[{"id": 1, "key": "82:1", "juz": 30, "page": 587, "side_trans": "When the sky breaks apart", "words": [{"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/082_001_001.mp3"}, {"type": "word", "ar": "ٱلسَّمَآءُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ", "en": "the sky", "tr": "l-samāu", "audio": "wbw/082_001_002.mp3"}, {"type": "word", "ar": "ٱنفَطَرَتْ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=ikhafa>نف</rule>َطَرَتۡ", "en": "(is) cleft asunder", "tr": "infaṭarat", "audio": "wbw/082_001_003.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "82:2", "juz": 30, "page": 587, "side_trans": "And when the stars fall, scattering,", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/082_002_001.mp3"}, {"type": "word", "ar": "ٱلْكَوَاكِبُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَوَاكِبُ", "en": "the stars", "tr": "l-kawākibu", "audio": "wbw/082_002_002.mp3"}, {"type": "word", "ar": "ٱنتَثَرَتْ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=ikhafa>نت</rule>َثَرَتۡ", "en": "scatter", "tr": "intatharat", "audio": "wbw/082_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "82:3", "juz": 30, "page": 587, "side_trans": "And when the seas are erupted", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/082_003_001.mp3"}, {"type": "word", "ar": "ٱلْبِحَارُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبِحَارُ", "en": "the seas", "tr": "l-biḥāru", "audio": "wbw/082_003_002.mp3"}, {"type": "word", "ar": "فُجِّرَتْ", "tajweed": "فُجِّرَتۡ", "en": "are made to gush forth", "tr": "fujjirat", "audio": "wbw/082_003_003.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "82:4", "juz": 30, "page": 587, "side_trans": "And when the [contents of] graves are scattered [i.e., exposed],", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/082_004_001.mp3"}, {"type": "word", "ar": "ٱلْقُبُورُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقُبُورُ", "en": "the graves", "tr": "l-qubūru", "audio": "wbw/082_004_002.mp3"}, {"type": "word", "ar": "بُعْثِرَتْ", "tajweed": "بُعۡثِرَتۡ", "en": "are overturned", "tr": "buʿ'thirat", "audio": "wbw/082_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "82:5", "juz": 30, "page": 587, "side_trans": "A soul will [then] know what it has put forth and kept back.", "words": [{"type": "word", "ar": "عَلِمَتْ", "tajweed": "عَلِمَتۡ", "en": "Will know", "tr": "ʿalimat", "audio": "wbw/082_005_001.mp3"}, {"type": "word", "ar": "نَفْسٌۭ", "tajweed": "نَفۡ<rule class=idgham_ghunnah>سٌ</rule>", "en": "a soul", "tr": "nafsun", "audio": "wbw/082_005_002.mp3"}, {"type": "word", "ar": "مَّا", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّا", "en": "what", "tr": "mā", "audio": "wbw/082_005_003.mp3"}, {"type": "word", "ar": "قَدَّمَتْ", "tajweed": "قَدَّمَتۡ", "en": "it has sent forth", "tr": "qaddamat", "audio": "wbw/082_005_004.mp3"}, {"type": "word", "ar": "وَأَخَّرَتْ", "tajweed": "وَأَخَّرَتۡ", "en": "and left behind", "tr": "wa-akharat", "audio": "wbw/082_005_005.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "82:6", "juz": 30, "page": 587, "side_trans": "O mankind, what has deceived you concerning your Lord, the Generous,", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/082_006_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "man", "tr": "l-insānu", "audio": "wbw/082_006_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "What", "tr": "mā", "audio": "wbw/082_006_003.mp3"}, {"type": "word", "ar": "غَرَّكَ", "tajweed": "غَرَّكَ", "en": "has deceived you", "tr": "gharraka", "audio": "wbw/082_006_004.mp3"}, {"type": "word", "ar": "بِرَبِّكَ", "tajweed": "بِرَبِّكَ", "en": "concerning your Lord", "tr": "birabbika", "audio": "wbw/082_006_005.mp3"}, {"type": "word", "ar": "ٱلْكَرِيمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَر<rule class=madda_permissible>ِي</rule>مِ", "en": "the Most Noble", "tr": "l-karīmi", "audio": "wbw/082_006_006.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "82:7", "juz": 30, "page": 587, "side_trans": "Who created you, proportioned you, and balanced you?", "words": [{"type": "word", "ar": "ٱلَّذِى", "tajweed": "ٱلَّذِى", "en": "Who", "tr": "alladhī", "audio": "wbw/082_007_001.mp3"}, {"type": "word", "ar": "خَلَقَكَ", "tajweed": "خَلَقَكَ", "en": "created you", "tr": "khalaqaka", "audio": "wbw/082_007_002.mp3"}, {"type": "word", "ar": "فَسَوَّىٰكَ", "tajweed": "فَسَوَّ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "then fashioned you", "tr": "fasawwāka", "audio": "wbw/082_007_003.mp3"}, {"type": "word", "ar": "فَعَدَلَكَ", "tajweed": "فَعَدَلَكَ", "en": "then balanced you", "tr": "faʿadalaka", "audio": "wbw/082_007_004.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "82:8", "juz": 30, "page": 587, "side_trans": "In whatever form He willed has He assembled you.", "words": [{"type": "word", "ar": "فِىٓ", "tajweed": "ف<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "In", "tr": "fī", "audio": "wbw/082_008_001.mp3"}, {"type": "word", "ar": "أَىِّ", "tajweed": "أَىِّ", "en": "whatever", "tr": "ayyi", "audio": "wbw/082_008_002.mp3"}, {"type": "word", "ar": "صُورَةٍۢ", "tajweed": "صُورَ<rule class=idgham_ghunnah>ةٍ</rule>", "en": "form", "tr": "ṣūratin", "audio": "wbw/082_008_003.mp3"}, {"type": "word", "ar": "مَّا", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّا", "en": "what", "tr": "mā", "audio": "wbw/082_008_004.mp3"}, {"type": "word", "ar": "شَآءَ", "tajweed": "ش<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "He willed", "tr": "shāa", "audio": "wbw/082_008_005.mp3"}, {"type": "word", "ar": "رَكَّبَكَ", "tajweed": "رَكَّبَكَ", "en": "He assembled you", "tr": "rakkabaka", "audio": "wbw/082_008_006.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "82:9", "juz": 30, "page": 587, "side_trans": "No! But you deny the Recompense.", "words": [{"type": "word", "ar": "كَلَّا", "tajweed": "كَلَّا", "en": "Nay", "tr": "kallā", "audio": "wbw/082_009_001.mp3"}, {"type": "word", "ar": "بَلْ", "tajweed": "بَلۡ", "en": "But", "tr": "bal", "audio": "wbw/082_009_002.mp3"}, {"type": "word", "ar": "تُكَذِّبُونَ", "tajweed": "تُكَذِّبُونَ", "en": "you deny", "tr": "tukadhibūna", "audio": "wbw/082_009_003.mp3"}, {"type": "word", "ar": "بِٱلدِّينِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دّ<rule class=madda_permissible>ِي</rule>نِ", "en": "the Judgment", "tr": "bil-dīni", "audio": "wbw/082_009_004.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "82:10", "juz": 30, "page": 587, "side_trans": "And indeed, [appointed] over you are keepers,", "words": [{"type": "word", "ar": "وَإِنَّ", "tajweed": "وَإِ<rule class=ghunnah>نّ</rule>َ", "en": "And indeed", "tr": "wa-inna", "audio": "wbw/082_010_001.mp3"}, {"type": "word", "ar": "عَلَيْكُمْ", "tajweed": "عَلَيۡكُمۡ", "en": "over you", "tr": "ʿalaykum", "audio": "wbw/082_010_002.mp3"}, {"type": "word", "ar": "لَحَـٰفِظِينَ", "tajweed": "لَحَ<rule class=madda_normal>ـٰ</rule>فِظ<rule class=madda_permissible>ِي</rule>نَ", "en": "(are) surely guardians", "tr": "laḥāfiẓīna", "audio": "wbw/082_010_003.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "82:11", "juz": 30, "page": 587, "side_trans": "Noble and recording;", "words": [{"type": "word", "ar": "كِرَامًۭا", "tajweed": "كِرَا<rule class=ikhafa>مًا</rule>", "en": "Noble", "tr": "kirāman", "audio": "wbw/082_011_001.mp3"}, {"type": "word", "ar": "كَـٰتِبِينَ", "tajweed": "<rule class=ikhafa>ك</rule>َ<rule class=madda_normal>ـٰ</rule>تِب<rule class=madda_permissible>ِي</rule>نَ", "en": "recording", "tr": "kātibīna", "audio": "wbw/082_011_002.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "82:12", "juz": 30, "page": 587, "side_trans": "They know whatever you do.", "words": [{"type": "word", "ar": "يَعْلَمُونَ", "tajweed": "يَعۡلَمُونَ", "en": "They know", "tr": "yaʿlamūna", "audio": "wbw/082_012_001.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "whatever", "tr": "mā", "audio": "wbw/082_012_002.mp3"}, {"type": "word", "ar": "تَفْعَلُونَ", "tajweed": "تَفۡعَل<rule class=madda_permissible>ُو</rule>نَ", "en": "you do", "tr": "tafʿalūna", "audio": "wbw/082_012_003.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "82:13", "juz": 30, "page": 587, "side_trans": "Indeed, the righteous will be in pleasure,", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/082_013_001.mp3"}, {"type": "word", "ar": "ٱلْأَبْرَارَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَ<rule class=qalaqah>بۡ</rule>رَارَ", "en": "the righteous", "tr": "l-abrāra", "audio": "wbw/082_013_002.mp3"}, {"type": "word", "ar": "لَفِى", "tajweed": "لَفِى", "en": "(will be) surely in", "tr": "lafī", "audio": "wbw/082_013_003.mp3"}, {"type": "word", "ar": "نَعِيمٍۢ", "tajweed": "نَع<rule class=madda_permissible>ِي</rule>مٍ", "en": "bliss", "tr": "naʿīmin", "audio": "wbw/082_013_004.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "82:14", "juz": 30, "page": 587, "side_trans": "And indeed, the wicked will be in Hellfire.", "words": [{"type": "word", "ar": "وَإِنَّ", "tajweed": "وَإِ<rule class=ghunnah>نّ</rule>َ", "en": "And indeed", "tr": "wa-inna", "audio": "wbw/082_014_001.mp3"}, {"type": "word", "ar": "ٱلْفُجَّارَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفُجَّارَ", "en": "the wicked", "tr": "l-fujāra", "audio": "wbw/082_014_002.mp3"}, {"type": "word", "ar": "لَفِى", "tajweed": "لَفِى", "en": "(will be) surely in", "tr": "lafī", "audio": "wbw/082_014_003.mp3"}, {"type": "word", "ar": "جَحِيمٍۢ", "tajweed": "جَح<rule class=madda_permissible>ِي</rule>مٍ", "en": "Hellfire", "tr": "jaḥīmin", "audio": "wbw/082_014_004.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "82:15", "juz": 30, "page": 587, "side_trans": "They will [enter to] burn therein on the Day of Recompense,", "words": [{"type": "word", "ar": "يَصْلَوْنَهَا", "tajweed": "يَصۡلَوۡنَهَا", "en": "They will burn (in) it", "tr": "yaṣlawnahā", "audio": "wbw/082_015_001.mp3"}, {"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(on the) Day", "tr": "yawma", "audio": "wbw/082_015_002.mp3"}, {"type": "word", "ar": "ٱلدِّينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دّ<rule class=madda_permissible>ِي</rule>نِ", "en": "(of) the Judgment", "tr": "l-dīni", "audio": "wbw/082_015_003.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "82:16", "juz": 30, "page": 587, "side_trans": "And never therefrom will they be absent.", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/082_016_001.mp3"}, {"type": "word", "ar": "هُمْ", "tajweed": "هُمۡ", "en": "they", "tr": "hum", "audio": "wbw/082_016_002.mp3"}, {"type": "word", "ar": "عَنْهَا", "tajweed": "عَنۡهَا", "en": "from it", "tr": "ʿanhā", "audio": "wbw/082_016_003.mp3"}, {"type": "word", "ar": "بِغَآئِبِينَ", "tajweed": "بِغ<rule class=madda_obligatory_mottasel>َا</rule>ٓئِب<rule class=madda_permissible>ِي</rule>نَ", "en": "(will be) absent", "tr": "bighāibīna", "audio": "wbw/082_016_004.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "82:17", "juz": 30, "page": 587, "side_trans": "And what can make you know what is the Day of Recompense?", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And what", "tr": "wamā", "audio": "wbw/082_017_001.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "can make you know", "tr": "adrāka", "audio": "wbw/082_017_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/082_017_003.mp3"}, {"type": "word", "ar": "يَوْمُ", "tajweed": "يَوۡمُ", "en": "(is the) Day", "tr": "yawmu", "audio": "wbw/082_017_004.mp3"}, {"type": "word", "ar": "ٱلدِّينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دّ<rule class=madda_permissible>ِي</rule>نِ", "en": "(of) the Judgment", "tr": "l-dīni", "audio": "wbw/082_017_005.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "82:18", "juz": 30, "page": 587, "side_trans": "Then, what can make you know what is the Day of Recompense?", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/082_018_001.mp3"}, {"type": "word", "ar": "مَآ", "tajweed": "م<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "what", "tr": "mā", "audio": "wbw/082_018_002.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "can make you know", "tr": "adrāka", "audio": "wbw/082_018_003.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/082_018_004.mp3"}, {"type": "word", "ar": "يَوْمُ", "tajweed": "يَوۡمُ", "en": "(is the) Day", "tr": "yawmu", "audio": "wbw/082_018_005.mp3"}, {"type": "word", "ar": "ٱلدِّينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دّ<rule class=madda_permissible>ِي</rule>نِ", "en": "(of) the Judgment", "tr": "l-dīni", "audio": "wbw/082_018_006.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "82:19", "juz": 30, "page": 587, "side_trans": "It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allāh.", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(The) Day", "tr": "yawma", "audio": "wbw/082_019_001.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/082_019_002.mp3"}, {"type": "word", "ar": "تَمْلِكُ", "tajweed": "تَمۡلِكُ", "en": "will have power", "tr": "tamliku", "audio": "wbw/082_019_003.mp3"}, {"type": "word", "ar": "نَفْسٌۭ", "tajweed": "نَفۡ<rule class=idgham_wo_ghunnah>سٌ</rule>", "en": "a soul", "tr": "nafsun", "audio": "wbw/082_019_004.mp3"}, {"type": "word", "ar": "لِّنَفْسٍۢ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّنَفۡ<rule class=ikhafa>سٍ</rule>", "en": "for a soul", "tr": "linafsin", "audio": "wbw/082_019_005.mp3"}, {"type": "word", "ar": "شَيْـًۭٔا ۖ", "tajweed": "<rule class=ikhafa>ش</rule>َيۡـ<rule class=idgham_ghunnah>ـًٔا‌ۖ</rule>", "en": "anything", "tr": "shayan", "audio": "wbw/082_019_006.mp3"}, {"type": "word", "ar": "وَٱلْأَمْرُ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َ<rule class=ham_wasl>ٱ</rule>لۡأَمۡرُ", "en": "and the Command", "tr": "wal-amru", "audio": "wbw/082_019_008.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "يَوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/082_019_009.mp3"}, {"type": "word", "ar": "لِّلَّهِ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلَّهِ", "en": "(will be) with Allah", "tr": "lillahi", "audio": "wbw/082_019_010.mp3"}, {"type": "end", "num": "١٩"}]}]