[{"id": 1, "key": "93:1", "juz": 30, "page": 596, "side_trans": "By the morning brightness", "words": [{"type": "word", "ar": "وَٱلضُّحَىٰ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ضُّحَىٰ", "en": "By the morning brightness", "tr": "wal-ḍuḥā", "audio": "wbw/093_001_001.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "93:2", "juz": 30, "page": 596, "side_trans": "And [by] the night when it covers with darkness,", "words": [{"type": "word", "ar": "وَٱلَّيْلِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّيۡلِ", "en": "And the night", "tr": "wa-al-layli", "audio": "wbw/093_002_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/093_002_002.mp3"}, {"type": "word", "ar": "سَجَىٰ", "tajweed": "سَجَىٰ", "en": "it covers with darkness", "tr": "sajā", "audio": "wbw/093_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "93:3", "juz": 30, "page": 596, "side_trans": "Your Lord has not taken leave of you, [O Muḥammad], nor has He detested [you].", "words": [{"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "Not", "tr": "mā", "audio": "wbw/093_003_001.mp3"}, {"type": "word", "ar": "وَدَّعَكَ", "tajweed": "وَدَّعَكَ", "en": "has forsaken you", "tr": "waddaʿaka", "audio": "wbw/093_003_002.mp3"}, {"type": "word", "ar": "رَبُّكَ", "tajweed": "رَبُّكَ", "en": "your Lord", "tr": "rabbuka", "audio": "wbw/093_003_003.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "and not", "tr": "wamā", "audio": "wbw/093_003_004.mp3"}, {"type": "word", "ar": "قَلَىٰ", "tajweed": "قَلَىٰ", "en": "He is displeased", "tr": "qalā", "audio": "wbw/093_003_005.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "93:4", "juz": 30, "page": 596, "side_trans": "And the Hereafter is better for you than the first [life].", "words": [{"type": "word", "ar": "وَلَلْـَٔاخِرَةُ", "tajweed": "وَلَلۡأَخِرَةُ", "en": "And surely the Hereafter", "tr": "walalākhiratu", "audio": "wbw/093_004_001.mp3"}, {"type": "word", "ar": "خَيْرٌۭ", "tajweed": "خَيۡ<rule class=idgham_wo_ghunnah>رٌ</rule>", "en": "(is) better", "tr": "khayrun", "audio": "wbw/093_004_002.mp3"}, {"type": "word", "ar": "لَّكَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّكَ", "en": "for you", "tr": "laka", "audio": "wbw/093_004_003.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "than", "tr": "mina", "audio": "wbw/093_004_004.mp3"}, {"type": "word", "ar": "ٱلْأُولَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأُولَىٰ", "en": "the first", "tr": "l-ūlā", "audio": "wbw/093_004_005.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "93:5", "juz": 30, "page": 596, "side_trans": "And your Lord is going to give you, and you will be satisfied.", "words": [{"type": "word", "ar": "وَلَسَوْفَ", "tajweed": "وَلَسَوۡفَ", "en": "And soon", "tr": "walasawfa", "audio": "wbw/093_005_001.mp3"}, {"type": "word", "ar": "يُعْطِيكَ", "tajweed": "يُعۡطِيكَ", "en": "will give you", "tr": "yuʿ'ṭīka", "audio": "wbw/093_005_002.mp3"}, {"type": "word", "ar": "رَبُّكَ", "tajweed": "رَبُّكَ", "en": "your Lord", "tr": "rabbuka", "audio": "wbw/093_005_003.mp3"}, {"type": "word", "ar": "فَتَرْضَىٰٓ", "tajweed": "فَتَرۡضَىٰٓ", "en": "then you will be satisfied", "tr": "fatarḍā", "audio": "wbw/093_005_004.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "93:6", "juz": 30, "page": 596, "side_trans": "Did He not find you an orphan and give [you] refuge?", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Did not", "tr": "alam", "audio": "wbw/093_006_001.mp3"}, {"type": "word", "ar": "يَجِدْكَ", "tajweed": "يَجِ<rule class=qalaqah>دۡ</rule>كَ", "en": "He find you", "tr": "yajid'ka", "audio": "wbw/093_006_002.mp3"}, {"type": "word", "ar": "يَتِيمًۭا", "tajweed": "يَتِي<rule class=ikhafa>مًا</rule>", "en": "an orphan", "tr": "yatīman", "audio": "wbw/093_006_003.mp3"}, {"type": "word", "ar": "فَـَٔاوَىٰ", "tajweed": "<rule class=ikhafa>ف</rule>َـَٔـاوَىٰ", "en": "and give shelter", "tr": "faāwā", "audio": "wbw/093_006_004.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "93:7", "juz": 30, "page": 596, "side_trans": "And He found you lost and guided [you],", "words": [{"type": "word", "ar": "وَوَجَدَكَ", "tajweed": "وَوَجَدَكَ", "en": "And He found you", "tr": "wawajadaka", "audio": "wbw/093_007_001.mp3"}, {"type": "word", "ar": "ضَآلًّۭا", "tajweed": "ضَآل<rule class=ikhafa>اًّ</rule>", "en": "lost", "tr": "ḍāllan", "audio": "wbw/093_007_002.mp3"}, {"type": "word", "ar": "فَهَدَىٰ", "tajweed": "<rule class=ikhafa>ف</rule>َهَدَىٰ", "en": "so He guided", "tr": "fahadā", "audio": "wbw/093_007_003.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "93:8", "juz": 30, "page": 596, "side_trans": "And He found you poor and made [you] self-sufficient.", "words": [{"type": "word", "ar": "وَوَجَدَكَ", "tajweed": "وَوَجَدَكَ", "en": "And He found you", "tr": "wawajadaka", "audio": "wbw/093_008_001.mp3"}, {"type": "word", "ar": "عَآئِلًۭا", "tajweed": "ع<rule class=madda_obligatory_mottasel>َا</rule>ٓئِل<rule class=ikhafa>اً</rule>", "en": "in need", "tr": "ʿāilan", "audio": "wbw/093_008_002.mp3"}, {"type": "word", "ar": "فَأَغْنَىٰ", "tajweed": "<rule class=ikhafa>ف</rule>َأَغۡنَىٰ", "en": "so He made self-sufficient", "tr": "fa-aghnā", "audio": "wbw/093_008_003.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "93:9", "juz": 30, "page": 596, "side_trans": "So as for the orphan, do not oppress [him].", "words": [{"type": "word", "ar": "فَأَمَّا", "tajweed": "فَأَ<rule class=ghunnah>مّ</rule>َا", "en": "So as for", "tr": "fa-ammā", "audio": "wbw/093_009_001.mp3"}, {"type": "word", "ar": "ٱلْيَتِيمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَتِيمَ", "en": "the orphan", "tr": "l-yatīma", "audio": "wbw/093_009_002.mp3"}, {"type": "word", "ar": "فَلَا", "tajweed": "فَلَا", "en": "then (do) not", "tr": "falā", "audio": "wbw/093_009_003.mp3"}, {"type": "word", "ar": "تَقْهَرْ", "tajweed": "تَ<rule class=qalaqah>قۡ</rule>هَرۡ", "en": "oppress", "tr": "taqhar", "audio": "wbw/093_009_004.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "93:10", "juz": 30, "page": 596, "side_trans": "And as for the petitioner, do not repel [him].", "words": [{"type": "word", "ar": "وَأَمَّا", "tajweed": "وَأَ<rule class=ghunnah>مّ</rule>َا", "en": "And as for", "tr": "wa-ammā", "audio": "wbw/093_010_001.mp3"}, {"type": "word", "ar": "ٱلسَّآئِلَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سّ<rule class=madda_obligatory_mottasel>َا</rule>ٓئِلَ", "en": "one who asks", "tr": "l-sāila", "audio": "wbw/093_010_002.mp3"}, {"type": "word", "ar": "فَلَا", "tajweed": "فَلَا", "en": "then (do) not", "tr": "falā", "audio": "wbw/093_010_003.mp3"}, {"type": "word", "ar": "تَنْهَرْ", "tajweed": "تَنۡهَرۡ", "en": "repel", "tr": "tanhar", "audio": "wbw/093_010_004.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "93:11", "juz": 30, "page": 596, "side_trans": "But as for the favor of your Lord, report [it].", "words": [{"type": "word", "ar": "وَأَمَّا", "tajweed": "وَأَ<rule class=ghunnah>مّ</rule>َا", "en": "But as for", "tr": "wa-ammā", "audio": "wbw/093_011_001.mp3"}, {"type": "word", "ar": "بِنِعْمَةِ", "tajweed": "بِنِعۡمَةِ", "en": "(the) Favor", "tr": "biniʿ'mati", "audio": "wbw/093_011_002.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "(of) your Lord", "tr": "rabbika", "audio": "wbw/093_011_003.mp3"}, {"type": "word", "ar": "فَحَدِّثْ", "tajweed": "فَحَدِّثۡ", "en": "narrate", "tr": "faḥaddith", "audio": "wbw/093_011_004.mp3"}, {"type": "end", "num": "١١"}]}]