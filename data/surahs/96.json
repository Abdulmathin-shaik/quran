[{"id": 1, "key": "96:1", "juz": 30, "page": 597, "side_trans": "Recite in the name of your Lord who created", "words": [{"type": "word", "ar": "ٱقْرَأْ", "tajweed": "ٱ<rule class=qalaqah>قۡ</rule>رَأۡ", "en": "Read", "tr": "iq'ra", "audio": "wbw/096_001_001.mp3"}, {"type": "word", "ar": "بِٱسْمِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>سۡمِ", "en": "in (the) name", "tr": "bi-is'mi", "audio": "wbw/096_001_002.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "(of) your Lord", "tr": "rabbika", "audio": "wbw/096_001_003.mp3"}, {"type": "word", "ar": "ٱلَّذِى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِى", "en": "the One Who", "tr": "alladhī", "audio": "wbw/096_001_004.mp3"}, {"type": "word", "ar": "خَلَقَ", "tajweed": "خَلَ<rule class=qalaqah>ق</rule>َ", "en": "created ", "tr": "khalaqa", "audio": "wbw/096_001_005.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "96:2", "juz": 30, "page": 597, "side_trans": "Created man from a clinging substance.", "words": [{"type": "word", "ar": "خَلَقَ", "tajweed": "خَلَقَ", "en": "He created", "tr": "khalaqa", "audio": "wbw/096_002_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نَ", "en": "man", "tr": "l-insāna", "audio": "wbw/096_002_002.mp3"}, {"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "from", "tr": "min", "audio": "wbw/096_002_003.mp3"}, {"type": "word", "ar": "عَلَقٍ", "tajweed": "عَلَ<rule class=qalaqah>ق</rule>ٍ", "en": "a clinging substance", "tr": "ʿalaqin", "audio": "wbw/096_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "96:3", "juz": 30, "page": 597, "side_trans": "Recite, and your Lord is the most Generous -", "words": [{"type": "word", "ar": "ٱقْرَأْ", "tajweed": "ٱ<rule class=qalaqah>قۡ</rule>رَأۡ", "en": "Read", "tr": "iq'ra", "audio": "wbw/096_003_001.mp3"}, {"type": "word", "ar": "وَرَبُّكَ", "tajweed": "وَرَبُّكَ", "en": "and your Lord", "tr": "warabbuka", "audio": "wbw/096_003_002.mp3"}, {"type": "word", "ar": "ٱلْأَكْرَمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَكۡرَمُ", "en": "(is) the Most Generous", "tr": "l-akramu", "audio": "wbw/096_003_003.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "96:4", "juz": 30, "page": 597, "side_trans": "Who taught by the pen", "words": [{"type": "word", "ar": "ٱلَّذِى", "tajweed": "ٱلَّذِى", "en": "The One Who", "tr": "alladhī", "audio": "wbw/096_004_001.mp3"}, {"type": "word", "ar": "عَلَّمَ", "tajweed": "عَلَّمَ", "en": "taught", "tr": "ʿallama", "audio": "wbw/096_004_002.mp3"}, {"type": "word", "ar": "بِٱلْقَلَمِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡقَلَمِ", "en": "by the pen", "tr": "bil-qalami", "audio": "wbw/096_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "96:5", "juz": 30, "page": 597, "side_trans": "Taught man that which he knew not.", "words": [{"type": "word", "ar": "عَلَّمَ", "tajweed": "عَلَّمَ", "en": "Taught", "tr": "ʿallama", "audio": "wbw/096_005_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نَ", "en": "man", "tr": "l-insāna", "audio": "wbw/096_005_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/096_005_003.mp3"}, {"type": "word", "ar": "لَمْ", "tajweed": "لَمۡ", "en": "not", "tr": "lam", "audio": "wbw/096_005_004.mp3"}, {"type": "word", "ar": "يَعْلَمْ", "tajweed": "يَعۡلَمۡ", "en": "he knew", "tr": "yaʿlam", "audio": "wbw/096_005_005.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "96:6", "juz": 30, "page": 597, "side_trans": "No! [But] indeed, man transgresses", "words": [{"type": "word", "ar": "كَلَّآ", "tajweed": "كَلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Nay", "tr": "kallā", "audio": "wbw/096_006_001.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/096_006_002.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نَ", "en": "man", "tr": "l-insāna", "audio": "wbw/096_006_003.mp3"}, {"type": "word", "ar": "لَيَطْغَىٰٓ", "tajweed": "لَيَ<rule class=qalaqah>طۡ</rule>غَىٰٓ", "en": "surely transgresses", "tr": "layaṭghā", "audio": "wbw/096_006_004.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "96:7", "juz": 30, "page": 597, "side_trans": "Because he sees himself self-sufficient.", "words": [{"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_wo_ghunnah>َن</rule>", "en": "That", "tr": "an", "audio": "wbw/096_007_001.mp3"}, {"type": "word", "ar": "رَّءَاهُ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّءَاهُ", "en": "he sees himself", "tr": "raāhu", "audio": "wbw/096_007_002.mp3"}, {"type": "word", "ar": "ٱسْتَغْنَىٰٓ", "tajweed": "<rule class=ham_wasl>ٱ</rule>سۡتَغۡنَىٰٓ", "en": "self-sufficient", "tr": "is'taghnā", "audio": "wbw/096_007_003.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "96:8", "juz": 30, "page": 597, "side_trans": "Indeed, to your Lord is the return.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/096_008_001.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/096_008_002.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "your Lord", "tr": "rabbika", "audio": "wbw/096_008_003.mp3"}, {"type": "word", "ar": "ٱلرُّجْعَىٰٓ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رُّ<rule class=qalaqah>جۡ</rule>عَىٰٓ", "en": "(is) the return", "tr": "l-ruj'ʿā", "audio": "wbw/096_008_004.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "96:9", "juz": 30, "page": 597, "side_trans": "Have you seen the one who forbids", "words": [{"type": "word", "ar": "أَرَءَيْتَ", "tajweed": "أَرَءَيۡتَ", "en": "Have you seen", "tr": "ara-ayta", "audio": "wbw/096_009_001.mp3"}, {"type": "word", "ar": "ٱلَّذِى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِى", "en": "the one who", "tr": "alladhī", "audio": "wbw/096_009_002.mp3"}, {"type": "word", "ar": "يَنْهَىٰ", "tajweed": "يَنۡهَىٰ", "en": "forbids", "tr": "yanhā", "audio": "wbw/096_009_003.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "96:10", "juz": 30, "page": 597, "side_trans": "A servant when he prays?", "words": [{"type": "word", "ar": "عَبْدًا", "tajweed": "عَ<rule class=qalaqah>بۡ</rule>دًا", "en": "A slave", "tr": "ʿabdan", "audio": "wbw/096_010_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/096_010_002.mp3"}, {"type": "word", "ar": "صَلَّىٰٓ", "tajweed": "صَلَّىٰٓ", "en": "he prays", "tr": "ṣallā", "audio": "wbw/096_010_003.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "96:11", "juz": 30, "page": 597, "side_trans": "Have you seen if he is upon guidance", "words": [{"type": "word", "ar": "أَرَءَيْتَ", "tajweed": "أَرَءَيۡتَ", "en": "Have you seen", "tr": "ara-ayta", "audio": "wbw/096_011_001.mp3"}, {"type": "word", "ar": "إِن", "tajweed": "إِ<rule class=ikhafa>ن</rule>", "en": "if", "tr": "in", "audio": "wbw/096_011_002.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "<rule class=ikhafa>ك</rule>َانَ", "en": "he is", "tr": "kāna", "audio": "wbw/096_011_003.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "upon", "tr": "ʿalā", "audio": "wbw/096_011_004.mp3"}, {"type": "word", "ar": "ٱلْهُدَىٰٓ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡهُدَىٰٓ", "en": "[the] guidance", "tr": "l-hudā", "audio": "wbw/096_011_005.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "96:12", "juz": 30, "page": 597, "side_trans": "Or enjoins righteousness?", "words": [{"type": "word", "ar": "أَوْ", "tajweed": "أَوۡ", "en": "Or", "tr": "aw", "audio": "wbw/096_012_001.mp3"}, {"type": "word", "ar": "أَمَرَ", "tajweed": "أَمَرَ", "en": "he enjoins", "tr": "amara", "audio": "wbw/096_012_002.mp3"}, {"type": "word", "ar": "بِٱلتَّقْوَىٰٓ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>تَّ<rule class=qalaqah>قۡ</rule>وَىٰٓ", "en": "[of the] righteousness", "tr": "bil-taqwā", "audio": "wbw/096_012_003.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "96:13", "juz": 30, "page": 598, "side_trans": "Have you seen if he denies and turns away -", "words": [{"type": "word", "ar": "أَرَءَيْتَ", "tajweed": "أَرَءَيۡتَ", "en": "Have you seen", "tr": "ara-ayta", "audio": "wbw/096_013_001.mp3"}, {"type": "word", "ar": "إِن", "tajweed": "إِ<rule class=ikhafa>ن</rule>", "en": "if", "tr": "in", "audio": "wbw/096_013_002.mp3"}, {"type": "word", "ar": "كَذَّبَ", "tajweed": "<rule class=ikhafa>ك</rule>َذَّبَ", "en": "he denies", "tr": "kadhaba", "audio": "wbw/096_013_003.mp3"}, {"type": "word", "ar": "وَتَوَلَّىٰٓ", "tajweed": "وَتَوَلَّىٰٓ", "en": "and turns away", "tr": "watawallā", "audio": "wbw/096_013_004.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "96:14", "juz": 30, "page": 598, "side_trans": "Does he not know that Allāh sees?", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Does not", "tr": "alam", "audio": "wbw/096_014_001.mp3"}, {"type": "word", "ar": "يَعْلَم", "tajweed": "يَعۡل<rule class=ikhafa_shafawi>َم</rule>", "en": "he know", "tr": "yaʿlam", "audio": "wbw/096_014_002.mp3"}, {"type": "word", "ar": "بِأَنَّ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِأَ<rule class=ghunnah>نّ</rule>َ", "en": "that", "tr": "bi-anna", "audio": "wbw/096_014_003.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/096_014_004.mp3"}, {"type": "word", "ar": "يَرَىٰ", "tajweed": "يَرَىٰ", "en": "sees", "tr": "yarā", "audio": "wbw/096_014_005.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "96:15", "juz": 30, "page": 598, "side_trans": "No! If he does not desist, We will surely drag him by the forelock", "words": [{"type": "word", "ar": "كَلَّا", "tajweed": "كَلَّا", "en": "Nay", "tr": "kallā", "audio": "wbw/096_015_001.mp3"}, {"type": "word", "ar": "لَئِن", "tajweed": "لَئ<rule class=idgham_wo_ghunnah>ِن</rule>", "en": "If", "tr": "la-in", "audio": "wbw/096_015_002.mp3"}, {"type": "word", "ar": "لَّمْ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّمۡ", "en": "not", "tr": "lam", "audio": "wbw/096_015_003.mp3"}, {"type": "word", "ar": "يَنتَهِ", "tajweed": "يَ<rule class=ikhafa>نت</rule>َهِ", "en": "he desists", "tr": "yantahi", "audio": "wbw/096_015_004.mp3"}, {"type": "word", "ar": "لَنَسْفَعًۢا", "tajweed": "لَنَسۡفَع<rule class=iqlab>َۢا</rule>", "en": "surely We will drag him", "tr": "lanasfaʿan", "audio": "wbw/096_015_005.mp3"}, {"type": "word", "ar": "بِٱلنَّاصِيَةِ", "tajweed": "<rule class=iqlab>ب</rule>ِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َاصِيَةِ", "en": "by the forelock", "tr": "bil-nāṣiyati", "audio": "wbw/096_015_006.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "96:16", "juz": 30, "page": 598, "side_trans": "A lying, sinning forelock.", "words": [{"type": "word", "ar": "نَاصِيَةٍۢ", "tajweed": "نَاصِيَ<rule class=ikhafa>ةٍ</rule>", "en": "A forelock", "tr": "nāṣiyatin", "audio": "wbw/096_016_001.mp3"}, {"type": "word", "ar": "كَـٰذِبَةٍ", "tajweed": "<rule class=ikhafa>ك</rule>َ<rule class=madda_normal>ـٰ</rule>ذِبَةٍ", "en": "lying", "tr": "kādhibatin", "audio": "wbw/096_016_002.mp3"}, {"type": "word", "ar": "خَاطِئَةٍۢ", "tajweed": "خَاطِئَةٍ", "en": "sinful", "tr": "khāṭi-atin", "audio": "wbw/096_016_003.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "96:17", "juz": 30, "page": 598, "side_trans": "Then let him call his associates;", "words": [{"type": "word", "ar": "فَلْيَدْعُ", "tajweed": "فَلۡيَ<rule class=qalaqah>دۡ</rule>عُ", "en": "Then let him call", "tr": "falyadʿu", "audio": "wbw/096_017_001.mp3"}, {"type": "word", "ar": "نَادِيَهُۥ", "tajweed": "نَادِيَهُۥ", "en": "his associates", "tr": "nādiyahu", "audio": "wbw/096_017_002.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "96:18", "juz": 30, "page": 598, "side_trans": "We will call the angels of Hell.", "words": [{"type": "word", "ar": "سَنَدْعُ", "tajweed": "سَنَ<rule class=qalaqah>دۡ</rule>عُ", "en": "We will call", "tr": "sanadʿu", "audio": "wbw/096_018_001.mp3"}, {"type": "word", "ar": "ٱلزَّبَانِيَةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>زَّبَانِيَةَ", "en": "the Angels of Hell", "tr": "l-zabāniyata", "audio": "wbw/096_018_002.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "96:19", "juz": 30, "page": 598, "side_trans": "No! Do not obey him. But prostrate and draw near [to Allāh].", "words": [{"type": "word", "ar": "كَلَّا", "tajweed": "كَلَّا", "en": "Nay", "tr": "kallā", "audio": "wbw/096_019_001.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(Do) not", "tr": "lā", "audio": "wbw/096_019_002.mp3"}, {"type": "word", "ar": "تُطِعْهُ", "tajweed": "تُطِعۡهُ", "en": "obey him", "tr": "tuṭiʿ'hu", "audio": "wbw/096_019_003.mp3"}, {"type": "word", "ar": "وَٱسْجُدْ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>سۡجُ<rule class=qalaqah>دۡ</rule>", "en": "But prostrate", "tr": "wa-us'jud", "audio": "wbw/096_019_004.mp3"}, {"type": "word", "ar": "وَٱقْتَرِب ۩", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>قۡ</rule>تَرِ<rule class=qalaqah>ب</rule>", "en": "and draw near (to Allah)", "tr": "wa-iq'tarib", "audio": "wbw/096_019_005.mp3"}, {"type": "end", "num": "١٩"}]}]