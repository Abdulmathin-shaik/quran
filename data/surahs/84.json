[{"id": 1, "key": "84:1", "juz": 30, "page": 589, "side_trans": "When the sky has split [open]", "words": [{"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/084_001_001.mp3"}, {"type": "word", "ar": "ٱلسَّمَآءُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ", "en": "the sky", "tr": "l-samāu", "audio": "wbw/084_001_002.mp3"}, {"type": "word", "ar": "ٱنشَقَّتْ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=ikhafa>نش</rule>َقَّتۡ", "en": "is split asunder", "tr": "inshaqqat", "audio": "wbw/084_001_003.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "84:2", "juz": 30, "page": 589, "side_trans": "And has listened [i.e., responded] to its Lord and was obligated [to do so]", "words": [{"type": "word", "ar": "وَأَذِنَتْ", "tajweed": "وَأَذِنَتۡ", "en": "And has listened", "tr": "wa-adhinat", "audio": "wbw/084_002_001.mp3"}, {"type": "word", "ar": "لِرَبِّهَا", "tajweed": "لِرَبِّهَا", "en": "to its Lord", "tr": "lirabbihā", "audio": "wbw/084_002_002.mp3"}, {"type": "word", "ar": "وَحُقَّتْ", "tajweed": "وَحُقَّتۡ", "en": "and was obligated", "tr": "waḥuqqat", "audio": "wbw/084_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "84:3", "juz": 30, "page": 589, "side_trans": "And when the earth has been extended", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/084_003_001.mp3"}, {"type": "word", "ar": "ٱلْأَرْضُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضُ", "en": "the earth", "tr": "l-arḍu", "audio": "wbw/084_003_002.mp3"}, {"type": "word", "ar": "مُدَّتْ", "tajweed": "مُدَّتۡ", "en": "is spread", "tr": "muddat", "audio": "wbw/084_003_003.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "84:4", "juz": 30, "page": 589, "side_trans": "And has cast out that within it and relinquished [it].", "words": [{"type": "word", "ar": "وَأَلْقَتْ", "tajweed": "وَأَلۡقَتۡ", "en": "And has cast out", "tr": "wa-alqat", "audio": "wbw/084_004_001.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/084_004_002.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "(is) in it", "tr": "fīhā", "audio": "wbw/084_004_003.mp3"}, {"type": "word", "ar": "وَتَخَلَّتْ", "tajweed": "وَتَخَلَّتۡ", "en": "and becomes empty", "tr": "watakhallat", "audio": "wbw/084_004_004.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "84:5", "juz": 30, "page": 589, "side_trans": "And has listened [i.e., responded] to its Lord and was obligated [to do so] -", "words": [{"type": "word", "ar": "وَأَذِنَتْ", "tajweed": "وَأَذِنَتۡ", "en": "And has listened", "tr": "wa-adhinat", "audio": "wbw/084_005_001.mp3"}, {"type": "word", "ar": "لِرَبِّهَا", "tajweed": "لِرَبِّهَا", "en": "to its Lord", "tr": "lirabbihā", "audio": "wbw/084_005_002.mp3"}, {"type": "word", "ar": "وَحُقَّتْ", "tajweed": "وَحُقَّتۡ", "en": "and was obligated", "tr": "waḥuqqat", "audio": "wbw/084_005_003.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "84:6", "juz": 30, "page": 589, "side_trans": "O mankind, indeed you are laboring toward your Lord with [great] exertion and will meet it.", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/084_006_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "mankind", "tr": "l-insānu", "audio": "wbw/084_006_002.mp3"}, {"type": "word", "ar": "إِنَّكَ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َكَ", "en": "Indeed, you", "tr": "innaka", "audio": "wbw/084_006_003.mp3"}, {"type": "word", "ar": "كَادِحٌ", "tajweed": "كَادِحٌ", "en": "(are) laboring", "tr": "kādiḥun", "audio": "wbw/084_006_004.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/084_006_005.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "your Lord", "tr": "rabbika", "audio": "wbw/084_006_006.mp3"}, {"type": "word", "ar": "كَدْحًۭا", "tajweed": "كَ<rule class=qalaqah>دۡ</rule><rule class=ikhafa>حًا</rule>", "en": "(with) exertion", "tr": "kadḥan", "audio": "wbw/084_006_007.mp3"}, {"type": "word", "ar": "فَمُلَـٰقِيهِ", "tajweed": "<rule class=ikhafa>ف</rule>َمُلَ<rule class=madda_normal>ـٰ</rule>ق<rule class=madda_permissible>ِي</rule>هِ", "en": "and you (will) meet Him", "tr": "famulāqīhi", "audio": "wbw/084_006_008.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "84:7", "juz": 30, "page": 589, "side_trans": "Then as for he who is given his record in his right hand,", "words": [{"type": "word", "ar": "فَأَمَّا", "tajweed": "فَأَ<rule class=ghunnah>مّ</rule>َا", "en": "Then as for", "tr": "fa-ammā", "audio": "wbw/084_007_001.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "(him) who", "tr": "man", "audio": "wbw/084_007_002.mp3"}, {"type": "word", "ar": "أُوتِىَ", "tajweed": "أُوتِىَ", "en": "is given", "tr": "ūtiya", "audio": "wbw/084_007_003.mp3"}, {"type": "word", "ar": "كِتَـٰبَهُۥ", "tajweed": "كِتَ<rule class=madda_normal>ـٰ</rule>بَهُ<rule class=madda_normal>ۥ</rule>", "en": "his record", "tr": "kitābahu", "audio": "wbw/084_007_004.mp3"}, {"type": "word", "ar": "بِيَمِينِهِۦ", "tajweed": "بِيَمِينِهِۦ", "en": "in his right (hand)", "tr": "biyamīnihi", "audio": "wbw/084_007_005.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "84:8", "juz": 30, "page": 589, "side_trans": "He will be judged with an easy account", "words": [{"type": "word", "ar": "فَسَوْفَ", "tajweed": "فَسَوۡفَ", "en": "Then soon", "tr": "fasawfa", "audio": "wbw/084_008_001.mp3"}, {"type": "word", "ar": "يُحَاسَبُ", "tajweed": "يُحَاسَبُ", "en": "his account will be taken", "tr": "yuḥāsabu", "audio": "wbw/084_008_002.mp3"}, {"type": "word", "ar": "حِسَابًۭا", "tajweed": "حِسَا<rule class=idgham_ghunnah>بًا</rule>", "en": "an account", "tr": "ḥisāban", "audio": "wbw/084_008_003.mp3"}, {"type": "word", "ar": "يَسِيرًۭا", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َسِيرًا", "en": "easy", "tr": "yasīran", "audio": "wbw/084_008_004.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "84:9", "juz": 30, "page": 589, "side_trans": "And return to his people in happiness.", "words": [{"type": "word", "ar": "وَيَنقَلِبُ", "tajweed": "وَيَ<rule class=ikhafa>نق</rule>َلِبُ", "en": "And he will return", "tr": "wayanqalibu", "audio": "wbw/084_009_001.mp3"}, {"type": "word", "ar": "إِلَىٰٓ", "tajweed": "إِلَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "to", "tr": "ilā", "audio": "wbw/084_009_002.mp3"}, {"type": "word", "ar": "أَهْلِهِۦ", "tajweed": "أَهۡلِه<rule class=madda_normal>ِۦ</rule>", "en": "his people", "tr": "ahlihi", "audio": "wbw/084_009_003.mp3"}, {"type": "word", "ar": "مَسْرُورًۭا", "tajweed": "مَسۡرُورًا", "en": "happily", "tr": "masrūran", "audio": "wbw/084_009_004.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "84:10", "juz": 30, "page": 589, "side_trans": "But as for he who is given his record behind his back,", "words": [{"type": "word", "ar": "وَأَمَّا", "tajweed": "وَأَ<rule class=ghunnah>مّ</rule>َا", "en": "But as for", "tr": "wa-ammā", "audio": "wbw/084_010_001.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "(him) who", "tr": "man", "audio": "wbw/084_010_002.mp3"}, {"type": "word", "ar": "أُوتِىَ", "tajweed": "أُوتِىَ", "en": "is given", "tr": "ūtiya", "audio": "wbw/084_010_003.mp3"}, {"type": "word", "ar": "كِتَـٰبَهُۥ", "tajweed": "كِتَ<rule class=madda_normal>ـٰ</rule>بَهُ<rule class=madda_normal>ۥ</rule>", "en": "his record", "tr": "kitābahu", "audio": "wbw/084_010_004.mp3"}, {"type": "word", "ar": "وَرَآءَ", "tajweed": "وَر<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "behind", "tr": "warāa", "audio": "wbw/084_010_005.mp3"}, {"type": "word", "ar": "ظَهْرِهِۦ", "tajweed": "ظَهۡرِهِۦ", "en": "his back", "tr": "ẓahrihi", "audio": "wbw/084_010_006.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "84:11", "juz": 30, "page": 589, "side_trans": "He will cry out for destruction", "words": [{"type": "word", "ar": "فَسَوْفَ", "tajweed": "فَسَوۡفَ", "en": "Then soon", "tr": "fasawfa", "audio": "wbw/084_011_001.mp3"}, {"type": "word", "ar": "يَدْعُوا۟", "tajweed": "يَ<rule class=qalaqah>دۡ</rule>عُو<rule class=slnt>اۡ</rule>", "en": "he will call", "tr": "yadʿū", "audio": "wbw/084_011_002.mp3"}, {"type": "word", "ar": "ثُبُورًۭا", "tajweed": "ثُبُورًا", "en": "(for) destruction", "tr": "thubūran", "audio": "wbw/084_011_003.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "84:12", "juz": 30, "page": 589, "side_trans": "And [enter to] burn in a Blaze.", "words": [{"type": "word", "ar": "وَيَصْلَىٰ", "tajweed": "وَيَصۡلَىٰ", "en": "And he will burn", "tr": "wayaṣlā", "audio": "wbw/084_012_001.mp3"}, {"type": "word", "ar": "سَعِيرًا", "tajweed": "سَعِيرًا", "en": "(in) a Blaze", "tr": "saʿīran", "audio": "wbw/084_012_002.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "84:13", "juz": 30, "page": 589, "side_trans": "Indeed, he had [once] been among his people in happiness;", "words": [{"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, he", "tr": "innahu", "audio": "wbw/084_013_001.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "had been", "tr": "kāna", "audio": "wbw/084_013_002.mp3"}, {"type": "word", "ar": "فِىٓ", "tajweed": "ف<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "among", "tr": "fī", "audio": "wbw/084_013_003.mp3"}, {"type": "word", "ar": "أَهْلِهِۦ", "tajweed": "أَهۡلِه<rule class=madda_normal>ِۦ</rule>", "en": "his people", "tr": "ahlihi", "audio": "wbw/084_013_004.mp3"}, {"type": "word", "ar": "مَسْرُورًا", "tajweed": "مَسۡرُورًا", "en": "happy", "tr": "masrūran", "audio": "wbw/084_013_005.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "84:14", "juz": 30, "page": 589, "side_trans": "Indeed, he had thought he would never return [to Allāh].", "words": [{"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, he", "tr": "innahu", "audio": "wbw/084_014_001.mp3"}, {"type": "word", "ar": "ظَنَّ", "tajweed": "ظَ<rule class=ghunnah>نّ</rule>َ", "en": "(had) thought", "tr": "ẓanna", "audio": "wbw/084_014_002.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_wo_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/084_014_003.mp3"}, {"type": "word", "ar": "لَّن", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ّ<rule class=idgham_ghunnah>َن</rule>", "en": "never", "tr": "lan", "audio": "wbw/084_014_004.mp3"}, {"type": "word", "ar": "يَحُورَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َح<rule class=madda_permissible>ُو</rule>رَ", "en": "he would return", "tr": "yaḥūra", "audio": "wbw/084_014_005.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "84:15", "juz": 30, "page": 589, "side_trans": "But yes! Indeed, his Lord was ever, of him, Seeing.", "words": [{"type": "word", "ar": "بَلَىٰٓ", "tajweed": "بَلَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "Yes", "tr": "balā", "audio": "wbw/084_015_001.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/084_015_002.mp3"}, {"type": "word", "ar": "رَبَّهُۥ", "tajweed": "رَبَّهُ<rule class=madda_normal>ۥ</rule>", "en": "his Lord", "tr": "rabbahu", "audio": "wbw/084_015_003.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "was", "tr": "kāna", "audio": "wbw/084_015_004.mp3"}, {"type": "word", "ar": "بِهِۦ", "tajweed": "بِه<rule class=madda_normal>ِۦ</rule>", "en": "of him", "tr": "bihi", "audio": "wbw/084_015_005.mp3"}, {"type": "word", "ar": "بَصِيرًۭا", "tajweed": "بَصِيرًا", "en": "All-Seer", "tr": "baṣīran", "audio": "wbw/084_015_006.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "84:16", "juz": 30, "page": 589, "side_trans": "So I swear by the twilight glow", "words": [{"type": "word", "ar": "فَلَآ", "tajweed": "فَل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "But nay", "tr": "falā", "audio": "wbw/084_016_001.mp3"}, {"type": "word", "ar": "أُقْسِمُ", "tajweed": "أُ<rule class=qalaqah>قۡ</rule>سِمُ", "en": "I swear", "tr": "uq'simu", "audio": "wbw/084_016_002.mp3"}, {"type": "word", "ar": "بِٱلشَّفَقِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شَّفَ<rule class=qalaqah>ق</rule>ِ", "en": "by the twilight glow", "tr": "bil-shafaqi", "audio": "wbw/084_016_003.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "84:17", "juz": 30, "page": 589, "side_trans": "And [by] the night and what it envelops", "words": [{"type": "word", "ar": "وَٱلَّيْلِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّيۡلِ", "en": "And the night", "tr": "wa-al-layli", "audio": "wbw/084_017_001.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "and what", "tr": "wamā", "audio": "wbw/084_017_002.mp3"}, {"type": "word", "ar": "وَسَقَ", "tajweed": "وَسَ<rule class=qalaqah>ق</rule>َ", "en": "it envelops", "tr": "wasaqa", "audio": "wbw/084_017_003.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "84:18", "juz": 30, "page": 589, "side_trans": "And [by] the moon when it becomes full", "words": [{"type": "word", "ar": "وَٱلْقَمَرِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡقَمَرِ", "en": "And the moon", "tr": "wal-qamari", "audio": "wbw/084_018_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/084_018_002.mp3"}, {"type": "word", "ar": "ٱتَّسَقَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>تَّسَ<rule class=qalaqah>ق</rule>َ", "en": "it becomes full", "tr": "ittasaqa", "audio": "wbw/084_018_003.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "84:19", "juz": 30, "page": 589, "side_trans": "[That] you will surely embark upon [i.e., experience] state after state.", "words": [{"type": "word", "ar": "لَتَرْكَبُنَّ", "tajweed": "لَتَرۡكَبُ<rule class=ghunnah>نّ</rule>َ", "en": "You will surely embark", "tr": "latarkabunna", "audio": "wbw/084_019_001.mp3"}, {"type": "word", "ar": "طَبَقًا", "tajweed": "طَبَقًا", "en": "(to) stage", "tr": "ṭabaqan", "audio": "wbw/084_019_002.mp3"}, {"type": "word", "ar": "عَن", "tajweed": "عَ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "ʿan", "audio": "wbw/084_019_003.mp3"}, {"type": "word", "ar": "طَبَقٍۢ", "tajweed": "<rule class=ikhafa>ط</rule>َبَ<rule class=qalaqah>ق</rule>ٍ", "en": "stage", "tr": "ṭabaqin", "audio": "wbw/084_019_004.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "84:20", "juz": 30, "page": 589, "side_trans": "So what is [the matter] with them [that] they do not believe,", "words": [{"type": "word", "ar": "فَمَا", "tajweed": "فَمَا", "en": "So what", "tr": "famā", "audio": "wbw/084_020_001.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "(is) for them", "tr": "lahum", "audio": "wbw/084_020_002.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/084_020_003.mp3"}, {"type": "word", "ar": "يُؤْمِنُونَ", "tajweed": "يُؤۡمِن<rule class=madda_permissible>ُو</rule>نَ", "en": "they believe", "tr": "yu'minūna", "audio": "wbw/084_020_004.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "84:21", "juz": 30, "page": 589, "side_trans": "And when the Qur’ān is recited to them, they do not prostrate [to Allāh]?", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/084_021_001.mp3"}, {"type": "word", "ar": "قُرِئَ", "tajweed": "قُرِئَ", "en": "is recited", "tr": "quri-a", "audio": "wbw/084_021_002.mp3"}, {"type": "word", "ar": "عَلَيْهِمُ", "tajweed": "عَلَيۡهِمُ", "en": "to them", "tr": "ʿalayhimu", "audio": "wbw/084_021_003.mp3"}, {"type": "word", "ar": "ٱلْقُرْءَانُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقُرۡءَانُ", "en": "the Quran", "tr": "l-qur'ānu", "audio": "wbw/084_021_004.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/084_021_005.mp3"}, {"type": "word", "ar": "يَسْجُدُونَ ۩", "tajweed": "يَسۡجُدُ<rule class=madda_permissible>و</rule>نَ", "en": "they prostrate", "tr": "yasjudūna", "audio": "wbw/084_021_006.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "84:22", "juz": 30, "page": 589, "side_trans": "But those who have disbelieved deny,", "words": [{"type": "word", "ar": "بَلِ", "tajweed": "بَلِ", "en": "Nay", "tr": "bali", "audio": "wbw/084_022_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "Those who", "tr": "alladhīna", "audio": "wbw/084_022_002.mp3"}, {"type": "word", "ar": "كَفَرُوا۟", "tajweed": "كَفَرُو<rule class=slnt>اۡ</rule>", "en": "disbelieved", "tr": "kafarū", "audio": "wbw/084_022_003.mp3"}, {"type": "word", "ar": "يُكَذِّبُونَ", "tajweed": "يُكَذِّب<rule class=madda_permissible>ُو</rule>نَ", "en": "deny", "tr": "yukadhibūna", "audio": "wbw/084_022_004.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "84:23", "juz": 30, "page": 589, "side_trans": "And Allāh is most knowing of what they keep within themselves.", "words": [{"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/084_023_001.mp3"}, {"type": "word", "ar": "أَعْلَمُ", "tajweed": "أَعۡلَمُ", "en": "(is) most knowing", "tr": "aʿlamu", "audio": "wbw/084_023_002.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "بِمَا", "en": "of what", "tr": "bimā", "audio": "wbw/084_023_003.mp3"}, {"type": "word", "ar": "يُوعُونَ", "tajweed": "يُوع<rule class=madda_permissible>ُو</rule>نَ", "en": "they keep within themselves", "tr": "yūʿūna", "audio": "wbw/084_023_004.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "84:24", "juz": 30, "page": 589, "side_trans": "So give them tidings of a painful punishment,", "words": [{"type": "word", "ar": "فَبَشِّرْهُم", "tajweed": "فَبَشِّرۡه<rule class=ikhafa_shafawi>ُم</rule>", "en": "so give them tidings", "tr": "fabashir'hum", "audio": "wbw/084_024_001.mp3"}, {"type": "word", "ar": "بِعَذَابٍ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِعَذَابٍ", "en": "of a punishment", "tr": "biʿadhābin", "audio": "wbw/084_024_002.mp3"}, {"type": "word", "ar": "أَلِيمٍ", "tajweed": "أَل<rule class=madda_permissible>ِي</rule>مٍ", "en": "painful", "tr": "alīmin", "audio": "wbw/084_024_003.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "84:25", "juz": 30, "page": 590, "side_trans": "Except for those who believe and do righteous deeds. For them is a reward uninterrupted.", "words": [{"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "Except", "tr": "illā", "audio": "wbw/084_025_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/084_025_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/084_025_003.mp3"}, {"type": "word", "ar": "وَعَمِلُوا۟", "tajweed": "وَعَمِلُو<rule class=slnt>اۡ</rule>", "en": "and do", "tr": "waʿamilū", "audio": "wbw/084_025_004.mp3"}, {"type": "word", "ar": "ٱلصَّـٰلِحَـٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّ<rule class=madda_normal>ـٰ</rule>لِحَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "righteous deeds", "tr": "l-ṣāliḥāti", "audio": "wbw/084_025_005.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "For them", "tr": "lahum", "audio": "wbw/084_025_006.mp3"}, {"type": "word", "ar": "أَجْرٌ", "tajweed": "أَ<rule class=qalaqah>جۡ</rule>رٌ", "en": "(is) a reward", "tr": "ajrun", "audio": "wbw/084_025_007.mp3"}, {"type": "word", "ar": "غَيْرُ", "tajweed": "غَيۡرُ", "en": "never", "tr": "ghayru", "audio": "wbw/084_025_008.mp3"}, {"type": "word", "ar": "مَمْنُونٍۭ", "tajweed": "مَمۡن<rule class=madda_permissible>ُو</rule>نِۭ", "en": "ending", "tr": "mamnūnin", "audio": "wbw/084_025_009.mp3"}, {"type": "end", "num": "٢٥"}]}]