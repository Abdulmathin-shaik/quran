[{"id": 1, "key": "64:1", "juz": 28, "page": 556, "side_trans": "Whatever is in the heavens and whatever is on the earth is exalting Allāh. To Him belongs dominion, and to Him belongs [all] praise, and He is over all things competent.", "words": [{"type": "word", "ar": "يُسَبِّحُ", "tajweed": "يُسَبِّحُ", "en": "Glorifies", "tr": "yusabbiḥu", "audio": "wbw/064_001_001.mp3"}, {"type": "word", "ar": "لِلَّهِ", "tajweed": "لِلَّهِ", "en": "[to] Allah", "tr": "lillahi", "audio": "wbw/064_001_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "whatever", "tr": "mā", "audio": "wbw/064_001_003.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(is) in", "tr": "fī", "audio": "wbw/064_001_004.mp3"}, {"type": "word", "ar": "ٱلسَّمَـٰوَٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّمَ<rule class=madda_normal>ـٰ</rule>و<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِ", "en": "the heavens", "tr": "l-samāwāti", "audio": "wbw/064_001_005.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "and whatever", "tr": "wamā", "audio": "wbw/064_001_006.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(is) in", "tr": "fī", "audio": "wbw/064_001_007.mp3"}, {"type": "word", "ar": "ٱلْأَرْضِ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ‌ۖ", "en": "the earth", "tr": "l-arḍi", "audio": "wbw/064_001_008.mp3"}, {"type": "word", "ar": "لَهُ", "tajweed": "لَهُ", "en": "For Him", "tr": "lahu", "audio": "wbw/064_001_010.mp3"}, {"type": "word", "ar": "ٱلْمُلْكُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُلۡكُ", "en": "(is the) dominion", "tr": "l-mul'ku", "audio": "wbw/064_001_011.mp3"}, {"type": "word", "ar": "وَلَهُ", "tajweed": "وَلَهُ", "en": "and for Him", "tr": "walahu", "audio": "wbw/064_001_012.mp3"}, {"type": "word", "ar": "ٱلْحَمْدُ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَمۡدُ‌ۖ", "en": "(is) the praise", "tr": "l-ḥamdu", "audio": "wbw/064_001_013.mp3"}, {"type": "word", "ar": "وَهُوَ", "tajweed": "وَهُوَ", "en": "And He", "tr": "wahuwa", "audio": "wbw/064_001_015.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "(is) on", "tr": "ʿalā", "audio": "wbw/064_001_016.mp3"}, {"type": "word", "ar": "كُلِّ", "tajweed": "كُلِّ", "en": "every", "tr": "kulli", "audio": "wbw/064_001_017.mp3"}, {"type": "word", "ar": "شَىْءٍۢ", "tajweed": "ش<rule class=ikhafa>َىۡءٍ</rule>", "en": "thing", "tr": "shayin", "audio": "wbw/064_001_018.mp3"}, {"type": "word", "ar": "قَدِيرٌ", "tajweed": "<rule class=ikhafa>ق</rule>َد<rule class=madda_permissible>ِي</rule>رٌ", "en": "All-Powerful", "tr": "qadīrun", "audio": "wbw/064_001_019.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "64:2", "juz": 28, "page": 556, "side_trans": "It is He who created you, and among you is the disbeliever, and among you is the believer. And Allāh, of what you do, is Seeing.", "words": [{"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "He", "tr": "huwa", "audio": "wbw/064_002_001.mp3"}, {"type": "word", "ar": "ٱلَّذِى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِى", "en": "(is) the One Who", "tr": "alladhī", "audio": "wbw/064_002_002.mp3"}, {"type": "word", "ar": "خَلَقَكُمْ", "tajweed": "خَلَقَكُمۡ", "en": "created you", "tr": "khalaqakum", "audio": "wbw/064_002_003.mp3"}, {"type": "word", "ar": "فَمِنكُمْ", "tajweed": "فَمِ<rule class=ikhafa>نك</rule>ُمۡ", "en": "and among you", "tr": "faminkum", "audio": "wbw/064_002_004.mp3"}, {"type": "word", "ar": "كَافِرٌۭ", "tajweed": "كَافِ<rule class=idgham_ghunnah>رٌ</rule>", "en": "(is) a disbeliever", "tr": "kāfirun", "audio": "wbw/064_002_005.mp3"}, {"type": "word", "ar": "وَمِنكُم", "tajweed": "<rule class=idgham_ghunnah>و</rule>َمِ<rule class=ikhafa>نك</rule><rule class=idgham_shafawi>ُم</rule>", "en": "and among you", "tr": "waminkum", "audio": "wbw/064_002_006.mp3"}, {"type": "word", "ar": "مُّؤْمِنٌۭ ۚ", "tajweed": "<rule class=idgham_shafawi>م</rule>ُّؤۡمِ<rule class=idgham_ghunnah>نٌ‌ۚ</rule>", "en": "(is) a believer", "tr": "mu'minun", "audio": "wbw/064_002_007.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/064_002_009.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "بِمَا", "en": "of what", "tr": "bimā", "audio": "wbw/064_002_010.mp3"}, {"type": "word", "ar": "تَعْمَلُونَ", "tajweed": "تَعۡمَلُونَ", "en": "you do", "tr": "taʿmalūna", "audio": "wbw/064_002_011.mp3"}, {"type": "word", "ar": "بَصِيرٌ", "tajweed": "بَص<rule class=madda_permissible>ِي</rule>رٌ", "en": "(is) All-Seer", "tr": "baṣīrun", "audio": "wbw/064_002_012.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "64:3", "juz": 28, "page": 556, "side_trans": "He created the heavens and earth in truth and formed you and perfected your forms; and to Him is the [final] destination.", "words": [{"type": "word", "ar": "خَلَقَ", "tajweed": "خَلَقَ", "en": "He created", "tr": "khalaqa", "audio": "wbw/064_003_001.mp3"}, {"type": "word", "ar": "ٱلسَّمَـٰوَٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّمَ<rule class=madda_normal>ـٰ</rule>و<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِ", "en": "the heavens", "tr": "l-samāwāti", "audio": "wbw/064_003_002.mp3"}, {"type": "word", "ar": "وَٱلْأَرْضَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأَرۡضَ", "en": "and the earth", "tr": "wal-arḍa", "audio": "wbw/064_003_003.mp3"}, {"type": "word", "ar": "بِٱلْحَقِّ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡحَقِّ", "en": "with truth", "tr": "bil-ḥaqi", "audio": "wbw/064_003_004.mp3"}, {"type": "word", "ar": "وَصَوَّرَكُمْ", "tajweed": "وَصَوَّرَكُمۡ", "en": "and He formed you", "tr": "waṣawwarakum", "audio": "wbw/064_003_005.mp3"}, {"type": "word", "ar": "فَأَحْسَنَ", "tajweed": "فَأَحۡسَنَ", "en": "and made good", "tr": "fa-aḥsana", "audio": "wbw/064_003_006.mp3"}, {"type": "word", "ar": "صُوَرَكُمْ ۖ", "tajweed": "صُوَرَكُمۡ‌ۖ", "en": "your forms", "tr": "ṣuwarakum", "audio": "wbw/064_003_007.mp3"}, {"type": "word", "ar": "وَإِلَيْهِ", "tajweed": "وَإِلَيۡهِ", "en": "and to Him", "tr": "wa-ilayhi", "audio": "wbw/064_003_009.mp3"}, {"type": "word", "ar": "ٱلْمَصِيرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَص<rule class=madda_permissible>ِي</rule>رُ", "en": "(is) the final return", "tr": "l-maṣīru", "audio": "wbw/064_003_010.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "64:4", "juz": 28, "page": 556, "side_trans": "He knows what is within the heavens and earth and knows what you conceal and what you declare. And Allāh is Knowing of that within the breasts.", "words": [{"type": "word", "ar": "يَعْلَمُ", "tajweed": "يَعۡلَمُ", "en": "He knows", "tr": "yaʿlamu", "audio": "wbw/064_004_001.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/064_004_002.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(is) in", "tr": "fī", "audio": "wbw/064_004_003.mp3"}, {"type": "word", "ar": "ٱلسَّمَـٰوَٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّمَ<rule class=madda_normal>ـٰ</rule>و<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِ", "en": "the heavens", "tr": "l-samāwāti", "audio": "wbw/064_004_004.mp3"}, {"type": "word", "ar": "وَٱلْأَرْضِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "and the earth", "tr": "wal-arḍi", "audio": "wbw/064_004_005.mp3"}, {"type": "word", "ar": "وَيَعْلَمُ", "tajweed": "وَيَعۡلَمُ", "en": "and He knows", "tr": "wayaʿlamu", "audio": "wbw/064_004_006.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/064_004_007.mp3"}, {"type": "word", "ar": "تُسِرُّونَ", "tajweed": "تُسِرُّونَ", "en": "you conceal", "tr": "tusirrūna", "audio": "wbw/064_004_008.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "and what", "tr": "wamā", "audio": "wbw/064_004_009.mp3"}, {"type": "word", "ar": "تُعْلِنُونَ ۚ", "tajweed": "تُعۡلِنُونَ‌ۚ", "en": "you declare", "tr": "tuʿ'linūna", "audio": "wbw/064_004_010.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/064_004_012.mp3"}, {"type": "word", "ar": "عَلِيمٌۢ", "tajweed": "عَلِي<rule class=iqlab>مُۢ</rule>", "en": "(is) All-Knowing", "tr": "ʿalīmun", "audio": "wbw/064_004_013.mp3"}, {"type": "word", "ar": "بِذَاتِ", "tajweed": "<rule class=iqlab>ب</rule>ِذَاتِ", "en": "of what", "tr": "bidhāti", "audio": "wbw/064_004_014.mp3"}, {"type": "word", "ar": "ٱلصُّدُورِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صُّد<rule class=madda_permissible>ُو</rule>رِ", "en": "(is in) the breasts", "tr": "l-ṣudūri", "audio": "wbw/064_004_015.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "64:5", "juz": 28, "page": 556, "side_trans": "Has there not come to you the news of those who disbelieved before? So they tasted the bad consequence of their affair, and they will have a painful punishment.", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Has not", "tr": "alam", "audio": "wbw/064_005_001.mp3"}, {"type": "word", "ar": "يَأْتِكُمْ", "tajweed": "يَأۡتِكُمۡ", "en": "come to you", "tr": "yatikum", "audio": "wbw/064_005_002.mp3"}, {"type": "word", "ar": "نَبَؤُا۟", "tajweed": "نَبَؤُ<rule class=slnt>اۡ</rule>", "en": "(the) news", "tr": "naba-u", "audio": "wbw/064_005_003.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "(of) those who", "tr": "alladhīna", "audio": "wbw/064_005_004.mp3"}, {"type": "word", "ar": "كَفَرُوا۟", "tajweed": "كَفَرُو<rule class=slnt>اۡ</rule>", "en": "disbelieved", "tr": "kafarū", "audio": "wbw/064_005_005.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/064_005_006.mp3"}, {"type": "word", "ar": "قَبْلُ", "tajweed": "<rule class=ikhafa>ق</rule>َ<rule class=qalaqah>بۡ</rule>لُ", "en": "before", "tr": "qablu", "audio": "wbw/064_005_007.mp3"}, {"type": "word", "ar": "فَذَاقُوا۟", "tajweed": "فَذَاقُو<rule class=slnt>اۡ</rule>", "en": "So they tasted", "tr": "fadhāqū", "audio": "wbw/064_005_008.mp3"}, {"type": "word", "ar": "وَبَالَ", "tajweed": "وَبَالَ", "en": "(the bad) consequence", "tr": "wabāla", "audio": "wbw/064_005_009.mp3"}, {"type": "word", "ar": "أَمْرِهِمْ", "tajweed": "أَمۡرِهِمۡ", "en": "(of) their affair", "tr": "amrihim", "audio": "wbw/064_005_010.mp3"}, {"type": "word", "ar": "وَلَهُمْ", "tajweed": "وَلَهُمۡ", "en": "and for them", "tr": "walahum", "audio": "wbw/064_005_011.mp3"}, {"type": "word", "ar": "عَذَابٌ", "tajweed": "عَذَابٌ", "en": "(is) a punishment", "tr": "ʿadhābun", "audio": "wbw/064_005_012.mp3"}, {"type": "word", "ar": "أَلِيمٌۭ", "tajweed": "أَل<rule class=madda_permissible>ِي</rule>مٌ", "en": "painful", "tr": "alīmun", "audio": "wbw/064_005_013.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "64:6", "juz": 28, "page": 556, "side_trans": "That is because their messengers used to come to them with clear evidences, but they said, \"Shall human beings guide us?\" and disbelieved and turned away. And Allāh dispensed [with them]; and Allāh is Free of need and Praiseworthy.", "words": [{"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "That", "tr": "dhālika", "audio": "wbw/064_006_001.mp3"}, {"type": "word", "ar": "بِأَنَّهُۥ", "tajweed": "بِأَ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "(is) because", "tr": "bi-annahu", "audio": "wbw/064_006_002.mp3"}, {"type": "word", "ar": "كَانَت", "tajweed": "كَانَت", "en": "had", "tr": "kānat", "audio": "wbw/064_006_003.mp3"}, {"type": "word", "ar": "تَّأْتِيهِمْ", "tajweed": "تَّأۡتِيهِمۡ", "en": "come to them", "tr": "tatīhim", "audio": "wbw/064_006_004.mp3"}, {"type": "word", "ar": "رُسُلُهُم", "tajweed": "رُسُلُه<rule class=ikhafa_shafawi>ُم</rule>", "en": "their Messengers", "tr": "rusuluhum", "audio": "wbw/064_006_005.mp3"}, {"type": "word", "ar": "بِٱلْبَيِّنَـٰتِ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِ<rule class=ham_wasl>ٱ</rule>لۡبَيِّنَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "with clear proofs", "tr": "bil-bayināti", "audio": "wbw/064_006_006.mp3"}, {"type": "word", "ar": "فَقَالُوٓا۟", "tajweed": "فَقَال<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "but they said", "tr": "faqālū", "audio": "wbw/064_006_007.mp3"}, {"type": "word", "ar": "أَبَشَرٌۭ", "tajweed": "أَبَشَ<rule class=idgham_ghunnah>رٌ</rule>", "en": "Shall human beings", "tr": "abasharun", "audio": "wbw/064_006_008.mp3"}, {"type": "word", "ar": "يَهْدُونَنَا", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َهۡدُونَنَا", "en": "guide us", "tr": "yahdūnanā", "audio": "wbw/064_006_009.mp3"}, {"type": "word", "ar": "فَكَفَرُوا۟", "tajweed": "فَكَفَرُو<rule class=slnt>اۡ</rule>", "en": "So they disbelieved", "tr": "fakafarū", "audio": "wbw/064_006_010.mp3"}, {"type": "word", "ar": "وَتَوَلَّوا۟ ۚ", "tajweed": "وَتَوَلَّو<rule class=slnt>اۡ‌ۚ</rule>", "en": "and turned away", "tr": "watawallaw", "audio": "wbw/064_006_011.mp3"}, {"type": "word", "ar": "وَّٱسْتَغْنَى", "tajweed": "وَّ<rule class=ham_wasl>ٱ</rule>سۡتَغۡنَى", "en": "And can do without them", "tr": "wa-is'taghnā", "audio": "wbw/064_006_013.mp3"}, {"type": "word", "ar": "ٱللَّهُ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ‌ۚ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/064_006_014.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/064_006_016.mp3"}, {"type": "word", "ar": "غَنِىٌّ", "tajweed": "غَنِىٌّ", "en": "(is) Self-sufficient", "tr": "ghaniyyun", "audio": "wbw/064_006_017.mp3"}, {"type": "word", "ar": "حَمِيدٌۭ", "tajweed": "حَم<rule class=madda_permissible>ِي</rule><rule class=qalaqah>د</rule>ٌ", "en": "Praiseworthy", "tr": "ḥamīdun", "audio": "wbw/064_006_018.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "64:7", "juz": 28, "page": 556, "side_trans": "Those who disbelieve have claimed that they will never be resurrected. Say, \"Yes, by my Lord, you will surely be resurrected; then you will surely be informed of what you did. And that, for Allāh, is easy.\"", "words": [{"type": "word", "ar": "زَعَمَ", "tajweed": "زَعَمَ", "en": "Claim", "tr": "zaʿama", "audio": "wbw/064_007_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/064_007_002.mp3"}, {"type": "word", "ar": "كَفَرُوٓا۟", "tajweed": "كَفَر<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "disbelieve", "tr": "kafarū", "audio": "wbw/064_007_003.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_wo_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/064_007_004.mp3"}, {"type": "word", "ar": "لَّن", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ّ<rule class=idgham_ghunnah>َن</rule>", "en": "never", "tr": "lan", "audio": "wbw/064_007_005.mp3"}, {"type": "word", "ar": "يُبْعَثُوا۟ ۚ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُ<rule class=qalaqah>بۡ</rule>عَثُو<rule class=slnt>اۡ‌ۚ</rule>", "en": "will they be raised", "tr": "yub'ʿathū", "audio": "wbw/064_007_006.mp3"}, {"type": "word", "ar": "قُلْ", "tajweed": "قُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/064_007_008.mp3"}, {"type": "word", "ar": "بَلَىٰ", "tajweed": "بَلَىٰ", "en": "Yes", "tr": "balā", "audio": "wbw/064_007_009.mp3"}, {"type": "word", "ar": "وَرَبِّى", "tajweed": "وَرَبِّى", "en": "by my Lord", "tr": "warabbī", "audio": "wbw/064_007_010.mp3"}, {"type": "word", "ar": "لَتُبْعَثُنَّ", "tajweed": "لَتُ<rule class=qalaqah>بۡ</rule>عَثُ<rule class=ghunnah>نّ</rule>َ", "en": "surely you will be raised", "tr": "latub'ʿathunna", "audio": "wbw/064_007_011.mp3"}, {"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "then", "tr": "thumma", "audio": "wbw/064_007_012.mp3"}, {"type": "word", "ar": "لَتُنَبَّؤُنَّ", "tajweed": "لَتُنَبَّؤُ<rule class=ghunnah>نّ</rule>َ", "en": "surely you will be informed", "tr": "latunabba-unna", "audio": "wbw/064_007_013.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "بِمَا", "en": "of what", "tr": "bimā", "audio": "wbw/064_007_014.mp3"}, {"type": "word", "ar": "عَمِلْتُمْ ۚ", "tajweed": "عَمِلۡتُمۡ‌ۚ", "en": "you did", "tr": "ʿamil'tum", "audio": "wbw/064_007_015.mp3"}, {"type": "word", "ar": "وَذَٰلِكَ", "tajweed": "وَذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "And that", "tr": "wadhālika", "audio": "wbw/064_007_017.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "for", "tr": "ʿalā", "audio": "wbw/064_007_018.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/064_007_019.mp3"}, {"type": "word", "ar": "يَسِيرٌۭ", "tajweed": "يَس<rule class=madda_permissible>ِي</rule>رٌ", "en": "(is) easy", "tr": "yasīrun", "audio": "wbw/064_007_020.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "64:8", "juz": 28, "page": 556, "side_trans": "So believe in Allāh and His Messenger and the light [i.e., the Qur’ān] which We have sent down. And Allāh is Aware of what you do.", "words": [{"type": "word", "ar": "فَـَٔامِنُوا۟", "tajweed": "فَـَٔـامِنُو<rule class=slnt>اۡ</rule>", "en": "So believe", "tr": "faāminū", "audio": "wbw/064_008_001.mp3"}, {"type": "word", "ar": "بِٱللَّهِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "in Allah", "tr": "bil-lahi", "audio": "wbw/064_008_002.mp3"}, {"type": "word", "ar": "وَرَسُولِهِۦ", "tajweed": "وَرَسُولِه<rule class=madda_normal>ِۦ</rule>", "en": "and His Messenger", "tr": "warasūlihi", "audio": "wbw/064_008_003.mp3"}, {"type": "word", "ar": "وَٱلنُّورِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>ُورِ", "en": "and the Light", "tr": "wal-nūri", "audio": "wbw/064_008_004.mp3"}, {"type": "word", "ar": "ٱلَّذِىٓ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذ<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "which", "tr": "alladhī", "audio": "wbw/064_008_005.mp3"}, {"type": "word", "ar": "أَنزَلْنَا ۚ", "tajweed": "أَ<rule class=ikhafa>نز</rule>َلۡنَا‌ۚ", "en": "We have sent down", "tr": "anzalnā", "audio": "wbw/064_008_006.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/064_008_008.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "بِمَا", "en": "of what", "tr": "bimā", "audio": "wbw/064_008_009.mp3"}, {"type": "word", "ar": "تَعْمَلُونَ", "tajweed": "تَعۡمَلُونَ", "en": "you do", "tr": "taʿmalūna", "audio": "wbw/064_008_010.mp3"}, {"type": "word", "ar": "خَبِيرٌۭ", "tajweed": "خَب<rule class=madda_permissible>ِي</rule>رٌ", "en": "(is) All-Aware", "tr": "khabīrun", "audio": "wbw/064_008_011.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "64:9", "juz": 28, "page": 556, "side_trans": "The Day He will assemble you for the Day of Assembly - that is the Day of Deprivation. And whoever believes in Allāh and does righteousness - He will remove from him his misdeeds and admit him to gardens beneath which rivers flow, wherein they will abide forever. That is the great attainment.", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(The) Day", "tr": "yawma", "audio": "wbw/064_009_001.mp3"}, {"type": "word", "ar": "يَجْمَعُكُمْ", "tajweed": "يَ<rule class=qalaqah>جۡ</rule>مَعُكُمۡ", "en": "He will assemble you", "tr": "yajmaʿukum", "audio": "wbw/064_009_002.mp3"}, {"type": "word", "ar": "لِيَوْمِ", "tajweed": "لِيَوۡمِ", "en": "for (the) Day", "tr": "liyawmi", "audio": "wbw/064_009_003.mp3"}, {"type": "word", "ar": "ٱلْجَمْعِ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجَمۡعِ‌ۖ", "en": "(of) the Assembly", "tr": "l-jamʿi", "audio": "wbw/064_009_004.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "that", "tr": "dhālika", "audio": "wbw/064_009_006.mp3"}, {"type": "word", "ar": "يَوْمُ", "tajweed": "يَوۡمُ", "en": "(will be the) Day", "tr": "yawmu", "audio": "wbw/064_009_007.mp3"}, {"type": "word", "ar": "ٱلتَّغَابُنِ ۗ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>تَّغَابُنِ‌ۗ", "en": "(of) mutual loss and gain", "tr": "l-taghābuni", "audio": "wbw/064_009_008.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/064_009_010.mp3"}, {"type": "word", "ar": "يُؤْمِنۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُؤۡم<rule class=iqlab>ِنۢ</rule>", "en": "believes", "tr": "yu'min", "audio": "wbw/064_009_011.mp3"}, {"type": "word", "ar": "بِٱللَّهِ", "tajweed": "<rule class=iqlab>ب</rule>ِ<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "in Allah", "tr": "bil-lahi", "audio": "wbw/064_009_012.mp3"}, {"type": "word", "ar": "وَيَعْمَلْ", "tajweed": "وَيَعۡمَلۡ", "en": "and does", "tr": "wayaʿmal", "audio": "wbw/064_009_013.mp3"}, {"type": "word", "ar": "صَـٰلِحًۭا", "tajweed": "صَ<rule class=madda_normal>ـٰ</rule>لِ<rule class=idgham_ghunnah>حًا</rule>", "en": "righteous deeds", "tr": "ṣāliḥan", "audio": "wbw/064_009_014.mp3"}, {"type": "word", "ar": "يُكَفِّرْ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُكَفِّرۡ", "en": "He will remove", "tr": "yukaffir", "audio": "wbw/064_009_015.mp3"}, {"type": "word", "ar": "عَنْهُ", "tajweed": "عَنۡهُ", "en": "from him", "tr": "ʿanhu", "audio": "wbw/064_009_016.mp3"}, {"type": "word", "ar": "سَيِّـَٔاتِهِۦ", "tajweed": "سَيِّـَٔـاتِه<rule class=madda_normal>ِۦ</rule>", "en": "his evil deeds", "tr": "sayyiātihi", "audio": "wbw/064_009_017.mp3"}, {"type": "word", "ar": "وَيُدْخِلْهُ", "tajweed": "وَيُ<rule class=qalaqah>دۡ</rule>خِلۡهُ", "en": "and He will admit him", "tr": "wayud'khil'hu", "audio": "wbw/064_009_018.mp3"}, {"type": "word", "ar": "جَنَّـٰتٍۢ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule><rule class=ikhafa>تٍ</rule>", "en": "(to) Gardens", "tr": "jannātin", "audio": "wbw/064_009_019.mp3"}, {"type": "word", "ar": "تَجْرِى", "tajweed": "<rule class=ikhafa>ت</rule>َ<rule class=qalaqah>جۡ</rule>رِى", "en": "flow", "tr": "tajrī", "audio": "wbw/064_009_020.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/064_009_021.mp3"}, {"type": "word", "ar": "تَحْتِهَا", "tajweed": "<rule class=ikhafa>ت</rule>َحۡتِهَا", "en": "underneath it", "tr": "taḥtihā", "audio": "wbw/064_009_022.mp3"}, {"type": "word", "ar": "ٱلْأَنْهَـٰرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَنۡهَ<rule class=madda_normal>ـٰ</rule>رُ", "en": "the rivers", "tr": "l-anhāru", "audio": "wbw/064_009_023.mp3"}, {"type": "word", "ar": "خَـٰلِدِينَ", "tajweed": "خَ<rule class=madda_normal>ـٰ</rule>لِدِينَ", "en": "abiding", "tr": "khālidīna", "audio": "wbw/064_009_024.mp3"}, {"type": "word", "ar": "فِيهَآ", "tajweed": "فِيه<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "therein", "tr": "fīhā", "audio": "wbw/064_009_025.mp3"}, {"type": "word", "ar": "أَبَدًۭا ۚ", "tajweed": "أَبَ<rule class=ikhafa>دًا‌ۚ</rule>", "en": "forever", "tr": "abadan", "audio": "wbw/064_009_026.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "<rule class=ikhafa>ذ</rule><rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "That", "tr": "dhālika", "audio": "wbw/064_009_028.mp3"}, {"type": "word", "ar": "ٱلْفَوْزُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَوۡزُ", "en": "(is) the success", "tr": "l-fawzu", "audio": "wbw/064_009_029.mp3"}, {"type": "word", "ar": "ٱلْعَظِيمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَظ<rule class=madda_permissible>ِي</rule>مُ", "en": "the great", "tr": "l-ʿaẓīmu", "audio": "wbw/064_009_030.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "64:10", "juz": 28, "page": 557, "side_trans": "But the ones who disbelieved and denied Our verses - those are the companions of the Fire, abiding eternally therein; and wretched is the destination.", "words": [{"type": "word", "ar": "وَٱلَّذِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "But those who", "tr": "wa-alladhīna", "audio": "wbw/064_010_001.mp3"}, {"type": "word", "ar": "كَفَرُوا۟", "tajweed": "كَفَرُو<rule class=slnt>اۡ</rule>", "en": "disbelieved", "tr": "kafarū", "audio": "wbw/064_010_002.mp3"}, {"type": "word", "ar": "وَكَذَّبُوا۟", "tajweed": "وَكَذَّبُو<rule class=slnt>اۡ</rule>", "en": "and denied", "tr": "wakadhabū", "audio": "wbw/064_010_003.mp3"}, {"type": "word", "ar": "بِـَٔايَـٰتِنَآ", "tajweed": "بِـَٔـايَ<rule class=madda_normal>ـٰ</rule>تِن<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "[in] Our Verses", "tr": "biāyātinā", "audio": "wbw/064_010_004.mp3"}, {"type": "word", "ar": "أُو۟لَـٰٓئِكَ", "tajweed": "أُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَ", "en": "those", "tr": "ulāika", "audio": "wbw/064_010_005.mp3"}, {"type": "word", "ar": "أَصْحَـٰبُ", "tajweed": "أَصۡحَ<rule class=madda_normal>ـٰ</rule>بُ", "en": "(are the) companions", "tr": "aṣḥābu", "audio": "wbw/064_010_006.mp3"}, {"type": "word", "ar": "ٱلنَّارِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َارِ", "en": "(of) the Fire", "tr": "l-nāri", "audio": "wbw/064_010_007.mp3"}, {"type": "word", "ar": "خَـٰلِدِينَ", "tajweed": "خَ<rule class=madda_normal>ـٰ</rule>لِدِينَ", "en": "abiding forever", "tr": "khālidīna", "audio": "wbw/064_010_008.mp3"}, {"type": "word", "ar": "فِيهَا ۖ", "tajweed": "فِيهَا‌ۖ", "en": "therein", "tr": "fīhā", "audio": "wbw/064_010_009.mp3"}, {"type": "word", "ar": "وَبِئْسَ", "tajweed": "وَبِئۡسَ", "en": "And wretched is", "tr": "wabi'sa", "audio": "wbw/064_010_011.mp3"}, {"type": "word", "ar": "ٱلْمَصِيرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَص<rule class=madda_permissible>ِي</rule>رُ", "en": "the destination", "tr": "l-maṣīru", "audio": "wbw/064_010_012.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "64:11", "juz": 28, "page": 557, "side_trans": "No disaster strikes except by permission of Allāh. And whoever believes in Allāh - He will guide his heart. And Allāh is Knowing of all things.", "words": [{"type": "word", "ar": "مَآ", "tajweed": "م<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Not", "tr": "mā", "audio": "wbw/064_011_001.mp3"}, {"type": "word", "ar": "أَصَابَ", "tajweed": "أَصَابَ", "en": "strikes", "tr": "aṣāba", "audio": "wbw/064_011_002.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_ghunnah>ِن</rule>", "en": "any", "tr": "min", "audio": "wbw/064_011_003.mp3"}, {"type": "word", "ar": "مُّصِيبَةٍ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّصِيبَةٍ", "en": "disaster", "tr": "muṣībatin", "audio": "wbw/064_011_004.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/064_011_005.mp3"}, {"type": "word", "ar": "بِإِذْنِ", "tajweed": "بِإِذۡنِ", "en": "by (the) permission", "tr": "bi-idh'ni", "audio": "wbw/064_011_006.mp3"}, {"type": "word", "ar": "ٱللَّهِ ۗ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ‌ۗ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/064_011_007.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/064_011_009.mp3"}, {"type": "word", "ar": "يُؤْمِنۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُؤۡم<rule class=iqlab>ِنۢ</rule>", "en": "believes", "tr": "yu'min", "audio": "wbw/064_011_010.mp3"}, {"type": "word", "ar": "بِٱللَّهِ", "tajweed": "<rule class=iqlab>ب</rule>ِ<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "in Allah", "tr": "bil-lahi", "audio": "wbw/064_011_011.mp3"}, {"type": "word", "ar": "يَهْدِ", "tajweed": "يَهۡدِ", "en": "He guides", "tr": "yahdi", "audio": "wbw/064_011_012.mp3"}, {"type": "word", "ar": "قَلْبَهُۥ ۚ", "tajweed": "قَلۡبَهُ<rule class=madda_normal>ۥ</rule>‌ۚ", "en": "his heart", "tr": "qalbahu", "audio": "wbw/064_011_013.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/064_011_015.mp3"}, {"type": "word", "ar": "بِكُلِّ", "tajweed": "بِكُلِّ", "en": "of every", "tr": "bikulli", "audio": "wbw/064_011_016.mp3"}, {"type": "word", "ar": "شَىْءٍ", "tajweed": "شَىۡءٍ", "en": "thing", "tr": "shayin", "audio": "wbw/064_011_017.mp3"}, {"type": "word", "ar": "عَلِيمٌۭ", "tajweed": "عَل<rule class=madda_permissible>ِي</rule>مٌ", "en": "(is) All-Knowing", "tr": "ʿalīmun", "audio": "wbw/064_011_018.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "64:12", "juz": 28, "page": 557, "side_trans": "And obey Allāh and obey the Messenger; but if you turn away - then upon Our Messenger is only [the duty of] clear notification.", "words": [{"type": "word", "ar": "وَأَطِيعُوا۟", "tajweed": "وَأَطِيعُو<rule class=slnt>اۡ</rule>", "en": "So obey", "tr": "wa-aṭīʿū", "audio": "wbw/064_012_001.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/064_012_002.mp3"}, {"type": "word", "ar": "وَأَطِيعُوا۟", "tajweed": "وَأَطِيعُو<rule class=slnt>اۡ</rule>", "en": "and obey", "tr": "wa-aṭīʿū", "audio": "wbw/064_012_003.mp3"}, {"type": "word", "ar": "ٱلرَّسُولَ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رَّسُولَ‌ۚ", "en": "the Messenger", "tr": "l-rasūla", "audio": "wbw/064_012_004.mp3"}, {"type": "word", "ar": "فَإِن", "tajweed": "فَإِ<rule class=ikhafa>ن</rule>", "en": "but if", "tr": "fa-in", "audio": "wbw/064_012_006.mp3"}, {"type": "word", "ar": "تَوَلَّيْتُمْ", "tajweed": "<rule class=ikhafa>ت</rule>َوَلَّيۡتُمۡ", "en": "you turn away", "tr": "tawallaytum", "audio": "wbw/064_012_007.mp3"}, {"type": "word", "ar": "فَإِنَّمَا", "tajweed": "فَإِ<rule class=ghunnah>نّ</rule>َمَا", "en": "then only", "tr": "fa-innamā", "audio": "wbw/064_012_008.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "upon", "tr": "ʿalā", "audio": "wbw/064_012_009.mp3"}, {"type": "word", "ar": "رَسُولِنَا", "tajweed": "رَسُولِنَا", "en": "Our Messenger", "tr": "rasūlinā", "audio": "wbw/064_012_010.mp3"}, {"type": "word", "ar": "ٱلْبَلَـٰغُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبَلَ<rule class=madda_normal>ـٰ</rule>غُ", "en": "(is) the conveyance", "tr": "l-balāghu", "audio": "wbw/064_012_011.mp3"}, {"type": "word", "ar": "ٱلْمُبِينُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُب<rule class=madda_permissible>ِي</rule>نُ", "en": "clear", "tr": "l-mubīnu", "audio": "wbw/064_012_012.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "64:13", "juz": 28, "page": 557, "side_trans": "Allāh - there is no deity except Him. And upon Allāh let the believers rely.", "words": [{"type": "word", "ar": "ٱللَّهُ", "tajweed": "ٱللَّهُ", "en": "Allah", "tr": "al-lahu", "audio": "wbw/064_013_001.mp3"}, {"type": "word", "ar": "لَآ", "tajweed": "ل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "(there is) no", "tr": "lā", "audio": "wbw/064_013_002.mp3"}, {"type": "word", "ar": "إِلَـٰهَ", "tajweed": "إِلَ<rule class=madda_normal>ـٰ</rule>هَ", "en": "god", "tr": "ilāha", "audio": "wbw/064_013_003.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/064_013_004.mp3"}, {"type": "word", "ar": "هُوَ ۚ", "tajweed": "هُوَ‌ۚ", "en": "Him", "tr": "huwa", "audio": "wbw/064_013_005.mp3"}, {"type": "word", "ar": "وَعَلَى", "tajweed": "وَعَلَى", "en": "And upon", "tr": "waʿalā", "audio": "wbw/064_013_007.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/064_013_008.mp3"}, {"type": "word", "ar": "فَلْيَتَوَكَّلِ", "tajweed": "فَلۡيَتَوَكَّلِ", "en": "let put (their) trust", "tr": "falyatawakkali", "audio": "wbw/064_013_009.mp3"}, {"type": "word", "ar": "ٱلْمُؤْمِنُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُؤۡمِن<rule class=madda_permissible>ُو</rule>نَ", "en": "the believers", "tr": "l-mu'minūna", "audio": "wbw/064_013_010.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "64:14", "juz": 28, "page": 557, "side_trans": "O you who have believed, indeed, among your spouses and your children are enemies to you, so beware of them. But if you pardon and overlook and forgive - then indeed, Allāh is Forgiving and Merciful.", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/064_014_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "(you) who", "tr": "alladhīna", "audio": "wbw/064_014_002.mp3"}, {"type": "word", "ar": "ءَامَنُوٓا۟", "tajweed": "ءَامَن<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/064_014_003.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/064_014_004.mp3"}, {"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "from", "tr": "min", "audio": "wbw/064_014_005.mp3"}, {"type": "word", "ar": "أَزْوَٰجِكُمْ", "tajweed": "أَزۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>جِكُمۡ", "en": "your spouses", "tr": "azwājikum", "audio": "wbw/064_014_006.mp3"}, {"type": "word", "ar": "وَأَوْلَـٰدِكُمْ", "tajweed": "وَأَوۡلَ<rule class=madda_normal>ـٰ</rule>دِكُمۡ", "en": "and your children", "tr": "wa-awlādikum", "audio": "wbw/064_014_007.mp3"}, {"type": "word", "ar": "عَدُوًّۭا", "tajweed": "عَدُو<rule class=idgham_wo_ghunnah>ًّا</rule>", "en": "(are) enemies", "tr": "ʿaduwwan", "audio": "wbw/064_014_008.mp3"}, {"type": "word", "ar": "لَّكُمْ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّكُمۡ", "en": "to you", "tr": "lakum", "audio": "wbw/064_014_009.mp3"}, {"type": "word", "ar": "فَٱحْذَرُوهُمْ ۚ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>حۡذَرُوهُمۡ‌ۚ", "en": "so beware of them", "tr": "fa-iḥ'dharūhum", "audio": "wbw/064_014_010.mp3"}, {"type": "word", "ar": "وَإِن", "tajweed": "وَإِ<rule class=ikhafa>ن</rule>", "en": "But if", "tr": "wa-in", "audio": "wbw/064_014_012.mp3"}, {"type": "word", "ar": "تَعْفُوا۟", "tajweed": "<rule class=ikhafa>ت</rule>َعۡفُو<rule class=slnt>اۡ</rule>", "en": "you pardon", "tr": "taʿfū", "audio": "wbw/064_014_013.mp3"}, {"type": "word", "ar": "وَتَصْفَحُوا۟", "tajweed": "وَتَصۡفَحُو<rule class=slnt>اۡ</rule>", "en": "and overlook", "tr": "wataṣfaḥū", "audio": "wbw/064_014_014.mp3"}, {"type": "word", "ar": "وَتَغْفِرُوا۟", "tajweed": "وَتَغۡفِرُو<rule class=slnt>اۡ</rule>", "en": "and forgive", "tr": "wataghfirū", "audio": "wbw/064_014_015.mp3"}, {"type": "word", "ar": "فَإِنَّ", "tajweed": "فَإِ<rule class=ghunnah>نّ</rule>َ", "en": "then indeed", "tr": "fa-inna", "audio": "wbw/064_014_016.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/064_014_017.mp3"}, {"type": "word", "ar": "غَفُورٌۭ", "tajweed": "غَفُو<rule class=idgham_wo_ghunnah>رٌ</rule>", "en": "(is) Oft-Forgiving", "tr": "ghafūrun", "audio": "wbw/064_014_018.mp3"}, {"type": "word", "ar": "رَّحِيمٌ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّح<rule class=madda_permissible>ِي</rule>مٌ", "en": "Most Merciful", "tr": "raḥīmun", "audio": "wbw/064_014_019.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "64:15", "juz": 28, "page": 557, "side_trans": "Your wealth and your children are but a trial, and Allāh has with Him a great reward.", "words": [{"type": "word", "ar": "إِنَّمَآ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Only", "tr": "innamā", "audio": "wbw/064_015_001.mp3"}, {"type": "word", "ar": "أَمْوَٰلُكُمْ", "tajweed": "أَمۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لُكُمۡ", "en": "your wealth", "tr": "amwālukum", "audio": "wbw/064_015_002.mp3"}, {"type": "word", "ar": "وَأَوْلَـٰدُكُمْ", "tajweed": "وَأَوۡلَ<rule class=madda_normal>ـٰ</rule>دُكُمۡ", "en": "and your children", "tr": "wa-awlādukum", "audio": "wbw/064_015_003.mp3"}, {"type": "word", "ar": "فِتْنَةٌۭ ۚ", "tajweed": "فِتۡنَ<rule class=idgham_ghunnah>ةٌ‌ۚ</rule>", "en": "(are) a trial", "tr": "fit'natun", "audio": "wbw/064_015_004.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "and Allah ", "tr": "wal-lahu", "audio": "wbw/064_015_006.mp3"}, {"type": "word", "ar": "عِندَهُۥٓ", "tajweed": "عِ<rule class=ikhafa>ند</rule>َهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "with Him", "tr": "ʿindahu", "audio": "wbw/064_015_007.mp3"}, {"type": "word", "ar": "أَجْرٌ", "tajweed": "أَ<rule class=qalaqah>جۡ</rule>رٌ", "en": "(is) a reward", "tr": "ajrun", "audio": "wbw/064_015_008.mp3"}, {"type": "word", "ar": "عَظِيمٌۭ", "tajweed": "عَظ<rule class=madda_permissible>ِي</rule>مٌ", "en": "great", "tr": "ʿaẓīmun", "audio": "wbw/064_015_009.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "64:16", "juz": 28, "page": 557, "side_trans": "So fear Allāh as much as you are able and listen and obey and spend [in the way of Allāh]; it is better for your selves. And whoever is protected from the stinginess of his soul - it is those who will be the successful.", "words": [{"type": "word", "ar": "فَٱتَّقُوا۟", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>تَّقُو<rule class=slnt>اۡ</rule>", "en": "So fear", "tr": "fa-ittaqū", "audio": "wbw/064_016_001.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/064_016_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/064_016_003.mp3"}, {"type": "word", "ar": "ٱسْتَطَعْتُمْ", "tajweed": "<rule class=ham_wasl>ٱ</rule>سۡتَطَعۡتُمۡ", "en": "you are able", "tr": "is'taṭaʿtum", "audio": "wbw/064_016_004.mp3"}, {"type": "word", "ar": "وَٱسْمَعُوا۟", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>سۡمَعُو<rule class=slnt>اۡ</rule>", "en": "and listen", "tr": "wa-is'maʿū", "audio": "wbw/064_016_005.mp3"}, {"type": "word", "ar": "وَأَطِيعُوا۟", "tajweed": "وَأَطِيعُو<rule class=slnt>اۡ</rule>", "en": "and obey", "tr": "wa-aṭīʿū", "audio": "wbw/064_016_006.mp3"}, {"type": "word", "ar": "وَأَنفِقُوا۟", "tajweed": "وَأَ<rule class=ikhafa>نف</rule>ِقُو<rule class=slnt>اۡ</rule>", "en": "and spend", "tr": "wa-anfiqū", "audio": "wbw/064_016_007.mp3"}, {"type": "word", "ar": "خَيْرًۭا", "tajweed": "خَيۡ<rule class=idgham_wo_ghunnah>رًا</rule>", "en": "(it is) better", "tr": "khayran", "audio": "wbw/064_016_008.mp3"}, {"type": "word", "ar": "لِّأَنفُسِكُمْ ۗ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّأَ<rule class=ikhafa>نف</rule>ُسِكُمۡ‌ۗ", "en": "for yourselves", "tr": "li-anfusikum", "audio": "wbw/064_016_009.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/064_016_011.mp3"}, {"type": "word", "ar": "يُوقَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُوقَ", "en": "is saved", "tr": "yūqa", "audio": "wbw/064_016_012.mp3"}, {"type": "word", "ar": "شُحَّ", "tajweed": "شُحَّ", "en": "(from the) greediness", "tr": "shuḥḥa", "audio": "wbw/064_016_013.mp3"}, {"type": "word", "ar": "نَفْسِهِۦ", "tajweed": "نَفۡسِه<rule class=madda_normal>ِۦ</rule>", "en": "(of) his soul", "tr": "nafsihi", "audio": "wbw/064_016_014.mp3"}, {"type": "word", "ar": "فَأُو۟لَـٰٓئِكَ", "tajweed": "فَأُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَ", "en": "then those", "tr": "fa-ulāika", "audio": "wbw/064_016_015.mp3"}, {"type": "word", "ar": "هُمُ", "tajweed": "هُمُ", "en": "[they]", "tr": "humu", "audio": "wbw/064_016_016.mp3"}, {"type": "word", "ar": "ٱلْمُفْلِحُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُفۡلِح<rule class=madda_permissible>ُو</rule>نَ", "en": "(are) the successful ones", "tr": "l-muf'liḥūna", "audio": "wbw/064_016_017.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "64:17", "juz": 28, "page": 557, "side_trans": "If you loan Allāh a goodly loan, He will multiply it for you and forgive you. And Allāh is [most] Appreciative and Forbearing,", "words": [{"type": "word", "ar": "إِن", "tajweed": "إِ<rule class=ikhafa>ن</rule>", "en": "If", "tr": "in", "audio": "wbw/064_017_001.mp3"}, {"type": "word", "ar": "تُقْرِضُوا۟", "tajweed": "<rule class=ikhafa>ت</rule>ُ<rule class=qalaqah>قۡ</rule>رِضُو<rule class=slnt>اۡ</rule>", "en": "you loan", "tr": "tuq'riḍū", "audio": "wbw/064_017_002.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "(to) Allah", "tr": "l-laha", "audio": "wbw/064_017_003.mp3"}, {"type": "word", "ar": "قَرْضًا", "tajweed": "قَرۡضًا", "en": "a loan", "tr": "qarḍan", "audio": "wbw/064_017_004.mp3"}, {"type": "word", "ar": "حَسَنًۭا", "tajweed": "حَسَ<rule class=idgham_ghunnah>نًا</rule>", "en": "goodly", "tr": "ḥasanan", "audio": "wbw/064_017_005.mp3"}, {"type": "word", "ar": "يُضَـٰعِفْهُ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُضَ<rule class=madda_normal>ـٰ</rule>عِفۡهُ", "en": "He will multiply it", "tr": "yuḍāʿif'hu", "audio": "wbw/064_017_006.mp3"}, {"type": "word", "ar": "لَكُمْ", "tajweed": "لَكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/064_017_007.mp3"}, {"type": "word", "ar": "وَيَغْفِرْ", "tajweed": "وَيَغۡفِرۡ", "en": "and will forgive", "tr": "wayaghfir", "audio": "wbw/064_017_008.mp3"}, {"type": "word", "ar": "لَكُمْ ۚ", "tajweed": "لَكُمۡ‌ۚ", "en": "you", "tr": "lakum", "audio": "wbw/064_017_009.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/064_017_011.mp3"}, {"type": "word", "ar": "شَكُورٌ", "tajweed": "شَكُورٌ", "en": "(is) Most Appreciative", "tr": "shakūrun", "audio": "wbw/064_017_012.mp3"}, {"type": "word", "ar": "حَلِيمٌ", "tajweed": "حَل<rule class=madda_permissible>ِي</rule>مٌ", "en": "Most Forbearing", "tr": "ḥalīmun", "audio": "wbw/064_017_013.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "64:18", "juz": 28, "page": 557, "side_trans": "Knower of the unseen and the witnessed, the Exalted in Might, the Wise.", "words": [{"type": "word", "ar": "عَـٰلِمُ", "tajweed": "عَ<rule class=madda_normal>ـٰ</rule>لِمُ", "en": "(The) Knower", "tr": "ʿālimu", "audio": "wbw/064_018_001.mp3"}, {"type": "word", "ar": "ٱلْغَيْبِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡغَيۡبِ", "en": "(of) the unseen", "tr": "l-ghaybi", "audio": "wbw/064_018_002.mp3"}, {"type": "word", "ar": "وَٱلشَّهَـٰدَةِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شَّهَ<rule class=madda_normal>ـٰ</rule>دَةِ", "en": "and the witnessed", "tr": "wal-shahādati", "audio": "wbw/064_018_003.mp3"}, {"type": "word", "ar": "ٱلْعَزِيزُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَزِيزُ", "en": "the All-Mighty", "tr": "l-ʿazīzu", "audio": "wbw/064_018_004.mp3"}, {"type": "word", "ar": "ٱلْحَكِيمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَك<rule class=madda_permissible>ِي</rule>مُ", "en": "the All-Wise", "tr": "l-ḥakīmu", "audio": "wbw/064_018_005.mp3"}, {"type": "end", "num": "١٨"}]}]