[{"id": 1, "key": "114:1", "juz": 30, "page": 604, "side_trans": "Say, \"I seek refuge in the Lord of mankind,", "words": [{"type": "word", "ar": "قُلْ", "tajweed": "قُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/114_001_001.mp3"}, {"type": "word", "ar": "أَعُوذُ", "tajweed": "أَعُوذُ", "en": "I seek refuge", "tr": "aʿūdhu", "audio": "wbw/114_001_002.mp3"}, {"type": "word", "ar": "بِرَبِّ", "tajweed": "بِرَبِّ", "en": "in (the) Lord", "tr": "birabbi", "audio": "wbw/114_001_003.mp3"}, {"type": "word", "ar": "ٱلنَّاسِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule><rule class=madda_permissible>َا</rule>سِ", "en": "(of) mankind", "tr": "l-nāsi", "audio": "wbw/114_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "114:2", "juz": 30, "page": 604, "side_trans": "The Sovereign of mankind,", "words": [{"type": "word", "ar": "مَلِكِ", "tajweed": "مَلِكِ", "en": "(The) King", "tr": "maliki", "audio": "wbw/114_002_001.mp3"}, {"type": "word", "ar": "ٱلنَّاسِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule><rule class=madda_permissible>َا</rule>سِ", "en": "(of) mankind", "tr": "l-nāsi", "audio": "wbw/114_002_002.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "114:3", "juz": 30, "page": 604, "side_trans": "The God of mankind,", "words": [{"type": "word", "ar": "إِلَـٰهِ", "tajweed": "إِلَ<rule class=madda_normal>ـٰ</rule>هِ", "en": "(The) God", "tr": "ilāhi", "audio": "wbw/114_003_001.mp3"}, {"type": "word", "ar": "ٱلنَّاسِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule><rule class=madda_permissible>َا</rule>سِ", "en": "(of) mankind", "tr": "l-nāsi", "audio": "wbw/114_003_002.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "114:4", "juz": 30, "page": 604, "side_trans": "From the evil of the retreating whisperer -", "words": [{"type": "word", "ar": "مِن", "tajweed": "مِ<rule cl