[{"id": 1, "key": "85:1", "juz": 30, "page": 590, "side_trans": "By the sky containing great stars", "words": [{"type": "word", "ar": "وَٱلسَّمَآءِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءِ", "en": "By the sky", "tr": "wal-samāi", "audio": "wbw/085_001_001.mp3"}, {"type": "word", "ar": "ذَاتِ", "tajweed": "ذَاتِ", "en": "containing", "tr": "dhāti", "audio": "wbw/085_001_002.mp3"}, {"type": "word", "ar": "ٱلْبُرُوجِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبُر<rule class=madda_permissible>ُو</rule><rule class=qalaqah>ج</rule>ِ", "en": "the constellations", "tr": "l-burūji", "audio": "wbw/085_001_003.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "85:2", "juz": 30, "page": 590, "side_trans": "And [by] the promised Day", "words": [{"type": "word", "ar": "وَٱلْيَوْمِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡيَوۡمِ", "en": "And the Day", "tr": "wal-yawmi", "audio": "wbw/085_002_001.mp3"}, {"type": "word", "ar": "ٱلْمَوْعُودِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَوۡع<rule class=madda_permissible>ُو</rule><rule class=qalaqah>د</rule>ِ", "en": "Promised", "tr": "l-mawʿūdi", "audio": "wbw/085_002_002.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "85:3", "juz": 30, "page": 590, "side_trans": "And [by] the witness and what is witnessed,", "words": [{"type": "word", "ar": "وَشَاهِدٍۢ", "tajweed": "وَشَاهِ<rule class=idgham_ghunnah>دٍ</rule>", "en": "And (the) witness", "tr": "washāhidin", "audio": "wbw/085_003_001.mp3"}, {"type": "word", "ar": "وَمَشْهُودٍۢ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َمَشۡه<rule class=madda_permissible>ُو</rule><rule class=qalaqah>د</rule>ٍ", "en": "and what is witnessed", "tr": "wamashhūdin", "audio": "wbw/085_003_002.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "85:4", "juz": 30, "page": 590, "side_trans": "Destroyed [i.e., cursed] were the companions of the trench", "words": [{"type": "word", "ar": "قُتِلَ", "tajweed": "قُتِلَ", "en": "Destroyed were", "tr": "qutila", "audio": "wbw/085_004_001.mp3"}, {"type": "word", "ar": "أَصْحَـٰبُ", "tajweed": "أَصۡحَ<rule class=madda_normal>ـٰ</rule>بُ", "en": "(the) companions", "tr": "aṣḥābu", "audio": "wbw/085_004_002.mp3"}, {"type": "word", "ar": "ٱلْأُخْدُودِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأُخۡد<rule class=madda_permissible>ُو</rule><rule class=qalaqah>د</rule>ِ", "en": "(of) the pit", "tr": "l-ukh'dūdi", "audio": "wbw/085_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "85:5", "juz": 30, "page": 590, "side_trans": "[Containing] the fire full of fuel,", "words": [{"type": "word", "ar": "ٱلنَّارِ", "tajweed": "ٱ<rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َارِ", "en": "(Of) the fire", "tr": "al-nāri", "audio": "wbw/085_005_001.mp3"}, {"type": "word", "ar": "ذَاتِ", "tajweed": "ذَاتِ", "en": "full", "tr": "dhāti", "audio": "wbw/085_005_002.mp3"}, {"type": "word", "ar": "ٱلْوَقُودِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡوَق<rule class=madda_permissible>ُو</rule><rule class=qalaqah>د</rule>ِ", "en": "(of) the fuel", "tr": "l-waqūdi", "audio": "wbw/085_005_003.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "85:6", "juz": 30, "page": 590, "side_trans": "When they were sitting near it.", "words": [{"type": "word", "ar": "إِذْ", "tajweed": "إِذۡ", "en": "When", "tr": "idh", "audio": "wbw/085_006_001.mp3"}, {"type": "word", "ar": "هُمْ", "tajweed": "هُمۡ", "en": "they", "tr": "hum", "audio": "wbw/085_006_002.mp3"}, {"type": "word", "ar": "عَلَيْهَا", "tajweed": "عَلَيۡهَا", "en": "by it", "tr": "ʿalayhā", "audio": "wbw/085_006_003.mp3"}, {"type": "word", "ar": "قُعُودٌۭ", "tajweed": "قُع<rule class=madda_permissible>ُو</rule><rule class=qalaqah>د</rule>ٌ", "en": "(were) sitting", "tr": "quʿūdun", "audio": "wbw/085_006_004.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "85:7", "juz": 30, "page": 590, "side_trans": "And they, to what they were doing against the believers, were witnesses.", "words": [{"type": "word", "ar": "وَهُمْ", "tajweed": "وَهُمۡ", "en": "And they", "tr": "wahum", "audio": "wbw/085_007_001.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "over", "tr": "ʿalā", "audio": "wbw/085_007_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/085_007_003.mp3"}, {"type": "word", "ar": "يَفْعَلُونَ", "tajweed": "يَفۡعَلُونَ", "en": "they were doing", "tr": "yafʿalūna", "audio": "wbw/085_007_004.mp3"}, {"type": "word", "ar": "بِٱلْمُؤْمِنِينَ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡمُؤۡمِنِينَ", "en": "to the believers", "tr": "bil-mu'minīna", "audio": "wbw/085_007_005.mp3"}, {"type": "word", "ar": "شُهُودٌۭ", "tajweed": "شُه<rule class=madda_permissible>ُو</rule><rule class=qalaqah>د</rule>ٌ", "en": "witnesses", "tr": "shuhūdun", "audio": "wbw/085_007_006.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "85:8", "juz": 30, "page": 590, "side_trans": "And they resented them not except because they believed in Allāh, the Exalted in Might, the Praiseworthy,", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/085_008_001.mp3"}, {"type": "word", "ar": "نَقَمُوا۟", "tajweed": "نَقَمُو<rule class=slnt>اۡ</rule>", "en": "they resented", "tr": "naqamū", "audio": "wbw/085_008_002.mp3"}, {"type": "word", "ar": "مِنْهُمْ", "tajweed": "مِنۡهُمۡ", "en": "[of] them", "tr": "min'hum", "audio": "wbw/085_008_003.mp3"}, {"type": "word", "ar": "إِلَّآ", "tajweed": "إِلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "except", "tr": "illā", "audio": "wbw/085_008_004.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/085_008_005.mp3"}, {"type": "word", "ar": "يُؤْمِنُوا۟", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُؤۡمِنُو<rule class=slnt>اۡ</rule>", "en": "they believed", "tr": "yu'minū", "audio": "wbw/085_008_006.mp3"}, {"type": "word", "ar": "بِٱللَّهِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "in Allah", "tr": "bil-lahi", "audio": "wbw/085_008_007.mp3"}, {"type": "word", "ar": "ٱلْعَزِيزِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَزِيزِ", "en": "the All-Mighty", "tr": "l-ʿazīzi", "audio": "wbw/085_008_008.mp3"}, {"type": "word", "ar": "ٱلْحَمِيدِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَم<rule class=madda_permissible>ِي</rule><rule class=qalaqah>د</rule>ِ", "en": "the Praiseworthy", "tr": "l-ḥamīdi", "audio": "wbw/085_008_009.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "85:9", "juz": 30, "page": 590, "side_trans": "To whom belongs the dominion of the heavens and the earth. And Allāh, over all things, is Witness.", "words": [{"type": "word", "ar": "ٱلَّذِى", "tajweed": "ٱلَّذِى", "en": "The One Who", "tr": "alladhī", "audio": "wbw/085_009_001.mp3"}, {"type": "word", "ar": "لَهُۥ", "tajweed": "لَهُ<rule class=madda_normal>ۥ</rule>", "en": "for Him", "tr": "lahu", "audio": "wbw/085_009_002.mp3"}, {"type": "word", "ar": "مُلْكُ", "tajweed": "مُلۡكُ", "en": "(is) the dominion", "tr": "mul'ku", "audio": "wbw/085_009_003.mp3"}, {"type": "word", "ar": "ٱلسَّمَـٰوَٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّمَ<rule class=madda_normal>ـٰ</rule>و<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِ", "en": "(of) the heavens", "tr": "l-samāwāti", "audio": "wbw/085_009_004.mp3"}, {"type": "word", "ar": "وَٱلْأَرْضِ ۚ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ‌ۚ", "en": "and the earth", "tr": "wal-arḍi", "audio": "wbw/085_009_005.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "and Allah", "tr": "wal-lahu", "audio": "wbw/085_009_007.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "on", "tr": "ʿalā", "audio": "wbw/085_009_008.mp3"}, {"type": "word", "ar": "كُلِّ", "tajweed": "كُلِّ", "en": "every", "tr": "kulli", "audio": "wbw/085_009_009.mp3"}, {"type": "word", "ar": "شَىْءٍۢ", "tajweed": "ش<rule class=ikhafa>َىۡءٍ</rule>", "en": "thing", "tr": "shayin", "audio": "wbw/085_009_010.mp3"}, {"type": "word", "ar": "شَهِيدٌ", "tajweed": "<rule class=ikhafa>ش</rule>َه<rule class=madda_permissible>ِي</rule><rule class=qalaqah>د</rule>ٌ", "en": "(is) a Witness", "tr": "shahīdun", "audio": "wbw/085_009_011.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "85:10", "juz": 30, "page": 590, "side_trans": "Indeed, those who have tortured the believing men and believing women and then have not repented will have the punishment of Hell, and they will have the punishment of the Burning Fire.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/085_010_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/085_010_002.mp3"}, {"type": "word", "ar": "فَتَنُوا۟", "tajweed": "فَتَنُو<rule class=slnt>اۡ</rule>", "en": "persecuted", "tr": "fatanū", "audio": "wbw/085_010_003.mp3"}, {"type": "word", "ar": "ٱلْمُؤْمِنِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُؤۡمِنِينَ", "en": "the believing men", "tr": "l-mu'minīna", "audio": "wbw/085_010_004.mp3"}, {"type": "word", "ar": "وَٱلْمُؤْمِنَـٰتِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمُؤۡمِنَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "and the believing women", "tr": "wal-mu'mināti", "audio": "wbw/085_010_005.mp3"}, {"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "then", "tr": "thumma", "audio": "wbw/085_010_006.mp3"}, {"type": "word", "ar": "لَمْ", "tajweed": "لَمۡ", "en": "not", "tr": "lam", "audio": "wbw/085_010_007.mp3"}, {"type": "word", "ar": "يَتُوبُوا۟", "tajweed": "يَتُوبُو<rule class=slnt>اۡ</rule>", "en": "they repented", "tr": "yatūbū", "audio": "wbw/085_010_008.mp3"}, {"type": "word", "ar": "فَلَهُمْ", "tajweed": "فَلَهُمۡ", "en": "then for them", "tr": "falahum", "audio": "wbw/085_010_009.mp3"}, {"type": "word", "ar": "عَذَابُ", "tajweed": "عَذَابُ", "en": "(is the) punishment", "tr": "ʿadhābu", "audio": "wbw/085_010_010.mp3"}, {"type": "word", "ar": "جَهَنَّمَ", "tajweed": "جَهَ<rule class=ghunnah>نّ</rule>َمَ", "en": "(of) Hell", "tr": "jahannama", "audio": "wbw/085_010_011.mp3"}, {"type": "word", "ar": "وَلَهُمْ", "tajweed": "وَلَهُمۡ", "en": "and for them", "tr": "walahum", "audio": "wbw/085_010_012.mp3"}, {"type": "word", "ar": "عَذَابُ", "tajweed": "عَذَابُ", "en": "(is the) punishment", "tr": "ʿadhābu", "audio": "wbw/085_010_013.mp3"}, {"type": "word", "ar": "ٱلْحَرِيقِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَر<rule class=madda_permissible>ِي</rule><rule class=qalaqah>ق</rule>ِ", "en": "(of) the Burning Fire", "tr": "l-ḥarīqi", "audio": "wbw/085_010_014.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "85:11", "juz": 30, "page": 590, "side_trans": "Indeed, those who have believed and done righteous deeds will have gardens beneath which rivers flow. That is the great attainment.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/085_011_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/085_011_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/085_011_003.mp3"}, {"type": "word", "ar": "وَعَمِلُوا۟", "tajweed": "وَعَمِلُو<rule class=slnt>اۡ</rule>", "en": "and do", "tr": "waʿamilū", "audio": "wbw/085_011_004.mp3"}, {"type": "word", "ar": "ٱلصَّـٰلِحَـٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّ<rule class=madda_normal>ـٰ</rule>لِحَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "the righteous deeds", "tr": "l-ṣāliḥāti", "audio": "wbw/085_011_005.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "for them", "tr": "lahum", "audio": "wbw/085_011_006.mp3"}, {"type": "word", "ar": "جَنَّـٰتٌۭ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule><rule class=ikhafa>تٌ</rule>", "en": "(will be) Gardens", "tr": "jannātun", "audio": "wbw/085_011_007.mp3"}, {"type": "word", "ar": "تَجْرِى", "tajweed": "<rule class=ikhafa>ت</rule>َ<rule class=qalaqah>جۡ</rule>رِى", "en": "flow", "tr": "tajrī", "audio": "wbw/085_011_008.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/085_011_009.mp3"}, {"type": "word", "ar": "تَحْتِهَا", "tajweed": "<rule class=ikhafa>ت</rule>َحۡتِهَا", "en": "underneath it", "tr": "taḥtihā", "audio": "wbw/085_011_010.mp3"}, {"type": "word", "ar": "ٱلْأَنْهَـٰرُ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَنۡهَ<rule class=madda_normal>ـٰ</rule>رُ‌ۚ", "en": "the rivers", "tr": "l-anhāru", "audio": "wbw/085_011_011.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "That", "tr": "dhālika", "audio": "wbw/085_011_013.mp3"}, {"type": "word", "ar": "ٱلْفَوْزُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَوۡزُ", "en": "(is) the success", "tr": "l-fawzu", "audio": "wbw/085_011_014.mp3"}, {"type": "word", "ar": "ٱلْكَبِيرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَب<rule class=madda_permissible>ِي</rule>رُ", "en": "the great", "tr": "l-kabīru", "audio": "wbw/085_011_015.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "85:12", "juz": 30, "page": 590, "side_trans": "Indeed, the assault [i.e., vengeance] of your Lord is severe.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/085_012_001.mp3"}, {"type": "word", "ar": "بَطْشَ", "tajweed": "بَ<rule class=qalaqah>طۡ</rule>شَ", "en": "(the) Grip", "tr": "baṭsha", "audio": "wbw/085_012_002.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "(of) your Lord", "tr": "rabbika", "audio": "wbw/085_012_003.mp3"}, {"type": "word", "ar": "لَشَدِيدٌ", "tajweed": "لَشَد<rule class=madda_permissible>ِي</rule><rule class=qalaqah>د</rule>ٌ", "en": "(is) surely strong", "tr": "lashadīdun", "audio": "wbw/085_012_004.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "85:13", "juz": 30, "page": 590, "side_trans": "Indeed, it is He who originates [creation] and repeats.", "words": [{"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed He", "tr": "innahu", "audio": "wbw/085_013_001.mp3"}, {"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "He", "tr": "huwa", "audio": "wbw/085_013_002.mp3"}, {"type": "word", "ar": "يُبْدِئُ", "tajweed": "يُ<rule class=qalaqah>بۡ</rule>دِئُ", "en": "originates", "tr": "yub'di-u", "audio": "wbw/085_013_003.mp3"}, {"type": "word", "ar": "وَيُعِيدُ", "tajweed": "وَيُع<rule class=madda_permissible>ِي</rule><rule class=qalaqah>د</rule>ُ", "en": "and repeats", "tr": "wayuʿīdu", "audio": "wbw/085_013_004.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "85:14", "juz": 30, "page": 590, "side_trans": "And He is the Forgiving, the Affectionate,", "words": [{"type": "word", "ar": "وَهُوَ", "tajweed": "وَهُوَ", "en": "And He", "tr": "wahuwa", "audio": "wbw/085_014_001.mp3"}, {"type": "word", "ar": "ٱلْغَفُورُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡغَفُورُ", "en": "(is) the Oft-Forgiving", "tr": "l-ghafūru", "audio": "wbw/085_014_002.mp3"}, {"type": "word", "ar": "ٱلْوَدُودُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡوَد<rule class=madda_permissible>ُو</rule><rule class=qalaqah>د</rule>ُ", "en": "the Most Loving", "tr": "l-wadūdu", "audio": "wbw/085_014_003.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "85:15", "juz": 30, "page": 590, "side_trans": "Honorable Owner of the Throne,", "words": [{"type": "word", "ar": "ذُو", "tajweed": "ذُو", "en": "Owner (of)", "tr": "dhū", "audio": "wbw/085_015_001.mp3"}, {"type": "word", "ar": "ٱلْعَرْشِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَرۡشِ", "en": "the Throne", "tr": "l-ʿarshi", "audio": "wbw/085_015_002.mp3"}, {"type": "word", "ar": "ٱلْمَجِيدُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَج<rule class=madda_permissible>ِي</rule><rule class=qalaqah>د</rule>ُ", "en": "the Glorious", "tr": "l-majīdu", "audio": "wbw/085_015_003.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "85:16", "juz": 30, "page": 590, "side_trans": "Effecter of what He intends.", "words": [{"type": "word", "ar": "فَعَّالٌۭ", "tajweed": "فَعَّا<rule class=idgham_wo_ghunnah>لٌ</rule>", "en": "Doer", "tr": "faʿʿālun", "audio": "wbw/085_016_001.mp3"}, {"type": "word", "ar": "لِّمَا", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّمَا", "en": "of what", "tr": "limā", "audio": "wbw/085_016_002.mp3"}, {"type": "word", "ar": "يُرِيدُ", "tajweed": "يُر<rule class=madda_permissible>ِي</rule><rule class=qalaqah>د</rule>ُ", "en": "He intends", "tr": "yurīdu", "audio": "wbw/085_016_003.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "85:17", "juz": 30, "page": 590, "side_trans": "Has there reached you the story of the soldiers -", "words": [{"type": "word", "ar": "هَلْ", "tajweed": "هَلۡ", "en": "Has", "tr": "hal", "audio": "wbw/085_017_001.mp3"}, {"type": "word", "ar": "أَتَىٰكَ", "tajweed": "أَتَ<rule class=madda_normal>ـٰ</rule>كَ", "en": "come to you", "tr": "atāka", "audio": "wbw/085_017_002.mp3"}, {"type": "word", "ar": "حَدِيثُ", "tajweed": "حَدِيثُ", "en": "(the) story", "tr": "ḥadīthu", "audio": "wbw/085_017_003.mp3"}, {"type": "word", "ar": "ٱلْجُنُودِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجُن<rule class=madda_permissible>ُو</rule><rule class=qalaqah>د</rule>ِ", "en": "(of) the hosts", "tr": "l-junūdi", "audio": "wbw/085_017_004.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "85:18", "juz": 30, "page": 590, "side_trans": "[Those of] Pharaoh and Thamūd?", "words": [{"type": "word", "ar": "فِرْعَوْنَ", "tajweed": "فِرۡعَوۡنَ", "en": "Firaun", "tr": "fir'ʿawna", "audio": "wbw/085_018_001.mp3"}, {"type": "word", "ar": "وَثَمُودَ", "tajweed": "وَثَم<rule class=madda_permissible>ُو</rule><rule class=qalaqah>د</rule>َ", "en": "and Thamud", "tr": "wathamūda", "audio": "wbw/085_018_002.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "85:19", "juz": 30, "page": 590, "side_trans": "But they who disbelieve are in [persistent] denial,", "words": [{"type": "word", "ar": "بَلِ", "tajweed": "بَلِ", "en": "Nay", "tr": "bali", "audio": "wbw/085_019_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "Those who", "tr": "alladhīna", "audio": "wbw/085_019_002.mp3"}, {"type": "word", "ar": "كَفَرُوا۟", "tajweed": "كَفَرُو<rule class=slnt>اۡ</rule>", "en": "disbelieve", "tr": "kafarū", "audio": "wbw/085_019_003.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(are) in", "tr": "fī", "audio": "wbw/085_019_004.mp3"}, {"type": "word", "ar": "تَكْذِيبٍۢ", "tajweed": "تَكۡذ<rule class=madda_permissible>ِي</rule><rule class=qalaqah>ب</rule>ٍ", "en": "denial", "tr": "takdhībin", "audio": "wbw/085_019_005.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "85:20", "juz": 30, "page": 590, "side_trans": "While Allāh encompasses them from behind.", "words": [{"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "But Allah", "tr": "wal-lahu", "audio": "wbw/085_020_001.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_ghunnah>ِن</rule>", "en": "from", "tr": "min", "audio": "wbw/085_020_002.mp3"}, {"type": "word", "ar": "وَرَآئِهِم", "tajweed": "<rule class=idgham_ghunnah>و</rule>َر<rule class=madda_obligatory_mottasel>َا</rule>ٓئِه<rule class=idgham_shafawi>ِم</rule>", "en": "behind them", "tr": "warāihim", "audio": "wbw/085_020_003.mp3"}, {"type": "word", "ar": "مُّحِيطٌۢ", "tajweed": "<rule class=idgham_shafawi>م</rule>ُّح<rule class=madda_permissible>ِي</rule><rule class=qalaqah>ط</rule>ُۢ", "en": "encompasses", "tr": "muḥīṭun", "audio": "wbw/085_020_004.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "85:21", "juz": 30, "page": 590, "side_trans": "But this is an honored Qur’ān", "words": [{"type": "word", "ar": "بَلْ", "tajweed": "بَلۡ", "en": "Nay", "tr": "bal", "audio": "wbw/085_021_001.mp3"}, {"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "It", "tr": "huwa", "audio": "wbw/085_021_002.mp3"}, {"type": "word", "ar": "قُرْءَانٌۭ", "tajweed": "قُرۡءَا<rule class=idgham_ghunnah>نٌ</rule>", "en": "(is) a Quran", "tr": "qur'ānun", "audio": "wbw/085_021_003.mp3"}, {"type": "word", "ar": "مَّجِيدٌۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّج<rule class=madda_permissible>ِي</rule><rule class=qalaqah>د</rule>ٌ", "en": "Glorious", "tr": "majīdun", "audio": "wbw/085_021_004.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "85:22", "juz": 30, "page": 590, "side_trans": "[Inscribed] in a Preserved Slate.", "words": [{"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "In", "tr": "fī", "audio": "wbw/085_022_001.mp3"}, {"type": "word", "ar": "لَوْحٍۢ", "tajweed": "لَوۡ<rule class=idgham_ghunnah>حٍ</rule>", "en": "a Tablet", "tr": "lawḥin", "audio": "wbw/085_022_002.mp3"}, {"type": "word", "ar": "مَّحْفُوظٍۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّحۡف<rule class=madda_permissible>ُو</rule>ظِۭ", "en": "Guarded", "tr": "maḥfūẓin", "audio": "wbw/085_022_003.mp3"}, {"type": "end", "num": "٢٢"}]}]