[{"id": 1, "key": "90:1", "juz": 30, "page": 594, "side_trans": "I swear by this city [i.e., Makkah]", "words": [{"type": "word", "ar": "لَآ", "tajweed": "ل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Nay", "tr": "lā", "audio": "wbw/090_001_001.mp3"}, {"type": "word", "ar": "أُقْسِمُ", "tajweed": "أُ<rule class=qalaqah>قۡ</rule>سِمُ", "en": "I swear", "tr": "uq'simu", "audio": "wbw/090_001_002.mp3"}, {"type": "word", "ar": "بِهَـٰذَا", "tajweed": "بِهَ<rule class=madda_normal>ـٰ</rule>ذَا", "en": "by this", "tr": "bihādhā", "audio": "wbw/090_001_003.mp3"}, {"type": "word", "ar": "ٱلْبَلَدِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبَلَ<rule class=qalaqah>د</rule>ِ", "en": "city", "tr": "l-baladi", "audio": "wbw/090_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "90:2", "juz": 30, "page": 594, "side_trans": "And you, [O Muḥammad], are free of restriction in this city", "words": [{"type": "word", "ar": "وَأَنتَ", "tajweed": "وَأَ<rule class=ikhafa>نت</rule>َ", "en": "And you", "tr": "wa-anta", "audio": "wbw/090_002_001.mp3"}, {"type": "word", "ar": "حِلٌّۢ", "tajweed": "حِل<rule class=iqlab>ُّۢ</rule>", "en": "(are) free (to dwell)", "tr": "ḥillun", "audio": "wbw/090_002_002.mp3"}, {"type": "word", "ar": "بِهَـٰذَا", "tajweed": "<rule class=iqlab>ب</rule>ِهَ<rule class=madda_normal>ـٰ</rule>ذَا", "en": "in this", "tr": "bihādhā", "audio": "wbw/090_002_003.mp3"}, {"type": "word", "ar": "ٱلْبَلَدِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبَلَ<rule class=qalaqah>د</rule>ِ", "en": "city", "tr": "l-baladi", "audio": "wbw/090_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "90:3", "juz": 30, "page": 594, "side_trans": "And [by] the father and that which was born [of him],", "words": [{"type": "word", "ar": "وَوَالِدٍۢ", "tajweed": "وَوَالِ<rule class=idgham_ghunnah>دٍ</rule>", "en": "And the begetter", "tr": "wawālidin", "audio": "wbw/090_003_001.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َمَا", "en": "and what", "tr": "wamā", "audio": "wbw/090_003_002.mp3"}, {"type": "word", "ar": "وَلَدَ", "tajweed": "وَلَ<rule class=qalaqah>د</rule>َ", "en": "he begot", "tr": "walada", "audio": "wbw/090_003_003.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "90:4", "juz": 30, "page": 594, "side_trans": "We have certainly created man into hardship.", "words": [{"type": "word", "ar": "لَقَدْ", "tajweed": "لَقَ<rule class=qalaqah>دۡ</rule>", "en": "Certainly", "tr": "laqad", "audio": "wbw/090_004_001.mp3"}, {"type": "word", "ar": "خَلَقْنَا", "tajweed": "خَلَ<rule class=qalaqah>قۡ</rule>نَا", "en": "We have created", "tr": "khalaqnā", "audio": "wbw/090_004_002.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نَ", "en": "man", "tr": "l-insāna", "audio": "wbw/090_004_003.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(to be) in", "tr": "fī", "audio": "wbw/090_004_004.mp3"}, {"type": "word", "ar": "كَبَدٍ", "tajweed": "كَبَ<rule class=qalaqah>د</rule>ٍ", "en": "hardship", "tr": "kabadin", "audio": "wbw/090_004_005.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "90:5", "juz": 30, "page": 594, "side_trans": "Does he think that never will anyone overcome him?", "words": [{"type": "word", "ar": "أَيَحْسَبُ", "tajweed": "أَيَحۡسَبُ", "en": "Does he think", "tr": "ayaḥsabu", "audio": "wbw/090_005_001.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_wo_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/090_005_002.mp3"}, {"type": "word", "ar": "لَّن", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ّ<rule class=idgham_ghunnah>َن</rule>", "en": "not", "tr": "lan", "audio": "wbw/090_005_003.mp3"}, {"type": "word", "ar": "يَقْدِرَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َ<rule class=qalaqah>قۡ</rule>دِرَ", "en": "has power", "tr": "yaqdira", "audio": "wbw/090_005_004.mp3"}, {"type": "word", "ar": "عَلَيْهِ", "tajweed": "عَلَيۡهِ", "en": "over him", "tr": "ʿalayhi", "audio": "wbw/090_005_005.mp3"}, {"type": "word", "ar": "أَحَدٌۭ", "tajweed": "أَحَ<rule class=qalaqah>د</rule>ٌ", "en": "anyone", "tr": "aḥadun", "audio": "wbw/090_005_006.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "90:6", "juz": 30, "page": 594, "side_trans": "He says, \"I have spent wealth in abundance.\"", "words": [{"type": "word", "ar": "يَقُولُ", "tajweed": "يَقُولُ", "en": "He will say", "tr": "yaqūlu", "audio": "wbw/090_006_001.mp3"}, {"type": "word", "ar": "أَهْلَكْتُ", "tajweed": "أَهۡلَكۡتُ", "en": "I have squandered", "tr": "ahlaktu", "audio": "wbw/090_006_002.mp3"}, {"type": "word", "ar": "مَالًۭا", "tajweed": "مَال<rule class=idgham_wo_ghunnah>اً</rule>", "en": "wealth", "tr": "mālan", "audio": "wbw/090_006_003.mp3"}, {"type": "word", "ar": "لُّبَدًا", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ُّبَدًا", "en": "abundant", "tr": "lubadan", "audio": "wbw/090_006_004.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "90:7", "juz": 30, "page": 594, "side_trans": "Does he think that no one has seen him?", "words": [{"type": "word", "ar": "أَيَحْسَبُ", "tajweed": "أَيَحۡسَبُ", "en": "Does he think", "tr": "ayaḥsabu", "audio": "wbw/090_007_001.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_wo_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/090_007_002.mp3"}, {"type": "word", "ar": "لَّمْ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّمۡ", "en": "not", "tr": "lam", "audio": "wbw/090_007_003.mp3"}, {"type": "word", "ar": "يَرَهُۥٓ", "tajweed": "يَرَهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "sees him", "tr": "yarahu", "audio": "wbw/090_007_004.mp3"}, {"type": "word", "ar": "أَحَدٌ", "tajweed": "أَحَ<rule class=qalaqah>د</rule>ٌ", "en": "anyone", "tr": "aḥadun", "audio": "wbw/090_007_005.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "90:8", "juz": 30, "page": 594, "side_trans": "Have We not made for him two eyes?", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Have not", "tr": "alam", "audio": "wbw/090_008_001.mp3"}, {"type": "word", "ar": "نَجْعَل", "tajweed": "نَ<rule class=qalaqah>جۡ</rule>عَل", "en": "We made", "tr": "najʿal", "audio": "wbw/090_008_002.mp3"}, {"type": "word", "ar": "لَّهُۥ", "tajweed": "لَّهُ<rule class=madda_normal>ۥ</rule>", "en": "for him", "tr": "lahu", "audio": "wbw/090_008_003.mp3"}, {"type": "word", "ar": "عَيْنَيْنِ", "tajweed": "عَيۡنَ<rule class=madda_permissible>يۡ</rule>نِ", "en": "two eyes", "tr": "ʿaynayni", "audio": "wbw/090_008_004.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "90:9", "juz": 30, "page": 594, "side_trans": "And a tongue and two lips?", "words": [{"type": "word", "ar": "وَلِسَانًۭا", "tajweed": "وَلِسَا<rule class=idgham_ghunnah>نًا</rule>", "en": "And a tongue", "tr": "walisānan", "audio": "wbw/090_009_001.mp3"}, {"type": "word", "ar": "وَشَفَتَيْنِ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َشَفَتَ<rule class=madda_permissible>يۡ</rule>نِ", "en": "and two lips", "tr": "washafatayni", "audio": "wbw/090_009_002.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "90:10", "juz": 30, "page": 594, "side_trans": "And have shown him the two ways?", "words": [{"type": "word", "ar": "وَهَدَيْنَـٰهُ", "tajweed": "وَهَدَيۡنَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "And shown him", "tr": "wahadaynāhu", "audio": "wbw/090_010_001.mp3"}, {"type": "word", "ar": "ٱلنَّجْدَيْنِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َ<rule class=qalaqah>جۡ</rule>دَ<rule class=madda_permissible>يۡ</rule>نِ", "en": "the two ways", "tr": "l-najdayni", "audio": "wbw/090_010_002.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "90:11", "juz": 30, "page": 594, "side_trans": "But he has not broken through the difficult pass.", "words": [{"type": "word", "ar": "فَلَا", "tajweed": "فَلَا", "en": "But not", "tr": "falā", "audio": "wbw/090_011_001.mp3"}, {"type": "word", "ar": "ٱقْتَحَمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>قۡ</rule>تَحَمَ", "en": "he has attempted", "tr": "iq'taḥama", "audio": "wbw/090_011_002.mp3"}, {"type": "word", "ar": "ٱلْعَقَبَةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَقَبَةَ", "en": "the steep path", "tr": "l-ʿaqabata", "audio": "wbw/090_011_003.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "90:12", "juz": 30, "page": 594, "side_trans": "And what can make you know what is [breaking through] the difficult pass?", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And what", "tr": "wamā", "audio": "wbw/090_012_001.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "can make you know", "tr": "adrāka", "audio": "wbw/090_012_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/090_012_003.mp3"}, {"type": "word", "ar": "ٱلْعَقَبَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَقَبَةُ", "en": "the steep path (is)", "tr": "l-ʿaqabatu", "audio": "wbw/090_012_004.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "90:13", "juz": 30, "page": 594, "side_trans": "It is the freeing of a slave", "words": [{"type": "word", "ar": "فَكُّ", "tajweed": "فَكُّ", "en": "(It is) freeing", "tr": "fakku", "audio": "wbw/090_013_001.mp3"}, {"type": "word", "ar": "رَقَبَةٍ", "tajweed": "رَقَبَةٍ", "en": "a neck", "tr": "raqabatin", "audio": "wbw/090_013_002.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "90:14", "juz": 30, "page": 594, "side_trans": "Or feeding on a day of severe hunger", "words": [{"type": "word", "ar": "أَوْ", "tajweed": "أَوۡ", "en": "Or", "tr": "aw", "audio": "wbw/090_014_001.mp3"}, {"type": "word", "ar": "إِطْعَـٰمٌۭ", "tajweed": "إِ<rule class=qalaqah>طۡ</rule>عَ<rule class=madda_normal>ـٰ</rule><rule class=ikhafa>مٌ</rule>", "en": "feeding", "tr": "iṭ'ʿāmun", "audio": "wbw/090_014_002.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "<rule class=ikhafa>ف</rule>ِى", "en": "in", "tr": "fī", "audio": "wbw/090_014_003.mp3"}, {"type": "word", "ar": "يَوْمٍۢ", "tajweed": "يَوۡ<rule class=ikhafa>مٍ</rule>", "en": "a day", "tr": "yawmin", "audio": "wbw/090_014_004.mp3"}, {"type": "word", "ar": "ذِى", "tajweed": "<rule class=ikhafa>ذ</rule>ِى", "en": "of", "tr": "dhī", "audio": "wbw/090_014_005.mp3"}, {"type": "word", "ar": "مَسْغَبَةٍۢ", "tajweed": "مَسۡغَبَةٍ", "en": "severe hunger", "tr": "masghabatin", "audio": "wbw/090_014_006.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "90:15", "juz": 30, "page": 594, "side_trans": "An orphan of near relationship", "words": [{"type": "word", "ar": "يَتِيمًۭا", "tajweed": "يَتِي<rule class=ikhafa>مًا</rule>", "en": "An orphan", "tr": "yatīman", "audio": "wbw/090_015_001.mp3"}, {"type": "word", "ar": "ذَا", "tajweed": "<rule class=ikhafa>ذ</rule>َا", "en": "of", "tr": "dhā", "audio": "wbw/090_015_002.mp3"}, {"type": "word", "ar": "مَقْرَبَةٍ", "tajweed": "مَ<rule class=qalaqah>قۡ</rule>رَبَةٍ", "en": "near relationship", "tr": "maqrabatin", "audio": "wbw/090_015_003.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "90:16", "juz": 30, "page": 594, "side_trans": "Or a needy person in misery", "words": [{"type": "word", "ar": "أَوْ", "tajweed": "أَوۡ", "en": "Or", "tr": "aw", "audio": "wbw/090_016_001.mp3"}, {"type": "word", "ar": "مِسْكِينًۭا", "tajweed": "مِسۡكِي<rule class=ikhafa>نًا</rule>", "en": "a needy person", "tr": "mis'kīnan", "audio": "wbw/090_016_002.mp3"}, {"type": "word", "ar": "ذَا", "tajweed": "<rule class=ikhafa>ذ</rule>َا", "en": "in", "tr": "dhā", "audio": "wbw/090_016_003.mp3"}, {"type": "word", "ar": "مَتْرَبَةٍۢ", "tajweed": "مَتۡرَبَةٍ", "en": "misery", "tr": "matrabatin", "audio": "wbw/090_016_004.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "90:17", "juz": 30, "page": 594, "side_trans": "And then being among those who believed and advised one another to patience and advised one another to compassion.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/090_017_001.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "he is", "tr": "kāna", "audio": "wbw/090_017_002.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "of", "tr": "mina", "audio": "wbw/090_017_003.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/090_017_004.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/090_017_005.mp3"}, {"type": "word", "ar": "وَتَوَاصَوْا۟", "tajweed": "وَتَوَاصَوۡ<rule class=slnt>اۡ</rule>", "en": "and enjoin (each other)", "tr": "watawāṣaw", "audio": "wbw/090_017_006.mp3"}, {"type": "word", "ar": "بِٱلصَّبْرِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّ<rule class=qalaqah>بۡ</rule>رِ", "en": "to patience", "tr": "bil-ṣabri", "audio": "wbw/090_017_007.mp3"}, {"type": "word", "ar": "وَتَوَاصَوْا۟", "tajweed": "وَتَوَاصَوۡ<rule class=slnt>اۡ</rule>", "en": "and enjoin (each other)", "tr": "watawāṣaw", "audio": "wbw/090_017_008.mp3"}, {"type": "word", "ar": "بِٱلْمَرْحَمَةِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡمَرۡحَمَةِ", "en": "to compassion", "tr": "bil-marḥamati", "audio": "wbw/090_017_009.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "90:18", "juz": 30, "page": 594, "side_trans": "Those are the companions of the right.", "words": [{"type": "word", "ar": "أُو۟لَـٰٓئِكَ", "tajweed": "أُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَ", "en": "Those", "tr": "ulāika", "audio": "wbw/090_018_001.mp3"}, {"type": "word", "ar": "أَصْحَـٰبُ", "tajweed": "أَصۡحَ<rule class=madda_normal>ـٰ</rule>بُ", "en": "(are the) companions", "tr": "aṣḥābu", "audio": "wbw/090_018_002.mp3"}, {"type": "word", "ar": "ٱلْمَيْمَنَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَيۡمَنَةِ", "en": "(of) the right (hand)", "tr": "l-maymanati", "audio": "wbw/090_018_003.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "90:19", "juz": 30, "page": 595, "side_trans": "But they who disbelieved in Our signs - those are the companions of the left.", "words": [{"type": "word", "ar": "وَٱلَّذِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "But those who", "tr": "wa-alladhīna", "audio": "wbw/090_019_001.mp3"}, {"type": "word", "ar": "كَفَرُوا۟", "tajweed": "كَفَرُو<rule class=slnt>اۡ</rule>", "en": "disbelieve", "tr": "kafarū", "audio": "wbw/090_019_002.mp3"}, {"type": "word", "ar": "بِـَٔايَـٰتِنَا", "tajweed": "بِـَٔـايَ<rule class=madda_normal>ـٰ</rule>تِنَا", "en": "in Our Verses", "tr": "biāyātinā", "audio": "wbw/090_019_003.mp3"}, {"type": "word", "ar": "هُمْ", "tajweed": "هُمۡ", "en": "they", "tr": "hum", "audio": "wbw/090_019_004.mp3"}, {"type": "word", "ar": "أَصْحَـٰبُ", "tajweed": "أَصۡحَ<rule class=madda_normal>ـٰ</rule>بُ", "en": "(are the) companions", "tr": "aṣḥābu", "audio": "wbw/090_019_005.mp3"}, {"type": "word", "ar": "ٱلْمَشْـَٔمَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَشۡــَٔمَةِ", "en": "(of) the left (hand)", "tr": "l-mashamati", "audio": "wbw/090_019_006.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "90:20", "juz": 30, "page": 595, "side_trans": "Over them will be fire closed in.", "words": [{"type": "word", "ar": "عَلَيْهِمْ", "tajweed": "عَلَيۡهِمۡ", "en": "Over them", "tr": "ʿalayhim", "audio": "wbw/090_020_001.mp3"}, {"type": "word", "ar": "نَارٌۭ", "tajweed": "نَا<rule class=idgham_ghunnah>رٌ</rule>", "en": "(will be the) Fire", "tr": "nārun", "audio": "wbw/090_020_002.mp3"}, {"type": "word", "ar": "مُّؤْصَدَةٌۢ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّؤۡصَدَةُۢ", "en": "closed in", "tr": "mu'ṣadatun", "audio": "wbw/090_020_003.mp3"}, {"type": "end", "num": "٢٠"}]}]