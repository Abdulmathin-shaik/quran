[{"id": 1, "key": "94:1", "juz": 30, "page": 596, "side_trans": "Did We not expand for you, [O Muḥammad], your breast?", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Have not", "tr": "alam", "audio": "wbw/094_001_001.mp3"}, {"type": "word", "ar": "نَشْرَحْ", "tajweed": "نَشۡرَحۡ", "en": "We expanded", "tr": "nashraḥ", "audio": "wbw/094_001_002.mp3"}, {"type": "word", "ar": "لَكَ", "tajweed": "لَكَ", "en": "for you", "tr": "laka", "audio": "wbw/094_001_003.mp3"}, {"type": "word", "ar": "صَدْرَكَ", "tajweed": "صَ<rule class=qalaqah>دۡ</rule>رَكَ", "en": "your breast", "tr": "ṣadraka", "audio": "wbw/094_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "94:2", "juz": 30, "page": 596, "side_trans": "And We removed from you your burden", "words": [{"type": "word", "ar": "وَوَضَعْنَا", "tajweed": "وَوَضَعۡنَا", "en": "And We removed", "tr": "wawaḍaʿnā", "audio": "wbw/094_002_001.mp3"}, {"type": "word", "ar": "عَنكَ", "tajweed": "عَ<rule class=ikhafa>نك</rule>َ", "en": "from you", "tr": "ʿanka", "audio": "wbw/094_002_002.mp3"}, {"type": "word", "ar": "وِزْرَكَ", "tajweed": "وِزۡرَكَ", "en": "your burden", "tr": "wiz'raka", "audio": "wbw/094_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "94:3", "juz": 30, "page": 597, "side_trans": "Which had weighed upon your back", "words": [{"type": "word", "ar": "ٱلَّذِىٓ", "tajweed": "ٱلَّذ<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "Which", "tr": "alladhī", "audio": "wbw/094_003_001.mp3"}, {"type": "word", "ar": "أَنقَضَ", "tajweed": "أَ<rule class=ikhafa>نق</rule>َضَ", "en": "weighed upon", "tr": "anqaḍa", "audio": "wbw/094_003_002.mp3"}, {"type": "word", "ar": "ظَهْرَكَ", "tajweed": "ظَهۡرَكَ", "en": "your back", "tr": "ẓahraka", "audio": "wbw/094_003_003.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "94:4", "juz": 30, "page": 597, "side_trans": "And raised high for you your repute.", "words": [{"type": "word", "ar": "وَرَفَعْنَا", "tajweed": "وَرَفَعۡنَا", "en": "And We raised high", "tr": "warafaʿnā", "audio": "wbw/094_004_001.mp3"}, {"type": "word", "ar": "لَكَ", "tajweed": "لَكَ", "en": "for you", "tr": "laka", "audio": "wbw/094_004_002.mp3"}, {"type": "word", "ar": "ذِكْرَكَ", "tajweed": "ذِكۡرَكَ", "en": "your reputation", "tr": "dhik'raka", "audio": "wbw/094_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "94:5", "juz": 30, "page": 597, "side_trans": "For indeed, with hardship [will be] ease [i.e., relief].", "words": [{"type": "word", "ar": "فَإِنَّ", "tajweed": "فَإِ<rule class=ghunnah>نّ</rule>َ", "en": "So indeed", "tr": "fa-inna", "audio": "wbw/094_005_001.mp3"}, {"type": "word", "ar": "مَعَ", "tajweed": "مَعَ", "en": "with", "tr": "maʿa", "audio": "wbw/094_005_002.mp3"}, {"type": "word", "ar": "ٱلْعُسْرِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعُسۡرِ", "en": "the hardship", "tr": "l-ʿus'ri", "audio": "wbw/094_005_003.mp3"}, {"type": "word", "ar": "يُسْرًا", "tajweed": "يُسۡرًا", "en": "(is) ease", "tr": "yus'ran", "audio": "wbw/094_005_004.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "94:6", "juz": 30, "page": 597, "side_trans": "Indeed, with hardship [will be] ease.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/094_006_001.mp3"}, {"type": "word", "ar": "مَعَ", "tajweed": "مَعَ", "en": "with", "tr": "maʿa", "audio": "wbw/094_006_002.mp3"}, {"type": "word", "ar": "ٱلْعُسْرِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعُسۡرِ", "en": "the hardship", "tr": "l-ʿus'ri", "audio": "wbw/094_006_003.mp3"}, {"type": "word", "ar": "يُسْرًۭا", "tajweed": "يُسۡرًا", "en": "(is) ease", "tr": "yus'ran", "audio": "wbw/094_006_004.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "94:7", "juz": 30, "page": 597, "side_trans": "So when you have finished [your duties], then stand up [for worship].", "words": [{"type": "word", "ar": "فَإِذَا", "tajweed": "فَإِذَا", "en": "So when", "tr": "fa-idhā", "audio": "wbw/094_007_001.mp3"}, {"type": "word", "ar": "فَرَغْتَ", "tajweed": "فَرَغۡتَ", "en": "you have finished", "tr": "faraghta", "audio": "wbw/094_007_002.mp3"}, {"type": "word", "ar": "فَٱنصَبْ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule><rule class=ikhafa>نص</rule>َ<rule class=qalaqah>بۡ</rule>", "en": "then labor hard", "tr": "fa-inṣab", "audio": "wbw/094_007_003.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "94:8", "juz": 30, "page": 597, "side_trans": "And to your Lord direct [your] longing.", "words": [{"type": "word", "ar": "وَإِلَىٰ", "tajweed": "وَإِلَىٰ", "en": "And to", "tr": "wa-ilā", "audio": "wbw/094_008_001.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "your Lord", "tr": "rabbika", "audio": "wbw/094_008_002.mp3"}, {"type": "word", "ar": "فَٱرْغَب", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>رۡغَ<rule class=qalaqah>ب</rule>", "en": "turn your attention", "tr": "fa-ir'ghab", "audio": "wbw/094_008_003.mp3"}, {"type": "end", "num": "٨"}]}]