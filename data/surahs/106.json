[{"id": 1, "key": "106:1", "juz": 30, "page": 602, "side_trans": "For the accustomed security of the Quraysh -", "words": [{"type": "word", "ar": "لِإِيلَـٰفِ", "tajweed": "لِإِيلَ<rule class=madda_normal>ـٰ</rule>فِ", "en": "For (the) familiarity", "tr": "liīlāfi", "audio": "wbw/106_001_001.mp3"}, {"type": "word", "ar": "قُرَيْشٍ", "tajweed": "قُر<rule class=madda_permissible>َي</rule>ۡشٍ", "en": "(of the) Quraish", "tr": "qurayshin", "audio": "wbw/106_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "106:2", "juz": 30, "page": 602, "side_trans": "Their accustomed security [in] the caravan of winter and summer -", "words": [{"type": "word", "ar": "إِۦلَـٰفِهِمْ", "tajweed": "إ<rule class=madda_normal>ِۦ</rule>لَ<rule class=madda_normal>ـٰ</rule>فِهِمۡ", "en": "Their familiarity", "tr": "īlāfihim", "audio": "wbw/106_002_001.mp3"}, {"type": "word", "ar": "رِحْلَةَ", "tajweed": "رِحۡلَةَ", "en": "(with the) journey", "tr": "riḥ'lata", "audio": "wbw/106_002_002.mp3"}, {"type": "word", "ar": "ٱلشِّتَآءِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شِّت<rule class=madda_obligatory_mottasel>َا</rule>ٓءِ", "en": "(of) winter", "tr": "l-shitāi", "audio": "wbw/106_002_003.mp3"}, {"type": "word", "ar": "وَٱلصَّيْفِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صّ<rule class=madda_permissible>َي</rule>ۡفِ", "en": "and summer", "tr": "wal-ṣayfi", "audio": "wbw/106_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "106:3", "juz": 30, "page": 602, "side_trans": "Let them worship the Lord of this House,", "words": [{"type": "word", "ar": "فَلْيَعْبُدُوا۟", "tajweed": "فَلۡيَعۡبُدُو<rule class=slnt>اۡ</rule>", "en": "So let them worship", "tr": "falyaʿbudū", "audio": "wbw/106_003_001.mp3"}, {"type": "word", "ar": "رَبَّ", "tajweed": "رَبَّ", "en": "(the) Lord", "tr": "rabba", "audio": "wbw/106_003_002.mp3"}, {"type": "word", "ar": "هَـٰذَا", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>ذَا", "en": "(of) this", "tr": "hādhā", "audio": "wbw/106_003_003.mp3"}, {"type": "word", "ar": "ٱلْبَيْتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡب<rule class=madda_permissible>َي</rule>ۡتِ", "en": "House", "tr": "l-bayti", "audio": "wbw/106_003_004.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "106:4", "juz": 30, "page": 602, "side_trans": "Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear.", "words": [{"type": "word", "ar": "ٱلَّذِىٓ", "tajweed": "ٱلَّذ<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "The One Who", "tr": "alladhī", "audio": "wbw/106_004_001.mp3"}, {"type": "word", "ar": "أَطْعَمَهُم", "tajweed": "أَ<rule class=qalaqah>طۡ</rule>عَمَه<rule class=idgham_shafawi>ُم</rule>", "en": "feeds them", "tr": "aṭʿamahum", "audio": "wbw/106_004_002.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_shafawi>م</rule>ِّ<rule class=ikhafa>ن</rule>", "en": "[from]", "tr": "min", "audio": "wbw/106_004_003.mp3"}, {"type": "word", "ar": "جُوعٍۢ", "tajweed": "<rule class=ikhafa>ج</rule>ُو<rule class=idgham_ghunnah>عٍ</rule>", "en": "(against) hunger", "tr": "jūʿin", "audio": "wbw/106_004_004.mp3"}, {"type": "word", "ar": "وَءَامَنَهُم", "tajweed": "<rule class=idgham_ghunnah>و</rule>َءَامَنَه<rule class=idgham_shafawi>ُم</rule>", "en": "and gives them security", "tr": "waāmanahum", "audio": "wbw/106_004_005.mp3"}, {"type": "word", "ar": "مِّنْ", "tajweed": "<rule class=idgham_shafawi>م</rule>ِّنۡ", "en": "from", "tr": "min", "audio": "wbw/106_004_006.mp3"}, {"type": "word", "ar": "خَوْفٍۭ", "tajweed": "خ<rule class=madda_permissible>َو</rule>ۡفِۭ", "en": "fear", "tr": "khawfin", "audio": "wbw/106_004_007.mp3"}, {"type": "end", "num": "٤"}]}]