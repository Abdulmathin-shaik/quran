[{"id": 1, "key": "105:1", "juz": 30, "page": 601, "side_trans": "Have you not considered, [O Muḥammad], how your Lord dealt with the companions of the elephant?", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Have not", "tr": "alam", "audio": "wbw/105_001_001.mp3"}, {"type": "word", "ar": "تَرَ", "tajweed": "تَرَ", "en": "you seen", "tr": "tara", "audio": "wbw/105_001_002.mp3"}, {"type": "word", "ar": "كَيْفَ", "tajweed": "كَيۡفَ", "en": "how", "tr": "kayfa", "audio": "wbw/105_001_003.mp3"}, {"type": "word", "ar": "فَعَلَ", "tajweed": "فَعَلَ", "en": "dealt", "tr": "faʿala", "audio": "wbw/105_001_004.mp3"}, {"type": "word", "ar": "رَبُّكَ", "tajweed": "رَبُّكَ", "en": "your Lord", "tr": "rabbuka", "audio": "wbw/105_001_005.mp3"}, {"type": "word", "ar": "بِأَصْحَـٰبِ", "tajweed": "بِأَصۡحَ<rule class=madda_normal>ـٰ</rule>بِ", "en": "with (the) Companions", "tr": "bi-aṣḥābi", "audio": "wbw/105_001_006.mp3"}, {"type": "word", "ar": "ٱلْفِيلِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡف<rule class=madda_permissible>ِي</rule>لِ", "en": "(of the) Elephant", "tr": "l-fīli", "audio": "wbw/105_001_007.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "105:2", "juz": 30, "page": 601, "side_trans": "Did He not make their plan into misguidance?", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Did not", "tr": "alam", "audio": "wbw/105_002_001.mp3"}, {"type": "word", "ar": "يَجْعَلْ", "tajweed": "يَ<rule class=qalaqah>جۡ</rule>عَلۡ", "en": "He make", "tr": "yajʿal", "audio": "wbw/105_002_002.mp3"}, {"type": "word", "ar": "كَيْدَهُمْ", "tajweed": "كَيۡدَهُمۡ", "en": "their plan", "tr": "kaydahum", "audio": "wbw/105_002_003.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "go", "tr": "fī", "audio": "wbw/105_002_004.mp3"}, {"type": "word", "ar": "تَضْلِيلٍۢ", "tajweed": "تَضۡل<rule class=madda_permissible>ِي</rule>لٍ", "en": "astray", "tr": "taḍlīlin", "audio": "wbw/105_002_005.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "105:3", "juz": 30, "page": 601, "side_trans": "And He sent against them birds in flocks,", "words": [{"type": "word", "ar": "وَأَرْسَلَ", "tajweed": "وَأَرۡسَلَ", "en": "And He sent", "tr": "wa-arsala", "audio": "wbw/105_003_001.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ", "tajweed": "عَلَيۡهِمۡ", "en": "against them", "tr": "ʿalayhim", "audio": "wbw/105_003_002.mp3"}, {"type": "word", "ar": "طَيْرًا", "tajweed": "طَيۡرًا", "en": "birds", "tr": "ṭayran", "audio": "wbw/105_003_003.mp3"}, {"type": "word", "ar": "أَبَابِيلَ", "tajweed": "أَبَاب<rule class=madda_permissible>ِي</rule>لَ", "en": "(in) flocks", "tr": "abābīla", "audio": "wbw/105_003_004.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "105:4", "juz": 30, "page": 601, "side_trans": "Striking them with stones of hard clay,", "words": [{"type": "word", "ar": "تَرْمِيهِم", "tajweed": "تَرۡمِيه<rule class=ikhafa_shafawi>ِم</rule>", "en": "Striking them", "tr": "tarmīhim", "audio": "wbw/105_004_001.mp3"}, {"type": "word", "ar": "بِحِجَارَةٍۢ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِحِجَارَ<rule class=idgham_ghunnah>ةٍ</rule>", "en": "with stones", "tr": "biḥijāratin", "audio": "wbw/105_004_002.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّ<rule class=ikhafa>ن</rule>", "en": "of", "tr": "min", "audio": "wbw/105_004_003.mp3"}, {"type": "word", "ar": "سِجِّيلٍۢ", "tajweed": "<rule class=ikhafa>س</rule>ِجّ<rule class=madda_permissible>ِي</rule>لٍ", "en": "baked clay", "tr": "sijjīlin", "audio": "wbw/105_004_004.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "105:5", "juz": 30, "page": 601, "side_trans": "And He made them like eaten straw.", "words": [{"type": "word", "ar": "فَجَعَلَهُمْ", "tajweed": "فَجَعَلَهُمۡ", "en": "Then He made them", "tr": "fajaʿalahum", "audio": "wbw/105_005_001.mp3"}, {"type": "word", "ar": "كَعَصْفٍۢ", "tajweed": "كَعَصۡ<rule class=idgham_ghunnah>فٍ</rule>", "en": "like straw", "tr": "kaʿaṣfin", "audio": "wbw/105_005_002.mp3"}, {"type": "word", "ar": "مَّأْكُولٍۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّأۡك<rule class=madda_permissible>ُو</rule>لِۭ", "en": "eaten up", "tr": "makūlin", "audio": "wbw/105_005_003.mp3"}, {"type": "end", "num": "٥"}]}]