[{"id": 1, "key": "89:1", "juz": 30, "page": 593, "side_trans": "By the dawn", "words": [{"type": "word", "ar": "وَٱلْفَجْرِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡفَ<rule class=qalaqah>جۡ</rule>رِ", "en": "By the dawn", "tr": "wal-fajri", "audio": "wbw/089_001_001.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "89:2", "juz": 30, "page": 593, "side_trans": "And [by] ten nights", "words": [{"type": "word", "ar": "وَلَيَالٍ", "tajweed": "وَلَيَالٍ", "en": "And the nights", "tr": "walayālin", "audio": "wbw/089_002_001.mp3"}, {"type": "word", "ar": "عَشْرٍۢ", "tajweed": "عَشۡرٍ", "en": "ten", "tr": "ʿashrin", "audio": "wbw/089_002_002.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "89:3", "juz": 30, "page": 593, "side_trans": "And [by] the even [number] and the odd", "words": [{"type": "word", "ar": "وَٱلشَّفْعِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شَّفۡعِ", "en": "And the even", "tr": "wal-shafʿi", "audio": "wbw/089_003_001.mp3"}, {"type": "word", "ar": "وَٱلْوَتْرِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡوَتۡرِ", "en": "and the odd", "tr": "wal-watri", "audio": "wbw/089_003_002.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "89:4", "juz": 30, "page": 593, "side_trans": "And [by] the night when it passes,", "words": [{"type": "word", "ar": "وَٱلَّيْلِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّيۡلِ", "en": "And the night", "tr": "wa-al-layli", "audio": "wbw/089_004_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/089_004_002.mp3"}, {"type": "word", "ar": "يَسْرِ", "tajweed": "يَسۡرِ", "en": "it passes", "tr": "yasri", "audio": "wbw/089_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "89:5", "juz": 30, "page": 593, "side_trans": "Is there [not] in [all] that an oath [sufficient] for one of perception?", "words": [{"type": "word", "ar": "هَلْ", "tajweed": "هَلۡ", "en": "Is", "tr": "hal", "audio": "wbw/089_005_001.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/089_005_002.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "that", "tr": "dhālika", "audio": "wbw/089_005_003.mp3"}, {"type": "word", "ar": "قَسَمٌۭ", "tajweed": "قَسَ<rule class=idgham_wo_ghunnah>مٌ</rule>", "en": "(not) an oath", "tr": "qasamun", "audio": "wbw/089_005_004.mp3"}, {"type": "word", "ar": "لِّذِى", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّذِى", "en": "for those", "tr": "lidhī", "audio": "wbw/089_005_005.mp3"}, {"type": "word", "ar": "حِجْرٍ", "tajweed": "حِ<rule class=qalaqah>جۡ</rule>رٍ", "en": "who understand", "tr": "ḥij'rin", "audio": "wbw/089_005_006.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "89:6", "juz": 30, "page": 593, "side_trans": "Have you not considered how your Lord dealt with ʿAad -", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Did not", "tr": "alam", "audio": "wbw/089_006_001.mp3"}, {"type": "word", "ar": "تَرَ", "tajweed": "تَرَ", "en": "you see", "tr": "tara", "audio": "wbw/089_006_002.mp3"}, {"type": "word", "ar": "كَيْفَ", "tajweed": "كَيۡفَ", "en": "how", "tr": "kayfa", "audio": "wbw/089_006_003.mp3"}, {"type": "word", "ar": "فَعَلَ", "tajweed": "فَعَلَ", "en": "dealt", "tr": "faʿala", "audio": "wbw/089_006_004.mp3"}, {"type": "word", "ar": "رَبُّكَ", "tajweed": "رَبُّكَ", "en": "your Lord", "tr": "rabbuka", "audio": "wbw/089_006_005.mp3"}, {"type": "word", "ar": "بِعَادٍ", "tajweed": "بِع<rule class=madda_permissible>َا</rule><rule class=qalaqah>د</rule>ٍ", "en": "with Aad", "tr": "biʿādin", "audio": "wbw/089_006_006.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "89:7", "juz": 30, "page": 593, "side_trans": "[With] Iram - who had lofty pillars,", "words": [{"type": "word", "ar": "إِرَمَ", "tajweed": "إِرَمَ", "en": "Iram", "tr": "irama", "audio": "wbw/089_007_001.mp3"}, {"type": "word", "ar": "ذَاتِ", "tajweed": "ذَاتِ", "en": "possessors (of)", "tr": "dhāti", "audio": "wbw/089_007_002.mp3"}, {"type": "word", "ar": "ٱلْعِمَادِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعِم<rule class=madda_permissible>َا</rule><rule class=qalaqah>د</rule>ِ", "en": "lofty pillars", "tr": "l-ʿimādi", "audio": "wbw/089_007_003.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "89:8", "juz": 30, "page": 593, "side_trans": "The likes of whom had never been created in the land?", "words": [{"type": "word", "ar": "ٱلَّتِى", "tajweed": "ٱلَّتِى", "en": "Which", "tr": "allatī", "audio": "wbw/089_008_001.mp3"}, {"type": "word", "ar": "لَمْ", "tajweed": "لَمۡ", "en": "not", "tr": "lam", "audio": "wbw/089_008_002.mp3"}, {"type": "word", "ar": "يُخْلَقْ", "tajweed": "يُخۡلَ<rule class=qalaqah>قۡ</rule>", "en": "had been created", "tr": "yukh'laq", "audio": "wbw/089_008_003.mp3"}, {"type": "word", "ar": "مِثْلُهَا", "tajweed": "مِثۡلُهَا", "en": "like them", "tr": "mith'luhā", "audio": "wbw/089_008_004.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/089_008_005.mp3"}, {"type": "word", "ar": "ٱلْبِلَـٰدِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبِلَ<rule class=madda_permissible>ـٰ</rule><rule class=qalaqah>د</rule>ِ", "en": "the cities", "tr": "l-bilādi", "audio": "wbw/089_008_006.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "89:9", "juz": 30, "page": 593, "side_trans": "And [with] Thamūd, who carved out the rocks in the valley?", "words": [{"type": "word", "ar": "وَثَمُودَ", "tajweed": "وَثَمُودَ", "en": "And Thamud", "tr": "wathamūda", "audio": "wbw/089_009_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "who", "tr": "alladhīna", "audio": "wbw/089_009_002.mp3"}, {"type": "word", "ar": "جَابُوا۟", "tajweed": "جَابُو<rule class=slnt>اۡ</rule>", "en": "carved out", "tr": "jābū", "audio": "wbw/089_009_003.mp3"}, {"type": "word", "ar": "ٱلصَّخْرَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّخۡرَ", "en": "the rocks", "tr": "l-ṣakhra", "audio": "wbw/089_009_004.mp3"}, {"type": "word", "ar": "بِٱلْوَادِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡو<rule class=madda_permissible>َا</rule><rule class=qalaqah>د</rule>ِ", "en": "in the valley", "tr": "bil-wādi", "audio": "wbw/089_009_005.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "89:10", "juz": 30, "page": 593, "side_trans": "And [with] Pharaoh, owner of the stakes?", "words": [{"type": "word", "ar": "وَفِرْعَوْنَ", "tajweed": "وَفِرۡعَوۡنَ", "en": "And Firaun", "tr": "wafir'ʿawna", "audio": "wbw/089_010_001.mp3"}, {"type": "word", "ar": "ذِى", "tajweed": "ذِى", "en": "owner of", "tr": "dhī", "audio": "wbw/089_010_002.mp3"}, {"type": "word", "ar": "ٱلْأَوْتَادِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَوۡت<rule class=madda_permissible>َا</rule><rule class=qalaqah>د</rule>ِ", "en": "stakes", "tr": "l-awtādi", "audio": "wbw/089_010_003.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "89:11", "juz": 30, "page": 593, "side_trans": "[All of] whom oppressed within the lands", "words": [{"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "ٱلَّذِينَ", "en": "Who", "tr": "alladhīna", "audio": "wbw/089_011_001.mp3"}, {"type": "word", "ar": "طَغَوْا۟", "tajweed": "طَغَوۡ<rule class=slnt>اۡ</rule>", "en": "transgressed", "tr": "ṭaghaw", "audio": "wbw/089_011_002.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/089_011_003.mp3"}, {"type": "word", "ar": "ٱلْبِلَـٰدِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبِلَ<rule class=madda_permissible>ـٰ</rule><rule class=qalaqah>د</rule>ِ", "en": "the lands", "tr": "l-bilādi", "audio": "wbw/089_011_004.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "89:12", "juz": 30, "page": 593, "side_trans": "And increased therein the corruption.", "words": [{"type": "word", "ar": "فَأَكْثَرُوا۟", "tajweed": "فَأَكۡثَرُو<rule class=slnt>اۡ</rule>", "en": "And (made) much", "tr": "fa-aktharū", "audio": "wbw/089_012_001.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/089_012_002.mp3"}, {"type": "word", "ar": "ٱلْفَسَادَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَس<rule class=madda_permissible>َا</rule><rule class=qalaqah>د</rule>َ", "en": "corruption", "tr": "l-fasāda", "audio": "wbw/089_012_003.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "89:13", "juz": 30, "page": 593, "side_trans": "So your Lord poured upon them a scourge of punishment.", "words": [{"type": "word", "ar": "فَصَبَّ", "tajweed": "فَصَبَّ", "en": "So poured", "tr": "faṣabba", "audio": "wbw/089_013_001.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ", "tajweed": "عَلَيۡهِمۡ", "en": "on them", "tr": "ʿalayhim", "audio": "wbw/089_013_002.mp3"}, {"type": "word", "ar": "رَبُّكَ", "tajweed": "رَبُّكَ", "en": "your Lord", "tr": "rabbuka", "audio": "wbw/089_013_003.mp3"}, {"type": "word", "ar": "سَوْطَ", "tajweed": "سَوۡطَ", "en": "scourge", "tr": "sawṭa", "audio": "wbw/089_013_004.mp3"}, {"type": "word", "ar": "عَذَابٍ", "tajweed": "عَذ<rule class=madda_permissible>َا</rule><rule class=qalaqah>ب</rule>ٍ", "en": "(of) punishment", "tr": "ʿadhābin", "audio": "wbw/089_013_005.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "89:14", "juz": 30, "page": 593, "side_trans": "Indeed, your Lord is in observation.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/089_014_001.mp3"}, {"type": "word", "ar": "رَبَّكَ", "tajweed": "رَبَّكَ", "en": "your Lord", "tr": "rabbaka", "audio": "wbw/089_014_002.mp3"}, {"type": "word", "ar": "لَبِٱلْمِرْصَادِ", "tajweed": "لَبِ<rule class=ham_wasl>ٱ</rule>لۡمِرۡص<rule class=madda_permissible>َا</rule><rule class=qalaqah>د</rule>ِ", "en": "(is) surely Ever Watchful", "tr": "labil-mir'ṣādi", "audio": "wbw/089_014_003.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "89:15", "juz": 30, "page": 593, "side_trans": "And as for man, when his Lord tries him and [thus] is generous to him and favors him, he says, \"My Lord has honored me.\"", "words": [{"type": "word", "ar": "فَأَمَّا", "tajweed": "فَأَ<rule class=ghunnah>مّ</rule>َا", "en": "And as for", "tr": "fa-ammā", "audio": "wbw/089_015_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "man", "tr": "l-insānu", "audio": "wbw/089_015_002.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/089_015_003.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "does", "tr": "mā", "audio": "wbw/089_015_004.mp3"}, {"type": "word", "ar": "ٱبْتَلَىٰهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>بۡ</rule>تَلَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "try him", "tr": "ib'talāhu", "audio": "wbw/089_015_005.mp3"}, {"type": "word", "ar": "رَبُّهُۥ", "tajweed": "رَبُّهُ<rule class=madda_normal>ۥ</rule>", "en": "his Lord", "tr": "rabbuhu", "audio": "wbw/089_015_006.mp3"}, {"type": "word", "ar": "فَأَكْرَمَهُۥ", "tajweed": "فَأَكۡرَمَهُ<rule class=madda_normal>ۥ</rule>", "en": "and is generous to him", "tr": "fa-akramahu", "audio": "wbw/089_015_007.mp3"}, {"type": "word", "ar": "وَنَعَّمَهُۥ", "tajweed": "وَنَعَّمَهُ<rule class=madda_normal>ۥ</rule>", "en": "and favors him", "tr": "wanaʿʿamahu", "audio": "wbw/089_015_008.mp3"}, {"type": "word", "ar": "فَيَقُولُ", "tajweed": "فَيَقُولُ", "en": "he says", "tr": "fayaqūlu", "audio": "wbw/089_015_009.mp3"}, {"type": "word", "ar": "رَبِّىٓ", "tajweed": "رَبّ<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "My Lord", "tr": "rabbī", "audio": "wbw/089_015_010.mp3"}, {"type": "word", "ar": "أَكْرَمَنِ", "tajweed": "أَكۡرَمَنِ", "en": "has honored me", "tr": "akramani", "audio": "wbw/089_015_011.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "89:16", "juz": 30, "page": 593, "side_trans": "But when He tries him and restricts his provision, he says, \"My Lord has humiliated me.\"", "words": [{"type": "word", "ar": "وَأَمَّآ", "tajweed": "وَأَ<rule class=ghunnah>مّ</rule><rule class=madda_obligatory_monfasel>َآ</rule>", "en": "But", "tr": "wa-ammā", "audio": "wbw/089_016_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/089_016_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "does", "tr": "mā", "audio": "wbw/089_016_003.mp3"}, {"type": "word", "ar": "ٱبْتَلَىٰهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>بۡ</rule>تَلَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "He try him", "tr": "ib'talāhu", "audio": "wbw/089_016_004.mp3"}, {"type": "word", "ar": "فَقَدَرَ", "tajweed": "فَقَدَرَ", "en": "and restricts", "tr": "faqadara", "audio": "wbw/089_016_005.mp3"}, {"type": "word", "ar": "عَلَيْهِ", "tajweed": "عَلَيۡهِ", "en": "for him", "tr": "ʿalayhi", "audio": "wbw/089_016_006.mp3"}, {"type": "word", "ar": "رِزْقَهُۥ", "tajweed": "رِزۡقَهُ<rule class=madda_normal>ۥ</rule>", "en": "his provision", "tr": "riz'qahu", "audio": "wbw/089_016_007.mp3"}, {"type": "word", "ar": "فَيَقُولُ", "tajweed": "فَيَقُولُ", "en": "then he says", "tr": "fayaqūlu", "audio": "wbw/089_016_008.mp3"}, {"type": "word", "ar": "رَبِّىٓ", "tajweed": "رَبّ<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "My Lord", "tr": "rabbī", "audio": "wbw/089_016_009.mp3"}, {"type": "word", "ar": "أَهَـٰنَنِ", "tajweed": "أَهَ<rule class=madda_normal>ـٰ</rule>نَنِ", "en": "(has) humiliated me", "tr": "ahānani", "audio": "wbw/089_016_010.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "89:17", "juz": 30, "page": 593, "side_trans": "No! But you do not honor the orphan", "words": [{"type": "word", "ar": "كَلَّا ۖ", "tajweed": "كَلَّا‌ۖ", "en": "Nay", "tr": "kallā", "audio": "wbw/089_017_001.mp3"}, {"type": "word", "ar": "بَل", "tajweed": "بَل", "en": "But", "tr": "bal", "audio": "wbw/089_017_003.mp3"}, {"type": "word", "ar": "لَّا", "tajweed": "لَّا", "en": "not", "tr": "lā", "audio": "wbw/089_017_004.mp3"}, {"type": "word", "ar": "تُكْرِمُونَ", "tajweed": "تُكۡرِمُونَ", "en": "you honor", "tr": "tuk'rimūna", "audio": "wbw/089_017_005.mp3"}, {"type": "word", "ar": "ٱلْيَتِيمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَت<rule class=madda_permissible>ِي</rule>مَ", "en": "the orphan", "tr": "l-yatīma", "audio": "wbw/089_017_006.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "89:18", "juz": 30, "page": 593, "side_trans": "And you do not encourage one another to feed the poor.", "words": [{"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "And not", "tr": "walā", "audio": "wbw/089_018_001.mp3"}, {"type": "word", "ar": "تَحَـٰٓضُّونَ", "tajweed": "تَحَ<rule class=madda_necessary>ـٰٓ</rule>ضُّونَ", "en": "you feel the urge", "tr": "taḥāḍḍūna", "audio": "wbw/089_018_002.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "to", "tr": "ʿalā", "audio": "wbw/089_018_003.mp3"}, {"type": "word", "ar": "طَعَامِ", "tajweed": "طَعَامِ", "en": "feed", "tr": "ṭaʿāmi", "audio": "wbw/089_018_004.mp3"}, {"type": "word", "ar": "ٱلْمِسْكِينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمِسۡك<rule class=madda_permissible>ِي</rule>نِ", "en": "the poor", "tr": "l-mis'kīni", "audio": "wbw/089_018_005.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "89:19", "juz": 30, "page": 593, "side_trans": "And you consume inheritance, devouring [it] altogether,", "words": [{"type": "word", "ar": "وَتَأْكُلُونَ", "tajweed": "وَتَأۡكُلُونَ", "en": "And you consume", "tr": "watakulūna", "audio": "wbw/089_019_001.mp3"}, {"type": "word", "ar": "ٱلتُّرَاثَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>تُّرَاثَ", "en": "the inheritance", "tr": "l-turātha", "audio": "wbw/089_019_002.mp3"}, {"type": "word", "ar": "أَكْلًۭا", "tajweed": "أَكۡل<rule class=idgham_wo_ghunnah>اً</rule>", "en": "devouring", "tr": "aklan", "audio": "wbw/089_019_003.mp3"}, {"type": "word", "ar": "لَّمًّۭا", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّ<rule class=ghunnah>مّ</rule>ًا", "en": "altogether", "tr": "lamman", "audio": "wbw/089_019_004.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "89:20", "juz": 30, "page": 593, "side_trans": "And you love wealth with immense love.", "words": [{"type": "word", "ar": "وَتُحِبُّونَ", "tajweed": "وَتُحِبُّونَ", "en": "And you love", "tr": "watuḥibbūna", "audio": "wbw/089_020_001.mp3"}, {"type": "word", "ar": "ٱلْمَالَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَالَ", "en": "wealth", "tr": "l-māla", "audio": "wbw/089_020_002.mp3"}, {"type": "word", "ar": "حُبًّۭا", "tajweed": "حُب<rule class=ikhafa>ًّا</rule>", "en": "(with) love", "tr": "ḥubban", "audio": "wbw/089_020_003.mp3"}, {"type": "word", "ar": "جَمًّۭا", "tajweed": "<rule class=ikhafa>ج</rule>َ<rule class=ghunnah>مّ</rule>ًا", "en": "immense", "tr": "jamman", "audio": "wbw/089_020_004.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "89:21", "juz": 30, "page": 593, "side_trans": "No! When the earth has been leveled - pounded and crushed", "words": [{"type": "word", "ar": "كَلَّآ", "tajweed": "كَلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Nay", "tr": "kallā", "audio": "wbw/089_021_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/089_021_002.mp3"}, {"type": "word", "ar": "دُكَّتِ", "tajweed": "دُكَّتِ", "en": "is leveled", "tr": "dukkati", "audio": "wbw/089_021_003.mp3"}, {"type": "word", "ar": "ٱلْأَرْضُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضُ", "en": "the earth", "tr": "l-arḍu", "audio": "wbw/089_021_004.mp3"}, {"type": "word", "ar": "دَكًّۭا", "tajweed": "دَك<rule class=ikhafa>ًّا</rule>", "en": "pounded", "tr": "dakkan", "audio": "wbw/089_021_005.mp3"}, {"type": "word", "ar": "دَكًّۭا", "tajweed": "<rule class=ikhafa>د</rule>َكًّا", "en": "(and) crushed", "tr": "dakkan", "audio": "wbw/089_021_006.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "89:22", "juz": 30, "page": 593, "side_trans": "And your Lord has come and the angels, rank upon rank,", "words": [{"type": "word", "ar": "وَجَآءَ", "tajweed": "وَج<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "And comes", "tr": "wajāa", "audio": "wbw/089_022_001.mp3"}, {"type": "word", "ar": "رَبُّكَ", "tajweed": "رَبُّكَ", "en": "your Lord", "tr": "rabbuka", "audio": "wbw/089_022_002.mp3"}, {"type": "word", "ar": "وَٱلْمَلَكُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمَلَكُ", "en": "and the Angels", "tr": "wal-malaku", "audio": "wbw/089_022_003.mp3"}, {"type": "word", "ar": "صَفًّۭا", "tajweed": "صَف<rule class=ikhafa>ًّا</rule>", "en": "rank", "tr": "ṣaffan", "audio": "wbw/089_022_004.mp3"}, {"type": "word", "ar": "صَفًّۭا", "tajweed": "<rule class=ikhafa>ص</rule>َفًّا", "en": "(upon) rank", "tr": "ṣaffan", "audio": "wbw/089_022_005.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "89:23", "juz": 30, "page": 594, "side_trans": "And brought [within view], that Day, is Hell - that Day, man will remember, but how [i.e., what good] to him will be the remembrance?", "words": [{"type": "word", "ar": "وَجِا۟ىٓءَ", "tajweed": "وَجِ<rule class=slnt>اۡ</rule><rule class=madda_obligatory_mottasel>ىٓ</rule>ءَ", "en": "And is brought", "tr": "wajīa", "audio": "wbw/089_023_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۭ", "tajweed": "يَوۡمَئِ<rule class=iqlab>ذِۭ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/089_023_002.mp3"}, {"type": "word", "ar": "بِجَهَنَّمَ ۚ", "tajweed": "<rule class=iqlab>ب</rule>ِجَهَ<rule class=ghunnah>نّ</rule>َمَ‌ۚ", "en": "Hell", "tr": "bijahannama", "audio": "wbw/089_023_003.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "يَوۡمَئِ<rule class=idgham_ghunnah>ذٍ</rule>", "en": "That Day", "tr": "yawma-idhin", "audio": "wbw/089_023_005.mp3"}, {"type": "word", "ar": "يَتَذَكَّرُ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َتَذَكَّرُ", "en": "will remember", "tr": "yatadhakkaru", "audio": "wbw/089_023_006.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "man", "tr": "l-insānu", "audio": "wbw/089_023_007.mp3"}, {"type": "word", "ar": "وَأَنَّىٰ", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َىٰ", "en": "but how", "tr": "wa-annā", "audio": "wbw/089_023_008.mp3"}, {"type": "word", "ar": "لَهُ", "tajweed": "لَهُ", "en": "(will be) for him", "tr": "lahu", "audio": "wbw/089_023_009.mp3"}, {"type": "word", "ar": "ٱلذِّكْرَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ذِّكۡرَىٰ", "en": "the remembrance", "tr": "l-dhik'rā", "audio": "wbw/089_023_010.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "89:24", "juz": 30, "page": 594, "side_trans": "He will say, \"Oh, I wish I had sent ahead [some good] for my life.\"", "words": [{"type": "word", "ar": "يَقُولُ", "tajweed": "يَقُولُ", "en": "He will say", "tr": "yaqūlu", "audio": "wbw/089_024_001.mp3"}, {"type": "word", "ar": "يَـٰلَيْتَنِى", "tajweed": "يَ<rule class=madda_normal>ـٰ</rule>لَيۡتَنِى", "en": "O I wish", "tr": "yālaytanī", "audio": "wbw/089_024_002.mp3"}, {"type": "word", "ar": "قَدَّمْتُ", "tajweed": "قَدَّمۡتُ", "en": "I had sent forth", "tr": "qaddamtu", "audio": "wbw/089_024_003.mp3"}, {"type": "word", "ar": "لِحَيَاتِى", "tajweed": "لِحَيَاتِى", "en": "for my life", "tr": "liḥayātī", "audio": "wbw/089_024_004.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "89:25", "juz": 30, "page": 594, "side_trans": "So on that Day, none will punish [as severely] as His punishment,", "words": [{"type": "word", "ar": "فَيَوْمَئِذٍۢ", "tajweed": "فَيَوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "So that Day", "tr": "fayawma-idhin", "audio": "wbw/089_025_001.mp3"}, {"type": "word", "ar": "لَّا", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّا", "en": "not", "tr": "lā", "audio": "wbw/089_025_002.mp3"}, {"type": "word", "ar": "يُعَذِّبُ", "tajweed": "يُعَذِّبُ", "en": "will punish", "tr": "yuʿadhibu", "audio": "wbw/089_025_003.mp3"}, {"type": "word", "ar": "عَذَابَهُۥٓ", "tajweed": "عَذَابَهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "(as) His punishment", "tr": "ʿadhābahu", "audio": "wbw/089_025_004.mp3"}, {"type": "word", "ar": "أَحَدٌۭ", "tajweed": "أَحَ<rule class=qalaqah>د</rule>ٌ", "en": "anyone", "tr": "aḥadun", "audio": "wbw/089_025_005.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "89:26", "juz": 30, "page": 594, "side_trans": "And none will bind [as severely] as His binding [of the evildoers].", "words": [{"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "And not", "tr": "walā", "audio": "wbw/089_026_001.mp3"}, {"type": "word", "ar": "يُوثِقُ", "tajweed": "يُوثِقُ", "en": "will bind", "tr": "yūthiqu", "audio": "wbw/089_026_002.mp3"}, {"type": "word", "ar": "وَثَاقَهُۥٓ", "tajweed": "وَثَاقَهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "(as) His binding", "tr": "wathāqahu", "audio": "wbw/089_026_003.mp3"}, {"type": "word", "ar": "أَحَدٌۭ", "tajweed": "أَحَ<rule class=qalaqah>د</rule>ٌ", "en": "anyone", "tr": "aḥadun", "audio": "wbw/089_026_004.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "89:27", "juz": 30, "page": 594, "side_trans": "[To the righteous it will be said], \"O reassured soul,", "words": [{"type": "word", "ar": "يَـٰٓأَيَّتُهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيَّتُهَا", "en": "O", "tr": "yāayyatuhā", "audio": "wbw/089_027_001.mp3"}, {"type": "word", "ar": "ٱلنَّفْسُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َفۡسُ", "en": "soul", "tr": "l-nafsu", "audio": "wbw/089_027_002.mp3"}, {"type": "word", "ar": "ٱلْمُطْمَئِنَّةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُ<rule class=qalaqah>طۡ</rule>مَئِ<rule class=ghunnah>نّ</rule>َةُ", "en": "who is satisfied", "tr": "l-muṭ'ma-inatu", "audio": "wbw/089_027_003.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "89:28", "juz": 30, "page": 594, "side_trans": "Return to your Lord, well-pleased and pleasing [to Him],", "words": [{"type": "word", "ar": "ٱرْجِعِىٓ", "tajweed": "ٱرۡجِع<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "Return", "tr": "ir'jiʿī", "audio": "wbw/089_028_001.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/089_028_002.mp3"}, {"type": "word", "ar": "رَبِّكِ", "tajweed": "رَبِّكِ", "en": "your Lord", "tr": "rabbiki", "audio": "wbw/089_028_003.mp3"}, {"type": "word", "ar": "رَاضِيَةًۭ", "tajweed": "رَاضِيَ<rule class=idgham_ghunnah>ةً</rule>", "en": "well pleased", "tr": "rāḍiyatan", "audio": "wbw/089_028_004.mp3"}, {"type": "word", "ar": "مَّرْضِيَّةًۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّرۡضِيَّةً", "en": "and pleasing", "tr": "marḍiyyatan", "audio": "wbw/089_028_005.mp3"}, {"type": "end", "num": "٢٨"}]}, {"id": 29, "key": "89:29", "juz": 30, "page": 594, "side_trans": "And enter among My [righteous] servants", "words": [{"type": "word", "ar": "فَٱدْخُلِى", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>دۡ</rule>خُلِى", "en": "So enter", "tr": "fa-ud'khulī", "audio": "wbw/089_029_001.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "among", "tr": "fī", "audio": "wbw/089_029_002.mp3"}, {"type": "word", "ar": "عِبَـٰدِى", "tajweed": "عِبَ<rule class=madda_normal>ـٰ</rule>دِى", "en": "My slaves", "tr": "ʿibādī", "audio": "wbw/089_029_003.mp3"}, {"type": "end", "num": "٢٩"}]}, {"id": 30, "key": "89:30", "juz": 30, "page": 594, "side_trans": "And enter My Paradise.\"", "words": [{"type": "word", "ar": "وَٱدْخُلِى", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>دۡ</rule>خُلِى", "en": "And enter", "tr": "wa-ud'khulī", "audio": "wbw/089_030_001.mp3"}, {"type": "word", "ar": "جَنَّتِى", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َتِى", "en": "My Paradise", "tr": "jannatī", "audio": "wbw/089_030_002.mp3"}, {"type": "end", "num": "٣٠"}]}]