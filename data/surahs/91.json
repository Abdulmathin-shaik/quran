[{"id": 1, "key": "91:1", "juz": 30, "page": 595, "side_trans": "By the sun and its brightness", "words": [{"type": "word", "ar": "وَٱلشَّمْسِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شَّمۡسِ", "en": "By the sun", "tr": "wal-shamsi", "audio": "wbw/091_001_001.mp3"}, {"type": "word", "ar": "وَضُحَىٰهَا", "tajweed": "وَضُحَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "and its brightness", "tr": "waḍuḥāhā", "audio": "wbw/091_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "91:2", "juz": 30, "page": 595, "side_trans": "And [by] the moon when it follows it", "words": [{"type": "word", "ar": "وَٱلْقَمَرِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡقَمَرِ", "en": "And the moon", "tr": "wal-qamari", "audio": "wbw/091_002_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/091_002_002.mp3"}, {"type": "word", "ar": "تَلَىٰهَا", "tajweed": "تَلَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "it follows it", "tr": "talāhā", "audio": "wbw/091_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "91:3", "juz": 30, "page": 595, "side_trans": "And [by] the day when it displays it", "words": [{"type": "word", "ar": "وَٱلنَّهَارِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َهَارِ", "en": "And the day", "tr": "wal-nahāri", "audio": "wbw/091_003_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/091_003_002.mp3"}, {"type": "word", "ar": "جَلَّىٰهَا", "tajweed": "جَلَّ<rule class=madda_normal>ـٰ</rule>هَا", "en": "it displays it", "tr": "jallāhā", "audio": "wbw/091_003_003.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "91:4", "juz": 30, "page": 595, "side_trans": "And [by] the night when it covers [i.e., conceals] it", "words": [{"type": "word", "ar": "وَٱلَّيْلِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّيۡلِ", "en": "And the night", "tr": "wa-al-layli", "audio": "wbw/091_004_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/091_004_002.mp3"}, {"type": "word", "ar": "يَغْشَىٰهَا", "tajweed": "يَغۡشَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "it covers it", "tr": "yaghshāhā", "audio": "wbw/091_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "91:5", "juz": 30, "page": 595, "side_trans": "And [by] the sky and He who constructed it", "words": [{"type": "word", "ar": "وَٱلسَّمَآءِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءِ", "en": "And the heaven", "tr": "wal-samāi", "audio": "wbw/091_005_001.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "and (He) Who", "tr": "wamā", "audio": "wbw/091_005_002.mp3"}, {"type": "word", "ar": "بَنَىٰهَا", "tajweed": "بَنَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "constructed it", "tr": "banāhā", "audio": "wbw/091_005_003.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "91:6", "juz": 30, "page": 595, "side_trans": "And [by] the earth and He who spread it", "words": [{"type": "word", "ar": "وَٱلْأَرْضِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "And the earth", "tr": "wal-arḍi", "audio": "wbw/091_006_001.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "and by (He) Who", "tr": "wamā", "audio": "wbw/091_006_002.mp3"}, {"type": "word", "ar": "طَحَىٰهَا", "tajweed": "طَحَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "spread it", "tr": "ṭaḥāhā", "audio": "wbw/091_006_003.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "91:7", "juz": 30, "page": 595, "side_trans": "And [by] the soul and He who proportioned it", "words": [{"type": "word", "ar": "وَنَفْسٍۢ", "tajweed": "وَنَفۡ<rule class=idgham_ghunnah>سٍ</rule>", "en": "And (the) soul", "tr": "wanafsin", "audio": "wbw/091_007_001.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َمَا", "en": "and (He) Who", "tr": "wamā", "audio": "wbw/091_007_002.mp3"}, {"type": "word", "ar": "سَوَّىٰهَا", "tajweed": "سَوَّ<rule class=madda_normal>ٮٰ</rule>هَا", "en": "proportioned it", "tr": "sawwāhā", "audio": "wbw/091_007_003.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "91:8", "juz": 30, "page": 595, "side_trans": "And inspired it [with discernment of] its wickedness and its righteousness,", "words": [{"type": "word", "ar": "فَأَلْهَمَهَا", "tajweed": "فَأَلۡهَمَهَا", "en": "And He inspired it", "tr": "fa-alhamahā", "audio": "wbw/091_008_001.mp3"}, {"type": "word", "ar": "فُجُورَهَا", "tajweed": "فُجُورَهَا", "en": "(to distinguish) its wickedness", "tr": "fujūrahā", "audio": "wbw/091_008_002.mp3"}, {"type": "word", "ar": "وَتَقْوَىٰهَا", "tajweed": "وَتَ<rule class=qalaqah>قۡ</rule>وَ<rule class=madda_normal>ٮٰ</rule>هَا", "en": "and its righteousness", "tr": "wataqwāhā", "audio": "wbw/091_008_003.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "91:9", "juz": 30, "page": 595, "side_trans": "He has succeeded who purifies it,", "words": [{"type": "word", "ar": "قَدْ", "tajweed": "قَ<rule class=qalaqah>دۡ</rule>", "en": "Indeed", "tr": "qad", "audio": "wbw/091_009_001.mp3"}, {"type": "word", "ar": "أَفْلَحَ", "tajweed": "أَفۡلَحَ", "en": "he succeeds", "tr": "aflaḥa", "audio": "wbw/091_009_002.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "مَ<rule class=ikhafa>ن</rule>", "en": "who", "tr": "man", "audio": "wbw/091_009_003.mp3"}, {"type": "word", "ar": "زَكَّىٰهَا", "tajweed": "<rule class=ikhafa>ز</rule>َكَّ<rule class=madda_normal>ـٰ</rule>هَا", "en": "purifies it", "tr": "zakkāhā", "audio": "wbw/091_009_004.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "91:10", "juz": 30, "page": 595, "side_trans": "And he has failed who instills it [with corruption].", "words": [{"type": "word", "ar": "وَقَدْ", "tajweed": "وَقَ<rule class=qalaqah>دۡ</rule>", "en": "And indeed", "tr": "waqad", "audio": "wbw/091_010_001.mp3"}, {"type": "word", "ar": "خَابَ", "tajweed": "خَابَ", "en": "he fails", "tr": "khāba", "audio": "wbw/091_010_002.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "مَ<rule class=ikhafa>ن</rule>", "en": "who", "tr": "man", "audio": "wbw/091_010_003.mp3"}, {"type": "word", "ar": "دَسَّىٰهَا", "tajweed": "<rule class=ikhafa>د</rule>َسَّ<rule class=madda_normal>ـٰ</rule>هَا", "en": "buries it", "tr": "dassāhā", "audio": "wbw/091_010_004.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "91:11", "juz": 30, "page": 595, "side_trans": "Thamūd denied [their prophet] by reason of their transgression,", "words": [{"type": "word", "ar": "كَذَّبَتْ", "tajweed": "كَذَّبَتۡ", "en": "Denied", "tr": "kadhabat", "audio": "wbw/091_011_001.mp3"}, {"type": "word", "ar": "ثَمُودُ", "tajweed": "ثَمُودُ", "en": "Thamud", "tr": "thamūdu", "audio": "wbw/091_011_002.mp3"}, {"type": "word", "ar": "بِطَغْوَىٰهَآ", "tajweed": "بِطَغۡوَ<rule class=madda_normal>ٮٰ</rule>هَآ", "en": "by their transgression", "tr": "biṭaghwāhā", "audio": "wbw/091_011_003.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "91:12", "juz": 30, "page": 595, "side_trans": "When the most wretched of them was sent forth.", "words": [{"type": "word", "ar": "إِذِ", "tajweed": "إِذِ", "en": "When", "tr": "idhi", "audio": "wbw/091_012_001.mp3"}, {"type": "word", "ar": "ٱنۢبَعَثَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=iqlab>نۢب</rule>َعَثَ", "en": "(was) sent forth", "tr": "inbaʿatha", "audio": "wbw/091_012_002.mp3"}, {"type": "word", "ar": "أَشْقَىٰهَا", "tajweed": "أَشۡقَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "(the) most wicked of them", "tr": "ashqāhā", "audio": "wbw/091_012_003.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "91:13", "juz": 30, "page": 595, "side_trans": "And the messenger of Allāh [i.e., Ṣāliḥ] said to them, \"[Do not harm] the she-camel of Allāh or [prevent her from] her drink.\"", "words": [{"type": "word", "ar": "فَقَالَ", "tajweed": "فَقَالَ", "en": "But said", "tr": "faqāla", "audio": "wbw/091_013_001.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "to them", "tr": "lahum", "audio": "wbw/091_013_002.mp3"}, {"type": "word", "ar": "رَسُولُ", "tajweed": "رَسُولُ", "en": "(the) Messenger", "tr": "rasūlu", "audio": "wbw/091_013_003.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/091_013_004.mp3"}, {"type": "word", "ar": "نَاقَةَ", "tajweed": "نَاقَةَ", "en": "(It is the) she-camel", "tr": "nāqata", "audio": "wbw/091_013_005.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/091_013_006.mp3"}, {"type": "word", "ar": "وَسُقْيَـٰهَا", "tajweed": "وَسُ<rule class=qalaqah>قۡ</rule>يَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "and her drink", "tr": "wasuq'yāhā", "audio": "wbw/091_013_007.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "91:14", "juz": 30, "page": 595, "side_trans": "But they denied him and hamstrung her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].", "words": [{"type": "word", "ar": "فَكَذَّبُوهُ", "tajweed": "فَكَذَّبُوهُ", "en": "But they denied him", "tr": "fakadhabūhu", "audio": "wbw/091_014_001.mp3"}, {"type": "word", "ar": "فَعَقَرُوهَا", "tajweed": "فَعَقَرُوهَا", "en": "and they hamstrung her", "tr": "faʿaqarūhā", "audio": "wbw/091_014_002.mp3"}, {"type": "word", "ar": "فَدَمْدَمَ", "tajweed": "فَدَمۡدَمَ", "en": "So destroyed", "tr": "fadamdama", "audio": "wbw/091_014_003.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ", "tajweed": "عَلَيۡهِمۡ", "en": "them", "tr": "ʿalayhim", "audio": "wbw/091_014_004.mp3"}, {"type": "word", "ar": "رَبُّهُم", "tajweed": "رَبُّه<rule class=ikhafa_shafawi>ُم</rule>", "en": "their Lord", "tr": "rabbuhum", "audio": "wbw/091_014_005.mp3"}, {"type": "word", "ar": "بِذَنۢبِهِمْ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِذَ<rule class=iqlab>نۢب</rule>ِهِمۡ", "en": "for their sin", "tr": "bidhanbihim", "audio": "wbw/091_014_006.mp3"}, {"type": "word", "ar": "فَسَوَّىٰهَا", "tajweed": "فَسَوَّ<rule class=madda_normal>ٮٰ</rule>هَا", "en": "and leveled them", "tr": "fasawwāhā", "audio": "wbw/091_014_007.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "91:15", "juz": 30, "page": 595, "side_trans": "And He does not fear the consequence thereof.", "words": [{"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "And not", "tr": "walā", "audio": "wbw/091_015_001.mp3"}, {"type": "word", "ar": "يَخَافُ", "tajweed": "يَخَافُ", "en": "He fears", "tr": "yakhāfu", "audio": "wbw/091_015_002.mp3"}, {"type": "word", "ar": "عُقْبَـٰهَا", "tajweed": "عُ<rule class=qalaqah>قۡ</rule>بَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "its consequences", "tr": "ʿuq'bāhā", "audio": "wbw/091_015_003.mp3"}, {"type": "end", "num": "١٥"}]}]