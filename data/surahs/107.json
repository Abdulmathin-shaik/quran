[{"id": 1, "key": "107:1", "juz": 30, "page": 602, "side_trans": "Have you seen the one who denies the Recompense?", "words": [{"type": "word", "ar": "أَرَءَيْتَ", "tajweed": "أَرَءَيۡتَ", "en": "Have you seen", "tr": "ara-ayta", "audio": "wbw/107_001_001.mp3"}, {"type": "word", "ar": "ٱلَّذِى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِى", "en": "the one who", "tr": "alladhī", "audio": "wbw/107_001_002.mp3"}, {"type": "word", "ar": "يُكَذِّبُ", "tajweed": "يُكَذِّبُ", "en": "denies", "tr": "yukadhibu", "audio": "wbw/107_001_003.mp3"}, {"type": "word", "ar": "بِٱلدِّينِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دّ<rule class=madda_permissible>ِي</rule>نِ", "en": "the Judgment", "tr": "bil-dīni", "audio": "wbw/107_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "107:2", "juz": 30, "page": 602, "side_trans": "For that is the one who drives away the orphan", "words": [{"type": "word", "ar": "فَذَٰلِكَ", "tajweed": "فَذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "Then that", "tr": "fadhālika", "audio": "wbw/107_002_001.mp3"}, {"type": "word", "ar": "ٱلَّذِى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِى", "en": "(is) the one who", "tr": "alladhī", "audio": "wbw/107_002_002.mp3"}, {"type": "word", "ar": "يَدُعُّ", "tajweed": "يَدُعُّ", "en": "repulses", "tr": "yaduʿʿu", "audio": "wbw/107_002_003.mp3"}, {"type": "word", "ar": "ٱلْيَتِيمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَت<rule class=madda_permissible>ِي</rule>مَ", "en": "the orphan", "tr": "l-yatīma", "audio": "wbw/107_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "107:3", "juz": 30, "page": 602, "side_trans": "And does not encourage the feeding of the poor.", "words": [{"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "And (does) not", "tr": "walā", "audio": "wbw/107_003_001.mp3"}, {"type": "word", "ar": "يَحُضُّ", "tajweed": "يَحُضُّ", "en": "feel the urge", "tr": "yaḥuḍḍu", "audio": "wbw/107_003_002.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "to", "tr": "ʿalā", "audio": "wbw/107_003_003.mp3"}, {"type": "word", "ar": "طَعَامِ", "tajweed": "طَعَامِ", "en": "feed", "tr": "ṭaʿāmi", "audio": "wbw/107_003_004.mp3"}, {"type": "word", "ar": "ٱلْمِسْكِينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمِسۡك<rule class=madda_permissible>ِي</rule>نِ", "en": "the poor", "tr": "l-mis'kīni", "audio": "wbw/107_003_005.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "107:4", "juz": 30, "page": 602, "side_trans": "So woe to those who pray", "words": [{"type": "word", "ar": "فَوَيْلٌۭ", "tajweed": "فَوَيۡ<rule class=idgham_wo_ghunnah>لٌ</rule>", "en": "So woe", "tr": "fawaylun", "audio": "wbw/107_004_001.mp3"}, {"type": "word", "ar": "لِّلْمُصَلِّينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُصَلّ<rule class=madda_permissible>ِي</rule>نَ", "en": "to those who pray", "tr": "lil'muṣallīna", "audio": "wbw/107_004_002.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "107:5", "juz": 30, "page": 602, "side_trans": "[But] who are heedless of their prayer -", "words": [{"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "ٱلَّذِينَ", "en": "Those who", "tr": "alladhīna", "audio": "wbw/107_005_001.mp3"}, {"type": "word", "ar": "هُمْ", "tajweed": "هُمۡ", "en": "[they]", "tr": "hum", "audio": "wbw/107_005_002.mp3"}, {"type": "word", "ar": "عَن", "tajweed": "عَ<rule class=ikhafa>ن</rule>", "en": "about", "tr": "ʿan", "audio": "wbw/107_005_003.mp3"}, {"type": "word", "ar": "صَلَاتِهِمْ", "tajweed": "<rule class=ikhafa>ص</rule>َلَاتِهِمۡ", "en": "their prayers", "tr": "ṣalātihim", "audio": "wbw/107_005_004.mp3"}, {"type": "word", "ar": "سَاهُونَ", "tajweed": "سَاه<rule class=madda_permissible>ُو</rule>نَ", "en": "(are) neglectful", "tr": "sāhūna", "audio": "wbw/107_005_005.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "107:6", "juz": 30, "page": 602, "side_trans": "Those who make show [of their deeds]", "words": [{"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "ٱلَّذِينَ", "en": "Those who", "tr": "alladhīna", "audio": "wbw/107_006_001.mp3"}, {"type": "word", "ar": "هُمْ", "tajweed": "هُمۡ", "en": "[they]", "tr": "hum", "audio": "wbw/107_006_002.mp3"}, {"type": "word", "ar": "يُرَآءُونَ", "tajweed": "يُر<rule class=madda_obligatory_mottasel>َا</rule>ٓء<rule class=madda_permissible>ُو</rule>نَ", "en": "make show", "tr": "yurāūna", "audio": "wbw/107_006_003.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "107:7", "juz": 30, "page": 602, "side_trans": "And withhold [simple] assistance.", "words": [{"type": "word", "ar": "وَيَمْنَعُونَ", "tajweed": "وَيَمۡنَعُونَ", "en": "And they deny", "tr": "wayamnaʿūna", "audio": "wbw/107_007_001.mp3"}, {"type": "word", "ar": "ٱلْمَاعُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَاع<rule class=madda_permissible>ُو</rule>نَ", "en": "[the] small kindnesses", "tr": "l-māʿūna", "audio": "wbw/107_007_002.mp3"}, {"type": "end", "num": "٧"}]}]