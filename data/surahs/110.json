[{"id": 1, "key": "110:1", "juz": 30, "page": 603, "side_trans": "When the victory of Allāh has come and the conquest,", "words": [{"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/110_001_001.mp3"}, {"type": "word", "ar": "جَآءَ", "tajweed": "ج<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "comes", "tr": "jāa", "audio": "wbw/110_001_002.mp3"}, {"type": "word", "ar": "نَصْرُ", "tajweed": "نَصۡرُ", "en": "(the) Help", "tr": "naṣru", "audio": "wbw/110_001_003.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/110_001_004.mp3"}, {"type": "word", "ar": "وَٱلْفَتْحُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡفَتۡحُ", "en": "and the Victory", "tr": "wal-fatḥu", "audio": "wbw/110_001_005.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "110:2", "juz": 30, "page": 603, "side_trans": "And you see the people entering into the religion of Allāh in multitudes,", "words": [{"type": "word", "ar": "وَرَأَيْتَ", "tajweed": "وَرَأَيۡتَ", "en": "And you see", "tr": "wara-ayta", "audio": "wbw/110_002_001.mp3"}, {"type": "word", "ar": "ٱلنَّاسَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َاسَ", "en": "the people", "tr": "l-nāsa", "audio": "wbw/110_002_002.mp3"}, {"type": "word", "ar": "يَدْخُلُونَ", "tajweed": "يَ<rule class=qalaqah>دۡ</rule>خُلُونَ", "en": "entering", "tr": "yadkhulūna", "audio": "wbw/110_002_003.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "into", "tr": "fī", "audio": "wbw/110_002_004.mp3"}, {"type": "word", "ar": "دِينِ", "tajweed": "دِينِ", "en": "(the) religion", "tr": "dīni", "audio": "wbw/110_002_005.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/110_002_006.mp3"}, {"type": "word", "ar": "أَفْوَاجًۭا", "tajweed": "أَفۡوَاجًا", "en": "(in) multitudes", "tr": "afwājan", "audio": "wbw/110_002_007.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "110:3", "juz": 30, "page": 603, "side_trans": "Then exalt [Him] with praise of your Lord and ask forgiveness of Him. Indeed, He is ever Accepting of Repentance.", "words": [{"type": "word", "ar": "فَسَبِّحْ", "tajweed": "فَسَبِّحۡ", "en": "Then glorify", "tr": "fasabbiḥ", "audio": "wbw/110_003_001.mp3"}, {"type": "word", "ar": "بِحَمْدِ", "tajweed": "بِحَمۡدِ", "en": "with (the) praises", "tr": "biḥamdi", "audio": "wbw/110_003_002.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "(of) your Lord", "tr": "rabbika", "audio": "wbw/110_003_003.mp3"}, {"type": "word", "ar": "وَٱسْتَغْفِرْهُ ۚ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>سۡتَغۡفِرۡهُ‌ۚ", "en": "and ask His forgiveness", "tr": "wa-is'taghfir'hu", "audio": "wbw/110_003_004.mp3"}, {"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, He", "tr": "innahu", "audio": "wbw/110_003_006.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "is", "tr": "kāna", "audio": "wbw/110_003_007.mp3"}, {"type": "word", "ar": "تَوَّابًۢا", "tajweed": "تَوَّابَۢا", "en": "Oft-Returning", "tr": "tawwāban", "audio": "wbw/110_003_008.mp3"}, {"type": "end", "num": "٣"}]}]