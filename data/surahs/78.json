[{"id": 1, "key": "78:1", "juz": 30, "page": 582, "side_trans": "About what are they asking one another?", "words": [{"type": "word", "ar": "عَمَّ", "tajweed": "عَ<rule class=ghunnah>مّ</rule>َ", "en": "About what", "tr": "ʿamma", "audio": "wbw/078_001_001.mp3"}, {"type": "word", "ar": "يَتَسَآءَلُونَ", "tajweed": "يَتَس<rule class=madda_obligatory_mottasel>َا</rule>ٓءَل<rule class=madda_permissible>ُو</rule>نَ", "en": "are they asking one another", "tr": "yatasāalūna", "audio": "wbw/078_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "78:2", "juz": 30, "page": 582, "side_trans": "About the great news -", "words": [{"type": "word", "ar": "عَنِ", "tajweed": "عَنِ", "en": "About", "tr": "ʿani", "audio": "wbw/078_002_001.mp3"}, {"type": "word", "ar": "ٱلنَّبَإِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َبَإِ", "en": "the News", "tr": "l-naba-i", "audio": "wbw/078_002_002.mp3"}, {"type": "word", "ar": "ٱلْعَظِيمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَظ<rule class=madda_permissible>ِي</rule>مِ", "en": "the Great", "tr": "l-ʿaẓīmi", "audio": "wbw/078_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "78:3", "juz": 30, "page": 582, "side_trans": "That over which they are in disagreement.", "words": [{"type": "word", "ar": "ٱلَّذِى", "tajweed": "ٱلَّذِى", "en": "(About) which", "tr": "alladhī", "audio": "wbw/078_003_001.mp3"}, {"type": "word", "ar": "هُمْ", "tajweed": "هُمۡ", "en": "they", "tr": "hum", "audio": "wbw/078_003_002.mp3"}, {"type": "word", "ar": "فِيهِ", "tajweed": "فِيهِ", "en": "(are) concerning it", "tr": "fīhi", "audio": "wbw/078_003_003.mp3"}, {"type": "word", "ar": "مُخْتَلِفُونَ", "tajweed": "مُخۡتَلِف<rule class=madda_permissible>ُو</rule>نَ", "en": "(in) disagreement", "tr": "mukh'talifūna", "audio": "wbw/078_003_004.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "78:4", "juz": 30, "page": 582, "side_trans": "No! They are going to know.", "words": [{"type": "word", "ar": "كَلَّا", "tajweed": "كَلَّا", "en": "Nay", "tr": "kallā", "audio": "wbw/078_004_001.mp3"}, {"type": "word", "ar": "سَيَعْلَمُونَ", "tajweed": "سَيَعۡلَم<rule class=madda_permissible>ُو</rule>نَ", "en": "(soon) they will know", "tr": "sayaʿlamūna", "audio": "wbw/078_004_002.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "78:5", "juz": 30, "page": 582, "side_trans": "Then, no! They are going to know.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/078_005_001.mp3"}, {"type": "word", "ar": "كَلَّا", "tajweed": "كَلَّا", "en": "Nay", "tr": "kallā", "audio": "wbw/078_005_002.mp3"}, {"type": "word", "ar": "سَيَعْلَمُونَ", "tajweed": "سَيَعۡلَم<rule class=madda_permissible>ُو</rule>نَ", "en": "(soon) they will know", "tr": "sayaʿlamūna", "audio": "wbw/078_005_003.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "78:6", "juz": 30, "page": 582, "side_trans": "Have We not made the earth a resting place?", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Have not", "tr": "alam", "audio": "wbw/078_006_001.mp3"}, {"type": "word", "ar": "نَجْعَلِ", "tajweed": "نَ<rule class=qalaqah>جۡ</rule>عَلِ", "en": "We made", "tr": "najʿali", "audio": "wbw/078_006_002.mp3"}, {"type": "word", "ar": "ٱلْأَرْضَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضَ", "en": "the earth", "tr": "l-arḍa", "audio": "wbw/078_006_003.mp3"}, {"type": "word", "ar": "مِهَـٰدًۭا", "tajweed": "مِهَ<rule class=madda_normal>ـٰ</rule>دًا", "en": "a resting place", "tr": "mihādan", "audio": "wbw/078_006_004.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "78:7", "juz": 30, "page": 582, "side_trans": "And the mountains as stakes?", "words": [{"type": "word", "ar": "وَٱلْجِبَالَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡجِبَالَ", "en": "And the mountains", "tr": "wal-jibāla", "audio": "wbw/078_007_001.mp3"}, {"type": "word", "ar": "أَوْتَادًۭا", "tajweed": "أَوۡتَادًا", "en": "(as) pegs", "tr": "awtādan", "audio": "wbw/078_007_002.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "78:8", "juz": 30, "page": 582, "side_trans": "And We created you in pairs.", "words": [{"type": "word", "ar": "وَخَلَقْنَـٰكُمْ", "tajweed": "وَخَلَ<rule class=qalaqah>قۡ</rule>نَ<rule class=madda_normal>ـٰ</rule>كُمۡ", "en": "And We created you", "tr": "wakhalaqnākum", "audio": "wbw/078_008_001.mp3"}, {"type": "word", "ar": "أَزْوَٰجًۭا", "tajweed": "أَزۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>جًا", "en": "(in) pairs", "tr": "azwājan", "audio": "wbw/078_008_002.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "78:9", "juz": 30, "page": 582, "side_trans": "And made your sleep [a means for] rest", "words": [{"type": "word", "ar": "وَجَعَلْنَا", "tajweed": "وَجَعَلۡنَا", "en": "And We made", "tr": "wajaʿalnā", "audio": "wbw/078_009_001.mp3"}, {"type": "word", "ar": "نَوْمَكُمْ", "tajweed": "نَوۡمَكُمۡ", "en": "your sleep", "tr": "nawmakum", "audio": "wbw/078_009_002.mp3"}, {"type": "word", "ar": "سُبَاتًۭا", "tajweed": "سُبَاتًا", "en": "(for) rest", "tr": "subātan", "audio": "wbw/078_009_003.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "78:10", "juz": 30, "page": 582, "side_trans": "And made the night as clothing.", "words": [{"type": "word", "ar": "وَجَعَلْنَا", "tajweed": "وَجَعَلۡنَا", "en": "And We made", "tr": "wajaʿalnā", "audio": "wbw/078_010_001.mp3"}, {"type": "word", "ar": "ٱلَّيْلَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّيۡلَ", "en": "the night", "tr": "al-layla", "audio": "wbw/078_010_002.mp3"}, {"type": "word", "ar": "لِبَاسًۭا", "tajweed": "لِبَاسًا", "en": "(as) covering", "tr": "libāsan", "audio": "wbw/078_010_003.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "78:11", "juz": 30, "page": 582, "side_trans": "And made the day for livelihood.", "words": [{"type": "word", "ar": "وَجَعَلْنَا", "tajweed": "وَجَعَلۡنَا", "en": "And We made", "tr": "wajaʿalnā", "audio": "wbw/078_011_001.mp3"}, {"type": "word", "ar": "ٱلنَّهَارَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َهَارَ", "en": "the day", "tr": "l-nahāra", "audio": "wbw/078_011_002.mp3"}, {"type": "word", "ar": "مَعَاشًۭا", "tajweed": "مَعَاشًا", "en": "(for) livelihood", "tr": "maʿāshan", "audio": "wbw/078_011_003.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "78:12", "juz": 30, "page": 582, "side_trans": "And constructed above you seven strong [heavens].", "words": [{"type": "word", "ar": "وَبَنَيْنَا", "tajweed": "وَبَنَيۡنَا", "en": "And We constructed", "tr": "wabanaynā", "audio": "wbw/078_012_001.mp3"}, {"type": "word", "ar": "فَوْقَكُمْ", "tajweed": "فَوۡقَكُمۡ", "en": "over you", "tr": "fawqakum", "audio": "wbw/078_012_002.mp3"}, {"type": "word", "ar": "سَبْعًۭا", "tajweed": "سَ<rule class=qalaqah>بۡ</rule><rule class=ikhafa>عًا</rule>", "en": "seven", "tr": "sabʿan", "audio": "wbw/078_012_003.mp3"}, {"type": "word", "ar": "شِدَادًۭا", "tajweed": "<rule class=ikhafa>ش</rule>ِدَادًا", "en": "strong", "tr": "shidādan", "audio": "wbw/078_012_004.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "78:13", "juz": 30, "page": 582, "side_trans": "And made [therein] a burning lamp", "words": [{"type": "word", "ar": "وَجَعَلْنَا", "tajweed": "وَجَعَلۡنَا", "en": "And We placed", "tr": "wajaʿalnā", "audio": "wbw/078_013_001.mp3"}, {"type": "word", "ar": "سِرَاجًۭا", "tajweed": "سِرَا<rule class=idgham_ghunnah>جًا</rule>", "en": "a lamp", "tr": "sirājan", "audio": "wbw/078_013_002.mp3"}, {"type": "word", "ar": "وَهَّاجًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َهَّاجًا", "en": "burning", "tr": "wahhājan", "audio": "wbw/078_013_003.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "78:14", "juz": 30, "page": 582, "side_trans": "And sent down, from the rain clouds, pouring water.", "words": [{"type": "word", "ar": "وَأَنزَلْنَا", "tajweed": "وَأَ<rule class=ikhafa>نز</rule>َلۡنَا", "en": "And We sent down", "tr": "wa-anzalnā", "audio": "wbw/078_014_001.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "from", "tr": "mina", "audio": "wbw/078_014_002.mp3"}, {"type": "word", "ar": "ٱلْمُعْصِرَٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُعۡصِر<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِ", "en": "the rain clouds", "tr": "l-muʿ'ṣirāti", "audio": "wbw/078_014_003.mp3"}, {"type": "word", "ar": "مَآءًۭ", "tajweed": "م<rule class=madda_obligatory_mottasel>َا</rule>ٓ<rule class=ikhafa>ءً</rule>", "en": "water", "tr": "māan", "audio": "wbw/078_014_004.mp3"}, {"type": "word", "ar": "ثَجَّاجًۭا", "tajweed": "<rule class=ikhafa>ث</rule>َجَّاجًا", "en": "pouring abundantly", "tr": "thajjājan", "audio": "wbw/078_014_005.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "78:15", "juz": 30, "page": 582, "side_trans": "That We may bring forth thereby grain and vegetation.", "words": [{"type": "word", "ar": "لِّنُخْرِجَ", "tajweed": "لِّنُخۡرِجَ", "en": "That We may bring forth", "tr": "linukh'rija", "audio": "wbw/078_015_001.mp3"}, {"type": "word", "ar": "بِهِۦ", "tajweed": "بِه<rule class=madda_normal>ِۦ</rule>", "en": "thereby", "tr": "bihi", "audio": "wbw/078_015_002.mp3"}, {"type": "word", "ar": "حَبًّۭا", "tajweed": "حَب<rule class=idgham_ghunnah>ًّا</rule>", "en": "grain", "tr": "ḥabban", "audio": "wbw/078_015_003.mp3"}, {"type": "word", "ar": "وَنَبَاتًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َنَبَاتًا", "en": "and vegetation", "tr": "wanabātan", "audio": "wbw/078_015_004.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "78:16", "juz": 30, "page": 582, "side_trans": "And gardens of entwined growth.", "words": [{"type": "word", "ar": "وَجَنَّـٰتٍ", "tajweed": "وَجَ<rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule>تٍ", "en": "And gardens", "tr": "wajannātin", "audio": "wbw/078_016_001.mp3"}, {"type": "word", "ar": "أَلْفَافًا", "tajweed": "أَلۡفَافًا", "en": "(of) thick foliage", "tr": "alfāfan", "audio": "wbw/078_016_002.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "78:17", "juz": 30, "page": 582, "side_trans": "Indeed, the Day of Judgement is an appointed time -", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/078_017_001.mp3"}, {"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(the) Day", "tr": "yawma", "audio": "wbw/078_017_002.mp3"}, {"type": "word", "ar": "ٱلْفَصْلِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَصۡلِ", "en": "(of) the Judgment", "tr": "l-faṣli", "audio": "wbw/078_017_003.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "is", "tr": "kāna", "audio": "wbw/078_017_004.mp3"}, {"type": "word", "ar": "مِيقَـٰتًۭا", "tajweed": "مِيقَ<rule class=madda_normal>ـٰ</rule>تًا", "en": "an appointed time", "tr": "mīqātan", "audio": "wbw/078_017_005.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "78:18", "juz": 30, "page": 582, "side_trans": "The Day the Horn is blown and you will come forth in multitudes", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(The) Day", "tr": "yawma", "audio": "wbw/078_018_001.mp3"}, {"type": "word", "ar": "يُنفَخُ", "tajweed": "يُ<rule class=ikhafa>نف</rule>َخُ", "en": "(in which) shall be blown", "tr": "yunfakhu", "audio": "wbw/078_018_002.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/078_018_003.mp3"}, {"type": "word", "ar": "ٱلصُّورِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صُّورِ", "en": "the trumpet", "tr": "l-ṣūri", "audio": "wbw/078_018_004.mp3"}, {"type": "word", "ar": "فَتَأْتُونَ", "tajweed": "فَتَأۡتُونَ", "en": "and you will come forth", "tr": "fatatūna", "audio": "wbw/078_018_005.mp3"}, {"type": "word", "ar": "أَفْوَاجًۭا", "tajweed": "أَفۡوَاجًا", "en": "(in) crowds", "tr": "afwājan", "audio": "wbw/078_018_006.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "78:19", "juz": 30, "page": 582, "side_trans": "And the heaven is opened and will become gateways.", "words": [{"type": "word", "ar": "وَفُتِحَتِ", "tajweed": "وَفُتِحَتِ", "en": "And is opened", "tr": "wafutiḥati", "audio": "wbw/078_019_001.mp3"}, {"type": "word", "ar": "ٱلسَّمَآءُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ", "en": "the heaven", "tr": "l-samāu", "audio": "wbw/078_019_002.mp3"}, {"type": "word", "ar": "فَكَانَتْ", "tajweed": "فَكَانَتۡ", "en": "and becomes", "tr": "fakānat", "audio": "wbw/078_019_003.mp3"}, {"type": "word", "ar": "أَبْوَٰبًۭا", "tajweed": "أَ<rule class=qalaqah>بۡ</rule>و<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>بًا", "en": "gateways", "tr": "abwāban", "audio": "wbw/078_019_004.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "78:20", "juz": 30, "page": 582, "side_trans": "And the mountains are removed and will be [but] a mirage.", "words": [{"type": "word", "ar": "وَسُيِّرَتِ", "tajweed": "وَسُيِّرَتِ", "en": "And are moved", "tr": "wasuyyirati", "audio": "wbw/078_020_001.mp3"}, {"type": "word", "ar": "ٱلْجِبَالُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجِبَالُ", "en": "the mountains", "tr": "l-jibālu", "audio": "wbw/078_020_002.mp3"}, {"type": "word", "ar": "فَكَانَتْ", "tajweed": "فَكَانَتۡ", "en": "and become", "tr": "fakānat", "audio": "wbw/078_020_003.mp3"}, {"type": "word", "ar": "سَرَابًا", "tajweed": "سَرَابًا", "en": "a mirage", "tr": "sarāban", "audio": "wbw/078_020_004.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "78:21", "juz": 30, "page": 582, "side_trans": "Indeed, Hell has been lying in wait", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/078_021_001.mp3"}, {"type": "word", "ar": "جَهَنَّمَ", "tajweed": "جَهَ<rule class=ghunnah>نّ</rule>َمَ", "en": "Hell", "tr": "jahannama", "audio": "wbw/078_021_002.mp3"}, {"type": "word", "ar": "كَانَتْ", "tajweed": "كَانَتۡ", "en": "is", "tr": "kānat", "audio": "wbw/078_021_003.mp3"}, {"type": "word", "ar": "مِرْصَادًۭا", "tajweed": "مِرۡصَادًا", "en": "lying in wait", "tr": "mir'ṣādan", "audio": "wbw/078_021_004.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "78:22", "juz": 30, "page": 582, "side_trans": "For the transgressors, a place of return,", "words": [{"type": "word", "ar": "لِّلطَّـٰغِينَ", "tajweed": "لِّلطَّ<rule class=madda_normal>ـٰ</rule>غِينَ", "en": "For the transgressors", "tr": "lilṭṭāghīna", "audio": "wbw/078_022_001.mp3"}, {"type": "word", "ar": "مَـَٔابًۭا", "tajweed": "مَـَٔـابًا", "en": "a place of return", "tr": "maāban", "audio": "wbw/078_022_002.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "78:23", "juz": 30, "page": 582, "side_trans": "In which they will remain for ages [unending].", "words": [{"type": "word", "ar": "لَّـٰبِثِينَ", "tajweed": "لَّ<rule class=madda_normal>ـٰ</rule>بِثِينَ", "en": "(They will) be remaining", "tr": "lābithīna", "audio": "wbw/078_023_001.mp3"}, {"type": "word", "ar": "فِيهَآ", "tajweed": "فِيه<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "therein", "tr": "fīhā", "audio": "wbw/078_023_002.mp3"}, {"type": "word", "ar": "أَحْقَابًۭا", "tajweed": "أَحۡقَابًا", "en": "(for) ages", "tr": "aḥqāban", "audio": "wbw/078_023_003.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "78:24", "juz": 30, "page": 582, "side_trans": "They will not taste therein [any] coolness or drink.", "words": [{"type": "word", "ar": "لَّا", "tajweed": "لَّا", "en": "Not", "tr": "lā", "audio": "wbw/078_024_001.mp3"}, {"type": "word", "ar": "يَذُوقُونَ", "tajweed": "يَذُوقُونَ", "en": "they will taste", "tr": "yadhūqūna", "audio": "wbw/078_024_002.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/078_024_003.mp3"}, {"type": "word", "ar": "بَرْدًۭا", "tajweed": "بَرۡ<rule class=idgham_ghunnah>دًا</rule>", "en": "coolness", "tr": "bardan", "audio": "wbw/078_024_004.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "and not", "tr": "walā", "audio": "wbw/078_024_005.mp3"}, {"type": "word", "ar": "شَرَابًا", "tajweed": "شَرَابًا", "en": "any drink", "tr": "sharāban", "audio": "wbw/078_024_006.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "78:25", "juz": 30, "page": 582, "side_trans": "Except scalding water and [foul] purulence -", "words": [{"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "Except", "tr": "illā", "audio": "wbw/078_025_001.mp3"}, {"type": "word", "ar": "حَمِيمًۭا", "tajweed": "حَمِي<rule class=idgham_ghunnah>مًا</rule>", "en": "scalding water", "tr": "ḥamīman", "audio": "wbw/078_025_002.mp3"}, {"type": "word", "ar": "وَغَسَّاقًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َغَسَّاقًا", "en": "and purulence", "tr": "waghassāqan", "audio": "wbw/078_025_003.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "78:26", "juz": 30, "page": 582, "side_trans": "An appropriate recompense.", "words": [{"type": "word", "ar": "جَزَآءًۭ", "tajweed": "جَز<rule class=madda_obligatory_mottasel>َا</rule>ٓ<rule class=idgham_ghunnah>ءً</rule>", "en": "A recompense", "tr": "jazāan", "audio": "wbw/078_026_001.mp3"}, {"type": "word", "ar": "وِفَاقًا", "tajweed": "<rule class=idgham_ghunnah>و</rule>ِفَاقًا", "en": "appropriate", "tr": "wifāqan", "audio": "wbw/078_026_002.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "78:27", "juz": 30, "page": 582, "side_trans": "Indeed, they were not expecting an account", "words": [{"type": "word", "ar": "إِنَّهُمْ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "Indeed, they", "tr": "innahum", "audio": "wbw/078_027_001.mp3"}, {"type": "word", "ar": "كَانُوا۟", "tajweed": "كَانُو<rule class=slnt>اۡ</rule>", "en": "were", "tr": "kānū", "audio": "wbw/078_027_002.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/078_027_003.mp3"}, {"type": "word", "ar": "يَرْجُونَ", "tajweed": "يَرۡجُونَ", "en": "expecting", "tr": "yarjūna", "audio": "wbw/078_027_004.mp3"}, {"type": "word", "ar": "حِسَابًۭا", "tajweed": "حِسَابًا", "en": "an account", "tr": "ḥisāban", "audio": "wbw/078_027_005.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "78:28", "juz": 30, "page": 582, "side_trans": "And denied Our verses with [emphatic] denial.", "words": [{"type": "word", "ar": "وَكَذَّبُوا۟", "tajweed": "وَكَذَّبُو<rule class=slnt>اۡ</rule>", "en": "And they denied", "tr": "wakadhabū", "audio": "wbw/078_028_001.mp3"}, {"type": "word", "ar": "بِـَٔايَـٰتِنَا", "tajweed": "بِـَٔـايَ<rule class=madda_normal>ـٰ</rule>تِنَا", "en": "Our Signs", "tr": "biāyātinā", "audio": "wbw/078_028_002.mp3"}, {"type": "word", "ar": "كِذَّابًۭا", "tajweed": "كِذَّابًا", "en": "(with) denial", "tr": "kidhāban", "audio": "wbw/078_028_003.mp3"}, {"type": "end", "num": "٢٨"}]}, {"id": 29, "key": "78:29", "juz": 30, "page": 582, "side_trans": "But all things We have enumerated in writing.", "words": [{"type": "word", "ar": "وَكُلَّ", "tajweed": "وَكُلَّ", "en": "And every", "tr": "wakulla", "audio": "wbw/078_029_001.mp3"}, {"type": "word", "ar": "شَىْءٍ", "tajweed": "شَىۡءٍ", "en": "thing", "tr": "shayin", "audio": "wbw/078_029_002.mp3"}, {"type": "word", "ar": "أَحْصَيْنَـٰهُ", "tajweed": "أَحۡصَيۡنَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "We have enumerated it", "tr": "aḥṣaynāhu", "audio": "wbw/078_029_003.mp3"}, {"type": "word", "ar": "كِتَـٰبًۭا", "tajweed": "كِتَ<rule class=madda_normal>ـٰ</rule>بًا", "en": "(in) a Book", "tr": "kitāban", "audio": "wbw/078_029_004.mp3"}, {"type": "end", "num": "٢٩"}]}, {"id": 30, "key": "78:30", "juz": 30, "page": 582, "side_trans": "\"So taste [the penalty], and never will We increase you except in torment.\"", "words": [{"type": "word", "ar": "فَذُوقُوا۟", "tajweed": "فَذُوقُو<rule class=slnt>اۡ</rule>", "en": "So taste", "tr": "fadhūqū", "audio": "wbw/078_030_001.mp3"}, {"type": "word", "ar": "فَلَن", "tajweed": "فَل<rule class=idgham_ghunnah>َن</rule>", "en": "and never", "tr": "falan", "audio": "wbw/078_030_002.mp3"}, {"type": "word", "ar": "نَّزِيدَكُمْ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>َّزِيدَكُمۡ", "en": "We will increase you", "tr": "nazīdakum", "audio": "wbw/078_030_003.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/078_030_004.mp3"}, {"type": "word", "ar": "عَذَابًا", "tajweed": "عَذَابًا", "en": "(in) punishment", "tr": "ʿadhāban", "audio": "wbw/078_030_005.mp3"}, {"type": "end", "num": "٣٠"}]}, {"id": 31, "key": "78:31", "juz": 30, "page": 583, "side_trans": "Indeed, for the righteous is attainment -", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/078_031_001.mp3"}, {"type": "word", "ar": "لِلْمُتَّقِينَ", "tajweed": "لِلۡمُتَّقِينَ", "en": "for the righteous", "tr": "lil'muttaqīna", "audio": "wbw/078_031_002.mp3"}, {"type": "word", "ar": "مَفَازًا", "tajweed": "مَفَازًا", "en": "(is) success", "tr": "mafāzan", "audio": "wbw/078_031_003.mp3"}, {"type": "end", "num": "٣١"}]}, {"id": 32, "key": "78:32", "juz": 30, "page": 583, "side_trans": "Gardens and grapevines.", "words": [{"type": "word", "ar": "حَدَآئِقَ", "tajweed": "حَد<rule class=madda_obligatory_mottasel>َا</rule>ٓئِقَ", "en": "Gardens", "tr": "ḥadāiqa", "audio": "wbw/078_032_001.mp3"}, {"type": "word", "ar": "وَأَعْنَـٰبًۭا", "tajweed": "وَأَعۡنَ<rule class=madda_normal>ـٰ</rule>بًا", "en": "and grapevines", "tr": "wa-aʿnāban", "audio": "wbw/078_032_002.mp3"}, {"type": "end", "num": "٣٢"}]}, {"id": 33, "key": "78:33", "juz": 30, "page": 583, "side_trans": "And full-breasted [companions] of equal age.", "words": [{"type": "word", "ar": "وَكَوَاعِبَ", "tajweed": "وَكَوَاعِبَ", "en": "And splendid companions", "tr": "wakawāʿiba", "audio": "wbw/078_033_001.mp3"}, {"type": "word", "ar": "أَتْرَابًۭا", "tajweed": "أَتۡرَابًا", "en": "well-matched", "tr": "atrāban", "audio": "wbw/078_033_002.mp3"}, {"type": "end", "num": "٣٣"}]}, {"id": 34, "key": "78:34", "juz": 30, "page": 583, "side_trans": "And a full cup.", "words": [{"type": "word", "ar": "وَكَأْسًۭا", "tajweed": "وَكَأۡ<rule class=ikhafa>سًا</rule>", "en": "And a cup", "tr": "wakasan", "audio": "wbw/078_034_001.mp3"}, {"type": "word", "ar": "دِهَاقًۭا", "tajweed": "<rule class=ikhafa>د</rule>ِهَاقًا", "en": "full", "tr": "dihāqan", "audio": "wbw/078_034_002.mp3"}, {"type": "end", "num": "٣٤"}]}, {"id": 35, "key": "78:35", "juz": 30, "page": 583, "side_trans": "No ill speech will they hear therein or any falsehood -", "words": [{"type": "word", "ar": "لَّا", "tajweed": "لَّا", "en": "Not", "tr": "lā", "audio": "wbw/078_035_001.mp3"}, {"type": "word", "ar": "يَسْمَعُونَ", "tajweed": "يَسۡمَعُونَ", "en": "they will hear", "tr": "yasmaʿūna", "audio": "wbw/078_035_002.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/078_035_003.mp3"}, {"type": "word", "ar": "لَغْوًۭا", "tajweed": "لَغۡ<rule class=idgham_ghunnah>وًا</rule>", "en": "any vain talk", "tr": "laghwan", "audio": "wbw/078_035_004.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "and not", "tr": "walā", "audio": "wbw/078_035_005.mp3"}, {"type": "word", "ar": "كِذَّٰبًۭا", "tajweed": "كِذّ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>بًا", "en": "any falsehood", "tr": "kidhāban", "audio": "wbw/078_035_006.mp3"}, {"type": "end", "num": "٣٥"}]}, {"id": 36, "key": "78:36", "juz": 30, "page": 583, "side_trans": "[As] reward from your Lord, [a generous] gift [made due by] account,", "words": [{"type": "word", "ar": "جَزَآءًۭ", "tajweed": "جَز<rule class=madda_obligatory_mottasel>َا</rule>ٓ<rule class=idgham_ghunnah>ءً</rule>", "en": "(As) a reward", "tr": "jazāan", "audio": "wbw/078_036_001.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_ghunnah>م</rule>ّ<rule class=idgham_wo_ghunnah>ِن</rule>", "en": "from", "tr": "min", "audio": "wbw/078_036_002.mp3"}, {"type": "word", "ar": "رَّبِّكَ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّبِّكَ", "en": "your Lord", "tr": "rabbika", "audio": "wbw/078_036_003.mp3"}, {"type": "word", "ar": "عَطَآءً", "tajweed": "عَط<rule class=madda_obligatory_mottasel>َا</rule>ٓءً", "en": "a gift", "tr": "ʿaṭāan", "audio": "wbw/078_036_004.mp3"}, {"type": "word", "ar": "حِسَابًۭا", "tajweed": "حِسَابًا", "en": "(according to) account", "tr": "ḥisāban", "audio": "wbw/078_036_005.mp3"}, {"type": "end", "num": "٣٦"}]}, {"id": 37, "key": "78:37", "juz": 30, "page": 583, "side_trans": "[From] the Lord of the heavens and the earth and whatever is between them, the Most Merciful. They possess not from Him [authority for] speech.", "words": [{"type": "word", "ar": "رَّبِّ", "tajweed": "رَّبِّ", "en": "Lord", "tr": "rabbi", "audio": "wbw/078_037_001.mp3"}, {"type": "word", "ar": "ٱلسَّمَـٰوَٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّمَ<rule class=madda_normal>ـٰ</rule>و<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِ", "en": "(of) the heavens", "tr": "l-samāwāti", "audio": "wbw/078_037_002.mp3"}, {"type": "word", "ar": "وَٱلْأَرْضِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "and the earth", "tr": "wal-arḍi", "audio": "wbw/078_037_003.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "and whatever", "tr": "wamā", "audio": "wbw/078_037_004.mp3"}, {"type": "word", "ar": "بَيْنَهُمَا", "tajweed": "بَيۡنَهُمَا", "en": "(is) between both of them", "tr": "baynahumā", "audio": "wbw/078_037_005.mp3"}, {"type": "word", "ar": "ٱلرَّحْمَـٰنِ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رَّحۡمَ<rule class=madda_normal>ـٰ</rule>نِ‌ۖ", "en": "the Most Gracious", "tr": "l-raḥmāni", "audio": "wbw/078_037_006.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/078_037_008.mp3"}, {"type": "word", "ar": "يَمْلِكُونَ", "tajweed": "يَمۡلِكُونَ", "en": "they have power", "tr": "yamlikūna", "audio": "wbw/078_037_009.mp3"}, {"type": "word", "ar": "مِنْهُ", "tajweed": "مِنۡهُ", "en": "from Him", "tr": "min'hu", "audio": "wbw/078_037_010.mp3"}, {"type": "word", "ar": "خِطَابًۭا", "tajweed": "خِطَابًا", "en": "(to) address", "tr": "khiṭāban", "audio": "wbw/078_037_011.mp3"}, {"type": "end", "num": "٣٧"}]}, {"id": 38, "key": "78:38", "juz": 30, "page": 583, "side_trans": "The Day that the Spirit [i.e., Gabriel] and the angels will stand in rows, they will not speak except for one whom the Most Merciful permits, and he will say what is correct.", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(The) Day", "tr": "yawma", "audio": "wbw/078_038_001.mp3"}, {"type": "word", "ar": "يَقُومُ", "tajweed": "يَقُومُ", "en": "will stand", "tr": "yaqūmu", "audio": "wbw/078_038_002.mp3"}, {"type": "word", "ar": "ٱلرُّوحُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رُّوحُ", "en": "the Spirit", "tr": "l-rūḥu", "audio": "wbw/078_038_003.mp3"}, {"type": "word", "ar": "وَٱلْمَلَـٰٓئِكَةُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمَلَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَةُ", "en": "and the Angels", "tr": "wal-malāikatu", "audio": "wbw/078_038_004.mp3"}, {"type": "word", "ar": "صَفًّۭا ۖ", "tajweed": "صَف<rule class=idgham_wo_ghunnah>ًّا‌ۖ</rule>", "en": "(in) rows", "tr": "ṣaffan", "audio": "wbw/078_038_005.mp3"}, {"type": "word", "ar": "لَّا", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّا", "en": "not", "tr": "lā", "audio": "wbw/078_038_007.mp3"}, {"type": "word", "ar": "يَتَكَلَّمُونَ", "tajweed": "يَتَكَلَّمُونَ", "en": "they will speak", "tr": "yatakallamūna", "audio": "wbw/078_038_008.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/078_038_009.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "(one) who ", "tr": "man", "audio": "wbw/078_038_010.mp3"}, {"type": "word", "ar": "أَذِنَ", "tajweed": "أَذِنَ", "en": "permits", "tr": "adhina", "audio": "wbw/078_038_011.mp3"}, {"type": "word", "ar": "لَهُ", "tajweed": "لَهُ", "en": "[for] him", "tr": "lahu", "audio": "wbw/078_038_012.mp3"}, {"type": "word", "ar": "ٱلرَّحْمَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رَّحۡمَ<rule class=madda_normal>ـٰ</rule>نُ", "en": "the Most Gracious", "tr": "l-raḥmānu", "audio": "wbw/078_038_013.mp3"}, {"type": "word", "ar": "وَقَالَ", "tajweed": "وَقَالَ", "en": "and he (will) say", "tr": "waqāla", "audio": "wbw/078_038_014.mp3"}, {"type": "word", "ar": "صَوَابًۭا", "tajweed": "صَوَابًا", "en": "(what is) correct", "tr": "ṣawāban", "audio": "wbw/078_038_015.mp3"}, {"type": "end", "num": "٣٨"}]}, {"id": 39, "key": "78:39", "juz": 30, "page": 583, "side_trans": "That is the True [i.e., certain] Day; so he who wills may take to his Lord a [way of] return.", "words": [{"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "That", "tr": "dhālika", "audio": "wbw/078_039_001.mp3"}, {"type": "word", "ar": "ٱلْيَوْمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَوۡمُ", "en": "(is) the Day", "tr": "l-yawmu", "audio": "wbw/078_039_002.mp3"}, {"type": "word", "ar": "ٱلْحَقُّ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَقُّ‌ۖ", "en": "the True", "tr": "l-ḥaqu", "audio": "wbw/078_039_003.mp3"}, {"type": "word", "ar": "فَمَن", "tajweed": "فَمَ<rule class=ikhafa>ن</rule>", "en": "So whoever", "tr": "faman", "audio": "wbw/078_039_005.mp3"}, {"type": "word", "ar": "شَآءَ", "tajweed": "<rule class=ikhafa>ش</rule><rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "wills", "tr": "shāa", "audio": "wbw/078_039_006.mp3"}, {"type": "word", "ar": "ٱتَّخَذَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>تَّخَذَ", "en": "let him take", "tr": "ittakhadha", "audio": "wbw/078_039_007.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "towards", "tr": "ilā", "audio": "wbw/078_039_008.mp3"}, {"type": "word", "ar": "رَبِّهِۦ", "tajweed": "رَبِّه<rule class=madda_normal>ِۦ</rule>", "en": "his Lord", "tr": "rabbihi", "audio": "wbw/078_039_009.mp3"}, {"type": "word", "ar": "مَـَٔابًا", "tajweed": "مَـَٔـابًا", "en": "a return", "tr": "maāban", "audio": "wbw/078_039_010.mp3"}, {"type": "end", "num": "٣٩"}]}, {"id": 40, "key": "78:40", "juz": 30, "page": 583, "side_trans": "Indeed, We have warned you of an impending punishment on the Day when a man will observe what his hands have put forth and the disbeliever will say, \"Oh, I wish that I were dust!\"", "words": [{"type": "word", "ar": "إِنَّآ", "tajweed": "إِ<rule class=ghunnah>نّ</rule><rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Indeed We", "tr": "innā", "audio": "wbw/078_040_001.mp3"}, {"type": "word", "ar": "أَنذَرْنَـٰكُمْ", "tajweed": "أَ<rule class=ikhafa>نذ</rule>َرۡنَ<rule class=madda_normal>ـٰ</rule>كُمۡ", "en": "[We] have warned you", "tr": "andharnākum", "audio": "wbw/078_040_002.mp3"}, {"type": "word", "ar": "عَذَابًۭا", "tajweed": "عَذَا<rule class=ikhafa>بًا</rule>", "en": "(of) a punishment", "tr": "ʿadhāban", "audio": "wbw/078_040_003.mp3"}, {"type": "word", "ar": "قَرِيبًۭا", "tajweed": "<rule class=ikhafa>ق</rule>َرِي<rule class=idgham_ghunnah>بًا</rule>", "en": "near", "tr": "qarīban", "audio": "wbw/078_040_004.mp3"}, {"type": "word", "ar": "يَوْمَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَ", "en": "(the) Day", "tr": "yawma", "audio": "wbw/078_040_005.mp3"}, {"type": "word", "ar": "يَنظُرُ", "tajweed": "يَ<rule class=ikhafa>نظ</rule>ُرُ", "en": "will see", "tr": "yanẓuru", "audio": "wbw/078_040_006.mp3"}, {"type": "word", "ar": "ٱلْمَرْءُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَرۡءُ", "en": "the man", "tr": "l-maru", "audio": "wbw/078_040_007.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/078_040_008.mp3"}, {"type": "word", "ar": "قَدَّمَتْ", "tajweed": "قَدَّمَتۡ", "en": "have sent forth", "tr": "qaddamat", "audio": "wbw/078_040_009.mp3"}, {"type": "word", "ar": "يَدَاهُ", "tajweed": "يَدَاهُ", "en": "his hands", "tr": "yadāhu", "audio": "wbw/078_040_010.mp3"}, {"type": "word", "ar": "وَيَقُولُ", "tajweed": "وَيَقُولُ", "en": "and will say", "tr": "wayaqūlu", "audio": "wbw/078_040_011.mp3"}, {"type": "word", "ar": "ٱلْكَافِرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَافِرُ", "en": "the disbeliever", "tr": "l-kāfiru", "audio": "wbw/078_040_012.mp3"}, {"type": "word", "ar": "يَـٰلَيْتَنِى", "tajweed": "يَ<rule class=madda_normal>ـٰ</rule>لَيۡتَنِى", "en": "O I wish", "tr": "yālaytanī", "audio": "wbw/078_040_013.mp3"}, {"type": "word", "ar": "كُنتُ", "tajweed": "كُ<rule class=ikhafa>نت</rule>ُ", "en": "I were", "tr": "kuntu", "audio": "wbw/078_040_014.mp3"}, {"type": "word", "ar": "تُرَٰبًۢا", "tajweed": "تُر<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>بَۢا", "en": "dust", "tr": "turāban", "audio": "wbw/078_040_015.mp3"}, {"type": "end", "num": "٤٠"}]}]