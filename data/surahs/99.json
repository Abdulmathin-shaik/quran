[{"id": 1, "key": "99:1", "juz": 30, "page": 599, "side_trans": "When the earth is shaken with its [final] earthquake", "words": [{"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/099_001_001.mp3"}, {"type": "word", "ar": "زُلْزِلَتِ", "tajweed": "زُلۡزِلَتِ", "en": "is shaken", "tr": "zul'zilati", "audio": "wbw/099_001_002.mp3"}, {"type": "word", "ar": "ٱلْأَرْضُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضُ", "en": "the earth", "tr": "l-arḍu", "audio": "wbw/099_001_003.mp3"}, {"type": "word", "ar": "زِلْزَالَهَا", "tajweed": "زِلۡزَالَهَا", "en": "(with) its earthquake", "tr": "zil'zālahā", "audio": "wbw/099_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "99:2", "juz": 30, "page": 599, "side_trans": "And the earth discharges its burdens", "words": [{"type": "word", "ar": "وَأَخْرَجَتِ", "tajweed": "وَأَخۡرَجَتِ", "en": "And brings forth", "tr": "wa-akhrajati", "audio": "wbw/099_002_001.mp3"}, {"type": "word", "ar": "ٱلْأَرْضُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضُ", "en": "the earth", "tr": "l-arḍu", "audio": "wbw/099_002_002.mp3"}, {"type": "word", "ar": "أَثْقَالَهَا", "tajweed": "أَثۡقَالَهَا", "en": "its burdens", "tr": "athqālahā", "audio": "wbw/099_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "99:3", "juz": 30, "page": 599, "side_trans": "And man says, \"What is [wrong] with it?\" -", "words": [{"type": "word", "ar": "وَقَالَ", "tajweed": "وَقَالَ", "en": "And says", "tr": "waqāla", "audio": "wbw/099_003_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "man", "tr": "l-insānu", "audio": "wbw/099_003_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "What", "tr": "mā", "audio": "wbw/099_003_003.mp3"}, {"type": "word", "ar": "لَهَا", "tajweed": "لَهَا", "en": "(is) with it", "tr": "lahā", "audio": "wbw/099_003_004.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "99:4", "juz": 30, "page": 599, "side_trans": "That Day, it will report its news", "words": [{"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "يَوۡمَئِ<rule class=ikhafa>ذٍ</rule>", "en": "That Day", "tr": "yawma-idhin", "audio": "wbw/099_004_001.mp3"}, {"type": "word", "ar": "تُحَدِّثُ", "tajweed": "<rule class=ikhafa>ت</rule>ُحَدِّثُ", "en": "it will report", "tr": "tuḥaddithu", "audio": "wbw/099_004_002.mp3"}, {"type": "word", "ar": "أَخْبَارَهَا", "tajweed": "أَخۡبَارَهَا", "en": "its news", "tr": "akhbārahā", "audio": "wbw/099_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "99:5", "juz": 30, "page": 599, "side_trans": "Because your Lord has inspired [i.e., commanded] it.", "words": [{"type": "word", "ar": "بِأَنَّ", "tajweed": "بِأَ<rule class=ghunnah>نّ</rule>َ", "en": "Because", "tr": "bi-anna", "audio": "wbw/099_005_001.mp3"}, {"type": "word", "ar": "رَبَّكَ", "tajweed": "رَبَّكَ", "en": "your Lord", "tr": "rabbaka", "audio": "wbw/099_005_002.mp3"}, {"type": "word", "ar": "أَوْحَىٰ", "tajweed": "أَوۡحَىٰ", "en": "inspired", "tr": "awḥā", "audio": "wbw/099_005_003.mp3"}, {"type": "word", "ar": "لَهَا", "tajweed": "لَهَا", "en": "[to] it", "tr": "lahā", "audio": "wbw/099_005_004.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "99:6", "juz": 30, "page": 599, "side_trans": "That Day, the people will depart separated [into categories] to be shown [the result of] their deeds.", "words": [{"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "يَوۡمَئِ<rule class=idgham_ghunnah>ذٍ</rule>", "en": "That Day", "tr": "yawma-idhin", "audio": "wbw/099_006_001.mp3"}, {"type": "word", "ar": "يَصْدُرُ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َصۡدُرُ", "en": "will proceed", "tr": "yaṣduru", "audio": "wbw/099_006_002.mp3"}, {"type": "word", "ar": "ٱلنَّاسُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َاسُ", "en": "the mankind", "tr": "l-nāsu", "audio": "wbw/099_006_003.mp3"}, {"type": "word", "ar": "أَشْتَاتًۭا", "tajweed": "أَشۡتَا<rule class=idgham_wo_ghunnah>تًا</rule>", "en": "(in) scattered groups", "tr": "ashtātan", "audio": "wbw/099_006_004.mp3"}, {"type": "word", "ar": "لِّيُرَوْا۟", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّيُرَوۡ<rule class=slnt>اۡ</rule>", "en": "to be shown", "tr": "liyuraw", "audio": "wbw/099_006_005.mp3"}, {"type": "word", "ar": "أَعْمَـٰلَهُمْ", "tajweed": "أَعۡمَ<rule class=madda_normal>ـٰ</rule>لَهُمۡ", "en": "their deeds", "tr": "aʿmālahum", "audio": "wbw/099_006_006.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "99:7", "juz": 30, "page": 599, "side_trans": "So whoever does an atom's weight of good will see it,", "words": [{"type": "word", "ar": "فَمَن", "tajweed": "فَم<rule class=idgham_ghunnah>َن</rule>", "en": "So whoever", "tr": "faman", "audio": "wbw/099_007_001.mp3"}, {"type": "word", "ar": "يَعْمَلْ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َعۡمَلۡ", "en": "does", "tr": "yaʿmal", "audio": "wbw/099_007_002.mp3"}, {"type": "word", "ar": "مِثْقَالَ", "tajweed": "مِثۡقَالَ", "en": "(equal to the) weight", "tr": "mith'qāla", "audio": "wbw/099_007_003.mp3"}, {"type": "word", "ar": "ذَرَّةٍ", "tajweed": "ذَرَّةٍ", "en": "(of) an atom", "tr": "dharratin", "audio": "wbw/099_007_004.mp3"}, {"type": "word", "ar": "خَيْرًۭا", "tajweed": "خَيۡ<rule class=idgham_ghunnah>رًا</rule>", "en": "good", "tr": "khayran", "audio": "wbw/099_007_005.mp3"}, {"type": "word", "ar": "يَرَهُۥ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َرَهُۥ", "en": "will see it", "tr": "yarahu", "audio": "wbw/099_007_006.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "99:8", "juz": 30, "page": 599, "side_trans": "And whoever does an atom's weight of evil will see it.", "words": [{"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/099_008_001.mp3"}, {"type": "word", "ar": "يَعْمَلْ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َعۡمَلۡ", "en": "does", "tr": "yaʿmal", "audio": "wbw/099_008_002.mp3"}, {"type": "word", "ar": "مِثْقَالَ", "tajweed": "مِثۡقَالَ", "en": "(equal to the) weight", "tr": "mith'qāla", "audio": "wbw/099_008_003.mp3"}, {"type": "word", "ar": "ذَرَّةٍۢ", "tajweed": "ذَرَّ<rule class=ikhafa>ةٍ</rule>", "en": "(of) an atom", "tr": "dharratin", "audio": "wbw/099_008_004.mp3"}, {"type": "word", "ar": "شَرًّۭا", "tajweed": "<rule class=ikhafa>ش</rule>َر<rule class=idgham_ghunnah>ًّا</rule>", "en": "evil", "tr": "sharran", "audio": "wbw/099_008_005.mp3"}, {"type": "word", "ar": "يَرَهُۥ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َرَهُۥ", "en": "will see it", "tr": "yarahu", "audio": "wbw/099_008_006.mp3"}, {"type": "end", "num": "٨"}]}]