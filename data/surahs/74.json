[{"id": 1, "key": "74:1", "juz": 29, "page": 575, "side_trans": "O you who covers himself [with a garment],", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O you", "tr": "yāayyuhā", "audio": "wbw/074_001_001.mp3"}, {"type": "word", "ar": "ٱلْمُدَّثِّرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُدَّثِّرُ", "en": "who covers himself", "tr": "l-mudathiru", "audio": "wbw/074_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "74:2", "juz": 29, "page": 575, "side_trans": "Arise and warn.", "words": [{"type": "word", "ar": "قُمْ", "tajweed": "قُمۡ", "en": "Stand up", "tr": "qum", "audio": "wbw/074_002_001.mp3"}, {"type": "word", "ar": "فَأَنذِرْ", "tajweed": "فَأَ<rule class=ikhafa>نذ</rule>ِرۡ", "en": "and warn", "tr": "fa-andhir", "audio": "wbw/074_002_002.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "74:3", "juz": 29, "page": 575, "side_trans": "And your Lord glorify.", "words": [{"type": "word", "ar": "وَرَبَّكَ", "tajweed": "وَرَبَّكَ", "en": "And your Lord", "tr": "warabbaka", "audio": "wbw/074_003_001.mp3"}, {"type": "word", "ar": "فَكَبِّرْ", "tajweed": "فَكَبِّرۡ", "en": "magnify", "tr": "fakabbir", "audio": "wbw/074_003_002.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "74:4", "juz": 29, "page": 575, "side_trans": "And your clothing purify.", "words": [{"type": "word", "ar": "وَثِيَابَكَ", "tajweed": "وَثِيَابَكَ", "en": "And your clothing", "tr": "wathiyābaka", "audio": "wbw/074_004_001.mp3"}, {"type": "word", "ar": "فَطَهِّرْ", "tajweed": "فَطَهِّرۡ", "en": "purify", "tr": "faṭahhir", "audio": "wbw/074_004_002.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "74:5", "juz": 29, "page": 575, "side_trans": "And uncleanliness avoid.", "words": [{"type": "word", "ar": "وَٱلرُّجْزَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رُّ<rule class=qalaqah>جۡ</rule>زَ", "en": "And uncleanliness", "tr": "wal-ruj'za", "audio": "wbw/074_005_001.mp3"}, {"type": "word", "ar": "فَٱهْجُرْ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>هۡجُرۡ", "en": "avoid", "tr": "fa-uh'jur", "audio": "wbw/074_005_002.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "74:6", "juz": 29, "page": 575, "side_trans": "And do not confer favor to acquire more.", "words": [{"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "And (do) not", "tr": "walā", "audio": "wbw/074_006_001.mp3"}, {"type": "word", "ar": "تَمْنُن", "tajweed": "تَمۡنُ<rule class=ikhafa>ن</rule>", "en": "confer favor", "tr": "tamnun", "audio": "wbw/074_006_002.mp3"}, {"type": "word", "ar": "تَسْتَكْثِرُ", "tajweed": "<rule class=ikhafa>ت</rule>َسۡتَكۡثِرُ", "en": "(to) acquire more", "tr": "tastakthiru", "audio": "wbw/074_006_003.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "74:7", "juz": 29, "page": 575, "side_trans": "But for your Lord be patient.", "words": [{"type": "word", "ar": "وَلِرَبِّكَ", "tajweed": "وَلِرَبِّكَ", "en": "And for your Lord", "tr": "walirabbika", "audio": "wbw/074_007_001.mp3"}, {"type": "word", "ar": "فَٱصْبِرْ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>صۡبِرۡ", "en": "be patient", "tr": "fa-iṣ'bir", "audio": "wbw/074_007_002.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "74:8", "juz": 29, "page": 575, "side_trans": "And when the trumpet is blown,", "words": [{"type": "word", "ar": "فَإِذَا", "tajweed": "فَإِذَا", "en": "Then when", "tr": "fa-idhā", "audio": "wbw/074_008_001.mp3"}, {"type": "word", "ar": "نُقِرَ", "tajweed": "نُقِرَ", "en": "is blown", "tr": "nuqira", "audio": "wbw/074_008_002.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/074_008_003.mp3"}, {"type": "word", "ar": "ٱلنَّاقُورِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َاق<rule class=madda_permissible>ُو</rule>رِ", "en": "the trumpet", "tr": "l-nāqūri", "audio": "wbw/074_008_004.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "74:9", "juz": 29, "page": 575, "side_trans": "That Day will be a difficult day", "words": [{"type": "word", "ar": "فَذَٰلِكَ", "tajweed": "فَذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "That", "tr": "fadhālika", "audio": "wbw/074_009_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "يَوۡمَئِ<rule class=idgham_ghunnah>ذٍ</rule>", "en": "Day", "tr": "yawma-idhin", "audio": "wbw/074_009_002.mp3"}, {"type": "word", "ar": "يَوْمٌ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمٌ", "en": "(will be) a Day", "tr": "yawmun", "audio": "wbw/074_009_003.mp3"}, {"type": "word", "ar": "عَسِيرٌ", "tajweed": "عَس<rule class=madda_permissible>ِي</rule>رٌ", "en": "difficult", "tr": "ʿasīrun", "audio": "wbw/074_009_004.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "74:10", "juz": 29, "page": 575, "side_trans": "For the disbelievers - not easy.", "words": [{"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "For", "tr": "ʿalā", "audio": "wbw/074_010_001.mp3"}, {"type": "word", "ar": "ٱلْكَـٰفِرِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَ<rule class=madda_normal>ـٰ</rule>فِرِينَ", "en": "the disbelievers ", "tr": "l-kāfirīna", "audio": "wbw/074_010_002.mp3"}, {"type": "word", "ar": "غَيْرُ", "tajweed": "غَيۡرُ", "en": "not", "tr": "ghayru", "audio": "wbw/074_010_003.mp3"}, {"type": "word", "ar": "يَسِيرٍۢ", "tajweed": "يَس<rule class=madda_permissible>ِي</rule>رٍ", "en": "easy", "tr": "yasīrin", "audio": "wbw/074_010_004.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "74:11", "juz": 29, "page": 575, "side_trans": "Leave Me with the one I created alone", "words": [{"type": "word", "ar": "ذَرْنِى", "tajweed": "ذَرۡنِى", "en": "Leave Me", "tr": "dharnī", "audio": "wbw/074_011_001.mp3"}, {"type": "word", "ar": "وَمَنْ", "tajweed": "وَمَنۡ", "en": "and whom", "tr": "waman", "audio": "wbw/074_011_002.mp3"}, {"type": "word", "ar": "خَلَقْتُ", "tajweed": "خَلَ<rule class=qalaqah>قۡ</rule>تُ", "en": "I created", "tr": "khalaqtu", "audio": "wbw/074_011_003.mp3"}, {"type": "word", "ar": "وَحِيدًۭا", "tajweed": "وَحِيدًا", "en": "alone", "tr": "waḥīdan", "audio": "wbw/074_011_004.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "74:12", "juz": 29, "page": 575, "side_trans": "And to whom I granted extensive wealth", "words": [{"type": "word", "ar": "وَجَعَلْتُ", "tajweed": "وَجَعَلۡتُ", "en": "And I granted", "tr": "wajaʿaltu", "audio": "wbw/074_012_001.mp3"}, {"type": "word", "ar": "لَهُۥ", "tajweed": "لَهُ<rule class=madda_normal>ۥ</rule>", "en": "to him", "tr": "lahu", "audio": "wbw/074_012_002.mp3"}, {"type": "word", "ar": "مَالًۭا", "tajweed": "مَال<rule class=idgham_ghunnah>اً</rule>", "en": "wealth", "tr": "mālan", "audio": "wbw/074_012_003.mp3"}, {"type": "word", "ar": "مَّمْدُودًۭا", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّمۡدُودًا", "en": "extensive", "tr": "mamdūdan", "audio": "wbw/074_012_004.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "74:13", "juz": 29, "page": 575, "side_trans": "And children present [with him]", "words": [{"type": "word", "ar": "وَبَنِينَ", "tajweed": "وَبَنِينَ", "en": "And children", "tr": "wabanīna", "audio": "wbw/074_013_001.mp3"}, {"type": "word", "ar": "شُهُودًۭا", "tajweed": "شُهُودًا", "en": "present", "tr": "shuhūdan", "audio": "wbw/074_013_002.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "74:14", "juz": 29, "page": 575, "side_trans": "And spread [everything] before him, easing [his life].", "words": [{"type": "word", "ar": "وَمَهَّدتُّ", "tajweed": "وَمَهَّ<rule class=idgham_mutajanisayn>د</rule>تُّ", "en": "And I spread", "tr": "wamahhadttu", "audio": "wbw/074_014_001.mp3"}, {"type": "word", "ar": "لَهُۥ", "tajweed": "لَهُ<rule class=madda_normal>ۥ</rule>", "en": "for him", "tr": "lahu", "audio": "wbw/074_014_002.mp3"}, {"type": "word", "ar": "تَمْهِيدًۭا", "tajweed": "تَمۡهِيدًا", "en": "ease", "tr": "tamhīdan", "audio": "wbw/074_014_003.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "74:15", "juz": 29, "page": 575, "side_trans": "Then he desires that I should add more.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/074_015_001.mp3"}, {"type": "word", "ar": "يَطْمَعُ", "tajweed": "يَ<rule class=qalaqah>طۡ</rule>مَعُ", "en": "he desires", "tr": "yaṭmaʿu", "audio": "wbw/074_015_002.mp3"}, {"type": "word", "ar": "أَنْ", "tajweed": "أَنۡ", "en": "that", "tr": "an", "audio": "wbw/074_015_003.mp3"}, {"type": "word", "ar": "أَزِيدَ", "tajweed": "أَز<rule class=madda_permissible>ِي</rule><rule class=qalaqah>د</rule>َ", "en": "I (should) add more", "tr": "azīda", "audio": "wbw/074_015_004.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "74:16", "juz": 29, "page": 575, "side_trans": "No! Indeed, he has been toward Our verses obstinate.", "words": [{"type": "word", "ar": "كَلَّآ ۖ", "tajweed": "كَلّ<rule class=madda_obligatory_monfasel>َآ‌ۖ</rule>", "en": "By no means", "tr": "kallā", "audio": "wbw/074_016_001.mp3"}, {"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, he", "tr": "innahu", "audio": "wbw/074_016_003.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "has been", "tr": "kāna", "audio": "wbw/074_016_004.mp3"}, {"type": "word", "ar": "لِـَٔايَـٰتِنَا", "tajweed": "لِأَيَ<rule class=madda_normal>ـٰ</rule>تِنَا", "en": "to Our Verses", "tr": "liāyātinā", "audio": "wbw/074_016_005.mp3"}, {"type": "word", "ar": "عَنِيدًۭا", "tajweed": "عَنِيدًا", "en": "stubborn", "tr": "ʿanīdan", "audio": "wbw/074_016_006.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "74:17", "juz": 29, "page": 575, "side_trans": "I will cover him with arduous torment.", "words": [{"type": "word", "ar": "سَأُرْهِقُهُۥ", "tajweed": "سَأُرۡهِقُهُ<rule class=madda_normal>ۥ</rule>", "en": "Soon I will cover Him", "tr": "sa-ur'hiquhu", "audio": "wbw/074_017_001.mp3"}, {"type": "word", "ar": "صَعُودًا", "tajweed": "صَعُودًا", "en": "(with) a laborious punishment", "tr": "ṣaʿūdan", "audio": "wbw/074_017_002.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "74:18", "juz": 29, "page": 575, "side_trans": "Indeed, he thought and deliberated.", "words": [{"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, he", "tr": "innahu", "audio": "wbw/074_018_001.mp3"}, {"type": "word", "ar": "فَكَّرَ", "tajweed": "فَكَّرَ", "en": "thought", "tr": "fakkara", "audio": "wbw/074_018_002.mp3"}, {"type": "word", "ar": "وَقَدَّرَ", "tajweed": "وَقَدَّرَ", "en": "and plotted", "tr": "waqaddara", "audio": "wbw/074_018_003.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "74:19", "juz": 29, "page": 576, "side_trans": "So may he be destroyed [for] how he deliberated.", "words": [{"type": "word", "ar": "فَقُتِلَ", "tajweed": "فَقُتِلَ", "en": "So may he be destroyed", "tr": "faqutila", "audio": "wbw/074_019_001.mp3"}, {"type": "word", "ar": "كَيْفَ", "tajweed": "كَيۡفَ", "en": "how", "tr": "kayfa", "audio": "wbw/074_019_002.mp3"}, {"type": "word", "ar": "قَدَّرَ", "tajweed": "قَدَّرَ", "en": "he plotted", "tr": "qaddara", "audio": "wbw/074_019_003.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "74:20", "juz": 29, "page": 576, "side_trans": "Then may he be destroyed [for] how he deliberated.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/074_020_001.mp3"}, {"type": "word", "ar": "قُتِلَ", "tajweed": "قُتِلَ", "en": "may he be destroyed", "tr": "qutila", "audio": "wbw/074_020_002.mp3"}, {"type": "word", "ar": "كَيْفَ", "tajweed": "كَيۡفَ", "en": "how", "tr": "kayfa", "audio": "wbw/074_020_003.mp3"}, {"type": "word", "ar": "قَدَّرَ", "tajweed": "قَدَّرَ", "en": "he plotted", "tr": "qaddara", "audio": "wbw/074_020_004.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "74:21", "juz": 29, "page": 576, "side_trans": "Then he considered [again];", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/074_021_001.mp3"}, {"type": "word", "ar": "نَظَرَ", "tajweed": "نَظَرَ", "en": "he looked", "tr": "naẓara", "audio": "wbw/074_021_002.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "74:22", "juz": 29, "page": 576, "side_trans": "Then he frowned and scowled;", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/074_022_001.mp3"}, {"type": "word", "ar": "عَبَسَ", "tajweed": "عَبَسَ", "en": "he frowned", "tr": "ʿabasa", "audio": "wbw/074_022_002.mp3"}, {"type": "word", "ar": "وَبَسَرَ", "tajweed": "وَبَسَرَ", "en": "and scowled", "tr": "wabasara", "audio": "wbw/074_022_003.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "74:23", "juz": 29, "page": 576, "side_trans": "Then he turned back and was arrogant", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/074_023_001.mp3"}, {"type": "word", "ar": "أَدْبَرَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>بَرَ", "en": "he turned back", "tr": "adbara", "audio": "wbw/074_023_002.mp3"}, {"type": "word", "ar": "وَٱسْتَكْبَرَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>سۡتَكۡبَرَ", "en": "and was proud", "tr": "wa-is'takbara", "audio": "wbw/074_023_003.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "74:24", "juz": 29, "page": 576, "side_trans": "And said, \"This is not but magic imitated [from others].", "words": [{"type": "word", "ar": "فَقَالَ", "tajweed": "فَقَالَ", "en": "Then he said", "tr": "faqāla", "audio": "wbw/074_024_001.mp3"}, {"type": "word", "ar": "إِنْ", "tajweed": "إِنۡ", "en": "Not", "tr": "in", "audio": "wbw/074_024_002.mp3"}, {"type": "word", "ar": "هَـٰذَآ", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>ذ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "(is) this", "tr": "hādhā", "audio": "wbw/074_024_003.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "but", "tr": "illā", "audio": "wbw/074_024_004.mp3"}, {"type": "word", "ar": "سِحْرٌۭ", "tajweed": "سِحۡ<rule class=idgham_ghunnah>رٌ</rule>", "en": "magic", "tr": "siḥ'run", "audio": "wbw/074_024_005.mp3"}, {"type": "word", "ar": "يُؤْثَرُ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُؤۡثَرُ", "en": "imitated", "tr": "yu'tharu", "audio": "wbw/074_024_006.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "74:25", "juz": 29, "page": 576, "side_trans": "This is not but the word of a human being.\"", "words": [{"type": "word", "ar": "إِنْ", "tajweed": "إِنۡ", "en": "Not", "tr": "in", "audio": "wbw/074_025_001.mp3"}, {"type": "word", "ar": "هَـٰذَآ", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>ذ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "(is) this", "tr": "hādhā", "audio": "wbw/074_025_002.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "but", "tr": "illā", "audio": "wbw/074_025_003.mp3"}, {"type": "word", "ar": "قَوْلُ", "tajweed": "قَوۡلُ", "en": "(the) word", "tr": "qawlu", "audio": "wbw/074_025_004.mp3"}, {"type": "word", "ar": "ٱلْبَشَرِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبَشَرِ", "en": "(of) a human being", "tr": "l-bashari", "audio": "wbw/074_025_005.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "74:26", "juz": 29, "page": 576, "side_trans": "I will drive him into Saqar.", "words": [{"type": "word", "ar": "سَأُصْلِيهِ", "tajweed": "سَأُصۡلِيهِ", "en": "Soon I will drive him", "tr": "sa-uṣ'līhi", "audio": "wbw/074_026_001.mp3"}, {"type": "word", "ar": "سَقَرَ", "tajweed": "سَقَرَ", "en": "(into) Hell", "tr": "saqara", "audio": "wbw/074_026_002.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "74:27", "juz": 29, "page": 576, "side_trans": "And what can make you know what is Saqar?", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And what", "tr": "wamā", "audio": "wbw/074_027_001.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "can make you know", "tr": "adrāka", "audio": "wbw/074_027_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/074_027_003.mp3"}, {"type": "word", "ar": "سَقَرُ", "tajweed": "سَقَرُ", "en": "(is) Hell", "tr": "saqaru", "audio": "wbw/074_027_004.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "74:28", "juz": 29, "page": 576, "side_trans": "It lets nothing remain and leaves nothing [unburned],", "words": [{"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "Not", "tr": "lā", "audio": "wbw/074_028_001.mp3"}, {"type": "word", "ar": "تُبْقِى", "tajweed": "تُ<rule class=qalaqah>بۡ</rule>قِى", "en": "it lets remain", "tr": "tub'qī", "audio": "wbw/074_028_002.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "and not", "tr": "walā", "audio": "wbw/074_028_003.mp3"}, {"type": "word", "ar": "تَذَرُ", "tajweed": "تَذَرُ", "en": "it leaves", "tr": "tadharu", "audio": "wbw/074_028_004.mp3"}, {"type": "end", "num": "٢٨"}]}, {"id": 29, "key": "74:29", "juz": 29, "page": 576, "side_trans": "Altering [i.e., blackening] the skins.", "words": [{"type": "word", "ar": "لَوَّاحَةٌۭ", "tajweed": "لَوَّاحَ<rule class=idgham_wo_ghunnah>ةٌ</rule>", "en": "Scorching", "tr": "lawwāḥatun", "audio": "wbw/074_029_001.mp3"}, {"type": "word", "ar": "لِّلْبَشَرِ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡبَشَرِ", "en": "the human (skin)", "tr": "lil'bashari", "audio": "wbw/074_029_002.mp3"}, {"type": "end", "num": "٢٩"}]}, {"id": 30, "key": "74:30", "juz": 29, "page": 576, "side_trans": "Over it are nineteen [angels].", "words": [{"type": "word", "ar": "عَلَيْهَا", "tajweed": "عَلَيۡهَا", "en": "Over it", "tr": "ʿalayhā", "audio": "wbw/074_030_001.mp3"}, {"type": "word", "ar": "تِسْعَةَ", "tajweed": "تِسۡعَةَ", "en": "(are) nine", "tr": "tis'ʿata", "audio": "wbw/074_030_002.mp3"}, {"type": "word", "ar": "عَشَرَ", "tajweed": "عَشَرَ", "en": "teen", "tr": "ʿashara", "audio": "wbw/074_030_003.mp3"}, {"type": "end", "num": "٣٠"}]}, {"id": 31, "key": "74:31", "juz": 29, "page": 576, "side_trans": "And We have not made the keepers of the Fire except angels. And We have not made their number except as a trial for those who disbelieve - that those who were given the Scripture will be convinced and those who have believed will increase in faith and those who were given the Scripture and the believers will not doubt and that those in whose hearts is disease [i.e., hypocrisy] and the disbelievers will say, \"What does Allāh intend by this as an example?\" Thus does Allāh send astray whom He wills and guide whom He wills. And none knows the soldiers of your Lord except Him. And it [i.e., mention of the Fire] is not but a reminder to humanity.", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/074_031_001.mp3"}, {"type": "word", "ar": "جَعَلْنَآ", "tajweed": "جَعَلۡن<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "We have made", "tr": "jaʿalnā", "audio": "wbw/074_031_002.mp3"}, {"type": "word", "ar": "أَصْحَـٰبَ", "tajweed": "أَصۡحَ<rule class=madda_normal>ـٰ</rule>بَ", "en": "keepers", "tr": "aṣḥāba", "audio": "wbw/074_031_003.mp3"}, {"type": "word", "ar": "ٱلنَّارِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َارِ", "en": "(of) the Fire", "tr": "l-nāri", "audio": "wbw/074_031_004.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/074_031_005.mp3"}, {"type": "word", "ar": "مَلَـٰٓئِكَةًۭ ۙ", "tajweed": "مَلَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَ<rule class=idgham_ghunnah>ةً‌ۙ</rule>", "en": "Angels", "tr": "malāikatan", "audio": "wbw/074_031_006.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َمَا", "en": "And not", "tr": "wamā", "audio": "wbw/074_031_008.mp3"}, {"type": "word", "ar": "جَعَلْنَا", "tajweed": "جَعَلۡنَا", "en": "We have made", "tr": "jaʿalnā", "audio": "wbw/074_031_009.mp3"}, {"type": "word", "ar": "عِدَّتَهُمْ", "tajweed": "عِدَّتَهُمۡ", "en": "their number", "tr": "ʿiddatahum", "audio": "wbw/074_031_010.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/074_031_011.mp3"}, {"type": "word", "ar": "فِتْنَةًۭ", "tajweed": "فِتۡنَ<rule class=idgham_wo_ghunnah>ةً</rule>", "en": "(as) a trial", "tr": "fit'natan", "audio": "wbw/074_031_012.mp3"}, {"type": "word", "ar": "لِّلَّذِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلَّذِينَ", "en": "for those who", "tr": "lilladhīna", "audio": "wbw/074_031_013.mp3"}, {"type": "word", "ar": "كَفَرُوا۟", "tajweed": "كَفَرُو<rule class=slnt>اۡ</rule>", "en": "disbelieve ", "tr": "kafarū", "audio": "wbw/074_031_014.mp3"}, {"type": "word", "ar": "لِيَسْتَيْقِنَ", "tajweed": "لِيَسۡتَيۡقِنَ", "en": "that may be certain", "tr": "liyastayqina", "audio": "wbw/074_031_015.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/074_031_016.mp3"}, {"type": "word", "ar": "أُوتُوا۟", "tajweed": "أُوتُو<rule class=slnt>اۡ</rule>", "en": "were given", "tr": "ūtū", "audio": "wbw/074_031_017.mp3"}, {"type": "word", "ar": "ٱلْكِتَـٰبَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكِتَ<rule class=madda_normal>ـٰ</rule>بَ", "en": "the Scripture", "tr": "l-kitāba", "audio": "wbw/074_031_018.mp3"}, {"type": "word", "ar": "وَيَزْدَادَ", "tajweed": "وَيَزۡدَادَ", "en": "and may increase", "tr": "wayazdāda", "audio": "wbw/074_031_019.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/074_031_020.mp3"}, {"type": "word", "ar": "ءَامَنُوٓا۟", "tajweed": "ءَامَن<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/074_031_021.mp3"}, {"type": "word", "ar": "إِيمَـٰنًۭا ۙ", "tajweed": "إِيمَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>نًا‌ۙ</rule>", "en": "(in) faith", "tr": "īmānan", "audio": "wbw/074_031_022.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "and not", "tr": "walā", "audio": "wbw/074_031_024.mp3"}, {"type": "word", "ar": "يَرْتَابَ", "tajweed": "يَرۡتَابَ", "en": "may doubt", "tr": "yartāba", "audio": "wbw/074_031_025.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/074_031_026.mp3"}, {"type": "word", "ar": "أُوتُوا۟", "tajweed": "أُوتُو<rule class=slnt>اۡ</rule>", "en": "were given", "tr": "ūtū", "audio": "wbw/074_031_027.mp3"}, {"type": "word", "ar": "ٱلْكِتَـٰبَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكِتَ<rule class=madda_normal>ـٰ</rule>بَ", "en": "the Scripture", "tr": "l-kitāba", "audio": "wbw/074_031_028.mp3"}, {"type": "word", "ar": "وَٱلْمُؤْمِنُونَ ۙ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمُؤۡمِنُونَ‌ۙ", "en": "and the believers", "tr": "wal-mu'minūna", "audio": "wbw/074_031_029.mp3"}, {"type": "word", "ar": "وَلِيَقُولَ", "tajweed": "وَلِيَقُولَ", "en": "and that may say", "tr": "waliyaqūla", "audio": "wbw/074_031_031.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those", "tr": "alladhīna", "audio": "wbw/074_031_032.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/074_031_033.mp3"}, {"type": "word", "ar": "قُلُوبِهِم", "tajweed": "قُلُوبِه<rule class=idgham_shafawi>ِم</rule>", "en": "their hearts", "tr": "qulūbihim", "audio": "wbw/074_031_034.mp3"}, {"type": "word", "ar": "مَّرَضٌۭ", "tajweed": "<rule class=idgham_shafawi>م</rule>َّرَ<rule class=idgham_ghunnah>ضٌ</rule>", "en": "(is) a disease", "tr": "maraḍun", "audio": "wbw/074_031_035.mp3"}, {"type": "word", "ar": "وَٱلْكَـٰفِرُونَ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َ<rule class=ham_wasl>ٱ</rule>لۡكَ<rule class=madda_normal>ـٰ</rule>فِرُونَ", "en": "and the disbelievers", "tr": "wal-kāfirūna", "audio": "wbw/074_031_036.mp3"}, {"type": "word", "ar": "مَاذَآ", "tajweed": "مَاذ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "What", "tr": "mādhā", "audio": "wbw/074_031_037.mp3"}, {"type": "word", "ar": "أَرَادَ", "tajweed": "أَرَادَ", "en": "(does) intend", "tr": "arāda", "audio": "wbw/074_031_038.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/074_031_039.mp3"}, {"type": "word", "ar": "بِهَـٰذَا", "tajweed": "بِهَ<rule class=madda_normal>ـٰ</rule>ذَا", "en": "by this", "tr": "bihādhā", "audio": "wbw/074_031_040.mp3"}, {"type": "word", "ar": "مَثَلًۭا ۚ", "tajweed": "مَثَل<rule class=ikhafa>اً‌ۚ</rule>", "en": "example", "tr": "mathalan", "audio": "wbw/074_031_041.mp3"}, {"type": "word", "ar": "كَذَٰلِكَ", "tajweed": "<rule class=ikhafa>ك</rule>َذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "Thus", "tr": "kadhālika", "audio": "wbw/074_031_043.mp3"}, {"type": "word", "ar": "يُضِلُّ", "tajweed": "يُضِلُّ", "en": "does let go astray", "tr": "yuḍillu", "audio": "wbw/074_031_044.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/074_031_045.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "م<rule class=idgham_ghunnah>َن</rule>", "en": "whom", "tr": "man", "audio": "wbw/074_031_046.mp3"}, {"type": "word", "ar": "يَشَآءُ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َش<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ", "en": "He wills", "tr": "yashāu", "audio": "wbw/074_031_047.mp3"}, {"type": "word", "ar": "وَيَهْدِى", "tajweed": "وَيَهۡدِى", "en": "and guides", "tr": "wayahdī", "audio": "wbw/074_031_048.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "م<rule class=idgham_ghunnah>َن</rule>", "en": "whom", "tr": "man", "audio": "wbw/074_031_049.mp3"}, {"type": "word", "ar": "يَشَآءُ ۚ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َش<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ‌ۚ", "en": "He wills", "tr": "yashāu", "audio": "wbw/074_031_050.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And none", "tr": "wamā", "audio": "wbw/074_031_052.mp3"}, {"type": "word", "ar": "يَعْلَمُ", "tajweed": "يَعۡلَمُ", "en": "knows", "tr": "yaʿlamu", "audio": "wbw/074_031_053.mp3"}, {"type": "word", "ar": "جُنُودَ", "tajweed": "جُنُودَ", "en": "(the) hosts", "tr": "junūda", "audio": "wbw/074_031_054.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "(of) your Lord", "tr": "rabbika", "audio": "wbw/074_031_055.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/074_031_056.mp3"}, {"type": "word", "ar": "هُوَ ۚ", "tajweed": "هُوَ‌ۚ", "en": "Him", "tr": "huwa", "audio": "wbw/074_031_057.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/074_031_059.mp3"}, {"type": "word", "ar": "هِىَ", "tajweed": "هِىَ", "en": "it", "tr": "hiya", "audio": "wbw/074_031_060.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "(is) but", "tr": "illā", "audio": "wbw/074_031_061.mp3"}, {"type": "word", "ar": "ذِكْرَىٰ", "tajweed": "ذِكۡرَىٰ", "en": "a reminder", "tr": "dhik'rā", "audio": "wbw/074_031_062.mp3"}, {"type": "word", "ar": "لِلْبَشَرِ", "tajweed": "لِلۡبَشَرِ", "en": "to (the) human beings", "tr": "lil'bashari", "audio": "wbw/074_031_063.mp3"}, {"type": "end", "num": "٣١"}]}, {"id": 32, "key": "74:32", "juz": 29, "page": 576, "side_trans": "No! By the moon.", "words": [{"type": "word", "ar": "كَلَّا", "tajweed": "كَلَّا", "en": "Nay", "tr": "kallā", "audio": "wbw/074_032_001.mp3"}, {"type": "word", "ar": "وَٱلْقَمَرِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡقَمَرِ", "en": "By the moon", "tr": "wal-qamari", "audio": "wbw/074_032_002.mp3"}, {"type": "end", "num": "٣٢"}]}, {"id": 33, "key": "74:33", "juz": 29, "page": 576, "side_trans": "And [by] the night when it departs.", "words": [{"type": "word", "ar": "وَٱلَّيْلِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّيۡلِ", "en": "And the night", "tr": "wa-al-layli", "audio": "wbw/074_033_001.mp3"}, {"type": "word", "ar": "إِذْ", "tajweed": "إِذۡ", "en": "when", "tr": "idh", "audio": "wbw/074_033_002.mp3"}, {"type": "word", "ar": "أَدْبَرَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>بَرَ", "en": "it departs", "tr": "adbara", "audio": "wbw/074_033_003.mp3"}, {"type": "end", "num": "٣٣"}]}, {"id": 34, "key": "74:34", "juz": 29, "page": 576, "side_trans": "And [by] the morning when it brightens,", "words": [{"type": "word", "ar": "وَٱلصُّبْحِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صُّ<rule class=qalaqah>بۡ</rule>حِ", "en": "And the morning", "tr": "wal-ṣub'ḥi", "audio": "wbw/074_034_001.mp3"}, {"type": "word", "ar": "إِذَآ", "tajweed": "إِذ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "when", "tr": "idhā", "audio": "wbw/074_034_002.mp3"}, {"type": "word", "ar": "أَسْفَرَ", "tajweed": "أَسۡفَرَ", "en": "it brightens", "tr": "asfara", "audio": "wbw/074_034_003.mp3"}, {"type": "end", "num": "٣٤"}]}, {"id": 35, "key": "74:35", "juz": 29, "page": 576, "side_trans": "Indeed, it [i.e., the Fire] is of the greatest [afflictions].", "words": [{"type": "word", "ar": "إِنَّهَا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهَا", "en": "Indeed, it", "tr": "innahā", "audio": "wbw/074_035_001.mp3"}, {"type": "word", "ar": "لَإِحْدَى", "tajweed": "لَإِحۡدَى", "en": "(is) surely one", "tr": "la-iḥ'dā", "audio": "wbw/074_035_002.mp3"}, {"type": "word", "ar": "ٱلْكُبَرِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكُبَرِ", "en": "(of) the greatest", "tr": "l-kubari", "audio": "wbw/074_035_003.mp3"}, {"type": "end", "num": "٣٥"}]}, {"id": 36, "key": "74:36", "juz": 29, "page": 576, "side_trans": "As a warning to humanity -", "words": [{"type": "word", "ar": "نَذِيرًۭا", "tajweed": "نَذِي<rule class=idgham_wo_ghunnah>رًا</rule>", "en": "A warning", "tr": "nadhīran", "audio": "wbw/074_036_001.mp3"}, {"type": "word", "ar": "لِّلْبَشَرِ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡبَشَرِ", "en": "to (the) human being", "tr": "lil'bashari", "audio": "wbw/074_036_002.mp3"}, {"type": "end", "num": "٣٦"}]}, {"id": 37, "key": "74:37", "juz": 29, "page": 576, "side_trans": "To whoever wills among you to proceed or stay behind.", "words": [{"type": "word", "ar": "لِمَن", "tajweed": "لِمَ<rule class=ikhafa>ن</rule>", "en": "To whoever", "tr": "liman", "audio": "wbw/074_037_001.mp3"}, {"type": "word", "ar": "شَآءَ", "tajweed": "<rule class=ikhafa>ش</rule><rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "wills", "tr": "shāa", "audio": "wbw/074_037_002.mp3"}, {"type": "word", "ar": "مِنكُمْ", "tajweed": "مِ<rule class=ikhafa>نك</rule>ُمۡ", "en": "among you", "tr": "minkum", "audio": "wbw/074_037_003.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "to", "tr": "an", "audio": "wbw/074_037_004.mp3"}, {"type": "word", "ar": "يَتَقَدَّمَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َتَقَدَّمَ", "en": "proceed", "tr": "yataqaddama", "audio": "wbw/074_037_005.mp3"}, {"type": "word", "ar": "أَوْ", "tajweed": "أَوۡ", "en": "or", "tr": "aw", "audio": "wbw/074_037_006.mp3"}, {"type": "word", "ar": "يَتَأَخَّرَ", "tajweed": "يَتَأَخَّرَ", "en": "stay behind", "tr": "yata-akhara", "audio": "wbw/074_037_007.mp3"}, {"type": "end", "num": "٣٧"}]}, {"id": 38, "key": "74:38", "juz": 29, "page": 576, "side_trans": "Every soul, for what it has earned, will be retained.", "words": [{"type": "word", "ar": "كُلُّ", "tajweed": "كُلُّ", "en": "Every", "tr": "kullu", "audio": "wbw/074_038_001.mp3"}, {"type": "word", "ar": "نَفْسٍۭ", "tajweed": "نَفۡ<rule class=iqlab>سِۭ</rule>", "en": "soul", "tr": "nafsin", "audio": "wbw/074_038_002.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "<rule class=iqlab>ب</rule>ِمَا", "en": "for what", "tr": "bimā", "audio": "wbw/074_038_003.mp3"}, {"type": "word", "ar": "كَسَبَتْ", "tajweed": "كَسَبَتۡ", "en": "it has earned", "tr": "kasabat", "audio": "wbw/074_038_004.mp3"}, {"type": "word", "ar": "رَهِينَةٌ", "tajweed": "رَهِينَةٌ", "en": "(is) pledged", "tr": "rahīnatun", "audio": "wbw/074_038_005.mp3"}, {"type": "end", "num": "٣٨"}]}, {"id": 39, "key": "74:39", "juz": 29, "page": 576, "side_trans": "Except the companions of the right,.", "words": [{"type": "word", "ar": "إِلَّآ", "tajweed": "إِلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Except", "tr": "illā", "audio": "wbw/074_039_001.mp3"}, {"type": "word", "ar": "أَصْحَـٰبَ", "tajweed": "أَصۡحَ<rule class=madda_normal>ـٰ</rule>بَ", "en": "(the) companions", "tr": "aṣḥāba", "audio": "wbw/074_039_002.mp3"}, {"type": "word", "ar": "ٱلْيَمِينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَم<rule class=madda_permissible>ِي</rule>نِ", "en": "(of) the right", "tr": "l-yamīni", "audio": "wbw/074_039_003.mp3"}, {"type": "end", "num": "٣٩"}]}, {"id": 40, "key": "74:40", "juz": 29, "page": 576, "side_trans": "[Who will be] in gardens, questioning each other", "words": [{"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "In", "tr": "fī", "audio": "wbw/074_040_001.mp3"}, {"type": "word", "ar": "جَنَّـٰتٍۢ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>تٍ</rule>", "en": "Gardens", "tr": "jannātin", "audio": "wbw/074_040_002.mp3"}, {"type": "word", "ar": "يَتَسَآءَلُونَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َتَس<rule class=madda_obligatory_mottasel>َا</rule>ٓءَل<rule class=madda_permissible>ُو</rule>نَ", "en": "asking each other", "tr": "yatasāalūna", "audio": "wbw/074_040_003.mp3"}, {"type": "end", "num": "٤٠"}]}, {"id": 41, "key": "74:41", "juz": 29, "page": 576, "side_trans": "About the criminals,", "words": [{"type": "word", "ar": "عَنِ", "tajweed": "عَنِ", "en": "About", "tr": "ʿani", "audio": "wbw/074_041_001.mp3"}, {"type": "word", "ar": "ٱلْمُجْرِمِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُ<rule class=qalaqah>جۡ</rule>رِم<rule class=madda_permissible>ِي</rule>نَ", "en": "the criminals", "tr": "l-muj'rimīna", "audio": "wbw/074_041_002.mp3"}, {"type": "end", "num": "٤١"}]}, {"id": 42, "key": "74:42", "juz": 29, "page": 576, "side_trans": "[And asking them], \"What put you into Saqar?\"", "words": [{"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "What", "tr": "mā", "audio": "wbw/074_042_001.mp3"}, {"type": "word", "ar": "سَلَكَكُمْ", "tajweed": "سَلَكَكُمۡ", "en": "led you", "tr": "salakakum", "audio": "wbw/074_042_002.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "into", "tr": "fī", "audio": "wbw/074_042_003.mp3"}, {"type": "word", "ar": "سَقَرَ", "tajweed": "سَقَرَ", "en": "Hell", "tr": "saqara", "audio": "wbw/074_042_004.mp3"}, {"type": "end", "num": "٤٢"}]}, {"id": 43, "key": "74:43", "juz": 29, "page": 576, "side_trans": "They will say, \"We were not of those who prayed,", "words": [{"type": "word", "ar": "قَالُوا۟", "tajweed": "قَالُو<rule class=slnt>اۡ</rule>", "en": "They will say", "tr": "qālū", "audio": "wbw/074_043_001.mp3"}, {"type": "word", "ar": "لَمْ", "tajweed": "لَمۡ", "en": "Not", "tr": "lam", "audio": "wbw/074_043_002.mp3"}, {"type": "word", "ar": "نَكُ", "tajweed": "نَكُ", "en": "we were", "tr": "naku", "audio": "wbw/074_043_003.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "of", "tr": "mina", "audio": "wbw/074_043_004.mp3"}, {"type": "word", "ar": "ٱلْمُصَلِّينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُصَلّ<rule class=madda_permissible>ِي</rule>نَ", "en": "those who prayed", "tr": "l-muṣalīna", "audio": "wbw/074_043_005.mp3"}, {"type": "end", "num": "٤٣"}]}, {"id": 44, "key": "74:44", "juz": 29, "page": 576, "side_trans": "Nor did we used to feed the poor.", "words": [{"type": "word", "ar": "وَلَمْ", "tajweed": "وَلَمۡ", "en": "And not", "tr": "walam", "audio": "wbw/074_044_001.mp3"}, {"type": "word", "ar": "نَكُ", "tajweed": "نَكُ", "en": "we used to", "tr": "naku", "audio": "wbw/074_044_002.mp3"}, {"type": "word", "ar": "نُطْعِمُ", "tajweed": "نُ<rule class=qalaqah>طۡ</rule>عِمُ", "en": "feed", "tr": "nuṭ'ʿimu", "audio": "wbw/074_044_003.mp3"}, {"type": "word", "ar": "ٱلْمِسْكِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمِسۡك<rule class=madda_permissible>ِي</rule>نَ", "en": "the poor", "tr": "l-mis'kīna", "audio": "wbw/074_044_004.mp3"}, {"type": "end", "num": "٤٤"}]}, {"id": 45, "key": "74:45", "juz": 29, "page": 576, "side_trans": "And we used to enter into vain discourse with those who engaged [in it],", "words": [{"type": "word", "ar": "وَكُنَّا", "tajweed": "وَكُ<rule class=ghunnah>نّ</rule>َا", "en": "And we used to", "tr": "wakunnā", "audio": "wbw/074_045_001.mp3"}, {"type": "word", "ar": "نَخُوضُ", "tajweed": "نَخُوضُ", "en": "indulge in vain talk", "tr": "nakhūḍu", "audio": "wbw/074_045_002.mp3"}, {"type": "word", "ar": "مَعَ", "tajweed": "مَعَ", "en": "with", "tr": "maʿa", "audio": "wbw/074_045_003.mp3"}, {"type": "word", "ar": "ٱلْخَآئِضِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡخ<rule class=madda_obligatory_mottasel>َا</rule>ٓئِض<rule class=madda_permissible>ِي</rule>نَ", "en": "the vain talkers", "tr": "l-khāiḍīna", "audio": "wbw/074_045_004.mp3"}, {"type": "end", "num": "٤٥"}]}, {"id": 46, "key": "74:46", "juz": 29, "page": 576, "side_trans": "And we used to deny the Day of Recompense", "words": [{"type": "word", "ar": "وَكُنَّا", "tajweed": "وَكُ<rule class=ghunnah>نّ</rule>َا", "en": "And we used to", "tr": "wakunnā", "audio": "wbw/074_046_001.mp3"}, {"type": "word", "ar": "نُكَذِّبُ", "tajweed": "نُكَذِّبُ", "en": "deny", "tr": "nukadhibu", "audio": "wbw/074_046_002.mp3"}, {"type": "word", "ar": "بِيَوْمِ", "tajweed": "بِيَوۡمِ", "en": "(the) Day", "tr": "biyawmi", "audio": "wbw/074_046_003.mp3"}, {"type": "word", "ar": "ٱلدِّينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دّ<rule class=madda_permissible>ِي</rule>نِ", "en": "(of) the Judgment", "tr": "l-dīni", "audio": "wbw/074_046_004.mp3"}, {"type": "end", "num": "٤٦"}]}, {"id": 47, "key": "74:47", "juz": 29, "page": 576, "side_trans": "Until there came to us the certainty [i.e., death].\"", "words": [{"type": "word", "ar": "حَتَّىٰٓ", "tajweed": "حَتَّ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "Until", "tr": "ḥattā", "audio": "wbw/074_047_001.mp3"}, {"type": "word", "ar": "أَتَىٰنَا", "tajweed": "أَتَ<rule class=madda_normal>ـٰ</rule>نَا", "en": "came to us", "tr": "atānā", "audio": "wbw/074_047_002.mp3"}, {"type": "word", "ar": "ٱلْيَقِينُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَق<rule class=madda_permissible>ِي</rule>نُ", "en": "the certainty", "tr": "l-yaqīnu", "audio": "wbw/074_047_003.mp3"}, {"type": "end", "num": "٤٧"}]}, {"id": 48, "key": "74:48", "juz": 29, "page": 577, "side_trans": "So there will not benefit them the intercession of [any] intercessors.", "words": [{"type": "word", "ar": "فَمَا", "tajweed": "فَمَا", "en": "Then not", "tr": "famā", "audio": "wbw/074_048_001.mp3"}, {"type": "word", "ar": "تَنفَعُهُمْ", "tajweed": "تَ<rule class=ikhafa>نف</rule>َعُهُمۡ", "en": "will benefit them", "tr": "tanfaʿuhum", "audio": "wbw/074_048_002.mp3"}, {"type": "word", "ar": "شَفَـٰعَةُ", "tajweed": "شَفَ<rule class=madda_normal>ـٰ</rule>عَةُ", "en": "intercession", "tr": "shafāʿatu", "audio": "wbw/074_048_003.mp3"}, {"type": "word", "ar": "ٱلشَّـٰفِعِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شَّ<rule class=madda_normal>ـٰ</rule>فِع<rule class=madda_permissible>ِي</rule>نَ", "en": "(of) the intercessors", "tr": "l-shāfiʿīna", "audio": "wbw/074_048_004.mp3"}, {"type": "end", "num": "٤٨"}]}, {"id": 49, "key": "74:49", "juz": 29, "page": 577, "side_trans": "Then what is [the matter] with them that they are, from the reminder, turning away.", "words": [{"type": "word", "ar": "فَمَا", "tajweed": "فَمَا", "en": "Then what", "tr": "famā", "audio": "wbw/074_049_001.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "(is) for them", "tr": "lahum", "audio": "wbw/074_049_002.mp3"}, {"type": "word", "ar": "عَنِ", "tajweed": "عَنِ", "en": "(that) from", "tr": "ʿani", "audio": "wbw/074_049_003.mp3"}, {"type": "word", "ar": "ٱلتَّذْكِرَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>تَّذۡكِرَةِ", "en": "the Reminder", "tr": "l-tadhkirati", "audio": "wbw/074_049_004.mp3"}, {"type": "word", "ar": "مُعْرِضِينَ", "tajweed": "مُعۡرِض<rule class=madda_permissible>ِي</rule>نَ", "en": "they (are) turning away", "tr": "muʿ'riḍīna", "audio": "wbw/074_049_005.mp3"}, {"type": "end", "num": "٤٩"}]}, {"id": 50, "key": "74:50", "juz": 29, "page": 577, "side_trans": "As if they were alarmed donkeys.", "words": [{"type": "word", "ar": "كَأَنَّهُمْ", "tajweed": "كَأَ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "As if they (were)", "tr": "ka-annahum", "audio": "wbw/074_050_001.mp3"}, {"type": "word", "ar": "حُمُرٌۭ", "tajweed": "حُمُ<rule class=idgham_ghunnah>رٌ</rule>", "en": "donkeys", "tr": "ḥumurun", "audio": "wbw/074_050_002.mp3"}, {"type": "word", "ar": "مُّسْتَنفِرَةٌۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّسۡتَ<rule class=ikhafa>نف</rule>ِرَةٌ", "en": "frightened", "tr": "mus'tanfiratun", "audio": "wbw/074_050_003.mp3"}, {"type": "end", "num": "٥٠"}]}, {"id": 51, "key": "74:51", "juz": 29, "page": 577, "side_trans": "Fleeing from a lion?", "words": [{"type": "word", "ar": "فَرَّتْ", "tajweed": "فَرَّتۡ", "en": "Fleeing", "tr": "farrat", "audio": "wbw/074_051_001.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/074_051_002.mp3"}, {"type": "word", "ar": "قَسْوَرَةٍۭ", "tajweed": "<rule class=ikhafa>ق</rule>َسۡوَرَةِۭ", "en": "a lion", "tr": "qaswaratin", "audio": "wbw/074_051_003.mp3"}, {"type": "end", "num": "٥١"}]}, {"id": 52, "key": "74:52", "juz": 29, "page": 577, "side_trans": "Rather, every person among them desires that he would be given scriptures spread about.", "words": [{"type": "word", "ar": "بَلْ", "tajweed": "بَلۡ", "en": "Nay", "tr": "bal", "audio": "wbw/074_052_001.mp3"}, {"type": "word", "ar": "يُرِيدُ", "tajweed": "يُرِيدُ", "en": "Desires", "tr": "yurīdu", "audio": "wbw/074_052_002.mp3"}, {"type": "word", "ar": "كُلُّ", "tajweed": "كُلُّ", "en": "every", "tr": "kullu", "audio": "wbw/074_052_003.mp3"}, {"type": "word", "ar": "ٱمْرِئٍۢ", "tajweed": "<rule class=ham_wasl>ٱ</rule>مۡرِى<rule class=idgham_ghunnah>ٍٕ</rule>", "en": "person", "tr": "im'ri-in", "audio": "wbw/074_052_004.mp3"}, {"type": "word", "ar": "مِّنْهُمْ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنۡهُمۡ", "en": "of them", "tr": "min'hum", "audio": "wbw/074_052_005.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/074_052_006.mp3"}, {"type": "word", "ar": "يُؤْتَىٰ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُؤۡتَىٰ", "en": "he may be given", "tr": "yu'tā", "audio": "wbw/074_052_007.mp3"}, {"type": "word", "ar": "صُحُفًۭا", "tajweed": "صُحُ<rule class=idgham_ghunnah>فًا</rule>", "en": "pages", "tr": "ṣuḥufan", "audio": "wbw/074_052_008.mp3"}, {"type": "word", "ar": "مُّنَشَّرَةًۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّنَشَّرَةً", "en": "spread out", "tr": "munasharatan", "audio": "wbw/074_052_009.mp3"}, {"type": "end", "num": "٥٢"}]}, {"id": 53, "key": "74:53", "juz": 29, "page": 577, "side_trans": "No! But they do not fear the Hereafter.", "words": [{"type": "word", "ar": "كَلَّا ۖ", "tajweed": "كَلَّا‌ۖ", "en": "Nay", "tr": "kallā", "audio": "wbw/074_053_001.mp3"}, {"type": "word", "ar": "بَل", "tajweed": "بَل", "en": "But", "tr": "bal", "audio": "wbw/074_053_003.mp3"}, {"type": "word", "ar": "لَّا", "tajweed": "لَّا", "en": "not", "tr": "lā", "audio": "wbw/074_053_004.mp3"}, {"type": "word", "ar": "يَخَافُونَ", "tajweed": "يَخَافُونَ", "en": "they fear", "tr": "yakhāfūna", "audio": "wbw/074_053_005.mp3"}, {"type": "word", "ar": "ٱلْـَٔاخِرَةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَخِرَةَ", "en": "the Hereafter", "tr": "l-ākhirata", "audio": "wbw/074_053_006.mp3"}, {"type": "end", "num": "٥٣"}]}, {"id": 54, "key": "74:54", "juz": 29, "page": 577, "side_trans": "No! Indeed, it [i.e., the Qur’ān] is a reminder.", "words": [{"type": "word", "ar": "كَلَّآ", "tajweed": "كَلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Nay", "tr": "kallā", "audio": "wbw/074_054_001.mp3"}, {"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, it", "tr": "innahu", "audio": "wbw/074_054_002.mp3"}, {"type": "word", "ar": "تَذْكِرَةٌۭ", "tajweed": "تَذۡكِرَةٌ", "en": "(is) a Reminder", "tr": "tadhkiratun", "audio": "wbw/074_054_003.mp3"}, {"type": "end", "num": "٥٤"}]}, {"id": 55, "key": "74:55", "juz": 29, "page": 577, "side_trans": "Then whoever wills will remember it.", "words": [{"type": "word", "ar": "فَمَن", "tajweed": "فَمَ<rule class=ikhafa>ن</rule>", "en": "So whoever", "tr": "faman", "audio": "wbw/074_055_001.mp3"}, {"type": "word", "ar": "شَآءَ", "tajweed": "<rule class=ikhafa>ش</rule><rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "wills", "tr": "shāa", "audio": "wbw/074_055_002.mp3"}, {"type": "word", "ar": "ذَكَرَهُۥ", "tajweed": "ذَكَرَهُۥ", "en": "(may) pay heed to it", "tr": "dhakarahu", "audio": "wbw/074_055_003.mp3"}, {"type": "end", "num": "٥٥"}]}, {"id": 56, "key": "74:56", "juz": 29, "page": 577, "side_trans": "And they will not remember except that Allāh wills. He is worthy of fear and adequate for [granting] forgiveness.", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/074_056_001.mp3"}, {"type": "word", "ar": "يَذْكُرُونَ", "tajweed": "يَذۡكُرُونَ", "en": "will pay heed", "tr": "yadhkurūna", "audio": "wbw/074_056_002.mp3"}, {"type": "word", "ar": "إِلَّآ", "tajweed": "إِلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "except", "tr": "illā", "audio": "wbw/074_056_003.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/074_056_004.mp3"}, {"type": "word", "ar": "يَشَآءَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َش<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "wills", "tr": "yashāa", "audio": "wbw/074_056_005.mp3"}, {"type": "word", "ar": "ٱللَّهُ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ‌ۚ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/074_056_006.mp3"}, {"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "He", "tr": "huwa", "audio": "wbw/074_056_008.mp3"}, {"type": "word", "ar": "أَهْلُ", "tajweed": "أَهۡلُ", "en": "(is) worthy", "tr": "ahlu", "audio": "wbw/074_056_009.mp3"}, {"type": "word", "ar": "ٱلتَّقْوَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>تَّ<rule class=qalaqah>قۡ</rule>وَىٰ", "en": "to be feared", "tr": "l-taqwā", "audio": "wbw/074_056_010.mp3"}, {"type": "word", "ar": "وَأَهْلُ", "tajweed": "وَأَهۡلُ", "en": "and worthy", "tr": "wa-ahlu", "audio": "wbw/074_056_011.mp3"}, {"type": "word", "ar": "ٱلْمَغْفِرَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَغۡفِرَةِ", "en": "to forgive", "tr": "l-maghfirati", "audio": "wbw/074_056_012.mp3"}, {"type": "end", "num": "٥٦"}]}]