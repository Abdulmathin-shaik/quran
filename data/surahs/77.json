[{"id": 1, "key": "77:1", "juz": 29, "page": 580, "side_trans": "By those [winds] sent forth in gusts", "words": [{"type": "word", "ar": "وَٱلْمُرْسَلَـٰتِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمُرۡسَلَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "By the ones sent forth", "tr": "wal-mur'salāti", "audio": "wbw/077_001_001.mp3"}, {"type": "word", "ar": "عُرْفًۭا", "tajweed": "عُرۡفًا", "en": "one after another", "tr": "ʿur'fan", "audio": "wbw/077_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "77:2", "juz": 29, "page": 580, "side_trans": "And the winds that blow violently", "words": [{"type": "word", "ar": "فَٱلْعَـٰصِفَـٰتِ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>لۡعَ<rule class=madda_normal>ـٰ</rule>صِفَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "And the winds that blow", "tr": "fal-ʿāṣifāti", "audio": "wbw/077_002_001.mp3"}, {"type": "word", "ar": "عَصْفًۭا", "tajweed": "عَصۡفًا", "en": "violently", "tr": "ʿaṣfan", "audio": "wbw/077_002_002.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "77:3", "juz": 29, "page": 580, "side_trans": "And [by] the winds that spread [clouds]", "words": [{"type": "word", "ar": "وَٱلنَّـٰشِرَٰتِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule>شِر<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِ", "en": "And the ones that scatter", "tr": "wal-nāshirāti", "audio": "wbw/077_003_001.mp3"}, {"type": "word", "ar": "نَشْرًۭا", "tajweed": "نَشۡرًا", "en": "far and wide", "tr": "nashran", "audio": "wbw/077_003_002.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "77:4", "juz": 29, "page": 580, "side_trans": "And those [angels] who bring criterion", "words": [{"type": "word", "ar": "فَٱلْفَـٰرِقَـٰتِ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>لۡفَ<rule class=madda_normal>ـٰ</rule>رِقَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "And those who separate", "tr": "fal-fāriqāti", "audio": "wbw/077_004_001.mp3"}, {"type": "word", "ar": "فَرْقًۭا", "tajweed": "فَرۡقًا", "en": "(by the) Criterion", "tr": "farqan", "audio": "wbw/077_004_002.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "77:5", "juz": 29, "page": 580, "side_trans": "And those [angels] who deliver a message.", "words": [{"type": "word", "ar": "فَٱلْمُلْقِيَـٰتِ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>لۡمُلۡقِيَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "And those who bring down", "tr": "fal-mul'qiyāti", "audio": "wbw/077_005_001.mp3"}, {"type": "word", "ar": "ذِكْرًا", "tajweed": "ذِكۡرًا", "en": "(the) Reminder", "tr": "dhik'ran", "audio": "wbw/077_005_002.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "77:6", "juz": 29, "page": 580, "side_trans": "As justification or warning,", "words": [{"type": "word", "ar": "عُذْرًا", "tajweed": "عُذۡرًا", "en": "(As) justification", "tr": "ʿudh'ran", "audio": "wbw/077_006_001.mp3"}, {"type": "word", "ar": "أَوْ", "tajweed": "أَوۡ", "en": "or", "tr": "aw", "audio": "wbw/077_006_002.mp3"}, {"type": "word", "ar": "نُذْرًا", "tajweed": "نُذۡرًا", "en": "warning", "tr": "nudh'ran", "audio": "wbw/077_006_003.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "77:7", "juz": 29, "page": 580, "side_trans": "Indeed, what you are promised is to occur.", "words": [{"type": "word", "ar": "إِنَّمَا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َمَا", "en": "Indeed, what", "tr": "innamā", "audio": "wbw/077_007_001.mp3"}, {"type": "word", "ar": "تُوعَدُونَ", "tajweed": "تُوعَدُونَ", "en": "you are promised", "tr": "tūʿadūna", "audio": "wbw/077_007_002.mp3"}, {"type": "word", "ar": "لَوَٰقِعٌۭ", "tajweed": "لَو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>قِعٌ", "en": "will surely occur", "tr": "lawāqiʿun", "audio": "wbw/077_007_003.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "77:8", "juz": 29, "page": 580, "side_trans": "So when the stars are obliterated", "words": [{"type": "word", "ar": "فَإِذَا", "tajweed": "فَإِذَا", "en": "So when", "tr": "fa-idhā", "audio": "wbw/077_008_001.mp3"}, {"type": "word", "ar": "ٱلنُّجُومُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>ُجُومُ", "en": "the stars", "tr": "l-nujūmu", "audio": "wbw/077_008_002.mp3"}, {"type": "word", "ar": "طُمِسَتْ", "tajweed": "طُمِسَتۡ", "en": "are obliterated", "tr": "ṭumisat", "audio": "wbw/077_008_003.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "77:9", "juz": 29, "page": 580, "side_trans": "And when the heaven is opened", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/077_009_001.mp3"}, {"type": "word", "ar": "ٱلسَّمَآءُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ", "en": "the heaven", "tr": "l-samāu", "audio": "wbw/077_009_002.mp3"}, {"type": "word", "ar": "فُرِجَتْ", "tajweed": "فُرِجَتۡ", "en": "is cleft asunder", "tr": "furijat", "audio": "wbw/077_009_003.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "77:10", "juz": 29, "page": 580, "side_trans": "And when the mountains are blown away", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/077_010_001.mp3"}, {"type": "word", "ar": "ٱلْجِبَالُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجِبَالُ", "en": "the mountains", "tr": "l-jibālu", "audio": "wbw/077_010_002.mp3"}, {"type": "word", "ar": "نُسِفَتْ", "tajweed": "نُسِفَتۡ", "en": "are blown away", "tr": "nusifat", "audio": "wbw/077_010_003.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "77:11", "juz": 29, "page": 580, "side_trans": "And when the messengers' time has come...", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/077_011_001.mp3"}, {"type": "word", "ar": "ٱلرُّسُلُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رُّسُلُ", "en": "the Messengers", "tr": "l-rusulu", "audio": "wbw/077_011_002.mp3"}, {"type": "word", "ar": "أُقِّتَتْ", "tajweed": "أُقِّتَتۡ", "en": "are gathered to their appointed time", "tr": "uqqitat", "audio": "wbw/077_011_003.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "77:12", "juz": 29, "page": 580, "side_trans": "For what Day was it postponed?", "words": [{"type": "word", "ar": "لِأَىِّ", "tajweed": "لِأَىِّ", "en": "For what", "tr": "li-ayyi", "audio": "wbw/077_012_001.mp3"}, {"type": "word", "ar": "يَوْمٍ", "tajweed": "يَوۡمٍ", "en": "Day", "tr": "yawmin", "audio": "wbw/077_012_002.mp3"}, {"type": "word", "ar": "أُجِّلَتْ", "tajweed": "أُجِّلَتۡ", "en": "are (these) postponed", "tr": "ujjilat", "audio": "wbw/077_012_003.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "77:13", "juz": 29, "page": 580, "side_trans": "For the Day of Judgement.", "words": [{"type": "word", "ar": "لِيَوْمِ", "tajweed": "لِيَوۡمِ", "en": "For (the) Day", "tr": "liyawmi", "audio": "wbw/077_013_001.mp3"}, {"type": "word", "ar": "ٱلْفَصْلِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَصۡلِ", "en": "(of) Judgment", "tr": "l-faṣli", "audio": "wbw/077_013_002.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "77:14", "juz": 29, "page": 580, "side_trans": "And what can make you know what is the Day of Judgement?", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And what", "tr": "wamā", "audio": "wbw/077_014_001.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "will make you know", "tr": "adrāka", "audio": "wbw/077_014_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/077_014_003.mp3"}, {"type": "word", "ar": "يَوْمُ", "tajweed": "يَوۡمُ", "en": "(is the) Day", "tr": "yawmu", "audio": "wbw/077_014_004.mp3"}, {"type": "word", "ar": "ٱلْفَصْلِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَصۡلِ", "en": "(of) the Judgment", "tr": "l-faṣli", "audio": "wbw/077_014_005.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "77:15", "juz": 29, "page": 580, "side_trans": "Woe, that Day, to the deniers.", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/077_015_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/077_015_002.mp3"}, {"type": "word", "ar": "لِّلْمُكَذِّبِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُكَذِّب<rule class=madda_permissible>ِي</rule>نَ", "en": "to the deniers", "tr": "lil'mukadhibīna", "audio": "wbw/077_015_003.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "77:16", "juz": 29, "page": 580, "side_trans": "Did We not destroy the former peoples?", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Did not", "tr": "alam", "audio": "wbw/077_016_001.mp3"}, {"type": "word", "ar": "نُهْلِكِ", "tajweed": "نُهۡلِكِ", "en": "We destroy", "tr": "nuh'liki", "audio": "wbw/077_016_002.mp3"}, {"type": "word", "ar": "ٱلْأَوَّلِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَوَّل<rule class=madda_permissible>ِي</rule>نَ", "en": "the former (people)", "tr": "l-awalīna", "audio": "wbw/077_016_003.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "77:17", "juz": 29, "page": 580, "side_trans": "Then We will follow them with the later ones.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/077_017_001.mp3"}, {"type": "word", "ar": "نُتْبِعُهُمُ", "tajweed": "نُتۡبِعُهُمُ", "en": "We follow them up", "tr": "nut'biʿuhumu", "audio": "wbw/077_017_002.mp3"}, {"type": "word", "ar": "ٱلْـَٔاخِرِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَخِر<rule class=madda_permissible>ِي</rule>نَ", "en": "(with) the later ones", "tr": "l-ākhirīna", "audio": "wbw/077_017_003.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "77:18", "juz": 29, "page": 580, "side_trans": "Thus do We deal with the criminals.", "words": [{"type": "word", "ar": "كَذَٰلِكَ", "tajweed": "كَذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "Thus", "tr": "kadhālika", "audio": "wbw/077_018_001.mp3"}, {"type": "word", "ar": "نَفْعَلُ", "tajweed": "نَفۡعَلُ", "en": "We deal", "tr": "nafʿalu", "audio": "wbw/077_018_002.mp3"}, {"type": "word", "ar": "بِٱلْمُجْرِمِينَ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡمُ<rule class=qalaqah>جۡ</rule>رِم<rule class=madda_permissible>ِي</rule>نَ", "en": "with the criminals", "tr": "bil-muj'rimīna", "audio": "wbw/077_018_003.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "77:19", "juz": 29, "page": 580, "side_trans": "Woe, that Day, to the deniers.", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/077_019_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/077_019_002.mp3"}, {"type": "word", "ar": "لِّلْمُكَذِّبِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُكَذِّب<rule class=madda_permissible>ِي</rule>نَ", "en": "to the deniers", "tr": "lil'mukadhibīna", "audio": "wbw/077_019_003.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "77:20", "juz": 29, "page": 581, "side_trans": "Did We not create you from a liquid disdained?", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Did not", "tr": "alam", "audio": "wbw/077_020_001.mp3"}, {"type": "word", "ar": "نَخْلُقكُّم", "tajweed": "نَخۡلُ<rule class=idgham_mutaqaribayn>ق</rule>كّ<rule class=idgham_shafawi>ُم</rule>", "en": "We create you", "tr": "nakhluqkkum", "audio": "wbw/077_020_002.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_shafawi>م</rule>ّ<rule class=idgham_ghunnah>ِن</rule>", "en": "from", "tr": "min", "audio": "wbw/077_020_003.mp3"}, {"type": "word", "ar": "مَّآءٍۢ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ّ<rule class=madda_obligatory_mottasel>َا</rule>ٓ<rule class=idgham_ghunnah>ءٍ</rule>", "en": "a water", "tr": "māin", "audio": "wbw/077_020_004.mp3"}, {"type": "word", "ar": "مَّهِينٍۢ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّه<rule class=madda_permissible>ِي</rule>نٍ", "en": "despicable", "tr": "mahīnin", "audio": "wbw/077_020_005.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "77:21", "juz": 29, "page": 581, "side_trans": "And We placed it in a firm lodging [i.e., the womb]", "words": [{"type": "word", "ar": "فَجَعَلْنَـٰهُ", "tajweed": "فَجَعَلۡنَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "Then We placed it", "tr": "fajaʿalnāhu", "audio": "wbw/077_021_001.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/077_021_002.mp3"}, {"type": "word", "ar": "قَرَارٍۢ", "tajweed": "قَرَا<rule class=idgham_ghunnah>رٍ</rule>", "en": "an abode", "tr": "qarārin", "audio": "wbw/077_021_003.mp3"}, {"type": "word", "ar": "مَّكِينٍ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّك<rule class=madda_permissible>ِي</rule>نٍ", "en": "safe", "tr": "makīnin", "audio": "wbw/077_021_004.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "77:22", "juz": 29, "page": 581, "side_trans": "For a known extent.", "words": [{"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "For", "tr": "ilā", "audio": "wbw/077_022_001.mp3"}, {"type": "word", "ar": "قَدَرٍۢ", "tajweed": "قَدَ<rule class=idgham_ghunnah>رٍ</rule>", "en": "a period", "tr": "qadarin", "audio": "wbw/077_022_002.mp3"}, {"type": "word", "ar": "مَّعْلُومٍۢ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّعۡل<rule class=madda_permissible>ُو</rule>مٍ", "en": "known", "tr": "maʿlūmin", "audio": "wbw/077_022_003.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "77:23", "juz": 29, "page": 581, "side_trans": "And We determined [it], and excellent [are We] to determine.", "words": [{"type": "word", "ar": "فَقَدَرْنَا", "tajweed": "فَقَدَرۡنَا", "en": "So We measured", "tr": "faqadarnā", "audio": "wbw/077_023_001.mp3"}, {"type": "word", "ar": "فَنِعْمَ", "tajweed": "فَنِعۡمَ", "en": "and Best", "tr": "faniʿ'ma", "audio": "wbw/077_023_002.mp3"}, {"type": "word", "ar": "ٱلْقَـٰدِرُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَ<rule class=madda_normal>ـٰ</rule>دِر<rule class=madda_permissible>ُو</rule>نَ", "en": "(are We to) measure", "tr": "l-qādirūna", "audio": "wbw/077_023_003.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "77:24", "juz": 29, "page": 581, "side_trans": "Woe, that Day, to the deniers.", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/077_024_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/077_024_002.mp3"}, {"type": "word", "ar": "لِّلْمُكَذِّبِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُكَذِّب<rule class=madda_permissible>ِي</rule>نَ", "en": "to the deniers", "tr": "lil'mukadhibīna", "audio": "wbw/077_024_003.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "77:25", "juz": 29, "page": 581, "side_trans": "Have We not made the earth a container", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Have not", "tr": "alam", "audio": "wbw/077_025_001.mp3"}, {"type": "word", "ar": "نَجْعَلِ", "tajweed": "نَ<rule class=qalaqah>جۡ</rule>عَلِ", "en": "We made", "tr": "najʿali", "audio": "wbw/077_025_002.mp3"}, {"type": "word", "ar": "ٱلْأَرْضَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضَ", "en": "the earth", "tr": "l-arḍa", "audio": "wbw/077_025_003.mp3"}, {"type": "word", "ar": "كِفَاتًا", "tajweed": "كِفَاتًا", "en": "a receptacle", "tr": "kifātan", "audio": "wbw/077_025_004.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "77:26", "juz": 29, "page": 581, "side_trans": "Of the living and the dead?", "words": [{"type": "word", "ar": "أَحْيَآءًۭ", "tajweed": "أَحۡي<rule class=madda_obligatory_mottasel>َا</rule>ٓ<rule class=idgham_ghunnah>ءً</rule>", "en": "(For the) living", "tr": "aḥyāan", "audio": "wbw/077_026_001.mp3"}, {"type": "word", "ar": "وَأَمْوَٰتًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َأَمۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تًا", "en": "and (the) dead", "tr": "wa-amwātan", "audio": "wbw/077_026_002.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "77:27", "juz": 29, "page": 581, "side_trans": "And We placed therein lofty, firmly set mountains and have given you to drink sweet water.", "words": [{"type": "word", "ar": "وَجَعَلْنَا", "tajweed": "وَجَعَلۡنَا", "en": "And We made", "tr": "wajaʿalnā", "audio": "wbw/077_027_001.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/077_027_002.mp3"}, {"type": "word", "ar": "رَوَٰسِىَ", "tajweed": "رَو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>سِىَ", "en": "firmly set mountains", "tr": "rawāsiya", "audio": "wbw/077_027_003.mp3"}, {"type": "word", "ar": "شَـٰمِخَـٰتٍۢ", "tajweed": "شَ<rule class=madda_normal>ـٰ</rule>مِخَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>تٍ</rule>", "en": "lofty", "tr": "shāmikhātin", "audio": "wbw/077_027_004.mp3"}, {"type": "word", "ar": "وَأَسْقَيْنَـٰكُم", "tajweed": "<rule class=idgham_ghunnah>و</rule>َأَسۡقَيۡنَ<rule class=madda_normal>ـٰ</rule>ك<rule class=idgham_shafawi>ُم</rule>", "en": "and We gave you to drink", "tr": "wa-asqaynākum", "audio": "wbw/077_027_005.mp3"}, {"type": "word", "ar": "مَّآءًۭ", "tajweed": "<rule class=idgham_shafawi>م</rule>ّ<rule class=madda_obligatory_mottasel>َا</rule>ٓ<rule class=ikhafa>ءً</rule>", "en": "water ", "tr": "māan", "audio": "wbw/077_027_006.mp3"}, {"type": "word", "ar": "فُرَاتًۭا", "tajweed": "<rule class=ikhafa>ف</rule>ُرَاتًا", "en": "sweet", "tr": "furātan", "audio": "wbw/077_027_007.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "77:28", "juz": 29, "page": 581, "side_trans": "Woe, that Day, to the deniers.", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/077_028_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/077_028_002.mp3"}, {"type": "word", "ar": "لِّلْمُكَذِّبِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُكَذِّب<rule class=madda_permissible>ِي</rule>نَ", "en": "to the deniers", "tr": "lil'mukadhibīna", "audio": "wbw/077_028_003.mp3"}, {"type": "end", "num": "٢٨"}]}, {"id": 29, "key": "77:29", "juz": 29, "page": 581, "side_trans": "[They will be told], \"Proceed to that which you used to deny.", "words": [{"type": "word", "ar": "ٱنطَلِقُوٓا۟", "tajweed": "ٱ<rule class=ikhafa>نط</rule>َلِق<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "Proceed", "tr": "inṭaliqū", "audio": "wbw/077_029_001.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/077_029_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/077_029_003.mp3"}, {"type": "word", "ar": "كُنتُم", "tajweed": "كُ<rule class=ikhafa>نت</rule><rule class=ikhafa_shafawi>ُم</rule>", "en": "you used to", "tr": "kuntum", "audio": "wbw/077_029_004.mp3"}, {"type": "word", "ar": "بِهِۦ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِه<rule class=madda_normal>ِۦ</rule>", "en": "in it", "tr": "bihi", "audio": "wbw/077_029_005.mp3"}, {"type": "word", "ar": "تُكَذِّبُونَ", "tajweed": "تُكَذِّب<rule class=madda_permissible>ُو</rule>نَ", "en": "deny", "tr": "tukadhibūna", "audio": "wbw/077_029_006.mp3"}, {"type": "end", "num": "٢٩"}]}, {"id": 30, "key": "77:30", "juz": 29, "page": 581, "side_trans": "Proceed to a shadow [of smoke] having three columns.", "words": [{"type": "word", "ar": "ٱنطَلِقُوٓا۟", "tajweed": "ٱ<rule class=ikhafa>نط</rule>َلِق<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "Proceed", "tr": "inṭaliqū", "audio": "wbw/077_030_001.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/077_030_002.mp3"}, {"type": "word", "ar": "ظِلٍّۢ", "tajweed": "ظِ<rule class=ikhafa>لٍّ</rule>", "en": "a shadow", "tr": "ẓillin", "audio": "wbw/077_030_003.mp3"}, {"type": "word", "ar": "ذِى", "tajweed": "<rule class=ikhafa>ذ</rule>ِى", "en": "having", "tr": "dhī", "audio": "wbw/077_030_004.mp3"}, {"type": "word", "ar": "ثَلَـٰثِ", "tajweed": "ثَلَ<rule class=madda_normal>ـٰ</rule>ثِ", "en": "three", "tr": "thalāthi", "audio": "wbw/077_030_005.mp3"}, {"type": "word", "ar": "شُعَبٍۢ", "tajweed": "شُعَ<rule class=qalaqah>ب</rule>ٍ", "en": "columns", "tr": "shuʿabin", "audio": "wbw/077_030_006.mp3"}, {"type": "end", "num": "٣٠"}]}, {"id": 31, "key": "77:31", "juz": 29, "page": 581, "side_trans": "[But having] no cool shade and availing not against the flame.\"", "words": [{"type": "word", "ar": "لَّا", "tajweed": "لَّا", "en": "No", "tr": "lā", "audio": "wbw/077_031_001.mp3"}, {"type": "word", "ar": "ظَلِيلٍۢ", "tajweed": "ظَلِي<rule class=idgham_ghunnah>لٍ</rule>", "en": "cool shade", "tr": "ẓalīlin", "audio": "wbw/077_031_002.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "and not", "tr": "walā", "audio": "wbw/077_031_003.mp3"}, {"type": "word", "ar": "يُغْنِى", "tajweed": "يُغۡنِى", "en": "availing", "tr": "yugh'nī", "audio": "wbw/077_031_004.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "against", "tr": "mina", "audio": "wbw/077_031_005.mp3"}, {"type": "word", "ar": "ٱللَّهَبِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>لَّهَ<rule class=qalaqah>ب</rule>ِ", "en": "the flame", "tr": "l-lahabi", "audio": "wbw/077_031_006.mp3"}, {"type": "end", "num": "٣١"}]}, {"id": 32, "key": "77:32", "juz": 29, "page": 581, "side_trans": "Indeed, it throws sparks [as huge] as a fortress,", "words": [{"type": "word", "ar": "إِنَّهَا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهَا", "en": "Indeed, it", "tr": "innahā", "audio": "wbw/077_032_001.mp3"}, {"type": "word", "ar": "تَرْمِى", "tajweed": "تَرۡمِى", "en": "throws up", "tr": "tarmī", "audio": "wbw/077_032_002.mp3"}, {"type": "word", "ar": "بِشَرَرٍۢ", "tajweed": "بِشَرَ<rule class=ikhafa>رٍ</rule>", "en": "sparks", "tr": "bishararin", "audio": "wbw/077_032_003.mp3"}, {"type": "word", "ar": "كَٱلْقَصْرِ", "tajweed": "<rule class=ikhafa>ك</rule>َ<rule class=ham_wasl>ٱ</rule>لۡقَصۡرِ", "en": "as the fortress", "tr": "kal-qaṣri", "audio": "wbw/077_032_004.mp3"}, {"type": "end", "num": "٣٢"}]}, {"id": 33, "key": "77:33", "juz": 29, "page": 581, "side_trans": "As if they were yellowish [black] camels.", "words": [{"type": "word", "ar": "كَأَنَّهُۥ", "tajweed": "كَأَ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "As if they (were)", "tr": "ka-annahu", "audio": "wbw/077_033_001.mp3"}, {"type": "word", "ar": "جِمَـٰلَتٌۭ", "tajweed": "جِمَ<rule class=madda_normal>ـٰ</rule>لَ<rule class=ikhafa>تٌ</rule>", "en": "camels", "tr": "jimālatun", "audio": "wbw/077_033_002.mp3"}, {"type": "word", "ar": "صُفْرٌۭ", "tajweed": "<rule class=ikhafa>ص</rule>ُفۡرٌ", "en": "yellow", "tr": "ṣuf'run", "audio": "wbw/077_033_003.mp3"}, {"type": "end", "num": "٣٣"}]}, {"id": 34, "key": "77:34", "juz": 29, "page": 581, "side_trans": "Woe, that Day, to the deniers.", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/077_034_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/077_034_002.mp3"}, {"type": "word", "ar": "لِّلْمُكَذِّبِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُكَذِّب<rule class=madda_permissible>ِي</rule>نَ", "en": "to the deniers", "tr": "lil'mukadhibīna", "audio": "wbw/077_034_003.mp3"}, {"type": "end", "num": "٣٤"}]}, {"id": 35, "key": "77:35", "juz": 29, "page": 581, "side_trans": "This is a Day they will not speak,", "words": [{"type": "word", "ar": "هَـٰذَا", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>ذَا", "en": "This", "tr": "hādhā", "audio": "wbw/077_035_001.mp3"}, {"type": "word", "ar": "يَوْمُ", "tajweed": "يَوۡمُ", "en": "(is) a Day", "tr": "yawmu", "audio": "wbw/077_035_002.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/077_035_003.mp3"}, {"type": "word", "ar": "يَنطِقُونَ", "tajweed": "يَ<rule class=ikhafa>نط</rule>ِق<rule class=madda_permissible>ُو</rule>نَ", "en": "they will speak", "tr": "yanṭiqūna", "audio": "wbw/077_035_004.mp3"}, {"type": "end", "num": "٣٥"}]}, {"id": 36, "key": "77:36", "juz": 29, "page": 581, "side_trans": "Nor will it be permitted for them to make an excuse.", "words": [{"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "And not", "tr": "walā", "audio": "wbw/077_036_001.mp3"}, {"type": "word", "ar": "يُؤْذَنُ", "tajweed": "يُؤۡذَنُ", "en": "will it be permitted", "tr": "yu'dhanu", "audio": "wbw/077_036_002.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "for them", "tr": "lahum", "audio": "wbw/077_036_003.mp3"}, {"type": "word", "ar": "فَيَعْتَذِرُونَ", "tajweed": "فَيَعۡتَذِر<rule class=madda_permissible>ُو</rule>نَ", "en": "to make excuses", "tr": "fayaʿtadhirūna", "audio": "wbw/077_036_004.mp3"}, {"type": "end", "num": "٣٦"}]}, {"id": 37, "key": "77:37", "juz": 29, "page": 581, "side_trans": "Woe, that Day, to the deniers.", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/077_037_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/077_037_002.mp3"}, {"type": "word", "ar": "لِّلْمُكَذِّبِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُكَذِّب<rule class=madda_permissible>ِي</rule>نَ", "en": "to the deniers", "tr": "lil'mukadhibīna", "audio": "wbw/077_037_003.mp3"}, {"type": "end", "num": "٣٧"}]}, {"id": 38, "key": "77:38", "juz": 29, "page": 581, "side_trans": "This is the Day of Judgement; We will have assembled you and the former peoples.", "words": [{"type": "word", "ar": "هَـٰذَا", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>ذَا", "en": "This", "tr": "hādhā", "audio": "wbw/077_038_001.mp3"}, {"type": "word", "ar": "يَوْمُ", "tajweed": "يَوۡمُ", "en": "(is the) Day", "tr": "yawmu", "audio": "wbw/077_038_002.mp3"}, {"type": "word", "ar": "ٱلْفَصْلِ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَصۡلِ‌ۖ", "en": "(of) Judgment", "tr": "l-faṣli", "audio": "wbw/077_038_003.mp3"}, {"type": "word", "ar": "جَمَعْنَـٰكُمْ", "tajweed": "جَمَعۡنَ<rule class=madda_normal>ـٰ</rule>كُمۡ", "en": "We have gathered you", "tr": "jamaʿnākum", "audio": "wbw/077_038_005.mp3"}, {"type": "word", "ar": "وَٱلْأَوَّلِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأَوَّل<rule class=madda_permissible>ِي</rule>نَ", "en": "and the former (people)", "tr": "wal-awalīna", "audio": "wbw/077_038_006.mp3"}, {"type": "end", "num": "٣٨"}]}, {"id": 39, "key": "77:39", "juz": 29, "page": 581, "side_trans": "So if you have a plan, then plan against Me.", "words": [{"type": "word", "ar": "فَإِن", "tajweed": "فَإِ<rule class=ikhafa>ن</rule>", "en": "So if", "tr": "fa-in", "audio": "wbw/077_039_001.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "<rule class=ikhafa>ك</rule>َانَ", "en": "is", "tr": "kāna", "audio": "wbw/077_039_002.mp3"}, {"type": "word", "ar": "لَكُمْ", "tajweed": "لَكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/077_039_003.mp3"}, {"type": "word", "ar": "كَيْدٌۭ", "tajweed": "كَيۡ<rule class=ikhafa>دٌ</rule>", "en": "a plan", "tr": "kaydun", "audio": "wbw/077_039_004.mp3"}, {"type": "word", "ar": "فَكِيدُونِ", "tajweed": "<rule class=ikhafa>ف</rule>َكِيد<rule class=madda_permissible>ُو</rule>نِ", "en": "then plan against Me", "tr": "fakīdūni", "audio": "wbw/077_039_005.mp3"}, {"type": "end", "num": "٣٩"}]}, {"id": 40, "key": "77:40", "juz": 29, "page": 581, "side_trans": "Woe, that Day, to the deniers.", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/077_040_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/077_040_002.mp3"}, {"type": "word", "ar": "لِّلْمُكَذِّبِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُكَذِّب<rule class=madda_permissible>ِي</rule>نَ", "en": "to the deniers", "tr": "lil'mukadhibīna", "audio": "wbw/077_040_003.mp3"}, {"type": "end", "num": "٤٠"}]}, {"id": 41, "key": "77:41", "juz": 29, "page": 581, "side_trans": "Indeed, the righteous will be among shades and springs", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/077_041_001.mp3"}, {"type": "word", "ar": "ٱلْمُتَّقِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُتَّقِينَ", "en": "the righteous", "tr": "l-mutaqīna", "audio": "wbw/077_041_002.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(will be) in", "tr": "fī", "audio": "wbw/077_041_003.mp3"}, {"type": "word", "ar": "ظِلَـٰلٍۢ", "tajweed": "ظِلَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>لٍ</rule>", "en": "shades", "tr": "ẓilālin", "audio": "wbw/077_041_004.mp3"}, {"type": "word", "ar": "وَعُيُونٍۢ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َعُي<rule class=madda_permissible>ُو</rule>نٍ", "en": "and springs", "tr": "waʿuyūnin", "audio": "wbw/077_041_005.mp3"}, {"type": "end", "num": "٤١"}]}, {"id": 42, "key": "77:42", "juz": 29, "page": 581, "side_trans": "And fruits from whatever they desire,", "words": [{"type": "word", "ar": "وَفَوَٰكِهَ", "tajweed": "وَفَو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>كِهَ", "en": "And fruits", "tr": "wafawākiha", "audio": "wbw/077_042_001.mp3"}, {"type": "word", "ar": "مِمَّا", "tajweed": "مِ<rule class=ghunnah>مّ</rule>َا", "en": "from what", "tr": "mimmā", "audio": "wbw/077_042_002.mp3"}, {"type": "word", "ar": "يَشْتَهُونَ", "tajweed": "يَشۡتَه<rule class=madda_permissible>ُو</rule>نَ", "en": "they desire", "tr": "yashtahūna", "audio": "wbw/077_042_003.mp3"}, {"type": "end", "num": "٤٢"}]}, {"id": 43, "key": "77:43", "juz": 29, "page": 581, "side_trans": "[Being told], \"Eat and drink in satisfaction for what you used to do.\"", "words": [{"type": "word", "ar": "كُلُوا۟", "tajweed": "كُلُو<rule class=slnt>اۡ</rule>", "en": "Eat", "tr": "kulū", "audio": "wbw/077_043_001.mp3"}, {"type": "word", "ar": "وَٱشْرَبُوا۟", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>شۡرَبُو<rule class=slnt>اۡ</rule>", "en": "and drink", "tr": "wa-ish'rabū", "audio": "wbw/077_043_002.mp3"}, {"type": "word", "ar": "هَنِيٓـًٔۢا", "tajweed": "هَنِ<rule class=madda_obligatory_mottasel>يٓـ</rule>ـ<rule class=iqlab>ـَٔۢا</rule>", "en": "(in) satisfaction", "tr": "hanīan", "audio": "wbw/077_043_003.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "<rule class=iqlab>ب</rule>ِمَا", "en": "for what", "tr": "bimā", "audio": "wbw/077_043_004.mp3"}, {"type": "word", "ar": "كُنتُمْ", "tajweed": "كُ<rule class=ikhafa>نت</rule>ُمۡ", "en": "you used to", "tr": "kuntum", "audio": "wbw/077_043_005.mp3"}, {"type": "word", "ar": "تَعْمَلُونَ", "tajweed": "تَعۡمَل<rule class=madda_permissible>ُو</rule>نَ", "en": "do", "tr": "taʿmalūna", "audio": "wbw/077_043_006.mp3"}, {"type": "end", "num": "٤٣"}]}, {"id": 44, "key": "77:44", "juz": 29, "page": 581, "side_trans": "Indeed, We thus reward the doers of good.", "words": [{"type": "word", "ar": "إِنَّا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َا", "en": "Indeed, We", "tr": "innā", "audio": "wbw/077_044_001.mp3"}, {"type": "word", "ar": "كَذَٰلِكَ", "tajweed": "كَذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "thus", "tr": "kadhālika", "audio": "wbw/077_044_002.mp3"}, {"type": "word", "ar": "نَجْزِى", "tajweed": "نَ<rule class=qalaqah>جۡ</rule>زِى", "en": "reward", "tr": "najzī", "audio": "wbw/077_044_003.mp3"}, {"type": "word", "ar": "ٱلْمُحْسِنِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُحۡسِن<rule class=madda_permissible>ِي</rule>نَ", "en": "the good-doers", "tr": "l-muḥ'sinīna", "audio": "wbw/077_044_004.mp3"}, {"type": "end", "num": "٤٤"}]}, {"id": 45, "key": "77:45", "juz": 29, "page": 581, "side_trans": "Woe, that Day, to the deniers.", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/077_045_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/077_045_002.mp3"}, {"type": "word", "ar": "لِّلْمُكَذِّبِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُكَذِّب<rule class=madda_permissible>ِي</rule>نَ", "en": "to the deniers", "tr": "lil'mukadhibīna", "audio": "wbw/077_045_003.mp3"}, {"type": "end", "num": "٤٥"}]}, {"id": 46, "key": "77:46", "juz": 29, "page": 581, "side_trans": "[O disbelievers], eat and enjoy yourselves a little; indeed, you are criminals.", "words": [{"type": "word", "ar": "كُلُوا۟", "tajweed": "كُلُو<rule class=slnt>اۡ</rule>", "en": "Eat", "tr": "kulū", "audio": "wbw/077_046_001.mp3"}, {"type": "word", "ar": "وَتَمَتَّعُوا۟", "tajweed": "وَتَمَتَّعُو<rule class=slnt>اۡ</rule>", "en": "and enjoy yourselves", "tr": "watamattaʿū", "audio": "wbw/077_046_002.mp3"}, {"type": "word", "ar": "قَلِيلًا", "tajweed": "قَلِيلاً", "en": "a little", "tr": "qalīlan", "audio": "wbw/077_046_003.mp3"}, {"type": "word", "ar": "إِنَّكُم", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َك<rule class=idgham_shafawi>ُم</rule>", "en": "indeed, you", "tr": "innakum", "audio": "wbw/077_046_004.mp3"}, {"type": "word", "ar": "مُّجْرِمُونَ", "tajweed": "<rule class=idgham_shafawi>م</rule>ُّ<rule class=qalaqah>جۡ</rule>رِم<rule class=madda_permissible>ُو</rule>نَ", "en": "(are) criminals", "tr": "muj'rimūna", "audio": "wbw/077_046_005.mp3"}, {"type": "end", "num": "٤٦"}]}, {"id": 47, "key": "77:47", "juz": 29, "page": 581, "side_trans": "Woe, that Day, to the deniers.", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/077_047_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/077_047_002.mp3"}, {"type": "word", "ar": "لِّلْمُكَذِّبِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُكَذِّب<rule class=madda_permissible>ِي</rule>نَ", "en": "to the deniers", "tr": "lil'mukadhibīna", "audio": "wbw/077_047_003.mp3"}, {"type": "end", "num": "٤٧"}]}, {"id": 48, "key": "77:48", "juz": 29, "page": 581, "side_trans": "And when it is said to them, \"Bow [in prayer],\" they do not bow.", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/077_048_001.mp3"}, {"type": "word", "ar": "قِيلَ", "tajweed": "قِيلَ", "en": "it is said", "tr": "qīla", "audio": "wbw/077_048_002.mp3"}, {"type": "word", "ar": "لَهُمُ", "tajweed": "لَهُمُ", "en": "to them", "tr": "lahumu", "audio": "wbw/077_048_003.mp3"}, {"type": "word", "ar": "ٱرْكَعُوا۟", "tajweed": "<rule class=ham_wasl>ٱ</rule>رۡكَعُو<rule class=slnt>اۡ</rule>", "en": "Bow", "tr": "ir'kaʿū", "audio": "wbw/077_048_004.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/077_048_005.mp3"}, {"type": "word", "ar": "يَرْكَعُونَ", "tajweed": "يَرۡكَع<rule class=madda_permissible>ُو</rule>نَ", "en": "they bow", "tr": "yarkaʿūna", "audio": "wbw/077_048_006.mp3"}, {"type": "end", "num": "٤٨"}]}, {"id": 49, "key": "77:49", "juz": 29, "page": 581, "side_trans": "Woe, that Day, to the deniers.", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/077_049_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/077_049_002.mp3"}, {"type": "word", "ar": "لِّلْمُكَذِّبِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُكَذِّب<rule class=madda_permissible>ِي</rule>نَ", "en": "to the deniers", "tr": "lil'mukadhibīna", "audio": "wbw/077_049_003.mp3"}, {"type": "end", "num": "٤٩"}]}, {"id": 50, "key": "77:50", "juz": 29, "page": 581, "side_trans": "Then in what statement after it [i.e., the Qur’ān] will they believe?", "words": [{"type": "word", "ar": "فَبِأَىِّ", "tajweed": "فَبِأَىِّ", "en": "Then in what", "tr": "fabi-ayyi", "audio": "wbw/077_050_001.mp3"}, {"type": "word", "ar": "حَدِيثٍۭ", "tajweed": "حَدِي<rule class=iqlab>ثِۭ</rule>", "en": "statement", "tr": "ḥadīthin", "audio": "wbw/077_050_002.mp3"}, {"type": "word", "ar": "بَعْدَهُۥ", "tajweed": "<rule class=iqlab>ب</rule>َعۡدَهُ<rule class=madda_normal>ۥ</rule>", "en": "after it", "tr": "baʿdahu", "audio": "wbw/077_050_003.mp3"}, {"type": "word", "ar": "يُؤْمِنُونَ", "tajweed": "يُؤۡمِن<rule class=madda_permissible>ُو</rule>نَ", "en": "will they believe", "tr": "yu'minūna", "audio": "wbw/077_050_004.mp3"}, {"type": "end", "num": "٥٠"}]}]