[{"id": 1, "key": "72:1", "juz": 29, "page": 572, "side_trans": "Say, [O Muḥammad], \"It has been revealed to me that a group of the jinn listened and said, 'Indeed, we have heard an amazing Qur’ān [i.e., recitation].", "words": [{"type": "word", "ar": "قُلْ", "tajweed": "قُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/072_001_001.mp3"}, {"type": "word", "ar": "أُوحِىَ", "tajweed": "أُوحِىَ", "en": "It has been revealed", "tr": "ūḥiya", "audio": "wbw/072_001_002.mp3"}, {"type": "word", "ar": "إِلَىَّ", "tajweed": "إِلَىَّ", "en": "to me", "tr": "ilayya", "audio": "wbw/072_001_003.mp3"}, {"type": "word", "ar": "أَنَّهُ", "tajweed": "أَ<rule class=ghunnah>نّ</rule>َهُ", "en": "that", "tr": "annahu", "audio": "wbw/072_001_004.mp3"}, {"type": "word", "ar": "ٱسْتَمَعَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>سۡتَمَعَ", "en": "listened", "tr": "is'tamaʿa", "audio": "wbw/072_001_005.mp3"}, {"type": "word", "ar": "نَفَرٌۭ", "tajweed": "نَفَ<rule class=idgham_ghunnah>رٌ</rule>", "en": "a group", "tr": "nafarun", "audio": "wbw/072_001_006.mp3"}, {"type": "word", "ar": "مِّنَ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنَ", "en": "of", "tr": "mina", "audio": "wbw/072_001_007.mp3"}, {"type": "word", "ar": "ٱلْجِنِّ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجِ<rule class=ghunnah>نّ</rule>ِ", "en": "the jinn", "tr": "l-jini", "audio": "wbw/072_001_008.mp3"}, {"type": "word", "ar": "فَقَالُوٓا۟", "tajweed": "فَقَال<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "and they said", "tr": "faqālū", "audio": "wbw/072_001_009.mp3"}, {"type": "word", "ar": "إِنَّا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َا", "en": "Indeed, we", "tr": "innā", "audio": "wbw/072_001_010.mp3"}, {"type": "word", "ar": "سَمِعْنَا", "tajweed": "سَمِعۡنَا", "en": "heard", "tr": "samiʿ'nā", "audio": "wbw/072_001_011.mp3"}, {"type": "word", "ar": "قُرْءَانًا", "tajweed": "قُرۡءَانًا", "en": "a Quran", "tr": "qur'ānan", "audio": "wbw/072_001_012.mp3"}, {"type": "word", "ar": "عَجَبًۭا", "tajweed": "عَجَبًا", "en": "amazing", "tr": "ʿajaban", "audio": "wbw/072_001_013.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "72:2", "juz": 29, "page": 572, "side_trans": "It guides to the right course, and we have believed in it. And we will never associate with our Lord anyone.", "words": [{"type": "word", "ar": "يَهْدِىٓ", "tajweed": "يَهۡد<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "It guides", "tr": "yahdī", "audio": "wbw/072_002_001.mp3"}, {"type": "word", "ar": "إِلَى", "tajweed": "إِلَى", "en": "to", "tr": "ilā", "audio": "wbw/072_002_002.mp3"}, {"type": "word", "ar": "ٱلرُّشْدِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رُّشۡدِ", "en": "the right way", "tr": "l-rush'di", "audio": "wbw/072_002_003.mp3"}, {"type": "word", "ar": "فَـَٔامَنَّا", "tajweed": "فَـَٔـامَ<rule class=ghunnah>نّ</rule>َا", "en": "so we believe", "tr": "faāmannā", "audio": "wbw/072_002_004.mp3"}, {"type": "word", "ar": "بِهِۦ ۖ", "tajweed": "بِه<rule class=madda_normal>ِۦ</rule>‌ۖ", "en": "in it", "tr": "bihi", "audio": "wbw/072_002_005.mp3"}, {"type": "word", "ar": "وَلَن", "tajweed": "وَل<rule class=idgham_ghunnah>َن</rule>", "en": "and never", "tr": "walan", "audio": "wbw/072_002_007.mp3"}, {"type": "word", "ar": "نُّشْرِكَ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>ُّشۡرِكَ", "en": "we will associate", "tr": "nush'rika", "audio": "wbw/072_002_008.mp3"}, {"type": "word", "ar": "بِرَبِّنَآ", "tajweed": "بِرَبِّن<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "with our Lord", "tr": "birabbinā", "audio": "wbw/072_002_009.mp3"}, {"type": "word", "ar": "أَحَدًۭا", "tajweed": "أَحَدًا", "en": "anyone", "tr": "aḥadan", "audio": "wbw/072_002_010.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "72:3", "juz": 29, "page": 572, "side_trans": "And [it teaches] that exalted is the nobleness of our Lord; He has not taken a wife or a son", "words": [{"type": "word", "ar": "وَأَنَّهُۥ", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "And that He ", "tr": "wa-annahu", "audio": "wbw/072_003_001.mp3"}, {"type": "word", "ar": "تَعَـٰلَىٰ", "tajweed": "تَعَ<rule class=madda_normal>ـٰ</rule>لَىٰ", "en": "Exalted is", "tr": "taʿālā", "audio": "wbw/072_003_002.mp3"}, {"type": "word", "ar": "جَدُّ", "tajweed": "جَدُّ", "en": "(the) Majesty", "tr": "jaddu", "audio": "wbw/072_003_003.mp3"}, {"type": "word", "ar": "رَبِّنَا", "tajweed": "رَبِّنَا", "en": "(of) our Lord ", "tr": "rabbinā", "audio": "wbw/072_003_004.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "not", "tr": "mā", "audio": "wbw/072_003_005.mp3"}, {"type": "word", "ar": "ٱتَّخَذَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>تَّخَذَ", "en": "He has taken", "tr": "ittakhadha", "audio": "wbw/072_003_006.mp3"}, {"type": "word", "ar": "صَـٰحِبَةًۭ", "tajweed": "صَ<rule class=madda_normal>ـٰ</rule>حِبَ<rule class=idgham_ghunnah>ةً</rule>", "en": "a wife", "tr": "ṣāḥibatan", "audio": "wbw/072_003_007.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "and not", "tr": "walā", "audio": "wbw/072_003_008.mp3"}, {"type": "word", "ar": "وَلَدًۭا", "tajweed": "وَلَدًا", "en": "a son", "tr": "waladan", "audio": "wbw/072_003_009.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "72:4", "juz": 29, "page": 572, "side_trans": "And that our foolish one [i.e., Iblees] has been saying about Allāh an excessive transgression.", "words": [{"type": "word", "ar": "وَأَنَّهُۥ", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "And that he", "tr": "wa-annahu", "audio": "wbw/072_004_001.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "used to", "tr": "kāna", "audio": "wbw/072_004_002.mp3"}, {"type": "word", "ar": "يَقُولُ", "tajweed": "يَقُولُ", "en": "speak ", "tr": "yaqūlu", "audio": "wbw/072_004_003.mp3"}, {"type": "word", "ar": "سَفِيهُنَا", "tajweed": "سَفِيهُنَا", "en": "the foolish among us", "tr": "safīhunā", "audio": "wbw/072_004_004.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "against", "tr": "ʿalā", "audio": "wbw/072_004_005.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/072_004_006.mp3"}, {"type": "word", "ar": "شَطَطًۭا", "tajweed": "شَطَطًا", "en": "an excessive transgression", "tr": "shaṭaṭan", "audio": "wbw/072_004_007.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "72:5", "juz": 29, "page": 572, "side_trans": "And we had thought that mankind and the jinn would never speak about Allāh a lie.", "words": [{"type": "word", "ar": "وَأَنَّا", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َا", "en": "And that we", "tr": "wa-annā", "audio": "wbw/072_005_001.mp3"}, {"type": "word", "ar": "ظَنَنَّآ", "tajweed": "ظَنَ<rule class=ghunnah>نّ</rule><rule class=madda_obligatory_monfasel>َآ</rule>", "en": "thought", "tr": "ẓanannā", "audio": "wbw/072_005_002.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_wo_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/072_005_003.mp3"}, {"type": "word", "ar": "لَّن", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّ<rule class=ikhafa>ن</rule>", "en": "never", "tr": "lan", "audio": "wbw/072_005_004.mp3"}, {"type": "word", "ar": "تَقُولَ", "tajweed": "<rule class=ikhafa>ت</rule>َقُولَ", "en": "will say", "tr": "taqūla", "audio": "wbw/072_005_005.mp3"}, {"type": "word", "ar": "ٱلْإِنسُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>ُ", "en": "the men", "tr": "l-insu", "audio": "wbw/072_005_006.mp3"}, {"type": "word", "ar": "وَٱلْجِنُّ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡجِ<rule class=ghunnah>نّ</rule>ُ", "en": "and the jinn", "tr": "wal-jinu", "audio": "wbw/072_005_007.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "against", "tr": "ʿalā", "audio": "wbw/072_005_008.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/072_005_009.mp3"}, {"type": "word", "ar": "كَذِبًۭا", "tajweed": "كَذِبًا", "en": "any lie", "tr": "kadhiban", "audio": "wbw/072_005_010.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "72:6", "juz": 29, "page": 572, "side_trans": "And there were men from mankind who sought refuge in men from the jinn, so they [only] increased them in burden [i.e., sin].", "words": [{"type": "word", "ar": "وَأَنَّهُۥ", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "And that", "tr": "wa-annahu", "audio": "wbw/072_006_001.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "(there) were", "tr": "kāna", "audio": "wbw/072_006_002.mp3"}, {"type": "word", "ar": "رِجَالٌۭ", "tajweed": "رِجَا<rule class=idgham_ghunnah>لٌ</rule>", "en": "men", "tr": "rijālun", "audio": "wbw/072_006_003.mp3"}, {"type": "word", "ar": "مِّنَ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنَ", "en": "among", "tr": "mina", "audio": "wbw/072_006_004.mp3"}, {"type": "word", "ar": "ٱلْإِنسِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>ِ", "en": "mankind", "tr": "l-insi", "audio": "wbw/072_006_005.mp3"}, {"type": "word", "ar": "يَعُوذُونَ", "tajweed": "يَعُوذُونَ", "en": "who sought refuge", "tr": "yaʿūdhūna", "audio": "wbw/072_006_006.mp3"}, {"type": "word", "ar": "بِرِجَالٍۢ", "tajweed": "بِرِجَا<rule class=idgham_ghunnah>لٍ</rule>", "en": "in (the) men", "tr": "birijālin", "audio": "wbw/072_006_007.mp3"}, {"type": "word", "ar": "مِّنَ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنَ", "en": "from", "tr": "mina", "audio": "wbw/072_006_008.mp3"}, {"type": "word", "ar": "ٱلْجِنِّ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجِ<rule class=ghunnah>نّ</rule>ِ", "en": "the jinn", "tr": "l-jini", "audio": "wbw/072_006_009.mp3"}, {"type": "word", "ar": "فَزَادُوهُمْ", "tajweed": "فَزَادُوهُمۡ", "en": "so they increased them", "tr": "fazādūhum", "audio": "wbw/072_006_010.mp3"}, {"type": "word", "ar": "رَهَقًۭا", "tajweed": "رَهَقًا", "en": "(in) burden", "tr": "rahaqan", "audio": "wbw/072_006_011.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "72:7", "juz": 29, "page": 572, "side_trans": "And they had thought, as you thought, that Allāh would never send anyone [as a messenger].", "words": [{"type": "word", "ar": "وَأَنَّهُمْ", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "And that they", "tr": "wa-annahum", "audio": "wbw/072_007_001.mp3"}, {"type": "word", "ar": "ظَنُّوا۟", "tajweed": "ظَ<rule class=ghunnah>نّ</rule>ُو<rule class=slnt>اۡ</rule>", "en": "thought", "tr": "ẓannū", "audio": "wbw/072_007_002.mp3"}, {"type": "word", "ar": "كَمَا", "tajweed": "كَمَا", "en": "as", "tr": "kamā", "audio": "wbw/072_007_003.mp3"}, {"type": "word", "ar": "ظَنَنتُمْ", "tajweed": "ظَنَ<rule class=ikhafa>نت</rule>ُمۡ", "en": "you thought", "tr": "ẓanantum", "audio": "wbw/072_007_004.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_wo_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/072_007_005.mp3"}, {"type": "word", "ar": "لَّن", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ّ<rule class=idgham_ghunnah>َن</rule>", "en": "never", "tr": "lan", "audio": "wbw/072_007_006.mp3"}, {"type": "word", "ar": "يَبْعَثَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َ<rule class=qalaqah>بۡ</rule>عَثَ", "en": "will raise", "tr": "yabʿatha", "audio": "wbw/072_007_007.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/072_007_008.mp3"}, {"type": "word", "ar": "أَحَدًۭا", "tajweed": "أَحَدًا", "en": "anyone", "tr": "aḥadan", "audio": "wbw/072_007_009.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "72:8", "juz": 29, "page": 572, "side_trans": "And we have sought [to reach] the heaven but found it filled with powerful guards and burning flames.", "words": [{"type": "word", "ar": "وَأَنَّا", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َا", "en": "And that we", "tr": "wa-annā", "audio": "wbw/072_008_001.mp3"}, {"type": "word", "ar": "لَمَسْنَا", "tajweed": "لَمَسۡنَا", "en": "sought to touch", "tr": "lamasnā", "audio": "wbw/072_008_002.mp3"}, {"type": "word", "ar": "ٱلسَّمَآءَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "the heaven", "tr": "l-samāa", "audio": "wbw/072_008_003.mp3"}, {"type": "word", "ar": "فَوَجَدْنَـٰهَا", "tajweed": "فَوَجَ<rule class=qalaqah>دۡ</rule>نَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "but we found it", "tr": "fawajadnāhā", "audio": "wbw/072_008_004.mp3"}, {"type": "word", "ar": "مُلِئَتْ", "tajweed": "مُلِئَتۡ", "en": "filled (with)", "tr": "muli-at", "audio": "wbw/072_008_005.mp3"}, {"type": "word", "ar": "حَرَسًۭا", "tajweed": "حَرَ<rule class=ikhafa>سًا</rule>", "en": "guards", "tr": "ḥarasan", "audio": "wbw/072_008_006.mp3"}, {"type": "word", "ar": "شَدِيدًۭا", "tajweed": "<rule class=ikhafa>ش</rule>َدِي<rule class=idgham_ghunnah>دًا</rule>", "en": "severe", "tr": "shadīdan", "audio": "wbw/072_008_007.mp3"}, {"type": "word", "ar": "وَشُهُبًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َشُهُبًا", "en": "and flaming fires", "tr": "washuhuban", "audio": "wbw/072_008_008.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "72:9", "juz": 29, "page": 572, "side_trans": "And we used to sit therein in positions for hearing, but whoever listens now will find a burning flame lying in wait for him.", "words": [{"type": "word", "ar": "وَأَنَّا", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َا", "en": "And that we", "tr": "wa-annā", "audio": "wbw/072_009_001.mp3"}, {"type": "word", "ar": "كُنَّا", "tajweed": "كُ<rule class=ghunnah>نّ</rule>َا", "en": "used to", "tr": "kunnā", "audio": "wbw/072_009_002.mp3"}, {"type": "word", "ar": "نَقْعُدُ", "tajweed": "نَ<rule class=qalaqah>قۡ</rule>عُدُ", "en": "sit", "tr": "naqʿudu", "audio": "wbw/072_009_003.mp3"}, {"type": "word", "ar": "مِنْهَا", "tajweed": "مِنۡهَا", "en": "there in", "tr": "min'hā", "audio": "wbw/072_009_004.mp3"}, {"type": "word", "ar": "مَقَـٰعِدَ", "tajweed": "مَقَ<rule class=madda_normal>ـٰ</rule>عِدَ", "en": "positions", "tr": "maqāʿida", "audio": "wbw/072_009_005.mp3"}, {"type": "word", "ar": "لِلسَّمْعِ ۖ", "tajweed": "لِلسَّمۡعِ‌ۖ", "en": "for hearing", "tr": "lilssamʿi", "audio": "wbw/072_009_006.mp3"}, {"type": "word", "ar": "فَمَن", "tajweed": "فَم<rule class=idgham_ghunnah>َن</rule>", "en": "but (he) who", "tr": "faman", "audio": "wbw/072_009_008.mp3"}, {"type": "word", "ar": "يَسْتَمِعِ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َسۡتَمِعِ", "en": "listens", "tr": "yastamiʿi", "audio": "wbw/072_009_009.mp3"}, {"type": "word", "ar": "ٱلْـَٔانَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَنَ", "en": "now", "tr": "l-āna", "audio": "wbw/072_009_010.mp3"}, {"type": "word", "ar": "يَجِدْ", "tajweed": "يَجِ<rule class=qalaqah>دۡ</rule>", "en": "will find", "tr": "yajid", "audio": "wbw/072_009_011.mp3"}, {"type": "word", "ar": "لَهُۥ", "tajweed": "لَهُ<rule class=madda_normal>ۥ</rule>", "en": "for him", "tr": "lahu", "audio": "wbw/072_009_012.mp3"}, {"type": "word", "ar": "شِهَابًۭا", "tajweed": "شِهَا<rule class=idgham_wo_ghunnah>بًا</rule>", "en": "a flaming fire", "tr": "shihāban", "audio": "wbw/072_009_013.mp3"}, {"type": "word", "ar": "رَّصَدًۭا", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّصَدًا", "en": "waiting", "tr": "raṣadan", "audio": "wbw/072_009_014.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "72:10", "juz": 29, "page": 572, "side_trans": "And we do not know [therefore] whether evil is intended for those on earth or whether their Lord intends for them a right course.", "words": [{"type": "word", "ar": "وَأَنَّا", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َا", "en": "And that we ", "tr": "wa-annā", "audio": "wbw/072_010_001.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/072_010_002.mp3"}, {"type": "word", "ar": "نَدْرِىٓ", "tajweed": "نَ<rule class=qalaqah>دۡ</rule>ر<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "we know", "tr": "nadrī", "audio": "wbw/072_010_003.mp3"}, {"type": "word", "ar": "أَشَرٌّ", "tajweed": "أَشَرٌّ", "en": "whether evil", "tr": "asharrun", "audio": "wbw/072_010_004.mp3"}, {"type": "word", "ar": "أُرِيدَ", "tajweed": "أُرِيدَ", "en": "is intended", "tr": "urīda", "audio": "wbw/072_010_005.mp3"}, {"type": "word", "ar": "بِمَن", "tajweed": "بِمَ<rule class=ikhafa>ن</rule>", "en": "for (those) who", "tr": "biman", "audio": "wbw/072_010_006.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "<rule class=ikhafa>ف</rule>ِى", "en": "(are) in", "tr": "fī", "audio": "wbw/072_010_007.mp3"}, {"type": "word", "ar": "ٱلْأَرْضِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "the earth", "tr": "l-arḍi", "audio": "wbw/072_010_008.mp3"}, {"type": "word", "ar": "أَمْ", "tajweed": "أَمۡ", "en": "or", "tr": "am", "audio": "wbw/072_010_009.mp3"}, {"type": "word", "ar": "أَرَادَ", "tajweed": "أَرَادَ", "en": "intends", "tr": "arāda", "audio": "wbw/072_010_010.mp3"}, {"type": "word", "ar": "بِهِمْ", "tajweed": "بِهِمۡ", "en": "for them", "tr": "bihim", "audio": "wbw/072_010_011.mp3"}, {"type": "word", "ar": "رَبُّهُمْ", "tajweed": "رَبُّهُمۡ", "en": "their Lord", "tr": "rabbuhum", "audio": "wbw/072_010_012.mp3"}, {"type": "word", "ar": "رَشَدًۭا", "tajweed": "رَشَدًا", "en": "a right path", "tr": "rashadan", "audio": "wbw/072_010_013.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "72:11", "juz": 29, "page": 572, "side_trans": "And among us are the righteous, and among us are [others] not so; we were [of] divided ways.", "words": [{"type": "word", "ar": "وَأَنَّا", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َا", "en": "And that [we]", "tr": "wa-annā", "audio": "wbw/072_011_001.mp3"}, {"type": "word", "ar": "مِنَّا", "tajweed": "مِ<rule class=ghunnah>نّ</rule>َا", "en": "among us", "tr": "minnā", "audio": "wbw/072_011_002.mp3"}, {"type": "word", "ar": "ٱلصَّـٰلِحُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّ<rule class=madda_normal>ـٰ</rule>لِحُونَ", "en": "(are) the righteous", "tr": "l-ṣāliḥūna", "audio": "wbw/072_011_003.mp3"}, {"type": "word", "ar": "وَمِنَّا", "tajweed": "وَمِ<rule class=ghunnah>نّ</rule>َا", "en": "and among us", "tr": "waminnā", "audio": "wbw/072_011_004.mp3"}, {"type": "word", "ar": "دُونَ", "tajweed": "دُونَ", "en": "(are) other than", "tr": "dūna", "audio": "wbw/072_011_005.mp3"}, {"type": "word", "ar": "ذَٰلِكَ ۖ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ‌ۖ", "en": "that", "tr": "dhālika", "audio": "wbw/072_011_006.mp3"}, {"type": "word", "ar": "كُنَّا", "tajweed": "كُ<rule class=ghunnah>نّ</rule>َا", "en": "We", "tr": "kunnā", "audio": "wbw/072_011_008.mp3"}, {"type": "word", "ar": "طَرَآئِقَ", "tajweed": "طَر<rule class=madda_obligatory_mottasel>َا</rule>ٓئِقَ", "en": "(are on) ways", "tr": "ṭarāiqa", "audio": "wbw/072_011_009.mp3"}, {"type": "word", "ar": "قِدَدًۭا", "tajweed": "قِدَدًا", "en": "different", "tr": "qidadan", "audio": "wbw/072_011_010.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "72:12", "juz": 29, "page": 572, "side_trans": "And we have become certain that we will never cause failure to Allāh upon earth, nor can we escape Him by flight.", "words": [{"type": "word", "ar": "وَأَنَّا", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َا", "en": "And that we", "tr": "wa-annā", "audio": "wbw/072_012_001.mp3"}, {"type": "word", "ar": "ظَنَنَّآ", "tajweed": "ظَنَ<rule class=ghunnah>نّ</rule><rule class=madda_obligatory_monfasel>َآ</rule>", "en": "[we] have become certain", "tr": "ẓanannā", "audio": "wbw/072_012_002.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_wo_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/072_012_003.mp3"}, {"type": "word", "ar": "لَّن", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ّ<rule class=idgham_ghunnah>َن</rule>", "en": "never", "tr": "lan", "audio": "wbw/072_012_004.mp3"}, {"type": "word", "ar": "نُّعْجِزَ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>ُّعۡجِزَ", "en": "we will cause failure", "tr": "nuʿ'jiza", "audio": "wbw/072_012_005.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "(to) Allah", "tr": "l-laha", "audio": "wbw/072_012_006.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/072_012_007.mp3"}, {"type": "word", "ar": "ٱلْأَرْضِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "the earth", "tr": "l-arḍi", "audio": "wbw/072_012_008.mp3"}, {"type": "word", "ar": "وَلَن", "tajweed": "وَل<rule class=idgham_ghunnah>َن</rule>", "en": "and never", "tr": "walan", "audio": "wbw/072_012_009.mp3"}, {"type": "word", "ar": "نُّعْجِزَهُۥ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>ُّعۡجِزَهُ<rule class=madda_normal>ۥ</rule>", "en": "we can escape Him", "tr": "nuʿ'jizahu", "audio": "wbw/072_012_010.mp3"}, {"type": "word", "ar": "هَرَبًۭا", "tajweed": "هَرَبًا", "en": "(by) flight", "tr": "haraban", "audio": "wbw/072_012_011.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "72:13", "juz": 29, "page": 572, "side_trans": "And when we heard the guidance [i.e., the Qur’ān], we believed in it. And whoever believes in his Lord will not fear deprivation or burden.", "words": [{"type": "word", "ar": "وَأَنَّا", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َا", "en": "And that [we]", "tr": "wa-annā", "audio": "wbw/072_013_001.mp3"}, {"type": "word", "ar": "لَمَّا", "tajweed": "لَ<rule class=ghunnah>مّ</rule>َا", "en": "when", "tr": "lammā", "audio": "wbw/072_013_002.mp3"}, {"type": "word", "ar": "سَمِعْنَا", "tajweed": "سَمِعۡنَا", "en": "we heard", "tr": "samiʿ'nā", "audio": "wbw/072_013_003.mp3"}, {"type": "word", "ar": "ٱلْهُدَىٰٓ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡهُدَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "the Guidance", "tr": "l-hudā", "audio": "wbw/072_013_004.mp3"}, {"type": "word", "ar": "ءَامَنَّا", "tajweed": "ءَامَ<rule class=ghunnah>نّ</rule>َا", "en": "we believed", "tr": "āmannā", "audio": "wbw/072_013_005.mp3"}, {"type": "word", "ar": "بِهِۦ ۖ", "tajweed": "بِه<rule class=madda_normal>ِۦ</rule>‌ۖ", "en": "in it", "tr": "bihi", "audio": "wbw/072_013_006.mp3"}, {"type": "word", "ar": "فَمَن", "tajweed": "فَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "faman", "audio": "wbw/072_013_008.mp3"}, {"type": "word", "ar": "يُؤْمِنۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُؤۡم<rule class=iqlab>ِنۢ</rule>", "en": "believes", "tr": "yu'min", "audio": "wbw/072_013_009.mp3"}, {"type": "word", "ar": "بِرَبِّهِۦ", "tajweed": "<rule class=iqlab>ب</rule>ِرَبِّه<rule class=madda_normal>ِۦ</rule>", "en": "in his Lord", "tr": "birabbihi", "audio": "wbw/072_013_010.mp3"}, {"type": "word", "ar": "فَلَا", "tajweed": "فَلَا", "en": "then not", "tr": "falā", "audio": "wbw/072_013_011.mp3"}, {"type": "word", "ar": "يَخَافُ", "tajweed": "يَخَافُ", "en": "he will fear", "tr": "yakhāfu", "audio": "wbw/072_013_012.mp3"}, {"type": "word", "ar": "بَخْسًۭا", "tajweed": "بَخۡ<rule class=idgham_ghunnah>سًا</rule>", "en": "any loss", "tr": "bakhsan", "audio": "wbw/072_013_013.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "and not", "tr": "walā", "audio": "wbw/072_013_014.mp3"}, {"type": "word", "ar": "رَهَقًۭا", "tajweed": "رَهَقًا", "en": "any burden", "tr": "rahaqan", "audio": "wbw/072_013_015.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "72:14", "juz": 29, "page": 573, "side_trans": "And among us are Muslims [in submission to Allāh], and among us are the unjust. And whoever has become Muslim - those have sought out the right course.", "words": [{"type": "word", "ar": "وَأَنَّا", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َا", "en": "And that we", "tr": "wa-annā", "audio": "wbw/072_014_001.mp3"}, {"type": "word", "ar": "مِنَّا", "tajweed": "مِ<rule class=ghunnah>نّ</rule>َا", "en": "among us", "tr": "minnā", "audio": "wbw/072_014_002.mp3"}, {"type": "word", "ar": "ٱلْمُسْلِمُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُسۡلِمُونَ", "en": "(are) Muslims", "tr": "l-mus'limūna", "audio": "wbw/072_014_003.mp3"}, {"type": "word", "ar": "وَمِنَّا", "tajweed": "وَمِ<rule class=ghunnah>نّ</rule>َا", "en": "and among us", "tr": "waminnā", "audio": "wbw/072_014_004.mp3"}, {"type": "word", "ar": "ٱلْقَـٰسِطُونَ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَ<rule class=madda_normal>ـٰ</rule>سِطُونَ‌ۖ", "en": "(are) unjust", "tr": "l-qāsiṭūna", "audio": "wbw/072_014_005.mp3"}, {"type": "word", "ar": "فَمَنْ", "tajweed": "فَمَنۡ", "en": "And whoever", "tr": "faman", "audio": "wbw/072_014_007.mp3"}, {"type": "word", "ar": "أَسْلَمَ", "tajweed": "أَسۡلَمَ", "en": "submits", "tr": "aslama", "audio": "wbw/072_014_008.mp3"}, {"type": "word", "ar": "فَأُو۟لَـٰٓئِكَ", "tajweed": "فَأُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَ", "en": "then those", "tr": "fa-ulāika", "audio": "wbw/072_014_009.mp3"}, {"type": "word", "ar": "تَحَرَّوْا۟", "tajweed": "تَحَرَّوۡ<rule class=slnt>اۡ</rule>", "en": "have sought", "tr": "taḥarraw", "audio": "wbw/072_014_010.mp3"}, {"type": "word", "ar": "رَشَدًۭا", "tajweed": "رَشَدًا", "en": "(the) right path", "tr": "rashadan", "audio": "wbw/072_014_011.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "72:15", "juz": 29, "page": 573, "side_trans": "But as for the unjust, they will be, for Hell, firewood.'", "words": [{"type": "word", "ar": "وَأَمَّا", "tajweed": "وَأَ<rule class=ghunnah>مّ</rule>َا", "en": "And as for", "tr": "wa-ammā", "audio": "wbw/072_015_001.mp3"}, {"type": "word", "ar": "ٱلْقَـٰسِطُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَ<rule class=madda_normal>ـٰ</rule>سِطُونَ", "en": "the unjust", "tr": "l-qāsiṭūna", "audio": "wbw/072_015_002.mp3"}, {"type": "word", "ar": "فَكَانُوا۟", "tajweed": "فَكَانُو<rule class=slnt>اۡ</rule>", "en": "they will be", "tr": "fakānū", "audio": "wbw/072_015_003.mp3"}, {"type": "word", "ar": "لِجَهَنَّمَ", "tajweed": "لِجَهَ<rule class=ghunnah>نّ</rule>َمَ", "en": "for Hell", "tr": "lijahannama", "audio": "wbw/072_015_004.mp3"}, {"type": "word", "ar": "حَطَبًۭا", "tajweed": "حَطَبًا", "en": "firewood", "tr": "ḥaṭaban", "audio": "wbw/072_015_005.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "72:16", "juz": 29, "page": 573, "side_trans": "And [Allāh revealed] that if they had remained straight on the way, We would have given them abundant rain [i.e., provision].", "words": [{"type": "word", "ar": "وَأَلَّوِ", "tajweed": "وَأَلَّوِ", "en": "And that if", "tr": "wa-allawi", "audio": "wbw/072_016_001.mp3"}, {"type": "word", "ar": "ٱسْتَقَـٰمُوا۟", "tajweed": "<rule class=ham_wasl>ٱ</rule>سۡتَقَ<rule class=madda_normal>ـٰ</rule>مُو<rule class=slnt>اۡ</rule>", "en": "they had remained", "tr": "is'taqāmū", "audio": "wbw/072_016_002.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "on", "tr": "ʿalā", "audio": "wbw/072_016_003.mp3"}, {"type": "word", "ar": "ٱلطَّرِيقَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>طَّرِيقَةِ", "en": "the Way", "tr": "l-ṭarīqati", "audio": "wbw/072_016_004.mp3"}, {"type": "word", "ar": "لَأَسْقَيْنَـٰهُم", "tajweed": "لَأَسۡقَيۡنَ<rule class=madda_normal>ـٰ</rule>ه<rule class=idgham_shafawi>ُم</rule>", "en": "surely We (would) have given them to drink", "tr": "la-asqaynāhum", "audio": "wbw/072_016_005.mp3"}, {"type": "word", "ar": "مَّآءً", "tajweed": "<rule class=idgham_shafawi>م</rule>ّ<rule class=madda_obligatory_mottasel>َا</rule>ٓءً", "en": "water", "tr": "māan", "audio": "wbw/072_016_006.mp3"}, {"type": "word", "ar": "غَدَقًۭا", "tajweed": "غَدَقًا", "en": "(in) abundance", "tr": "ghadaqan", "audio": "wbw/072_016_007.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "72:17", "juz": 29, "page": 573, "side_trans": "So We might test them therein. And whoever turns away from the remembrance of his Lord He will put into arduous punishment.", "words": [{"type": "word", "ar": "لِّنَفْتِنَهُمْ", "tajweed": "لِّنَفۡتِنَهُمۡ", "en": "That We might test them", "tr": "linaftinahum", "audio": "wbw/072_017_001.mp3"}, {"type": "word", "ar": "فِيهِ ۚ", "tajweed": "فِيهِ‌ۚ", "en": "therein", "tr": "fīhi", "audio": "wbw/072_017_002.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/072_017_004.mp3"}, {"type": "word", "ar": "يُعْرِضْ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُعۡرِضۡ", "en": "turns away", "tr": "yuʿ'riḍ", "audio": "wbw/072_017_005.mp3"}, {"type": "word", "ar": "عَن", "tajweed": "عَ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "ʿan", "audio": "wbw/072_017_006.mp3"}, {"type": "word", "ar": "ذِكْرِ", "tajweed": "<rule class=ikhafa>ذ</rule>ِكۡرِ", "en": "the Remembrance", "tr": "dhik'ri", "audio": "wbw/072_017_007.mp3"}, {"type": "word", "ar": "رَبِّهِۦ", "tajweed": "رَبِّه<rule class=madda_normal>ِۦ</rule>", "en": "(of) his Lord", "tr": "rabbihi", "audio": "wbw/072_017_008.mp3"}, {"type": "word", "ar": "يَسْلُكْهُ", "tajweed": "يَسۡلُكۡهُ", "en": "He will make him enter", "tr": "yasluk'hu", "audio": "wbw/072_017_009.mp3"}, {"type": "word", "ar": "عَذَابًۭا", "tajweed": "عَذَا<rule class=ikhafa>بًا</rule>", "en": "a punishment", "tr": "ʿadhāban", "audio": "wbw/072_017_010.mp3"}, {"type": "word", "ar": "صَعَدًۭا", "tajweed": "<rule class=ikhafa>ص</rule>َعَدًا", "en": "severe", "tr": "ṣaʿadan", "audio": "wbw/072_017_011.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "72:18", "juz": 29, "page": 573, "side_trans": "And [He revealed] that the masjids are for Allāh, so do not invoke with Allāh anyone.", "words": [{"type": "word", "ar": "وَأَنَّ", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َ", "en": "And that", "tr": "wa-anna", "audio": "wbw/072_018_001.mp3"}, {"type": "word", "ar": "ٱلْمَسَـٰجِدَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَسَ<rule class=madda_normal>ـٰ</rule>جِدَ", "en": "the masjids", "tr": "l-masājida", "audio": "wbw/072_018_002.mp3"}, {"type": "word", "ar": "لِلَّهِ", "tajweed": "لِلَّهِ", "en": "(are) for Allah", "tr": "lillahi", "audio": "wbw/072_018_003.mp3"}, {"type": "word", "ar": "فَلَا", "tajweed": "فَلَا", "en": "so (do) not", "tr": "falā", "audio": "wbw/072_018_004.mp3"}, {"type": "word", "ar": "تَدْعُوا۟", "tajweed": "تَ<rule class=qalaqah>دۡ</rule>عُو<rule class=slnt>اۡ</rule>", "en": "call", "tr": "tadʿū", "audio": "wbw/072_018_005.mp3"}, {"type": "word", "ar": "مَعَ", "tajweed": "مَعَ", "en": "with", "tr": "maʿa", "audio": "wbw/072_018_006.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/072_018_007.mp3"}, {"type": "word", "ar": "أَحَدًۭا", "tajweed": "أَحَدًا", "en": "anyone", "tr": "aḥadan", "audio": "wbw/072_018_008.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "72:19", "juz": 29, "page": 573, "side_trans": "And that when the Servant [i.e., Prophet] of Allāh stood up supplicating Him, they almost became about him a compacted mass.\"", "words": [{"type": "word", "ar": "وَأَنَّهُۥ", "tajweed": "وَأَ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "And that", "tr": "wa-annahu", "audio": "wbw/072_019_001.mp3"}, {"type": "word", "ar": "لَمَّا", "tajweed": "لَ<rule class=ghunnah>مّ</rule>َا", "en": "when", "tr": "lammā", "audio": "wbw/072_019_002.mp3"}, {"type": "word", "ar": "قَامَ", "tajweed": "قَامَ", "en": "stood up", "tr": "qāma", "audio": "wbw/072_019_003.mp3"}, {"type": "word", "ar": "عَبْدُ", "tajweed": "عَ<rule class=qalaqah>بۡ</rule>دُ", "en": "(the) slave", "tr": "ʿabdu", "audio": "wbw/072_019_004.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/072_019_005.mp3"}, {"type": "word", "ar": "يَدْعُوهُ", "tajweed": "يَ<rule class=qalaqah>دۡ</rule>عُوهُ", "en": "calling (upon) Him", "tr": "yadʿūhu", "audio": "wbw/072_019_006.mp3"}, {"type": "word", "ar": "كَادُوا۟", "tajweed": "كَادُو<rule class=slnt>اۡ</rule>", "en": "they almost", "tr": "kādū", "audio": "wbw/072_019_007.mp3"}, {"type": "word", "ar": "يَكُونُونَ", "tajweed": "يَكُونُونَ", "en": "became", "tr": "yakūnūna", "audio": "wbw/072_019_008.mp3"}, {"type": "word", "ar": "عَلَيْهِ", "tajweed": "عَلَيۡهِ", "en": "around him", "tr": "ʿalayhi", "audio": "wbw/072_019_009.mp3"}, {"type": "word", "ar": "لِبَدًۭا", "tajweed": "لِبَدًا", "en": "a compacted mass", "tr": "libadan", "audio": "wbw/072_019_010.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "72:20", "juz": 29, "page": 573, "side_trans": "Say, [O Muḥammad], \"I only invoke my Lord and do not associate with Him anyone.\"", "words": [{"type": "word", "ar": "قُلْ", "tajweed": "قُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/072_020_001.mp3"}, {"type": "word", "ar": "إِنَّمَآ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Only", "tr": "innamā", "audio": "wbw/072_020_002.mp3"}, {"type": "word", "ar": "أَدْعُوا۟", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>عُو<rule class=slnt>اۡ</rule>", "en": "I call upon", "tr": "adʿū", "audio": "wbw/072_020_003.mp3"}, {"type": "word", "ar": "رَبِّى", "tajweed": "رَبِّى", "en": "my Lord", "tr": "rabbī", "audio": "wbw/072_020_004.mp3"}, {"type": "word", "ar": "وَلَآ", "tajweed": "وَل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "and not", "tr": "walā", "audio": "wbw/072_020_005.mp3"}, {"type": "word", "ar": "أُشْرِكُ", "tajweed": "أُشۡرِكُ", "en": "I associate", "tr": "ush'riku", "audio": "wbw/072_020_006.mp3"}, {"type": "word", "ar": "بِهِۦٓ", "tajweed": "بِه<rule class=madda_obligatory_monfasel>ِۦٓ</rule>", "en": "with Him", "tr": "bihi", "audio": "wbw/072_020_007.mp3"}, {"type": "word", "ar": "أَحَدًۭا", "tajweed": "أَحَدًا", "en": "anyone", "tr": "aḥadan", "audio": "wbw/072_020_008.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "72:21", "juz": 29, "page": 573, "side_trans": "Say, \"Indeed, I do not possess for you [the power of] harm or right direction.\"", "words": [{"type": "word", "ar": "قُلْ", "tajweed": "قُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/072_021_001.mp3"}, {"type": "word", "ar": "إِنِّى", "tajweed": "إِ<rule class=ghunnah>نّ</rule>ِى", "en": "Indeed, I", "tr": "innī", "audio": "wbw/072_021_002.mp3"}, {"type": "word", "ar": "لَآ", "tajweed": "ل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "(do) not", "tr": "lā", "audio": "wbw/072_021_003.mp3"}, {"type": "word", "ar": "أَمْلِكُ", "tajweed": "أَمۡلِكُ", "en": "possess", "tr": "amliku", "audio": "wbw/072_021_004.mp3"}, {"type": "word", "ar": "لَكُمْ", "tajweed": "لَكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/072_021_005.mp3"}, {"type": "word", "ar": "ضَرًّۭا", "tajweed": "ضَر<rule class=idgham_ghunnah>ًّا</rule>", "en": "any harm", "tr": "ḍarran", "audio": "wbw/072_021_006.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "and not", "tr": "walā", "audio": "wbw/072_021_007.mp3"}, {"type": "word", "ar": "رَشَدًۭا", "tajweed": "رَشَدًا", "en": "right path", "tr": "rashadan", "audio": "wbw/072_021_008.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "72:22", "juz": 29, "page": 573, "side_trans": "Say, \"Indeed, there will never protect me from Allāh anyone [if I should disobey], nor will I find in other than Him a refuge.", "words": [{"type": "word", "ar": "قُلْ", "tajweed": "قُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/072_022_001.mp3"}, {"type": "word", "ar": "إِنِّى", "tajweed": "إِ<rule class=ghunnah>نّ</rule>ِى", "en": "Indeed I", "tr": "innī", "audio": "wbw/072_022_002.mp3"}, {"type": "word", "ar": "لَن", "tajweed": "ل<rule class=idgham_ghunnah>َن</rule>", "en": "never", "tr": "lan", "audio": "wbw/072_022_003.mp3"}, {"type": "word", "ar": "يُجِيرَنِى", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُجِيرَنِى", "en": "can protect me", "tr": "yujīranī", "audio": "wbw/072_022_004.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "from", "tr": "mina", "audio": "wbw/072_022_005.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/072_022_006.mp3"}, {"type": "word", "ar": "أَحَدٌۭ", "tajweed": "أَحَ<rule class=idgham_ghunnah>دٌ</rule>", "en": "anyone", "tr": "aḥadun", "audio": "wbw/072_022_007.mp3"}, {"type": "word", "ar": "وَلَنْ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَنۡ", "en": "and never", "tr": "walan", "audio": "wbw/072_022_008.mp3"}, {"type": "word", "ar": "أَجِدَ", "tajweed": "أَجِدَ", "en": "can I find", "tr": "ajida", "audio": "wbw/072_022_009.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/072_022_010.mp3"}, {"type": "word", "ar": "دُونِهِۦ", "tajweed": "<rule class=ikhafa>د</rule>ُونِه<rule class=madda_normal>ِۦ</rule>", "en": "besides Him", "tr": "dūnihi", "audio": "wbw/072_022_011.mp3"}, {"type": "word", "ar": "مُلْتَحَدًا", "tajweed": "مُلۡتَحَدًا", "en": "any refuge", "tr": "mul'taḥadan", "audio": "wbw/072_022_012.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "72:23", "juz": 29, "page": 573, "side_trans": "But [I have for you] only notification from Allāh, and His messages.\" And whoever disobeys Allāh and His Messenger - then indeed, for him is the fire of Hell; they will abide therein forever.", "words": [{"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "But", "tr": "illā", "audio": "wbw/072_023_001.mp3"}, {"type": "word", "ar": "بَلَـٰغًۭا", "tajweed": "بَلَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>غًا</rule>", "en": "(the) notification", "tr": "balāghan", "audio": "wbw/072_023_002.mp3"}, {"type": "word", "ar": "مِّنَ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنَ", "en": "from", "tr": "mina", "audio": "wbw/072_023_003.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/072_023_004.mp3"}, {"type": "word", "ar": "وَرِسَـٰلَـٰتِهِۦ ۚ", "tajweed": "وَرِسَ<rule class=madda_normal>ـٰ</rule>لَ<rule class=madda_normal>ـٰ</rule>تِه<rule class=madda_normal>ِۦ</rule>‌ۚ", "en": "and His Messages", "tr": "warisālātihi", "audio": "wbw/072_023_005.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/072_023_007.mp3"}, {"type": "word", "ar": "يَعْصِ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َعۡصِ", "en": "disobeys", "tr": "yaʿṣi", "audio": "wbw/072_023_008.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/072_023_009.mp3"}, {"type": "word", "ar": "وَرَسُولَهُۥ", "tajweed": "وَرَسُولَهُ<rule class=madda_normal>ۥ</rule>", "en": "and His Messenger", "tr": "warasūlahu", "audio": "wbw/072_023_010.mp3"}, {"type": "word", "ar": "فَإِنَّ", "tajweed": "فَإِ<rule class=ghunnah>نّ</rule>َ", "en": "then indeed", "tr": "fa-inna", "audio": "wbw/072_023_011.mp3"}, {"type": "word", "ar": "لَهُۥ", "tajweed": "لَهُ<rule class=madda_normal>ۥ</rule>", "en": "for him", "tr": "lahu", "audio": "wbw/072_023_012.mp3"}, {"type": "word", "ar": "نَارَ", "tajweed": "نَارَ", "en": "(is the) Fire", "tr": "nāra", "audio": "wbw/072_023_013.mp3"}, {"type": "word", "ar": "جَهَنَّمَ", "tajweed": "جَهَ<rule class=ghunnah>نّ</rule>َمَ", "en": "(of) Hell", "tr": "jahannama", "audio": "wbw/072_023_014.mp3"}, {"type": "word", "ar": "خَـٰلِدِينَ", "tajweed": "خَ<rule class=madda_normal>ـٰ</rule>لِدِينَ", "en": "(they will) abide", "tr": "khālidīna", "audio": "wbw/072_023_015.mp3"}, {"type": "word", "ar": "فِيهَآ", "tajweed": "فِيه<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "therein", "tr": "fīhā", "audio": "wbw/072_023_016.mp3"}, {"type": "word", "ar": "أَبَدًا", "tajweed": "أَبَدًا", "en": "forever", "tr": "abadan", "audio": "wbw/072_023_017.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "72:24", "juz": 29, "page": 573, "side_trans": "[The disbelievers continue] until, when they see that which they are promised, then they will know who is weaker in helpers and less in number.", "words": [{"type": "word", "ar": "حَتَّىٰٓ", "tajweed": "حَتَّ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "Until", "tr": "ḥattā", "audio": "wbw/072_024_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/072_024_002.mp3"}, {"type": "word", "ar": "رَأَوْا۟", "tajweed": "رَأَوۡ<rule class=slnt>اۡ</rule>", "en": "they see", "tr": "ra-aw", "audio": "wbw/072_024_003.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/072_024_004.mp3"}, {"type": "word", "ar": "يُوعَدُونَ", "tajweed": "يُوعَدُونَ", "en": "they are promised", "tr": "yūʿadūna", "audio": "wbw/072_024_005.mp3"}, {"type": "word", "ar": "فَسَيَعْلَمُونَ", "tajweed": "فَسَيَعۡلَمُونَ", "en": "then they will know", "tr": "fasayaʿlamūna", "audio": "wbw/072_024_006.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "who", "tr": "man", "audio": "wbw/072_024_007.mp3"}, {"type": "word", "ar": "أَضْعَفُ", "tajweed": "أَضۡعَفُ", "en": "(is) weaker", "tr": "aḍʿafu", "audio": "wbw/072_024_008.mp3"}, {"type": "word", "ar": "نَاصِرًۭا", "tajweed": "نَاصِ<rule class=idgham_ghunnah>رًا</rule>", "en": "(in) helpers", "tr": "nāṣiran", "audio": "wbw/072_024_009.mp3"}, {"type": "word", "ar": "وَأَقَلُّ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َأَقَلُّ", "en": "and fewer", "tr": "wa-aqallu", "audio": "wbw/072_024_010.mp3"}, {"type": "word", "ar": "عَدَدًۭا", "tajweed": "عَدَدًا", "en": "(in) number", "tr": "ʿadadan", "audio": "wbw/072_024_011.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "72:25", "juz": 29, "page": 573, "side_trans": "Say, \"I do not know if what you are promised is near or if my Lord will grant for it a [long] period.\"", "words": [{"type": "word", "ar": "قُلْ", "tajweed": "قُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/072_025_001.mp3"}, {"type": "word", "ar": "إِنْ", "tajweed": "إِنۡ", "en": "Not", "tr": "in", "audio": "wbw/072_025_002.mp3"}, {"type": "word", "ar": "أَدْرِىٓ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>ر<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "I know", "tr": "adrī", "audio": "wbw/072_025_003.mp3"}, {"type": "word", "ar": "أَقَرِيبٌۭ", "tajweed": "أَقَرِي<rule class=idgham_ghunnah>بٌ</rule>", "en": "whether is near", "tr": "aqarībun", "audio": "wbw/072_025_004.mp3"}, {"type": "word", "ar": "مَّا", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّا", "en": "what", "tr": "mā", "audio": "wbw/072_025_005.mp3"}, {"type": "word", "ar": "تُوعَدُونَ", "tajweed": "تُوعَدُونَ", "en": "you are promised", "tr": "tūʿadūna", "audio": "wbw/072_025_006.mp3"}, {"type": "word", "ar": "أَمْ", "tajweed": "أَمۡ", "en": "or (whether)", "tr": "am", "audio": "wbw/072_025_007.mp3"}, {"type": "word", "ar": "يَجْعَلُ", "tajweed": "يَ<rule class=qalaqah>جۡ</rule>عَلُ", "en": "will appoint", "tr": "yajʿalu", "audio": "wbw/072_025_008.mp3"}, {"type": "word", "ar": "لَهُۥ", "tajweed": "لَهُ<rule class=madda_normal>ۥ</rule>", "en": "for it", "tr": "lahu", "audio": "wbw/072_025_009.mp3"}, {"type": "word", "ar": "رَبِّىٓ", "tajweed": "رَبّ<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "my Lord", "tr": "rabbī", "audio": "wbw/072_025_010.mp3"}, {"type": "word", "ar": "أَمَدًا", "tajweed": "أَمَدًا", "en": "a (distant) term", "tr": "amadan", "audio": "wbw/072_025_011.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "72:26", "juz": 29, "page": 573, "side_trans": "[He is] Knower of the unseen, and He does not disclose His [knowledge of the] unseen to anyone", "words": [{"type": "word", "ar": "عَـٰلِمُ", "tajweed": "عَ<rule class=madda_normal>ـٰ</rule>لِمُ", "en": "(The) All-Knower", "tr": "ʿālimu", "audio": "wbw/072_026_001.mp3"}, {"type": "word", "ar": "ٱلْغَيْبِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡغَيۡبِ", "en": "(of) the unseen", "tr": "l-ghaybi", "audio": "wbw/072_026_002.mp3"}, {"type": "word", "ar": "فَلَا", "tajweed": "فَلَا", "en": "so not", "tr": "falā", "audio": "wbw/072_026_003.mp3"}, {"type": "word", "ar": "يُظْهِرُ", "tajweed": "يُظۡهِرُ", "en": "He reveals", "tr": "yuẓ'hiru", "audio": "wbw/072_026_004.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "from", "tr": "ʿalā", "audio": "wbw/072_026_005.mp3"}, {"type": "word", "ar": "غَيْبِهِۦٓ", "tajweed": "غَيۡبِه<rule class=madda_obligatory_monfasel>ِۦٓ</rule>", "en": "His unseen", "tr": "ghaybihi", "audio": "wbw/072_026_006.mp3"}, {"type": "word", "ar": "أَحَدًا", "tajweed": "أَحَدًا", "en": "(to) anyone", "tr": "aḥadan", "audio": "wbw/072_026_007.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "72:27", "juz": 29, "page": 573, "side_trans": "Except whom He has approved of messengers, and indeed, He sends before him [i.e., each messenger] and behind him observers", "words": [{"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "Except", "tr": "illā", "audio": "wbw/072_027_001.mp3"}, {"type": "word", "ar": "مَنِ", "tajweed": "مَنِ", "en": "whom", "tr": "mani", "audio": "wbw/072_027_002.mp3"}, {"type": "word", "ar": "ٱرْتَضَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>رۡتَضَىٰ", "en": "He has approved", "tr": "ir'taḍā", "audio": "wbw/072_027_003.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_wo_ghunnah>ِن</rule>", "en": "of", "tr": "min", "audio": "wbw/072_027_004.mp3"}, {"type": "word", "ar": "رَّسُولٍۢ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّسُو<rule class=ikhafa>لٍ</rule>", "en": "a Messenger", "tr": "rasūlin", "audio": "wbw/072_027_005.mp3"}, {"type": "word", "ar": "فَإِنَّهُۥ", "tajweed": "<rule class=ikhafa>ف</rule>َإِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "and indeed, He", "tr": "fa-innahu", "audio": "wbw/072_027_006.mp3"}, {"type": "word", "ar": "يَسْلُكُ", "tajweed": "يَسۡلُكُ", "en": "makes to march", "tr": "yasluku", "audio": "wbw/072_027_007.mp3"}, {"type": "word", "ar": "مِنۢ", "tajweed": "م<rule class=iqlab>ِنۢ</rule>", "en": "from", "tr": "min", "audio": "wbw/072_027_008.mp3"}, {"type": "word", "ar": "بَيْنِ", "tajweed": "<rule class=iqlab>ب</rule>َيۡنِ", "en": "before", "tr": "bayni", "audio": "wbw/072_027_009.mp3"}, {"type": "word", "ar": "يَدَيْهِ", "tajweed": "يَدَيۡهِ", "en": "him", "tr": "yadayhi", "audio": "wbw/072_027_010.mp3"}, {"type": "word", "ar": "وَمِنْ", "tajweed": "وَمِنۡ", "en": "and from", "tr": "wamin", "audio": "wbw/072_027_011.mp3"}, {"type": "word", "ar": "خَلْفِهِۦ", "tajweed": "خَلۡفِه<rule class=madda_normal>ِۦ</rule>", "en": "behind him", "tr": "khalfihi", "audio": "wbw/072_027_012.mp3"}, {"type": "word", "ar": "رَصَدًۭا", "tajweed": "رَصَدًا", "en": "a guard", "tr": "raṣadan", "audio": "wbw/072_027_013.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "72:28", "juz": 29, "page": 573, "side_trans": "That he [i.e., Muḥammad (ﷺ)] may know that they have conveyed the messages of their Lord; and He has encompassed whatever is with them and has enumerated all things in number.", "words": [{"type": "word", "ar": "لِّيَعْلَمَ", "tajweed": "لِّيَعۡلَمَ", "en": "That He may make evident", "tr": "liyaʿlama", "audio": "wbw/072_028_001.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أَ<rule class=ikhafa>ن</rule>", "en": "that", "tr": "an", "audio": "wbw/072_028_002.mp3"}, {"type": "word", "ar": "قَدْ", "tajweed": "<rule class=ikhafa>ق</rule>َ<rule class=qalaqah>دۡ</rule>", "en": "indeed", "tr": "qad", "audio": "wbw/072_028_003.mp3"}, {"type": "word", "ar": "أَبْلَغُوا۟", "tajweed": "أَ<rule class=qalaqah>بۡ</rule>لَغُو<rule class=slnt>اۡ</rule>", "en": "they have conveyed", "tr": "ablaghū", "audio": "wbw/072_028_004.mp3"}, {"type": "word", "ar": "رِسَـٰلَـٰتِ", "tajweed": "رِسَ<rule class=madda_normal>ـٰ</rule>لَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "(the) Messages", "tr": "risālāti", "audio": "wbw/072_028_005.mp3"}, {"type": "word", "ar": "رَبِّهِمْ", "tajweed": "رَبِّهِمۡ", "en": "(of) their Lord", "tr": "rabbihim", "audio": "wbw/072_028_006.mp3"}, {"type": "word", "ar": "وَأَحَاطَ", "tajweed": "وَأَحَاطَ", "en": "and He has encompassed", "tr": "wa-aḥāṭa", "audio": "wbw/072_028_007.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "بِمَا", "en": "what", "tr": "bimā", "audio": "wbw/072_028_008.mp3"}, {"type": "word", "ar": "لَدَيْهِمْ", "tajweed": "لَدَيۡهِمۡ", "en": "(is) with them", "tr": "ladayhim", "audio": "wbw/072_028_009.mp3"}, {"type": "word", "ar": "وَأَحْصَىٰ", "tajweed": "وَأَحۡصَىٰ", "en": "and He takes account", "tr": "wa-aḥṣā", "audio": "wbw/072_028_010.mp3"}, {"type": "word", "ar": "كُلَّ", "tajweed": "كُلَّ", "en": "(of) all", "tr": "kulla", "audio": "wbw/072_028_011.mp3"}, {"type": "word", "ar": "شَىْءٍ", "tajweed": "شَىۡءٍ", "en": "things", "tr": "shayin", "audio": "wbw/072_028_012.mp3"}, {"type": "word", "ar": "عَدَدًۢا", "tajweed": "عَدَدَۢا", "en": "(in) number", "tr": "ʿadadan", "audio": "wbw/072_028_013.mp3"}, {"type": "end", "num": "٢٨"}]}]