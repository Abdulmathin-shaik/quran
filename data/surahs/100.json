[{"id": 1, "key": "100:1", "juz": 30, "page": 599, "side_trans": "By the racers, panting,", "words": [{"type": "word", "ar": "وَٱلْعَـٰدِيَـٰتِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡعَ<rule class=madda_normal>ـٰ</rule>دِيَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "By the racers", "tr": "wal-ʿādiyāti", "audio": "wbw/100_001_001.mp3"}, {"type": "word", "ar": "ضَبْحًۭا", "tajweed": "ضَ<rule class=qalaqah>بۡ</rule>حًا", "en": "panting", "tr": "ḍabḥan", "audio": "wbw/100_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "100:2", "juz": 30, "page": 599, "side_trans": "And the producers of sparks [when] striking", "words": [{"type": "word", "ar": "فَٱلْمُورِيَـٰتِ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>لۡمُورِيَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "And the producers of sparks", "tr": "fal-mūriyāti", "audio": "wbw/100_002_001.mp3"}, {"type": "word", "ar": "قَدْحًۭا", "tajweed": "قَ<rule class=qalaqah>دۡ</rule>حًا", "en": "striking", "tr": "qadḥan", "audio": "wbw/100_002_002.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "100:3", "juz": 30, "page": 599, "side_trans": "And the chargers at dawn,", "words": [{"type": "word", "ar": "فَٱلْمُغِيرَٰتِ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>لۡمُغِير<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِ", "en": "And the chargers", "tr": "fal-mughīrāti", "audio": "wbw/100_003_001.mp3"}, {"type": "word", "ar": "صُبْحًۭا", "tajweed": "صُ<rule class=qalaqah>بۡ</rule>حًا", "en": "(at) dawn", "tr": "ṣub'ḥan", "audio": "wbw/100_003_002.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "100:4", "juz": 30, "page": 599, "side_trans": "Stirring up thereby [clouds of] dust,", "words": [{"type": "word", "ar": "فَأَثَرْنَ", "tajweed": "فَأَثَرۡنَ", "en": "Then raise", "tr": "fa-atharna", "audio": "wbw/100_004_001.mp3"}, {"type": "word", "ar": "بِهِۦ", "tajweed": "بِه<rule class=madda_normal>ِۦ</rule>", "en": "thereby", "tr": "bihi", "audio": "wbw/100_004_002.mp3"}, {"type": "word", "ar": "نَقْعًۭا", "tajweed": "نَ<rule class=qalaqah>قۡ</rule>عًا", "en": "dust", "tr": "naqʿan", "audio": "wbw/100_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "100:5", "juz": 30, "page": 599, "side_trans": "Arriving thereby in the center collectively,", "words": [{"type": "word", "ar": "فَوَسَطْنَ", "tajweed": "فَوَسَ<rule class=qalaqah>طۡ</rule>نَ", "en": "Then penetrate (in the) center", "tr": "fawasaṭna", "audio": "wbw/100_005_001.mp3"}, {"type": "word", "ar": "بِهِۦ", "tajweed": "بِه<rule class=madda_normal>ِۦ</rule>", "en": "thereby", "tr": "bihi", "audio": "wbw/100_005_002.mp3"}, {"type": "word", "ar": "جَمْعًا", "tajweed": "جَمۡعًا", "en": "collectively", "tr": "jamʿan", "audio": "wbw/100_005_003.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "100:6", "juz": 30, "page": 600, "side_trans": "Indeed mankind, to his Lord, is ungrateful.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/100_006_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نَ", "en": "mankind", "tr": "l-insāna", "audio": "wbw/100_006_002.mp3"}, {"type": "word", "ar": "لِرَبِّهِۦ", "tajweed": "لِرَبِّه<rule class=madda_normal>ِۦ</rule>", "en": "to his Lord", "tr": "lirabbihi", "audio": "wbw/100_006_003.mp3"}, {"type": "word", "ar": "لَكَنُودٌۭ", "tajweed": "لَكَن<rule class=madda_permissible>ُو</rule><rule class=qalaqah>د</rule>ٌ", "en": "(is) surely ungrateful", "tr": "lakanūdun", "audio": "wbw/100_006_004.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "100:7", "juz": 30, "page": 600, "side_trans": "And indeed, he is to that a witness.", "words": [{"type": "word", "ar": "وَإِنَّهُۥ", "tajweed": "وَإِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "And indeed, he", "tr": "wa-innahu", "audio": "wbw/100_007_001.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "on", "tr": "ʿalā", "audio": "wbw/100_007_002.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "that", "tr": "dhālika", "audio": "wbw/100_007_003.mp3"}, {"type": "word", "ar": "لَشَهِيدٌۭ", "tajweed": "لَشَه<rule class=madda_permissible>ِي</rule><rule class=qalaqah>د</rule>ٌ", "en": "surely (is) a witness", "tr": "lashahīdun", "audio": "wbw/100_007_004.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "100:8", "juz": 30, "page": 600, "side_trans": "And indeed he is, in love of wealth, intense.", "words": [{"type": "word", "ar": "وَإِنَّهُۥ", "tajweed": "وَإِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "And indeed he", "tr": "wa-innahu", "audio": "wbw/100_008_001.mp3"}, {"type": "word", "ar": "لِحُبِّ", "tajweed": "لِحُبِّ", "en": "in (the) love", "tr": "liḥubbi", "audio": "wbw/100_008_002.mp3"}, {"type": "word", "ar": "ٱلْخَيْرِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡخَيۡرِ", "en": "(of) wealth", "tr": "l-khayri", "audio": "wbw/100_008_003.mp3"}, {"type": "word", "ar": "لَشَدِيدٌ", "tajweed": "لَشَد<rule class=madda_permissible>ِي</rule><rule class=qalaqah>د</rule>ٌ", "en": "(is) surely intense", "tr": "lashadīdun", "audio": "wbw/100_008_004.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "100:9", "juz": 30, "page": 600, "side_trans": "But does he not know that when the contents of the graves are scattered", "words": [{"type": "word", "ar": "۞ أَفَلَا", "tajweed": "۞أَفَلَا", "en": "But does not", "tr": "afalā", "audio": "wbw/100_009_002.mp3"}, {"type": "word", "ar": "يَعْلَمُ", "tajweed": "يَعۡلَمُ", "en": "he know", "tr": "yaʿlamu", "audio": "wbw/100_009_003.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/100_009_004.mp3"}, {"type": "word", "ar": "بُعْثِرَ", "tajweed": "بُعۡثِرَ", "en": "will be scattered", "tr": "buʿ'thira", "audio": "wbw/100_009_005.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/100_009_006.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(is) in", "tr": "fī", "audio": "wbw/100_009_007.mp3"}, {"type": "word", "ar": "ٱلْقُبُورِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقُب<rule class=madda_permissible>ُو</rule>رِ", "en": "the graves", "tr": "l-qubūri", "audio": "wbw/100_009_008.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "100:10", "juz": 30, "page": 600, "side_trans": "And that within the breasts is obtained,", "words": [{"type": "word", "ar": "وَحُصِّلَ", "tajweed": "وَحُصِّلَ", "en": "And is made apparent", "tr": "waḥuṣṣila", "audio": "wbw/100_010_001.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/100_010_002.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(is) in", "tr": "fī", "audio": "wbw/100_010_003.mp3"}, {"type": "word", "ar": "ٱلصُّدُورِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صُّد<rule class=madda_permissible>ُو</rule>رِ", "en": "the breasts", "tr": "l-ṣudūri", "audio": "wbw/100_010_004.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "100:11", "juz": 30, "page": 600, "side_trans": "Indeed, their Lord with them, that Day, is [fully] Aware.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/100_011_001.mp3"}, {"type": "word", "ar": "رَبَّهُم", "tajweed": "رَبَّه<rule class=ikhafa_shafawi>ُم</rule>", "en": "their Lord", "tr": "rabbahum", "audio": "wbw/100_011_002.mp3"}, {"type": "word", "ar": "بِهِمْ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِهِمۡ", "en": "about them", "tr": "bihim", "audio": "wbw/100_011_003.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "يَوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/100_011_004.mp3"}, {"type": "word", "ar": "لَّخَبِيرٌۢ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّخَب<rule class=madda_permissible>ِي</rule>رُۢ", "en": "(is) surely All-Aware", "tr": "lakhabīrun", "audio": "wbw/100_011_005.mp3"}, {"type": "end", "num": "١١"}]}]