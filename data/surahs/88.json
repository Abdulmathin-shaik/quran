[{"id": 1, "key": "88:1", "juz": 30, "page": 592, "side_trans": "Has there reached you the report of the Overwhelming [event]?", "words": [{"type": "word", "ar": "هَلْ", "tajweed": "هَلۡ", "en": "Has", "tr": "hal", "audio": "wbw/088_001_001.mp3"}, {"type": "word", "ar": "أَتَىٰكَ", "tajweed": "أَتَ<rule class=madda_normal>ـٰ</rule>كَ", "en": "(there) come to you", "tr": "atāka", "audio": "wbw/088_001_002.mp3"}, {"type": "word", "ar": "حَدِيثُ", "tajweed": "حَدِيثُ", "en": "(the) news", "tr": "ḥadīthu", "audio": "wbw/088_001_003.mp3"}, {"type": "word", "ar": "ٱلْغَـٰشِيَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡغَ<rule class=madda_normal>ـٰ</rule>شِيَةِ", "en": "(of) the Overwhelming", "tr": "l-ghāshiyati", "audio": "wbw/088_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "88:2", "juz": 30, "page": 592, "side_trans": "[Some] faces, that Day, will be humbled,", "words": [{"type": "word", "ar": "وُجُوهٌۭ", "tajweed": "وُجُو<rule class=idgham_ghunnah>هٌ</rule>", "en": "Faces", "tr": "wujūhun", "audio": "wbw/088_002_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِذٍ", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/088_002_002.mp3"}, {"type": "word", "ar": "خَـٰشِعَةٌ", "tajweed": "خَ<rule class=madda_normal>ـٰ</rule>شِعَةٌ", "en": "(will be) humbled", "tr": "khāshiʿatun", "audio": "wbw/088_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "88:3", "juz": 30, "page": 592, "side_trans": "Working [hard] and exhausted.", "words": [{"type": "word", "ar": "عَامِلَةٌۭ", "tajweed": "عَامِلَ<rule class=idgham_ghunnah>ةٌ</rule>", "en": "Laboring", "tr": "ʿāmilatun", "audio": "wbw/088_003_001.mp3"}, {"type": "word", "ar": "نَّاصِبَةٌۭ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>َّاصِبَةٌ", "en": "exhausted", "tr": "nāṣibatun", "audio": "wbw/088_003_002.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "88:4", "juz": 30, "page": 592, "side_trans": "They will [enter to] burn in an intensely hot Fire.", "words": [{"type": "word", "ar": "تَصْلَىٰ", "tajweed": "تَصۡلَىٰ", "en": "They will burn", "tr": "taṣlā", "audio": "wbw/088_004_001.mp3"}, {"type": "word", "ar": "نَارًا", "tajweed": "نَارًا", "en": "(in) a Fire", "tr": "nāran", "audio": "wbw/088_004_002.mp3"}, {"type": "word", "ar": "حَامِيَةًۭ", "tajweed": "حَامِيَةً", "en": "intensely hot", "tr": "ḥāmiyatan", "audio": "wbw/088_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "88:5", "juz": 30, "page": 592, "side_trans": "They will be given drink from a boiling spring.", "words": [{"type": "word", "ar": "تُسْقَىٰ", "tajweed": "تُسۡقَىٰ", "en": "They will be given to drink", "tr": "tus'qā", "audio": "wbw/088_005_001.mp3"}, {"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "from", "tr": "min", "audio": "wbw/088_005_002.mp3"}, {"type": "word", "ar": "عَيْنٍ", "tajweed": "عَيۡنٍ", "en": "a spring", "tr": "ʿaynin", "audio": "wbw/088_005_003.mp3"}, {"type": "word", "ar": "ءَانِيَةٍۢ", "tajweed": "ءَانِيَةٍ", "en": "boiling", "tr": "āniyatin", "audio": "wbw/088_005_004.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "88:6", "juz": 30, "page": 592, "side_trans": "For them there will be no food except from a poisonous, thorny plant", "words": [{"type": "word", "ar": "لَّيْسَ", "tajweed": "لَّيۡسَ", "en": "Not is", "tr": "laysa", "audio": "wbw/088_006_001.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "for them", "tr": "lahum", "audio": "wbw/088_006_002.mp3"}, {"type": "word", "ar": "طَعَامٌ", "tajweed": "طَعَامٌ", "en": "food", "tr": "ṭaʿāmun", "audio": "wbw/088_006_003.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/088_006_004.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/088_006_005.mp3"}, {"type": "word", "ar": "ضَرِيعٍۢ", "tajweed": "<rule class=ikhafa>ض</rule>َر<rule class=madda_permissible>ِي</rule>عٍ", "en": "a bitter thorny plant", "tr": "ḍarīʿin", "audio": "wbw/088_006_006.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "88:7", "juz": 30, "page": 592, "side_trans": "Which neither nourishes nor avails against hunger.", "words": [{"type": "word", "ar": "لَّا", "tajweed": "لَّا", "en": "Not", "tr": "lā", "audio": "wbw/088_007_001.mp3"}, {"type": "word", "ar": "يُسْمِنُ", "tajweed": "يُسۡمِنُ", "en": "it nourishes", "tr": "yus'minu", "audio": "wbw/088_007_002.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "and not", "tr": "walā", "audio": "wbw/088_007_003.mp3"}, {"type": "word", "ar": "يُغْنِى", "tajweed": "يُغۡنِى", "en": "it avails", "tr": "yugh'nī", "audio": "wbw/088_007_004.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/088_007_005.mp3"}, {"type": "word", "ar": "جُوعٍۢ", "tajweed": "<rule class=ikhafa>ج</rule><rule class=madda_permissible>ُو</rule>عٍ", "en": "hunger", "tr": "jūʿin", "audio": "wbw/088_007_006.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "88:8", "juz": 30, "page": 592, "side_trans": "[Other] faces, that Day, will show pleasure.", "words": [{"type": "word", "ar": "وُجُوهٌۭ", "tajweed": "وُجُو<rule class=idgham_ghunnah>هٌ</rule>", "en": "Faces", "tr": "wujūhun", "audio": "wbw/088_008_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/088_008_002.mp3"}, {"type": "word", "ar": "نَّاعِمَةٌۭ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>َّاعِمَةٌ", "en": "(will be) joyful", "tr": "nāʿimatun", "audio": "wbw/088_008_003.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "88:9", "juz": 30, "page": 592, "side_trans": "With their effort [they are] satisfied", "words": [{"type": "word", "ar": "لِّسَعْيِهَا", "tajweed": "لِّسَعۡيِهَا", "en": "With their effort", "tr": "lisaʿyihā", "audio": "wbw/088_009_001.mp3"}, {"type": "word", "ar": "رَاضِيَةٌۭ", "tajweed": "رَاضِيَةٌ", "en": "satisfied", "tr": "rāḍiyatun", "audio": "wbw/088_009_002.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "88:10", "juz": 30, "page": 592, "side_trans": "In an elevated garden,", "words": [{"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "In", "tr": "fī", "audio": "wbw/088_010_001.mp3"}, {"type": "word", "ar": "جَنَّةٍ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َةٍ", "en": "a garden", "tr": "jannatin", "audio": "wbw/088_010_002.mp3"}, {"type": "word", "ar": "عَالِيَةٍۢ", "tajweed": "عَالِيَةٍ", "en": "elevated", "tr": "ʿāliyatin", "audio": "wbw/088_010_003.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "88:11", "juz": 30, "page": 592, "side_trans": "Wherein they will hear no unsuitable speech.", "words": [{"type": "word", "ar": "لَّا", "tajweed": "لَّا", "en": "Not", "tr": "lā", "audio": "wbw/088_011_001.mp3"}, {"type": "word", "ar": "تَسْمَعُ", "tajweed": "تَسۡمَعُ", "en": "they will hear", "tr": "tasmaʿu", "audio": "wbw/088_011_002.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/088_011_003.mp3"}, {"type": "word", "ar": "لَـٰغِيَةًۭ", "tajweed": "لَ<rule class=madda_normal>ـٰ</rule>غِيَةً", "en": "vain talk", "tr": "lāghiyatan", "audio": "wbw/088_011_004.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "88:12", "juz": 30, "page": 592, "side_trans": "Within it is a flowing spring.", "words": [{"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "Therein", "tr": "fīhā", "audio": "wbw/088_012_001.mp3"}, {"type": "word", "ar": "عَيْنٌۭ", "tajweed": "عَيۡ<rule class=ikhafa>نٌ</rule>", "en": "(will be) a spring", "tr": "ʿaynun", "audio": "wbw/088_012_002.mp3"}, {"type": "word", "ar": "جَارِيَةٌۭ", "tajweed": "<rule class=ikhafa>ج</rule>َارِيَةٌ", "en": "flowing", "tr": "jāriyatun", "audio": "wbw/088_012_003.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "88:13", "juz": 30, "page": 592, "side_trans": "Within it are couches raised high", "words": [{"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "Therein", "tr": "fīhā", "audio": "wbw/088_013_001.mp3"}, {"type": "word", "ar": "سُرُرٌۭ", "tajweed": "سُرُ<rule class=idgham_ghunnah>رٌ</rule>", "en": "(will be) thrones", "tr": "sururun", "audio": "wbw/088_013_002.mp3"}, {"type": "word", "ar": "مَّرْفُوعَةٌۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّرۡفُوعَةٌ", "en": "raised high", "tr": "marfūʿatun", "audio": "wbw/088_013_003.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "88:14", "juz": 30, "page": 592, "side_trans": "And cups put in place", "words": [{"type": "word", "ar": "وَأَكْوَابٌۭ", "tajweed": "وَأَكۡوَا<rule class=idgham_ghunnah>بٌ</rule>", "en": "And cups", "tr": "wa-akwābun", "audio": "wbw/088_014_001.mp3"}, {"type": "word", "ar": "مَّوْضُوعَةٌۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّوۡضُوعَةٌ", "en": "put in place", "tr": "mawḍūʿatun", "audio": "wbw/088_014_002.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "88:15", "juz": 30, "page": 592, "side_trans": "And cushions lined up", "words": [{"type": "word", "ar": "وَنَمَارِقُ", "tajweed": "وَنَمَارِقُ", "en": "And cushions", "tr": "wanamāriqu", "audio": "wbw/088_015_001.mp3"}, {"type": "word", "ar": "مَصْفُوفَةٌۭ", "tajweed": "مَصۡفُوفَةٌ", "en": "lined up", "tr": "maṣfūfatun", "audio": "wbw/088_015_002.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "88:16", "juz": 30, "page": 592, "side_trans": "And carpets spread around.", "words": [{"type": "word", "ar": "وَزَرَابِىُّ", "tajweed": "وَزَرَابِىُّ", "en": "And carpets", "tr": "wazarābiyyu", "audio": "wbw/088_016_001.mp3"}, {"type": "word", "ar": "مَبْثُوثَةٌ", "tajweed": "مَ<rule class=qalaqah>بۡ</rule>ثُوثَةٌ", "en": "spread out", "tr": "mabthūthatun", "audio": "wbw/088_016_002.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "88:17", "juz": 30, "page": 592, "side_trans": "Then do they not look at the camels - how they are created?", "words": [{"type": "word", "ar": "أَفَلَا", "tajweed": "أَفَلَا", "en": "Then do not", "tr": "afalā", "audio": "wbw/088_017_001.mp3"}, {"type": "word", "ar": "يَنظُرُونَ", "tajweed": "يَ<rule class=ikhafa>نظ</rule>ُرُونَ", "en": "they look", "tr": "yanẓurūna", "audio": "wbw/088_017_002.mp3"}, {"type": "word", "ar": "إِلَى", "tajweed": "إِلَى", "en": "towards", "tr": "ilā", "audio": "wbw/088_017_003.mp3"}, {"type": "word", "ar": "ٱلْإِبِلِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِبِلِ", "en": "the camels", "tr": "l-ibili", "audio": "wbw/088_017_004.mp3"}, {"type": "word", "ar": "كَيْفَ", "tajweed": "كَيۡفَ", "en": "how", "tr": "kayfa", "audio": "wbw/088_017_005.mp3"}, {"type": "word", "ar": "خُلِقَتْ", "tajweed": "خُلِقَتۡ", "en": "they are created", "tr": "khuliqat", "audio": "wbw/088_017_006.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "88:18", "juz": 30, "page": 592, "side_trans": "And at the sky - how it is raised?", "words": [{"type": "word", "ar": "وَإِلَى", "tajweed": "وَإِلَى", "en": "And towards", "tr": "wa-ilā", "audio": "wbw/088_018_001.mp3"}, {"type": "word", "ar": "ٱلسَّمَآءِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءِ", "en": "the sky", "tr": "l-samāi", "audio": "wbw/088_018_002.mp3"}, {"type": "word", "ar": "كَيْفَ", "tajweed": "كَيۡفَ", "en": "how", "tr": "kayfa", "audio": "wbw/088_018_003.mp3"}, {"type": "word", "ar": "رُفِعَتْ", "tajweed": "رُفِعَتۡ", "en": "it is raised", "tr": "rufiʿat", "audio": "wbw/088_018_004.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "88:19", "juz": 30, "page": 592, "side_trans": "And at the mountains - how they are erected?", "words": [{"type": "word", "ar": "وَإِلَى", "tajweed": "وَإِلَى", "en": "And towards", "tr": "wa-ilā", "audio": "wbw/088_019_001.mp3"}, {"type": "word", "ar": "ٱلْجِبَالِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجِبَالِ", "en": "the mountains", "tr": "l-jibāli", "audio": "wbw/088_019_002.mp3"}, {"type": "word", "ar": "كَيْفَ", "tajweed": "كَيۡفَ", "en": "how", "tr": "kayfa", "audio": "wbw/088_019_003.mp3"}, {"type": "word", "ar": "نُصِبَتْ", "tajweed": "نُصِبَتۡ", "en": "they are fixed", "tr": "nuṣibat", "audio": "wbw/088_019_004.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "88:20", "juz": 30, "page": 592, "side_trans": "And at the earth - how it is spread out?", "words": [{"type": "word", "ar": "وَإِلَى", "tajweed": "وَإِلَى", "en": "And towards", "tr": "wa-ilā", "audio": "wbw/088_020_001.mp3"}, {"type": "word", "ar": "ٱلْأَرْضِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "the earth", "tr": "l-arḍi", "audio": "wbw/088_020_002.mp3"}, {"type": "word", "ar": "كَيْفَ", "tajweed": "كَيۡفَ", "en": "how", "tr": "kayfa", "audio": "wbw/088_020_003.mp3"}, {"type": "word", "ar": "سُطِحَتْ", "tajweed": "سُطِحَتۡ", "en": "it is spread out", "tr": "suṭiḥat", "audio": "wbw/088_020_004.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "88:21", "juz": 30, "page": 592, "side_trans": "So remind, [O Muḥammad]; you are only a reminder.", "words": [{"type": "word", "ar": "فَذَكِّرْ", "tajweed": "فَذَكِّرۡ", "en": "So remind", "tr": "fadhakkir", "audio": "wbw/088_021_001.mp3"}, {"type": "word", "ar": "إِنَّمَآ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "only", "tr": "innamā", "audio": "wbw/088_021_002.mp3"}, {"type": "word", "ar": "أَنتَ", "tajweed": "أَ<rule class=ikhafa>نت</rule>َ", "en": "you", "tr": "anta", "audio": "wbw/088_021_003.mp3"}, {"type": "word", "ar": "مُذَكِّرٌۭ", "tajweed": "مُذَكِّرٌ", "en": "(are) a reminder", "tr": "mudhakkirun", "audio": "wbw/088_021_004.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "88:22", "juz": 30, "page": 592, "side_trans": "You are not over them a controller.", "words": [{"type": "word", "ar": "لَّسْتَ", "tajweed": "لَّسۡتَ", "en": "You are not", "tr": "lasta", "audio": "wbw/088_022_001.mp3"}, {"type": "word", "ar": "عَلَيْهِم", "tajweed": "عَلَيۡه<rule class=ikhafa_shafawi>ِم</rule>", "en": "over them", "tr": "ʿalayhim", "audio": "wbw/088_022_002.mp3"}, {"type": "word", "ar": "بِمُصَيْطِرٍ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِمُصَيۡطِرٍ", "en": "a controller", "tr": "bimuṣayṭirin", "audio": "wbw/088_022_003.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "88:23", "juz": 30, "page": 593, "side_trans": "However, he who turns away and disbelieves", "words": [{"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "But", "tr": "illā", "audio": "wbw/088_023_001.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "مَ<rule class=ikhafa>ن</rule>", "en": "whoever", "tr": "man", "audio": "wbw/088_023_002.mp3"}, {"type": "word", "ar": "تَوَلَّىٰ", "tajweed": "<rule class=ikhafa>ت</rule>َوَلَّىٰ", "en": "turns away", "tr": "tawallā", "audio": "wbw/088_023_003.mp3"}, {"type": "word", "ar": "وَكَفَرَ", "tajweed": "وَكَفَرَ", "en": "and disbelieves", "tr": "wakafara", "audio": "wbw/088_023_004.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "88:24", "juz": 30, "page": 593, "side_trans": "Then Allāh will punish him with the greatest punishment.", "words": [{"type": "word", "ar": "فَيُعَذِّبُهُ", "tajweed": "فَيُعَذِّبُهُ", "en": "Then will punish him", "tr": "fayuʿadhibuhu", "audio": "wbw/088_024_001.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/088_024_002.mp3"}, {"type": "word", "ar": "ٱلْعَذَابَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَذَابَ", "en": "(with) the punishment", "tr": "l-ʿadhāba", "audio": "wbw/088_024_003.mp3"}, {"type": "word", "ar": "ٱلْأَكْبَرَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَكۡبَرَ", "en": "greatest", "tr": "l-akbara", "audio": "wbw/088_024_004.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "88:25", "juz": 30, "page": 593, "side_trans": "Indeed, to Us is their return.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/088_025_001.mp3"}, {"type": "word", "ar": "إِلَيْنَآ", "tajweed": "إِلَيۡن<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "to Us", "tr": "ilaynā", "audio": "wbw/088_025_002.mp3"}, {"type": "word", "ar": "إِيَابَهُمْ", "tajweed": "إِيَابَهُمۡ", "en": "(will be) their return", "tr": "iyābahum", "audio": "wbw/088_025_003.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "88:26", "juz": 30, "page": 593, "side_trans": "Then indeed, upon Us is their account.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/088_026_001.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "indeed", "tr": "inna", "audio": "wbw/088_026_002.mp3"}, {"type": "word", "ar": "عَلَيْنَا", "tajweed": "عَلَيۡنَا", "en": "upon Us", "tr": "ʿalaynā", "audio": "wbw/088_026_003.mp3"}, {"type": "word", "ar": "حِسَابَهُم", "tajweed": "حِسَابَهُم", "en": "(is) their account", "tr": "ḥisābahum", "audio": "wbw/088_026_004.mp3"}, {"type": "end", "num": "٢٦"}]}]