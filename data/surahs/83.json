[{"id": 1, "key": "83:1", "juz": 30, "page": 587, "side_trans": "Woe to those who give less [than due],", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_wo_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/083_001_001.mp3"}, {"type": "word", "ar": "لِّلْمُطَفِّفِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُطَفِّف<rule class=madda_permissible>ِي</rule>نَ", "en": "to those who give less", "tr": "lil'muṭaffifīna", "audio": "wbw/083_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "83:2", "juz": 30, "page": 587, "side_trans": "Who, when they take a measure from people, take in full.", "words": [{"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "ٱلَّذِينَ", "en": "Those who", "tr": "alladhīna", "audio": "wbw/083_002_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/083_002_002.mp3"}, {"type": "word", "ar": "ٱكْتَالُوا۟", "tajweed": "<rule class=ham_wasl>ٱ</rule>كۡتَالُو<rule class=slnt>اۡ</rule>", "en": "they take a measure", "tr": "ik'tālū", "audio": "wbw/083_002_003.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "from", "tr": "ʿalā", "audio": "wbw/083_002_004.mp3"}, {"type": "word", "ar": "ٱلنَّاسِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َاسِ", "en": "the people", "tr": "l-nāsi", "audio": "wbw/083_002_005.mp3"}, {"type": "word", "ar": "يَسْتَوْفُونَ", "tajweed": "يَسۡتَوۡف<rule class=madda_permissible>ُو</rule>نَ", "en": "they take in full", "tr": "yastawfūna", "audio": "wbw/083_002_006.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "83:3", "juz": 30, "page": 587, "side_trans": "But if they give by measure or by weight to them, they cause loss.", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "But when", "tr": "wa-idhā", "audio": "wbw/083_003_001.mp3"}, {"type": "word", "ar": "كَالُوهُمْ", "tajweed": "كَالُوهُمۡ", "en": "they give by measure (to) them", "tr": "kālūhum", "audio": "wbw/083_003_002.mp3"}, {"type": "word", "ar": "أَو", "tajweed": "أَو", "en": "or", "tr": "aw", "audio": "wbw/083_003_003.mp3"}, {"type": "word", "ar": "وَّزَنُوهُمْ", "tajweed": "وَّزَنُوهُمۡ", "en": "they weigh (for) them", "tr": "wazanūhum", "audio": "wbw/083_003_004.mp3"}, {"type": "word", "ar": "يُخْسِرُونَ", "tajweed": "يُخۡسِر<rule class=madda_permissible>ُو</rule>نَ", "en": "they give less", "tr": "yukh'sirūna", "audio": "wbw/083_003_005.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "83:4", "juz": 30, "page": 587, "side_trans": "Do they not think that they will be resurrected", "words": [{"type": "word", "ar": "أَلَا", "tajweed": "أَلَا", "en": "Do not", "tr": "alā", "audio": "wbw/083_004_001.mp3"}, {"type": "word", "ar": "يَظُنُّ", "tajweed": "يَظُ<rule class=ghunnah>نّ</rule>ُ", "en": "think", "tr": "yaẓunnu", "audio": "wbw/083_004_002.mp3"}, {"type": "word", "ar": "أُو۟لَـٰٓئِكَ", "tajweed": "أُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَ", "en": "those", "tr": "ulāika", "audio": "wbw/083_004_003.mp3"}, {"type": "word", "ar": "أَنَّهُم", "tajweed": "أَ<rule class=ghunnah>نّ</rule>َه<rule class=idgham_shafawi>ُم</rule>", "en": "that they", "tr": "annahum", "audio": "wbw/083_004_004.mp3"}, {"type": "word", "ar": "مَّبْعُوثُونَ", "tajweed": "<rule class=idgham_shafawi>م</rule>َّ<rule class=qalaqah>بۡ</rule>عُوث<rule class=madda_permissible>ُو</rule>نَ", "en": "(will be) resurrected", "tr": "mabʿūthūna", "audio": "wbw/083_004_005.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "83:5", "juz": 30, "page": 588, "side_trans": "For a tremendous Day -", "words": [{"type": "word", "ar": "لِيَوْمٍ", "tajweed": "لِيَوۡمٍ", "en": "For a Day", "tr": "liyawmin", "audio": "wbw/083_005_001.mp3"}, {"type": "word", "ar": "عَظِيمٍۢ", "tajweed": "عَظ<rule class=madda_permissible>ِي</rule>مٍ", "en": "Great", "tr": "ʿaẓīmin", "audio": "wbw/083_005_002.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "83:6", "juz": 30, "page": 588, "side_trans": "The Day when mankind will stand before the Lord of the worlds?", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(The) Day", "tr": "yawma", "audio": "wbw/083_006_001.mp3"}, {"type": "word", "ar": "يَقُومُ", "tajweed": "يَقُومُ", "en": "will stand", "tr": "yaqūmu", "audio": "wbw/083_006_002.mp3"}, {"type": "word", "ar": "ٱلنَّاسُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َاسُ", "en": "mankind", "tr": "l-nāsu", "audio": "wbw/083_006_003.mp3"}, {"type": "word", "ar": "لِرَبِّ", "tajweed": "لِرَبِّ", "en": "before (the) Lord", "tr": "lirabbi", "audio": "wbw/083_006_004.mp3"}, {"type": "word", "ar": "ٱلْعَـٰلَمِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَ<rule class=madda_normal>ـٰ</rule>لَم<rule class=madda_permissible>ِي</rule>نَ", "en": "(of) the worlds", "tr": "l-ʿālamīna", "audio": "wbw/083_006_005.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "83:7", "juz": 30, "page": 588, "side_trans": "No! Indeed, the record of the wicked is in sijjeen.", "words": [{"type": "word", "ar": "كَلَّآ", "tajweed": "كَلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Nay", "tr": "kallā", "audio": "wbw/083_007_001.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/083_007_002.mp3"}, {"type": "word", "ar": "كِتَـٰبَ", "tajweed": "كِتَ<rule class=madda_normal>ـٰ</rule>بَ", "en": "(the) record", "tr": "kitāba", "audio": "wbw/083_007_003.mp3"}, {"type": "word", "ar": "ٱلْفُجَّارِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفُجَّارِ", "en": "(of) the wicked", "tr": "l-fujāri", "audio": "wbw/083_007_004.mp3"}, {"type": "word", "ar": "لَفِى", "tajweed": "لَفِى", "en": "(is) surely in", "tr": "lafī", "audio": "wbw/083_007_005.mp3"}, {"type": "word", "ar": "سِجِّينٍۢ", "tajweed": "سِجّ<rule class=madda_permissible>ِي</rule>نٍ", "en": "Sijjin", "tr": "sijjīnin", "audio": "wbw/083_007_006.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "83:8", "juz": 30, "page": 588, "side_trans": "And what can make you know what is sijjeen?", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And what", "tr": "wamā", "audio": "wbw/083_008_001.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "can make you know", "tr": "adrāka", "audio": "wbw/083_008_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/083_008_003.mp3"}, {"type": "word", "ar": "سِجِّينٌۭ", "tajweed": "سِجّ<rule class=madda_permissible>ِي</rule>نٌ", "en": "(is) Sijjin", "tr": "sijjīnun", "audio": "wbw/083_008_004.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "83:9", "juz": 30, "page": 588, "side_trans": "It is [their destination recorded in] a register inscribed.", "words": [{"type": "word", "ar": "كِتَـٰبٌۭ", "tajweed": "كِتَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>بٌ</rule>", "en": "A book", "tr": "kitābun", "audio": "wbw/083_009_001.mp3"}, {"type": "word", "ar": "مَّرْقُومٌۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّرۡق<rule class=madda_permissible>ُو</rule>مٌ", "en": "written", "tr": "marqūmun", "audio": "wbw/083_009_002.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "83:10", "juz": 30, "page": 588, "side_trans": "Woe, that Day, to the deniers,", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/083_010_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/083_010_002.mp3"}, {"type": "word", "ar": "لِّلْمُكَذِّبِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُكَذِّب<rule class=madda_permissible>ِي</rule>نَ", "en": "to the deniers", "tr": "lil'mukadhibīna", "audio": "wbw/083_010_003.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "83:11", "juz": 30, "page": 588, "side_trans": "Who deny the Day of Recompense.", "words": [{"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "ٱلَّذِينَ", "en": "Those who", "tr": "alladhīna", "audio": "wbw/083_011_001.mp3"}, {"type": "word", "ar": "يُكَذِّبُونَ", "tajweed": "يُكَذِّبُونَ", "en": "deny", "tr": "yukadhibūna", "audio": "wbw/083_011_002.mp3"}, {"type": "word", "ar": "بِيَوْمِ", "tajweed": "بِيَوۡمِ", "en": "(the) Day", "tr": "biyawmi", "audio": "wbw/083_011_003.mp3"}, {"type": "word", "ar": "ٱلدِّينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دّ<rule class=madda_permissible>ِي</rule>نِ", "en": "(of) the Judgment", "tr": "l-dīni", "audio": "wbw/083_011_004.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "83:12", "juz": 30, "page": 588, "side_trans": "And none deny it except every sinful transgressor.", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/083_012_001.mp3"}, {"type": "word", "ar": "يُكَذِّبُ", "tajweed": "يُكَذِّبُ", "en": "can deny", "tr": "yukadhibu", "audio": "wbw/083_012_002.mp3"}, {"type": "word", "ar": "بِهِۦٓ", "tajweed": "بِه<rule class=madda_obligatory_monfasel>ِۦٓ</rule>", "en": "[of] it", "tr": "bihi", "audio": "wbw/083_012_003.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/083_012_004.mp3"}, {"type": "word", "ar": "كُلُّ", "tajweed": "كُلُّ", "en": "every", "tr": "kullu", "audio": "wbw/083_012_005.mp3"}, {"type": "word", "ar": "مُعْتَدٍ", "tajweed": "مُعۡتَدٍ", "en": "transgressor", "tr": "muʿ'tadin", "audio": "wbw/083_012_006.mp3"}, {"type": "word", "ar": "أَثِيمٍ", "tajweed": "أَث<rule class=madda_permissible>ِي</rule>مٍ", "en": "sinful", "tr": "athīmin", "audio": "wbw/083_012_007.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "83:13", "juz": 30, "page": 588, "side_trans": "When Our verses are recited to him, he says, \"Legends of the former peoples.\"", "words": [{"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/083_013_001.mp3"}, {"type": "word", "ar": "تُتْلَىٰ", "tajweed": "تُتۡلَىٰ", "en": "are recited", "tr": "tut'lā", "audio": "wbw/083_013_002.mp3"}, {"type": "word", "ar": "عَلَيْهِ", "tajweed": "عَلَيۡهِ", "en": "to him", "tr": "ʿalayhi", "audio": "wbw/083_013_003.mp3"}, {"type": "word", "ar": "ءَايَـٰتُنَا", "tajweed": "ءَايَ<rule class=madda_normal>ـٰ</rule>تُنَا", "en": "Our Verses", "tr": "āyātunā", "audio": "wbw/083_013_004.mp3"}, {"type": "word", "ar": "قَالَ", "tajweed": "قَالَ", "en": "he says", "tr": "qāla", "audio": "wbw/083_013_005.mp3"}, {"type": "word", "ar": "أَسَـٰطِيرُ", "tajweed": "أَسَ<rule class=madda_normal>ـٰ</rule>طِيرُ", "en": "Stories", "tr": "asāṭīru", "audio": "wbw/083_013_006.mp3"}, {"type": "word", "ar": "ٱلْأَوَّلِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَوَّل<rule class=madda_permissible>ِي</rule>نَ", "en": "(of) the former (people)", "tr": "l-awalīna", "audio": "wbw/083_013_007.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "83:14", "juz": 30, "page": 588, "side_trans": "No! Rather, the stain has covered their hearts of that which they were earning.", "words": [{"type": "word", "ar": "كَلَّا ۖ", "tajweed": "كَلَّا‌ۖ", "en": "Nay", "tr": "kallā", "audio": "wbw/083_014_001.mp3"}, {"type": "word", "ar": "بَلْ ۜ", "tajweed": "بَلۡۜ", "en": "But", "tr": "bal", "audio": "wbw/083_014_003.mp3"}, {"type": "word", "ar": "رَانَ", "tajweed": "رَانَ", "en": "(the) stain has covered", "tr": "rāna", "audio": "wbw/083_014_005.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "[over]", "tr": "ʿalā", "audio": "wbw/083_014_006.mp3"}, {"type": "word", "ar": "قُلُوبِهِم", "tajweed": "قُلُوبِه<rule class=idgham_shafawi>ِم</rule>", "en": "their hearts", "tr": "qulūbihim", "audio": "wbw/083_014_007.mp3"}, {"type": "word", "ar": "مَّا", "tajweed": "<rule class=idgham_shafawi>م</rule>َّا", "en": "(for) what", "tr": "mā", "audio": "wbw/083_014_008.mp3"}, {"type": "word", "ar": "كَانُوا۟", "tajweed": "كَانُو<rule class=slnt>اۡ</rule>", "en": "they used to", "tr": "kānū", "audio": "wbw/083_014_009.mp3"}, {"type": "word", "ar": "يَكْسِبُونَ", "tajweed": "يَكۡسِب<rule class=madda_permissible>ُو</rule>نَ", "en": "earn", "tr": "yaksibūna", "audio": "wbw/083_014_010.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "83:15", "juz": 30, "page": 588, "side_trans": "No! Indeed, from their Lord, that Day, they will be partitioned.", "words": [{"type": "word", "ar": "كَلَّآ", "tajweed": "كَلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Nay", "tr": "kallā", "audio": "wbw/083_015_001.mp3"}, {"type": "word", "ar": "إِنَّهُمْ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "Indeed, they", "tr": "innahum", "audio": "wbw/083_015_002.mp3"}, {"type": "word", "ar": "عَن", "tajweed": "ع<rule class=idgham_wo_ghunnah>َن</rule>", "en": "from", "tr": "ʿan", "audio": "wbw/083_015_003.mp3"}, {"type": "word", "ar": "رَّبِّهِمْ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّبِّهِمۡ", "en": "their Lord", "tr": "rabbihim", "audio": "wbw/083_015_004.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "يَوۡمَئِ<rule class=idgham_wo_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/083_015_005.mp3"}, {"type": "word", "ar": "لَّمَحْجُوبُونَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّمَحۡجُوب<rule class=madda_permissible>ُو</rule>نَ", "en": "surely will be partitioned", "tr": "lamaḥjūbūna", "audio": "wbw/083_015_006.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "83:16", "juz": 30, "page": 588, "side_trans": "Then indeed, they will [enter and] burn in Hellfire.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/083_016_001.mp3"}, {"type": "word", "ar": "إِنَّهُمْ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "indeed, they", "tr": "innahum", "audio": "wbw/083_016_002.mp3"}, {"type": "word", "ar": "لَصَالُوا۟", "tajweed": "لَصَالُو<rule class=slnt>اۡ</rule>", "en": "(surely) will burn", "tr": "laṣālū", "audio": "wbw/083_016_003.mp3"}, {"type": "word", "ar": "ٱلْجَحِيمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجَح<rule class=madda_permissible>ِي</rule>مِ", "en": "(in) the Hellfire", "tr": "l-jaḥīmi", "audio": "wbw/083_016_004.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "83:17", "juz": 30, "page": 588, "side_trans": "Then it will be said [to them], \"This is what you used to deny.\"", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/083_017_001.mp3"}, {"type": "word", "ar": "يُقَالُ", "tajweed": "يُقَالُ", "en": "it will be said", "tr": "yuqālu", "audio": "wbw/083_017_002.mp3"}, {"type": "word", "ar": "هَـٰذَا", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>ذَا", "en": "This", "tr": "hādhā", "audio": "wbw/083_017_003.mp3"}, {"type": "word", "ar": "ٱلَّذِى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِى", "en": "(is) what", "tr": "alladhī", "audio": "wbw/083_017_004.mp3"}, {"type": "word", "ar": "كُنتُم", "tajweed": "كُ<rule class=ikhafa>نت</rule><rule class=ikhafa_shafawi>ُم</rule>", "en": "you used to", "tr": "kuntum", "audio": "wbw/083_017_005.mp3"}, {"type": "word", "ar": "بِهِۦ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِه<rule class=madda_normal>ِۦ</rule>", "en": "[of it]", "tr": "bihi", "audio": "wbw/083_017_006.mp3"}, {"type": "word", "ar": "تُكَذِّبُونَ", "tajweed": "تُكَذِّب<rule class=madda_permissible>ُو</rule>نَ", "en": "deny", "tr": "tukadhibūna", "audio": "wbw/083_017_007.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "83:18", "juz": 30, "page": 588, "side_trans": "No! Indeed, the record of the righteous is in ʿilliyyūn.", "words": [{"type": "word", "ar": "كَلَّآ", "tajweed": "كَلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Nay", "tr": "kallā", "audio": "wbw/083_018_001.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/083_018_002.mp3"}, {"type": "word", "ar": "كِتَـٰبَ", "tajweed": "كِتَ<rule class=madda_normal>ـٰ</rule>بَ", "en": "(the) record", "tr": "kitāba", "audio": "wbw/083_018_003.mp3"}, {"type": "word", "ar": "ٱلْأَبْرَارِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَ<rule class=qalaqah>بۡ</rule>رَارِ", "en": "(of) the righteous", "tr": "l-abrāri", "audio": "wbw/083_018_004.mp3"}, {"type": "word", "ar": "لَفِى", "tajweed": "لَفِى", "en": "(will be) surely in", "tr": "lafī", "audio": "wbw/083_018_005.mp3"}, {"type": "word", "ar": "عِلِّيِّينَ", "tajweed": "عِلِّيّ<rule class=madda_permissible>ِي</rule>نَ", "en": "Illiyin", "tr": "ʿilliyyīna", "audio": "wbw/083_018_006.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "83:19", "juz": 30, "page": 588, "side_trans": "And what can make you know what is ʿilliyyūn?", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And what", "tr": "wamā", "audio": "wbw/083_019_001.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "can make you know", "tr": "adrāka", "audio": "wbw/083_019_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/083_019_003.mp3"}, {"type": "word", "ar": "عِلِّيُّونَ", "tajweed": "عِلِّيّ<rule class=madda_permissible>ُو</rule>نَ", "en": "(is) Illiyun", "tr": "ʿilliyyūna", "audio": "wbw/083_019_004.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "83:20", "juz": 30, "page": 588, "side_trans": "It is [their destination recorded in] a register inscribed", "words": [{"type": "word", "ar": "كِتَـٰبٌۭ", "tajweed": "كِتَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>بٌ</rule>", "en": "A book", "tr": "kitābun", "audio": "wbw/083_020_001.mp3"}, {"type": "word", "ar": "مَّرْقُومٌۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّرۡق<rule class=madda_permissible>ُو</rule>مٌ", "en": "written", "tr": "marqūmun", "audio": "wbw/083_020_002.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "83:21", "juz": 30, "page": 588, "side_trans": "Which is witnessed by those brought near [to Allāh].", "words": [{"type": "word", "ar": "يَشْهَدُهُ", "tajweed": "يَشۡهَدُهُ", "en": "Witness it", "tr": "yashhaduhu", "audio": "wbw/083_021_001.mp3"}, {"type": "word", "ar": "ٱلْمُقَرَّبُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُقَرَّب<rule class=madda_permissible>ُو</rule>نَ", "en": "those brought near", "tr": "l-muqarabūna", "audio": "wbw/083_021_002.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "83:22", "juz": 30, "page": 588, "side_trans": "Indeed, the righteous will be in pleasure", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/083_022_001.mp3"}, {"type": "word", "ar": "ٱلْأَبْرَارَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَ<rule class=qalaqah>بۡ</rule>رَارَ", "en": "the righteous", "tr": "l-abrāra", "audio": "wbw/083_022_002.mp3"}, {"type": "word", "ar": "لَفِى", "tajweed": "لَفِى", "en": "(will be) surely in", "tr": "lafī", "audio": "wbw/083_022_003.mp3"}, {"type": "word", "ar": "نَعِيمٍ", "tajweed": "نَع<rule class=madda_permissible>ِي</rule>مٍ", "en": "bliss", "tr": "naʿīmin", "audio": "wbw/083_022_004.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "83:23", "juz": 30, "page": 588, "side_trans": "On adorned couches, observing.", "words": [{"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "On", "tr": "ʿalā", "audio": "wbw/083_023_001.mp3"}, {"type": "word", "ar": "ٱلْأَرَآئِكِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَر<rule class=madda_obligatory_mottasel>َا</rule>ٓئِكِ", "en": "thrones", "tr": "l-arāiki", "audio": "wbw/083_023_002.mp3"}, {"type": "word", "ar": "يَنظُرُونَ", "tajweed": "يَ<rule class=ikhafa>نظ</rule>ُر<rule class=madda_permissible>ُو</rule>نَ", "en": "observing", "tr": "yanẓurūna", "audio": "wbw/083_023_003.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "83:24", "juz": 30, "page": 588, "side_trans": "You will recognize in their faces the radiance of pleasure.", "words": [{"type": "word", "ar": "تَعْرِفُ", "tajweed": "تَعۡرِفُ", "en": "You will recognize", "tr": "taʿrifu", "audio": "wbw/083_024_001.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/083_024_002.mp3"}, {"type": "word", "ar": "وُجُوهِهِمْ", "tajweed": "وُجُوهِهِمۡ", "en": "their faces", "tr": "wujūhihim", "audio": "wbw/083_024_003.mp3"}, {"type": "word", "ar": "نَضْرَةَ", "tajweed": "نَضۡرَةَ", "en": "(the) radiance", "tr": "naḍrata", "audio": "wbw/083_024_004.mp3"}, {"type": "word", "ar": "ٱلنَّعِيمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َع<rule class=madda_permissible>ِي</rule>مِ", "en": "(of) bliss", "tr": "l-naʿīmi", "audio": "wbw/083_024_005.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "83:25", "juz": 30, "page": 588, "side_trans": "They will be given to drink [pure] wine [which was] sealed.", "words": [{"type": "word", "ar": "يُسْقَوْنَ", "tajweed": "يُسۡقَوۡنَ", "en": "They will be given to drink", "tr": "yus'qawna", "audio": "wbw/083_025_001.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_wo_ghunnah>ِن</rule>", "en": "of", "tr": "min", "audio": "wbw/083_025_002.mp3"}, {"type": "word", "ar": "رَّحِيقٍۢ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّحِي<rule class=idgham_ghunnah>قٍ</rule>", "en": "a pure wine", "tr": "raḥīqin", "audio": "wbw/083_025_003.mp3"}, {"type": "word", "ar": "مَّخْتُومٍ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّخۡت<rule class=madda_permissible>ُو</rule>مٍ", "en": "sealed", "tr": "makhtūmin", "audio": "wbw/083_025_004.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "83:26", "juz": 30, "page": 588, "side_trans": "The last of it is musk. So for this let the competitors compete.", "words": [{"type": "word", "ar": "خِتَـٰمُهُۥ", "tajweed": "خِتَ<rule class=madda_normal>ـٰ</rule>مُهُ<rule class=madda_normal>ۥ</rule>", "en": "Its seal", "tr": "khitāmuhu", "audio": "wbw/083_026_001.mp3"}, {"type": "word", "ar": "مِسْكٌۭ ۚ", "tajweed": "مِسۡ<rule class=idgham_ghunnah>كٌ‌ۚ</rule>", "en": "(will be of) musk", "tr": "mis'kun", "audio": "wbw/083_026_002.mp3"}, {"type": "word", "ar": "وَفِى", "tajweed": "<rule class=idgham_ghunnah>و</rule>َفِى", "en": "And for", "tr": "wafī", "audio": "wbw/083_026_004.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "that", "tr": "dhālika", "audio": "wbw/083_026_005.mp3"}, {"type": "word", "ar": "فَلْيَتَنَافَسِ", "tajweed": "فَلۡيَتَنَافَسِ", "en": "let aspire", "tr": "falyatanāfasi", "audio": "wbw/083_026_006.mp3"}, {"type": "word", "ar": "ٱلْمُتَنَـٰفِسُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُتَنَ<rule class=madda_normal>ـٰ</rule>فِس<rule class=madda_permissible>ُو</rule>نَ", "en": "the aspirers", "tr": "l-mutanāfisūna", "audio": "wbw/083_026_007.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "83:27", "juz": 30, "page": 588, "side_trans": "And its mixture is of Tasneem,", "words": [{"type": "word", "ar": "وَمِزَاجُهُۥ", "tajweed": "وَمِزَاجُهُ<rule class=madda_normal>ۥ</rule>", "en": "And its mixture", "tr": "wamizājuhu", "audio": "wbw/083_027_001.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "(is) of", "tr": "min", "audio": "wbw/083_027_002.mp3"}, {"type": "word", "ar": "تَسْنِيمٍ", "tajweed": "<rule class=ikhafa>ت</rule>َسۡن<rule class=madda_permissible>ِي</rule>مٍ", "en": "Tasneem", "tr": "tasnīmin", "audio": "wbw/083_027_003.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "83:28", "juz": 30, "page": 588, "side_trans": "A spring from which those near [to Allāh] drink.", "words": [{"type": "word", "ar": "عَيْنًۭا", "tajweed": "عَيۡ<rule class=idgham_ghunnah>نًا</rule>", "en": "A spring", "tr": "ʿaynan", "audio": "wbw/083_028_001.mp3"}, {"type": "word", "ar": "يَشْرَبُ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َشۡرَبُ", "en": "will drink", "tr": "yashrabu", "audio": "wbw/083_028_002.mp3"}, {"type": "word", "ar": "بِهَا", "tajweed": "بِهَا", "en": "from it", "tr": "bihā", "audio": "wbw/083_028_003.mp3"}, {"type": "word", "ar": "ٱلْمُقَرَّبُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُقَرَّب<rule class=madda_permissible>ُو</rule>نَ", "en": "those brought near", "tr": "l-muqarabūna", "audio": "wbw/083_028_004.mp3"}, {"type": "end", "num": "٢٨"}]}, {"id": 29, "key": "83:29", "juz": 30, "page": 588, "side_trans": "Indeed, those who committed crimes used to laugh at those who believed.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/083_029_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/083_029_002.mp3"}, {"type": "word", "ar": "أَجْرَمُوا۟", "tajweed": "أَ<rule class=qalaqah>جۡ</rule>رَمُو<rule class=slnt>اۡ</rule>", "en": "committed crimes", "tr": "ajramū", "audio": "wbw/083_029_003.mp3"}, {"type": "word", "ar": "كَانُوا۟", "tajweed": "كَانُو<rule class=slnt>اۡ</rule>", "en": "used to", "tr": "kānū", "audio": "wbw/083_029_004.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "at", "tr": "mina", "audio": "wbw/083_029_005.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/083_029_006.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believed", "tr": "āmanū", "audio": "wbw/083_029_007.mp3"}, {"type": "word", "ar": "يَضْحَكُونَ", "tajweed": "يَضۡحَك<rule class=madda_permissible>ُو</rule>نَ", "en": "laugh", "tr": "yaḍḥakūna", "audio": "wbw/083_029_008.mp3"}, {"type": "end", "num": "٢٩"}]}, {"id": 30, "key": "83:30", "juz": 30, "page": 588, "side_trans": "And when they passed by them, they would exchange derisive glances.", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/083_030_001.mp3"}, {"type": "word", "ar": "مَرُّوا۟", "tajweed": "مَرُّو<rule class=slnt>اۡ</rule>", "en": "they passed", "tr": "marrū", "audio": "wbw/083_030_002.mp3"}, {"type": "word", "ar": "بِهِمْ", "tajweed": "بِهِمۡ", "en": "by them", "tr": "bihim", "audio": "wbw/083_030_003.mp3"}, {"type": "word", "ar": "يَتَغَامَزُونَ", "tajweed": "يَتَغَامَز<rule class=madda_permissible>ُو</rule>نَ", "en": "they winked at one another", "tr": "yataghāmazūna", "audio": "wbw/083_030_004.mp3"}, {"type": "end", "num": "٣٠"}]}, {"id": 31, "key": "83:31", "juz": 30, "page": 588, "side_trans": "And when they returned to their people, they would return jesting.", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/083_031_001.mp3"}, {"type": "word", "ar": "ٱنقَلَبُوٓا۟", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=ikhafa>نق</rule>َلَب<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "they returned", "tr": "inqalabū", "audio": "wbw/083_031_002.mp3"}, {"type": "word", "ar": "إِلَىٰٓ", "tajweed": "إِلَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "to", "tr": "ilā", "audio": "wbw/083_031_003.mp3"}, {"type": "word", "ar": "أَهْلِهِمُ", "tajweed": "أَهۡلِهِمُ", "en": "their people", "tr": "ahlihimu", "audio": "wbw/083_031_004.mp3"}, {"type": "word", "ar": "ٱنقَلَبُوا۟", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=ikhafa>نق</rule>َلَبُو<rule class=slnt>اۡ</rule>", "en": "they would return", "tr": "inqalabū", "audio": "wbw/083_031_005.mp3"}, {"type": "word", "ar": "فَكِهِينَ", "tajweed": "فَكِه<rule class=madda_permissible>ِي</rule>نَ", "en": "jesting", "tr": "fakihīna", "audio": "wbw/083_031_006.mp3"}, {"type": "end", "num": "٣١"}]}, {"id": 32, "key": "83:32", "juz": 30, "page": 588, "side_trans": "And when they saw them, they would say, \"Indeed, those are truly lost.\"", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/083_032_001.mp3"}, {"type": "word", "ar": "رَأَوْهُمْ", "tajweed": "رَأَوۡهُمۡ", "en": "they saw them", "tr": "ra-awhum", "audio": "wbw/083_032_002.mp3"}, {"type": "word", "ar": "قَالُوٓا۟", "tajweed": "قَال<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "they said", "tr": "qālū", "audio": "wbw/083_032_003.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/083_032_004.mp3"}, {"type": "word", "ar": "هَـٰٓؤُلَآءِ", "tajweed": "هَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ؤُل<rule class=madda_obligatory_mottasel>َا</rule>ٓءِ", "en": "these", "tr": "hāulāi", "audio": "wbw/083_032_005.mp3"}, {"type": "word", "ar": "لَضَآلُّونَ", "tajweed": "لَض<rule class=madda_necessary>َا</rule>ٓلّ<rule class=madda_permissible>ُو</rule>نَ", "en": "surely have gone astray", "tr": "laḍāllūna", "audio": "wbw/083_032_006.mp3"}, {"type": "end", "num": "٣٢"}]}, {"id": 33, "key": "83:33", "juz": 30, "page": 588, "side_trans": "But they had not been sent as guardians over them.", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "But not", "tr": "wamā", "audio": "wbw/083_033_001.mp3"}, {"type": "word", "ar": "أُرْسِلُوا۟", "tajweed": "أُرۡسِلُو<rule class=slnt>اۡ</rule>", "en": "they had been sent", "tr": "ur'silū", "audio": "wbw/083_033_002.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ", "tajweed": "عَلَيۡهِمۡ", "en": "over them", "tr": "ʿalayhim", "audio": "wbw/083_033_003.mp3"}, {"type": "word", "ar": "حَـٰفِظِينَ", "tajweed": "حَ<rule class=madda_normal>ـٰ</rule>فِظ<rule class=madda_permissible>ِي</rule>نَ", "en": "(as) guardians", "tr": "ḥāfiẓīna", "audio": "wbw/083_033_004.mp3"}, {"type": "end", "num": "٣٣"}]}, {"id": 34, "key": "83:34", "juz": 30, "page": 589, "side_trans": "So Today those who believed are laughing at the disbelievers,", "words": [{"type": "word", "ar": "فَٱلْيَوْمَ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>لۡيَوۡمَ", "en": "So today", "tr": "fal-yawma", "audio": "wbw/083_034_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/083_034_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believed ", "tr": "āmanū", "audio": "wbw/083_034_003.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "at", "tr": "mina", "audio": "wbw/083_034_004.mp3"}, {"type": "word", "ar": "ٱلْكُفَّارِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكُفَّارِ", "en": "the disbelievers", "tr": "l-kufāri", "audio": "wbw/083_034_005.mp3"}, {"type": "word", "ar": "يَضْحَكُونَ", "tajweed": "يَضۡحَك<rule class=madda_permissible>ُو</rule>نَ", "en": "they will laugh", "tr": "yaḍḥakūna", "audio": "wbw/083_034_006.mp3"}, {"type": "end", "num": "٣٤"}]}, {"id": 35, "key": "83:35", "juz": 30, "page": 589, "side_trans": "On adorned couches, observing.", "words": [{"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "On", "tr": "ʿalā", "audio": "wbw/083_035_001.mp3"}, {"type": "word", "ar": "ٱلْأَرَآئِكِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَر<rule class=madda_obligatory_mottasel>َا</rule>ٓئِكِ", "en": "the thrones", "tr": "l-arāiki", "audio": "wbw/083_035_002.mp3"}, {"type": "word", "ar": "يَنظُرُونَ", "tajweed": "يَ<rule class=ikhafa>نظ</rule>ُر<rule class=madda_permissible>ُو</rule>نَ", "en": "observing", "tr": "yanẓurūna", "audio": "wbw/083_035_003.mp3"}, {"type": "end", "num": "٣٥"}]}, {"id": 36, "key": "83:36", "juz": 30, "page": 589, "side_trans": "Have the disbelievers [not] been rewarded [this Day] for what they used to do?", "words": [{"type": "word", "ar": "هَلْ", "tajweed": "هَلۡ", "en": "Have (not)", "tr": "hal", "audio": "wbw/083_036_001.mp3"}, {"type": "word", "ar": "ثُوِّبَ", "tajweed": "ثُوِّبَ", "en": "been rewarded", "tr": "thuwwiba", "audio": "wbw/083_036_002.mp3"}, {"type": "word", "ar": "ٱلْكُفَّارُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكُفَّارُ", "en": "the disbelievers", "tr": "l-kufāru", "audio": "wbw/083_036_003.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "(for) what", "tr": "mā", "audio": "wbw/083_036_004.mp3"}, {"type": "word", "ar": "كَانُوا۟", "tajweed": "كَانُو<rule class=slnt>اۡ</rule>", "en": "they used to", "tr": "kānū", "audio": "wbw/083_036_005.mp3"}, {"type": "word", "ar": "يَفْعَلُونَ", "tajweed": "يَفۡعَل<rule class=madda_permissible>ُو</rule>نَ", "en": "do", "tr": "yafʿalūna", "audio": "wbw/083_036_006.mp3"}, {"type": "end", "num": "٣٦"}]}]