[{"id": 1, "key": "66:1", "juz": 28, "page": 560, "side_trans": "O Prophet, why do you prohibit [yourself from] what Allāh has made lawful for you, seeking the approval of your wives? And Allāh is Forgiving and Merciful.", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/066_001_001.mp3"}, {"type": "word", "ar": "ٱلنَّبِىُّ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َبِىُّ", "en": "Prophet", "tr": "l-nabiyu", "audio": "wbw/066_001_002.mp3"}, {"type": "word", "ar": "لِمَ", "tajweed": "لِمَ", "en": "Why (do)", "tr": "lima", "audio": "wbw/066_001_003.mp3"}, {"type": "word", "ar": "تُحَرِّمُ", "tajweed": "تُحَرِّمُ", "en": "you prohibit", "tr": "tuḥarrimu", "audio": "wbw/066_001_004.mp3"}, {"type": "word", "ar": "مَآ", "tajweed": "م<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "what", "tr": "mā", "audio": "wbw/066_001_005.mp3"}, {"type": "word", "ar": "أَحَلَّ", "tajweed": "أَحَلَّ", "en": "has made lawful", "tr": "aḥalla", "audio": "wbw/066_001_006.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/066_001_007.mp3"}, {"type": "word", "ar": "لَكَ ۖ", "tajweed": "لَكَ‌ۖ", "en": "for you", "tr": "laka", "audio": "wbw/066_001_008.mp3"}, {"type": "word", "ar": "تَبْتَغِى", "tajweed": "تَ<rule class=qalaqah>بۡ</rule>تَغِى", "en": "seeking", "tr": "tabtaghī", "audio": "wbw/066_001_010.mp3"}, {"type": "word", "ar": "مَرْضَاتَ", "tajweed": "مَرۡضَاتَ", "en": "(to) please", "tr": "marḍāta", "audio": "wbw/066_001_011.mp3"}, {"type": "word", "ar": "أَزْوَٰجِكَ ۚ", "tajweed": "أَزۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>جِكَ‌ۚ", "en": "your wives", "tr": "azwājika", "audio": "wbw/066_001_012.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/066_001_014.mp3"}, {"type": "word", "ar": "غَفُورٌۭ", "tajweed": "غَفُو<rule class=idgham_wo_ghunnah>رٌ</rule>", "en": "(is) Oft-Forgiving", "tr": "ghafūrun", "audio": "wbw/066_001_015.mp3"}, {"type": "word", "ar": "رَّحِيمٌۭ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّح<rule class=madda_permissible>ِي</rule>مٌ", "en": "Most Merciful", "tr": "raḥīmun", "audio": "wbw/066_001_016.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "66:2", "juz": 28, "page": 560, "side_trans": "Allāh has already ordained for you [Muslims] the dissolution of your oaths. And Allāh is your protector, and He is the Knowing, the Wise.", "words": [{"type": "word", "ar": "قَدْ", "tajweed": "قَ<rule class=qalaqah>دۡ</rule>", "en": "Indeed", "tr": "qad", "audio": "wbw/066_002_001.mp3"}, {"type": "word", "ar": "فَرَضَ", "tajweed": "فَرَضَ", "en": "has ordained", "tr": "faraḍa", "audio": "wbw/066_002_002.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/066_002_003.mp3"}, {"type": "word", "ar": "لَكُمْ", "tajweed": "لَكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/066_002_004.mp3"}, {"type": "word", "ar": "تَحِلَّةَ", "tajweed": "تَحِلَّةَ", "en": "(the) dissolution", "tr": "taḥillata", "audio": "wbw/066_002_005.mp3"}, {"type": "word", "ar": "أَيْمَـٰنِكُمْ ۚ", "tajweed": "أَيۡمَ<rule class=madda_normal>ـٰ</rule>نِكُمۡ‌ۚ", "en": "(of) your oaths", "tr": "aymānikum", "audio": "wbw/066_002_006.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/066_002_008.mp3"}, {"type": "word", "ar": "مَوْلَىٰكُمْ ۖ", "tajweed": "مَوۡلَ<rule class=madda_normal>ـٰ</rule>كُمۡ‌ۖ", "en": "(is) your Protector", "tr": "mawlākum", "audio": "wbw/066_002_009.mp3"}, {"type": "word", "ar": "وَهُوَ", "tajweed": "وَهُوَ", "en": "and He", "tr": "wahuwa", "audio": "wbw/066_002_011.mp3"}, {"type": "word", "ar": "ٱلْعَلِيمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَلِيمُ", "en": "(is) the All-Knower", "tr": "l-ʿalīmu", "audio": "wbw/066_002_012.mp3"}, {"type": "word", "ar": "ٱلْحَكِيمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَك<rule class=madda_permissible>ِي</rule>مُ", "en": "the All-Wise", "tr": "l-ḥakīmu", "audio": "wbw/066_002_013.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "66:3", "juz": 28, "page": 560, "side_trans": "And [remember] when the Prophet confided to one of his wives a statement; and when she informed [another] of it and Allāh showed it to him, he made known part of it and ignored a part. And when he informed her about it, she said, \"Who told you this?\" He said, \"I was informed by the Knowing, the Aware.\"", "words": [{"type": "word", "ar": "وَإِذْ", "tajweed": "وَإِذۡ", "en": "And when", "tr": "wa-idh", "audio": "wbw/066_003_001.mp3"}, {"type": "word", "ar": "أَسَرَّ", "tajweed": "أَسَرَّ", "en": "confided", "tr": "asarra", "audio": "wbw/066_003_002.mp3"}, {"type": "word", "ar": "ٱلنَّبِىُّ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َبِىُّ", "en": "the Prophet", "tr": "l-nabiyu", "audio": "wbw/066_003_003.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/066_003_004.mp3"}, {"type": "word", "ar": "بَعْضِ", "tajweed": "بَعۡضِ", "en": "one", "tr": "baʿḍi", "audio": "wbw/066_003_005.mp3"}, {"type": "word", "ar": "أَزْوَٰجِهِۦ", "tajweed": "أَزۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>جِه<rule class=madda_normal>ِۦ</rule>", "en": "(of) his wives", "tr": "azwājihi", "audio": "wbw/066_003_006.mp3"}, {"type": "word", "ar": "حَدِيثًۭا", "tajweed": "حَدِي<rule class=ikhafa>ثًا</rule>", "en": "a statement", "tr": "ḥadīthan", "audio": "wbw/066_003_007.mp3"}, {"type": "word", "ar": "فَلَمَّا", "tajweed": "<rule class=ikhafa>ف</rule>َلَ<rule class=ghunnah>مّ</rule>َا", "en": "and when", "tr": "falammā", "audio": "wbw/066_003_008.mp3"}, {"type": "word", "ar": "نَبَّأَتْ", "tajweed": "نَبَّأَتۡ", "en": "she informed", "tr": "nabba-at", "audio": "wbw/066_003_009.mp3"}, {"type": "word", "ar": "بِهِۦ", "tajweed": "بِه<rule class=madda_normal>ِۦ</rule>", "en": "about it", "tr": "bihi", "audio": "wbw/066_003_010.mp3"}, {"type": "word", "ar": "وَأَظْهَرَهُ", "tajweed": "وَأَظۡهَرَهُ", "en": "and made it apparent", "tr": "wa-aẓharahu", "audio": "wbw/066_003_011.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/066_003_012.mp3"}, {"type": "word", "ar": "عَلَيْهِ", "tajweed": "عَلَيۡهِ", "en": "to him", "tr": "ʿalayhi", "audio": "wbw/066_003_013.mp3"}, {"type": "word", "ar": "عَرَّفَ", "tajweed": "عَرَّفَ", "en": "he made known", "tr": "ʿarrafa", "audio": "wbw/066_003_014.mp3"}, {"type": "word", "ar": "بَعْضَهُۥ", "tajweed": "بَعۡضَهُ<rule class=madda_normal>ۥ</rule>", "en": "a part of it", "tr": "baʿḍahu", "audio": "wbw/066_003_015.mp3"}, {"type": "word", "ar": "وَأَعْرَضَ", "tajweed": "وَأَعۡرَضَ", "en": "and avoided", "tr": "wa-aʿraḍa", "audio": "wbw/066_003_016.mp3"}, {"type": "word", "ar": "عَنۢ", "tajweed": "ع<rule class=iqlab>َنۢ</rule>", "en": "[of]", "tr": "ʿan", "audio": "wbw/066_003_017.mp3"}, {"type": "word", "ar": "بَعْضٍۢ ۖ", "tajweed": "<rule class=iqlab>ب</rule>َعۡ<rule class=ikhafa>ضٍ‌ۖ</rule>", "en": "a part", "tr": "baʿḍin", "audio": "wbw/066_003_018.mp3"}, {"type": "word", "ar": "فَلَمَّا", "tajweed": "<rule class=ikhafa>ف</rule>َلَ<rule class=ghunnah>مّ</rule>َا", "en": "Then when", "tr": "falammā", "audio": "wbw/066_003_020.mp3"}, {"type": "word", "ar": "نَبَّأَهَا", "tajweed": "نَبَّأَهَا", "en": "he informed her", "tr": "nabba-ahā", "audio": "wbw/066_003_021.mp3"}, {"type": "word", "ar": "بِهِۦ", "tajweed": "بِه<rule class=madda_normal>ِۦ</rule>", "en": "about it", "tr": "bihi", "audio": "wbw/066_003_022.mp3"}, {"type": "word", "ar": "قَالَتْ", "tajweed": "قَالَتۡ", "en": "she said", "tr": "qālat", "audio": "wbw/066_003_023.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "Who", "tr": "man", "audio": "wbw/066_003_024.mp3"}, {"type": "word", "ar": "أَنۢبَأَكَ", "tajweed": "أَ<rule class=iqlab>نۢب</rule>َأَكَ", "en": "informed you", "tr": "anba-aka", "audio": "wbw/066_003_025.mp3"}, {"type": "word", "ar": "هَـٰذَا ۖ", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>ذَا‌ۖ", "en": "this", "tr": "hādhā", "audio": "wbw/066_003_026.mp3"}, {"type": "word", "ar": "قَالَ", "tajweed": "قَالَ", "en": "He said", "tr": "qāla", "audio": "wbw/066_003_028.mp3"}, {"type": "word", "ar": "نَبَّأَنِىَ", "tajweed": "نَبَّأَنِىَ", "en": "Has informed me", "tr": "nabba-aniya", "audio": "wbw/066_003_029.mp3"}, {"type": "word", "ar": "ٱلْعَلِيمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَلِيمُ", "en": "the All-Knower", "tr": "l-ʿalīmu", "audio": "wbw/066_003_030.mp3"}, {"type": "word", "ar": "ٱلْخَبِيرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡخَب<rule class=madda_permissible>ِي</rule>رُ", "en": "the All-Aware", "tr": "l-khabīru", "audio": "wbw/066_003_031.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "66:4", "juz": 28, "page": 560, "side_trans": "If you two [wives] repent to Allāh, [it is best], for your hearts have deviated. But if you cooperate against him - then indeed Allāh is his protector, and Gabriel and the righteous of the believers and the angels, moreover, are [his] assistants.", "words": [{"type": "word", "ar": "إِن", "tajweed": "إِ<rule class=ikhafa>ن</rule>", "en": "If", "tr": "in", "audio": "wbw/066_004_001.mp3"}, {"type": "word", "ar": "تَتُوبَآ", "tajweed": "<rule class=ikhafa>ت</rule>َتُوب<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "you both turn", "tr": "tatūbā", "audio": "wbw/066_004_002.mp3"}, {"type": "word", "ar": "إِلَى", "tajweed": "إِلَى", "en": "to", "tr": "ilā", "audio": "wbw/066_004_003.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/066_004_004.mp3"}, {"type": "word", "ar": "فَقَدْ", "tajweed": "فَقَ<rule class=qalaqah>دۡ</rule>", "en": "so indeed", "tr": "faqad", "audio": "wbw/066_004_005.mp3"}, {"type": "word", "ar": "صَغَتْ", "tajweed": "صَغَتۡ", "en": "(are) inclined", "tr": "ṣaghat", "audio": "wbw/066_004_006.mp3"}, {"type": "word", "ar": "قُلُوبُكُمَا ۖ", "tajweed": "قُلُوبُكُمَا‌ۖ", "en": "your hearts", "tr": "qulūbukumā", "audio": "wbw/066_004_007.mp3"}, {"type": "word", "ar": "وَإِن", "tajweed": "وَإِ<rule class=ikhafa>ن</rule>", "en": "but if", "tr": "wa-in", "audio": "wbw/066_004_009.mp3"}, {"type": "word", "ar": "تَظَـٰهَرَا", "tajweed": "<rule class=ikhafa>ت</rule>َظَ<rule class=madda_normal>ـٰ</rule>هَرَا", "en": "you backup each other", "tr": "taẓāharā", "audio": "wbw/066_004_010.mp3"}, {"type": "word", "ar": "عَلَيْهِ", "tajweed": "عَلَيۡهِ", "en": "against him", "tr": "ʿalayhi", "audio": "wbw/066_004_011.mp3"}, {"type": "word", "ar": "فَإِنَّ", "tajweed": "فَإِ<rule class=ghunnah>نّ</rule>َ", "en": "then indeed", "tr": "fa-inna", "audio": "wbw/066_004_012.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/066_004_013.mp3"}, {"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "He", "tr": "huwa", "audio": "wbw/066_004_014.mp3"}, {"type": "word", "ar": "مَوْلَىٰهُ", "tajweed": "مَوۡلَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "(is) his Protector", "tr": "mawlāhu", "audio": "wbw/066_004_015.mp3"}, {"type": "word", "ar": "وَجِبْرِيلُ", "tajweed": "وَجِ<rule class=qalaqah>بۡ</rule>رِيلُ", "en": "and Jibreel", "tr": "wajib'rīlu", "audio": "wbw/066_004_016.mp3"}, {"type": "word", "ar": "وَصَـٰلِحُ", "tajweed": "وَصَ<rule class=madda_normal>ـٰ</rule>لِحُ", "en": "and (the) righteous", "tr": "waṣāliḥu", "audio": "wbw/066_004_017.mp3"}, {"type": "word", "ar": "ٱلْمُؤْمِنِينَ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُؤۡمِنِينَ‌ۖ", "en": "believers", "tr": "l-mu'minīna", "audio": "wbw/066_004_018.mp3"}, {"type": "word", "ar": "وَٱلْمَلَـٰٓئِكَةُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمَلَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَةُ", "en": "and the Angels", "tr": "wal-malāikatu", "audio": "wbw/066_004_020.mp3"}, {"type": "word", "ar": "بَعْدَ", "tajweed": "بَعۡدَ", "en": "after", "tr": "baʿda", "audio": "wbw/066_004_021.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "that", "tr": "dhālika", "audio": "wbw/066_004_022.mp3"}, {"type": "word", "ar": "ظَهِيرٌ", "tajweed": "ظَه<rule class=madda_permissible>ِي</rule>رٌ", "en": "(are his) assistants", "tr": "ẓahīrun", "audio": "wbw/066_004_023.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "66:5", "juz": 28, "page": 560, "side_trans": "Perhaps his Lord, if he divorced you [all], would substitute for him wives better than you - submitting [to Allāh], believing, devoutly obedient, repentant, worshipping, and traveling - [ones] previously married and virgins.", "words": [{"type": "word", "ar": "عَسَىٰ", "tajweed": "عَسَىٰ", "en": "Perhaps", "tr": "ʿasā", "audio": "wbw/066_005_001.mp3"}, {"type": "word", "ar": "رَبُّهُۥٓ", "tajweed": "رَبُّهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "his Lord", "tr": "rabbuhu", "audio": "wbw/066_005_002.mp3"}, {"type": "word", "ar": "إِن", "tajweed": "إِ<rule class=ikhafa>ن</rule>", "en": "if", "tr": "in", "audio": "wbw/066_005_003.mp3"}, {"type": "word", "ar": "طَلَّقَكُنَّ", "tajweed": "<rule class=ikhafa>ط</rule>َلَّقَكُ<rule class=ghunnah>نّ</rule>َ", "en": "he divorced you", "tr": "ṭallaqakunna", "audio": "wbw/066_005_004.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "[that]", "tr": "an", "audio": "wbw/066_005_005.mp3"}, {"type": "word", "ar": "يُبْدِلَهُۥٓ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُ<rule class=qalaqah>بۡ</rule>دِلَهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "He will substitute for him", "tr": "yub'dilahu", "audio": "wbw/066_005_006.mp3"}, {"type": "word", "ar": "أَزْوَٰجًا", "tajweed": "أَزۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>جًا", "en": "wives", "tr": "azwājan", "audio": "wbw/066_005_007.mp3"}, {"type": "word", "ar": "خَيْرًۭا", "tajweed": "خَيۡ<rule class=idgham_ghunnah>رًا</rule>", "en": "better", "tr": "khayran", "audio": "wbw/066_005_008.mp3"}, {"type": "word", "ar": "مِّنكُنَّ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّ<rule class=ikhafa>نك</rule>ُ<rule class=ghunnah>نّ</rule>َ", "en": "than you", "tr": "minkunna", "audio": "wbw/066_005_009.mp3"}, {"type": "word", "ar": "مُسْلِمَـٰتٍۢ", "tajweed": "مُسۡلِمَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>تٍ</rule>", "en": "submissive", "tr": "mus'limātin", "audio": "wbw/066_005_010.mp3"}, {"type": "word", "ar": "مُّؤْمِنَـٰتٍۢ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّؤۡمِنَ<rule class=madda_normal>ـٰ</rule><rule class=ikhafa>تٍ</rule>", "en": "faithful", "tr": "mu'minātin", "audio": "wbw/066_005_011.mp3"}, {"type": "word", "ar": "قَـٰنِتَـٰتٍۢ", "tajweed": "<rule class=ikhafa>ق</rule>َ<rule class=madda_normal>ـٰ</rule>نِتَ<rule class=madda_normal>ـٰ</rule><rule class=ikhafa>تٍ</rule>", "en": "obedient", "tr": "qānitātin", "audio": "wbw/066_005_012.mp3"}, {"type": "word", "ar": "تَـٰٓئِبَـٰتٍ", "tajweed": "<rule class=ikhafa>ت</rule>َ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِبَ<rule class=madda_normal>ـٰ</rule>تٍ", "en": "repentant", "tr": "tāibātin", "audio": "wbw/066_005_013.mp3"}, {"type": "word", "ar": "عَـٰبِدَٰتٍۢ", "tajweed": "عَ<rule class=madda_normal>ـٰ</rule>بِد<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule><rule class=ikhafa>تٍ</rule>", "en": "who worship", "tr": "ʿābidātin", "audio": "wbw/066_005_014.mp3"}, {"type": "word", "ar": "سَـٰٓئِحَـٰتٍۢ", "tajweed": "<rule class=ikhafa>س</rule>َ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِحَ<rule class=madda_normal>ـٰ</rule><rule class=ikhafa>تٍ</rule>", "en": "who fast", "tr": "sāiḥātin", "audio": "wbw/066_005_015.mp3"}, {"type": "word", "ar": "ثَيِّبَـٰتٍۢ", "tajweed": "<rule class=ikhafa>ث</rule>َيِّبَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>تٍ</rule>", "en": "previously married", "tr": "thayyibātin", "audio": "wbw/066_005_016.mp3"}, {"type": "word", "ar": "وَأَبْكَارًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َأَ<rule class=qalaqah>بۡ</rule>كَارًا", "en": "and virgins", "tr": "wa-abkāran", "audio": "wbw/066_005_017.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "66:6", "juz": 28, "page": 560, "side_trans": "O you who have believed, protect yourselves and your families from a Fire whose fuel is people and stones, over which are [appointed] angels, harsh and severe; they do not disobey Allāh in what He commands them but do what they are commanded.", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/066_006_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "(you) who", "tr": "alladhīna", "audio": "wbw/066_006_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/066_006_003.mp3"}, {"type": "word", "ar": "قُوٓا۟", "tajweed": "ق<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "Protect", "tr": "qū", "audio": "wbw/066_006_004.mp3"}, {"type": "word", "ar": "أَنفُسَكُمْ", "tajweed": "أَ<rule class=ikhafa>نف</rule>ُسَكُمۡ", "en": "yourselves", "tr": "anfusakum", "audio": "wbw/066_006_005.mp3"}, {"type": "word", "ar": "وَأَهْلِيكُمْ", "tajweed": "وَأَهۡلِيكُمۡ", "en": "and your families", "tr": "wa-ahlīkum", "audio": "wbw/066_006_006.mp3"}, {"type": "word", "ar": "نَارًۭا", "tajweed": "نَا<rule class=idgham_ghunnah>رًا</rule>", "en": "(from) a Fire", "tr": "nāran", "audio": "wbw/066_006_007.mp3"}, {"type": "word", "ar": "وَقُودُهَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َقُودُهَا", "en": "whose fuel", "tr": "waqūduhā", "audio": "wbw/066_006_008.mp3"}, {"type": "word", "ar": "ٱلنَّاسُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َاسُ", "en": "(is) people", "tr": "l-nāsu", "audio": "wbw/066_006_009.mp3"}, {"type": "word", "ar": "وَٱلْحِجَارَةُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡحِجَارَةُ", "en": "and stones", "tr": "wal-ḥijāratu", "audio": "wbw/066_006_010.mp3"}, {"type": "word", "ar": "عَلَيْهَا", "tajweed": "عَلَيۡهَا", "en": "over it", "tr": "ʿalayhā", "audio": "wbw/066_006_011.mp3"}, {"type": "word", "ar": "مَلَـٰٓئِكَةٌ", "tajweed": "مَلَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَةٌ", "en": "(are) Angels", "tr": "malāikatun", "audio": "wbw/066_006_012.mp3"}, {"type": "word", "ar": "غِلَاظٌۭ", "tajweed": "غِلَا<rule class=ikhafa>ظٌ</rule>", "en": "stern", "tr": "ghilāẓun", "audio": "wbw/066_006_013.mp3"}, {"type": "word", "ar": "شِدَادٌۭ", "tajweed": "<rule class=ikhafa>ش</rule>ِدَا<rule class=idgham_wo_ghunnah>دٌ</rule>", "en": "severe", "tr": "shidādun", "audio": "wbw/066_006_014.mp3"}, {"type": "word", "ar": "لَّا", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّا", "en": "not", "tr": "lā", "audio": "wbw/066_006_015.mp3"}, {"type": "word", "ar": "يَعْصُونَ", "tajweed": "يَعۡصُونَ", "en": "they disobey", "tr": "yaʿṣūna", "audio": "wbw/066_006_016.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/066_006_017.mp3"}, {"type": "word", "ar": "مَآ", "tajweed": "م<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "(in) what", "tr": "mā", "audio": "wbw/066_006_018.mp3"}, {"type": "word", "ar": "أَمَرَهُمْ", "tajweed": "أَمَرَهُمۡ", "en": "He Commands them", "tr": "amarahum", "audio": "wbw/066_006_019.mp3"}, {"type": "word", "ar": "وَيَفْعَلُونَ", "tajweed": "وَيَفۡعَلُونَ", "en": "but they do", "tr": "wayafʿalūna", "audio": "wbw/066_006_020.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/066_006_021.mp3"}, {"type": "word", "ar": "يُؤْمَرُونَ", "tajweed": "يُؤۡمَر<rule class=madda_permissible>ُو</rule>نَ", "en": "they are commanded", "tr": "yu'marūna", "audio": "wbw/066_006_022.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "66:7", "juz": 28, "page": 560, "side_trans": "O you who have disbelieved, make no excuses that Day. You will only be recompensed for what you used to do.", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/066_007_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "(you) who", "tr": "alladhīna", "audio": "wbw/066_007_002.mp3"}, {"type": "word", "ar": "كَفَرُوا۟", "tajweed": "كَفَرُو<rule class=slnt>اۡ</rule>", "en": "disbelieve", "tr": "kafarū", "audio": "wbw/066_007_003.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(Do) not", "tr": "lā", "audio": "wbw/066_007_004.mp3"}, {"type": "word", "ar": "تَعْتَذِرُوا۟", "tajweed": "تَعۡتَذِرُو<rule class=slnt>اۡ</rule>", "en": "make excuses", "tr": "taʿtadhirū", "audio": "wbw/066_007_005.mp3"}, {"type": "word", "ar": "ٱلْيَوْمَ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَوۡمَ‌ۖ", "en": "today", "tr": "l-yawma", "audio": "wbw/066_007_006.mp3"}, {"type": "word", "ar": "إِنَّمَا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َمَا", "en": "Only", "tr": "innamā", "audio": "wbw/066_007_008.mp3"}, {"type": "word", "ar": "تُجْزَوْنَ", "tajweed": "تُ<rule class=qalaqah>جۡ</rule>زَوۡنَ", "en": "you will be recompensed", "tr": "tuj'zawna", "audio": "wbw/066_007_009.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "(for) what", "tr": "mā", "audio": "wbw/066_007_010.mp3"}, {"type": "word", "ar": "كُنتُمْ", "tajweed": "كُ<rule class=ikhafa>نت</rule>ُمۡ", "en": "you used to", "tr": "kuntum", "audio": "wbw/066_007_011.mp3"}, {"type": "word", "ar": "تَعْمَلُونَ", "tajweed": "تَعۡمَل<rule class=madda_permissible>ُو</rule>نَ", "en": "do", "tr": "taʿmalūna", "audio": "wbw/066_007_012.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "66:8", "juz": 28, "page": 561, "side_trans": "O you who have believed, repent to Allāh with sincere repentance. Perhaps your Lord will remove from you your misdeeds and admit you into gardens beneath which rivers flow [on] the Day when Allāh will not disgrace the Prophet and those who believed with him. Their light will proceed before them and on their right; they will say, \"Our Lord, perfect for us our light and forgive us. Indeed, You are over all things competent.\"", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/066_008_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "(you) who believe", "tr": "alladhīna", "audio": "wbw/066_008_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/066_008_003.mp3"}, {"type": "word", "ar": "تُوبُوٓا۟", "tajweed": "تُوب<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "Turn", "tr": "tūbū", "audio": "wbw/066_008_004.mp3"}, {"type": "word", "ar": "إِلَى", "tajweed": "إِلَى", "en": "to", "tr": "ilā", "audio": "wbw/066_008_005.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/066_008_006.mp3"}, {"type": "word", "ar": "تَوْبَةًۭ", "tajweed": "تَوۡبَ<rule class=idgham_ghunnah>ةً</rule>", "en": "(in) repentance", "tr": "tawbatan", "audio": "wbw/066_008_007.mp3"}, {"type": "word", "ar": "نَّصُوحًا", "tajweed": "<rule class=idgham_ghunnah>ن</rule>َّصُوحًا", "en": "sincere", "tr": "naṣūḥan", "audio": "wbw/066_008_008.mp3"}, {"type": "word", "ar": "عَسَىٰ", "tajweed": "عَسَىٰ", "en": "Perhaps", "tr": "ʿasā", "audio": "wbw/066_008_009.mp3"}, {"type": "word", "ar": "رَبُّكُمْ", "tajweed": "رَبُّكُمۡ", "en": "your Lord", "tr": "rabbukum", "audio": "wbw/066_008_010.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "will", "tr": "an", "audio": "wbw/066_008_011.mp3"}, {"type": "word", "ar": "يُكَفِّرَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُكَفِّرَ", "en": "remove", "tr": "yukaffira", "audio": "wbw/066_008_012.mp3"}, {"type": "word", "ar": "عَنكُمْ", "tajweed": "عَ<rule class=ikhafa>نك</rule>ُمۡ", "en": "from you", "tr": "ʿankum", "audio": "wbw/066_008_013.mp3"}, {"type": "word", "ar": "سَيِّـَٔاتِكُمْ", "tajweed": "سَيِّـَٔـاتِكُمۡ", "en": "your evil deeds", "tr": "sayyiātikum", "audio": "wbw/066_008_014.mp3"}, {"type": "word", "ar": "وَيُدْخِلَكُمْ", "tajweed": "وَيُ<rule class=qalaqah>دۡ</rule>خِلَكُمۡ", "en": "and admit you", "tr": "wayud'khilakum", "audio": "wbw/066_008_015.mp3"}, {"type": "word", "ar": "جَنَّـٰتٍۢ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule><rule class=ikhafa>تٍ</rule>", "en": "(into) Gardens", "tr": "jannātin", "audio": "wbw/066_008_016.mp3"}, {"type": "word", "ar": "تَجْرِى", "tajweed": "<rule class=ikhafa>ت</rule>َ<rule class=qalaqah>جۡ</rule>رِى", "en": "flow", "tr": "tajrī", "audio": "wbw/066_008_017.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/066_008_018.mp3"}, {"type": "word", "ar": "تَحْتِهَا", "tajweed": "<rule class=ikhafa>ت</rule>َحۡتِهَا", "en": "underneath it", "tr": "taḥtihā", "audio": "wbw/066_008_019.mp3"}, {"type": "word", "ar": "ٱلْأَنْهَـٰرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَنۡهَ<rule class=madda_normal>ـٰ</rule>رُ", "en": "the rivers", "tr": "l-anhāru", "audio": "wbw/066_008_020.mp3"}, {"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(on the) Day", "tr": "yawma", "audio": "wbw/066_008_021.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/066_008_022.mp3"}, {"type": "word", "ar": "يُخْزِى", "tajweed": "يُخۡزِى", "en": "will be disgraced", "tr": "yukh'zī", "audio": "wbw/066_008_023.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "(by) Allah", "tr": "l-lahu", "audio": "wbw/066_008_024.mp3"}, {"type": "word", "ar": "ٱلنَّبِىَّ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َبِىَّ", "en": "the Prophet", "tr": "l-nabiya", "audio": "wbw/066_008_025.mp3"}, {"type": "word", "ar": "وَٱلَّذِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "and those who", "tr": "wa-alladhīna", "audio": "wbw/066_008_026.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believed", "tr": "āmanū", "audio": "wbw/066_008_027.mp3"}, {"type": "word", "ar": "مَعَهُۥ ۖ", "tajweed": "مَعَهُ<rule class=madda_normal>ۥ</rule>‌ۖ", "en": "with him", "tr": "maʿahu", "audio": "wbw/066_008_028.mp3"}, {"type": "word", "ar": "نُورُهُمْ", "tajweed": "نُورُهُمۡ", "en": "Their light", "tr": "nūruhum", "audio": "wbw/066_008_030.mp3"}, {"type": "word", "ar": "يَسْعَىٰ", "tajweed": "يَسۡعَىٰ", "en": "will run", "tr": "yasʿā", "audio": "wbw/066_008_031.mp3"}, {"type": "word", "ar": "بَيْنَ", "tajweed": "بَيۡنَ", "en": "before", "tr": "bayna", "audio": "wbw/066_008_032.mp3"}, {"type": "word", "ar": "أَيْدِيهِمْ", "tajweed": "أَيۡدِيهِمۡ", "en": "their hands", "tr": "aydīhim", "audio": "wbw/066_008_033.mp3"}, {"type": "word", "ar": "وَبِأَيْمَـٰنِهِمْ", "tajweed": "وَبِأَيۡمَ<rule class=madda_normal>ـٰ</rule>نِهِمۡ", "en": "and on their right", "tr": "wabi-aymānihim", "audio": "wbw/066_008_034.mp3"}, {"type": "word", "ar": "يَقُولُونَ", "tajweed": "يَقُولُونَ", "en": "they will say", "tr": "yaqūlūna", "audio": "wbw/066_008_035.mp3"}, {"type": "word", "ar": "رَبَّنَآ", "tajweed": "رَبَّن<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Our Lord", "tr": "rabbanā", "audio": "wbw/066_008_036.mp3"}, {"type": "word", "ar": "أَتْمِمْ", "tajweed": "أَتۡمِمۡ", "en": "Perfect", "tr": "atmim", "audio": "wbw/066_008_037.mp3"}, {"type": "word", "ar": "لَنَا", "tajweed": "لَنَا", "en": "for us", "tr": "lanā", "audio": "wbw/066_008_038.mp3"}, {"type": "word", "ar": "نُورَنَا", "tajweed": "نُورَنَا", "en": "our light", "tr": "nūranā", "audio": "wbw/066_008_039.mp3"}, {"type": "word", "ar": "وَٱغْفِرْ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>غۡفِرۡ", "en": "and grant forgiveness", "tr": "wa-igh'fir", "audio": "wbw/066_008_040.mp3"}, {"type": "word", "ar": "لَنَآ ۖ", "tajweed": "لَن<rule class=madda_obligatory_monfasel>َآ‌ۖ</rule>", "en": "to us", "tr": "lanā", "audio": "wbw/066_008_041.mp3"}, {"type": "word", "ar": "إِنَّكَ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َكَ", "en": "Indeed, You", "tr": "innaka", "audio": "wbw/066_008_043.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "(are) over", "tr": "ʿalā", "audio": "wbw/066_008_044.mp3"}, {"type": "word", "ar": "كُلِّ", "tajweed": "كُلِّ", "en": "every", "tr": "kulli", "audio": "wbw/066_008_045.mp3"}, {"type": "word", "ar": "شَىْءٍۢ", "tajweed": "ش<rule class=ikhafa>َىۡءٍ</rule>", "en": "thing", "tr": "shayin", "audio": "wbw/066_008_046.mp3"}, {"type": "word", "ar": "قَدِيرٌۭ", "tajweed": "<rule class=ikhafa>ق</rule>َد<rule class=madda_permissible>ِي</rule>رٌ", "en": "All-Powerful", "tr": "qadīrun", "audio": "wbw/066_008_047.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "66:9", "juz": 28, "page": 561, "side_trans": "O Prophet, strive against the disbelievers and the hypocrites and be harsh upon them. And their refuge is Hell, and wretched is the destination.", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/066_009_001.mp3"}, {"type": "word", "ar": "ٱلنَّبِىُّ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َبِىُّ", "en": "Prophet", "tr": "l-nabiyu", "audio": "wbw/066_009_002.mp3"}, {"type": "word", "ar": "جَـٰهِدِ", "tajweed": "جَ<rule class=madda_normal>ـٰ</rule>هِدِ", "en": "Strive", "tr": "jāhidi", "audio": "wbw/066_009_003.mp3"}, {"type": "word", "ar": "ٱلْكُفَّارَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكُفَّارَ", "en": "(against) the disbelievers", "tr": "l-kufāra", "audio": "wbw/066_009_004.mp3"}, {"type": "word", "ar": "وَٱلْمُنَـٰفِقِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمُنَ<rule class=madda_normal>ـٰ</rule>فِقِينَ", "en": "and the hypocrites", "tr": "wal-munāfiqīna", "audio": "wbw/066_009_005.mp3"}, {"type": "word", "ar": "وَٱغْلُظْ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>غۡلُظۡ", "en": "and be stern", "tr": "wa-ugh'luẓ", "audio": "wbw/066_009_006.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ ۚ", "tajweed": "عَلَيۡهِمۡ‌ۚ", "en": "with them", "tr": "ʿalayhim", "audio": "wbw/066_009_007.mp3"}, {"type": "word", "ar": "وَمَأْوَىٰهُمْ", "tajweed": "وَمَأۡوَ<rule class=madda_normal>ٮٰ</rule>هُمۡ", "en": "And their abode", "tr": "wamawāhum", "audio": "wbw/066_009_009.mp3"}, {"type": "word", "ar": "جَهَنَّمُ ۖ", "tajweed": "جَهَ<rule class=ghunnah>نّ</rule>َمُ‌ۖ", "en": "(is) Hell", "tr": "jahannamu", "audio": "wbw/066_009_010.mp3"}, {"type": "word", "ar": "وَبِئْسَ", "tajweed": "وَبِئۡسَ", "en": "and wretched is", "tr": "wabi'sa", "audio": "wbw/066_009_012.mp3"}, {"type": "word", "ar": "ٱلْمَصِيرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَص<rule class=madda_permissible>ِي</rule>رُ", "en": "the destination", "tr": "l-maṣīru", "audio": "wbw/066_009_013.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "66:10", "juz": 28, "page": 561, "side_trans": "Allāh presents an example of those who disbelieved: the wife of Noah and the wife of Lot. They were under two of Our righteous servants but betrayed them, so they [i.e., those prophets] did not avail them from Allāh at all, and it was said, \"Enter the Fire with those who enter.\"", "words": [{"type": "word", "ar": "ضَرَبَ", "tajweed": "ضَرَبَ", "en": "Presents", "tr": "ḍaraba", "audio": "wbw/066_010_001.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/066_010_002.mp3"}, {"type": "word", "ar": "مَثَلًۭا", "tajweed": "مَثَل<rule class=idgham_wo_ghunnah>اً</rule>", "en": "an example", "tr": "mathalan", "audio": "wbw/066_010_003.mp3"}, {"type": "word", "ar": "لِّلَّذِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلَّذِينَ", "en": "for those who", "tr": "lilladhīna", "audio": "wbw/066_010_004.mp3"}, {"type": "word", "ar": "كَفَرُوا۟", "tajweed": "كَفَرُو<rule class=slnt>اۡ</rule>", "en": "disbelieved ", "tr": "kafarū", "audio": "wbw/066_010_005.mp3"}, {"type": "word", "ar": "ٱمْرَأَتَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>مۡرَأَتَ", "en": "(the) wife", "tr": "im'ra-ata", "audio": "wbw/066_010_006.mp3"}, {"type": "word", "ar": "نُوحٍۢ", "tajweed": "نُو<rule class=idgham_ghunnah>حٍ</rule>", "en": "(of) Nuh", "tr": "nūḥin", "audio": "wbw/066_010_007.mp3"}, {"type": "word", "ar": "وَٱمْرَأَتَ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َ<rule class=ham_wasl>ٱ</rule>مۡرَأَتَ", "en": "(and the) wife", "tr": "wa-im'ra-ata", "audio": "wbw/066_010_008.mp3"}, {"type": "word", "ar": "لُوطٍۢ ۖ", "tajweed": "لُو<rule class=ikhafa>طٍ‌ۖ</rule>", "en": "(of) Lut", "tr": "lūṭin", "audio": "wbw/066_010_009.mp3"}, {"type": "word", "ar": "كَانَتَا", "tajweed": "<rule class=ikhafa>ك</rule>َانَتَا", "en": "They were", "tr": "kānatā", "audio": "wbw/066_010_011.mp3"}, {"type": "word", "ar": "تَحْتَ", "tajweed": "تَحۡتَ", "en": "under", "tr": "taḥta", "audio": "wbw/066_010_012.mp3"}, {"type": "word", "ar": "عَبْدَيْنِ", "tajweed": "عَ<rule class=qalaqah>بۡ</rule>دَيۡنِ", "en": "two [slaves]", "tr": "ʿabdayni", "audio": "wbw/066_010_013.mp3"}, {"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "of", "tr": "min", "audio": "wbw/066_010_014.mp3"}, {"type": "word", "ar": "عِبَادِنَا", "tajweed": "عِبَادِنَا", "en": "Our slaves", "tr": "ʿibādinā", "audio": "wbw/066_010_015.mp3"}, {"type": "word", "ar": "صَـٰلِحَيْنِ", "tajweed": "صَ<rule class=madda_normal>ـٰ</rule>لِحَيۡنِ", "en": "righteous", "tr": "ṣāliḥayni", "audio": "wbw/066_010_016.mp3"}, {"type": "word", "ar": "فَخَانَتَاهُمَا", "tajweed": "فَخَانَتَاهُمَا", "en": "but they both betrayed them", "tr": "fakhānatāhumā", "audio": "wbw/066_010_017.mp3"}, {"type": "word", "ar": "فَلَمْ", "tajweed": "فَلَمۡ", "en": "so not", "tr": "falam", "audio": "wbw/066_010_018.mp3"}, {"type": "word", "ar": "يُغْنِيَا", "tajweed": "يُغۡنِيَا", "en": "they availed", "tr": "yugh'niyā", "audio": "wbw/066_010_019.mp3"}, {"type": "word", "ar": "عَنْهُمَا", "tajweed": "عَنۡهُمَا", "en": "both of them", "tr": "ʿanhumā", "audio": "wbw/066_010_020.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "from", "tr": "mina", "audio": "wbw/066_010_021.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/066_010_022.mp3"}, {"type": "word", "ar": "شَيْـًۭٔا", "tajweed": "شَيۡـ<rule class=idgham_ghunnah>ـًٔا</rule>", "en": "(in) anything", "tr": "shayan", "audio": "wbw/066_010_023.mp3"}, {"type": "word", "ar": "وَقِيلَ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َقِيلَ", "en": "and it was said", "tr": "waqīla", "audio": "wbw/066_010_024.mp3"}, {"type": "word", "ar": "ٱدْخُلَا", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>دۡ</rule>خُلَا", "en": "Enter", "tr": "ud'khulā", "audio": "wbw/066_010_025.mp3"}, {"type": "word", "ar": "ٱلنَّارَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َارَ", "en": "the Fire", "tr": "l-nāra", "audio": "wbw/066_010_026.mp3"}, {"type": "word", "ar": "مَعَ", "tajweed": "مَعَ", "en": "with", "tr": "maʿa", "audio": "wbw/066_010_027.mp3"}, {"type": "word", "ar": "ٱلدَّٰخِلِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دّ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>خِل<rule class=madda_permissible>ِي</rule>نَ", "en": "those who enter", "tr": "l-dākhilīna", "audio": "wbw/066_010_028.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "66:11", "juz": 28, "page": 561, "side_trans": "And Allāh presents an example of those who believed: the wife of Pharaoh, when she said, \"My Lord, build for me near You a house in Paradise and save me from Pharaoh and his deeds and save me from the wrongdoing people.\"", "words": [{"type": "word", "ar": "وَضَرَبَ", "tajweed": "وَضَرَبَ", "en": "And presents", "tr": "waḍaraba", "audio": "wbw/066_011_001.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/066_011_002.mp3"}, {"type": "word", "ar": "مَثَلًۭا", "tajweed": "مَثَل<rule class=idgham_wo_ghunnah>اً</rule>", "en": "an example", "tr": "mathalan", "audio": "wbw/066_011_003.mp3"}, {"type": "word", "ar": "لِّلَّذِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلَّذِينَ", "en": "for those who", "tr": "lilladhīna", "audio": "wbw/066_011_004.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believed ", "tr": "āmanū", "audio": "wbw/066_011_005.mp3"}, {"type": "word", "ar": "ٱمْرَأَتَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>مۡرَأَتَ", "en": "(the) wife", "tr": "im'ra-ata", "audio": "wbw/066_011_006.mp3"}, {"type": "word", "ar": "فِرْعَوْنَ", "tajweed": "فِرۡعَوۡنَ", "en": "(of) Firaun", "tr": "fir'ʿawna", "audio": "wbw/066_011_007.mp3"}, {"type": "word", "ar": "إِذْ", "tajweed": "إِذۡ", "en": "when", "tr": "idh", "audio": "wbw/066_011_008.mp3"}, {"type": "word", "ar": "قَالَتْ", "tajweed": "قَالَتۡ", "en": "she said", "tr": "qālat", "audio": "wbw/066_011_009.mp3"}, {"type": "word", "ar": "رَبِّ", "tajweed": "رَبِّ", "en": "My Lord", "tr": "rabbi", "audio": "wbw/066_011_010.mp3"}, {"type": "word", "ar": "ٱبْنِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>بۡ</rule>نِ", "en": "Build", "tr": "ib'ni", "audio": "wbw/066_011_011.mp3"}, {"type": "word", "ar": "لِى", "tajweed": "لِى", "en": "for me", "tr": "lī", "audio": "wbw/066_011_012.mp3"}, {"type": "word", "ar": "عِندَكَ", "tajweed": "عِ<rule class=ikhafa>ند</rule>َكَ", "en": "near You", "tr": "ʿindaka", "audio": "wbw/066_011_013.mp3"}, {"type": "word", "ar": "بَيْتًۭا", "tajweed": "بَيۡ<rule class=ikhafa>تًا</rule>", "en": "a house", "tr": "baytan", "audio": "wbw/066_011_014.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "<rule class=ikhafa>ف</rule>ِى", "en": "in", "tr": "fī", "audio": "wbw/066_011_015.mp3"}, {"type": "word", "ar": "ٱلْجَنَّةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجَ<rule class=ghunnah>نّ</rule>َةِ", "en": "Paradise", "tr": "l-janati", "audio": "wbw/066_011_016.mp3"}, {"type": "word", "ar": "وَنَجِّنِى", "tajweed": "وَنَجِّنِى", "en": "and save me", "tr": "wanajjinī", "audio": "wbw/066_011_017.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/066_011_018.mp3"}, {"type": "word", "ar": "فِرْعَوْنَ", "tajweed": "<rule class=ikhafa>ف</rule>ِرۡعَوۡنَ", "en": "Firaun", "tr": "fir'ʿawna", "audio": "wbw/066_011_019.mp3"}, {"type": "word", "ar": "وَعَمَلِهِۦ", "tajweed": "وَعَمَلِه<rule class=madda_normal>ِۦ</rule>", "en": "and his deeds", "tr": "waʿamalihi", "audio": "wbw/066_011_020.mp3"}, {"type": "word", "ar": "وَنَجِّنِى", "tajweed": "وَنَجِّنِى", "en": "and save me", "tr": "wanajjinī", "audio": "wbw/066_011_021.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "from", "tr": "mina", "audio": "wbw/066_011_022.mp3"}, {"type": "word", "ar": "ٱلْقَوْمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَوۡمِ", "en": "the people", "tr": "l-qawmi", "audio": "wbw/066_011_023.mp3"}, {"type": "word", "ar": "ٱلظَّـٰلِمِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ظَّ<rule class=madda_normal>ـٰ</rule>لِم<rule class=madda_permissible>ِي</rule>نَ", "en": "the wrongdoers", "tr": "l-ẓālimīna", "audio": "wbw/066_011_024.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "66:12", "juz": 28, "page": 561, "side_trans": "And [the example of] Mary, the daughter of ʿImrān, who guarded her chastity, so We blew into [her garment] through Our angel [i.e., Gabriel], and she believed in the words of her Lord and His scriptures and was of the devoutly obedient.", "words": [{"type": "word", "ar": "وَمَرْيَمَ", "tajweed": "وَمَرۡيَمَ", "en": "And Maryam", "tr": "wamaryama", "audio": "wbw/066_012_001.mp3"}, {"type": "word", "ar": "ٱبْنَتَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>بۡ</rule>نَتَ", "en": "(the) daughter", "tr": "ib'nata", "audio": "wbw/066_012_002.mp3"}, {"type": "word", "ar": "عِمْرَٰنَ", "tajweed": "عِمۡر<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>نَ", "en": "(of) Imran", "tr": "ʿim'rāna", "audio": "wbw/066_012_003.mp3"}, {"type": "word", "ar": "ٱلَّتِىٓ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّت<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "who", "tr": "allatī", "audio": "wbw/066_012_004.mp3"}, {"type": "word", "ar": "أَحْصَنَتْ", "tajweed": "أَحۡصَنَتۡ", "en": "guarded", "tr": "aḥṣanat", "audio": "wbw/066_012_005.mp3"}, {"type": "word", "ar": "فَرْجَهَا", "tajweed": "فَرۡجَهَا", "en": "her chastity", "tr": "farjahā", "audio": "wbw/066_012_006.mp3"}, {"type": "word", "ar": "فَنَفَخْنَا", "tajweed": "فَنَفَخۡنَا", "en": "so We breathed", "tr": "fanafakhnā", "audio": "wbw/066_012_007.mp3"}, {"type": "word", "ar": "فِيهِ", "tajweed": "فِيهِ", "en": "into it", "tr": "fīhi", "audio": "wbw/066_012_008.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_wo_ghunnah>ِن</rule>", "en": "of", "tr": "min", "audio": "wbw/066_012_009.mp3"}, {"type": "word", "ar": "رُّوحِنَا", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>ُّوحِنَا", "en": "Our Spirit", "tr": "rūḥinā", "audio": "wbw/066_012_010.mp3"}, {"type": "word", "ar": "وَصَدَّقَتْ", "tajweed": "وَصَدَّقَتۡ", "en": "And she believed", "tr": "waṣaddaqat", "audio": "wbw/066_012_011.mp3"}, {"type": "word", "ar": "بِكَلِمَـٰتِ", "tajweed": "بِكَلِمَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "(in the) Words", "tr": "bikalimāti", "audio": "wbw/066_012_012.mp3"}, {"type": "word", "ar": "رَبِّهَا", "tajweed": "رَبِّهَا", "en": "(of) her Lord", "tr": "rabbihā", "audio": "wbw/066_012_013.mp3"}, {"type": "word", "ar": "وَكُتُبِهِۦ", "tajweed": "وَكُتُبِه<rule class=madda_normal>ِۦ</rule>", "en": "and His Books", "tr": "wakutubihi", "audio": "wbw/066_012_014.mp3"}, {"type": "word", "ar": "وَكَانَتْ", "tajweed": "وَكَانَتۡ", "en": "and she was", "tr": "wakānat", "audio": "wbw/066_012_015.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "of", "tr": "mina", "audio": "wbw/066_012_016.mp3"}, {"type": "word", "ar": "ٱلْقَـٰنِتِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَ<rule class=madda_normal>ـٰ</rule>نِت<rule class=madda_permissible>ِي</rule>نَ", "en": "the devoutly obedient", "tr": "l-qānitīna", "audio": "wbw/066_012_017.mp3"}, {"type": "end", "num": "١٢"}]}]