[{"id": 1, "key": "111:1", "juz": 30, "page": 603, "side_trans": "May the hands of Abū Lahab be ruined, and ruined is he.", "words": [{"type": "word", "ar": "تَبَّتْ", "tajweed": "تَبَّتۡ", "en": "Perish", "tr": "tabbat", "audio": "wbw/111_001_001.mp3"}, {"type": "word", "ar": "يَدَآ", "tajweed": "يَد<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "(the) hands", "tr": "yadā", "audio": "wbw/111_001_002.mp3"}, {"type": "word", "ar": "أَبِى", "tajweed": "أَبِى", "en": "(of) Abu", "tr": "abī", "audio": "wbw/111_001_003.mp3"}, {"type": "word", "ar": "لَهَبٍۢ", "tajweed": "لَهَ<rule class=idgham_ghunnah>بٍ</rule>", "en": "Lahab", "tr": "lahabin", "audio": "wbw/111_001_004.mp3"}, {"type": "word", "ar": "وَتَبَّ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َتَ<rule class=qalaqah>ب</rule>َّ", "en": "and perish he", "tr": "watabba", "audio": "wbw/111_001_005.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "111:2", "juz": 30, "page": 603, "side_trans": "His wealth will not avail him or that which he gained.", "words": [{"type": "word", "ar": "مَآ", "tajweed": "م<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Not", "tr": "mā", "audio": "wbw/111_002_001.mp3"}, {"type": "word", "ar": "أَغْنَىٰ", "tajweed": "أَغۡنَىٰ", "en": "(will) avail", "tr": "aghnā", "audio": "wbw/111_002_002.mp3"}, {"type": "word", "ar": "عَنْهُ", "tajweed": "عَنۡهُ", "en": "him", "tr": "ʿanhu", "audio": "wbw/111_002_003.mp3"}, {"type": "word", "ar": "مَالُهُۥ", "tajweed": "مَالُهُ<rule class=madda_normal>ۥ</rule>", "en": "his wealth", "tr": "māluhu", "audio": "wbw/111_002_004.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "and what", "tr": "wamā", "audio": "wbw/111_002_005.mp3"}, {"type": "word", "ar": "كَسَبَ", "tajweed": "كَسَ<rule class=qalaqah>ب</rule>َ", "en": "he earned", "tr": "kasaba", "audio": "wbw/111_002_006.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "111:3", "juz": 30, "page": 603, "side_trans": "He will [enter to] burn in a Fire of [blazing] flame", "words": [{"type": "word", "ar": "سَيَصْلَىٰ", "tajweed": "سَيَصۡلَىٰ", "en": "He will be burnt", "tr": "sayaṣlā", "audio": "wbw/111_003_001.mp3"}, {"type": "word", "ar": "نَارًۭا", "tajweed": "نَا<rule class=ikhafa>رًا</rule>", "en": "(in) a Fire", "tr": "nāran", "audio": "wbw/111_003_002.mp3"}, {"type": "word", "ar": "ذَاتَ", "tajweed": "<rule class=ikhafa>ذ</rule>َاتَ", "en": "of", "tr": "dhāta", "audio": "wbw/111_003_003.mp3"}, {"type": "word", "ar": "لَهَبٍۢ", "tajweed": "لَهَ<rule class=qalaqah>ب</rule>ٍ", "en": "Blazing Flames", "tr": "lahabin", "audio": "wbw/111_003_004.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "111:4", "juz": 30, "page": 603, "side_trans": "And his wife [as well] - the carrier of firewood.", "words": [{"type": "word", "ar": "وَٱمْرَأَتُهُۥ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>مۡرَأَتُهُ<rule class=madda_normal>ۥ</rule>", "en": "And his wife", "tr": "wa-im'ra-atuhu", "audio": "wbw/111_004_001.mp3"}, {"type": "word", "ar": "حَمَّالَةَ", "tajweed": "حَ<rule class=ghunnah>مّ</rule>َالَةَ", "en": "(the) carrier", "tr": "ḥammālata", "audio": "wbw/111_004_002.mp3"}, {"type": "word", "ar": "ٱلْحَطَبِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَطَ<rule class=qalaqah>ب</rule>ِ", "en": "(of) firewood", "tr": "l-ḥaṭabi", "audio": "wbw/111_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "111:5", "juz": 30, "page": 603, "side_trans": "Around her neck is a rope of [twisted] fiber.", "words": [{"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "In", "tr": "fī", "audio": "wbw/111_005_001.mp3"}, {"type": "word", "ar": "جِيدِهَا", "tajweed": "جِيدِهَا", "en": "her neck", "tr": "jīdihā", "audio": "wbw/111_005_002.mp3"}, {"type": "word", "ar": "حَبْلٌۭ", "tajweed": "حَ<rule class=qalaqah>بۡ</rule><rule class=idgham_ghunnah>لٌ</rule>", "en": "(will be) a rope", "tr": "ḥablun", "audio": "wbw/111_005_003.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_ghunnah>م</rule>ّ<rule class=idgham_ghunnah>ِن</rule>", "en": "of", "tr": "min", "audio": "wbw/111_005_004.mp3"}, {"type": "word", "ar": "مَّسَدٍۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّسَ<rule class=qalaqah>د</rule>ِۭ", "en": "palm-fiber", "tr": "masadin", "audio": "wbw/111_005_005.mp3"}, {"type": "end", "num": "٥"}]}]