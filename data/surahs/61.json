 "ʿalā", "audio": "wbw/061_014_035.mp3"}, {"type": "word", "ar": "عَدُوِّهِمْ", "tajweed": "عَدُوِّهِمۡ", "en": "their enemy", "tr": "ʿaduwwihim", "audio": "wbw/061_014_036.mp3"}, {"type": "word", "ar": "فَأَصْبَحُوا۟", "tajweed": "فَأَصۡبَحُو<rule class=slnt>اۡ</rule>", "en": "and they became", "tr": "fa-aṣbaḥū", "audio": "wbw/061_014_037.mp3"}, {"type": "word", "ar": "ظَـٰهِرِينَ", "tajweed": "ظَ<rule class=madda_normal>ـٰ</rule>هِر<rule class=madda_permissible>ِي</rule>نَ", "en": "dominant", "tr": "ẓāhirīna", "audio": "wbw/061_014_038.mp3"}, {"type": "end", "num": "١٤"}]}]