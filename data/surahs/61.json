[{"id": 1, "key": "61:1", "juz": 28, "page": 551, "side_trans": "Whatever is in the heavens and whatever is on the earth exalts Allāh, and He is the Exalted in Might, the Wise.", "words": [{"type": "word", "ar": "سَبَّحَ", "tajweed": "سَبَّحَ", "en": "Glorifies", "tr": "sabbaḥa", "audio": "wbw/061_001_001.mp3"}, {"type": "word", "ar": "لِلَّهِ", "tajweed": "لِلَّهِ", "en": "Allah", "tr": "lillahi", "audio": "wbw/061_001_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "whatever", "tr": "mā", "audio": "wbw/061_001_003.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(is) in", "tr": "fī", "audio": "wbw/061_001_004.mp3"}, {"type": "word", "ar": "ٱلسَّمَـٰوَٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّمَ<rule class=madda_normal>ـٰ</rule>و<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِ", "en": "the heavens", "tr": "l-samāwāti", "audio": "wbw/061_001_005.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "and whatever", "tr": "wamā", "audio": "wbw/061_001_006.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(is) in", "tr": "fī", "audio": "wbw/061_001_007.mp3"}, {"type": "word", "ar": "ٱلْأَرْضِ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ‌ۖ", "en": "the earth", "tr": "l-arḍi", "audio": "wbw/061_001_008.mp3"}, {"type": "word", "ar": "وَهُوَ", "tajweed": "وَهُوَ", "en": "And He", "tr": "wahuwa", "audio": "wbw/061_001_010.mp3"}, {"type": "word", "ar": "ٱلْعَزِيزُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَزِيزُ", "en": "(is) the All-Mighty", "tr": "l-ʿazīzu", "audio": "wbw/061_001_011.mp3"}, {"type": "word", "ar": "ٱلْحَكِيمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَك<rule class=madda_permissible>ِي</rule>مُ", "en": "the All-Wise", "tr": "l-ḥakīmu", "audio": "wbw/061_001_012.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "61:2", "juz": 28, "page": 551, "side_trans": "O you who have believed, why do you say what you do not do?", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/061_002_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "(you) who", "tr": "alladhīna", "audio": "wbw/061_002_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/061_002_003.mp3"}, {"type": "word", "ar": "لِمَ", "tajweed": "لِمَ", "en": "Why", "tr": "lima", "audio": "wbw/061_002_004.mp3"}, {"type": "word", "ar": "تَقُولُونَ", "tajweed": "تَقُولُونَ", "en": "(do) you say", "tr": "taqūlūna", "audio": "wbw/061_002_005.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/061_002_006.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/061_002_007.mp3"}, {"type": "word", "ar": "تَفْعَلُونَ", "tajweed": "تَفۡعَل<rule class=madda_permissible>ُو</rule>نَ", "en": "you do", "tr": "tafʿalūna", "audio": "wbw/061_002_008.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "61:3", "juz": 28, "page": 551, "side_trans": "Greatly hateful in the sight of Allāh is that you say what you do not do.", "words": [{"type": "word", "ar": "كَبُرَ", "tajweed": "كَبُرَ", "en": "Great is", "tr": "kabura", "audio": "wbw/061_003_001.mp3"}, {"type": "word", "ar": "مَقْتًا", "tajweed": "مَ<rule class=qalaqah>قۡ</rule>تًا", "en": "hatred", "tr": "maqtan", "audio": "wbw/061_003_002.mp3"}, {"type": "word", "ar": "عِندَ", "tajweed": "عِ<rule class=ikhafa>ند</rule>َ", "en": "with", "tr": "ʿinda", "audio": "wbw/061_003_003.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/061_003_004.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أَ<rule class=ikhafa>ن</rule>", "en": "that", "tr": "an", "audio": "wbw/061_003_005.mp3"}, {"type": "word", "ar": "تَقُولُوا۟", "tajweed": "<rule class=ikhafa>ت</rule>َقُولُو<rule class=slnt>اۡ</rule>", "en": "you say", "tr": "taqūlū", "audio": "wbw/061_003_006.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/061_003_007.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/061_003_008.mp3"}, {"type": "word", "ar": "تَفْعَلُونَ", "tajweed": "تَفۡعَل<rule class=madda_permissible>ُو</rule>نَ", "en": "you do", "tr": "tafʿalūna", "audio": "wbw/061_003_009.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "61:4", "juz": 28, "page": 551, "side_trans": "Indeed, Allāh loves those who fight in His cause in a row as though they are a [single] structure joined firmly.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/061_004_001.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/061_004_002.mp3"}, {"type": "word", "ar": "يُحِبُّ", "tajweed": "يُحِبُّ", "en": "loves", "tr": "yuḥibbu", "audio": "wbw/061_004_003.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/061_004_004.mp3"}, {"type": "word", "ar": "يُقَـٰتِلُونَ", "tajweed": "يُقَ<rule class=madda_normal>ـٰ</rule>تِلُونَ", "en": "fight", "tr": "yuqātilūna", "audio": "wbw/061_004_005.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/061_004_006.mp3"}, {"type": "word", "ar": "سَبِيلِهِۦ", "tajweed": "سَبِيلِه<rule class=madda_normal>ِۦ</rule>", "en": "His Way", "tr": "sabīlihi", "audio": "wbw/061_004_007.mp3"}, {"type": "word", "ar": "صَفًّۭا", "tajweed": "صَف<rule class=ikhafa>ًّا</rule>", "en": "(in) a row", "tr": "ṣaffan", "audio": "wbw/061_004_008.mp3"}, {"type": "word", "ar": "كَأَنَّهُم", "tajweed": "<rule class=ikhafa>ك</rule>َأَ<rule class=ghunnah>نّ</rule>َه<rule class=ikhafa_shafawi>ُم</rule>", "en": "as if they", "tr": "ka-annahum", "audio": "wbw/061_004_009.mp3"}, {"type": "word", "ar": "بُنْيَـٰنٌۭ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ُنۡيَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>نٌ</rule>", "en": "(were) a structure", "tr": "bun'yānun", "audio": "wbw/061_004_010.mp3"}, {"type": "word", "ar": "مَّرْصُوصٌۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّرۡص<rule class=madda_permissible>ُو</rule>صٌ", "en": "joined firmly", "tr": "marṣūṣun", "audio": "wbw/061_004_011.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "61:5", "juz": 28, "page": 551, "side_trans": "And [mention, O Muḥammad], when Moses said to his people, \"O my people, why do you harm me while you certainly know that I am the messenger of Allāh to you?\" And when they deviated, Allāh caused their hearts to deviate. And Allāh does not guide the defiantly disobedient people.", "words": [{"type": "word", "ar": "وَإِذْ", "tajweed": "وَإِذۡ", "en": "And when", "tr": "wa-idh", "audio": "wbw/061_005_001.mp3"}, {"type": "word", "ar": "قَالَ", "tajweed": "قَالَ", "en": "said", "tr": "qāla", "audio": "wbw/061_005_002.mp3"}, {"type": "word", "ar": "مُوسَىٰ", "tajweed": "مُوسَىٰ", "en": "Musa", "tr": "mūsā", "audio": "wbw/061_005_003.mp3"}, {"type": "word", "ar": "لِقَوْمِهِۦ", "tajweed": "لِقَوۡمِه<rule class=madda_normal>ِۦ</rule>", "en": "to his people", "tr": "liqawmihi", "audio": "wbw/061_005_004.mp3"}, {"type": "word", "ar": "يَـٰقَوْمِ", "tajweed": "يَ<rule class=madda_normal>ـٰ</rule>قَوۡمِ", "en": "O my people", "tr": "yāqawmi", "audio": "wbw/061_005_005.mp3"}, {"type": "word", "ar": "لِمَ", "tajweed": "لِمَ", "en": "Why", "tr": "lima", "audio": "wbw/061_005_006.mp3"}, {"type": "word", "ar": "تُؤْذُونَنِى", "tajweed": "تُؤۡذُونَنِى", "en": "do you hurt me", "tr": "tu'dhūnanī", "audio": "wbw/061_005_007.mp3"}, {"type": "word", "ar": "وَقَد", "tajweed": "وَقَ<rule class=idgham_mutajanisayn>د</rule>", "en": "while certainly", "tr": "waqad", "audio": "wbw/061_005_008.mp3"}, {"type": "word", "ar": "تَّعْلَمُونَ", "tajweed": "تَّعۡلَمُونَ", "en": "you know", "tr": "taʿlamūna", "audio": "wbw/061_005_009.mp3"}, {"type": "word", "ar": "أَنِّى", "tajweed": "أَ<rule class=ghunnah>نّ</rule>ِى", "en": "that I am", "tr": "annī", "audio": "wbw/061_005_010.mp3"}, {"type": "word", "ar": "رَسُولُ", "tajweed": "رَسُولُ", "en": "(the) Messenger", "tr": "rasūlu", "audio": "wbw/061_005_011.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/061_005_012.mp3"}, {"type": "word", "ar": "إِلَيْكُمْ ۖ", "tajweed": "إِلَيۡكُمۡ‌ۖ", "en": "to you", "tr": "ilaykum", "audio": "wbw/061_005_013.mp3"}, {"type": "word", "ar": "فَلَمَّا", "tajweed": "فَلَ<rule class=ghunnah>مّ</rule>َا", "en": "Then when", "tr": "falammā", "audio": "wbw/061_005_015.mp3"}, {"type": "word", "ar": "زَاغُوٓا۟", "tajweed": "زَاغ<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "they deviated", "tr": "zāghū", "audio": "wbw/061_005_016.mp3"}, {"type": "word", "ar": "أَزَاغَ", "tajweed": "أَزَاغَ", "en": "(was caused to) deviate", "tr": "azāgha", "audio": "wbw/061_005_017.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "(by) Allah", "tr": "l-lahu", "audio": "wbw/061_005_018.mp3"}, {"type": "word", "ar": "قُلُوبَهُمْ ۚ", "tajweed": "قُلُوبَهُمۡ‌ۚ", "en": "their hearts", "tr": "qulūbahum", "audio": "wbw/061_005_019.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/061_005_021.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(does) not", "tr": "lā", "audio": "wbw/061_005_022.mp3"}, {"type": "word", "ar": "يَهْدِى", "tajweed": "يَهۡدِى", "en": "guide", "tr": "yahdī", "audio": "wbw/061_005_023.mp3"}, {"type": "word", "ar": "ٱلْقَوْمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَوۡمَ", "en": "the people", "tr": "l-qawma", "audio": "wbw/061_005_024.mp3"}, {"type": "word", "ar": "ٱلْفَـٰسِقِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَ<rule class=madda_normal>ـٰ</rule>سِق<rule class=madda_permissible>ِي</rule>نَ", "en": "the defiantly disobedient", "tr": "l-fāsiqīna", "audio": "wbw/061_005_025.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "61:6", "juz": 28, "page": 552, "side_trans": "And [mention] when Jesus, the son of Mary, said, \"O Children of Israel, indeed I am the messenger of Allāh to you confirming what came before me of the Torah and bringing good tidings of a messenger to come after me, whose name is Aḥmad.\" But when he came to them with clear evidences, they said, \"This is obvious magic.\"", "words": [{"type": "word", "ar": "وَإِذْ", "tajweed": "وَإِذۡ", "en": "And when", "tr": "wa-idh", "audio": "wbw/061_006_001.mp3"}, {"type": "word", "ar": "قَالَ", "tajweed": "قَالَ", "en": "said", "tr": "qāla", "audio": "wbw/061_006_002.mp3"}, {"type": "word", "ar": "عِيسَى", "tajweed": "عِيسَى", "en": "Isa", "tr": "ʿīsā", "audio": "wbw/061_006_003.mp3"}, {"type": "word", "ar": "ٱبْنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>بۡ</rule>نُ", "en": "son", "tr": "ub'nu", "audio": "wbw/061_006_004.mp3"}, {"type": "word", "ar": "مَرْيَمَ", "tajweed": "مَرۡيَمَ", "en": "(of) Maryam", "tr": "maryama", "audio": "wbw/061_006_005.mp3"}, {"type": "word", "ar": "يَـٰبَنِىٓ", "tajweed": "يَ<rule class=madda_normal>ـٰ</rule>بَن<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "O Children", "tr": "yābanī", "audio": "wbw/061_006_006.mp3"}, {"type": "word", "ar": "إِسْرَٰٓءِيلَ", "tajweed": "إِسۡر<rule class=madda_obligatory_mottasel><rule class=custom-alef-maksora>ٰ</rule></rule>ٓءِيلَ", "en": "(of) Israel", "tr": "is'rāīla", "audio": "wbw/061_006_007.mp3"}, {"type": "word", "ar": "إِنِّى", "tajweed": "إِ<rule class=ghunnah>نّ</rule>ِى", "en": "Indeed, I am", "tr": "innī", "audio": "wbw/061_006_008.mp3"}, {"type": "word", "ar": "رَسُولُ", "tajweed": "رَسُولُ", "en": "(the) Messenger", "tr": "rasūlu", "audio": "wbw/061_006_009.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/061_006_010.mp3"}, {"type": "word", "ar": "إِلَيْكُم", "tajweed": "إِلَيۡك<rule class=idgham_shafawi>ُم</rule>", "en": "to you", "tr": "ilaykum", "audio": "wbw/061_006_011.mp3"}, {"type": "word", "ar": "مُّصَدِّقًۭا", "tajweed": "<rule class=idgham_shafawi>م</rule>ُّصَدِّ<rule class=idgham_wo_ghunnah>قًا</rule>", "en": "confirming", "tr": "muṣaddiqan", "audio": "wbw/061_006_012.mp3"}, {"type": "word", "ar": "لِّمَا", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّمَا", "en": "that which", "tr": "limā", "audio": "wbw/061_006_013.mp3"}, {"type": "word", "ar": "بَيْنَ", "tajweed": "بَيۡنَ", "en": "(was) between", "tr": "bayna", "audio": "wbw/061_006_014.mp3"}, {"type": "word", "ar": "يَدَىَّ", "tajweed": "يَدَىَّ", "en": "my hands", "tr": "yadayya", "audio": "wbw/061_006_015.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "of", "tr": "mina", "audio": "wbw/061_006_016.mp3"}, {"type": "word", "ar": "ٱلتَّوْرَىٰةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>تَّوۡرَ<rule class=madda_normal>ٮٰ</rule>ةِ", "en": "the Taurat", "tr": "l-tawrāti", "audio": "wbw/061_006_017.mp3"}, {"type": "word", "ar": "وَمُبَشِّرًۢا", "tajweed": "وَمُبَشِّر<rule class=iqlab>َۢا</rule>", "en": "and bringing glad tidings", "tr": "wamubashiran", "audio": "wbw/061_006_018.mp3"}, {"type": "word", "ar": "بِرَسُولٍۢ", "tajweed": "<rule class=iqlab>ب</rule>ِرَسُو<rule class=idgham_ghunnah>لٍ</rule>", "en": "(of) a Messenger", "tr": "birasūlin", "audio": "wbw/061_006_019.mp3"}, {"type": "word", "ar": "يَأْتِى", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َأۡتِى", "en": "to come", "tr": "yatī", "audio": "wbw/061_006_020.mp3"}, {"type": "word", "ar": "مِنۢ", "tajweed": "م<rule class=iqlab>ِنۢ</rule>", "en": "from", "tr": "min", "audio": "wbw/061_006_021.mp3"}, {"type": "word", "ar": "بَعْدِى", "tajweed": "<rule class=iqlab>ب</rule>َعۡدِى", "en": "after me", "tr": "baʿdī", "audio": "wbw/061_006_022.mp3"}, {"type": "word", "ar": "ٱسْمُهُۥٓ", "tajweed": "<rule class=ham_wasl>ٱ</rule>سۡمُهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "whose name (will be)", "tr": "us'muhu", "audio": "wbw/061_006_023.mp3"}, {"type": "word", "ar": "أَحْمَدُ ۖ", "tajweed": "أَحۡمَدُ‌ۖ", "en": "Ahmad", "tr": "aḥmadu", "audio": "wbw/061_006_024.mp3"}, {"type": "word", "ar": "فَلَمَّا", "tajweed": "فَلَ<rule class=ghunnah>مّ</rule>َا", "en": "But when", "tr": "falammā", "audio": "wbw/061_006_026.mp3"}, {"type": "word", "ar": "جَآءَهُم", "tajweed": "ج<rule class=madda_obligatory_mottasel>َا</rule>ٓءَه<rule class=ikhafa_shafawi>ُم</rule>", "en": "he came to them", "tr": "jāahum", "audio": "wbw/061_006_027.mp3"}, {"type": "word", "ar": "بِٱلْبَيِّنَـٰتِ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِ<rule class=ham_wasl>ٱ</rule>لۡبَيِّنَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "with clear proofs", "tr": "bil-bayināti", "audio": "wbw/061_006_028.mp3"}, {"type": "word", "ar": "قَالُوا۟", "tajweed": "قَالُو<rule class=slnt>اۡ</rule>", "en": "they said", "tr": "qālū", "audio": "wbw/061_006_029.mp3"}, {"type": "word", "ar": "هَـٰذَا", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>ذَا", "en": "This", "tr": "hādhā", "audio": "wbw/061_006_030.mp3"}, {"type": "word", "ar": "سِحْرٌۭ", "tajweed": "سِحۡ<rule class=idgham_ghunnah>رٌ</rule>", "en": "(is) a magic", "tr": "siḥ'run", "audio": "wbw/061_006_031.mp3"}, {"type": "word", "ar": "مُّبِينٌۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّب<rule class=madda_permissible>ِي</rule>نٌ", "en": "clear", "tr": "mubīnun", "audio": "wbw/061_006_032.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "61:7", "juz": 28, "page": 552, "side_trans": "And who is more unjust than one who invents about Allāh untruth while he is being invited to Islām. And Allāh does not guide the wrongdoing people.", "words": [{"type": "word", "ar": "وَمَنْ", "tajweed": "وَمَنۡ", "en": "And who", "tr": "waman", "audio": "wbw/061_007_001.mp3"}, {"type": "word", "ar": "أَظْلَمُ", "tajweed": "أَظۡلَمُ", "en": "(is) more wrong", "tr": "aẓlamu", "audio": "wbw/061_007_002.mp3"}, {"type": "word", "ar": "مِمَّنِ", "tajweed": "مِ<rule class=ghunnah>مّ</rule>َنِ", "en": "than (one) who", "tr": "mimmani", "audio": "wbw/061_007_003.mp3"}, {"type": "word", "ar": "ٱفْتَرَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>فۡتَرَىٰ", "en": "invents", "tr": "if'tarā", "audio": "wbw/061_007_004.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "upon", "tr": "ʿalā", "audio": "wbw/061_007_005.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/061_007_006.mp3"}, {"type": "word", "ar": "ٱلْكَذِبَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَذِبَ", "en": "the lie", "tr": "l-kadhiba", "audio": "wbw/061_007_007.mp3"}, {"type": "word", "ar": "وَهُوَ", "tajweed": "وَهُوَ", "en": "while he", "tr": "wahuwa", "audio": "wbw/061_007_008.mp3"}, {"type": "word", "ar": "يُدْعَىٰٓ", "tajweed": "يُ<rule class=qalaqah>دۡ</rule>عَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "is invited", "tr": "yud'ʿā", "audio": "wbw/061_007_009.mp3"}, {"type": "word", "ar": "إِلَى", "tajweed": "إِلَى", "en": "to", "tr": "ilā", "audio": "wbw/061_007_010.mp3"}, {"type": "word", "ar": "ٱلْإِسْلَـٰمِ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِسۡلَ<rule class=madda_normal>ـٰ</rule>مِ‌ۚ", "en": "Islam", "tr": "l-is'lāmi", "audio": "wbw/061_007_011.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/061_007_013.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(does) not", "tr": "lā", "audio": "wbw/061_007_014.mp3"}, {"type": "word", "ar": "يَهْدِى", "tajweed": "يَهۡدِى", "en": "guide", "tr": "yahdī", "audio": "wbw/061_007_015.mp3"}, {"type": "word", "ar": "ٱلْقَوْمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَوۡمَ", "en": "the people", "tr": "l-qawma", "audio": "wbw/061_007_016.mp3"}, {"type": "word", "ar": "ٱلظَّـٰلِمِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ظَّ<rule class=madda_normal>ـٰ</rule>لِم<rule class=madda_permissible>ِي</rule>نَ", "en": "[the] wrongdoers", "tr": "l-ẓālimīna", "audio": "wbw/061_007_017.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "61:8", "juz": 28, "page": 552, "side_trans": "They want to extinguish the light of Allāh with their mouths, but Allāh will perfect His light, although the disbelievers dislike it.", "words": [{"type": "word", "ar": "يُرِيدُونَ", "tajweed": "يُرِيدُونَ", "en": "They intend", "tr": "yurīdūna", "audio": "wbw/061_008_001.mp3"}, {"type": "word", "ar": "لِيُطْفِـُٔوا۟", "tajweed": "لِيُ<rule class=qalaqah>طۡ</rule>فِــُٔو<rule class=slnt>اۡ</rule>", "en": "to put out", "tr": "liyuṭ'fiū", "audio": "wbw/061_008_002.mp3"}, {"type": "word", "ar": "نُورَ", "tajweed": "نُورَ", "en": "(the) light", "tr": "nūra", "audio": "wbw/061_008_003.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/061_008_004.mp3"}, {"type": "word", "ar": "بِأَفْوَٰهِهِمْ", "tajweed": "بِأَفۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>هِهِمۡ", "en": "with their mouths", "tr": "bi-afwāhihim", "audio": "wbw/061_008_005.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "but Allah", "tr": "wal-lahu", "audio": "wbw/061_008_006.mp3"}, {"type": "word", "ar": "مُتِمُّ", "tajweed": "مُتِ<rule class=ghunnah>مّ</rule>ُ", "en": "will perfect", "tr": "mutimmu", "audio": "wbw/061_008_007.mp3"}, {"type": "word", "ar": "نُورِهِۦ", "tajweed": "نُورِه<rule class=madda_normal>ِۦ</rule>", "en": "His Light", "tr": "nūrihi", "audio": "wbw/061_008_008.mp3"}, {"type": "word", "ar": "وَلَوْ", "tajweed": "وَلَوۡ", "en": "although", "tr": "walaw", "audio": "wbw/061_008_009.mp3"}, {"type": "word", "ar": "كَرِهَ", "tajweed": "كَرِهَ", "en": "dislike", "tr": "kariha", "audio": "wbw/061_008_010.mp3"}, {"type": "word", "ar": "ٱلْكَـٰفِرُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَ<rule class=madda_normal>ـٰ</rule>فِر<rule class=madda_permissible>ُو</rule>نَ", "en": "the disbelievers", "tr": "l-kāfirūna", "audio": "wbw/061_008_011.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "61:9", "juz": 28, "page": 552, "side_trans": "It is He who sent His Messenger with guidance and the religion of truth to manifest it over all religion, although those who associate others with Allāh dislike it.", "words": [{"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "He", "tr": "huwa", "audio": "wbw/061_009_001.mp3"}, {"type": "word", "ar": "ٱلَّذِىٓ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذ<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "(is) the One Who", "tr": "alladhī", "audio": "wbw/061_009_002.mp3"}, {"type": "word", "ar": "أَرْسَلَ", "tajweed": "أَرۡسَلَ", "en": "sent", "tr": "arsala", "audio": "wbw/061_009_003.mp3"}, {"type": "word", "ar": "رَسُولَهُۥ", "tajweed": "رَسُولَهُ<rule class=madda_normal>ۥ</rule>", "en": "His Messenger", "tr": "rasūlahu", "audio": "wbw/061_009_004.mp3"}, {"type": "word", "ar": "بِٱلْهُدَىٰ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡهُدَىٰ", "en": "with guidance", "tr": "bil-hudā", "audio": "wbw/061_009_005.mp3"}, {"type": "word", "ar": "وَدِينِ", "tajweed": "وَدِينِ", "en": "and (the) religion", "tr": "wadīni", "audio": "wbw/061_009_006.mp3"}, {"type": "word", "ar": "ٱلْحَقِّ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَقِّ", "en": "(of) the truth", "tr": "l-ḥaqi", "audio": "wbw/061_009_007.mp3"}, {"type": "word", "ar": "لِيُظْهِرَهُۥ", "tajweed": "لِيُظۡهِرَهُ<rule class=madda_normal>ۥ</rule>", "en": "to make it prevail", "tr": "liyuẓ'hirahu", "audio": "wbw/061_009_008.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "over", "tr": "ʿalā", "audio": "wbw/061_009_009.mp3"}, {"type": "word", "ar": "ٱلدِّينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دِّينِ", "en": "the religion", "tr": "l-dīni", "audio": "wbw/061_009_010.mp3"}, {"type": "word", "ar": "كُلِّهِۦ", "tajweed": "كُلِّه<rule class=madda_normal>ِۦ</rule>", "en": "all of them", "tr": "kullihi", "audio": "wbw/061_009_011.mp3"}, {"type": "word", "ar": "وَلَوْ", "tajweed": "وَلَوۡ", "en": "although", "tr": "walaw", "audio": "wbw/061_009_012.mp3"}, {"type": "word", "ar": "كَرِهَ", "tajweed": "كَرِهَ", "en": "dislike (it)", "tr": "kariha", "audio": "wbw/061_009_013.mp3"}, {"type": "word", "ar": "ٱلْمُشْرِكُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُشۡرِك<rule class=madda_permissible>ُو</rule>نَ", "en": "the polytheists", "tr": "l-mush'rikūna", "audio": "wbw/061_009_014.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "61:10", "juz": 28, "page": 552, "side_trans": "O you who have believed, shall I guide you to a transaction that will save you from a painful punishment?", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/061_010_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "(you) who", "tr": "alladhīna", "audio": "wbw/061_010_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/061_010_003.mp3"}, {"type": "word", "ar": "هَلْ", "tajweed": "هَلۡ", "en": "Shall", "tr": "hal", "audio": "wbw/061_010_004.mp3"}, {"type": "word", "ar": "أَدُلُّكُمْ", "tajweed": "أَدُلُّكُمۡ", "en": "I guide you", "tr": "adullukum", "audio": "wbw/061_010_005.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "to", "tr": "ʿalā", "audio": "wbw/061_010_006.mp3"}, {"type": "word", "ar": "تِجَـٰرَةٍۢ", "tajweed": "تِجَ<rule class=madda_normal>ـٰ</rule>رَ<rule class=ikhafa>ةٍ</rule>", "en": "a transaction", "tr": "tijāratin", "audio": "wbw/061_010_007.mp3"}, {"type": "word", "ar": "تُنجِيكُم", "tajweed": "<rule class=ikhafa>ت</rule>ُ<rule class=ikhafa>نج</rule>ِيك<rule class=idgham_shafawi>ُم</rule>", "en": "(that) will save you", "tr": "tunjīkum", "audio": "wbw/061_010_008.mp3"}, {"type": "word", "ar": "مِّنْ", "tajweed": "<rule class=idgham_shafawi>م</rule>ِّنۡ", "en": "from", "tr": "min", "audio": "wbw/061_010_009.mp3"}, {"type": "word", "ar": "عَذَابٍ", "tajweed": "عَذَابٍ", "en": "a punishment", "tr": "ʿadhābin", "audio": "wbw/061_010_010.mp3"}, {"type": "word", "ar": "أَلِيمٍۢ", "tajweed": "أَل<rule class=madda_permissible>ِي</rule>مٍ", "en": "painful", "tr": "alīmin", "audio": "wbw/061_010_011.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "61:11", "juz": 28, "page": 552, "side_trans": "[It is that] you believe in Allāh and His Messenger and strive in the cause of Allāh with your wealth and your lives. That is best for you, if you only knew.", "words": [{"type": "word", "ar": "تُؤْمِنُونَ", "tajweed": "تُؤۡمِنُونَ", "en": "Believe", "tr": "tu'minūna", "audio": "wbw/061_011_001.mp3"}, {"type": "word", "ar": "بِٱللَّهِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "in Allah", "tr": "bil-lahi", "audio": "wbw/061_011_002.mp3"}, {"type": "word", "ar": "وَرَسُولِهِۦ", "tajweed": "وَرَسُولِه<rule class=madda_normal>ِۦ</rule>", "en": "and His Messenger", "tr": "warasūlihi", "audio": "wbw/061_011_003.mp3"}, {"type": "word", "ar": "وَتُجَـٰهِدُونَ", "tajweed": "وَتُجَ<rule class=madda_normal>ـٰ</rule>هِدُونَ", "en": "and strive", "tr": "watujāhidūna", "audio": "wbw/061_011_004.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/061_011_005.mp3"}, {"type": "word", "ar": "سَبِيلِ", "tajweed": "سَبِيلِ", "en": "(the) way", "tr": "sabīli", "audio": "wbw/061_011_006.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/061_011_007.mp3"}, {"type": "word", "ar": "بِأَمْوَٰلِكُمْ", "tajweed": "بِأَمۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكُمۡ", "en": "with your wealth", "tr": "bi-amwālikum", "audio": "wbw/061_011_008.mp3"}, {"type": "word", "ar": "وَأَنفُسِكُمْ ۚ", "tajweed": "وَأَ<rule class=ikhafa>نف</rule>ُسِكُمۡ‌ۚ", "en": "and your lives", "tr": "wa-anfusikum", "audio": "wbw/061_011_009.mp3"}, {"type": "word", "ar": "ذَٰلِكُمْ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكُمۡ", "en": "That", "tr": "dhālikum", "audio": "wbw/061_011_011.mp3"}, {"type": "word", "ar": "خَيْرٌۭ", "tajweed": "خَيۡ<rule class=idgham_wo_ghunnah>رٌ</rule>", "en": "(is) better", "tr": "khayrun", "audio": "wbw/061_011_012.mp3"}, {"type": "word", "ar": "لَّكُمْ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/061_011_013.mp3"}, {"type": "word", "ar": "إِن", "tajweed": "إِ<rule class=ikhafa>ن</rule>", "en": "if", "tr": "in", "audio": "wbw/061_011_014.mp3"}, {"type": "word", "ar": "كُنتُمْ", "tajweed": "<rule class=ikhafa>ك</rule>ُ<rule class=ikhafa>نت</rule>ُمۡ", "en": "you", "tr": "kuntum", "audio": "wbw/061_011_015.mp3"}, {"type": "word", "ar": "تَعْلَمُونَ", "tajweed": "تَعۡلَم<rule class=madda_permissible>ُو</rule>نَ", "en": "know", "tr": "taʿlamūna", "audio": "wbw/061_011_016.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "61:12", "juz": 28, "page": 552, "side_trans": "He will forgive for you your sins and admit you to gardens beneath which rivers flow and pleasant dwellings in gardens of perpetual residence. That is the great attainment.", "words": [{"type": "word", "ar": "يَغْفِرْ", "tajweed": "يَغۡفِرۡ", "en": "He will forgive", "tr": "yaghfir", "audio": "wbw/061_012_001.mp3"}, {"type": "word", "ar": "لَكُمْ", "tajweed": "لَكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/061_012_002.mp3"}, {"type": "word", "ar": "ذُنُوبَكُمْ", "tajweed": "ذُنُوبَكُمۡ", "en": "your sins", "tr": "dhunūbakum", "audio": "wbw/061_012_003.mp3"}, {"type": "word", "ar": "وَيُدْخِلْكُمْ", "tajweed": "وَيُ<rule class=qalaqah>دۡ</rule>خِلۡكُمۡ", "en": "and admit you", "tr": "wayud'khil'kum", "audio": "wbw/061_012_004.mp3"}, {"type": "word", "ar": "جَنَّـٰتٍۢ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule><rule class=ikhafa>تٍ</rule>", "en": "(in) Gardens", "tr": "jannātin", "audio": "wbw/061_012_005.mp3"}, {"type": "word", "ar": "تَجْرِى", "tajweed": "<rule class=ikhafa>ت</rule>َ<rule class=qalaqah>جۡ</rule>رِى", "en": "flow", "tr": "tajrī", "audio": "wbw/061_012_006.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/061_012_007.mp3"}, {"type": "word", "ar": "تَحْتِهَا", "tajweed": "<rule class=ikhafa>ت</rule>َحۡتِهَا", "en": "underneath it", "tr": "taḥtihā", "audio": "wbw/061_012_008.mp3"}, {"type": "word", "ar": "ٱلْأَنْهَـٰرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَنۡهَ<rule class=madda_normal>ـٰ</rule>رُ", "en": "the rivers", "tr": "l-anhāru", "audio": "wbw/061_012_009.mp3"}, {"type": "word", "ar": "وَمَسَـٰكِنَ", "tajweed": "وَمَسَ<rule class=madda_normal>ـٰ</rule>كِنَ", "en": "and dwellings", "tr": "wamasākina", "audio": "wbw/061_012_010.mp3"}, {"type": "word", "ar": "طَيِّبَةًۭ", "tajweed": "طَيِّبَ<rule class=ikhafa>ةً</rule>", "en": "pleasant", "tr": "ṭayyibatan", "audio": "wbw/061_012_011.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "<rule class=ikhafa>ف</rule>ِى", "en": "in", "tr": "fī", "audio": "wbw/061_012_012.mp3"}, {"type": "word", "ar": "جَنَّـٰتِ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule>تِ", "en": "Gardens", "tr": "jannāti", "audio": "wbw/061_012_013.mp3"}, {"type": "word", "ar": "عَدْنٍۢ ۚ", "tajweed": "عَ<rule class=qalaqah>دۡ</rule><rule class=ikhafa>نٍ‌ۚ</rule>", "en": "(of) Eternity", "tr": "ʿadnin", "audio": "wbw/061_012_014.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "<rule class=ikhafa>ذ</rule><rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "That", "tr": "dhālika", "audio": "wbw/061_012_016.mp3"}, {"type": "word", "ar": "ٱلْفَوْزُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَوۡزُ", "en": "(is) the success", "tr": "l-fawzu", "audio": "wbw/061_012_017.mp3"}, {"type": "word", "ar": "ٱلْعَظِيمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَظ<rule class=madda_permissible>ِي</rule>مُ", "en": "the great", "tr": "l-ʿaẓīmu", "audio": "wbw/061_012_018.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "61:13", "juz": 28, "page": 552, "side_trans": "And [you will obtain] another [favor] that you love - victory from Allāh and an imminent conquest; and give good tidings to the believers.", "words": [{"type": "word", "ar": "وَأُخْرَىٰ", "tajweed": "وَأُخۡرَىٰ", "en": "And another", "tr": "wa-ukh'rā", "audio": "wbw/061_013_001.mp3"}, {"type": "word", "ar": "تُحِبُّونَهَا ۖ", "tajweed": "تُحِبُّونَهَا‌ۖ", "en": "that you love ", "tr": "tuḥibbūnahā", "audio": "wbw/061_013_002.mp3"}, {"type": "word", "ar": "نَصْرٌۭ", "tajweed": "نَصۡ<rule class=idgham_ghunnah>رٌ</rule>", "en": "a help", "tr": "naṣrun", "audio": "wbw/061_013_004.mp3"}, {"type": "word", "ar": "مِّنَ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنَ", "en": "from", "tr": "mina", "audio": "wbw/061_013_005.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/061_013_006.mp3"}, {"type": "word", "ar": "وَفَتْحٌۭ", "tajweed": "وَفَتۡ<rule class=ikhafa>حٌ</rule>", "en": "and a victory", "tr": "wafatḥun", "audio": "wbw/061_013_007.mp3"}, {"type": "word", "ar": "قَرِيبٌۭ ۗ", "tajweed": "<rule class=ikhafa>ق</rule>َرِي<rule class=idgham_ghunnah>بٌ‌ۗ</rule>", "en": "near", "tr": "qarībun", "audio": "wbw/061_013_008.mp3"}, {"type": "word", "ar": "وَبَشِّرِ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َبَشِّرِ", "en": "and give glad tidings", "tr": "wabashiri", "audio": "wbw/061_013_010.mp3"}, {"type": "word", "ar": "ٱلْمُؤْمِنِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُؤۡمِن<rule class=madda_permissible>ِي</rule>نَ", "en": "(to) the believers", "tr": "l-mu'minīna", "audio": "wbw/061_013_011.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "61:14", "juz": 28, "page": 552, "side_trans": "O you who have believed, be supporters of Allāh, as when Jesus, the son of Mary, said to the disciples, \"Who are my supporters for Allāh?\" The disciples said, \"We are supporters of Allāh.\" And a faction of the Children of Israel believed and a faction disbelieved. So We supported those who believed against their enemy, and they became dominant.", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O you", "tr": "yāayyuhā", "audio": "wbw/061_014_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "who", "tr": "alladhīna", "audio": "wbw/061_014_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/061_014_003.mp3"}, {"type": "word", "ar": "كُونُوٓا۟", "tajweed": "كُون<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "Be", "tr": "kūnū", "audio": "wbw/061_014_004.mp3"}, {"type": "word", "ar": "أَنصَارَ", "tajweed": "أَ<rule class=ikhafa>نص</rule>َارَ", "en": "helpers", "tr": "anṣāra", "audio": "wbw/061_014_005.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/061_014_006.mp3"}, {"type": "word", "ar": "كَمَا", "tajweed": "كَمَا", "en": "as", "tr": "kamā", "audio": "wbw/061_014_007.mp3"}, {"type": "word", "ar": "قَالَ", "tajweed": "قَالَ", "en": "said", "tr": "qāla", "audio": "wbw/061_014_008.mp3"}, {"type": "word", "ar": "عِيسَى", "tajweed": "عِيسَى", "en": "Isa", "tr": "ʿīsā", "audio": "wbw/061_014_009.mp3"}, {"type": "word", "ar": "ٱبْنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>بۡ</rule>نُ", "en": "son", "tr": "ub'nu", "audio": "wbw/061_014_010.mp3"}, {"type": "word", "ar": "مَرْيَمَ", "tajweed": "مَرۡيَمَ", "en": "(of) Maryam", "tr": "maryama", "audio": "wbw/061_014_011.mp3"}, {"type": "word", "ar": "لِلْحَوَارِيِّـۧنَ", "tajweed": "لِلۡحَوَارِيِّـ<rule class=madda_normal>ـۧ</rule>نَ", "en": "to the disciples", "tr": "lil'ḥawāriyyīna", "audio": "wbw/061_014_012.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "Who", "tr": "man", "audio": "wbw/061_014_013.mp3"}, {"type": "word", "ar": "أَنصَارِىٓ", "tajweed": "أَ<rule class=ikhafa>نص</rule>َار<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "(are) my helpers", "tr": "anṣārī", "audio": "wbw/061_014_014.mp3"}, {"type": "word", "ar": "إِلَى", "tajweed": "إِلَى", "en": "for", "tr": "ilā", "audio": "wbw/061_014_015.mp3"}, {"type": "word", "ar": "ٱللَّهِ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ‌ۖ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/061_014_016.mp3"}, {"type": "word", "ar": "قَالَ", "tajweed": "قَالَ", "en": "Said", "tr": "qāla", "audio": "wbw/061_014_018.mp3"}, {"type": "word", "ar": "ٱلْحَوَارِيُّونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَوَارِيُّونَ", "en": "the disciples", "tr": "l-ḥawāriyūna", "audio": "wbw/061_014_019.mp3"}, {"type": "word", "ar": "نَحْنُ", "tajweed": "نَحۡنُ", "en": "We", "tr": "naḥnu", "audio": "wbw/061_014_020.mp3"}, {"type": "word", "ar": "أَنصَارُ", "tajweed": "أَ<rule class=ikhafa>نص</rule>َارُ", "en": "(are) the helpers", "tr": "anṣāru", "audio": "wbw/061_014_021.mp3"}, {"type": "word", "ar": "ٱللَّهِ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ‌ۖ", "en": "(