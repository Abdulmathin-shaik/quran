[{"id": 1, "key": "80:1", "juz": 30, "page": 585, "side_trans": "He [i.e., the Prophet (ﷺ) ] frowned and turned away", "words": [{"type": "word", "ar": "عَبَسَ", "tajweed": "عَبَسَ", "en": "He frowned", "tr": "ʿabasa", "audio": "wbw/080_001_001.mp3"}, {"type": "word", "ar": "وَتَوَلَّىٰٓ", "tajweed": "وَتَوَلَّىٰٓ", "en": "and turned away", "tr": "watawallā", "audio": "wbw/080_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "80:2", "juz": 30, "page": 585, "side_trans": "Because there came to him the blind man, [interrupting].", "words": [{"type": "word", "ar": "أَن", "tajweed": "أَ<rule class=ikhafa>ن</rule>", "en": "Because", "tr": "an", "audio": "wbw/080_002_001.mp3"}, {"type": "word", "ar": "جَآءَهُ", "tajweed": "<rule class=ikhafa>ج</rule><rule class=madda_obligatory_mottasel>َا</rule>ٓءَهُ", "en": "came to him", "tr": "jāahu", "audio": "wbw/080_002_002.mp3"}, {"type": "word", "ar": "ٱلْأَعْمَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَعۡمَىٰ", "en": "the blind man", "tr": "l-aʿmā", "audio": "wbw/080_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "80:3", "juz": 30, "page": 585, "side_trans": "But what would make you perceive, [O Muḥammad], that perhaps he might be purified", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "But what", "tr": "wamā", "audio": "wbw/080_003_001.mp3"}, {"type": "word", "ar": "يُدْرِيكَ", "tajweed": "يُ<rule class=qalaqah>دۡ</rule>رِيكَ", "en": "would make you know", "tr": "yud'rīka", "audio": "wbw/080_003_002.mp3"}, {"type": "word", "ar": "لَعَلَّهُۥ", "tajweed": "لَعَلَّهُ<rule class=madda_normal>ۥ</rule>", "en": "that he might", "tr": "laʿallahu", "audio": "wbw/080_003_003.mp3"}, {"type": "word", "ar": "يَزَّكَّىٰٓ", "tajweed": "يَزَّكَّىٰٓ", "en": "purify himself", "tr": "yazzakkā", "audio": "wbw/080_003_004.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "80:4", "juz": 30, "page": 585, "side_trans": "Or be reminded and the remembrance would benefit him?", "words": [{"type": "word", "ar": "أَوْ", "tajweed": "أَوۡ", "en": "Or", "tr": "aw", "audio": "wbw/080_004_001.mp3"}, {"type": "word", "ar": "يَذَّكَّرُ", "tajweed": "يَذَّكَّرُ", "en": "be reminded", "tr": "yadhakkaru", "audio": "wbw/080_004_002.mp3"}, {"type": "word", "ar": "فَتَنفَعَهُ", "tajweed": "فَتَ<rule class=ikhafa>نف</rule>َعَهُ", "en": "so would benefit him", "tr": "fatanfaʿahu", "audio": "wbw/080_004_003.mp3"}, {"type": "word", "ar": "ٱلذِّكْرَىٰٓ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ذِّكۡرَىٰٓ", "en": "the reminder", "tr": "l-dhik'rā", "audio": "wbw/080_004_004.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "80:5", "juz": 30, "page": 585, "side_trans": "As for he who thinks himself without need,", "words": [{"type": "word", "ar": "أَمَّا", "tajweed": "أَ<rule class=ghunnah>مّ</rule>َا", "en": "As for", "tr": "ammā", "audio": "wbw/080_005_001.mp3"}, {"type": "word", "ar": "مَنِ", "tajweed": "مَنِ", "en": "(him) who", "tr": "mani", "audio": "wbw/080_005_002.mp3"}, {"type": "word", "ar": "ٱسْتَغْنَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>سۡتَغۡنَىٰ", "en": "considers himself free from need", "tr": "is'taghnā", "audio": "wbw/080_005_003.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "80:6", "juz": 30, "page": 585, "side_trans": "To him you give attention.", "words": [{"type": "word", "ar": "فَأَنتَ", "tajweed": "فَأَ<rule class=ikhafa>نت</rule>َ", "en": "So you", "tr": "fa-anta", "audio": "wbw/080_006_001.mp3"}, {"type": "word", "ar": "لَهُۥ", "tajweed": "لَهُ<rule class=madda_normal>ۥ</rule>", "en": "to him", "tr": "lahu", "audio": "wbw/080_006_002.mp3"}, {"type": "word", "ar": "تَصَدَّىٰ", "tajweed": "تَصَدَّىٰ", "en": "give attention", "tr": "taṣaddā", "audio": "wbw/080_006_003.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "80:7", "juz": 30, "page": 585, "side_trans": "And not upon you [is any blame] if he will not be purified.", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/080_007_001.mp3"}, {"type": "word", "ar": "عَلَيْكَ", "tajweed": "عَلَيۡكَ", "en": "upon you", "tr": "ʿalayka", "audio": "wbw/080_007_002.mp3"}, {"type": "word", "ar": "أَلَّا", "tajweed": "أَلَّا", "en": "that not", "tr": "allā", "audio": "wbw/080_007_003.mp3"}, {"type": "word", "ar": "يَزَّكَّىٰ", "tajweed": "يَزَّكَّىٰ", "en": "he purifies himself", "tr": "yazzakkā", "audio": "wbw/080_007_004.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "80:8", "juz": 30, "page": 585, "side_trans": "But as for he who came to you striving [for knowledge]", "words": [{"type": "word", "ar": "وَأَمَّا", "tajweed": "وَأَ<rule class=ghunnah>مّ</rule>َا", "en": "But as for", "tr": "wa-ammā", "audio": "wbw/080_008_001.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "مَ<rule class=ikhafa>ن</rule>", "en": "(he) who", "tr": "man", "audio": "wbw/080_008_002.mp3"}, {"type": "word", "ar": "جَآءَكَ", "tajweed": "<rule class=ikhafa>ج</rule><rule class=madda_obligatory_mottasel>َا</rule>ٓءَكَ", "en": "came to you", "tr": "jāaka", "audio": "wbw/080_008_003.mp3"}, {"type": "word", "ar": "يَسْعَىٰ", "tajweed": "يَسۡعَىٰ", "en": "striving", "tr": "yasʿā", "audio": "wbw/080_008_004.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "80:9", "juz": 30, "page": 585, "side_trans": "While he fears [Allāh],", "words": [{"type": "word", "ar": "وَهُوَ", "tajweed": "وَهُوَ", "en": "While he", "tr": "wahuwa", "audio": "wbw/080_009_001.mp3"}, {"type": "word", "ar": "يَخْشَىٰ", "tajweed": "يَخۡشَىٰ", "en": "fears", "tr": "yakhshā", "audio": "wbw/080_009_002.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "80:10", "juz": 30, "page": 585, "side_trans": "From him you are distracted.", "words": [{"type": "word", "ar": "فَأَنتَ", "tajweed": "فَأَ<rule class=ikhafa>نت</rule>َ", "en": "But you", "tr": "fa-anta", "audio": "wbw/080_010_001.mp3"}, {"type": "word", "ar": "عَنْهُ", "tajweed": "عَنۡهُ", "en": "from him", "tr": "ʿanhu", "audio": "wbw/080_010_002.mp3"}, {"type": "word", "ar": "تَلَهَّىٰ", "tajweed": "تَلَهَّىٰ", "en": "(are) distracted", "tr": "talahhā", "audio": "wbw/080_010_003.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "80:11", "juz": 30, "page": 585, "side_trans": "No! Indeed, they [i.e., these verses] are a reminder;", "words": [{"type": "word", "ar": "كَلَّآ", "tajweed": "كَلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Nay", "tr": "kallā", "audio": "wbw/080_011_001.mp3"}, {"type": "word", "ar": "إِنَّهَا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهَا", "en": "Indeed, it", "tr": "innahā", "audio": "wbw/080_011_002.mp3"}, {"type": "word", "ar": "تَذْكِرَةٌۭ", "tajweed": "تَذۡكِرَةٌ", "en": "(is) a reminder", "tr": "tadhkiratun", "audio": "wbw/080_011_003.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "80:12", "juz": 30, "page": 585, "side_trans": "So whoever wills may remember it.", "words": [{"type": "word", "ar": "فَمَن", "tajweed": "فَمَ<rule class=ikhafa>ن</rule>", "en": "So whosoever", "tr": "faman", "audio": "wbw/080_012_001.mp3"}, {"type": "word", "ar": "شَآءَ", "tajweed": "<rule class=ikhafa>ش</rule><rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "wills", "tr": "shāa", "audio": "wbw/080_012_002.mp3"}, {"type": "word", "ar": "ذَكَرَهُۥ", "tajweed": "ذَكَرَهُۥ", "en": "may remember it", "tr": "dhakarahu", "audio": "wbw/080_012_003.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "80:13", "juz": 30, "page": 585, "side_trans": "[It is recorded] in honored sheets,", "words": [{"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "In", "tr": "fī", "audio": "wbw/080_013_001.mp3"}, {"type": "word", "ar": "صُحُفٍۢ", "tajweed": "صُحُ<rule class=idgham_ghunnah>فٍ</rule>", "en": "sheets", "tr": "ṣuḥufin", "audio": "wbw/080_013_002.mp3"}, {"type": "word", "ar": "مُّكَرَّمَةٍۢ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّكَرَّمَةٍ", "en": "honored", "tr": "mukarramatin", "audio": "wbw/080_013_003.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "80:14", "juz": 30, "page": 585, "side_trans": "Exalted and purified,", "words": [{"type": "word", "ar": "مَّرْفُوعَةٍۢ", "tajweed": "مَّرۡفُوعَ<rule class=idgham_ghunnah>ةٍ</rule>", "en": "Exalted", "tr": "marfūʿatin", "audio": "wbw/080_014_001.mp3"}, {"type": "word", "ar": "مُّطَهَّرَةٍۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّطَهَّرَةِۭ", "en": "purified", "tr": "muṭahharatin", "audio": "wbw/080_014_002.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "80:15", "juz": 30, "page": 585, "side_trans": "[Carried] by the hands of messenger-angels,", "words": [{"type": "word", "ar": "بِأَيْدِى", "tajweed": "بِأَيۡدِى", "en": "In (the) hands", "tr": "bi-aydī", "audio": "wbw/080_015_001.mp3"}, {"type": "word", "ar": "سَفَرَةٍۢ", "tajweed": "سَفَرَةٍ", "en": "(of) scribes", "tr": "safaratin", "audio": "wbw/080_015_002.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "80:16", "juz": 30, "page": 585, "side_trans": "Noble and dutiful.", "words": [{"type": "word", "ar": "كِرَامٍۭ", "tajweed": "كِرَا<rule class=iqlab>مِۭ</rule>", "en": "Noble", "tr": "kirāmin", "audio": "wbw/080_016_001.mp3"}, {"type": "word", "ar": "بَرَرَةٍۢ", "tajweed": "<rule class=iqlab>ب</rule>َرَرَةٍ", "en": "dutiful", "tr": "bararatin", "audio": "wbw/080_016_002.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "80:17", "juz": 30, "page": 585, "side_trans": "Destroyed [i.e., cursed] is man; how disbelieving is he.", "words": [{"type": "word", "ar": "قُتِلَ", "tajweed": "قُتِلَ", "en": "Is destroyed", "tr": "qutila", "audio": "wbw/080_017_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "[the] man", "tr": "l-insānu", "audio": "wbw/080_017_002.mp3"}, {"type": "word", "ar": "مَآ", "tajweed": "م<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "how", "tr": "mā", "audio": "wbw/080_017_003.mp3"}, {"type": "word", "ar": "أَكْفَرَهُۥ", "tajweed": "أَكۡفَرَهُۥ", "en": "ungrateful is he", "tr": "akfarahu", "audio": "wbw/080_017_004.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "80:18", "juz": 30, "page": 585, "side_trans": "From what thing [i.e., substance] did He create him?", "words": [{"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "From", "tr": "min", "audio": "wbw/080_018_001.mp3"}, {"type": "word", "ar": "أَىِّ", "tajweed": "أَىِّ", "en": "what", "tr": "ayyi", "audio": "wbw/080_018_002.mp3"}, {"type": "word", "ar": "شَىْءٍ", "tajweed": "شَىۡءٍ", "en": "thing", "tr": "shayin", "audio": "wbw/080_018_003.mp3"}, {"type": "word", "ar": "خَلَقَهُۥ", "tajweed": "خَلَقَهُۥ", "en": "He created him", "tr": "khalaqahu", "audio": "wbw/080_018_004.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "80:19", "juz": 30, "page": 585, "side_trans": "From a sperm-drop He created him and destined for him;", "words": [{"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_ghunnah>ِن</rule>", "en": "From", "tr": "min", "audio": "wbw/080_019_001.mp3"}, {"type": "word", "ar": "نُّطْفَةٍ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>ُّ<rule class=qalaqah>طۡ</rule>فَةٍ", "en": "a semen-drop", "tr": "nuṭ'fatin", "audio": "wbw/080_019_002.mp3"}, {"type": "word", "ar": "خَلَقَهُۥ", "tajweed": "خَلَقَهُ<rule class=madda_normal>ۥ</rule>", "en": "He created him", "tr": "khalaqahu", "audio": "wbw/080_019_003.mp3"}, {"type": "word", "ar": "فَقَدَّرَهُۥ", "tajweed": "فَقَدَّرَهُۥ", "en": "then He proportioned him", "tr": "faqaddarahu", "audio": "wbw/080_019_004.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "80:20", "juz": 30, "page": 585, "side_trans": "Then He eased the way for him;", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/080_020_001.mp3"}, {"type": "word", "ar": "ٱلسَّبِيلَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّبِيلَ", "en": "the way", "tr": "l-sabīla", "audio": "wbw/080_020_002.mp3"}, {"type": "word", "ar": "يَسَّرَهُۥ", "tajweed": "يَسَّرَهُۥ", "en": "He made easy for him", "tr": "yassarahu", "audio": "wbw/080_020_003.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "80:21", "juz": 30, "page": 585, "side_trans": "Then He causes his death and provides a grave for him.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/080_021_001.mp3"}, {"type": "word", "ar": "أَمَاتَهُۥ", "tajweed": "أَمَاتَهُ<rule class=madda_normal>ۥ</rule>", "en": "He causes him to die", "tr": "amātahu", "audio": "wbw/080_021_002.mp3"}, {"type": "word", "ar": "فَأَقْبَرَهُۥ", "tajweed": "فَأَ<rule class=qalaqah>قۡ</rule>بَرَهُۥ", "en": "and provides a grave for him", "tr": "fa-aqbarahu", "audio": "wbw/080_021_003.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "80:22", "juz": 30, "page": 585, "side_trans": "Then when He wills, He will resurrect him.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/080_022_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/080_022_002.mp3"}, {"type": "word", "ar": "شَآءَ", "tajweed": "ش<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "He wills", "tr": "shāa", "audio": "wbw/080_022_003.mp3"}, {"type": "word", "ar": "أَنشَرَهُۥ", "tajweed": "أَ<rule class=ikhafa>نش</rule>َرَهُۥ", "en": "He will resurrect him", "tr": "ansharahu", "audio": "wbw/080_022_004.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "80:23", "juz": 30, "page": 585, "side_trans": "No! He [i.e., man] has not yet accomplished what He commanded him.", "words": [{"type": "word", "ar": "كَلَّا", "tajweed": "كَلَّا", "en": "Nay", "tr": "kallā", "audio": "wbw/080_023_001.mp3"}, {"type": "word", "ar": "لَمَّا", "tajweed": "لَ<rule class=ghunnah>مّ</rule>َا", "en": "Not", "tr": "lammā", "audio": "wbw/080_023_002.mp3"}, {"type": "word", "ar": "يَقْضِ", "tajweed": "يَ<rule class=qalaqah>قۡ</rule>ضِ", "en": "he has accomplished", "tr": "yaqḍi", "audio": "wbw/080_023_003.mp3"}, {"type": "word", "ar": "مَآ", "tajweed": "م<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "what", "tr": "mā", "audio": "wbw/080_023_004.mp3"}, {"type": "word", "ar": "أَمَرَهُۥ", "tajweed": "أَمَرَهُۥ", "en": "He commanded him", "tr": "amarahu", "audio": "wbw/080_023_005.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "80:24", "juz": 30, "page": 585, "side_trans": "Then let mankind look at his food -", "words": [{"type": "word", "ar": "فَلْيَنظُرِ", "tajweed": "فَلۡيَ<rule class=ikhafa>نظ</rule>ُرِ", "en": "Then let look", "tr": "falyanẓuri", "audio": "wbw/080_024_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "the man", "tr": "l-insānu", "audio": "wbw/080_024_002.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "at", "tr": "ilā", "audio": "wbw/080_024_003.mp3"}, {"type": "word", "ar": "طَعَامِهِۦٓ", "tajweed": "طَعَامِهِۦٓ", "en": "his food", "tr": "ṭaʿāmihi", "audio": "wbw/080_024_004.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "80:25", "juz": 30, "page": 585, "side_trans": "How We poured down water in torrents,", "words": [{"type": "word", "ar": "اَنَّا", "tajweed": "أَ<rule class=ghunnah>نّ</rule>َا", "en": "That [We]", "tr": "annā", "audio": "wbw/080_025_001.mp3"}, {"type": "word", "ar": "صَبَبْنَا", "tajweed": "صَبَ<rule class=qalaqah>بۡ</rule>نَا", "en": "[We] poured", "tr": "ṣababnā", "audio": "wbw/080_025_002.mp3"}, {"type": "word", "ar": "ٱلْمَآءَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡم<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "the water", "tr": "l-māa", "audio": "wbw/080_025_003.mp3"}, {"type": "word", "ar": "صَبًّۭا", "tajweed": "صَبًّا", "en": "(in) abundance", "tr": "ṣabban", "audio": "wbw/080_025_004.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "80:26", "juz": 30, "page": 585, "side_trans": "Then We broke open the earth, splitting [it with sprouts],", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/080_026_001.mp3"}, {"type": "word", "ar": "شَقَقْنَا", "tajweed": "شَقَ<rule class=qalaqah>قۡ</rule>نَا", "en": "We cleaved", "tr": "shaqaqnā", "audio": "wbw/080_026_002.mp3"}, {"type": "word", "ar": "ٱلْأَرْضَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضَ", "en": "the earth", "tr": "l-arḍa", "audio": "wbw/080_026_003.mp3"}, {"type": "word", "ar": "شَقًّۭا", "tajweed": "شَقًّا", "en": "splitting", "tr": "shaqqan", "audio": "wbw/080_026_004.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "80:27", "juz": 30, "page": 585, "side_trans": "And caused to grow within it grain", "words": [{"type": "word", "ar": "فَأَنۢبَتْنَا", "tajweed": "فَأَ<rule class=iqlab>نۢب</rule>َتۡنَا", "en": "Then We caused to grow", "tr": "fa-anbatnā", "audio": "wbw/080_027_001.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/080_027_002.mp3"}, {"type": "word", "ar": "حَبًّۭا", "tajweed": "حَبًّا", "en": "grain", "tr": "ḥabban", "audio": "wbw/080_027_003.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "80:28", "juz": 30, "page": 585, "side_trans": "And grapes and herbage", "words": [{"type": "word", "ar": "وَعِنَبًۭا", "tajweed": "وَعِنَ<rule class=idgham_ghunnah>بًا</rule>", "en": "And grapes", "tr": "waʿinaban", "audio": "wbw/080_028_001.mp3"}, {"type": "word", "ar": "وَقَضْبًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َقَضۡبًا", "en": "and green fodder", "tr": "waqaḍban", "audio": "wbw/080_028_002.mp3"}, {"type": "end", "num": "٢٨"}]}, {"id": 29, "key": "80:29", "juz": 30, "page": 585, "side_trans": "And olive and palm trees", "words": [{"type": "word", "ar": "وَزَيْتُونًۭا", "tajweed": "وَزَيۡتُو<rule class=idgham_ghunnah>نًا</rule>", "en": "And olive", "tr": "wazaytūnan", "audio": "wbw/080_029_001.mp3"}, {"type": "word", "ar": "وَنَخْلًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َنَخۡلاً", "en": "and date-palms", "tr": "wanakhlan", "audio": "wbw/080_029_002.mp3"}, {"type": "end", "num": "٢٩"}]}, {"id": 30, "key": "80:30", "juz": 30, "page": 585, "side_trans": "And gardens of dense shrubbery", "words": [{"type": "word", "ar": "وَحَدَآئِقَ", "tajweed": "وَحَد<rule class=madda_obligatory_mottasel>َا</rule>ٓئِقَ", "en": "And gardens", "tr": "waḥadāiqa", "audio": "wbw/080_030_001.mp3"}, {"type": "word", "ar": "غُلْبًۭا", "tajweed": "غُلۡبًا", "en": "(of) thick foliage", "tr": "ghul'ban", "audio": "wbw/080_030_002.mp3"}, {"type": "end", "num": "٣٠"}]}, {"id": 31, "key": "80:31", "juz": 30, "page": 585, "side_trans": "And fruit and grass -", "words": [{"type": "word", "ar": "وَفَـٰكِهَةًۭ", "tajweed": "وَفَ<rule class=madda_normal>ـٰ</rule>كِهَ<rule class=idgham_ghunnah>ةً</rule>", "en": "And fruits", "tr": "wafākihatan", "audio": "wbw/080_031_001.mp3"}, {"type": "word", "ar": "وَأَبًّۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َأَبًّا", "en": "and grass", "tr": "wa-abban", "audio": "wbw/080_031_002.mp3"}, {"type": "end", "num": "٣١"}]}, {"id": 32, "key": "80:32", "juz": 30, "page": 585, "side_trans": "[As] enjoyment [i.e., provision] for you and your grazing livestock.", "words": [{"type": "word", "ar": "مَّتَـٰعًۭا", "tajweed": "مَّتَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_wo_ghunnah>عًا</rule>", "en": "(As) a provision", "tr": "matāʿan", "audio": "wbw/080_032_001.mp3"}, {"type": "word", "ar": "لَّكُمْ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/080_032_002.mp3"}, {"type": "word", "ar": "وَلِأَنْعَـٰمِكُمْ", "tajweed": "وَلِأَنۡعَ<rule class=madda_normal>ـٰ</rule>مِكُمۡ", "en": "and for your cattle", "tr": "wali-anʿāmikum", "audio": "wbw/080_032_003.mp3"}, {"type": "end", "num": "٣٢"}]}, {"id": 33, "key": "80:33", "juz": 30, "page": 585, "side_trans": "But when there comes the Deafening Blast", "words": [{"type": "word", "ar": "فَإِذَا", "tajweed": "فَإِذَا", "en": "But when", "tr": "fa-idhā", "audio": "wbw/080_033_001.mp3"}, {"type": "word", "ar": "جَآءَتِ", "tajweed": "ج<rule class=madda_obligatory_mottasel>َا</rule>ٓءَتِ", "en": "comes", "tr": "jāati", "audio": "wbw/080_033_002.mp3"}, {"type": "word", "ar": "ٱلصَّآخَّةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صّ<rule class=madda_necessary>َا</rule>ٓخَّةُ", "en": "the Deafening Blast", "tr": "l-ṣākhatu", "audio": "wbw/080_033_003.mp3"}, {"type": "end", "num": "٣٣"}]}, {"id": 34, "key": "80:34", "juz": 30, "page": 585, "side_trans": "On the Day a man will flee from his brother", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(The) Day", "tr": "yawma", "audio": "wbw/080_034_001.mp3"}, {"type": "word", "ar": "يَفِرُّ", "tajweed": "يَفِرُّ", "en": "will flee", "tr": "yafirru", "audio": "wbw/080_034_002.mp3"}, {"type": "word", "ar": "ٱلْمَرْءُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَرۡءُ", "en": "a man", "tr": "l-maru", "audio": "wbw/080_034_003.mp3"}, {"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "from", "tr": "min", "audio": "wbw/080_034_004.mp3"}, {"type": "word", "ar": "أَخِيهِ", "tajweed": "أَخ<rule class=madda_permissible>ِي</rule>هِ", "en": "his brother", "tr": "akhīhi", "audio": "wbw/080_034_005.mp3"}, {"type": "end", "num": "٣٤"}]}, {"id": 35, "key": "80:35", "juz": 30, "page": 585, "side_trans": "And his mother and his father", "words": [{"type": "word", "ar": "وَأُمِّهِۦ", "tajweed": "وَأُ<rule class=ghunnah>مّ</rule>ِه<rule class=madda_normal>ِۦ</rule>", "en": "And his mother", "tr": "wa-ummihi", "audio": "wbw/080_035_001.mp3"}, {"type": "word", "ar": "وَأَبِيهِ", "tajweed": "وَأَب<rule class=madda_permissible>ِي</rule>هِ", "en": "and his father", "tr": "wa-abīhi", "audio": "wbw/080_035_002.mp3"}, {"type": "end", "num": "٣٥"}]}, {"id": 36, "key": "80:36", "juz": 30, "page": 585, "side_trans": "And his wife and his children,", "words": [{"type": "word", "ar": "وَصَـٰحِبَتِهِۦ", "tajweed": "وَصَ<rule class=madda_normal>ـٰ</rule>حِبَتِه<rule class=madda_normal>ِۦ</rule>", "en": "And his wife", "tr": "waṣāḥibatihi", "audio": "wbw/080_036_001.mp3"}, {"type": "word", "ar": "وَبَنِيهِ", "tajweed": "وَبَن<rule class=madda_permissible>ِي</rule>هِ", "en": "and his children", "tr": "wabanīhi", "audio": "wbw/080_036_002.mp3"}, {"type": "end", "num": "٣٦"}]}, {"id": 37, "key": "80:37", "juz": 30, "page": 585, "side_trans": "For every man, that Day, will be a matter adequate for him.", "words": [{"type": "word", "ar": "لِكُلِّ", "tajweed": "لِكُلِّ", "en": "For every", "tr": "likulli", "audio": "wbw/080_037_001.mp3"}, {"type": "word", "ar": "ٱمْرِئٍۢ", "tajweed": "<rule class=ham_wasl>ٱ</rule>مۡرِى<rule class=idgham_ghunnah>ٍٕ</rule>", "en": "man", "tr": "im'ri-in", "audio": "wbw/080_037_002.mp3"}, {"type": "word", "ar": "مِّنْهُمْ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنۡهُمۡ", "en": "among them", "tr": "min'hum", "audio": "wbw/080_037_003.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "يَوۡمَئِ<rule class=ikhafa>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/080_037_004.mp3"}, {"type": "word", "ar": "شَأْنٌۭ", "tajweed": "<rule class=ikhafa>ش</rule>َأۡ<rule class=idgham_ghunnah>نٌ</rule>", "en": "(will be) a matter", "tr": "shanun", "audio": "wbw/080_037_005.mp3"}, {"type": "word", "ar": "يُغْنِيهِ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُغۡن<rule class=madda_permissible>ِي</rule>هِ", "en": "occupying him", "tr": "yugh'nīhi", "audio": "wbw/080_037_006.mp3"}, {"type": "end", "num": "٣٧"}]}, {"id": 38, "key": "80:38", "juz": 30, "page": 585, "side_trans": "[Some] faces, that Day, will be bright -", "words": [{"type": "word", "ar": "وُجُوهٌۭ", "tajweed": "وُجُو<rule class=idgham_ghunnah>هٌ</rule>", "en": "Faces", "tr": "wujūhun", "audio": "wbw/080_038_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/080_038_002.mp3"}, {"type": "word", "ar": "مُّسْفِرَةٌۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّسۡفِرَةٌ", "en": "(will be) bright", "tr": "mus'firatun", "audio": "wbw/080_038_003.mp3"}, {"type": "end", "num": "٣٨"}]}, {"id": 39, "key": "80:39", "juz": 30, "page": 585, "side_trans": "Laughing, rejoicing at good news.", "words": [{"type": "word", "ar": "ضَاحِكَةٌۭ", "tajweed": "ضَاحِكَ<rule class=idgham_ghunnah>ةٌ</rule>", "en": "Laughing", "tr": "ḍāḥikatun", "audio": "wbw/080_039_001.mp3"}, {"type": "word", "ar": "مُّسْتَبْشِرَةٌۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّسۡتَ<rule class=qalaqah>بۡ</rule>شِرَةٌ", "en": "rejoicing at good news", "tr": "mus'tabshiratun", "audio": "wbw/080_039_002.mp3"}, {"type": "end", "num": "٣٩"}]}, {"id": 40, "key": "80:40", "juz": 30, "page": 585, "side_trans": "And [other] faces, that Day, will have upon them dust.", "words": [{"type": "word", "ar": "وَوُجُوهٌۭ", "tajweed": "وَوُجُو<rule class=idgham_ghunnah>هٌ</rule>", "en": "And faces", "tr": "wawujūhun", "audio": "wbw/080_040_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِذٍ", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/080_040_002.mp3"}, {"type": "word", "ar": "عَلَيْهَا", "tajweed": "عَلَيۡهَا", "en": "upon them", "tr": "ʿalayhā", "audio": "wbw/080_040_003.mp3"}, {"type": "word", "ar": "غَبَرَةٌۭ", "tajweed": "غَبَرَةٌ", "en": "(will be) dust", "tr": "ghabaratun", "audio": "wbw/080_040_004.mp3"}, {"type": "end", "num": "٤٠"}]}, {"id": 41, "key": "80:41", "juz": 30, "page": 586, "side_trans": "Blackness will cover them.", "words": [{"type": "word", "ar": "تَرْهَقُهَا", "tajweed": "تَرۡهَقُهَا", "en": "Will cover them", "tr": "tarhaquhā", "audio": "wbw/080_041_001.mp3"}, {"type": "word", "ar": "قَتَرَةٌ", "tajweed": "قَتَرَةٌ", "en": "darkness", "tr": "qataratun", "audio": "wbw/080_041_002.mp3"}, {"type": "end", "num": "٤١"}]}, {"id": 42, "key": "80:42", "juz": 30, "page": 586, "side_trans": "Those are the disbelievers, the wicked ones.", "words": [{"type": "word", "ar": "أُو۟لَـٰٓئِكَ", "tajweed": "أُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَ", "en": "Those", "tr": "ulāika", "audio": "wbw/080_042_001.mp3"}, {"type": "word", "ar": "هُمُ", "tajweed": "هُمُ", "en": "[they]", "tr": "humu", "audio": "wbw/080_042_002.mp3"}, {"type": "word", "ar": "ٱلْكَفَرَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَفَرَةُ", "en": "(are) the disbelievers", "tr": "l-kafaratu", "audio": "wbw/080_042_003.mp3"}, {"type": "word", "ar": "ٱلْفَجَرَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَجَرَةُ", "en": "the wicked ones", "tr": "l-fajaratu", "audio": "wbw/080_042_004.mp3"}, {"type": "end", "num": "٤٢"}]}]