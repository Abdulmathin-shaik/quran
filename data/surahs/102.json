[{"id": 1, "key": "102:1", "juz": 30, "page": 600, "side_trans": "Competition in [worldly] increase diverts you", "words": [{"type": "word", "ar": "أَلْهَىٰكُمُ", "tajweed": "أَلۡهَ<rule class=madda_normal>ـٰ</rule>كُمُ", "en": "Diverts you", "tr": "alhākumu", "audio": "wbw/102_001_001.mp3"}, {"type": "word", "ar": "ٱلتَّكَاثُرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>تَّكَاثُرُ", "en": "the competition to increase", "tr": "l-takāthuru", "audio": "wbw/102_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "102:2", "juz": 30, "page": 600, "side_trans": "Until you visit the graveyards.", "words": [{"type": "word", "ar": "حَتَّىٰ", "tajweed": "حَتَّىٰ", "en": "Until", "tr": "ḥattā", "audio": "wbw/102_002_001.mp3"}, {"type": "word", "ar": "زُرْتُمُ", "tajweed": "زُرۡتُمُ", "en": "you visit", "tr": "zur'tumu", "audio": "wbw/102_002_002.mp3"}, {"type": "word", "ar": "ٱلْمَقَابِرَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَقَابِرَ", "en": "the graves", "tr": "l-maqābira", "audio": "wbw/102_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "102:3", "juz": 30, "page": 600, "side_trans": "No! You are going to know.", "words": [{"type": "word", "ar": "كَلَّا", "tajweed": "كَلَّا", "en": "Nay", "tr": "kallā", "audio": "wbw/102_003_001.mp3"}, {"type": "word", "ar": "سَوْفَ", "tajweed": "سَوۡفَ", "en": "Soon", "tr": "sawfa", "audio": "wbw/102_003_002.mp3"}, {"type": "word", "ar": "تَعْلَمُونَ", "tajweed": "تَعۡلَم<rule class=madda_permissible>ُو</rule>نَ", "en": "you will know", "tr": "taʿlamūna", "audio": "wbw/102_003_003.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "102:4", "juz": 30, "page": 600, "side_trans": "Then, no! You are going to know.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/102_004_001.mp3"}, {"type": "word", "ar": "كَلَّا", "tajweed": "كَلَّا", "en": "nay", "tr": "kallā", "audio": "wbw/102_004_002.mp3"}, {"type": "word", "ar": "سَوْفَ", "tajweed": "سَوۡفَ", "en": "Soon", "tr": "sawfa", "audio": "wbw/102_004_003.mp3"}, {"type": "word", "ar": "تَعْلَمُونَ", "tajweed": "تَعۡلَم<rule class=madda_permissible>ُو</rule>نَ", "en": "you will know", "tr": "taʿlamūna", "audio": "wbw/102_004_004.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "102:5", "juz": 30, "page": 600, "side_trans": "No! If you only knew with knowledge of certainty...", "words": [{"type": "word", "ar": "كَلَّا", "tajweed": "كَلَّا", "en": "Nay", "tr": "kallā", "audio": "wbw/102_005_001.mp3"}, {"type": "word", "ar": "لَوْ", "tajweed": "لَوۡ", "en": "If", "tr": "law", "audio": "wbw/102_005_002.mp3"}, {"type": "word", "ar": "تَعْلَمُونَ", "tajweed": "تَعۡلَمُونَ", "en": "you know", "tr": "taʿlamūna", "audio": "wbw/102_005_003.mp3"}, {"type": "word", "ar": "عِلْمَ", "tajweed": "عِلۡمَ", "en": "(with) a knowledge", "tr": "ʿil'ma", "audio": "wbw/102_005_004.mp3"}, {"type": "word", "ar": "ٱلْيَقِينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَق<rule class=madda_permissible>ِي</rule>نِ", "en": "(of) certainty", "tr": "l-yaqīni", "audio": "wbw/102_005_005.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "102:6", "juz": 30, "page": 600, "side_trans": "You will surely see the Hellfire.", "words": [{"type": "word", "ar": "لَتَرَوُنَّ", "tajweed": "لَتَرَوُ<rule class=ghunnah>نّ</rule>َ", "en": "Surely you will see", "tr": "latarawunna", "audio": "wbw/102_006_001.mp3"}, {"type": "word", "ar": "ٱلْجَحِيمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجَح<rule class=madda_permissible>ِي</rule>مَ", "en": "the Hellfire", "tr": "l-jaḥīma", "audio": "wbw/102_006_002.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "102:7", "juz": 30, "page": 600, "side_trans": "Then you will surely see it with the eye of certainty.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/102_007_001.mp3"}, {"type": "word", "ar": "لَتَرَوُنَّهَا", "tajweed": "لَتَرَوُ<rule class=ghunnah>نّ</rule>َهَا", "en": "surely you will see it", "tr": "latarawunnahā", "audio": "wbw/102_007_002.mp3"}, {"type": "word", "ar": "عَيْنَ", "tajweed": "عَيۡنَ", "en": "(with the) eye", "tr": "ʿayna", "audio": "wbw/102_007_003.mp3"}, {"type": "word", "ar": "ٱلْيَقِينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَق<rule class=madda_permissible>ِي</rule>نِ", "en": "(of) certainty", "tr": "l-yaqīni", "audio": "wbw/102_007_004.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "102:8", "juz": 30, "page": 600, "side_trans": "Then you will surely be asked that Day about pleasure.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/102_008_001.mp3"}, {"type": "word", "ar": "لَتُسْـَٔلُنَّ", "tajweed": "لَتُسۡــَٔلُ<rule class=ghunnah>نّ</rule>َ", "en": "surely you will be asked", "tr": "latus'alunna", "audio": "wbw/102_008_002.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍ", "tajweed": "يَوۡمَئِذٍ", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/102_008_003.mp3"}, {"type": "word", "ar": "عَنِ", "tajweed": "عَنِ", "en": "about", "tr": "ʿani", "audio": "wbw/102_008_004.mp3"}, {"type": "word", "ar": "ٱلنَّعِيمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َع<rule class=madda_permissible>ِي</rule>مِ", "en": "the pleasures", "tr": "l-naʿīmi", "audio": "wbw/102_008_005.mp3"}, {"type": "end", "num": "٨"}]}]