[{"id": 1, "key": "92:1", "juz": 30, "page": 595, "side_trans": "By the night when it covers", "words": [{"type": "word", "ar": "وَٱلَّيْلِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّيۡلِ", "en": "By the night", "tr": "wa-al-layli", "audio": "wbw/092_001_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/092_001_002.mp3"}, {"type": "word", "ar": "يَغْشَىٰ", "tajweed": "يَغۡشَىٰ", "en": "it covers", "tr": "yaghshā", "audio": "wbw/092_001_003.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "92:2", "juz": 30, "page": 595, "side_trans": "And [by] the day when it appears", "words": [{"type": "word", "ar": "وَٱلنَّهَارِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َهَارِ", "en": "And the day", "tr": "wal-nahāri", "audio": "wbw/092_002_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/092_002_002.mp3"}, {"type": "word", "ar": "تَجَلَّىٰ", "tajweed": "تَجَلَّىٰ", "en": "it shines in brightness", "tr": "tajallā", "audio": "wbw/092_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "92:3", "juz": 30, "page": 595, "side_trans": "And [by] He who created the male and female,", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And He Who", "tr": "wamā", "audio": "wbw/092_003_001.mp3"}, {"type": "word", "ar": "خَلَقَ", "tajweed": "خَلَقَ", "en": "created", "tr": "khalaqa", "audio": "wbw/092_003_002.mp3"}, {"type": "word", "ar": "ٱلذَّكَرَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ذَّكَرَ", "en": "the male", "tr": "l-dhakara", "audio": "wbw/092_003_003.mp3"}, {"type": "word", "ar": "وَٱلْأُنثَىٰٓ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأُ<rule class=ikhafa>نث</rule>َىٰٓ", "en": "and the female", "tr": "wal-unthā", "audio": "wbw/092_003_004.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "92:4", "juz": 30, "page": 595, "side_trans": "Indeed, your efforts are diverse.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/092_004_001.mp3"}, {"type": "word", "ar": "سَعْيَكُمْ", "tajweed": "سَعۡيَكُمۡ", "en": "your efforts", "tr": "saʿyakum", "audio": "wbw/092_004_002.mp3"}, {"type": "word", "ar": "لَشَتَّىٰ", "tajweed": "لَشَتَّىٰ", "en": "(are) surely diverse", "tr": "lashattā", "audio": "wbw/092_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "92:5", "juz": 30, "page": 595, "side_trans": "As for he who gives and fears Allāh", "words": [{"type": "word", "ar": "فَأَمَّا", "tajweed": "فَأَ<rule class=ghunnah>مّ</rule>َا", "en": "Then as for", "tr": "fa-ammā", "audio": "wbw/092_005_001.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "(him) who", "tr": "man", "audio": "wbw/092_005_002.mp3"}, {"type": "word", "ar": "أَعْطَىٰ", "tajweed": "أَعۡطَىٰ", "en": "gives", "tr": "aʿṭā", "audio": "wbw/092_005_003.mp3"}, {"type": "word", "ar": "وَٱتَّقَىٰ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>تَّقَىٰ", "en": "and fears", "tr": "wa-ittaqā", "audio": "wbw/092_005_004.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "92:6", "juz": 30, "page": 595, "side_trans": "And believes in the best [reward],", "words": [{"type": "word", "ar": "وَصَدَّقَ", "tajweed": "وَصَدَّقَ", "en": "And believes", "tr": "waṣaddaqa", "audio": "wbw/092_006_001.mp3"}, {"type": "word", "ar": "بِٱلْحُسْنَىٰ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡحُسۡنَىٰ", "en": "in the best", "tr": "bil-ḥus'nā", "audio": "wbw/092_006_002.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "92:7", "juz": 30, "page": 595, "side_trans": "We will ease him toward ease.", "words": [{"type": "word", "ar": "فَسَنُيَسِّرُهُۥ", "tajweed": "فَسَنُيَسِّرُهُ<rule class=madda_normal>ۥ</rule>", "en": "Then We will ease him", "tr": "fasanuyassiruhu", "audio": "wbw/092_007_001.mp3"}, {"type": "word", "ar": "لِلْيُسْرَىٰ", "tajweed": "لِلۡيُسۡرَىٰ", "en": "towards [the] ease", "tr": "lil'yus'rā", "audio": "wbw/092_007_002.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "92:8", "juz": 30, "page": 595, "side_trans": "But as for he who withholds and considers himself free of need", "words": [{"type": "word", "ar": "وَأَمَّا", "tajweed": "وَأَ<rule class=ghunnah>مّ</rule>َا", "en": "But as for", "tr": "wa-ammā", "audio": "wbw/092_008_001.mp3"}, {"type": "word", "ar": "مَنۢ", "tajweed": "م<rule class=iqlab>َنۢ</rule>", "en": "(him) who", "tr": "man", "audio": "wbw/092_008_002.mp3"}, {"type": "word", "ar": "بَخِلَ", "tajweed": "<rule class=iqlab>ب</rule>َخِلَ", "en": "withholds", "tr": "bakhila", "audio": "wbw/092_008_003.mp3"}, {"type": "word", "ar": "وَٱسْتَغْنَىٰ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>سۡتَغۡنَىٰ", "en": "and considers himself free from need", "tr": "wa-is'taghnā", "audio": "wbw/092_008_004.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "92:9", "juz": 30, "page": 595, "side_trans": "And denies the best [reward],", "words": [{"type": "word", "ar": "وَكَذَّبَ", "tajweed": "وَكَذَّبَ", "en": "And denies", "tr": "wakadhaba", "audio": "wbw/092_009_001.mp3"}, {"type": "word", "ar": "بِٱلْحُسْنَىٰ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡحُسۡنَىٰ", "en": "the best", "tr": "bil-ḥus'nā", "audio": "wbw/092_009_002.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "92:10", "juz": 30, "page": 596, "side_trans": "We will ease him toward difficulty.", "words": [{"type": "word", "ar": "فَسَنُيَسِّرُهُۥ", "tajweed": "فَسَنُيَسِّرُهُ<rule class=madda_normal>ۥ</rule>", "en": "Then We will ease him", "tr": "fasanuyassiruhu", "audio": "wbw/092_010_001.mp3"}, {"type": "word", "ar": "لِلْعُسْرَىٰ", "tajweed": "لِلۡعُسۡرَىٰ", "en": "towards [the] difficulty", "tr": "lil'ʿus'rā", "audio": "wbw/092_010_002.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "92:11", "juz": 30, "page": 596, "side_trans": "And what will his wealth avail him when he falls?", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/092_011_001.mp3"}, {"type": "word", "ar": "يُغْنِى", "tajweed": "يُغۡنِى", "en": "will avail", "tr": "yugh'nī", "audio": "wbw/092_011_002.mp3"}, {"type": "word", "ar": "عَنْهُ", "tajweed": "عَنۡهُ", "en": "him", "tr": "ʿanhu", "audio": "wbw/092_011_003.mp3"}, {"type": "word", "ar": "مَالُهُۥٓ", "tajweed": "مَالُهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "his wealth", "tr": "māluhu", "audio": "wbw/092_011_004.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/092_011_005.mp3"}, {"type": "word", "ar": "تَرَدَّىٰٓ", "tajweed": "تَرَدَّىٰٓ", "en": "he falls", "tr": "taraddā", "audio": "wbw/092_011_006.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "92:12", "juz": 30, "page": 596, "side_trans": "Indeed, [incumbent] upon Us is guidance.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/092_012_001.mp3"}, {"type": "word", "ar": "عَلَيْنَا", "tajweed": "عَلَيۡنَا", "en": "upon Us", "tr": "ʿalaynā", "audio": "wbw/092_012_002.mp3"}, {"type": "word", "ar": "لَلْهُدَىٰ", "tajweed": "لَلۡهُدَىٰ", "en": "(is) the guidance", "tr": "lalhudā", "audio": "wbw/092_012_003.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "92:13", "juz": 30, "page": 596, "side_trans": "And indeed, to us belongs the Hereafter and the first [life].", "words": [{"type": "word", "ar": "وَإِنَّ", "tajweed": "وَإِ<rule class=ghunnah>نّ</rule>َ", "en": "And indeed", "tr": "wa-inna", "audio": "wbw/092_013_001.mp3"}, {"type": "word", "ar": "لَنَا", "tajweed": "لَنَا", "en": "for Us", "tr": "lanā", "audio": "wbw/092_013_002.mp3"}, {"type": "word", "ar": "لَلْـَٔاخِرَةَ", "tajweed": "لَلۡأَخِرَةَ", "en": "(is) the Hereafter", "tr": "lalākhirata", "audio": "wbw/092_013_003.mp3"}, {"type": "word", "ar": "وَٱلْأُولَىٰ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأُولَىٰ", "en": "and the first (life)", "tr": "wal-ūlā", "audio": "wbw/092_013_004.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "92:14", "juz": 30, "page": 596, "side_trans": "So I have warned you of a Fire which is blazing.", "words": [{"type": "word", "ar": "فَأَنذَرْتُكُمْ", "tajweed": "فَأَ<rule class=ikhafa>نذ</rule>َرۡتُكُمۡ", "en": "So I warn you", "tr": "fa-andhartukum", "audio": "wbw/092_014_001.mp3"}, {"type": "word", "ar": "نَارًۭا", "tajweed": "نَا<rule class=ikhafa>رًا</rule>", "en": "(of) a Fire", "tr": "nāran", "audio": "wbw/092_014_002.mp3"}, {"type": "word", "ar": "تَلَظَّىٰ", "tajweed": "<rule class=ikhafa>ت</rule>َلَظَّىٰ", "en": "blazing", "tr": "talaẓẓā", "audio": "wbw/092_014_003.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "92:15", "juz": 30, "page": 596, "side_trans": "None will [enter to] burn therein except the most wretched one", "words": [{"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "Not", "tr": "lā", "audio": "wbw/092_015_001.mp3"}, {"type": "word", "ar": "يَصْلَىٰهَآ", "tajweed": "يَصۡلَ<rule class=madda_normal>ـٰ</rule>ه<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "will burn (in) it", "tr": "yaṣlāhā", "audio": "wbw/092_015_002.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/092_015_003.mp3"}, {"type": "word", "ar": "ٱلْأَشْقَى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَشۡقَى", "en": "the most wretched", "tr": "l-ashqā", "audio": "wbw/092_015_004.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "92:16", "juz": 30, "page": 596, "side_trans": "Who had denied and turned away.", "words": [{"type": "word", "ar": "ٱلَّذِى", "tajweed": "ٱلَّذِى", "en": "The one who", "tr": "alladhī", "audio": "wbw/092_016_001.mp3"}, {"type": "word", "ar": "كَذَّبَ", "tajweed": "كَذَّبَ", "en": "denied", "tr": "kadhaba", "audio": "wbw/092_016_002.mp3"}, {"type": "word", "ar": "وَتَوَلَّىٰ", "tajweed": "وَتَوَلَّىٰ", "en": "and turned away", "tr": "watawallā", "audio": "wbw/092_016_003.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "92:17", "juz": 30, "page": 596, "side_trans": "But the righteous one will avoid it", "words": [{"type": "word", "ar": "وَسَيُجَنَّبُهَا", "tajweed": "وَسَيُجَ<rule class=ghunnah>نّ</rule>َبُهَا", "en": "But will be removed from it", "tr": "wasayujannabuhā", "audio": "wbw/092_017_001.mp3"}, {"type": "word", "ar": "ٱلْأَتْقَى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَتۡقَى", "en": "the righteous", "tr": "l-atqā", "audio": "wbw/092_017_002.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "92:18", "juz": 30, "page": 596, "side_trans": "[He] who gives [from] his wealth to purify himself", "words": [{"type": "word", "ar": "ٱلَّذِى", "tajweed": "ٱلَّذِى", "en": "The one who", "tr": "alladhī", "audio": "wbw/092_018_001.mp3"}, {"type": "word", "ar": "يُؤْتِى", "tajweed": "يُؤۡتِى", "en": "gives", "tr": "yu'tī", "audio": "wbw/092_018_002.mp3"}, {"type": "word", "ar": "مَالَهُۥ", "tajweed": "مَالَهُ<rule class=madda_normal>ۥ</rule>", "en": "his wealth", "tr": "mālahu", "audio": "wbw/092_018_003.mp3"}, {"type": "word", "ar": "يَتَزَكَّىٰ", "tajweed": "يَتَزَكَّىٰ", "en": "(to) purify himself", "tr": "yatazakkā", "audio": "wbw/092_018_004.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "92:19", "juz": 30, "page": 596, "side_trans": "And not [giving] for anyone who has [done him] a favor to be rewarded", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/092_019_001.mp3"}, {"type": "word", "ar": "لِأَحَدٍ", "tajweed": "لِأَحَدٍ", "en": "for anyone", "tr": "li-aḥadin", "audio": "wbw/092_019_002.mp3"}, {"type": "word", "ar": "عِندَهُۥ", "tajweed": "عِ<rule class=ikhafa>ند</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "with him", "tr": "ʿindahu", "audio": "wbw/092_019_003.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_ghunnah>ِن</rule>", "en": "any", "tr": "min", "audio": "wbw/092_019_004.mp3"}, {"type": "word", "ar": "نِّعْمَةٍۢ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>ِّعۡمَ<rule class=ikhafa>ةٍ</rule>", "en": "favor", "tr": "niʿ'matin", "audio": "wbw/092_019_005.mp3"}, {"type": "word", "ar": "تُجْزَىٰٓ", "tajweed": "<rule class=ikhafa>ت</rule>ُ<rule class=qalaqah>جۡ</rule>زَىٰٓ", "en": "to be recompensed", "tr": "tuj'zā", "audio": "wbw/092_019_006.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "92:20", "juz": 30, "page": 596, "side_trans": "But only seeking the face [i.e., acceptance] of his Lord, Most High.", "words": [{"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "Except", "tr": "illā", "audio": "wbw/092_020_001.mp3"}, {"type": "word", "ar": "ٱبْتِغَآءَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>بۡ</rule>تِغ<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "seeking", "tr": "ib'tighāa", "audio": "wbw/092_020_002.mp3"}, {"type": "word", "ar": "وَجْهِ", "tajweed": "وَ<rule class=qalaqah>جۡ</rule>هِ", "en": "(the) Countenance", "tr": "wajhi", "audio": "wbw/092_020_003.mp3"}, {"type": "word", "ar": "رَبِّهِ", "tajweed": "رَبِّهِ", "en": "(of) his Lord", "tr": "rabbihi", "audio": "wbw/092_020_004.mp3"}, {"type": "word", "ar": "ٱلْأَعْلَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَعۡلَىٰ", "en": "the Most High", "tr": "l-aʿlā", "audio": "wbw/092_020_005.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "92:21", "juz": 30, "page": 596, "side_trans": "And he is going to be satisfied.", "words": [{"type": "word", "ar": "وَلَسَوْفَ", "tajweed": "وَلَسَوۡفَ", "en": "And soon, surely", "tr": "walasawfa", "audio": "wbw/092_021_001.mp3"}, {"type": "word", "ar": "يَرْضَىٰ", "tajweed": "يَرۡضَىٰ", "en": "he will be pleased", "tr": "yarḍā", "audio": "wbw/092_021_002.mp3"}, {"type": "end", "num": "٢١"}]}]