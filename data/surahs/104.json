[{"id": 1, "key": "104:1", "juz": 30, "page": 601, "side_trans": "Woe to every scorner and mocker", "words": [{"type": "word", "ar": "وَيْلٌۭ", "tajweed": "وَيۡ<rule class=idgham_wo_ghunnah>لٌ</rule>", "en": "Woe", "tr": "waylun", "audio": "wbw/104_001_001.mp3"}, {"type": "word", "ar": "لِّكُلِّ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّكُلِّ", "en": "to every", "tr": "likulli", "audio": "wbw/104_001_002.mp3"}, {"type": "word", "ar": "هُمَزَةٍۢ", "tajweed": "هُمَزَ<rule class=idgham_wo_ghunnah>ةٍ</rule>", "en": "slanderer", "tr": "humazatin", "audio": "wbw/104_001_003.mp3"}, {"type": "word", "ar": "لُّمَزَةٍ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ُّمَزَةٍ", "en": "backbiter", "tr": "lumazatin", "audio": "wbw/104_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "104:2", "juz": 30, "page": 601, "side_trans": "Who collects wealth and [continuously] counts it.", "words": [{"type": "word", "ar": "ٱلَّذِى", "tajweed": "ٱلَّذِى", "en": "The one who", "tr": "alladhī", "audio": "wbw/104_002_001.mp3"}, {"type": "word", "ar": "جَمَعَ", "tajweed": "جَمَعَ", "en": "collects", "tr": "jamaʿa", "audio": "wbw/104_002_002.mp3"}, {"type": "word", "ar": "مَالًۭا", "tajweed": "مَال<rule class=idgham_ghunnah>اً</rule>", "en": "wealth", "tr": "mālan", "audio": "wbw/104_002_003.mp3"}, {"type": "word", "ar": "وَعَدَّدَهُۥ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َعَدَّدَهُۥ", "en": "and counts it", "tr": "waʿaddadahu", "audio": "wbw/104_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "104:3", "juz": 30, "page": 601, "side_trans": "He thinks that his wealth will make him immortal.", "words": [{"type": "word", "ar": "يَحْسَبُ", "tajweed": "يَحۡسَبُ", "en": "Thinking", "tr": "yaḥsabu", "audio": "wbw/104_003_001.mp3"}, {"type": "word", "ar": "أَنَّ", "tajweed": "أَ<rule class=ghunnah>نّ</rule>َ", "en": "that", "tr": "anna", "audio": "wbw/104_003_002.mp3"}, {"type": "word", "ar": "مَالَهُۥٓ", "tajweed": "مَالَهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "his wealth", "tr": "mālahu", "audio": "wbw/104_003_003.mp3"}, {"type": "word", "ar": "أَخْلَدَهُۥ", "tajweed": "أَخۡلَدَهُۥ", "en": "will make him immortal", "tr": "akhladahu", "audio": "wbw/104_003_004.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "104:4", "juz": 30, "page": 601, "side_trans": "No! He will surely be thrown into the Crusher.", "words": [{"type": "word", "ar": "كَلَّا ۖ", "tajweed": "كَلَّا‌ۖ", "en": "Nay", "tr": "kallā", "audio": "wbw/104_004_001.mp3"}, {"type": "word", "ar": "لَيُنۢبَذَنَّ", "tajweed": "لَيُ<rule class=iqlab>نۢب</rule>َذَ<rule class=ghunnah>نّ</rule>َ", "en": "Surely he will be thrown", "tr": "layunbadhanna", "audio": "wbw/104_004_003.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/104_004_004.mp3"}, {"type": "word", "ar": "ٱلْحُطَمَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحُطَمَةِ", "en": "the Crusher", "tr": "l-ḥuṭamati", "audio": "wbw/104_004_005.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "104:5", "juz": 30, "page": 601, "side_trans": "And what can make you know what is the Crusher?", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And what", "tr": "wamā", "audio": "wbw/104_005_001.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "will make you know", "tr": "adrāka", "audio": "wbw/104_005_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/104_005_003.mp3"}, {"type": "word", "ar": "ٱلْحُطَمَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحُطَمَةُ", "en": "the Crusher (is)", "tr": "l-ḥuṭamatu", "audio": "wbw/104_005_004.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "104:6", "juz": 30, "page": 601, "side_trans": "It is the fire of Allāh, [eternally] fueled,", "words": [{"type": "word", "ar": "نَارُ", "tajweed": "نَارُ", "en": "A Fire", "tr": "nāru", "audio": "wbw/104_006_001.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/104_006_002.mp3"}, {"type": "word", "ar": "ٱلْمُوقَدَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُوقَدَةُ", "en": "kindled", "tr": "l-mūqadatu", "audio": "wbw/104_006_003.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "104:7", "juz": 30, "page": 601, "side_trans": "Which mounts directed at the hearts.", "words": [{"type": "word", "ar": "ٱلَّتِى", "tajweed": "ٱلَّتِى", "en": "Which", "tr": "allatī", "audio": "wbw/104_007_001.mp3"}, {"type": "word", "ar": "تَطَّلِعُ", "tajweed": "تَطَّلِعُ", "en": "mounts up", "tr": "taṭṭaliʿu", "audio": "wbw/104_007_002.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "to", "tr": "ʿalā", "audio": "wbw/104_007_003.mp3"}, {"type": "word", "ar": "ٱلْأَفْـِٔدَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَفۡــِٔدَةِ", "en": "the hearts", "tr": "l-afidati", "audio": "wbw/104_007_004.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "104:8", "juz": 30, "page": 601, "side_trans": "Indeed, it [i.e., Hellfire] will be closed down upon them", "words": [{"type": "word", "ar": "إِنَّهَا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهَا", "en": "Indeed, it", "tr": "innahā", "audio": "wbw/104_008_001.mp3"}, {"type": "word", "ar": "عَلَيْهِم", "tajweed": "عَلَيۡه<rule class=idgham_shafawi>ِم</rule>", "en": "(will be) upon them", "tr": "ʿalayhim", "audio": "wbw/104_008_002.mp3"}, {"type": "word", "ar": "مُّؤْصَدَةٌۭ", "tajweed": "<rule class=idgham_shafawi>م</rule>ُّؤۡصَدَةٌ", "en": "closed over", "tr": "mu'ṣadatun", "audio": "wbw/104_008_003.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "104:9", "juz": 30, "page": 601, "side_trans": "In extended columns.", "words": [{"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "In", "tr": "fī", "audio": "wbw/104_009_001.mp3"}, {"type": "word", "ar": "عَمَدٍۢ", "tajweed": "عَمَ<rule class=idgham_ghunnah>دٍ</rule>", "en": "columns", "tr": "ʿamadin", "audio": "wbw/104_009_002.mp3"}, {"type": "word", "ar": "مُّمَدَّدَةٍۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّمَدَّدَةِۭ", "en": "extended", "tr": "mumaddadatin", "audio": "wbw/104_009_003.mp3"}, {"type": "end", "num": "٩"}]}]