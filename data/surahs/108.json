[{"id": 1, "key": "108:1", "juz": 30, "page": 602, "side_trans": "Indeed, We have granted you, [O Muḥammad], al-Kawthar.", "words": [{"type": "word", "ar": "إِنَّآ", "tajweed": "إِ<rule class=ghunnah>نّ</rule><rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Indeed, We", "tr": "innā", "audio": "wbw/108_001_001.mp3"}, {"type": "word", "ar": "أَعْطَيْنَـٰكَ", "tajweed": "أَعۡطَيۡنَ<rule class=madda_normal>ـٰ</rule>كَ", "en": "We have given you", "tr": "aʿṭaynāka", "audio": "wbw/108_001_002.mp3"}, {"type": "word", "ar": "ٱلْكَوْثَرَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَوۡثَرَ", "en": "Al-Kauthar", "tr": "l-kawthara", "audio": "wbw/108_001_003.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "108:2", "juz": 30, "page": 602, "side_trans": "So pray to your Lord and offer sacrifice [to Him alone].", "words": [{"type": "word", "ar": "فَصَلِّ", "tajweed": "فَصَلِّ", "en": "So pray", "tr": "faṣalli", "audio": "wbw/108_002_001.mp3"}, {"type": "word", "ar": "لِرَبِّكَ", "tajweed": "لِرَبِّكَ", "en": "to your Lord", "tr": "lirabbika", "audio": "wbw/108_002_002.mp3"}, {"type": "word", "ar": "وَٱنْحَرْ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>نۡحَرۡ", "en": "and sacrifice", "tr": "wa-in'ḥar", "audio": "wbw/108_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "108:3", "juz": 30, "page": 602, "side_trans": "Indeed, your enemy is the one cut off.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/108_003_001.mp3"}, {"type": "word", "ar": "شَانِئَكَ", "tajweed": "شَانِئَكَ", "en": "your enemy ", "tr": "shāni-aka", "audio": "wbw/108_003_002.mp3"}, {"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "he (is)", "tr": "huwa", "audio": "wbw/108_003_003.mp3"}, {"type": "word", "ar": "ٱلْأَبْتَرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَ<rule class=qalaqah>بۡ</rule>تَرُ", "en": "the one cut off", "tr": "l-abtaru", "audio": "wbw/108_003_004.mp3"}, {"type": "end", "num": "٣"}]}]