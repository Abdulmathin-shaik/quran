[{"id": 1, "key": "98:1", "juz": 30, "page": 598, "side_trans": "Those who disbelieved among the People of the Scripture and the polytheists were not to be parted [from misbelief] until there came to them clear evidence", "words": [{"type": "word", "ar": "لَمْ", "tajweed": "لَمۡ", "en": "Not", "tr": "lam", "audio": "wbw/098_001_001.mp3"}, {"type": "word", "ar": "يَكُنِ", "tajweed": "يَكُنِ", "en": "were", "tr": "yakuni", "audio": "wbw/098_001_002.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/098_001_003.mp3"}, {"type": "word", "ar": "كَفَرُوا۟", "tajweed": "كَفَرُو<rule class=slnt>اۡ</rule>", "en": "disbelieved", "tr": "kafarū", "audio": "wbw/098_001_004.mp3"}, {"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "from", "tr": "min", "audio": "wbw/098_001_005.mp3"}, {"type": "word", "ar": "أَهْلِ", "tajweed": "أَهۡلِ", "en": "(the) People", "tr": "ahli", "audio": "wbw/098_001_006.mp3"}, {"type": "word", "ar": "ٱلْكِتَـٰبِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكِتَ<rule class=madda_normal>ـٰ</rule>بِ", "en": "of the Book", "tr": "l-kitābi", "audio": "wbw/098_001_007.mp3"}, {"type": "word", "ar": "وَٱلْمُشْرِكِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمُشۡرِكِينَ", "en": "and the polytheists", "tr": "wal-mush'rikīna", "audio": "wbw/098_001_008.mp3"}, {"type": "word", "ar": "مُنفَكِّينَ", "tajweed": "مُ<rule class=ikhafa>نف</rule>َكِّينَ", "en": "to be abandoned", "tr": "munfakkīna", "audio": "wbw/098_001_009.mp3"}, {"type": "word", "ar": "حَتَّىٰ", "tajweed": "حَتَّىٰ", "en": "until", "tr": "ḥattā", "audio": "wbw/098_001_010.mp3"}, {"type": "word", "ar": "تَأْتِيَهُمُ", "tajweed": "تَأۡتِيَهُمُ", "en": "(there) comes to them", "tr": "tatiyahumu", "audio": "wbw/098_001_011.mp3"}, {"type": "word", "ar": "ٱلْبَيِّنَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبَيِّنَةُ", "en": "the clear evidence", "tr": "l-bayinatu", "audio": "wbw/098_001_012.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "98:2", "juz": 30, "page": 598, "side_trans": "A Messenger from Allāh, reciting purified scriptures", "words": [{"type": "word", "ar": "رَسُولٌۭ", "tajweed": "رَسُو<rule class=idgham_ghunnah>لٌ</rule>", "en": "A Messenger", "tr": "rasūlun", "audio": "wbw/098_002_001.mp3"}, {"type": "word", "ar": "مِّنَ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنَ", "en": "from", "tr": "mina", "audio": "wbw/098_002_002.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/098_002_003.mp3"}, {"type": "word", "ar": "يَتْلُوا۟", "tajweed": "يَتۡلُو<rule class=slnt>اۡ</rule>", "en": "reciting", "tr": "yatlū", "audio": "wbw/098_002_004.mp3"}, {"type": "word", "ar": "صُحُفًۭا", "tajweed": "صُحُ<rule class=idgham_ghunnah>فًا</rule>", "en": "pages", "tr": "ṣuḥufan", "audio": "wbw/098_002_005.mp3"}, {"type": "word", "ar": "مُّطَهَّرَةًۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّطَهَّرَةً", "en": "purified", "tr": "muṭahharatan", "audio": "wbw/098_002_006.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "98:3", "juz": 30, "page": 598, "side_trans": "Within which are correct writings [i.e., rulings and laws].", "words": [{"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "Wherein", "tr": "fīhā", "audio": "wbw/098_003_001.mp3"}, {"type": "word", "ar": "كُتُبٌۭ", "tajweed": "كُتُ<rule class=ikhafa>بٌ</rule>", "en": "(are) writings", "tr": "kutubun", "audio": "wbw/098_003_002.mp3"}, {"type": "word", "ar": "قَيِّمَةٌۭ", "tajweed": "<rule class=ikhafa>ق</rule>َيِّمَةٌ", "en": "correct", "tr": "qayyimatun", "audio": "wbw/098_003_003.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "98:4", "juz": 30, "page": 598, "side_trans": "Nor did those who were given the Scripture become divided until after there had come to them clear evidence.", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/098_004_001.mp3"}, {"type": "word", "ar": "تَفَرَّقَ", "tajweed": "تَفَرَّقَ", "en": "became divided", "tr": "tafarraqa", "audio": "wbw/098_004_002.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/098_004_003.mp3"}, {"type": "word", "ar": "أُوتُوا۟", "tajweed": "أُوتُو<rule class=slnt>اۡ</rule>", "en": "were given", "tr": "ūtū", "audio": "wbw/098_004_004.mp3"}, {"type": "word", "ar": "ٱلْكِتَـٰبَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكِتَ<rule class=madda_normal>ـٰ</rule>بَ", "en": "the Book", "tr": "l-kitāba", "audio": "wbw/098_004_005.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "until", "tr": "illā", "audio": "wbw/098_004_006.mp3"}, {"type": "word", "ar": "مِنۢ", "tajweed": "م<rule class=iqlab>ِنۢ</rule>", "en": "from", "tr": "min", "audio": "wbw/098_004_007.mp3"}, {"type": "word", "ar": "بَعْدِ", "tajweed": "<rule class=iqlab>ب</rule>َعۡدِ", "en": "after", "tr": "baʿdi", "audio": "wbw/098_004_008.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/098_004_009.mp3"}, {"type": "word", "ar": "جَآءَتْهُمُ", "tajweed": "ج<rule class=madda_obligatory_mottasel>َا</rule>ٓءَتۡهُمُ", "en": "came (to) them", "tr": "jāathumu", "audio": "wbw/098_004_010.mp3"}, {"type": "word", "ar": "ٱلْبَيِّنَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبَيِّنَةُ", "en": "(of) the clear evidence", "tr": "l-bayinatu", "audio": "wbw/098_004_011.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "98:5", "juz": 30, "page": 598, "side_trans": "And they were not commanded except to worship Allāh, [being] sincere to Him in religion, inclining to truth, and to establish prayer and to give zakāh. And that is the correct religion.", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And not", "tr": "wamā", "audio": "wbw/098_005_001.mp3"}, {"type": "word", "ar": "أُمِرُوٓا۟", "tajweed": "أُمِر<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "they were commanded", "tr": "umirū", "audio": "wbw/098_005_002.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/098_005_003.mp3"}, {"type": "word", "ar": "لِيَعْبُدُوا۟", "tajweed": "لِيَعۡبُدُو<rule class=slnt>اۡ</rule>", "en": "to worship", "tr": "liyaʿbudū", "audio": "wbw/098_005_004.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/098_005_005.mp3"}, {"type": "word", "ar": "مُخْلِصِينَ", "tajweed": "مُخۡلِصِينَ", "en": "(being) sincere", "tr": "mukh'liṣīna", "audio": "wbw/098_005_006.mp3"}, {"type": "word", "ar": "لَهُ", "tajweed": "لَهُ", "en": "to Him", "tr": "lahu", "audio": "wbw/098_005_007.mp3"}, {"type": "word", "ar": "ٱلدِّينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دِّينَ", "en": "(in) the religion", "tr": "l-dīna", "audio": "wbw/098_005_008.mp3"}, {"type": "word", "ar": "حُنَفَآءَ", "tajweed": "حُنَف<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "upright", "tr": "ḥunafāa", "audio": "wbw/098_005_009.mp3"}, {"type": "word", "ar": "وَيُقِيمُوا۟", "tajweed": "وَيُقِيمُو<rule class=slnt>اۡ</rule>", "en": "and to establish", "tr": "wayuqīmū", "audio": "wbw/098_005_010.mp3"}, {"type": "word", "ar": "ٱلصَّلَوٰةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّلَ<rule class=slnt>و</rule><rule class=madda_normal>ٰ</rule>ةَ", "en": "the prayer", "tr": "l-ṣalata", "audio": "wbw/098_005_011.mp3"}, {"type": "word", "ar": "وَيُؤْتُوا۟", "tajweed": "وَيُؤۡتُو<rule class=slnt>اۡ</rule>", "en": "and to give", "tr": "wayu'tū", "audio": "wbw/098_005_012.mp3"}, {"type": "word", "ar": "ٱلزَّكَوٰةَ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>زَّكَ<rule class=slnt>و</rule><rule class=madda_normal>ٰ</rule>ةَ‌ۚ", "en": "the zakah", "tr": "l-zakata", "audio": "wbw/098_005_013.mp3"}, {"type": "word", "ar": "وَذَٰلِكَ", "tajweed": "وَذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "And that", "tr": "wadhālika", "audio": "wbw/098_005_015.mp3"}, {"type": "word", "ar": "دِينُ", "tajweed": "دِينُ", "en": "(is the) religion", "tr": "dīnu", "audio": "wbw/098_005_016.mp3"}, {"type": "word", "ar": "ٱلْقَيِّمَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَيِّمَةِ", "en": "the correct", "tr": "l-qayimati", "audio": "wbw/098_005_017.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "98:6", "juz": 30, "page": 599, "side_trans": "Indeed, they who disbelieved among the People of the Scripture and the polytheists will be in the fire of Hell, abiding eternally therein. Those are the worst of creatures.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/098_006_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/098_006_002.mp3"}, {"type": "word", "ar": "كَفَرُوا۟", "tajweed": "كَفَرُو<rule class=slnt>اۡ</rule>", "en": "disbelieve", "tr": "kafarū", "audio": "wbw/098_006_003.mp3"}, {"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "from", "tr": "min", "audio": "wbw/098_006_004.mp3"}, {"type": "word", "ar": "أَهْلِ", "tajweed": "أَهۡلِ", "en": "(the) People", "tr": "ahli", "audio": "wbw/098_006_005.mp3"}, {"type": "word", "ar": "ٱلْكِتَـٰبِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكِتَ<rule class=madda_normal>ـٰ</rule>بِ", "en": "(of) the Book", "tr": "l-kitābi", "audio": "wbw/098_006_006.mp3"}, {"type": "word", "ar": "وَٱلْمُشْرِكِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمُشۡرِكِينَ", "en": "and the polytheists", "tr": "wal-mush'rikīna", "audio": "wbw/098_006_007.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(will be) in", "tr": "fī", "audio": "wbw/098_006_008.mp3"}, {"type": "word", "ar": "نَارِ", "tajweed": "نَارِ", "en": "(the) Fire", "tr": "nāri", "audio": "wbw/098_006_009.mp3"}, {"type": "word", "ar": "جَهَنَّمَ", "tajweed": "جَهَ<rule class=ghunnah>نّ</rule>َمَ", "en": "(of) Hell", "tr": "jahannama", "audio": "wbw/098_006_010.mp3"}, {"type": "word", "ar": "خَـٰلِدِينَ", "tajweed": "خَ<rule class=madda_normal>ـٰ</rule>لِدِينَ", "en": "abiding eternally", "tr": "khālidīna", "audio": "wbw/098_006_011.mp3"}, {"type": "word", "ar": "فِيهَآ ۚ", "tajweed": "فِيه<rule class=madda_obligatory_monfasel>َآ‌ۚ</rule>", "en": "therein", "tr": "fīhā", "audio": "wbw/098_006_012.mp3"}, {"type": "word", "ar": "أُو۟لَـٰٓئِكَ", "tajweed": "أُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَ", "en": "Those ", "tr": "ulāika", "audio": "wbw/098_006_014.mp3"}, {"type": "word", "ar": "هُمْ", "tajweed": "هُمۡ", "en": "they", "tr": "hum", "audio": "wbw/098_006_015.mp3"}, {"type": "word", "ar": "شَرُّ", "tajweed": "شَرُّ", "en": "(are the) worst", "tr": "sharru", "audio": "wbw/098_006_016.mp3"}, {"type": "word", "ar": "ٱلْبَرِيَّةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبَرِيَّةِ", "en": "(of) the creatures", "tr": "l-bariyati", "audio": "wbw/098_006_017.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "98:7", "juz": 30, "page": 599, "side_trans": "Indeed, they who have believed and done righteous deeds - those are the best of creatures.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/098_007_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/098_007_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/098_007_003.mp3"}, {"type": "word", "ar": "وَعَمِلُوا۟", "tajweed": "وَعَمِلُو<rule class=slnt>اۡ</rule>", "en": "and do", "tr": "waʿamilū", "audio": "wbw/098_007_004.mp3"}, {"type": "word", "ar": "ٱلصَّـٰلِحَـٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّ<rule class=madda_normal>ـٰ</rule>لِحَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "righteous deeds", "tr": "l-ṣāliḥāti", "audio": "wbw/098_007_005.mp3"}, {"type": "word", "ar": "أُو۟لَـٰٓئِكَ", "tajweed": "أُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَ", "en": "those ", "tr": "ulāika", "audio": "wbw/098_007_006.mp3"}, {"type": "word", "ar": "هُمْ", "tajweed": "هُمۡ", "en": "they", "tr": "hum", "audio": "wbw/098_007_007.mp3"}, {"type": "word", "ar": "خَيْرُ", "tajweed": "خَيۡرُ", "en": "(are the) best", "tr": "khayru", "audio": "wbw/098_007_008.mp3"}, {"type": "word", "ar": "ٱلْبَرِيَّةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبَرِيَّةِ", "en": "(of) the creatures", "tr": "l-bariyati", "audio": "wbw/098_007_009.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "98:8", "juz": 30, "page": 599, "side_trans": "Their reward with their Lord will be gardens of perpetual residence beneath which rivers flow, wherein they will abide forever, Allāh being pleased with them and they with Him. That is for whoever has feared his Lord.", "words": [{"type": "word", "ar": "جَزَآؤُهُمْ", "tajweed": "جَز<rule class=madda_obligatory_mottasel>َا</rule>ٓؤُهُمۡ", "en": "Their reward", "tr": "jazāuhum", "audio": "wbw/098_008_001.mp3"}, {"type": "word", "ar": "عِندَ", "tajweed": "عِ<rule class=ikhafa>ند</rule>َ", "en": "(is) with", "tr": "ʿinda", "audio": "wbw/098_008_002.mp3"}, {"type": "word", "ar": "رَبِّهِمْ", "tajweed": "رَبِّهِمۡ", "en": "their Lord ", "tr": "rabbihim", "audio": "wbw/098_008_003.mp3"}, {"type": "word", "ar": "جَنَّـٰتُ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule>تُ", "en": "Gardens", "tr": "jannātu", "audio": "wbw/098_008_004.mp3"}, {"type": "word", "ar": "عَدْنٍۢ", "tajweed": "عَ<rule class=qalaqah>دۡ</rule><rule class=ikhafa>نٍ</rule>", "en": "(of) Eternity", "tr": "ʿadnin", "audio": "wbw/098_008_005.mp3"}, {"type": "word", "ar": "تَجْرِى", "tajweed": "<rule class=ikhafa>ت</rule>َ<rule class=qalaqah>جۡ</rule>رِى", "en": "flow", "tr": "tajrī", "audio": "wbw/098_008_006.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/098_008_007.mp3"}, {"type": "word", "ar": "تَحْتِهَا", "tajweed": "<rule class=ikhafa>ت</rule>َحۡتِهَا", "en": "underneath them", "tr": "taḥtihā", "audio": "wbw/098_008_008.mp3"}, {"type": "word", "ar": "ٱلْأَنْهَـٰرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَنۡهَ<rule class=madda_normal>ـٰ</rule>رُ", "en": "the rivers", "tr": "l-anhāru", "audio": "wbw/098_008_009.mp3"}, {"type": "word", "ar": "خَـٰلِدِينَ", "tajweed": "خَ<rule class=madda_normal>ـٰ</rule>لِدِينَ", "en": "will abide", "tr": "khālidīna", "audio": "wbw/098_008_010.mp3"}, {"type": "word", "ar": "فِيهَآ", "tajweed": "فِيه<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "therein", "tr": "fīhā", "audio": "wbw/098_008_011.mp3"}, {"type": "word", "ar": "أَبَدًۭا ۖ", "tajweed": "أَبَ<rule class=idgham_wo_ghunnah>دًا‌ۖ</rule>", "en": "forever", "tr": "abadan", "audio": "wbw/098_008_012.mp3"}, {"type": "word", "ar": "رَّضِىَ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّضِىَ", "en": "(will be) pleased", "tr": "raḍiya", "audio": "wbw/098_008_014.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/098_008_015.mp3"}, {"type": "word", "ar": "عَنْهُمْ", "tajweed": "عَنۡهُمۡ", "en": "with them", "tr": "ʿanhum", "audio": "wbw/098_008_016.mp3"}, {"type": "word", "ar": "وَرَضُوا۟", "tajweed": "وَرَضُو<rule class=slnt>اۡ</rule>", "en": "and they (will be) pleased", "tr": "waraḍū", "audio": "wbw/098_008_017.mp3"}, {"type": "word", "ar": "عَنْهُ ۚ", "tajweed": "عَنۡهُ‌ۚ", "en": "with Him", "tr": "ʿanhu", "audio": "wbw/098_008_018.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "That", "tr": "dhālika", "audio": "wbw/098_008_020.mp3"}, {"type": "word", "ar": "لِمَنْ", "tajweed": "لِمَنۡ", "en": "(is) for whoever", "tr": "liman", "audio": "wbw/098_008_021.mp3"}, {"type": "word", "ar": "خَشِىَ", "tajweed": "خَشِىَ", "en": "feared", "tr": "khashiya", "audio": "wbw/098_008_022.mp3"}, {"type": "word", "ar": "رَبَّهُۥ", "tajweed": "رَبَّهُۥ", "en": "his Lord", "tr": "rabbahu", "audio": "wbw/098_008_023.mp3"}, {"type": "end", "num": "٨"}]}]