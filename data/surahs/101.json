[{"id": 1, "key": "101:1", "juz": 30, "page": 600, "side_trans": "The Striking Calamity -", "words": [{"type": "word", "ar": "ٱلْقَارِعَةُ", "tajweed": "ٱلۡقَارِعَةُ", "en": "The Striking Calamity", "tr": "al-qāriʿatu", "audio": "wbw/101_001_001.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "101:2", "juz": 30, "page": 600, "side_trans": "What is the Striking Calamity?", "words": [{"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "What", "tr": "mā", "audio": "wbw/101_002_001.mp3"}, {"type": "word", "ar": "ٱلْقَارِعَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَارِعَةُ", "en": "(is) the Striking Calamity", "tr": "l-qāriʿatu", "audio": "wbw/101_002_002.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "101:3", "juz": 30, "page": 600, "side_trans": "And what can make you know what is the Striking Calamity?", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And what", "tr": "wamā", "audio": "wbw/101_003_001.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "will make you know", "tr": "adrāka", "audio": "wbw/101_003_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/101_003_003.mp3"}, {"type": "word", "ar": "ٱلْقَارِعَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَارِعَةُ", "en": "(is) the Striking Calamity", "tr": "l-qāriʿatu", "audio": "wbw/101_003_004.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "101:4", "juz": 30, "page": 600, "side_trans": "It is the Day when people will be like moths, dispersed,", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(The) Day", "tr": "yawma", "audio": "wbw/101_004_001.mp3"}, {"type": "word", "ar": "يَكُونُ", "tajweed": "يَكُونُ", "en": "will be", "tr": "yakūnu", "audio": "wbw/101_004_002.mp3"}, {"type": "word", "ar": "ٱلنَّاسُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َاسُ", "en": "the mankind", "tr": "l-nāsu", "audio": "wbw/101_004_003.mp3"}, {"type": "word", "ar": "كَٱلْفَرَاشِ", "tajweed": "كَ<rule class=ham_wasl>ٱ</rule>لۡفَرَاشِ", "en": "like moths", "tr": "kal-farāshi", "audio": "wbw/101_004_004.mp3"}, {"type": "word", "ar": "ٱلْمَبْثُوثِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَ<rule class=qalaqah>بۡ</rule>ث<rule class=madda_permissible>ُو</rule>ثِ", "en": "scattered", "tr": "l-mabthūthi", "audio": "wbw/101_004_005.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "101:5", "juz": 30, "page": 600, "side_trans": "And the mountains will be like wool, fluffed up.", "words": [{"type": "word", "ar": "وَتَكُونُ", "tajweed": "وَتَكُونُ", "en": "And will be", "tr": "watakūnu", "audio": "wbw/101_005_001.mp3"}, {"type": "word", "ar": "ٱلْجِبَالُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجِبَالُ", "en": "the mountains", "tr": "l-jibālu", "audio": "wbw/101_005_002.mp3"}, {"type": "word", "ar": "كَٱلْعِهْنِ", "tajweed": "كَ<rule class=ham_wasl>ٱ</rule>لۡعِهۡنِ", "en": "like wool", "tr": "kal-ʿih'ni", "audio": "wbw/101_005_003.mp3"}, {"type": "word", "ar": "ٱلْمَنفُوشِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَ<rule class=ikhafa>نف</rule><rule class=madda_permissible>ُو</rule>شِ", "en": "fluffed up", "tr": "l-manfūshi", "audio": "wbw/101_005_004.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "101:6", "juz": 30, "page": 600, "side_trans": "Then as for one whose scales are heavy [with good deeds],", "words": [{"type": "word", "ar": "فَأَمَّا", "tajweed": "فَأَ<rule class=ghunnah>مّ</rule>َا", "en": "Then as for", "tr": "fa-ammā", "audio": "wbw/101_006_001.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "مَ<rule class=ikhafa>ن</rule>", "en": "(him) whose", "tr": "man", "audio": "wbw/101_006_002.mp3"}, {"type": "word", "ar": "ثَقُلَتْ", "tajweed": "<rule class=ikhafa>ث</rule>َقُلَتۡ", "en": "(are) heavy", "tr": "thaqulat", "audio": "wbw/101_006_003.mp3"}, {"type": "word", "ar": "مَوَٰزِينُهُۥ", "tajweed": "مَو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>زِينُهُۥ", "en": "his scales", "tr": "mawāzīnuhu", "audio": "wbw/101_006_004.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "101:7", "juz": 30, "page": 600, "side_trans": "He will be in a pleasant life.", "words": [{"type": "word", "ar": "فَهُوَ", "tajweed": "فَهُوَ", "en": "Then he", "tr": "fahuwa", "audio": "wbw/101_007_001.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(will be) in", "tr": "fī", "audio": "wbw/101_007_002.mp3"}, {"type": "word", "ar": "عِيشَةٍۢ", "tajweed": "عِيشَ<rule class=idgham_wo_ghunnah>ةٍ</rule>", "en": "a life", "tr": "ʿīshatin", "audio": "wbw/101_007_003.mp3"}, {"type": "word", "ar": "رَّاضِيَةٍۢ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّاضِيَةٍ", "en": "pleasant", "tr": "rāḍiyatin", "audio": "wbw/101_007_004.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "101:8", "juz": 30, "page": 600, "side_trans": "But as for one whose scales are light,", "words": [{"type": "word", "ar": "وَأَمَّا", "tajweed": "وَأَ<rule class=ghunnah>مّ</rule>َا", "en": "But as for", "tr": "wa-ammā", "audio": "wbw/101_008_001.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "(him) whose", "tr": "man", "audio": "wbw/101_008_002.mp3"}, {"type": "word", "ar": "خَفَّتْ", "tajweed": "خَفَّتۡ", "en": "(are) light", "tr": "khaffat", "audio": "wbw/101_008_003.mp3"}, {"type": "word", "ar": "مَوَٰزِينُهُۥ", "tajweed": "مَو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>زِينُهُۥ", "en": "his scales", "tr": "mawāzīnuhu", "audio": "wbw/101_008_004.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "101:9", "juz": 30, "page": 600, "side_trans": "His refuge will be an abyss.", "words": [{"type": "word", "ar": "فَأُمُّهُۥ", "tajweed": "فَأُ<rule class=ghunnah>مّ</rule>ُهُ<rule class=madda_normal>ۥ</rule>", "en": "His abode", "tr": "fa-ummuhu", "audio": "wbw/101_009_001.mp3"}, {"type": "word", "ar": "هَاوِيَةٌۭ", "tajweed": "هَاوِيَةٌ", "en": "(will be the) Pit", "tr": "hāwiyatun", "audio": "wbw/101_009_002.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "101:10", "juz": 30, "page": 600, "side_trans": "And what can make you know what that is?", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And what", "tr": "wamā", "audio": "wbw/101_010_001.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "will make you know", "tr": "adrāka", "audio": "wbw/101_010_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/101_010_003.mp3"}, {"type": "word", "ar": "هِيَهْ", "tajweed": "هِيَهۡ", "en": "it is", "tr": "hiyah", "audio": "wbw/101_010_004.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "101:11", "juz": 30, "page": 600, "side_trans": "It is a Fire, intensely hot.", "words": [{"type": "word", "ar": "نَارٌ", "tajweed": "نَارٌ", "en": "A Fire", "tr": "nārun", "audio": "wbw/101_011_001.mp3"}, {"type": "word", "ar": "حَامِيَةٌۢ", "tajweed": "حَامِيَةُۢ", "en": "intensely hot", "tr": "ḥāmiyatun", "audio": "wbw/101_011_002.mp3"}, {"type": "end", "num": "١١"}]}]