[{"id": 1, "key": "69:1", "juz": 29, "page": 566, "side_trans": "The Inevitable Reality -", "words": [{"type": "word", "ar": "ٱلْحَآقَّةُ", "tajweed": "ٱلۡح<rule class=madda_necessary>َا</rule>ٓقَّةُ", "en": "The Inevitable Reality", "tr": "al-ḥāqatu", "audio": "wbw/069_001_001.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "69:2", "juz": 29, "page": 566, "side_trans": "What is the Inevitable Reality?", "words": [{"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "What", "tr": "mā", "audio": "wbw/069_002_001.mp3"}, {"type": "word", "ar": "ٱلْحَآقَّةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡح<rule class=madda_necessary>َا</rule>ٓقَّةُ", "en": "(is) the Inevitable Reality", "tr": "l-ḥāqatu", "audio": "wbw/069_002_002.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "69:3", "juz": 29, "page": 566, "side_trans": "And what can make you know what is the Inevitable Reality?", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And what", "tr": "wamā", "audio": "wbw/069_003_001.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "will make you know", "tr": "adrāka", "audio": "wbw/069_003_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/069_003_003.mp3"}, {"type": "word", "ar": "ٱلْحَآقَّةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡح<rule class=madda_necessary>َا</rule>ٓقَّةُ", "en": "(is) the Inevitable Reality", "tr": "l-ḥāqatu", "audio": "wbw/069_003_004.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "69:4", "juz": 29, "page": 566, "side_trans": "Thamūd and ʿAad denied the Striking Calamity [i.e., the Resurrection].", "words": [{"type": "word", "ar": "كَذَّبَتْ", "tajweed": "كَذَّبَتۡ", "en": "Denied", "tr": "kadhabat", "audio": "wbw/069_004_001.mp3"}, {"type": "word", "ar": "ثَمُودُ", "tajweed": "ثَمُودُ", "en": "Thamud", "tr": "thamūdu", "audio": "wbw/069_004_002.mp3"}, {"type": "word", "ar": "وَعَادٌۢ", "tajweed": "وَعَا<rule class=iqlab>دُۢ</rule>", "en": "and Aad", "tr": "waʿādun", "audio": "wbw/069_004_003.mp3"}, {"type": "word", "ar": "بِٱلْقَارِعَةِ", "tajweed": "<rule class=iqlab>ب</rule>ِ<rule class=ham_wasl>ٱ</rule>لۡقَارِعَةِ", "en": "the Striking Calamity", "tr": "bil-qāriʿati", "audio": "wbw/069_004_004.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "69:5", "juz": 29, "page": 566, "side_trans": "So as for Thamūd, they were destroyed by the overpowering [blast].", "words": [{"type": "word", "ar": "فَأَمَّا", "tajweed": "فَأَ<rule class=ghunnah>مّ</rule>َا", "en": "So as for", "tr": "fa-ammā", "audio": "wbw/069_005_001.mp3"}, {"type": "word", "ar": "ثَمُودُ", "tajweed": "ثَمُودُ", "en": "Thamud", "tr": "thamūdu", "audio": "wbw/069_005_002.mp3"}, {"type": "word", "ar": "فَأُهْلِكُوا۟", "tajweed": "فَأُهۡلِكُو<rule class=slnt>اۡ</rule>", "en": "they were destroyed", "tr": "fa-uh'likū", "audio": "wbw/069_005_003.mp3"}, {"type": "word", "ar": "بِٱلطَّاغِيَةِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>طَّاغِيَةِ", "en": "by the overpowering (blast)", "tr": "bil-ṭāghiyati", "audio": "wbw/069_005_004.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "69:6", "juz": 29, "page": 566, "side_trans": "And as for ʿAad, they were destroyed by a screaming, violent wind", "words": [{"type": "word", "ar": "وَأَمَّا", "tajweed": "وَأَ<rule class=ghunnah>مّ</rule>َا", "en": "And as for", "tr": "wa-ammā", "audio": "wbw/069_006_001.mp3"}, {"type": "word", "ar": "عَادٌۭ", "tajweed": "عَا<rule class=ikhafa>دٌ</rule>", "en": "Aad", "tr": "ʿādun", "audio": "wbw/069_006_002.mp3"}, {"type": "word", "ar": "فَأُهْلِكُوا۟", "tajweed": "<rule class=ikhafa>ف</rule>َأُهۡلِكُو<rule class=slnt>اۡ</rule>", "en": "they were destroyed", "tr": "fa-uh'likū", "audio": "wbw/069_006_003.mp3"}, {"type": "word", "ar": "بِرِيحٍۢ", "tajweed": "بِرِي<rule class=ikhafa>حٍ</rule>", "en": "by a wind", "tr": "birīḥin", "audio": "wbw/069_006_004.mp3"}, {"type": "word", "ar": "صَرْصَرٍ", "tajweed": "<rule class=ikhafa>ص</rule>َرۡصَرٍ", "en": "screaming", "tr": "ṣarṣarin", "audio": "wbw/069_006_005.mp3"}, {"type": "word", "ar": "عَاتِيَةٍۢ", "tajweed": "عَاتِيَةٍ", "en": "violent", "tr": "ʿātiyatin", "audio": "wbw/069_006_006.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "69:7", "juz": 29, "page": 566, "side_trans": "Which He [i.e., Allāh] imposed upon them for seven nights and eight days in succession, so you would see the people therein fallen as if they were hollow trunks of palm trees.", "words": [{"type": "word", "ar": "سَخَّرَهَا", "tajweed": "سَخَّرَهَا", "en": "Which He imposed", "tr": "sakharahā", "audio": "wbw/069_007_001.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ", "tajweed": "عَلَيۡهِمۡ", "en": "upon them", "tr": "ʿalayhim", "audio": "wbw/069_007_002.mp3"}, {"type": "word", "ar": "سَبْعَ", "tajweed": "سَ<rule class=qalaqah>بۡ</rule>عَ", "en": "(for) seven", "tr": "sabʿa", "audio": "wbw/069_007_003.mp3"}, {"type": "word", "ar": "لَيَالٍۢ", "tajweed": "لَيَا<rule class=idgham_ghunnah>لٍ</rule>", "en": "nights", "tr": "layālin", "audio": "wbw/069_007_004.mp3"}, {"type": "word", "ar": "وَثَمَـٰنِيَةَ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َثَمَ<rule class=madda_normal>ـٰ</rule>نِيَةَ", "en": "and eight", "tr": "wathamāniyata", "audio": "wbw/069_007_005.mp3"}, {"type": "word", "ar": "أَيَّامٍ", "tajweed": "أَيَّامٍ", "en": "days", "tr": "ayyāmin", "audio": "wbw/069_007_006.mp3"}, {"type": "word", "ar": "حُسُومًۭا", "tajweed": "حُسُو<rule class=ikhafa>مًا</rule>", "en": "(in) succession", "tr": "ḥusūman", "audio": "wbw/069_007_007.mp3"}, {"type": "word", "ar": "فَتَرَى", "tajweed": "<rule class=ikhafa>ف</rule>َتَرَى", "en": "so you would see", "tr": "fatarā", "audio": "wbw/069_007_008.mp3"}, {"type": "word", "ar": "ٱلْقَوْمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَوۡمَ", "en": "the people", "tr": "l-qawma", "audio": "wbw/069_007_009.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/069_007_010.mp3"}, {"type": "word", "ar": "صَرْعَىٰ", "tajweed": "صَرۡعَىٰ", "en": "fallen", "tr": "ṣarʿā", "audio": "wbw/069_007_011.mp3"}, {"type": "word", "ar": "كَأَنَّهُمْ", "tajweed": "كَأَ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "as if they were", "tr": "ka-annahum", "audio": "wbw/069_007_012.mp3"}, {"type": "word", "ar": "أَعْجَازُ", "tajweed": "أَعۡجَازُ", "en": "trunks", "tr": "aʿjāzu", "audio": "wbw/069_007_013.mp3"}, {"type": "word", "ar": "نَخْلٍ", "tajweed": "نَخۡلٍ", "en": "(of) date-palms", "tr": "nakhlin", "audio": "wbw/069_007_014.mp3"}, {"type": "word", "ar": "خَاوِيَةٍۢ", "tajweed": "خَاوِيَةٍ", "en": "hollow", "tr": "khāwiyatin", "audio": "wbw/069_007_015.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "69:8", "juz": 29, "page": 566, "side_trans": "Then do you see of them any remains?", "words": [{"type": "word", "ar": "فَهَلْ", "tajweed": "فَهَلۡ", "en": "Then do", "tr": "fahal", "audio": "wbw/069_008_001.mp3"}, {"type": "word", "ar": "تَرَىٰ", "tajweed": "تَرَىٰ", "en": "you see", "tr": "tarā", "audio": "wbw/069_008_002.mp3"}, {"type": "word", "ar": "لَهُم", "tajweed": "لَه<rule class=idgham_shafawi>ُم</rule>", "en": "of them", "tr": "lahum", "audio": "wbw/069_008_003.mp3"}, {"type": "word", "ar": "مِّنۢ", "tajweed": "<rule class=idgham_shafawi>م</rule>ّ<rule class=iqlab>ِنۢ</rule>", "en": "any", "tr": "min", "audio": "wbw/069_008_004.mp3"}, {"type": "word", "ar": "بَاقِيَةٍۢ", "tajweed": "<rule class=iqlab>ب</rule>َاقِيَةٍ", "en": "remains", "tr": "bāqiyatin", "audio": "wbw/069_008_005.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "69:9", "juz": 29, "page": 567, "side_trans": "And there came Pharaoh and those before him and the overturned cities with sin.", "words": [{"type": "word", "ar": "وَجَآءَ", "tajweed": "وَج<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "And came", "tr": "wajāa", "audio": "wbw/069_009_001.mp3"}, {"type": "word", "ar": "فِرْعَوْنُ", "tajweed": "فِرۡعَوۡنُ", "en": "Firaun", "tr": "fir'ʿawnu", "audio": "wbw/069_009_002.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَمَ<rule class=ikhafa>ن</rule>", "en": "and (those)", "tr": "waman", "audio": "wbw/069_009_003.mp3"}, {"type": "word", "ar": "قَبْلَهُۥ", "tajweed": "<rule class=ikhafa>ق</rule>َ<rule class=qalaqah>بۡ</rule>لَهُ<rule class=madda_normal>ۥ</rule>", "en": "before him", "tr": "qablahu", "audio": "wbw/069_009_004.mp3"}, {"type": "word", "ar": "وَٱلْمُؤْتَفِكَـٰتُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمُؤۡتَفِكَ<rule class=madda_normal>ـٰ</rule>تُ", "en": "and the overturned cities", "tr": "wal-mu'tafikātu", "audio": "wbw/069_009_005.mp3"}, {"type": "word", "ar": "بِٱلْخَاطِئَةِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡخَاطِئَةِ", "en": "with sin", "tr": "bil-khāṭi-ati", "audio": "wbw/069_009_006.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "69:10", "juz": 29, "page": 567, "side_trans": "And they disobeyed the messenger of their Lord, so He seized them with a seizure exceeding [in severity].", "words": [{"type": "word", "ar": "فَعَصَوْا۟", "tajweed": "فَعَصَوۡ<rule class=slnt>اۡ</rule>", "en": "And they disobeyed", "tr": "faʿaṣaw", "audio": "wbw/069_010_001.mp3"}, {"type": "word", "ar": "رَسُولَ", "tajweed": "رَسُولَ", "en": "(the) Messenger", "tr": "rasūla", "audio": "wbw/069_010_002.mp3"}, {"type": "word", "ar": "رَبِّهِمْ", "tajweed": "رَبِّهِمۡ", "en": "(of) their Lord", "tr": "rabbihim", "audio": "wbw/069_010_003.mp3"}, {"type": "word", "ar": "فَأَخَذَهُمْ", "tajweed": "فَأَخَذَهُمۡ", "en": "so He seized them", "tr": "fa-akhadhahum", "audio": "wbw/069_010_004.mp3"}, {"type": "word", "ar": "أَخْذَةًۭ", "tajweed": "أَخۡذَ<rule class=idgham_wo_ghunnah>ةً</rule>", "en": "(with) a seizure", "tr": "akhdhatan", "audio": "wbw/069_010_005.mp3"}, {"type": "word", "ar": "رَّابِيَةً", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّابِيَةً", "en": "exceeding", "tr": "rābiyatan", "audio": "wbw/069_010_006.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "69:11", "juz": 29, "page": 567, "side_trans": "Indeed, when the water overflowed, We carried you [i.e., your ancestors] in the sailing ship", "words": [{"type": "word", "ar": "إِنَّا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َا", "en": "Indeed, We", "tr": "innā", "audio": "wbw/069_011_001.mp3"}, {"type": "word", "ar": "لَمَّا", "tajweed": "لَ<rule class=ghunnah>مّ</rule>َا", "en": "when", "tr": "lammā", "audio": "wbw/069_011_002.mp3"}, {"type": "word", "ar": "طَغَا", "tajweed": "طَغَا", "en": "overflowed", "tr": "ṭaghā", "audio": "wbw/069_011_003.mp3"}, {"type": "word", "ar": "ٱلْمَآءُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡم<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ", "en": "the water", "tr": "l-māu", "audio": "wbw/069_011_004.mp3"}, {"type": "word", "ar": "حَمَلْنَـٰكُمْ", "tajweed": "حَمَلۡنَ<rule class=madda_normal>ـٰ</rule>كُمۡ", "en": "We carried you", "tr": "ḥamalnākum", "audio": "wbw/069_011_005.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/069_011_006.mp3"}, {"type": "word", "ar": "ٱلْجَارِيَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجَارِيَةِ", "en": "the sailing (ship)", "tr": "l-jāriyati", "audio": "wbw/069_011_007.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "69:12", "juz": 29, "page": 567, "side_trans": "That We might make it for you a reminder and [that] a conscious ear would be conscious of it.", "words": [{"type": "word", "ar": "لِنَجْعَلَهَا", "tajweed": "لِنَ<rule class=qalaqah>جۡ</rule>عَلَهَا", "en": "That We might make it", "tr": "linajʿalahā", "audio": "wbw/069_012_001.mp3"}, {"type": "word", "ar": "لَكُمْ", "tajweed": "لَكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/069_012_002.mp3"}, {"type": "word", "ar": "تَذْكِرَةًۭ", "tajweed": "تَذۡكِرَ<rule class=idgham_ghunnah>ةً</rule>", "en": "a reminder", "tr": "tadhkiratan", "audio": "wbw/069_012_003.mp3"}, {"type": "word", "ar": "وَتَعِيَهَآ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َتَعِيَه<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "and would be conscious of it", "tr": "wataʿiyahā", "audio": "wbw/069_012_004.mp3"}, {"type": "word", "ar": "أُذُنٌۭ", "tajweed": "أُذُ<rule class=idgham_ghunnah>نٌ</rule>", "en": "an ear", "tr": "udhunun", "audio": "wbw/069_012_005.mp3"}, {"type": "word", "ar": "وَٰعِيَةٌۭ", "tajweed": "<rule class=idgham_ghunnah>و</rule><rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>عِيَةٌ", "en": "conscious", "tr": "wāʿiyatun", "audio": "wbw/069_012_006.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "69:13", "juz": 29, "page": 567, "side_trans": "Then when the Horn is blown with one blast", "words": [{"type": "word", "ar": "فَإِذَا", "tajweed": "فَإِذَا", "en": "Then when", "tr": "fa-idhā", "audio": "wbw/069_013_001.mp3"}, {"type": "word", "ar": "نُفِخَ", "tajweed": "نُفِخَ", "en": "is blown", "tr": "nufikha", "audio": "wbw/069_013_002.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/069_013_003.mp3"}, {"type": "word", "ar": "ٱلصُّورِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صُّورِ", "en": "the trumpet ", "tr": "l-ṣūri", "audio": "wbw/069_013_004.mp3"}, {"type": "word", "ar": "نَفْخَةٌۭ", "tajweed": "نَفۡخَ<rule class=idgham_ghunnah>ةٌ</rule>", "en": "a blast", "tr": "nafkhatun", "audio": "wbw/069_013_005.mp3"}, {"type": "word", "ar": "وَٰحِدَةٌۭ", "tajweed": "<rule class=idgham_ghunnah>و</rule><rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>حِدَةٌ", "en": "single", "tr": "wāḥidatun", "audio": "wbw/069_013_006.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "69:14", "juz": 29, "page": 567, "side_trans": "And the earth and the mountains are lifted and leveled with one blow [i.e., stroke] -", "words": [{"type": "word", "ar": "وَحُمِلَتِ", "tajweed": "وَحُمِلَتِ", "en": "And are lifted", "tr": "waḥumilati", "audio": "wbw/069_014_001.mp3"}, {"type": "word", "ar": "ٱلْأَرْضُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضُ", "en": "the earth", "tr": "l-arḍu", "audio": "wbw/069_014_002.mp3"}, {"type": "word", "ar": "وَٱلْجِبَالُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡجِبَالُ", "en": "and the mountains", "tr": "wal-jibālu", "audio": "wbw/069_014_003.mp3"}, {"type": "word", "ar": "فَدُكَّتَا", "tajweed": "فَدُكَّتَا", "en": "and crushed", "tr": "fadukkatā", "audio": "wbw/069_014_004.mp3"}, {"type": "word", "ar": "دَكَّةًۭ", "tajweed": "دَكَّ<rule class=idgham_ghunnah>ةً</rule>", "en": "(with) a crushing", "tr": "dakkatan", "audio": "wbw/069_014_005.mp3"}, {"type": "word", "ar": "وَٰحِدَةًۭ", "tajweed": "<rule class=idgham_ghunnah>و</rule><rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>حِدَةً", "en": "single", "tr": "wāḥidatan", "audio": "wbw/069_014_006.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "69:15", "juz": 29, "page": 567, "side_trans": "Then on that Day, the Occurrence [i.e., Resurrection] will occur,", "words": [{"type": "word", "ar": "فَيَوْمَئِذٍۢ", "tajweed": "فَيَوۡمَئِ<rule class=idgham_ghunnah>ذٍ</rule>", "en": "Then (on) that Day", "tr": "fayawma-idhin", "audio": "wbw/069_015_001.mp3"}, {"type": "word", "ar": "وَقَعَتِ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َقَعَتِ", "en": "will occur", "tr": "waqaʿati", "audio": "wbw/069_015_002.mp3"}, {"type": "word", "ar": "ٱلْوَاقِعَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡوَاقِعَةُ", "en": "the Occurrence", "tr": "l-wāqiʿatu", "audio": "wbw/069_015_003.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "69:16", "juz": 29, "page": 567, "side_trans": "And the heaven will split [open], for that Day it is infirm.", "words": [{"type": "word", "ar": "وَٱنشَقَّتِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=ikhafa>نش</rule>َقَّتِ", "en": "And will split", "tr": "wa-inshaqqati", "audio": "wbw/069_016_001.mp3"}, {"type": "word", "ar": "ٱلسَّمَآءُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ", "en": "the heaven", "tr": "l-samāu", "audio": "wbw/069_016_002.mp3"}, {"type": "word", "ar": "فَهِىَ", "tajweed": "فَهِىَ", "en": "so it", "tr": "fahiya", "audio": "wbw/069_016_003.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "يَوۡمَئِ<rule class=idgham_ghunnah>ذٍ</rule>", "en": "(is on) that Day", "tr": "yawma-idhin", "audio": "wbw/069_016_004.mp3"}, {"type": "word", "ar": "وَاهِيَةٌۭ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َاهِيَةٌ", "en": "frail", "tr": "wāhiyatun", "audio": "wbw/069_016_005.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "69:17", "juz": 29, "page": 567, "side_trans": "And the angels are at its edges. And there will bear the Throne of your Lord above them, that Day, eight [of them].", "words": [{"type": "word", "ar": "وَٱلْمَلَكُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمَلَكُ", "en": "And the Angels", "tr": "wal-malaku", "audio": "wbw/069_017_001.mp3"}, {"type": "word", "ar": "عَلَىٰٓ", "tajweed": "عَلَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "(will be) on", "tr": "ʿalā", "audio": "wbw/069_017_002.mp3"}, {"type": "word", "ar": "أَرْجَآئِهَا ۚ", "tajweed": "أَرۡج<rule class=madda_obligatory_mottasel>َا</rule>ٓئِهَا‌ۚ", "en": "its edges", "tr": "arjāihā", "audio": "wbw/069_017_003.mp3"}, {"type": "word", "ar": "وَيَحْمِلُ", "tajweed": "وَيَحۡمِلُ", "en": "and will bear", "tr": "wayaḥmilu", "audio": "wbw/069_017_005.mp3"}, {"type": "word", "ar": "عَرْشَ", "tajweed": "عَرۡشَ", "en": "(the) Throne", "tr": "ʿarsha", "audio": "wbw/069_017_006.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "(of) your Lord", "tr": "rabbika", "audio": "wbw/069_017_007.mp3"}, {"type": "word", "ar": "فَوْقَهُمْ", "tajweed": "فَوۡقَهُمۡ", "en": "above them", "tr": "fawqahum", "audio": "wbw/069_017_008.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "يَوۡمَئِ<rule class=ikhafa>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/069_017_009.mp3"}, {"type": "word", "ar": "ثَمَـٰنِيَةٌۭ", "tajweed": "<rule class=ikhafa>ث</rule>َمَ<rule class=madda_normal>ـٰ</rule>نِيَةٌ", "en": "eight", "tr": "thamāniyatun", "audio": "wbw/069_017_010.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "69:18", "juz": 29, "page": 567, "side_trans": "That Day, you will be exhibited [for judgement]; not hidden among you is anything concealed.", "words": [{"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "يَوۡمَئِ<rule class=ikhafa>ذٍ</rule>", "en": "That Day", "tr": "yawma-idhin", "audio": "wbw/069_018_001.mp3"}, {"type": "word", "ar": "تُعْرَضُونَ", "tajweed": "<rule class=ikhafa>ت</rule>ُعۡرَضُونَ", "en": "you will be exhibited", "tr": "tuʿ'raḍūna", "audio": "wbw/069_018_002.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/069_018_003.mp3"}, {"type": "word", "ar": "تَخْفَىٰ", "tajweed": "تَخۡفَىٰ", "en": "will be hidden", "tr": "takhfā", "audio": "wbw/069_018_004.mp3"}, {"type": "word", "ar": "مِنكُمْ", "tajweed": "مِ<rule class=ikhafa>نك</rule>ُمۡ", "en": "among you", "tr": "minkum", "audio": "wbw/069_018_005.mp3"}, {"type": "word", "ar": "خَافِيَةٌۭ", "tajweed": "خَافِيَةٌ", "en": "any secret", "tr": "khāfiyatun", "audio": "wbw/069_018_006.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "69:19", "juz": 29, "page": 567, "side_trans": "So as for he who is given his record in his right hand, he will say, \"Here, read my record!", "words": [{"type": "word", "ar": "فَأَمَّا", "tajweed": "فَأَ<rule class=ghunnah>مّ</rule>َا", "en": "Then as for", "tr": "fa-ammā", "audio": "wbw/069_019_001.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "(him) who", "tr": "man", "audio": "wbw/069_019_002.mp3"}, {"type": "word", "ar": "أُوتِىَ", "tajweed": "أُوتِىَ", "en": "is given", "tr": "ūtiya", "audio": "wbw/069_019_003.mp3"}, {"type": "word", "ar": "كِتَـٰبَهُۥ", "tajweed": "كِتَ<rule class=madda_normal>ـٰ</rule>بَهُ<rule class=madda_normal>ۥ</rule>", "en": "his record", "tr": "kitābahu", "audio": "wbw/069_019_004.mp3"}, {"type": "word", "ar": "بِيَمِينِهِۦ", "tajweed": "بِيَمِينِه<rule class=madda_normal>ِۦ</rule>", "en": "in his right hand", "tr": "biyamīnihi", "audio": "wbw/069_019_005.mp3"}, {"type": "word", "ar": "فَيَقُولُ", "tajweed": "فَيَقُولُ", "en": "will say", "tr": "fayaqūlu", "audio": "wbw/069_019_006.mp3"}, {"type": "word", "ar": "هَآؤُمُ", "tajweed": "ه<rule class=madda_obligatory_mottasel>َا</rule>ٓؤُمُ", "en": "Here", "tr": "hāumu", "audio": "wbw/069_019_007.mp3"}, {"type": "word", "ar": "ٱقْرَءُوا۟", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>قۡ</rule>رَءُو<rule class=slnt>اۡ</rule>", "en": "read", "tr": "iq'raū", "audio": "wbw/069_019_008.mp3"}, {"type": "word", "ar": "كِتَـٰبِيَهْ", "tajweed": "كِتَ<rule class=madda_normal>ـٰ</rule>بِيَهۡ", "en": "my record", "tr": "kitābiyah", "audio": "wbw/069_019_009.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "69:20", "juz": 29, "page": 567, "side_trans": "Indeed, I was certain that I would be meeting my account.\"", "words": [{"type": "word", "ar": "إِنِّى", "tajweed": "إِ<rule class=ghunnah>نّ</rule>ِى", "en": "Indeed, I", "tr": "innī", "audio": "wbw/069_020_001.mp3"}, {"type": "word", "ar": "ظَنَنتُ", "tajweed": "ظَنَ<rule class=ikhafa>نت</rule>ُ", "en": "was certain", "tr": "ẓanantu", "audio": "wbw/069_020_002.mp3"}, {"type": "word", "ar": "أَنِّى", "tajweed": "أَ<rule class=ghunnah>نّ</rule>ِى", "en": "that I", "tr": "annī", "audio": "wbw/069_020_003.mp3"}, {"type": "word", "ar": "مُلَـٰقٍ", "tajweed": "مُلَ<rule class=madda_normal>ـٰ</rule>قٍ", "en": "(will) meet", "tr": "mulāqin", "audio": "wbw/069_020_004.mp3"}, {"type": "word", "ar": "حِسَابِيَهْ", "tajweed": "حِسَابِيَهۡ", "en": "my account", "tr": "ḥisābiyah", "audio": "wbw/069_020_005.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "69:21", "juz": 29, "page": 567, "side_trans": "So he will be in a pleasant life -", "words": [{"type": "word", "ar": "فَهُوَ", "tajweed": "فَهُوَ", "en": "So he", "tr": "fahuwa", "audio": "wbw/069_021_001.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(will be) in", "tr": "fī", "audio": "wbw/069_021_002.mp3"}, {"type": "word", "ar": "عِيشَةٍۢ", "tajweed": "عِيشَ<rule class=idgham_wo_ghunnah>ةٍ</rule>", "en": "a life", "tr": "ʿīshatin", "audio": "wbw/069_021_003.mp3"}, {"type": "word", "ar": "رَّاضِيَةٍۢ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّاضِيَةٍ", "en": "pleasant", "tr": "rāḍiyatin", "audio": "wbw/069_021_004.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "69:22", "juz": 29, "page": 567, "side_trans": "In an elevated garden,", "words": [{"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "In", "tr": "fī", "audio": "wbw/069_022_001.mp3"}, {"type": "word", "ar": "جَنَّةٍ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َةٍ", "en": "a Garden", "tr": "jannatin", "audio": "wbw/069_022_002.mp3"}, {"type": "word", "ar": "عَالِيَةٍۢ", "tajweed": "عَالِيَةٍ", "en": "elevated", "tr": "ʿāliyatin", "audio": "wbw/069_022_003.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "69:23", "juz": 29, "page": 567, "side_trans": "Its [fruit] to be picked hanging near.", "words": [{"type": "word", "ar": "قُطُوفُهَا", "tajweed": "قُطُوفُهَا", "en": "Its clusters of fruits", "tr": "quṭūfuhā", "audio": "wbw/069_023_001.mp3"}, {"type": "word", "ar": "دَانِيَةٌۭ", "tajweed": "دَانِيَةٌ", "en": "hanging near", "tr": "dāniyatun", "audio": "wbw/069_023_002.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "69:24", "juz": 29, "page": 567, "side_trans": "[They will be told], \"Eat and drink in satisfaction for what you put forth in the days past.\"", "words": [{"type": "word", "ar": "كُلُوا۟", "tajweed": "كُلُو<rule class=slnt>اۡ</rule>", "en": "Eat", "tr": "kulū", "audio": "wbw/069_024_001.mp3"}, {"type": "word", "ar": "وَٱشْرَبُوا۟", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>شۡرَبُو<rule class=slnt>اۡ</rule>", "en": "and drink", "tr": "wa-ish'rabū", "audio": "wbw/069_024_002.mp3"}, {"type": "word", "ar": "هَنِيٓـًٔۢا", "tajweed": "هَنِ<rule class=madda_obligatory_mottasel>يٓـ</rule>ـ<rule class=iqlab>ـَٔۢا</rule>", "en": "(in) satisfaction", "tr": "hanīan", "audio": "wbw/069_024_003.mp3"}, {"type": "word", "ar": "بِمَآ", "tajweed": "<rule class=iqlab>ب</rule>ِم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "for what", "tr": "bimā", "audio": "wbw/069_024_004.mp3"}, {"type": "word", "ar": "أَسْلَفْتُمْ", "tajweed": "أَسۡلَفۡتُمۡ", "en": "you sent before you", "tr": "aslaftum", "audio": "wbw/069_024_005.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/069_024_006.mp3"}, {"type": "word", "ar": "ٱلْأَيَّامِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَيَّامِ", "en": "the days", "tr": "l-ayāmi", "audio": "wbw/069_024_007.mp3"}, {"type": "word", "ar": "ٱلْخَالِيَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡخَالِيَةِ", "en": "past", "tr": "l-khāliyati", "audio": "wbw/069_024_008.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "69:25", "juz": 29, "page": 567, "side_trans": "But as for he who is given his record in his left hand, he will say, \"Oh, I wish I had not been given my record", "words": [{"type": "word", "ar": "وَأَمَّا", "tajweed": "وَأَ<rule class=ghunnah>مّ</rule>َا", "en": "But as for", "tr": "wa-ammā", "audio": "wbw/069_025_001.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "(him) who", "tr": "man", "audio": "wbw/069_025_002.mp3"}, {"type": "word", "ar": "أُوتِىَ", "tajweed": "أُوتِىَ", "en": "is given", "tr": "ūtiya", "audio": "wbw/069_025_003.mp3"}, {"type": "word", "ar": "كِتَـٰبَهُۥ", "tajweed": "كِتَ<rule class=madda_normal>ـٰ</rule>بَهُ<rule class=madda_normal>ۥ</rule>", "en": "his record", "tr": "kitābahu", "audio": "wbw/069_025_004.mp3"}, {"type": "word", "ar": "بِشِمَالِهِۦ", "tajweed": "بِشِمَالِه<rule class=madda_normal>ِۦ</rule>", "en": "in his left hand", "tr": "bishimālihi", "audio": "wbw/069_025_005.mp3"}, {"type": "word", "ar": "فَيَقُولُ", "tajweed": "فَيَقُولُ", "en": "will say", "tr": "fayaqūlu", "audio": "wbw/069_025_006.mp3"}, {"type": "word", "ar": "يَـٰلَيْتَنِى", "tajweed": "يَ<rule class=madda_normal>ـٰ</rule>لَيۡتَنِى", "en": "O! I wish", "tr": "yālaytanī", "audio": "wbw/069_025_007.mp3"}, {"type": "word", "ar": "لَمْ", "tajweed": "لَمۡ", "en": "not", "tr": "lam", "audio": "wbw/069_025_008.mp3"}, {"type": "word", "ar": "أُوتَ", "tajweed": "أُوتَ", "en": "I had been given", "tr": "ūta", "audio": "wbw/069_025_009.mp3"}, {"type": "word", "ar": "كِتَـٰبِيَهْ", "tajweed": "كِتَ<rule class=madda_normal>ـٰ</rule>بِيَهۡ", "en": "my record", "tr": "kitābiyah", "audio": "wbw/069_025_010.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "69:26", "juz": 29, "page": 567, "side_trans": "And had not known what is my account.", "words": [{"type": "word", "ar": "وَلَمْ", "tajweed": "وَلَمۡ", "en": "And not", "tr": "walam", "audio": "wbw/069_026_001.mp3"}, {"type": "word", "ar": "أَدْرِ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رِ", "en": "I had known", "tr": "adri", "audio": "wbw/069_026_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/069_026_003.mp3"}, {"type": "word", "ar": "حِسَابِيَهْ", "tajweed": "حِسَابِيَهۡ", "en": "(is) my account", "tr": "ḥisābiyah", "audio": "wbw/069_026_004.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "69:27", "juz": 29, "page": 567, "side_trans": "I wish it [i.e., my death] had been the decisive one.", "words": [{"type": "word", "ar": "يَـٰلَيْتَهَا", "tajweed": "يَ<rule class=madda_normal>ـٰ</rule>لَيۡتَهَا", "en": "O! I wish it", "tr": "yālaytahā", "audio": "wbw/069_027_001.mp3"}, {"type": "word", "ar": "كَانَتِ", "tajweed": "كَانَتِ", "en": "had been", "tr": "kānati", "audio": "wbw/069_027_002.mp3"}, {"type": "word", "ar": "ٱلْقَاضِيَةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَاضِيَةَ", "en": "the end", "tr": "l-qāḍiyata", "audio": "wbw/069_027_003.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "69:28", "juz": 29, "page": 567, "side_trans": "My wealth has not availed me.", "words": [{"type": "word", "ar": "مَآ", "tajweed": "م<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Not", "tr": "mā", "audio": "wbw/069_028_001.mp3"}, {"type": "word", "ar": "أَغْنَىٰ", "tajweed": "أَغۡنَىٰ", "en": "has availed", "tr": "aghnā", "audio": "wbw/069_028_002.mp3"}, {"type": "word", "ar": "عَنِّى", "tajweed": "عَ<rule class=ghunnah>نّ</rule>ِى", "en": "me", "tr": "ʿannī", "audio": "wbw/069_028_003.mp3"}, {"type": "word", "ar": "مَالِيَهْ ۜ", "tajweed": "مَالِيَهۡۜ", "en": "my wealth", "tr": "māliyah", "audio": "wbw/069_028_004.mp3"}, {"type": "end", "num": "٢٨"}]}, {"id": 29, "key": "69:29", "juz": 29, "page": 567, "side_trans": "Gone from me is my authority.\"", "words": [{"type": "word", "ar": "هَلَكَ", "tajweed": "هَلَكَ", "en": "Is gone", "tr": "halaka", "audio": "wbw/069_029_001.mp3"}, {"type": "word", "ar": "عَنِّى", "tajweed": "عَ<rule class=ghunnah>نّ</rule>ِى", "en": "from me", "tr": "ʿannī", "audio": "wbw/069_029_002.mp3"}, {"type": "word", "ar": "سُلْطَـٰنِيَهْ", "tajweed": "سُلۡطَ<rule class=madda_normal>ـٰ</rule>نِيَهۡ", "en": "my authority", "tr": "sul'ṭāniyah", "audio": "wbw/069_029_003.mp3"}, {"type": "end", "num": "٢٩"}]}, {"id": 30, "key": "69:30", "juz": 29, "page": 567, "side_trans": "[Allāh will say], \"Seize him and shackle him.", "words": [{"type": "word", "ar": "خُذُوهُ", "tajweed": "خُذُوهُ", "en": "Seize him", "tr": "khudhūhu", "audio": "wbw/069_030_001.mp3"}, {"type": "word", "ar": "فَغُلُّوهُ", "tajweed": "فَغُلّ<rule class=madda_permissible>ُو</rule>هُ", "en": "and shackle him", "tr": "faghullūhu", "audio": "wbw/069_030_002.mp3"}, {"type": "end", "num": "٣٠"}]}, {"id": 31, "key": "69:31", "juz": 29, "page": 567, "side_trans": "Then into Hellfire drive him.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/069_031_001.mp3"}, {"type": "word", "ar": "ٱلْجَحِيمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجَحِيمَ", "en": "(into) the Hellfire", "tr": "l-jaḥīma", "audio": "wbw/069_031_002.mp3"}, {"type": "word", "ar": "صَلُّوهُ", "tajweed": "صَلّ<rule class=madda_permissible>ُو</rule>هُ", "en": "burn him", "tr": "ṣallūhu", "audio": "wbw/069_031_003.mp3"}, {"type": "end", "num": "٣١"}]}, {"id": 32, "key": "69:32", "juz": 29, "page": 567, "side_trans": "Then into a chain whose length is seventy cubits insert him.\"", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/069_032_001.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "into", "tr": "fī", "audio": "wbw/069_032_002.mp3"}, {"type": "word", "ar": "سِلْسِلَةٍۢ", "tajweed": "سِلۡسِلَ<rule class=ikhafa>ةٍ</rule>", "en": "a chain", "tr": "sil'silatin", "audio": "wbw/069_032_003.mp3"}, {"type": "word", "ar": "ذَرْعُهَا", "tajweed": "<rule class=ikhafa>ذ</rule>َرۡعُهَا", "en": "its length", "tr": "dharʿuhā", "audio": "wbw/069_032_004.mp3"}, {"type": "word", "ar": "سَبْعُونَ", "tajweed": "سَ<rule class=qalaqah>بۡ</rule>عُونَ", "en": "(is) seventy", "tr": "sabʿūna", "audio": "wbw/069_032_005.mp3"}, {"type": "word", "ar": "ذِرَاعًۭا", "tajweed": "ذِرَا<rule class=ikhafa>عًا</rule>", "en": "cubits", "tr": "dhirāʿan", "audio": "wbw/069_032_006.mp3"}, {"type": "word", "ar": "فَٱسْلُكُوهُ", "tajweed": "<rule class=ikhafa>ف</rule>َ<rule class=ham_wasl>ٱ</rule>سۡلُك<rule class=madda_permissible>ُو</rule>هُ", "en": "insert him", "tr": "fa-us'lukūhu", "audio": "wbw/069_032_007.mp3"}, {"type": "end", "num": "٣٢"}]}, {"id": 33, "key": "69:33", "juz": 29, "page": 567, "side_trans": "Indeed, he did not used to believe in Allāh, the Most Great,", "words": [{"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, he", "tr": "innahu", "audio": "wbw/069_033_001.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "was", "tr": "kāna", "audio": "wbw/069_033_002.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/069_033_003.mp3"}, {"type": "word", "ar": "يُؤْمِنُ", "tajweed": "يُؤۡمِنُ", "en": "believing", "tr": "yu'minu", "audio": "wbw/069_033_004.mp3"}, {"type": "word", "ar": "بِٱللَّهِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "in Allah", "tr": "bil-lahi", "audio": "wbw/069_033_005.mp3"}, {"type": "word", "ar": "ٱلْعَظِيمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَظ<rule class=madda_permissible>ِي</rule>مِ", "en": "the Most Great", "tr": "l-ʿaẓīmi", "audio": "wbw/069_033_006.mp3"}, {"type": "end", "num": "٣٣"}]}, {"id": 34, "key": "69:34", "juz": 29, "page": 567, "side_trans": "Nor did he encourage the feeding of the poor.", "words": [{"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "And (did) not", "tr": "walā", "audio": "wbw/069_034_001.mp3"}, {"type": "word", "ar": "يَحُضُّ", "tajweed": "يَحُضُّ", "en": "feel the urge", "tr": "yaḥuḍḍu", "audio": "wbw/069_034_002.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "on", "tr": "ʿalā", "audio": "wbw/069_034_003.mp3"}, {"type": "word", "ar": "طَعَامِ", "tajweed": "طَعَامِ", "en": "(the) feeding", "tr": "ṭaʿāmi", "audio": "wbw/069_034_004.mp3"}, {"type": "word", "ar": "ٱلْمِسْكِينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمِسۡك<rule class=madda_permissible>ِي</rule>نِ", "en": "(of) the poor", "tr": "l-mis'kīni", "audio": "wbw/069_034_005.mp3"}, {"type": "end", "num": "٣٤"}]}, {"id": 35, "key": "69:35", "juz": 29, "page": 567, "side_trans": "So there is not for him here this Day any devoted friend", "words": [{"type": "word", "ar": "فَلَيْسَ", "tajweed": "فَلَيۡسَ", "en": "So not", "tr": "falaysa", "audio": "wbw/069_035_001.mp3"}, {"type": "word", "ar": "لَهُ", "tajweed": "لَهُ", "en": "for him", "tr": "lahu", "audio": "wbw/069_035_002.mp3"}, {"type": "word", "ar": "ٱلْيَوْمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَوۡمَ", "en": "today", "tr": "l-yawma", "audio": "wbw/069_035_003.mp3"}, {"type": "word", "ar": "هَـٰهُنَا", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>هُنَا", "en": "here", "tr": "hāhunā", "audio": "wbw/069_035_004.mp3"}, {"type": "word", "ar": "حَمِيمٌۭ", "tajweed": "حَم<rule class=madda_permissible>ِي</rule>مٌ", "en": "any devoted friend", "tr": "ḥamīmun", "audio": "wbw/069_035_005.mp3"}, {"type": "end", "num": "٣٥"}]}, {"id": 36, "key": "69:36", "juz": 29, "page": 568, "side_trans": "Nor any food except from the discharge of wounds;", "words": [{"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "And not", "tr": "walā", "audio": "wbw/069_036_001.mp3"}, {"type": "word", "ar": "طَعَامٌ", "tajweed": "طَعَامٌ", "en": "any food", "tr": "ṭaʿāmun", "audio": "wbw/069_036_002.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/069_036_003.mp3"}, {"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "from", "tr": "min", "audio": "wbw/069_036_004.mp3"}, {"type": "word", "ar": "غِسْلِينٍۢ", "tajweed": "غِسۡل<rule class=madda_permissible>ِي</rule>نٍ", "en": "(the) discharge of wounds", "tr": "ghis'līnin", "audio": "wbw/069_036_005.mp3"}, {"type": "end", "num": "٣٦"}]}, {"id": 37, "key": "69:37", "juz": 29, "page": 568, "side_trans": "None will eat it except the sinners.", "words": [{"type": "word", "ar": "لَّا", "tajweed": "لَّا", "en": "Not", "tr": "lā", "audio": "wbw/069_037_001.mp3"}, {"type": "word", "ar": "يَأْكُلُهُۥٓ", "tajweed": "يَأۡكُلُهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "will eat it", "tr": "yakuluhu", "audio": "wbw/069_037_002.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/069_037_003.mp3"}, {"type": "word", "ar": "ٱلْخَـٰطِـُٔونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡخَ<rule class=madda_normal>ـٰ</rule>طِــٔ<rule class=madda_permissible>ُو</rule>نَ", "en": "the sinners", "tr": "l-khāṭiūna", "audio": "wbw/069_037_004.mp3"}, {"type": "end", "num": "٣٧"}]}, {"id": 38, "key": "69:38", "juz": 29, "page": 568, "side_trans": "So I swear by what you see", "words": [{"type": "word", "ar": "فَلَآ", "tajweed": "فَل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "But nay", "tr": "falā", "audio": "wbw/069_038_001.mp3"}, {"type": "word", "ar": "أُقْسِمُ", "tajweed": "أُ<rule class=qalaqah>قۡ</rule>سِمُ", "en": "I swear", "tr": "uq'simu", "audio": "wbw/069_038_002.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "بِمَا", "en": "by what", "tr": "bimā", "audio": "wbw/069_038_003.mp3"}, {"type": "word", "ar": "تُبْصِرُونَ", "tajweed": "تُ<rule class=qalaqah>بۡ</rule>صِر<rule class=madda_permissible>ُو</rule>نَ", "en": "you see", "tr": "tub'ṣirūna", "audio": "wbw/069_038_004.mp3"}, {"type": "end", "num": "٣٨"}]}, {"id": 39, "key": "69:39", "juz": 29, "page": 568, "side_trans": "And what you do not see", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And what", "tr": "wamā", "audio": "wbw/069_039_001.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/069_039_002.mp3"}, {"type": "word", "ar": "تُبْصِرُونَ", "tajweed": "تُ<rule class=qalaqah>بۡ</rule>صِر<rule class=madda_permissible>ُو</rule>نَ", "en": "you see", "tr": "tub'ṣirūna", "audio": "wbw/069_039_003.mp3"}, {"type": "end", "num": "٣٩"}]}, {"id": 40, "key": "69:40", "juz": 29, "page": 568, "side_trans": "[That] indeed, it [i.e., the Qur’ān] is the word of a noble Messenger.", "words": [{"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, it (is)", "tr": "innahu", "audio": "wbw/069_040_001.mp3"}, {"type": "word", "ar": "لَقَوْلُ", "tajweed": "لَقَوۡلُ", "en": "surely (the) Word", "tr": "laqawlu", "audio": "wbw/069_040_002.mp3"}, {"type": "word", "ar": "رَسُولٍۢ", "tajweed": "رَسُو<rule class=ikhafa>لٍ</rule>", "en": "(of) a Messenger", "tr": "rasūlin", "audio": "wbw/069_040_003.mp3"}, {"type": "word", "ar": "كَرِيمٍۢ", "tajweed": "<rule class=ikhafa>ك</rule>َر<rule class=madda_permissible>ِي</rule>مٍ", "en": "noble", "tr": "karīmin", "audio": "wbw/069_040_004.mp3"}, {"type": "end", "num": "٤٠"}]}, {"id": 41, "key": "69:41", "juz": 29, "page": 568, "side_trans": "And it is not the word of a poet; little do you believe.", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/069_041_001.mp3"}, {"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "it", "tr": "huwa", "audio": "wbw/069_041_002.mp3"}, {"type": "word", "ar": "بِقَوْلِ", "tajweed": "بِقَوۡلِ", "en": "(is the) word", "tr": "biqawli", "audio": "wbw/069_041_003.mp3"}, {"type": "word", "ar": "شَاعِرٍۢ ۚ", "tajweed": "شَاعِ<rule class=ikhafa>رٍ‌ۚ</rule>", "en": "(of) a poet", "tr": "shāʿirin", "audio": "wbw/069_041_004.mp3"}, {"type": "word", "ar": "قَلِيلًۭا", "tajweed": "<rule class=ikhafa>ق</rule>َلِيل<rule class=idgham_ghunnah>اً</rule>", "en": "little", "tr": "qalīlan", "audio": "wbw/069_041_006.mp3"}, {"type": "word", "ar": "مَّا", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّا", "en": "(is) what", "tr": "mā", "audio": "wbw/069_041_007.mp3"}, {"type": "word", "ar": "تُؤْمِنُونَ", "tajweed": "تُؤۡمِن<rule class=madda_permissible>ُو</rule>نَ", "en": "you believe", "tr": "tu'minūna", "audio": "wbw/069_041_008.mp3"}, {"type": "end", "num": "٤١"}]}, {"id": 42, "key": "69:42", "juz": 29, "page": 568, "side_trans": "Nor the word of a soothsayer; little do you remember.", "words": [{"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "And not", "tr": "walā", "audio": "wbw/069_042_001.mp3"}, {"type": "word", "ar": "بِقَوْلِ", "tajweed": "بِقَوۡلِ", "en": "(it is the) word", "tr": "biqawli", "audio": "wbw/069_042_002.mp3"}, {"type": "word", "ar": "كَاهِنٍۢ ۚ", "tajweed": "كَاهِ<rule class=ikhafa>نٍ‌ۚ</rule>", "en": "(of) a soothsayer", "tr": "kāhinin", "audio": "wbw/069_042_003.mp3"}, {"type": "word", "ar": "قَلِيلًۭا", "tajweed": "<rule class=ikhafa>ق</rule>َلِيل<rule class=idgham_ghunnah>اً</rule>", "en": "little", "tr": "qalīlan", "audio": "wbw/069_042_005.mp3"}, {"type": "word", "ar": "مَّا", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّا", "en": "(is) what", "tr": "mā", "audio": "wbw/069_042_006.mp3"}, {"type": "word", "ar": "تَذَكَّرُونَ", "tajweed": "تَذَكَّر<rule class=madda_permissible>ُو</rule>نَ", "en": "you take heed", "tr": "tadhakkarūna", "audio": "wbw/069_042_007.mp3"}, {"type": "end", "num": "٤٢"}]}, {"id": 43, "key": "69:43", "juz": 29, "page": 568, "side_trans": "[It is] a revelation from the Lord of the worlds.", "words": [{"type": "word", "ar": "تَنزِيلٌۭ", "tajweed": "تَ<rule class=ikhafa>نز</rule>ِي<rule class=idgham_ghunnah>لٌ</rule>", "en": "(It is) a revelation", "tr": "tanzīlun", "audio": "wbw/069_043_001.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_ghunnah>م</rule>ّ<rule class=idgham_wo_ghunnah>ِن</rule>", "en": "from", "tr": "min", "audio": "wbw/069_043_002.mp3"}, {"type": "word", "ar": "رَّبِّ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّبِّ", "en": "(the) Lord", "tr": "rabbi", "audio": "wbw/069_043_003.mp3"}, {"type": "word", "ar": "ٱلْعَـٰلَمِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَ<rule class=madda_normal>ـٰ</rule>لَم<rule class=madda_permissible>ِي</rule>نَ", "en": "(of) the worlds", "tr": "l-ʿālamīna", "audio": "wbw/069_043_004.mp3"}, {"type": "end", "num": "٤٣"}]}, {"id": 44, "key": "69:44", "juz": 29, "page": 568, "side_trans": "And if he [i.e., Muḥammad] had made up about Us some [false] sayings,", "words": [{"type": "word", "ar": "وَلَوْ", "tajweed": "وَلَوۡ", "en": "And if", "tr": "walaw", "audio": "wbw/069_044_001.mp3"}, {"type": "word", "ar": "تَقَوَّلَ", "tajweed": "تَقَوَّلَ", "en": "he (had) fabricated", "tr": "taqawwala", "audio": "wbw/069_044_002.mp3"}, {"type": "word", "ar": "عَلَيْنَا", "tajweed": "عَلَيۡنَا", "en": "against Us", "tr": "ʿalaynā", "audio": "wbw/069_044_003.mp3"}, {"type": "word", "ar": "بَعْضَ", "tajweed": "بَعۡضَ", "en": "some", "tr": "baʿḍa", "audio": "wbw/069_044_004.mp3"}, {"type": "word", "ar": "ٱلْأَقَاوِيلِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَقَاو<rule class=madda_permissible>ِي</rule>لِ", "en": "sayings", "tr": "l-aqāwīli", "audio": "wbw/069_044_005.mp3"}, {"type": "end", "num": "٤٤"}]}, {"id": 45, "key": "69:45", "juz": 29, "page": 568, "side_trans": "We would have seized him by the right hand;", "words": [{"type": "word", "ar": "لَأَخَذْنَا", "tajweed": "لَأَخَذۡنَا", "en": "Certainly We (would) have seized", "tr": "la-akhadhnā", "audio": "wbw/069_045_001.mp3"}, {"type": "word", "ar": "مِنْهُ", "tajweed": "مِنۡهُ", "en": "him", "tr": "min'hu", "audio": "wbw/069_045_002.mp3"}, {"type": "word", "ar": "بِٱلْيَمِينِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡيَم<rule class=madda_permissible>ِي</rule>نِ", "en": "by the right hand", "tr": "bil-yamīni", "audio": "wbw/069_045_003.mp3"}, {"type": "end", "num": "٤٥"}]}, {"id": 46, "key": "69:46", "juz": 29, "page": 568, "side_trans": "Then We would have cut from him the aorta.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/069_046_001.mp3"}, {"type": "word", "ar": "لَقَطَعْنَا", "tajweed": "لَقَطَعۡنَا", "en": "certainly We (would) have cut off", "tr": "laqaṭaʿnā", "audio": "wbw/069_046_002.mp3"}, {"type": "word", "ar": "مِنْهُ", "tajweed": "مِنۡهُ", "en": "from him", "tr": "min'hu", "audio": "wbw/069_046_003.mp3"}, {"type": "word", "ar": "ٱلْوَتِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡوَت<rule class=madda_permissible>ِي</rule>نَ", "en": "the aorta", "tr": "l-watīna", "audio": "wbw/069_046_004.mp3"}, {"type": "end", "num": "٤٦"}]}, {"id": 47, "key": "69:47", "juz": 29, "page": 568, "side_trans": "And there is no one of you who could prevent [Us] from him.", "words": [{"type": "word", "ar": "فَمَا", "tajweed": "فَمَا", "en": "And not", "tr": "famā", "audio": "wbw/069_047_001.mp3"}, {"type": "word", "ar": "مِنكُم", "tajweed": "مِ<rule class=ikhafa>نك</rule><rule class=idgham_shafawi>ُم</rule>", "en": "from you", "tr": "minkum", "audio": "wbw/069_047_002.mp3"}, {"type": "word", "ar": "مِّنْ", "tajweed": "<rule class=idgham_shafawi>م</rule>ِّنۡ", "en": "any", "tr": "min", "audio": "wbw/069_047_003.mp3"}, {"type": "word", "ar": "أَحَدٍ", "tajweed": "أَحَدٍ", "en": "one", "tr": "aḥadin", "audio": "wbw/069_047_004.mp3"}, {"type": "word", "ar": "عَنْهُ", "tajweed": "عَنۡهُ", "en": "[from him]", "tr": "ʿanhu", "audio": "wbw/069_047_005.mp3"}, {"type": "word", "ar": "حَـٰجِزِينَ", "tajweed": "حَ<rule class=madda_normal>ـٰ</rule>جِز<rule class=madda_permissible>ِي</rule>نَ", "en": "(who could) prevent (it)", "tr": "ḥājizīna", "audio": "wbw/069_047_006.mp3"}, {"type": "end", "num": "٤٧"}]}, {"id": 48, "key": "69:48", "juz": 29, "page": 568, "side_trans": "And indeed, it [i.e., the Qur’ān] is a reminder for the righteous.", "words": [{"type": "word", "ar": "وَإِنَّهُۥ", "tajweed": "وَإِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "And indeed, it", "tr": "wa-innahu", "audio": "wbw/069_048_001.mp3"}, {"type": "word", "ar": "لَتَذْكِرَةٌۭ", "tajweed": "لَتَذۡكِرَ<rule class=idgham_wo_ghunnah>ةٌ</rule>", "en": "(is) surely a reminder", "tr": "latadhkiratun", "audio": "wbw/069_048_002.mp3"}, {"type": "word", "ar": "لِّلْمُتَّقِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡمُتَّق<rule class=madda_permissible>ِي</rule>نَ", "en": "for the Allah-fearing", "tr": "lil'muttaqīna", "audio": "wbw/069_048_003.mp3"}, {"type": "end", "num": "٤٨"}]}, {"id": 49, "key": "69:49", "juz": 29, "page": 568, "side_trans": "And indeed, We know that among you are deniers.", "words": [{"type": "word", "ar": "وَإِنَّا", "tajweed": "وَإِ<rule class=ghunnah>نّ</rule>َا", "en": "And indeed, We", "tr": "wa-innā", "audio": "wbw/069_049_001.mp3"}, {"type": "word", "ar": "لَنَعْلَمُ", "tajweed": "لَنَعۡلَمُ", "en": "surely know", "tr": "lanaʿlamu", "audio": "wbw/069_049_002.mp3"}, {"type": "word", "ar": "أَنَّ", "tajweed": "أَ<rule class=ghunnah>نّ</rule>َ", "en": "that", "tr": "anna", "audio": "wbw/069_049_003.mp3"}, {"type": "word", "ar": "مِنكُم", "tajweed": "مِ<rule class=ikhafa>نك</rule><rule class=idgham_shafawi>ُم</rule>", "en": "among you", "tr": "minkum", "audio": "wbw/069_049_004.mp3"}, {"type": "word", "ar": "مُّكَذِّبِينَ", "tajweed": "<rule class=idgham_shafawi>م</rule>ُّكَذِّب<rule class=madda_permissible>ِي</rule>نَ", "en": "(are) deniers", "tr": "mukadhibīna", "audio": "wbw/069_049_005.mp3"}, {"type": "end", "num": "٤٩"}]}, {"id": 50, "key": "69:50", "juz": 29, "page": 568, "side_trans": "And indeed, it will be [a cause of] regret upon the disbelievers.", "words": [{"type": "word", "ar": "وَإِنَّهُۥ", "tajweed": "وَإِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "And indeed, it", "tr": "wa-innahu", "audio": "wbw/069_050_001.mp3"}, {"type": "word", "ar": "لَحَسْرَةٌ", "tajweed": "لَحَسۡرَةٌ", "en": "(is) surely a regret", "tr": "laḥasratun", "audio": "wbw/069_050_002.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "upon", "tr": "ʿalā", "audio": "wbw/069_050_003.mp3"}, {"type": "word", "ar": "ٱلْكَـٰفِرِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَ<rule class=madda_normal>ـٰ</rule>فِر<rule class=madda_permissible>ِي</rule>نَ", "en": "the disbelievers", "tr": "l-kāfirīna", "audio": "wbw/069_050_004.mp3"}, {"type": "end", "num": "٥٠"}]}, {"id": 51, "key": "69:51", "juz": 29, "page": 568, "side_trans": "And indeed, it is the truth of certainty.", "words": [{"type": "word", "ar": "وَإِنَّهُۥ", "tajweed": "وَإِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "And indeed, it (is)", "tr": "wa-innahu", "audio": "wbw/069_051_001.mp3"}, {"type": "word", "ar": "لَحَقُّ", "tajweed": "لَحَقُّ", "en": "surely (the) truth", "tr": "laḥaqqu", "audio": "wbw/069_051_002.mp3"}, {"type": "word", "ar": "ٱلْيَقِينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَق<rule class=madda_permissible>ِي</rule>نِ", "en": "(of) certainty", "tr": "l-yaqīni", "audio": "wbw/069_051_003.mp3"}, {"type": "end", "num": "٥١"}]}, {"id": 52, "key": "69:52", "juz": 29, "page": 568, "side_trans": "So exalt the name of your Lord, the Most Great.", "words": [{"type": "word", "ar": "فَسَبِّحْ", "tajweed": "فَسَبِّحۡ", "en": "So glorify", "tr": "fasabbiḥ", "audio": "wbw/069_052_001.mp3"}, {"type": "word", "ar": "بِٱسْمِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>سۡمِ", "en": "(the) name", "tr": "bi-is'mi", "audio": "wbw/069_052_002.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "(of) your Lord", "tr": "rabbika", "audio": "wbw/069_052_003.mp3"}, {"type": "word", "ar": "ٱلْعَظِيمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَظ<rule class=madda_permissible>ِي</rule>مِ", "en": "the Most Great", "tr": "l-ʿaẓīmi", "audio": "wbw/069_052_004.mp3"}, {"type": "end", "num": "٥٢"}]}]