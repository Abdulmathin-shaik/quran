[{"id": 1, "key": "81:1", "juz": 30, "page": 586, "side_trans": "When the sun is wrapped up [in darkness]", "words": [{"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/081_001_001.mp3"}, {"type": "word", "ar": "ٱلشَّمْسُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شَّمۡسُ", "en": "the sun", "tr": "l-shamsu", "audio": "wbw/081_001_002.mp3"}, {"type": "word", "ar": "كُوِّرَتْ", "tajweed": "كُوِّرَتۡ", "en": "is wrapped up", "tr": "kuwwirat", "audio": "wbw/081_001_003.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "81:2", "juz": 30, "page": 586, "side_trans": "And when the stars fall, dispersing,", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/081_002_001.mp3"}, {"type": "word", "ar": "ٱلنُّجُومُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>ُجُومُ", "en": "the stars", "tr": "l-nujūmu", "audio": "wbw/081_002_002.mp3"}, {"type": "word", "ar": "ٱنكَدَرَتْ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=ikhafa>نك</rule>َدَرَتۡ", "en": "fall, losing their luster", "tr": "inkadarat", "audio": "wbw/081_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "81:3", "juz": 30, "page": 586, "side_trans": "And when the mountains are removed", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/081_003_001.mp3"}, {"type": "word", "ar": "ٱلْجِبَالُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجِبَالُ", "en": "the mountains", "tr": "l-jibālu", "audio": "wbw/081_003_002.mp3"}, {"type": "word", "ar": "سُيِّرَتْ", "tajweed": "سُيِّرَتۡ", "en": "are moved away", "tr": "suyyirat", "audio": "wbw/081_003_003.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "81:4", "juz": 30, "page": 586, "side_trans": "And when full-term she-camels are neglected", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/081_004_001.mp3"}, {"type": "word", "ar": "ٱلْعِشَارُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعِشَارُ", "en": "the full-term she-camels", "tr": "l-ʿishāru", "audio": "wbw/081_004_002.mp3"}, {"type": "word", "ar": "عُطِّلَتْ", "tajweed": "عُطِّلَتۡ", "en": "(are) left untended", "tr": "ʿuṭṭilat", "audio": "wbw/081_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "81:5", "juz": 30, "page": 586, "side_trans": "And when the wild beasts are gathered", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/081_005_001.mp3"}, {"type": "word", "ar": "ٱلْوُحُوشُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡوُحُوشُ", "en": "the wild beasts", "tr": "l-wuḥūshu", "audio": "wbw/081_005_002.mp3"}, {"type": "word", "ar": "حُشِرَتْ", "tajweed": "حُشِرَتۡ", "en": "are gathered", "tr": "ḥushirat", "audio": "wbw/081_005_003.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "81:6", "juz": 30, "page": 586, "side_trans": "And when the seas are filled with flame", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/081_006_001.mp3"}, {"type": "word", "ar": "ٱلْبِحَارُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبِحَارُ", "en": "the seas", "tr": "l-biḥāru", "audio": "wbw/081_006_002.mp3"}, {"type": "word", "ar": "سُجِّرَتْ", "tajweed": "سُجِّرَتۡ", "en": "are made to overflow", "tr": "sujjirat", "audio": "wbw/081_006_003.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "81:7", "juz": 30, "page": 586, "side_trans": "And when the souls are paired", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/081_007_001.mp3"}, {"type": "word", "ar": "ٱلنُّفُوسُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>ُفُوسُ", "en": "the souls", "tr": "l-nufūsu", "audio": "wbw/081_007_002.mp3"}, {"type": "word", "ar": "زُوِّجَتْ", "tajweed": "زُوِّجَتۡ", "en": "are paired", "tr": "zuwwijat", "audio": "wbw/081_007_003.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "81:8", "juz": 30, "page": 586, "side_trans": "And when the girl [who was] buried alive is asked", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/081_008_001.mp3"}, {"type": "word", "ar": "ٱلْمَوْءُۥدَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَوۡءُ<rule class=madda_normal>ۥ</rule>دَةُ", "en": "the female infant buried alive", "tr": "l-mawūdatu", "audio": "wbw/081_008_002.mp3"}, {"type": "word", "ar": "سُئِلَتْ", "tajweed": "سُئِلَتۡ", "en": "is asked", "tr": "su-ilat", "audio": "wbw/081_008_003.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "81:9", "juz": 30, "page": 586, "side_trans": "For what sin she was killed", "words": [{"type": "word", "ar": "بِأَىِّ", "tajweed": "بِأَىِّ", "en": "For what", "tr": "bi-ayyi", "audio": "wbw/081_009_001.mp3"}, {"type": "word", "ar": "ذَنۢبٍۢ", "tajweed": "ذَ<rule class=iqlab>نۢب</rule><rule class=ikhafa>ٍ</rule>", "en": "sin", "tr": "dhanbin", "audio": "wbw/081_009_002.mp3"}, {"type": "word", "ar": "قُتِلَتْ", "tajweed": "<rule class=ikhafa>ق</rule>ُتِلَتۡ", "en": "she was killed", "tr": "qutilat", "audio": "wbw/081_009_003.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "81:10", "juz": 30, "page": 586, "side_trans": "And when the pages are spread [i.e., made public]", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/081_010_001.mp3"}, {"type": "word", "ar": "ٱلصُّحُفُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صُّحُفُ", "en": "the pages", "tr": "l-ṣuḥufu", "audio": "wbw/081_010_002.mp3"}, {"type": "word", "ar": "نُشِرَتْ", "tajweed": "نُشِرَتۡ", "en": "are laid open", "tr": "nushirat", "audio": "wbw/081_010_003.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "81:11", "juz": 30, "page": 586, "side_trans": "And when the sky is stripped away", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/081_011_001.mp3"}, {"type": "word", "ar": "ٱلسَّمَآءُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ", "en": "the sky", "tr": "l-samāu", "audio": "wbw/081_011_002.mp3"}, {"type": "word", "ar": "كُشِطَتْ", "tajweed": "كُشِطَتۡ", "en": "is stripped away", "tr": "kushiṭat", "audio": "wbw/081_011_003.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "81:12", "juz": 30, "page": 586, "side_trans": "And when Hellfire is set ablaze", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/081_012_001.mp3"}, {"type": "word", "ar": "ٱلْجَحِيمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجَحِيمُ", "en": "the Hellfire", "tr": "l-jaḥīmu", "audio": "wbw/081_012_002.mp3"}, {"type": "word", "ar": "سُعِّرَتْ", "tajweed": "سُعِّرَتۡ", "en": "is set ablaze", "tr": "suʿʿirat", "audio": "wbw/081_012_003.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "81:13", "juz": 30, "page": 586, "side_trans": "And when Paradise is brought near,", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/081_013_001.mp3"}, {"type": "word", "ar": "ٱلْجَنَّةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجَ<rule class=ghunnah>نّ</rule>َةُ", "en": "Paradise", "tr": "l-janatu", "audio": "wbw/081_013_002.mp3"}, {"type": "word", "ar": "أُزْلِفَتْ", "tajweed": "أُزۡلِفَتۡ", "en": "is brought near", "tr": "uz'lifat", "audio": "wbw/081_013_003.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "81:14", "juz": 30, "page": 586, "side_trans": "A soul will [then] know what it has brought [with it].", "words": [{"type": "word", "ar": "عَلِمَتْ", "tajweed": "عَلِمَتۡ", "en": "Will know", "tr": "ʿalimat", "audio": "wbw/081_014_001.mp3"}, {"type": "word", "ar": "نَفْسٌۭ", "tajweed": "نَفۡ<rule class=idgham_ghunnah>سٌ</rule>", "en": "a soul", "tr": "nafsun", "audio": "wbw/081_014_002.mp3"}, {"type": "word", "ar": "مَّآ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "what", "tr": "mā", "audio": "wbw/081_014_003.mp3"}, {"type": "word", "ar": "أَحْضَرَتْ", "tajweed": "أَحۡضَرَتۡ", "en": "it has brought", "tr": "aḥḍarat", "audio": "wbw/081_014_004.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "81:15", "juz": 30, "page": 586, "side_trans": "So I swear by the retreating stars -", "words": [{"type": "word", "ar": "فَلَآ", "tajweed": "فَل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "But nay", "tr": "falā", "audio": "wbw/081_015_001.mp3"}, {"type": "word", "ar": "أُقْسِمُ", "tajweed": "أُ<rule class=qalaqah>قۡ</rule>سِمُ", "en": "I swear", "tr": "uq'simu", "audio": "wbw/081_015_002.mp3"}, {"type": "word", "ar": "بِٱلْخُنَّسِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡخُ<rule class=ghunnah>نّ</rule>َسِ", "en": "by the retreating planets", "tr": "bil-khunasi", "audio": "wbw/081_015_003.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "81:16", "juz": 30, "page": 586, "side_trans": "Those that run [their courses] and disappear [i.e., set]", "words": [{"type": "word", "ar": "ٱلْجَوَارِ", "tajweed": "ٱلۡجَوَارِ", "en": "Those that run", "tr": "al-jawāri", "audio": "wbw/081_016_001.mp3"}, {"type": "word", "ar": "ٱلْكُنَّسِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكُ<rule class=ghunnah>نّ</rule>َسِ", "en": "(and) disappear", "tr": "l-kunasi", "audio": "wbw/081_016_002.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "81:17", "juz": 30, "page": 586, "side_trans": "And by the night as it closes in", "words": [{"type": "word", "ar": "وَٱلَّيْلِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّيۡلِ", "en": "And the night", "tr": "wa-al-layli", "audio": "wbw/081_017_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/081_017_002.mp3"}, {"type": "word", "ar": "عَسْعَسَ", "tajweed": "عَسۡعَسَ", "en": "it departs", "tr": "ʿasʿasa", "audio": "wbw/081_017_003.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "81:18", "juz": 30, "page": 586, "side_trans": "And by the dawn when it breathes [i.e., stirs]", "words": [{"type": "word", "ar": "وَٱلصُّبْحِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صُّ<rule class=qalaqah>بۡ</rule>حِ", "en": "And the dawn", "tr": "wal-ṣub'ḥi", "audio": "wbw/081_018_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/081_018_002.mp3"}, {"type": "word", "ar": "تَنَفَّسَ", "tajweed": "تَنَفَّسَ", "en": "it breathes", "tr": "tanaffasa", "audio": "wbw/081_018_003.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "81:19", "juz": 30, "page": 586, "side_trans": "[That] indeed, it [i.e., the Qur’ān] is a word [conveyed by] a noble messenger [i.e., Gabriel]", "words": [{"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, it", "tr": "innahu", "audio": "wbw/081_019_001.mp3"}, {"type": "word", "ar": "لَقَوْلُ", "tajweed": "لَقَوۡلُ", "en": "(is) surely a word", "tr": "laqawlu", "audio": "wbw/081_019_002.mp3"}, {"type": "word", "ar": "رَسُولٍۢ", "tajweed": "رَسُو<rule class=ikhafa>لٍ</rule>", "en": "(of) a Messenger", "tr": "rasūlin", "audio": "wbw/081_019_003.mp3"}, {"type": "word", "ar": "كَرِيمٍۢ", "tajweed": "<rule class=ikhafa>ك</rule>َر<rule class=madda_permissible>ِي</rule>مٍ", "en": "noble", "tr": "karīmin", "audio": "wbw/081_019_004.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "81:20", "juz": 30, "page": 586, "side_trans": "[Who is] possessed of power and with the Owner of the Throne, secure [in position],", "words": [{"type": "word", "ar": "ذِى", "tajweed": "ذِى", "en": "Possessor of", "tr": "dhī", "audio": "wbw/081_020_001.mp3"}, {"type": "word", "ar": "قُوَّةٍ", "tajweed": "قُوَّةٍ", "en": "power", "tr": "quwwatin", "audio": "wbw/081_020_002.mp3"}, {"type": "word", "ar": "عِندَ", "tajweed": "عِ<rule class=ikhafa>ند</rule>َ", "en": "with", "tr": "ʿinda", "audio": "wbw/081_020_003.mp3"}, {"type": "word", "ar": "ذِى", "tajweed": "ذِى", "en": "(the) Owner of", "tr": "dhī", "audio": "wbw/081_020_004.mp3"}, {"type": "word", "ar": "ٱلْعَرْشِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَرۡشِ", "en": "the Throne", "tr": "l-ʿarshi", "audio": "wbw/081_020_005.mp3"}, {"type": "word", "ar": "مَكِينٍۢ", "tajweed": "مَك<rule class=madda_permissible>ِي</rule>نٍ", "en": "secure", "tr": "makīnin", "audio": "wbw/081_020_006.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "81:21", "juz": 30, "page": 586, "side_trans": "Obeyed there [in the heavens] and trustworthy.", "words": [{"type": "word", "ar": "مُّطَاعٍۢ", "tajweed": "مُّطَا<rule class=ikhafa>عٍ</rule>", "en": "One to be obeyed", "tr": "muṭāʿin", "audio": "wbw/081_021_001.mp3"}, {"type": "word", "ar": "ثَمَّ", "tajweed": "<rule class=ikhafa>ث</rule>َ<rule class=ghunnah>مّ</rule>َ", "en": "and", "tr": "thamma", "audio": "wbw/081_021_002.mp3"}, {"type": "word", "ar": "أَمِينٍۢ", "tajweed": "أَم<rule class=madda_permissible>ِي</rule>نٍ", "en": "trustworthy", "tr": "amīnin", "audio": "wbw/081_021_003.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "81:22", "juz": 30, "page": 586, "side_trans": "And your companion [i.e., Prophet Muḥammad (ﷺ) ] is not [at all] mad.", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/081_022_001.mp3"}, {"type": "word", "ar": "صَاحِبُكُم", "tajweed": "صَاحِبُك<rule class=ikhafa_shafawi>ُم</rule>", "en": "(is) your companion", "tr": "ṣāḥibukum", "audio": "wbw/081_022_002.mp3"}, {"type": "word", "ar": "بِمَجْنُونٍۢ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِمَ<rule class=qalaqah>جۡ</rule>ن<rule class=madda_permissible>ُو</rule>نٍ", "en": "mad", "tr": "bimajnūnin", "audio": "wbw/081_022_003.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "81:23", "juz": 30, "page": 586, "side_trans": "And he has already seen him [i.e., Gabriel] in the clear horizon.", "words": [{"type": "word", "ar": "وَلَقَدْ", "tajweed": "وَلَقَ<rule class=qalaqah>دۡ</rule>", "en": "And certainly", "tr": "walaqad", "audio": "wbw/081_023_001.mp3"}, {"type": "word", "ar": "رَءَاهُ", "tajweed": "رَءَاهُ", "en": "he saw him", "tr": "raāhu", "audio": "wbw/081_023_002.mp3"}, {"type": "word", "ar": "بِٱلْأُفُقِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡأُفُقِ", "en": "in the horizon", "tr": "bil-ufuqi", "audio": "wbw/081_023_003.mp3"}, {"type": "word", "ar": "ٱلْمُبِينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُب<rule class=madda_permissible>ِي</rule>نِ", "en": "the clear", "tr": "l-mubīni", "audio": "wbw/081_023_004.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "81:24", "juz": 30, "page": 586, "side_trans": "And he [i.e., Muḥammad (ﷺ)] is not a withholder of [knowledge of] the unseen.", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/081_024_001.mp3"}, {"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "he (is)", "tr": "huwa", "audio": "wbw/081_024_002.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "on", "tr": "ʿalā", "audio": "wbw/081_024_003.mp3"}, {"type": "word", "ar": "ٱلْغَيْبِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡغَيۡبِ", "en": "the unseen", "tr": "l-ghaybi", "audio": "wbw/081_024_004.mp3"}, {"type": "word", "ar": "بِضَنِينٍۢ", "tajweed": "بِضَن<rule class=madda_permissible>ِي</rule>نٍ", "en": "a withholder", "tr": "biḍanīnin", "audio": "wbw/081_024_005.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "81:25", "juz": 30, "page": 586, "side_trans": "And it [i.e., the Qur’ān] is not the word of a devil, expelled [from the heavens].", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/081_025_001.mp3"}, {"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "it", "tr": "huwa", "audio": "wbw/081_025_002.mp3"}, {"type": "word", "ar": "بِقَوْلِ", "tajweed": "بِقَوۡلِ", "en": "(is the) word", "tr": "biqawli", "audio": "wbw/081_025_003.mp3"}, {"type": "word", "ar": "شَيْطَـٰنٍۢ", "tajweed": "شَيۡطَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_wo_ghunnah>نٍ</rule>", "en": "(of) Shaitaan", "tr": "shayṭānin", "audio": "wbw/081_025_004.mp3"}, {"type": "word", "ar": "رَّجِيمٍۢ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّج<rule class=madda_permissible>ِي</rule>مٍ", "en": "accursed", "tr": "rajīmin", "audio": "wbw/081_025_005.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "81:26", "juz": 30, "page": 586, "side_trans": "So where are you going?", "words": [{"type": "word", "ar": "فَأَيْنَ", "tajweed": "فَأَيۡنَ", "en": "So where", "tr": "fa-ayna", "audio": "wbw/081_026_001.mp3"}, {"type": "word", "ar": "تَذْهَبُونَ", "tajweed": "تَذۡهَب<rule class=madda_permissible>ُو</rule>نَ", "en": "are you going", "tr": "tadhhabūna", "audio": "wbw/081_026_002.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "81:27", "juz": 30, "page": 586, "side_trans": "It is not except a reminder to the worlds", "words": [{"type": "word", "ar": "إِنْ", "tajweed": "إِنۡ", "en": "Not", "tr": "in", "audio": "wbw/081_027_001.mp3"}, {"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "it", "tr": "huwa", "audio": "wbw/081_027_002.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "(is) except", "tr": "illā", "audio": "wbw/081_027_003.mp3"}, {"type": "word", "ar": "ذِكْرٌۭ", "tajweed": "ذِكۡ<rule class=idgham_wo_ghunnah>رٌ</rule>", "en": "a reminder", "tr": "dhik'run", "audio": "wbw/081_027_004.mp3"}, {"type": "word", "ar": "لِّلْعَـٰلَمِينَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلۡعَ<rule class=madda_normal>ـٰ</rule>لَم<rule class=madda_permissible>ِي</rule>نَ", "en": "to the worlds", "tr": "lil'ʿālamīna", "audio": "wbw/081_027_005.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "81:28", "juz": 30, "page": 586, "side_trans": "For whoever wills among you to take a right course.", "words": [{"type": "word", "ar": "لِمَن", "tajweed": "لِمَ<rule class=ikhafa>ن</rule>", "en": "For whoever", "tr": "liman", "audio": "wbw/081_028_001.mp3"}, {"type": "word", "ar": "شَآءَ", "tajweed": "<rule class=ikhafa>ش</rule><rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "wills", "tr": "shāa", "audio": "wbw/081_028_002.mp3"}, {"type": "word", "ar": "مِنكُمْ", "tajweed": "مِ<rule class=ikhafa>نك</rule>ُمۡ", "en": "among you", "tr": "minkum", "audio": "wbw/081_028_003.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "to", "tr": "an", "audio": "wbw/081_028_004.mp3"}, {"type": "word", "ar": "يَسْتَقِيمَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َسۡتَق<rule class=madda_permissible>ِي</rule>مَ", "en": "take a straight way", "tr": "yastaqīma", "audio": "wbw/081_028_005.mp3"}, {"type": "end", "num": "٢٨"}]}, {"id": 29, "key": "81:29", "juz": 30, "page": 586, "side_trans": "And you do not will except that Allāh wills - Lord of the worlds.", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/081_029_001.mp3"}, {"type": "word", "ar": "تَشَآءُونَ", "tajweed": "تَش<rule class=madda_obligatory_mottasel>َا</rule>ٓءُونَ", "en": "you will", "tr": "tashāūna", "audio": "wbw/081_029_002.mp3"}, {"type": "word", "ar": "إِلَّآ", "tajweed": "إِلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "except", "tr": "illā", "audio": "wbw/081_029_003.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/081_029_004.mp3"}, {"type": "word", "ar": "يَشَآءَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َش<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "wills", "tr": "yashāa", "audio": "wbw/081_029_005.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/081_029_006.mp3"}, {"type": "word", "ar": "رَبُّ", "tajweed": "رَبُّ", "en": "Lord", "tr": "rabbu", "audio": "wbw/081_029_007.mp3"}, {"type": "word", "ar": "ٱلْعَـٰلَمِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَ<rule class=madda_normal>ـٰ</rule>لَم<rule class=madda_permissible>ِي</rule>نَ", "en": "(of) the worlds", "tr": "l-ʿālamīna", "audio": "wbw/081_029_008.mp3"}, {"type": "end", "num": "٢٩"}]}]