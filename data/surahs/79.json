[{"id": 1, "key": "79:1", "juz": 30, "page": 583, "side_trans": "By those [angels] who extract with violence", "words": [{"type": "word", "ar": "وَٱلنَّـٰزِعَـٰتِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule>زِعَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "By those who extract", "tr": "wal-nāziʿāti", "audio": "wbw/079_001_001.mp3"}, {"type": "word", "ar": "غَرْقًۭا", "tajweed": "غَرۡقًا", "en": "violently", "tr": "gharqan", "audio": "wbw/079_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "79:2", "juz": 30, "page": 583, "side_trans": "And [by] those who remove with ease", "words": [{"type": "word", "ar": "وَٱلنَّـٰشِطَـٰتِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule>شِطَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "And those who draw out", "tr": "wal-nāshiṭāti", "audio": "wbw/079_002_001.mp3"}, {"type": "word", "ar": "نَشْطًۭا", "tajweed": "نَشۡطًا", "en": "gently", "tr": "nashṭan", "audio": "wbw/079_002_002.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "79:3", "juz": 30, "page": 583, "side_trans": "And [by] those who glide [as if] swimming", "words": [{"type": "word", "ar": "وَٱلسَّـٰبِحَـٰتِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّ<rule class=madda_normal>ـٰ</rule>بِحَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "And those who glide", "tr": "wal-sābiḥāti", "audio": "wbw/079_003_001.mp3"}, {"type": "word", "ar": "سَبْحًۭا", "tajweed": "سَ<rule class=qalaqah>بۡ</rule>حًا", "en": "swimming", "tr": "sabḥan", "audio": "wbw/079_003_002.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "79:4", "juz": 30, "page": 583, "side_trans": "And those who race each other in a race", "words": [{"type": "word", "ar": "فَٱلسَّـٰبِقَـٰتِ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّ<rule class=madda_normal>ـٰ</rule>بِقَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "And those who race each other", "tr": "fal-sābiqāti", "audio": "wbw/079_004_001.mp3"}, {"type": "word", "ar": "سَبْقًۭا", "tajweed": "سَ<rule class=qalaqah>بۡ</rule>قًا", "en": "(in) a race", "tr": "sabqan", "audio": "wbw/079_004_002.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "79:5", "juz": 30, "page": 583, "side_trans": "And those who arrange [each] matter,", "words": [{"type": "word", "ar": "فَٱلْمُدَبِّرَٰتِ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>لۡمُدَبِّر<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِ", "en": "And those who arrange", "tr": "fal-mudabirāti", "audio": "wbw/079_005_001.mp3"}, {"type": "word", "ar": "أَمْرًۭا", "tajweed": "أَمۡرًا", "en": "(the) matter", "tr": "amran", "audio": "wbw/079_005_002.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "79:6", "juz": 30, "page": 583, "side_trans": "On the Day the blast [of the Horn] will convulse [creation],", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(The) Day", "tr": "yawma", "audio": "wbw/079_006_001.mp3"}, {"type": "word", "ar": "تَرْجُفُ", "tajweed": "تَرۡجُفُ", "en": "will quake", "tr": "tarjufu", "audio": "wbw/079_006_002.mp3"}, {"type": "word", "ar": "ٱلرَّاجِفَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رَّاجِفَةُ", "en": "the quaking one", "tr": "l-rājifatu", "audio": "wbw/079_006_003.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "79:7", "juz": 30, "page": 583, "side_trans": "There will follow it the subsequent [one].", "words": [{"type": "word", "ar": "تَتْبَعُهَا", "tajweed": "تَتۡبَعُهَا", "en": "Follows it", "tr": "tatbaʿuhā", "audio": "wbw/079_007_001.mp3"}, {"type": "word", "ar": "ٱلرَّادِفَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رَّادِفَةُ", "en": "the subsequent", "tr": "l-rādifatu", "audio": "wbw/079_007_002.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "79:8", "juz": 30, "page": 583, "side_trans": "Hearts, that Day, will tremble,", "words": [{"type": "word", "ar": "قُلُوبٌۭ", "tajweed": "قُلُو<rule class=idgham_ghunnah>بٌ</rule>", "en": "Hearts", "tr": "qulūbun", "audio": "wbw/079_008_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/079_008_002.mp3"}, {"type": "word", "ar": "وَاجِفَةٌ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َاجِفَةٌ", "en": "will palpitate", "tr": "wājifatun", "audio": "wbw/079_008_003.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "79:9", "juz": 30, "page": 583, "side_trans": "Their eyes humbled.", "words": [{"type": "word", "ar": "أَبْصَـٰرُهَا", "tajweed": "أَ<rule class=qalaqah>بۡ</rule>صَ<rule class=madda_normal>ـٰ</rule>رُهَا", "en": "Their eyes", "tr": "abṣāruhā", "audio": "wbw/079_009_001.mp3"}, {"type": "word", "ar": "خَـٰشِعَةٌۭ", "tajweed": "خَ<rule class=madda_normal>ـٰ</rule>شِعَةٌ", "en": "humbled", "tr": "khāshiʿatun", "audio": "wbw/079_009_002.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "79:10", "juz": 30, "page": 583, "side_trans": "They are [presently] saying, \"Will we indeed be returned to [our] former state [of life]?", "words": [{"type": "word", "ar": "يَقُولُونَ", "tajweed": "يَقُولُونَ", "en": "They say", "tr": "yaqūlūna", "audio": "wbw/079_010_001.mp3"}, {"type": "word", "ar": "أَءِنَّا", "tajweed": "أَءِ<rule class=ghunnah>نّ</rule>َا", "en": "Will we", "tr": "a-innā", "audio": "wbw/079_010_002.mp3"}, {"type": "word", "ar": "لَمَرْدُودُونَ", "tajweed": "لَمَرۡدُودُونَ", "en": "indeed be returned", "tr": "lamardūdūna", "audio": "wbw/079_010_003.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "to", "tr": "fī", "audio": "wbw/079_010_004.mp3"}, {"type": "word", "ar": "ٱلْحَافِرَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَافِرَةِ", "en": "the former state", "tr": "l-ḥāfirati", "audio": "wbw/079_010_005.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "79:11", "juz": 30, "page": 583, "side_trans": "Even if we should be decayed bones?\"", "words": [{"type": "word", "ar": "أَءِذَا", "tajweed": "أَءِذَا", "en": "What! When", "tr": "a-idhā", "audio": "wbw/079_011_001.mp3"}, {"type": "word", "ar": "كُنَّا", "tajweed": "كُ<rule class=ghunnah>نّ</rule>َا", "en": "we are", "tr": "kunnā", "audio": "wbw/079_011_002.mp3"}, {"type": "word", "ar": "عِظَـٰمًۭا", "tajweed": "عِظَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>مًا</rule>", "en": "bones", "tr": "ʿiẓāman", "audio": "wbw/079_011_003.mp3"}, {"type": "word", "ar": "نَّخِرَةًۭ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>َّخِرَةً", "en": "decayed", "tr": "nakhiratan", "audio": "wbw/079_011_004.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "79:12", "juz": 30, "page": 583, "side_trans": "They say, \"That, then, would be a losing return.\"", "words": [{"type": "word", "ar": "قَالُوا۟", "tajweed": "قَالُو<rule class=slnt>اۡ</rule>", "en": "They say", "tr": "qālū", "audio": "wbw/079_012_001.mp3"}, {"type": "word", "ar": "تِلْكَ", "tajweed": "تِلۡكَ", "en": "This", "tr": "til'ka", "audio": "wbw/079_012_002.mp3"}, {"type": "word", "ar": "إِذًۭا", "tajweed": "إِ<rule class=ikhafa>ذًا</rule>", "en": "then", "tr": "idhan", "audio": "wbw/079_012_003.mp3"}, {"type": "word", "ar": "كَرَّةٌ", "tajweed": "<rule class=ikhafa>ك</rule>َرَّةٌ", "en": "(would be) a return", "tr": "karratun", "audio": "wbw/079_012_004.mp3"}, {"type": "word", "ar": "خَاسِرَةٌۭ", "tajweed": "خَاسِرَةٌ", "en": "losing", "tr": "khāsiratun", "audio": "wbw/079_012_005.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "79:13", "juz": 30, "page": 583, "side_trans": "Indeed, it will be but one shout,", "words": [{"type": "word", "ar": "فَإِنَّمَا", "tajweed": "فَإِ<rule class=ghunnah>نّ</rule>َمَا", "en": "Then only", "tr": "fa-innamā", "audio": "wbw/079_013_001.mp3"}, {"type": "word", "ar": "هِىَ", "tajweed": "هِىَ", "en": "it", "tr": "hiya", "audio": "wbw/079_013_002.mp3"}, {"type": "word", "ar": "زَجْرَةٌۭ", "tajweed": "زَ<rule class=qalaqah>جۡ</rule>رَ<rule class=idgham_ghunnah>ةٌ</rule>", "en": "(will be) a shout", "tr": "zajratun", "audio": "wbw/079_013_003.mp3"}, {"type": "word", "ar": "وَٰحِدَةٌۭ", "tajweed": "<rule class=idgham_ghunnah>و</rule><rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>حِدَةٌ", "en": "single", "tr": "wāḥidatun", "audio": "wbw/079_013_004.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "79:14", "juz": 30, "page": 583, "side_trans": "And suddenly they will be [alert] upon the earth's surface.", "words": [{"type": "word", "ar": "فَإِذَا", "tajweed": "فَإِذَا", "en": "And behold", "tr": "fa-idhā", "audio": "wbw/079_014_001.mp3"}, {"type": "word", "ar": "هُم", "tajweed": "ه<rule class=ikhafa_shafawi>ُم</rule>", "en": "They", "tr": "hum", "audio": "wbw/079_014_002.mp3"}, {"type": "word", "ar": "بِٱلسَّاهِرَةِ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّاهِرَةِ", "en": "(will be) awakened", "tr": "bil-sāhirati", "audio": "wbw/079_014_003.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "79:15", "juz": 30, "page": 583, "side_trans": "Has there reached you the story of Moses? -", "words": [{"type": "word", "ar": "هَلْ", "tajweed": "هَلۡ", "en": "Has", "tr": "hal", "audio": "wbw/079_015_001.mp3"}, {"type": "word", "ar": "أَتَىٰكَ", "tajweed": "أَتَ<rule class=madda_normal>ـٰ</rule>كَ", "en": "(there) come to you", "tr": "atāka", "audio": "wbw/079_015_002.mp3"}, {"type": "word", "ar": "حَدِيثُ", "tajweed": "حَدِيثُ", "en": "(the) story", "tr": "ḥadīthu", "audio": "wbw/079_015_003.mp3"}, {"type": "word", "ar": "مُوسَىٰٓ", "tajweed": "مُوسَىٰٓ", "en": "(of) Musa", "tr": "mūsā", "audio": "wbw/079_015_004.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "79:16", "juz": 30, "page": 583, "side_trans": "When his Lord called to him in the sacred valley of Ṭuwā,", "words": [{"type": "word", "ar": "إِذْ", "tajweed": "إِذۡ", "en": "When", "tr": "idh", "audio": "wbw/079_016_001.mp3"}, {"type": "word", "ar": "نَادَىٰهُ", "tajweed": "نَادَ<rule class=madda_normal>ٮٰ</rule>هُ", "en": "called him", "tr": "nādāhu", "audio": "wbw/079_016_002.mp3"}, {"type": "word", "ar": "رَبُّهُۥ", "tajweed": "رَبُّهُ<rule class=madda_normal>ۥ</rule>", "en": "his Lord", "tr": "rabbuhu", "audio": "wbw/079_016_003.mp3"}, {"type": "word", "ar": "بِٱلْوَادِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡوَادِ", "en": "in the valley", "tr": "bil-wādi", "audio": "wbw/079_016_004.mp3"}, {"type": "word", "ar": "ٱلْمُقَدَّسِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُقَدَّسِ", "en": "the sacred", "tr": "l-muqadasi", "audio": "wbw/079_016_005.mp3"}, {"type": "word", "ar": "طُوًى", "tajweed": "طُوًى", "en": "(of) Tuwa", "tr": "ṭuwan", "audio": "wbw/079_016_006.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "79:17", "juz": 30, "page": 584, "side_trans": "\"Go to Pharaoh. Indeed, he has transgressed.", "words": [{"type": "word", "ar": "ٱذْهَبْ", "tajweed": "ٱذۡهَ<rule class=qalaqah>بۡ</rule>", "en": "Go", "tr": "idh'hab", "audio": "wbw/079_017_001.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/079_017_002.mp3"}, {"type": "word", "ar": "فِرْعَوْنَ", "tajweed": "فِرۡعَوۡنَ", "en": "Firaun", "tr": "fir'ʿawna", "audio": "wbw/079_017_003.mp3"}, {"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, he", "tr": "innahu", "audio": "wbw/079_017_004.mp3"}, {"type": "word", "ar": "طَغَىٰ", "tajweed": "طَغَىٰ", "en": "(has) transgressed", "tr": "ṭaghā", "audio": "wbw/079_017_005.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "79:18", "juz": 30, "page": 584, "side_trans": "And say to him, 'Would you [be willing to] purify yourself", "words": [{"type": "word", "ar": "فَقُلْ", "tajweed": "فَقُلۡ", "en": "And say", "tr": "faqul", "audio": "wbw/079_018_001.mp3"}, {"type": "word", "ar": "هَل", "tajweed": "هَل", "en": "Would", "tr": "hal", "audio": "wbw/079_018_002.mp3"}, {"type": "word", "ar": "لَّكَ", "tajweed": "لَّكَ", "en": "[for] you", "tr": "laka", "audio": "wbw/079_018_003.mp3"}, {"type": "word", "ar": "إِلَىٰٓ", "tajweed": "إِلَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "[to]", "tr": "ilā", "audio": "wbw/079_018_004.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أَ<rule class=ikhafa>ن</rule>", "en": "[that]", "tr": "an", "audio": "wbw/079_018_005.mp3"}, {"type": "word", "ar": "تَزَكَّىٰ", "tajweed": "<rule class=ikhafa>ت</rule>َزَكَّىٰ", "en": "purify yourself", "tr": "tazakkā", "audio": "wbw/079_018_006.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "79:19", "juz": 30, "page": 584, "side_trans": "And let me guide you to your Lord so you would fear [Him]?'\"", "words": [{"type": "word", "ar": "وَأَهْدِيَكَ", "tajweed": "وَأَهۡدِيَكَ", "en": "And I will guide you", "tr": "wa-ahdiyaka", "audio": "wbw/079_019_001.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/079_019_002.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "your Lord", "tr": "rabbika", "audio": "wbw/079_019_003.mp3"}, {"type": "word", "ar": "فَتَخْشَىٰ", "tajweed": "فَتَخۡشَىٰ", "en": "so you would fear", "tr": "fatakhshā", "audio": "wbw/079_019_004.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "79:20", "juz": 30, "page": 584, "side_trans": "And he showed him the greatest sign,", "words": [{"type": "word", "ar": "فَأَرَىٰهُ", "tajweed": "فَأَرَ<rule class=madda_normal>ٮٰ</rule>هُ", "en": "Then he showed him", "tr": "fa-arāhu", "audio": "wbw/079_020_001.mp3"}, {"type": "word", "ar": "ٱلْـَٔايَةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَيَةَ", "en": "the sign", "tr": "l-āyata", "audio": "wbw/079_020_002.mp3"}, {"type": "word", "ar": "ٱلْكُبْرَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكُ<rule class=qalaqah>بۡ</rule>رَىٰ", "en": "the great", "tr": "l-kub'rā", "audio": "wbw/079_020_003.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "79:21", "juz": 30, "page": 584, "side_trans": "But he [i.e., Pharaoh] denied and disobeyed.", "words": [{"type": "word", "ar": "فَكَذَّبَ", "tajweed": "فَكَذَّبَ", "en": "But he denied", "tr": "fakadhaba", "audio": "wbw/079_021_001.mp3"}, {"type": "word", "ar": "وَعَصَىٰ", "tajweed": "وَعَصَىٰ", "en": "and disobeyed", "tr": "waʿaṣā", "audio": "wbw/079_021_002.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "79:22", "juz": 30, "page": 584, "side_trans": "Then he turned his back, striving [i.e., plotting].", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/079_022_001.mp3"}, {"type": "word", "ar": "أَدْبَرَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>بَرَ", "en": "he turned his back", "tr": "adbara", "audio": "wbw/079_022_002.mp3"}, {"type": "word", "ar": "يَسْعَىٰ", "tajweed": "يَسۡعَىٰ", "en": "striving", "tr": "yasʿā", "audio": "wbw/079_022_003.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "79:23", "juz": 30, "page": 584, "side_trans": "And he gathered [his people] and called out.", "words": [{"type": "word", "ar": "فَحَشَرَ", "tajweed": "فَحَشَرَ", "en": "And he gathered", "tr": "faḥashara", "audio": "wbw/079_023_001.mp3"}, {"type": "word", "ar": "فَنَادَىٰ", "tajweed": "فَنَادَىٰ", "en": "and called out", "tr": "fanādā", "audio": "wbw/079_023_002.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "79:24", "juz": 30, "page": 584, "side_trans": "And said, \"I am your most exalted lord.\"", "words": [{"type": "word", "ar": "فَقَالَ", "tajweed": "فَقَالَ", "en": "Then he said", "tr": "faqāla", "audio": "wbw/079_024_001.mp3"}, {"type": "word", "ar": "أَنَا۠", "tajweed": "أَنَاۡ", "en": "I am", "tr": "anā", "audio": "wbw/079_024_002.mp3"}, {"type": "word", "ar": "رَبُّكُمُ", "tajweed": "رَبُّكُمُ", "en": "your Lord", "tr": "rabbukumu", "audio": "wbw/079_024_003.mp3"}, {"type": "word", "ar": "ٱلْأَعْلَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَعۡلَىٰ", "en": "the Most High", "tr": "l-aʿlā", "audio": "wbw/079_024_004.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "79:25", "juz": 30, "page": 584, "side_trans": "So Allāh seized him in exemplary punishment for the last and the first [transgression]..", "words": [{"type": "word", "ar": "فَأَخَذَهُ", "tajweed": "فَأَخَذَهُ", "en": "So seized him", "tr": "fa-akhadhahu", "audio": "wbw/079_025_001.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/079_025_002.mp3"}, {"type": "word", "ar": "نَكَالَ", "tajweed": "نَكَالَ", "en": "(with) an exemplary punishment", "tr": "nakāla", "audio": "wbw/079_025_003.mp3"}, {"type": "word", "ar": "ٱلْـَٔاخِرَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَخِرَةِ", "en": "(for) the last", "tr": "l-ākhirati", "audio": "wbw/079_025_004.mp3"}, {"type": "word", "ar": "وَٱلْأُولَىٰٓ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأُولَىٰٓ", "en": "and the first", "tr": "wal-ūlā", "audio": "wbw/079_025_005.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "79:26", "juz": 30, "page": 584, "side_trans": "Indeed in that is a lesson [i.e., warning] for whoever would fear [Allāh].", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/079_026_001.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/079_026_002.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "that", "tr": "dhālika", "audio": "wbw/079_026_003.mp3"}, {"type": "word", "ar": "لَعِبْرَةًۭ", "tajweed": "لَعِ<rule class=qalaqah>بۡ</rule>رَ<rule class=idgham_wo_ghunnah>ةً</rule>", "en": "surely (is) a lesson", "tr": "laʿib'ratan", "audio": "wbw/079_026_004.mp3"}, {"type": "word", "ar": "لِّمَن", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّم<rule class=idgham_ghunnah>َن</rule>", "en": "for whoever", "tr": "liman", "audio": "wbw/079_026_005.mp3"}, {"type": "word", "ar": "يَخْشَىٰٓ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َخۡشَىٰٓ", "en": "fears", "tr": "yakhshā", "audio": "wbw/079_026_006.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "79:27", "juz": 30, "page": 584, "side_trans": "Are you a more difficult creation or is the heaven? He [i.e., Allāh] constructed it.", "words": [{"type": "word", "ar": "ءَأَنتُمْ", "tajweed": "ءَأَ<rule class=ikhafa>نت</rule>ُمۡ", "en": "Are you", "tr": "a-antum", "audio": "wbw/079_027_001.mp3"}, {"type": "word", "ar": "أَشَدُّ", "tajweed": "أَشَدُّ", "en": "a more difficult", "tr": "ashaddu", "audio": "wbw/079_027_002.mp3"}, {"type": "word", "ar": "خَلْقًا", "tajweed": "خَلۡقًا", "en": "creation", "tr": "khalqan", "audio": "wbw/079_027_003.mp3"}, {"type": "word", "ar": "أَمِ", "tajweed": "أَمِ", "en": "or", "tr": "ami", "audio": "wbw/079_027_004.mp3"}, {"type": "word", "ar": "ٱلسَّمَآءُ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ‌ۚ", "en": "the heaven", "tr": "l-samāu", "audio": "wbw/079_027_005.mp3"}, {"type": "word", "ar": "بَنَىٰهَا", "tajweed": "بَنَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "He constructed it", "tr": "banāhā", "audio": "wbw/079_027_007.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "79:28", "juz": 30, "page": 584, "side_trans": "He raised its ceiling and proportioned it.", "words": [{"type": "word", "ar": "رَفَعَ", "tajweed": "رَفَعَ", "en": "He raised", "tr": "rafaʿa", "audio": "wbw/079_028_001.mp3"}, {"type": "word", "ar": "سَمْكَهَا", "tajweed": "سَمۡكَهَا", "en": "its ceiling", "tr": "samkahā", "audio": "wbw/079_028_002.mp3"}, {"type": "word", "ar": "فَسَوَّىٰهَا", "tajweed": "فَسَوَّ<rule class=madda_normal>ٮٰ</rule>هَا", "en": "and proportioned it", "tr": "fasawwāhā", "audio": "wbw/079_028_003.mp3"}, {"type": "end", "num": "٢٨"}]}, {"id": 29, "key": "79:29", "juz": 30, "page": 584, "side_trans": "And He darkened its night and extracted its brightness.", "words": [{"type": "word", "ar": "وَأَغْطَشَ", "tajweed": "وَأَغۡطَشَ", "en": "And He darkened", "tr": "wa-aghṭasha", "audio": "wbw/079_029_001.mp3"}, {"type": "word", "ar": "لَيْلَهَا", "tajweed": "لَيۡلَهَا", "en": "its night", "tr": "laylahā", "audio": "wbw/079_029_002.mp3"}, {"type": "word", "ar": "وَأَخْرَجَ", "tajweed": "وَأَخۡرَجَ", "en": "and brought out", "tr": "wa-akhraja", "audio": "wbw/079_029_003.mp3"}, {"type": "word", "ar": "ضُحَىٰهَا", "tajweed": "ضُحَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "its brightness", "tr": "ḍuḥāhā", "audio": "wbw/079_029_004.mp3"}, {"type": "end", "num": "٢٩"}]}, {"id": 30, "key": "79:30", "juz": 30, "page": 584, "side_trans": "And after that He spread the earth.", "words": [{"type": "word", "ar": "وَٱلْأَرْضَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأَرۡضَ", "en": "And the earth", "tr": "wal-arḍa", "audio": "wbw/079_030_001.mp3"}, {"type": "word", "ar": "بَعْدَ", "tajweed": "بَعۡدَ", "en": "after", "tr": "baʿda", "audio": "wbw/079_030_002.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "that", "tr": "dhālika", "audio": "wbw/079_030_003.mp3"}, {"type": "word", "ar": "دَحَىٰهَآ", "tajweed": "دَحَ<rule class=madda_normal>ـٰ</rule>هَآ", "en": "He spread it", "tr": "daḥāhā", "audio": "wbw/079_030_004.mp3"}, {"type": "end", "num": "٣٠"}]}, {"id": 31, "key": "79:31", "juz": 30, "page": 584, "side_trans": "He extracted from it its water and its pasture,", "words": [{"type": "word", "ar": "أَخْرَجَ", "tajweed": "أَخۡرَجَ", "en": "He brought forth", "tr": "akhraja", "audio": "wbw/079_031_001.mp3"}, {"type": "word", "ar": "مِنْهَا", "tajweed": "مِنۡهَا", "en": "from it", "tr": "min'hā", "audio": "wbw/079_031_002.mp3"}, {"type": "word", "ar": "مَآءَهَا", "tajweed": "م<rule class=madda_obligatory_mottasel>َا</rule>ٓءَهَا", "en": "its water", "tr": "māahā", "audio": "wbw/079_031_003.mp3"}, {"type": "word", "ar": "وَمَرْعَىٰهَا", "tajweed": "وَمَرۡعَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "and its pasture", "tr": "wamarʿāhā", "audio": "wbw/079_031_004.mp3"}, {"type": "end", "num": "٣١"}]}, {"id": 32, "key": "79:32", "juz": 30, "page": 584, "side_trans": "And the mountains He set firmly", "words": [{"type": "word", "ar": "وَٱلْجِبَالَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡجِبَالَ", "en": "And the mountains", "tr": "wal-jibāla", "audio": "wbw/079_032_001.mp3"}, {"type": "word", "ar": "أَرْسَىٰهَا", "tajweed": "أَرۡسَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "He made them firm", "tr": "arsāhā", "audio": "wbw/079_032_002.mp3"}, {"type": "end", "num": "٣٢"}]}, {"id": 33, "key": "79:33", "juz": 30, "page": 584, "side_trans": "As enjoyment [i.e., provision] for you and your grazing livestock.", "words": [{"type": "word", "ar": "مَتَـٰعًۭا", "tajweed": "مَتَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_wo_ghunnah>عًا</rule>", "en": "(As) a provision", "tr": "matāʿan", "audio": "wbw/079_033_001.mp3"}, {"type": "word", "ar": "لَّكُمْ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/079_033_002.mp3"}, {"type": "word", "ar": "وَلِأَنْعَـٰمِكُمْ", "tajweed": "وَلِأَنۡعَ<rule class=madda_normal>ـٰ</rule>مِكُمۡ", "en": "and for your cattle", "tr": "wali-anʿāmikum", "audio": "wbw/079_033_003.mp3"}, {"type": "end", "num": "٣٣"}]}, {"id": 34, "key": "79:34", "juz": 30, "page": 584, "side_trans": "But when there comes the greatest Overwhelming Calamity -", "words": [{"type": "word", "ar": "فَإِذَا", "tajweed": "فَإِذَا", "en": "But when", "tr": "fa-idhā", "audio": "wbw/079_034_001.mp3"}, {"type": "word", "ar": "جَآءَتِ", "tajweed": "ج<rule class=madda_obligatory_mottasel>َا</rule>ٓءَتِ", "en": "comes", "tr": "jāati", "audio": "wbw/079_034_002.mp3"}, {"type": "word", "ar": "ٱلطَّآمَّةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>طّ<rule class=madda_necessary>َا</rule>ٓ<rule class=ghunnah>مّ</rule>َةُ", "en": "the Overwhelming Calamity", "tr": "l-ṭāmatu", "audio": "wbw/079_034_003.mp3"}, {"type": "word", "ar": "ٱلْكُبْرَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكُ<rule class=qalaqah>بۡ</rule>رَىٰ", "en": "the great", "tr": "l-kub'rā", "audio": "wbw/079_034_004.mp3"}, {"type": "end", "num": "٣٤"}]}, {"id": 35, "key": "79:35", "juz": 30, "page": 584, "side_trans": "The Day when man will remember that for which he strove,", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(The) Day", "tr": "yawma", "audio": "wbw/079_035_001.mp3"}, {"type": "word", "ar": "يَتَذَكَّرُ", "tajweed": "يَتَذَكَّرُ", "en": "will remember", "tr": "yatadhakkaru", "audio": "wbw/079_035_002.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "man", "tr": "l-insānu", "audio": "wbw/079_035_003.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/079_035_004.mp3"}, {"type": "word", "ar": "سَعَىٰ", "tajweed": "سَعَىٰ", "en": "he strove (for)", "tr": "saʿā", "audio": "wbw/079_035_005.mp3"}, {"type": "end", "num": "٣٥"}]}, {"id": 36, "key": "79:36", "juz": 30, "page": 584, "side_trans": "And Hellfire will be exposed for [all] those who see -", "words": [{"type": "word", "ar": "وَبُرِّزَتِ", "tajweed": "وَبُرِّزَتِ", "en": "And will be made manifest", "tr": "waburrizati", "audio": "wbw/079_036_001.mp3"}, {"type": "word", "ar": "ٱلْجَحِيمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجَحِيمُ", "en": "the Hellfire", "tr": "l-jaḥīmu", "audio": "wbw/079_036_002.mp3"}, {"type": "word", "ar": "لِمَن", "tajweed": "لِم<rule class=idgham_ghunnah>َن</rule>", "en": "to (him) who", "tr": "liman", "audio": "wbw/079_036_003.mp3"}, {"type": "word", "ar": "يَرَىٰ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َرَىٰ", "en": "sees", "tr": "yarā", "audio": "wbw/079_036_004.mp3"}, {"type": "end", "num": "٣٦"}]}, {"id": 37, "key": "79:37", "juz": 30, "page": 584, "side_trans": "So as for he who transgressed", "words": [{"type": "word", "ar": "فَأَمَّا", "tajweed": "فَأَ<rule class=ghunnah>مّ</rule>َا", "en": "Then as for", "tr": "fa-ammā", "audio": "wbw/079_037_001.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "مَ<rule class=ikhafa>ن</rule>", "en": "(him) who", "tr": "man", "audio": "wbw/079_037_002.mp3"}, {"type": "word", "ar": "طَغَىٰ", "tajweed": "<rule class=ikhafa>ط</rule>َغَىٰ", "en": "transgressed", "tr": "ṭaghā", "audio": "wbw/079_037_003.mp3"}, {"type": "end", "num": "٣٧"}]}, {"id": 38, "key": "79:38", "juz": 30, "page": 584, "side_trans": "And preferred the life of the world,", "words": [{"type": "word", "ar": "وَءَاثَرَ", "tajweed": "وَءَاثَرَ", "en": "And preferred", "tr": "waāthara", "audio": "wbw/079_038_001.mp3"}, {"type": "word", "ar": "ٱلْحَيَوٰةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَيَ<rule class=slnt>و</rule><rule class=madda_normal>ٰ</rule>ةَ", "en": "the life", "tr": "l-ḥayata", "audio": "wbw/079_038_002.mp3"}, {"type": "word", "ar": "ٱلدُّنْيَا", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دُّنۡيَا", "en": "(of) the world", "tr": "l-dun'yā", "audio": "wbw/079_038_003.mp3"}, {"type": "end", "num": "٣٨"}]}, {"id": 39, "key": "79:39", "juz": 30, "page": 584, "side_trans": "Then indeed, Hellfire will be [his] refuge.", "words": [{"type": "word", "ar": "فَإِنَّ", "tajweed": "فَإِ<rule class=ghunnah>نّ</rule>َ", "en": "Then indeed", "tr": "fa-inna", "audio": "wbw/079_039_001.mp3"}, {"type": "word", "ar": "ٱلْجَحِيمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجَحِيمَ", "en": "the Hellfire", "tr": "l-jaḥīma", "audio": "wbw/079_039_002.mp3"}, {"type": "word", "ar": "هِىَ", "tajweed": "هِىَ", "en": "it", "tr": "hiya", "audio": "wbw/079_039_003.mp3"}, {"type": "word", "ar": "ٱلْمَأْوَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَأۡوَىٰ", "en": "(is) the refuge", "tr": "l-mawā", "audio": "wbw/079_039_004.mp3"}, {"type": "end", "num": "٣٩"}]}, {"id": 40, "key": "79:40", "juz": 30, "page": 584, "side_trans": "But as for he who feared the position of his Lord and prevented the soul from [unlawful] inclination,", "words": [{"type": "word", "ar": "وَأَمَّا", "tajweed": "وَأَ<rule class=ghunnah>مّ</rule>َا", "en": "But as for", "tr": "wa-ammā", "audio": "wbw/079_040_001.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "(him) who", "tr": "man", "audio": "wbw/079_040_002.mp3"}, {"type": "word", "ar": "خَافَ", "tajweed": "خَافَ", "en": "feared", "tr": "khāfa", "audio": "wbw/079_040_003.mp3"}, {"type": "word", "ar": "مَقَامَ", "tajweed": "مَقَامَ", "en": "standing", "tr": "maqāma", "audio": "wbw/079_040_004.mp3"}, {"type": "word", "ar": "رَبِّهِۦ", "tajweed": "رَبِّه<rule class=madda_normal>ِۦ</rule>", "en": "(before) his Lord", "tr": "rabbihi", "audio": "wbw/079_040_005.mp3"}, {"type": "word", "ar": "وَنَهَى", "tajweed": "وَنَهَى", "en": "and restrained", "tr": "wanahā", "audio": "wbw/079_040_006.mp3"}, {"type": "word", "ar": "ٱلنَّفْسَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َفۡسَ", "en": "his soul", "tr": "l-nafsa", "audio": "wbw/079_040_007.mp3"}, {"type": "word", "ar": "عَنِ", "tajweed": "عَنِ", "en": "from", "tr": "ʿani", "audio": "wbw/079_040_008.mp3"}, {"type": "word", "ar": "ٱلْهَوَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡهَوَىٰ", "en": "the vain desires", "tr": "l-hawā", "audio": "wbw/079_040_009.mp3"}, {"type": "end", "num": "٤٠"}]}, {"id": 41, "key": "79:41", "juz": 30, "page": 584, "side_trans": "Then indeed, Paradise will be [his] refuge.", "words": [{"type": "word", "ar": "فَإِنَّ", "tajweed": "فَإِ<rule class=ghunnah>نّ</rule>َ", "en": "Then indeed", "tr": "fa-inna", "audio": "wbw/079_041_001.mp3"}, {"type": "word", "ar": "ٱلْجَنَّةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجَ<rule class=ghunnah>نّ</rule>َةَ", "en": "Paradise ", "tr": "l-janata", "audio": "wbw/079_041_002.mp3"}, {"type": "word", "ar": "هِىَ", "tajweed": "هِىَ", "en": "it (is)", "tr": "hiya", "audio": "wbw/079_041_003.mp3"}, {"type": "word", "ar": "ٱلْمَأْوَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَأۡوَىٰ", "en": "the refuge", "tr": "l-mawā", "audio": "wbw/079_041_004.mp3"}, {"type": "end", "num": "٤١"}]}, {"id": 42, "key": "79:42", "juz": 30, "page": 584, "side_trans": "They ask you, [O Muḥammad], about the Hour: when is its arrival?", "words": [{"type": "word", "ar": "يَسْـَٔلُونَكَ", "tajweed": "يَسۡــَٔلُونَكَ", "en": "They ask you", "tr": "yasalūnaka", "audio": "wbw/079_042_001.mp3"}, {"type": "word", "ar": "عَنِ", "tajweed": "عَنِ", "en": "about", "tr": "ʿani", "audio": "wbw/079_042_002.mp3"}, {"type": "word", "ar": "ٱلسَّاعَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّاعَةِ", "en": "the Hour", "tr": "l-sāʿati", "audio": "wbw/079_042_003.mp3"}, {"type": "word", "ar": "أَيَّانَ", "tajweed": "أَيَّانَ", "en": "when", "tr": "ayyāna", "audio": "wbw/079_042_004.mp3"}, {"type": "word", "ar": "مُرْسَىٰهَا", "tajweed": "مُرۡسَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "(is) its arrival", "tr": "mur'sāhā", "audio": "wbw/079_042_005.mp3"}, {"type": "end", "num": "٤٢"}]}, {"id": 43, "key": "79:43", "juz": 30, "page": 584, "side_trans": "In what [position] are you that you should mention it?", "words": [{"type": "word", "ar": "فِيمَ", "tajweed": "فِيمَ", "en": "In what", "tr": "fīma", "audio": "wbw/079_043_001.mp3"}, {"type": "word", "ar": "أَنتَ", "tajweed": "أَ<rule class=ikhafa>نت</rule>َ", "en": "(are) you", "tr": "anta", "audio": "wbw/079_043_002.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "[of]", "tr": "min", "audio": "wbw/079_043_003.mp3"}, {"type": "word", "ar": "ذِكْرَىٰهَآ", "tajweed": "<rule class=ikhafa>ذ</rule>ِكۡرَ<rule class=madda_normal>ٮٰ</rule>هَآ", "en": "(to) mention it", "tr": "dhik'rāhā", "audio": "wbw/079_043_004.mp3"}, {"type": "end", "num": "٤٣"}]}, {"id": 44, "key": "79:44", "juz": 30, "page": 584, "side_trans": "To your Lord is its finality.", "words": [{"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "To", "tr": "ilā", "audio": "wbw/079_044_001.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "your Lord", "tr": "rabbika", "audio": "wbw/079_044_002.mp3"}, {"type": "word", "ar": "مُنتَهَىٰهَآ", "tajweed": "مُ<rule class=ikhafa>نت</rule>َهَ<rule class=madda_normal>ـٰ</rule>هَآ", "en": "(is) its finality", "tr": "muntahāhā", "audio": "wbw/079_044_003.mp3"}, {"type": "end", "num": "٤٤"}]}, {"id": 45, "key": "79:45", "juz": 30, "page": 584, "side_trans": "You are only a warner for those who fear it.", "words": [{"type": "word", "ar": "إِنَّمَآ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Only", "tr": "innamā", "audio": "wbw/079_045_001.mp3"}, {"type": "word", "ar": "أَنتَ", "tajweed": "أَ<rule class=ikhafa>نت</rule>َ", "en": "you", "tr": "anta", "audio": "wbw/079_045_002.mp3"}, {"type": "word", "ar": "مُنذِرُ", "tajweed": "مُ<rule class=ikhafa>نذ</rule>ِرُ", "en": "(are) a warner", "tr": "mundhiru", "audio": "wbw/079_045_003.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "م<rule class=idgham_ghunnah>َن</rule>", "en": "(for him) who", "tr": "man", "audio": "wbw/079_045_004.mp3"}, {"type": "word", "ar": "يَخْشَىٰهَا", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َخۡشَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "fears it", "tr": "yakhshāhā", "audio": "wbw/079_045_005.mp3"}, {"type": "end", "num": "٤٥"}]}, {"id": 46, "key": "79:46", "juz": 30, "page": 584, "side_trans": "It will be, on the Day they see it, as though they had not remained [in the world] except for an afternoon or a morning thereof.", "words": [{"type": "word", "ar": "كَأَنَّهُمْ", "tajweed": "كَأَ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "As though they", "tr": "ka-annahum", "audio": "wbw/079_046_001.mp3"}, {"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(the) Day", "tr": "yawma", "audio": "wbw/079_046_002.mp3"}, {"type": "word", "ar": "يَرَوْنَهَا", "tajweed": "يَرَوۡنَهَا", "en": "they see it", "tr": "yarawnahā", "audio": "wbw/079_046_003.mp3"}, {"type": "word", "ar": "لَمْ", "tajweed": "لَمۡ", "en": "not", "tr": "lam", "audio": "wbw/079_046_004.mp3"}, {"type": "word", "ar": "يَلْبَثُوٓا۟", "tajweed": "يَلۡبَث<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "they had remained", "tr": "yalbathū", "audio": "wbw/079_046_005.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/079_046_006.mp3"}, {"type": "word", "ar": "عَشِيَّةً", "tajweed": "عَشِيَّةً", "en": "an evening", "tr": "ʿashiyyatan", "audio": "wbw/079_046_007.mp3"}, {"type": "word", "ar": "أَوْ", "tajweed": "أَوۡ", "en": "or", "tr": "aw", "audio": "wbw/079_046_008.mp3"}, {"type": "word", "ar": "ضُحَىٰهَا", "tajweed": "ضُحَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "a morning thereof", "tr": "ḍuḥāhā", "audio": "wbw/079_046_009.mp3"}, {"type": "end", "num": "٤٦"}]}]