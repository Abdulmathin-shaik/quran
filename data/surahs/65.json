[{"id": 1, "key": "65:1", "juz": 28, "page": 558, "side_trans": "O Prophet, when you [Muslims] divorce women, divorce them for [the commencement of] their waiting period and keep count of the waiting period, and fear Allāh, your Lord. Do not turn them out of their [husbands'] houses, nor should they [themselves] leave [during that period] unless they are committing a clear immorality. And those are the limits [set by] Allāh. And whoever transgresses the limits of Allāh has certainly wronged himself. You know not; perhaps Allāh will bring about after that a [different] matter.", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/065_001_001.mp3"}, {"type": "word", "ar": "ٱلنَّبِىُّ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َبِىُّ", "en": "Prophet", "tr": "l-nabiyu", "audio": "wbw/065_001_002.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/065_001_003.mp3"}, {"type": "word", "ar": "طَلَّقْتُمُ", "tajweed": "طَلَّ<rule class=qalaqah>قۡ</rule>تُمُ", "en": "you divorce", "tr": "ṭallaqtumu", "audio": "wbw/065_001_004.mp3"}, {"type": "word", "ar": "ٱلنِّسَآءَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>ِس<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "[the] women", "tr": "l-nisāa", "audio": "wbw/065_001_005.mp3"}, {"type": "word", "ar": "فَطَلِّقُوهُنَّ", "tajweed": "فَطَلِّقُوهُ<rule class=ghunnah>نّ</rule>َ", "en": "then divorce them", "tr": "faṭalliqūhunna", "audio": "wbw/065_001_006.mp3"}, {"type": "word", "ar": "لِعِدَّتِهِنَّ", "tajweed": "لِعِدَّتِهِ<rule class=ghunnah>نّ</rule>َ", "en": "for their waiting period", "tr": "liʿiddatihinna", "audio": "wbw/065_001_007.mp3"}, {"type": "word", "ar": "وَأَحْصُوا۟", "tajweed": "وَأَحۡصُو<rule class=slnt>اۡ</rule>", "en": "and keep count", "tr": "wa-aḥṣū", "audio": "wbw/065_001_008.mp3"}, {"type": "word", "ar": "ٱلْعِدَّةَ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعِدَّةَ‌ۖ", "en": "(of) the waiting period", "tr": "l-ʿidata", "audio": "wbw/065_001_009.mp3"}, {"type": "word", "ar": "وَٱتَّقُوا۟", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>تَّقُو<rule class=slnt>اۡ</rule>", "en": "and fear", "tr": "wa-ittaqū", "audio": "wbw/065_001_011.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/065_001_012.mp3"}, {"type": "word", "ar": "رَبَّكُمْ ۖ", "tajweed": "رَبَّكُمۡ‌ۖ", "en": "your Lord", "tr": "rabbakum", "audio": "wbw/065_001_013.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(Do) not", "tr": "lā", "audio": "wbw/065_001_015.mp3"}, {"type": "word", "ar": "تُخْرِجُوهُنَّ", "tajweed": "تُخۡرِجُوهُ<rule class=ghunnah>نّ</rule>َ", "en": "expel them", "tr": "tukh'rijūhunna", "audio": "wbw/065_001_016.mp3"}, {"type": "word", "ar": "مِنۢ", "tajweed": "م<rule class=iqlab>ِنۢ</rule>", "en": "from", "tr": "min", "audio": "wbw/065_001_017.mp3"}, {"type": "word", "ar": "بُيُوتِهِنَّ", "tajweed": "<rule class=iqlab>ب</rule>ُيُوتِهِ<rule class=ghunnah>نّ</rule>َ", "en": "their houses", "tr": "buyūtihinna", "audio": "wbw/065_001_018.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "and not", "tr": "walā", "audio": "wbw/065_001_019.mp3"}, {"type": "word", "ar": "يَخْرُجْنَ", "tajweed": "يَخۡرُ<rule class=qalaqah>جۡ</rule>نَ", "en": "they should leave", "tr": "yakhruj'na", "audio": "wbw/065_001_020.mp3"}, {"type": "word", "ar": "إِلَّآ", "tajweed": "إِلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "except", "tr": "illā", "audio": "wbw/065_001_021.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/065_001_022.mp3"}, {"type": "word", "ar": "يَأْتِينَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َأۡتِينَ", "en": "they commit", "tr": "yatīna", "audio": "wbw/065_001_023.mp3"}, {"type": "word", "ar": "بِفَـٰحِشَةٍۢ", "tajweed": "بِفَ<rule class=madda_normal>ـٰ</rule>حِشَ<rule class=idgham_ghunnah>ةٍ</rule>", "en": "an immorality", "tr": "bifāḥishatin", "audio": "wbw/065_001_024.mp3"}, {"type": "word", "ar": "مُّبَيِّنَةٍۢ ۚ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّبَيِّنَ<rule class=idgham_ghunnah>ةٍ‌ۚ</rule>", "en": "clear", "tr": "mubayyinatin", "audio": "wbw/065_001_025.mp3"}, {"type": "word", "ar": "وَتِلْكَ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َتِلۡكَ", "en": "And these", "tr": "watil'ka", "audio": "wbw/065_001_027.mp3"}, {"type": "word", "ar": "حُدُودُ", "tajweed": "حُدُودُ", "en": "(are the) limits", "tr": "ḥudūdu", "audio": "wbw/065_001_028.mp3"}, {"type": "word", "ar": "ٱللَّهِ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ‌ۚ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/065_001_029.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/065_001_031.mp3"}, {"type": "word", "ar": "يَتَعَدَّ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َتَعَدَّ", "en": "transgresses", "tr": "yataʿadda", "audio": "wbw/065_001_032.mp3"}, {"type": "word", "ar": "حُدُودَ", "tajweed": "حُدُودَ", "en": "(the) limits", "tr": "ḥudūda", "audio": "wbw/065_001_033.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/065_001_034.mp3"}, {"type": "word", "ar": "فَقَدْ", "tajweed": "فَقَ<rule class=qalaqah>دۡ</rule>", "en": "then certainly", "tr": "faqad", "audio": "wbw/065_001_035.mp3"}, {"type": "word", "ar": "ظَلَمَ", "tajweed": "ظَلَمَ", "en": "he has wronged", "tr": "ẓalama", "audio": "wbw/065_001_036.mp3"}, {"type": "word", "ar": "نَفْسَهُۥ ۚ", "tajweed": "نَفۡسَهُ<rule class=madda_normal>ۥ</rule>‌ۚ", "en": "himself", "tr": "nafsahu", "audio": "wbw/065_001_037.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "Not", "tr": "lā", "audio": "wbw/065_001_039.mp3"}, {"type": "word", "ar": "تَدْرِى", "tajweed": "تَ<rule class=qalaqah>دۡ</rule>رِى", "en": "you know", "tr": "tadrī", "audio": "wbw/065_001_040.mp3"}, {"type": "word", "ar": "لَعَلَّ", "tajweed": "لَعَلَّ", "en": "Perhaps", "tr": "laʿalla", "audio": "wbw/065_001_041.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/065_001_042.mp3"}, {"type": "word", "ar": "يُحْدِثُ", "tajweed": "يُحۡدِثُ", "en": "will bring about", "tr": "yuḥ'dithu", "audio": "wbw/065_001_043.mp3"}, {"type": "word", "ar": "بَعْدَ", "tajweed": "بَعۡدَ", "en": "after", "tr": "baʿda", "audio": "wbw/065_001_044.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "that", "tr": "dhālika", "audio": "wbw/065_001_045.mp3"}, {"type": "word", "ar": "أَمْرًۭا", "tajweed": "أَمۡرًا", "en": "a matter", "tr": "amran", "audio": "wbw/065_001_046.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "65:2", "juz": 28, "page": 558, "side_trans": "And when they have [nearly] fulfilled their term, either retain them according to acceptable terms or part with them according to acceptable terms. And bring to witness two just men from among you and establish the testimony for [the acceptance of] Allāh. That is instructed to whoever should believe in Allāh and the Last Day. And whoever fears Allāh - He will make for him a way out", "words": [{"type": "word", "ar": "فَإِذَا", "tajweed": "فَإِذَا", "en": "Then when", "tr": "fa-idhā", "audio": "wbw/065_002_001.mp3"}, {"type": "word", "ar": "بَلَغْنَ", "tajweed": "بَلَغۡنَ", "en": "they have reached", "tr": "balaghna", "audio": "wbw/065_002_002.mp3"}, {"type": "word", "ar": "أَجَلَهُنَّ", "tajweed": "أَجَلَهُ<rule class=ghunnah>نّ</rule>َ", "en": "their term", "tr": "ajalahunna", "audio": "wbw/065_002_003.mp3"}, {"type": "word", "ar": "فَأَمْسِكُوهُنَّ", "tajweed": "فَأَمۡسِكُوهُ<rule class=ghunnah>نّ</rule>َ", "en": "then retain them", "tr": "fa-amsikūhunna", "audio": "wbw/065_002_004.mp3"}, {"type": "word", "ar": "بِمَعْرُوفٍ", "tajweed": "بِمَعۡرُوفٍ", "en": "with kindness", "tr": "bimaʿrūfin", "audio": "wbw/065_002_005.mp3"}, {"type": "word", "ar": "أَوْ", "tajweed": "أَوۡ", "en": "or", "tr": "aw", "audio": "wbw/065_002_006.mp3"}, {"type": "word", "ar": "فَارِقُوهُنَّ", "tajweed": "فَارِقُوهُ<rule class=ghunnah>نّ</rule>َ", "en": "part with them", "tr": "fāriqūhunna", "audio": "wbw/065_002_007.mp3"}, {"type": "word", "ar": "بِمَعْرُوفٍۢ", "tajweed": "بِمَعۡرُو<rule class=idgham_ghunnah>فٍ</rule>", "en": "with kindness", "tr": "bimaʿrūfin", "audio": "wbw/065_002_008.mp3"}, {"type": "word", "ar": "وَأَشْهِدُوا۟", "tajweed": "<rule class=idgham_ghunnah>و</rule>َأَشۡهِدُو<rule class=slnt>اۡ</rule>", "en": "And take witness", "tr": "wa-ashhidū", "audio": "wbw/065_002_009.mp3"}, {"type": "word", "ar": "ذَوَىْ", "tajweed": "ذَوَىۡ", "en": "two men", "tr": "dhaway", "audio": "wbw/065_002_010.mp3"}, {"type": "word", "ar": "عَدْلٍۢ", "tajweed": "عَ<rule class=qalaqah>دۡ</rule><rule class=idgham_ghunnah>لٍ</rule>", "en": "just", "tr": "ʿadlin", "audio": "wbw/065_002_011.mp3"}, {"type": "word", "ar": "مِّنكُمْ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّ<rule class=ikhafa>نك</rule>ُمۡ", "en": "among you", "tr": "minkum", "audio": "wbw/065_002_012.mp3"}, {"type": "word", "ar": "وَأَقِيمُوا۟", "tajweed": "وَأَقِيمُو<rule class=slnt>اۡ</rule>", "en": "and establish", "tr": "wa-aqīmū", "audio": "wbw/065_002_013.mp3"}, {"type": "word", "ar": "ٱلشَّهَـٰدَةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شَّهَ<rule class=madda_normal>ـٰ</rule>دَةَ", "en": "the testimony", "tr": "l-shahādata", "audio": "wbw/065_002_014.mp3"}, {"type": "word", "ar": "لِلَّهِ ۚ", "tajweed": "لِلَّهِ‌ۚ", "en": "for Allah", "tr": "lillahi", "audio": "wbw/065_002_015.mp3"}, {"type": "word", "ar": "ذَٰلِكُمْ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكُمۡ", "en": "That", "tr": "dhālikum", "audio": "wbw/065_002_017.mp3"}, {"type": "word", "ar": "يُوعَظُ", "tajweed": "يُوعَظُ", "en": "is instructed", "tr": "yūʿaẓu", "audio": "wbw/065_002_018.mp3"}, {"type": "word", "ar": "بِهِۦ", "tajweed": "بِه<rule class=madda_normal>ِۦ</rule>", "en": "with it", "tr": "bihi", "audio": "wbw/065_002_019.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "مَ<rule class=ikhafa>ن</rule>", "en": "whoever", "tr": "man", "audio": "wbw/065_002_020.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "<rule class=ikhafa>ك</rule>َانَ", "en": "[is]", "tr": "kāna", "audio": "wbw/065_002_021.mp3"}, {"type": "word", "ar": "يُؤْمِنُ", "tajweed": "يُؤۡمِنُ", "en": "believes", "tr": "yu'minu", "audio": "wbw/065_002_022.mp3"}, {"type": "word", "ar": "بِٱللَّهِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "in Allah", "tr": "bil-lahi", "audio": "wbw/065_002_023.mp3"}, {"type": "word", "ar": "وَٱلْيَوْمِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡيَوۡمِ", "en": "and the Day", "tr": "wal-yawmi", "audio": "wbw/065_002_024.mp3"}, {"type": "word", "ar": "ٱلْـَٔاخِرِ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَخِرِ‌ۚ", "en": "the Last", "tr": "l-ākhiri", "audio": "wbw/065_002_025.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/065_002_027.mp3"}, {"type": "word", "ar": "يَتَّقِ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َتَّقِ", "en": "fears", "tr": "yattaqi", "audio": "wbw/065_002_028.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/065_002_029.mp3"}, {"type": "word", "ar": "يَجْعَل", "tajweed": "يَ<rule class=qalaqah>جۡ</rule>عَل", "en": "He will make", "tr": "yajʿal", "audio": "wbw/065_002_030.mp3"}, {"type": "word", "ar": "لَّهُۥ", "tajweed": "لَّهُ<rule class=madda_normal>ۥ</rule>", "en": "for him", "tr": "lahu", "audio": "wbw/065_002_031.mp3"}, {"type": "word", "ar": "مَخْرَجًۭا", "tajweed": "مَخۡرَجًا", "en": "a way out", "tr": "makhrajan", "audio": "wbw/065_002_032.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "65:3", "juz": 28, "page": 558, "side_trans": "And will provide for him from where he does not expect. And whoever relies upon Allāh - then He is sufficient for him. Indeed, Allāh will accomplish His purpose. Allāh has already set for everything a [decreed] extent.", "words": [{"type": "word", "ar": "وَيَرْزُقْهُ", "tajweed": "وَيَرۡزُ<rule class=qalaqah>قۡ</rule>هُ", "en": "And He will provide for him", "tr": "wayarzuq'hu", "audio": "wbw/065_003_001.mp3"}, {"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "from", "tr": "min", "audio": "wbw/065_003_002.mp3"}, {"type": "word", "ar": "حَيْثُ", "tajweed": "حَيۡثُ", "en": "where", "tr": "ḥaythu", "audio": "wbw/065_003_003.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/065_003_004.mp3"}, {"type": "word", "ar": "يَحْتَسِبُ ۚ", "tajweed": "يَحۡتَسِبُ‌ۚ", "en": "he thinks", "tr": "yaḥtasibu", "audio": "wbw/065_003_005.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/065_003_007.mp3"}, {"type": "word", "ar": "يَتَوَكَّلْ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َتَوَكَّلۡ", "en": "puts his trust", "tr": "yatawakkal", "audio": "wbw/065_003_008.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "upon", "tr": "ʿalā", "audio": "wbw/065_003_009.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/065_003_010.mp3"}, {"type": "word", "ar": "فَهُوَ", "tajweed": "فَهُوَ", "en": "then He", "tr": "fahuwa", "audio": "wbw/065_003_011.mp3"}, {"type": "word", "ar": "حَسْبُهُۥٓ ۚ", "tajweed": "حَسۡبُهُ<rule class=madda_obligatory_monfasel>ۥٓ‌ۚ</rule>", "en": "(is) sufficient for him", "tr": "ḥasbuhu", "audio": "wbw/065_003_012.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/065_003_014.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/065_003_015.mp3"}, {"type": "word", "ar": "بَـٰلِغُ", "tajweed": "بَ<rule class=madda_normal>ـٰ</rule>لِغُ", "en": "(will) accomplish", "tr": "bālighu", "audio": "wbw/065_003_016.mp3"}, {"type": "word", "ar": "أَمْرِهِۦ ۚ", "tajweed": "أَمۡرِه<rule class=madda_normal>ِۦ</rule>‌ۚ", "en": "His purpose", "tr": "amrihi", "audio": "wbw/065_003_017.mp3"}, {"type": "word", "ar": "قَدْ", "tajweed": "قَ<rule class=qalaqah>دۡ</rule>", "en": "Indeed", "tr": "qad", "audio": "wbw/065_003_019.mp3"}, {"type": "word", "ar": "جَعَلَ", "tajweed": "جَعَلَ", "en": "has set", "tr": "jaʿala", "audio": "wbw/065_003_020.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/065_003_021.mp3"}, {"type": "word", "ar": "لِكُلِّ", "tajweed": "لِكُلِّ", "en": "for every", "tr": "likulli", "audio": "wbw/065_003_022.mp3"}, {"type": "word", "ar": "شَىْءٍۢ", "tajweed": "ش<rule class=ikhafa>َىۡءٍ</rule>", "en": "thing", "tr": "shayin", "audio": "wbw/065_003_023.mp3"}, {"type": "word", "ar": "قَدْرًۭا", "tajweed": "<rule class=ikhafa>ق</rule>َ<rule class=qalaqah>دۡ</rule>رًا", "en": "a measure", "tr": "qadran", "audio": "wbw/065_003_024.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "65:4", "juz": 28, "page": 558, "side_trans": "And those who no longer expect menstruation among your women - if you doubt, then their period is three months, and [also for] those who have not menstruated. And for those who are pregnant, their term is until they give birth. And whoever fears Allāh - He will make for him of his matter ease.", "words": [{"type": "word", "ar": "وَٱلَّـٰٓـِٔى", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّ<rule class=madda_obligatory_mottasel>ــٰٓ</rule>ــِٔى", "en": "And those who", "tr": "wa-allāī", "audio": "wbw/065_004_001.mp3"}, {"type": "word", "ar": "يَئِسْنَ", "tajweed": "يَئِسۡنَ", "en": "have despaired", "tr": "ya-is'na", "audio": "wbw/065_004_002.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "of", "tr": "mina", "audio": "wbw/065_004_003.mp3"}, {"type": "word", "ar": "ٱلْمَحِيضِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَحِيضِ", "en": "the menstruation", "tr": "l-maḥīḍi", "audio": "wbw/065_004_004.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_ghunnah>ِن</rule>", "en": "among", "tr": "min", "audio": "wbw/065_004_005.mp3"}, {"type": "word", "ar": "نِّسَآئِكُمْ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>ِّس<rule class=madda_obligatory_mottasel>َا</rule>ٓئِكُمۡ", "en": "your women", "tr": "nisāikum", "audio": "wbw/065_004_006.mp3"}, {"type": "word", "ar": "إِنِ", "tajweed": "إِنِ", "en": "if", "tr": "ini", "audio": "wbw/065_004_007.mp3"}, {"type": "word", "ar": "ٱرْتَبْتُمْ", "tajweed": "<rule class=ham_wasl>ٱ</rule>رۡتَ<rule class=qalaqah>بۡ</rule>تُمۡ", "en": "you doubt", "tr": "ir'tabtum", "audio": "wbw/065_004_008.mp3"}, {"type": "word", "ar": "فَعِدَّتُهُنَّ", "tajweed": "فَعِدَّتُهُ<rule class=ghunnah>نّ</rule>َ", "en": "then their waiting period", "tr": "faʿiddatuhunna", "audio": "wbw/065_004_009.mp3"}, {"type": "word", "ar": "ثَلَـٰثَةُ", "tajweed": "ثَلَ<rule class=madda_normal>ـٰ</rule>ثَةُ", "en": "(is) three", "tr": "thalāthatu", "audio": "wbw/065_004_010.mp3"}, {"type": "word", "ar": "أَشْهُرٍۢ", "tajweed": "أَشۡهُ<rule class=idgham_ghunnah>رٍ</rule>", "en": "months", "tr": "ashhurin", "audio": "wbw/065_004_011.mp3"}, {"type": "word", "ar": "وَٱلَّـٰٓـِٔى", "tajweed": "<rule class=idgham_ghunnah>و</rule>َ<rule class=ham_wasl>ٱ</rule>لَّ<rule class=madda_obligatory_mottasel>ــٰٓ</rule>ــِٔى", "en": "and the ones who", "tr": "wa-allāī", "audio": "wbw/065_004_012.mp3"}, {"type": "word", "ar": "لَمْ", "tajweed": "لَمۡ", "en": "not", "tr": "lam", "audio": "wbw/065_004_013.mp3"}, {"type": "word", "ar": "يَحِضْنَ ۚ", "tajweed": "يَحِضۡنَ‌ۚ", "en": "[they] menstruated", "tr": "yaḥiḍ'na", "audio": "wbw/065_004_014.mp3"}, {"type": "word", "ar": "وَأُو۟لَـٰتُ", "tajweed": "وَأُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_normal>ـٰ</rule>تُ", "en": "And those who (are)", "tr": "wa-ulātu", "audio": "wbw/065_004_016.mp3"}, {"type": "word", "ar": "ٱلْأَحْمَالِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَحۡمَالِ", "en": "pregnant", "tr": "l-aḥmāli", "audio": "wbw/065_004_017.mp3"}, {"type": "word", "ar": "أَجَلُهُنَّ", "tajweed": "أَجَلُهُ<rule class=ghunnah>نّ</rule>َ", "en": "their term", "tr": "ajaluhunna", "audio": "wbw/065_004_018.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "until", "tr": "an", "audio": "wbw/065_004_019.mp3"}, {"type": "word", "ar": "يَضَعْنَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َضَعۡنَ", "en": "they deliver", "tr": "yaḍaʿna", "audio": "wbw/065_004_020.mp3"}, {"type": "word", "ar": "حَمْلَهُنَّ ۚ", "tajweed": "حَمۡلَهُ<rule class=ghunnah>نّ</rule>َ‌ۚ", "en": "their burdens", "tr": "ḥamlahunna", "audio": "wbw/065_004_021.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/065_004_023.mp3"}, {"type": "word", "ar": "يَتَّقِ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َتَّقِ", "en": "fears", "tr": "yattaqi", "audio": "wbw/065_004_024.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/065_004_025.mp3"}, {"type": "word", "ar": "يَجْعَل", "tajweed": "يَ<rule class=qalaqah>جۡ</rule>عَل", "en": "He will make", "tr": "yajʿal", "audio": "wbw/065_004_026.mp3"}, {"type": "word", "ar": "لَّهُۥ", "tajweed": "لَّهُ<rule class=madda_normal>ۥ</rule>", "en": "for him", "tr": "lahu", "audio": "wbw/065_004_027.mp3"}, {"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "of", "tr": "min", "audio": "wbw/065_004_028.mp3"}, {"type": "word", "ar": "أَمْرِهِۦ", "tajweed": "أَمۡرِه<rule class=madda_normal>ِۦ</rule>", "en": "his affair", "tr": "amrihi", "audio": "wbw/065_004_029.mp3"}, {"type": "word", "ar": "يُسْرًۭا", "tajweed": "يُسۡرًا", "en": "ease", "tr": "yus'ran", "audio": "wbw/065_004_030.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "65:5", "juz": 28, "page": 558, "side_trans": "That is the command of Allāh, which He has sent down to you; and whoever fears Allāh - He will remove for him his misdeeds and make great for him his reward.", "words": [{"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "That", "tr": "dhālika", "audio": "wbw/065_005_001.mp3"}, {"type": "word", "ar": "أَمْرُ", "tajweed": "أَمۡرُ", "en": "(is the) Command", "tr": "amru", "audio": "wbw/065_005_002.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/065_005_003.mp3"}, {"type": "word", "ar": "أَنزَلَهُۥٓ", "tajweed": "أَ<rule class=ikhafa>نز</rule>َلَهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "which He has sent down", "tr": "anzalahu", "audio": "wbw/065_005_004.mp3"}, {"type": "word", "ar": "إِلَيْكُمْ ۚ", "tajweed": "إِلَيۡكُمۡ‌ۚ", "en": "to you", "tr": "ilaykum", "audio": "wbw/065_005_005.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "and whoever", "tr": "waman", "audio": "wbw/065_005_007.mp3"}, {"type": "word", "ar": "يَتَّقِ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َتَّقِ", "en": "fears", "tr": "yattaqi", "audio": "wbw/065_005_008.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/065_005_009.mp3"}, {"type": "word", "ar": "يُكَفِّرْ", "tajweed": "يُكَفِّرۡ", "en": "He will remove", "tr": "yukaffir", "audio": "wbw/065_005_010.mp3"}, {"type": "word", "ar": "عَنْهُ", "tajweed": "عَنۡهُ", "en": "from him", "tr": "ʿanhu", "audio": "wbw/065_005_011.mp3"}, {"type": "word", "ar": "سَيِّـَٔاتِهِۦ", "tajweed": "سَيِّـَٔـاتِه<rule class=madda_normal>ِۦ</rule>", "en": "his evil deeds", "tr": "sayyiātihi", "audio": "wbw/065_005_012.mp3"}, {"type": "word", "ar": "وَيُعْظِمْ", "tajweed": "وَيُعۡظِمۡ", "en": "and make great", "tr": "wayuʿ'ẓim", "audio": "wbw/065_005_013.mp3"}, {"type": "word", "ar": "لَهُۥٓ", "tajweed": "لَهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "for him", "tr": "lahu", "audio": "wbw/065_005_014.mp3"}, {"type": "word", "ar": "أَجْرًا", "tajweed": "أَ<rule class=qalaqah>جۡ</rule>رًا", "en": "(his) reward", "tr": "ajran", "audio": "wbw/065_005_015.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "65:6", "juz": 28, "page": 559, "side_trans": "Lodge them [in a section] of where you dwell out of your means and do not harm them in order to oppress them. And if they should be pregnant, then spend on them until they give birth. And if they breastfeed for you, then give them their payment and confer among yourselves in the acceptable way; but if you are in discord, then there may breastfeed for him [i.e., the father] another woman.", "words": [{"type": "word", "ar": "أَسْكِنُوهُنَّ", "tajweed": "أَسۡكِنُوهُ<rule class=ghunnah>نّ</rule>َ", "en": "Lodge them", "tr": "askinūhunna", "audio": "wbw/065_006_001.mp3"}, {"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "from", "tr": "min", "audio": "wbw/065_006_002.mp3"}, {"type": "word", "ar": "حَيْثُ", "tajweed": "حَيۡثُ", "en": "where", "tr": "ḥaythu", "audio": "wbw/065_006_003.mp3"}, {"type": "word", "ar": "سَكَنتُم", "tajweed": "سَكَ<rule class=ikhafa>نت</rule><rule class=idgham_shafawi>ُم</rule>", "en": "you dwell", "tr": "sakantum", "audio": "wbw/065_006_004.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_shafawi>م</rule>ّ<rule class=idgham_ghunnah>ِن</rule>", "en": "(out) of", "tr": "min", "audio": "wbw/065_006_005.mp3"}, {"type": "word", "ar": "وُجْدِكُمْ", "tajweed": "<rule class=idgham_ghunnah>و</rule>ُ<rule class=qalaqah>جۡ</rule>دِكُمۡ", "en": "your means", "tr": "wuj'dikum", "audio": "wbw/065_006_006.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "and (do) not", "tr": "walā", "audio": "wbw/065_006_007.mp3"}, {"type": "word", "ar": "تُضَآرُّوهُنَّ", "tajweed": "تُض<rule class=madda_necessary>َا</rule>ٓرُّوهُ<rule class=ghunnah>نّ</rule>َ", "en": "harm them", "tr": "tuḍārrūhunna", "audio": "wbw/065_006_008.mp3"}, {"type": "word", "ar": "لِتُضَيِّقُوا۟", "tajweed": "لِتُضَيِّقُو<rule class=slnt>اۡ</rule>", "en": "to distress", "tr": "lituḍayyiqū", "audio": "wbw/065_006_009.mp3"}, {"type": "word", "ar": "عَلَيْهِنَّ ۚ", "tajweed": "عَلَيۡهِ<rule class=ghunnah>نّ</rule>َ‌ۚ", "en": "[on] them", "tr": "ʿalayhinna", "audio": "wbw/065_006_010.mp3"}, {"type": "word", "ar": "وَإِن", "tajweed": "وَإِ<rule class=ikhafa>ن</rule>", "en": "And if", "tr": "wa-in", "audio": "wbw/065_006_012.mp3"}, {"type": "word", "ar": "كُنَّ", "tajweed": "<rule class=ikhafa>ك</rule>ُ<rule class=ghunnah>نّ</rule>َ", "en": "they are", "tr": "kunna", "audio": "wbw/065_006_013.mp3"}, {"type": "word", "ar": "أُو۟لَـٰتِ", "tajweed": "أُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "those (who are)", "tr": "ulāti", "audio": "wbw/065_006_014.mp3"}, {"type": "word", "ar": "حَمْلٍۢ", "tajweed": "حَمۡ<rule class=ikhafa>لٍ</rule>", "en": "pregnant", "tr": "ḥamlin", "audio": "wbw/065_006_015.mp3"}, {"type": "word", "ar": "فَأَنفِقُوا۟", "tajweed": "<rule class=ikhafa>ف</rule>َأَ<rule class=ikhafa>نف</rule>ِقُو<rule class=slnt>اۡ</rule>", "en": "then spend", "tr": "fa-anfiqū", "audio": "wbw/065_006_016.mp3"}, {"type": "word", "ar": "عَلَيْهِنَّ", "tajweed": "عَلَيۡهِ<rule class=ghunnah>نّ</rule>َ", "en": "on them", "tr": "ʿalayhinna", "audio": "wbw/065_006_017.mp3"}, {"type": "word", "ar": "حَتَّىٰ", "tajweed": "حَتَّىٰ", "en": "until", "tr": "ḥattā", "audio": "wbw/065_006_018.mp3"}, {"type": "word", "ar": "يَضَعْنَ", "tajweed": "يَضَعۡنَ", "en": "they deliver", "tr": "yaḍaʿna", "audio": "wbw/065_006_019.mp3"}, {"type": "word", "ar": "حَمْلَهُنَّ ۚ", "tajweed": "حَمۡلَهُ<rule class=ghunnah>نّ</rule>َ‌ۚ", "en": "their burden", "tr": "ḥamlahunna", "audio": "wbw/065_006_020.mp3"}, {"type": "word", "ar": "فَإِنْ", "tajweed": "فَإِنۡ", "en": "Then if", "tr": "fa-in", "audio": "wbw/065_006_022.mp3"}, {"type": "word", "ar": "أَرْضَعْنَ", "tajweed": "أَرۡضَعۡنَ", "en": "they suckle", "tr": "arḍaʿna", "audio": "wbw/065_006_023.mp3"}, {"type": "word", "ar": "لَكُمْ", "tajweed": "لَكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/065_006_024.mp3"}, {"type": "word", "ar": "فَـَٔاتُوهُنَّ", "tajweed": "فَـَٔـاتُوهُ<rule class=ghunnah>نّ</rule>َ", "en": "then give them", "tr": "faātūhunna", "audio": "wbw/065_006_025.mp3"}, {"type": "word", "ar": "أُجُورَهُنَّ ۖ", "tajweed": "أُجُورَهُ<rule class=ghunnah>نّ</rule>َ‌ۖ", "en": "their payment", "tr": "ujūrahunna", "audio": "wbw/065_006_026.mp3"}, {"type": "word", "ar": "وَأْتَمِرُوا۟", "tajweed": "وَأۡتَمِرُو<rule class=slnt>اۡ</rule>", "en": "and consult", "tr": "watamirū", "audio": "wbw/065_006_028.mp3"}, {"type": "word", "ar": "بَيْنَكُم", "tajweed": "بَيۡنَك<rule class=ikhafa_shafawi>ُم</rule>", "en": "among yourselves", "tr": "baynakum", "audio": "wbw/065_006_029.mp3"}, {"type": "word", "ar": "بِمَعْرُوفٍۢ ۖ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِمَعۡرُو<rule class=idgham_ghunnah>فٍ‌ۖ</rule>", "en": "with kindness", "tr": "bimaʿrūfin", "audio": "wbw/065_006_030.mp3"}, {"type": "word", "ar": "وَإِن", "tajweed": "<rule class=idgham_ghunnah>و</rule>َإِ<rule class=ikhafa>ن</rule>", "en": "but if", "tr": "wa-in", "audio": "wbw/065_006_032.mp3"}, {"type": "word", "ar": "تَعَاسَرْتُمْ", "tajweed": "<rule class=ikhafa>ت</rule>َعَاسَرۡتُمۡ", "en": "you disagree", "tr": "taʿāsartum", "audio": "wbw/065_006_033.mp3"}, {"type": "word", "ar": "فَسَتُرْضِعُ", "tajweed": "فَسَتُرۡضِعُ", "en": "then may suckle", "tr": "fasatur'ḍiʿu", "audio": "wbw/065_006_034.mp3"}, {"type": "word", "ar": "لَهُۥٓ", "tajweed": "لَهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "for him", "tr": "lahu", "audio": "wbw/065_006_035.mp3"}, {"type": "word", "ar": "أُخْرَىٰ", "tajweed": "أُخۡرَىٰ", "en": "another (women)", "tr": "ukh'rā", "audio": "wbw/065_006_036.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "65:7", "juz": 28, "page": 559, "side_trans": "Let a man of wealth spend from his wealth, and he whose provision is restricted - let him spend from what Allāh has given him. Allāh does not charge a soul except [according to] what He has given it. Allāh will bring about, after hardship, ease [i.e., relief].", "words": [{"type": "word", "ar": "لِيُنفِقْ", "tajweed": "لِيُ<rule class=ikhafa>نف</rule>ِ<rule class=qalaqah>قۡ</rule>", "en": "Let spend", "tr": "liyunfiq", "audio": "wbw/065_007_001.mp3"}, {"type": "word", "ar": "ذُو", "tajweed": "ذُو", "en": "owner", "tr": "dhū", "audio": "wbw/065_007_002.mp3"}, {"type": "word", "ar": "سَعَةٍۢ", "tajweed": "سَعَ<rule class=idgham_ghunnah>ةٍ</rule>", "en": "(of) ample means", "tr": "saʿatin", "audio": "wbw/065_007_003.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/065_007_004.mp3"}, {"type": "word", "ar": "سَعَتِهِۦ ۖ", "tajweed": "<rule class=ikhafa>س</rule>َعَتِه<rule class=madda_normal>ِۦ</rule>‌ۖ", "en": "his ample means", "tr": "saʿatihi", "audio": "wbw/065_007_005.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَمَ<rule class=ikhafa>ن</rule>", "en": "and (he) who", "tr": "waman", "audio": "wbw/065_007_007.mp3"}, {"type": "word", "ar": "قُدِرَ", "tajweed": "<rule class=ikhafa>ق</rule>ُدِرَ", "en": "is restricted", "tr": "qudira", "audio": "wbw/065_007_008.mp3"}, {"type": "word", "ar": "عَلَيْهِ", "tajweed": "عَلَيۡهِ", "en": "on him", "tr": "ʿalayhi", "audio": "wbw/065_007_009.mp3"}, {"type": "word", "ar": "رِزْقُهُۥ", "tajweed": "رِزۡقُهُ<rule class=madda_normal>ۥ</rule>", "en": "his provision", "tr": "riz'quhu", "audio": "wbw/065_007_010.mp3"}, {"type": "word", "ar": "فَلْيُنفِقْ", "tajweed": "فَلۡيُ<rule class=ikhafa>نف</rule>ِ<rule class=qalaqah>قۡ</rule>", "en": "let him spend", "tr": "falyunfiq", "audio": "wbw/065_007_011.mp3"}, {"type": "word", "ar": "مِمَّآ", "tajweed": "مِ<rule class=ghunnah>مّ</rule><rule class=madda_obligatory_monfasel>َآ</rule>", "en": "from what", "tr": "mimmā", "audio": "wbw/065_007_012.mp3"}, {"type": "word", "ar": "ءَاتَىٰهُ", "tajweed": "ءَاتَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "he has been given", "tr": "ātāhu", "audio": "wbw/065_007_013.mp3"}, {"type": "word", "ar": "ٱللَّهُ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ‌ۚ", "en": "(by) Allah", "tr": "l-lahu", "audio": "wbw/065_007_014.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "Does not", "tr": "lā", "audio": "wbw/065_007_016.mp3"}, {"type": "word", "ar": "يُكَلِّفُ", "tajweed": "يُكَلِّفُ", "en": "burden", "tr": "yukallifu", "audio": "wbw/065_007_017.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/065_007_018.mp3"}, {"type": "word", "ar": "نَفْسًا", "tajweed": "نَفۡسًا", "en": "any soul", "tr": "nafsan", "audio": "wbw/065_007_019.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/065_007_020.mp3"}, {"type": "word", "ar": "مَآ", "tajweed": "م<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "(with) what", "tr": "mā", "audio": "wbw/065_007_021.mp3"}, {"type": "word", "ar": "ءَاتَىٰهَا ۚ", "tajweed": "ءَاتَ<rule class=madda_normal>ـٰ</rule>هَا‌ۚ", "en": "He has given it", "tr": "ātāhā", "audio": "wbw/065_007_022.mp3"}, {"type": "word", "ar": "سَيَجْعَلُ", "tajweed": "سَيَ<rule class=qalaqah>جۡ</rule>عَلُ", "en": "Will bring about", "tr": "sayajʿalu", "audio": "wbw/065_007_024.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/065_007_025.mp3"}, {"type": "word", "ar": "بَعْدَ", "tajweed": "بَعۡدَ", "en": "after", "tr": "baʿda", "audio": "wbw/065_007_026.mp3"}, {"type": "word", "ar": "عُسْرٍۢ", "tajweed": "عُسۡ<rule class=idgham_ghunnah>رٍ</rule>", "en": "hardship", "tr": "ʿus'rin", "audio": "wbw/065_007_027.mp3"}, {"type": "word", "ar": "يُسْرًۭا", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُسۡرًا", "en": "ease", "tr": "yus'ran", "audio": "wbw/065_007_028.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "65:8", "juz": 28, "page": 559, "side_trans": "And how many a city was insolent toward the command of its Lord and His messengers, so We took it to severe account and punished it with a terrible punishment.", "words": [{"type": "word", "ar": "وَكَأَيِّن", "tajweed": "وَكَأَيّ<rule class=idgham_ghunnah>ِن</rule>", "en": "And how many", "tr": "waka-ayyin", "audio": "wbw/065_008_001.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّ<rule class=ikhafa>ن</rule>", "en": "of", "tr": "min", "audio": "wbw/065_008_002.mp3"}, {"type": "word", "ar": "قَرْيَةٍ", "tajweed": "<rule class=ikhafa>ق</rule>َرۡيَةٍ", "en": "a town", "tr": "qaryatin", "audio": "wbw/065_008_003.mp3"}, {"type": "word", "ar": "عَتَتْ", "tajweed": "عَتَتۡ", "en": "rebelled", "tr": "ʿatat", "audio": "wbw/065_008_004.mp3"}, {"type": "word", "ar": "عَنْ", "tajweed": "عَنۡ", "en": "against", "tr": "ʿan", "audio": "wbw/065_008_005.mp3"}, {"type": "word", "ar": "أَمْرِ", "tajweed": "أَمۡرِ", "en": "(the) Command", "tr": "amri", "audio": "wbw/065_008_006.mp3"}, {"type": "word", "ar": "رَبِّهَا", "tajweed": "رَبِّهَا", "en": "(of) its Lord", "tr": "rabbihā", "audio": "wbw/065_008_007.mp3"}, {"type": "word", "ar": "وَرُسُلِهِۦ", "tajweed": "وَرُسُلِه<rule class=madda_normal>ِۦ</rule>", "en": "and His Messengers", "tr": "warusulihi", "audio": "wbw/065_008_008.mp3"}, {"type": "word", "ar": "فَحَاسَبْنَـٰهَا", "tajweed": "فَحَاسَ<rule class=qalaqah>بۡ</rule>نَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "so We took it to account", "tr": "faḥāsabnāhā", "audio": "wbw/065_008_009.mp3"}, {"type": "word", "ar": "حِسَابًۭا", "tajweed": "حِسَا<rule class=ikhafa>بًا</rule>", "en": "an account", "tr": "ḥisāban", "audio": "wbw/065_008_010.mp3"}, {"type": "word", "ar": "شَدِيدًۭا", "tajweed": "<rule class=ikhafa>ش</rule>َدِي<rule class=idgham_ghunnah>دًا</rule>", "en": "severe", "tr": "shadīdan", "audio": "wbw/065_008_011.mp3"}, {"type": "word", "ar": "وَعَذَّبْنَـٰهَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َعَذَّ<rule class=qalaqah>بۡ</rule>نَ<rule class=madda_normal>ـٰ</rule>هَا", "en": "and We punished it", "tr": "waʿadhabnāhā", "audio": "wbw/065_008_012.mp3"}, {"type": "word", "ar": "عَذَابًۭا", "tajweed": "عَذَا<rule class=idgham_ghunnah>بًا</rule>", "en": "a punishment", "tr": "ʿadhāban", "audio": "wbw/065_008_013.mp3"}, {"type": "word", "ar": "نُّكْرًۭا", "tajweed": "<rule class=idgham_ghunnah>ن</rule>ُّكۡرًا", "en": "terrible", "tr": "nuk'ran", "audio": "wbw/065_008_014.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "65:9", "juz": 28, "page": 559, "side_trans": "And it tasted the bad consequence of its affair [i.e., rebellion], and the outcome of its affair was loss.", "words": [{"type": "word", "ar": "فَذَاقَتْ", "tajweed": "فَذَاقَتۡ", "en": "So it tasted", "tr": "fadhāqat", "audio": "wbw/065_009_001.mp3"}, {"type": "word", "ar": "وَبَالَ", "tajweed": "وَبَالَ", "en": "(the bad) consequence", "tr": "wabāla", "audio": "wbw/065_009_002.mp3"}, {"type": "word", "ar": "أَمْرِهَا", "tajweed": "أَمۡرِهَا", "en": "(of) its affair", "tr": "amrihā", "audio": "wbw/065_009_003.mp3"}, {"type": "word", "ar": "وَكَانَ", "tajweed": "وَكَانَ", "en": "and was", "tr": "wakāna", "audio": "wbw/065_009_004.mp3"}, {"type": "word", "ar": "عَـٰقِبَةُ", "tajweed": "عَ<rule class=madda_normal>ـٰ</rule>قِبَةُ", "en": "(the) end", "tr": "ʿāqibatu", "audio": "wbw/065_009_005.mp3"}, {"type": "word", "ar": "أَمْرِهَا", "tajweed": "أَمۡرِهَا", "en": "(of) its affair", "tr": "amrihā", "audio": "wbw/065_009_006.mp3"}, {"type": "word", "ar": "خُسْرًا", "tajweed": "خُسۡرًا", "en": "loss", "tr": "khus'ran", "audio": "wbw/065_009_007.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "65:10", "juz": 28, "page": 559, "side_trans": "Allāh has prepared for them a severe punishment; so fear Allāh, O you of understanding who have believed. Allāh has sent down to you a message [i.e., the Qur’ān].", "words": [{"type": "word", "ar": "أَعَدَّ", "tajweed": "أَعَدَّ", "en": "Has prepared", "tr": "aʿadda", "audio": "wbw/065_010_001.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/065_010_002.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "for them", "tr": "lahum", "audio": "wbw/065_010_003.mp3"}, {"type": "word", "ar": "عَذَابًۭا", "tajweed": "عَذَا<rule class=ikhafa>بًا</rule>", "en": "a punishment", "tr": "ʿadhāban", "audio": "wbw/065_010_004.mp3"}, {"type": "word", "ar": "شَدِيدًۭا ۖ", "tajweed": "<rule class=ikhafa>ش</rule>َدِي<rule class=ikhafa>دًا‌ۖ</rule>", "en": "severe", "tr": "shadīdan", "audio": "wbw/065_010_005.mp3"}, {"type": "word", "ar": "فَٱتَّقُوا۟", "tajweed": "<rule class=ikhafa>ف</rule>َ<rule class=ham_wasl>ٱ</rule>تَّقُو<rule class=slnt>اۡ</rule>", "en": "So fear", "tr": "fa-ittaqū", "audio": "wbw/065_010_007.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/065_010_008.mp3"}, {"type": "word", "ar": "يَـٰٓأُو۟لِى", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أُ<rule class=slnt>وۡ</rule>لِى", "en": "O men", "tr": "yāulī", "audio": "wbw/065_010_009.mp3"}, {"type": "word", "ar": "ٱلْأَلْبَـٰبِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَلۡبَ<rule class=madda_normal>ـٰ</rule>بِ", "en": "(of) understanding", "tr": "l-albābi", "audio": "wbw/065_010_010.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/065_010_011.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟ ۚ", "tajweed": "ءَامَنُو<rule class=slnt>اۡ‌ۚ</rule>", "en": "have believed", "tr": "āmanū", "audio": "wbw/065_010_012.mp3"}, {"type": "word", "ar": "قَدْ", "tajweed": "قَ<rule class=qalaqah>دۡ</rule>", "en": "Indeed", "tr": "qad", "audio": "wbw/065_010_014.mp3"}, {"type": "word", "ar": "أَنزَلَ", "tajweed": "أَ<rule class=ikhafa>نز</rule>َلَ", "en": "Has sent down", "tr": "anzala", "audio": "wbw/065_010_015.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/065_010_016.mp3"}, {"type": "word", "ar": "إِلَيْكُمْ", "tajweed": "إِلَيۡكُمۡ", "en": "to you", "tr": "ilaykum", "audio": "wbw/065_010_017.mp3"}, {"type": "word", "ar": "ذِكْرًۭا", "tajweed": "ذِكۡرًا", "en": "a Message", "tr": "dhik'ran", "audio": "wbw/065_010_018.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "65:11", "juz": 28, "page": 559, "side_trans": "[He sent] a Messenger [i.e., Muḥammad (ﷺ)] reciting to you the distinct verses of Allāh that He may bring out those who believe and do righteous deeds from darknesses into the light. And whoever believes in Allāh and does righteousness - He will admit him into gardens beneath which rivers flow to abide therein forever. Allāh will have perfected for him a provision.", "words": [{"type": "word", "ar": "رَّسُولًۭا", "tajweed": "رَّسُول<rule class=idgham_ghunnah>اً</rule>", "en": "A Messenger", "tr": "rasūlan", "audio": "wbw/065_011_001.mp3"}, {"type": "word", "ar": "يَتْلُوا۟", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َتۡلُو<rule class=slnt>اۡ</rule>", "en": "reciting", "tr": "yatlū", "audio": "wbw/065_011_002.mp3"}, {"type": "word", "ar": "عَلَيْكُمْ", "tajweed": "عَلَيۡكُمۡ", "en": "to you", "tr": "ʿalaykum", "audio": "wbw/065_011_003.mp3"}, {"type": "word", "ar": "ءَايَـٰتِ", "tajweed": "ءَايَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "(the) Verses", "tr": "āyāti", "audio": "wbw/065_011_004.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/065_011_005.mp3"}, {"type": "word", "ar": "مُبَيِّنَـٰتٍۢ", "tajweed": "مُبَيِّنَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_wo_ghunnah>تٍ</rule>", "en": "clear", "tr": "mubayyinātin", "audio": "wbw/065_011_006.mp3"}, {"type": "word", "ar": "لِّيُخْرِجَ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّيُخۡرِجَ", "en": "that he may bring out", "tr": "liyukh'rija", "audio": "wbw/065_011_007.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/065_011_008.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/065_011_009.mp3"}, {"type": "word", "ar": "وَعَمِلُوا۟", "tajweed": "وَعَمِلُو<rule class=slnt>اۡ</rule>", "en": "and do", "tr": "waʿamilū", "audio": "wbw/065_011_010.mp3"}, {"type": "word", "ar": "ٱلصَّـٰلِحَـٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّ<rule class=madda_normal>ـٰ</rule>لِحَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "righteous deeds", "tr": "l-ṣāliḥāti", "audio": "wbw/065_011_011.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "from", "tr": "mina", "audio": "wbw/065_011_012.mp3"}, {"type": "word", "ar": "ٱلظُّلُمَـٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ظُّلُمَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "the darkness[es]", "tr": "l-ẓulumāti", "audio": "wbw/065_011_013.mp3"}, {"type": "word", "ar": "إِلَى", "tajweed": "إِلَى", "en": "towards", "tr": "ilā", "audio": "wbw/065_011_014.mp3"}, {"type": "word", "ar": "ٱلنُّورِ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>ُورِ‌ۚ", "en": "the light", "tr": "l-nūri", "audio": "wbw/065_011_015.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/065_011_017.mp3"}, {"type": "word", "ar": "يُؤْمِنۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُؤۡم<rule class=iqlab>ِنۢ</rule>", "en": "believes", "tr": "yu'min", "audio": "wbw/065_011_018.mp3"}, {"type": "word", "ar": "بِٱللَّهِ", "tajweed": "<rule class=iqlab>ب</rule>ِ<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "in Allah", "tr": "bil-lahi", "audio": "wbw/065_011_019.mp3"}, {"type": "word", "ar": "وَيَعْمَلْ", "tajweed": "وَيَعۡمَلۡ", "en": "and does", "tr": "wayaʿmal", "audio": "wbw/065_011_020.mp3"}, {"type": "word", "ar": "صَـٰلِحًۭا", "tajweed": "صَ<rule class=madda_normal>ـٰ</rule>لِ<rule class=idgham_ghunnah>حًا</rule>", "en": "righteous deeds", "tr": "ṣāliḥan", "audio": "wbw/065_011_021.mp3"}, {"type": "word", "ar": "يُدْخِلْهُ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُ<rule class=qalaqah>دۡ</rule>خِلۡهُ", "en": "He will admit him", "tr": "yud'khil'hu", "audio": "wbw/065_011_022.mp3"}, {"type": "word", "ar": "جَنَّـٰتٍۢ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule><rule class=ikhafa>تٍ</rule>", "en": "(into) Gardens", "tr": "jannātin", "audio": "wbw/065_011_023.mp3"}, {"type": "word", "ar": "تَجْرِى", "tajweed": "<rule class=ikhafa>ت</rule>َ<rule class=qalaqah>جۡ</rule>رِى", "en": "flow", "tr": "tajrī", "audio": "wbw/065_011_024.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/065_011_025.mp3"}, {"type": "word", "ar": "تَحْتِهَا", "tajweed": "<rule class=ikhafa>ت</ru