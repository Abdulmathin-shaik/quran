[{"id": 1, "key": "86:1", "juz": 30, "page": 591, "side_trans": "By the sky and the night comer", "words": [{"type": "word", "ar": "وَٱلسَّمَآءِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءِ", "en": "By the sky", "tr": "wal-samāi", "audio": "wbw/086_001_001.mp3"}, {"type": "word", "ar": "وَٱلطَّارِقِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>طَّارِ<rule class=qalaqah>ق</rule>ِ", "en": "and the night comer", "tr": "wal-ṭāriqi", "audio": "wbw/086_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "86:2", "juz": 30, "page": 591, "side_trans": "And what can make you know what is the night comer?", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And what", "tr": "wamā", "audio": "wbw/086_002_001.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "can make you know", "tr": "adrāka", "audio": "wbw/086_002_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/086_002_003.mp3"}, {"type": "word", "ar": "ٱلطَّارِقُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>طَّارِ<rule class=qalaqah>ق</rule>ُ", "en": "the night comer (is)", "tr": "l-ṭāriqu", "audio": "wbw/086_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "86:3", "juz": 30, "page": 591, "side_trans": "It is the piercing star", "words": [{"type": "word", "ar": "ٱلنَّجْمُ", "tajweed": "ٱ<rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َ<rule class=qalaqah>جۡ</rule>مُ", "en": "(It is) the star", "tr": "al-najmu", "audio": "wbw/086_003_001.mp3"}, {"type": "word", "ar": "ٱلثَّاقِبُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ثَّاقِ<rule class=qalaqah>ب</rule>ُ", "en": "the piercing", "tr": "l-thāqibu", "audio": "wbw/086_003_002.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "86:4", "juz": 30, "page": 591, "side_trans": "There is no soul but that it has over it a protector.", "words": [{"type": "word", "ar": "إِن", "tajweed": "إِ<rule class=ikhafa>ن</rule>", "en": "Not", "tr": "in", "audio": "wbw/086_004_001.mp3"}, {"type": "word", "ar": "كُلُّ", "tajweed": "<rule class=ikhafa>ك</rule>ُلُّ", "en": "(is) every", "tr": "kullu", "audio": "wbw/086_004_002.mp3"}, {"type": "word", "ar": "نَفْسٍۢ", "tajweed": "نَفۡ<rule class=idgham_wo_ghunnah>سٍ</rule>", "en": "soul", "tr": "nafsin", "audio": "wbw/086_004_003.mp3"}, {"type": "word", "ar": "لَّمَّا", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّ<rule class=ghunnah>مّ</rule>َا", "en": "but", "tr": "lammā", "audio": "wbw/086_004_004.mp3"}, {"type": "word", "ar": "عَلَيْهَا", "tajweed": "عَلَيۡهَا", "en": "over it", "tr": "ʿalayhā", "audio": "wbw/086_004_005.mp3"}, {"type": "word", "ar": "حَافِظٌۭ", "tajweed": "حَافِظٌ", "en": "(is) a protector", "tr": "ḥāfiẓun", "audio": "wbw/086_004_006.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "86:5", "juz": 30, "page": 591, "side_trans": "So let man observe from what he was created.", "words": [{"type": "word", "ar": "فَلْيَنظُرِ", "tajweed": "فَلۡيَ<rule class=ikhafa>نظ</rule>ُرِ", "en": "So let see", "tr": "falyanẓuri", "audio": "wbw/086_005_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "man", "tr": "l-insānu", "audio": "wbw/086_005_002.mp3"}, {"type": "word", "ar": "مِمَّ", "tajweed": "مِ<rule class=ghunnah>مّ</rule>َ", "en": "from what", "tr": "mimma", "audio": "wbw/086_005_003.mp3"}, {"type": "word", "ar": "خُلِقَ", "tajweed": "خُلِ<rule class=qalaqah>ق</rule>َ", "en": "he is created", "tr": "khuliqa", "audio": "wbw/086_005_004.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "86:6", "juz": 30, "page": 591, "side_trans": "He was created from a fluid, ejected,", "words": [{"type": "word", "ar": "خُلِقَ", "tajweed": "خُلِقَ", "en": "He is created", "tr": "khuliqa", "audio": "wbw/086_006_001.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_ghunnah>ِن</rule>", "en": "from", "tr": "min", "audio": "wbw/086_006_002.mp3"}, {"type": "word", "ar": "مَّآءٍۢ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ّ<rule class=madda_obligatory_mottasel>َا</rule>ٓ<rule class=ikhafa>ءٍ</rule>", "en": "a water", "tr": "māin", "audio": "wbw/086_006_003.mp3"}, {"type": "word", "ar": "دَافِقٍۢ", "tajweed": "<rule class=ikhafa>د</rule>َافِ<rule class=qalaqah>ق</rule>ٍ", "en": "ejected", "tr": "dāfiqin", "audio": "wbw/086_006_004.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "86:7", "juz": 30, "page": 591, "side_trans": "Emerging from between the backbone and the ribs.", "words": [{"type": "word", "ar": "يَخْرُجُ", "tajweed": "يَخۡرُجُ", "en": "Coming forth", "tr": "yakhruju", "audio": "wbw/086_007_001.mp3"}, {"type": "word", "ar": "مِنۢ", "tajweed": "م<rule class=iqlab>ِنۢ</rule>", "en": "from", "tr": "min", "audio": "wbw/086_007_002.mp3"}, {"type": "word", "ar": "بَيْنِ", "tajweed": "<rule class=iqlab>ب</rule>َيۡنِ", "en": "between", "tr": "bayni", "audio": "wbw/086_007_003.mp3"}, {"type": "word", "ar": "ٱلصُّلْبِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صُّلۡبِ", "en": "the backbone", "tr": "l-ṣul'bi", "audio": "wbw/086_007_004.mp3"}, {"type": "word", "ar": "وَٱلتَّرَآئِبِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>تَّر<rule class=madda_obligatory_mottasel>َا</rule>ٓئِ<rule class=qalaqah>ب</rule>ِ", "en": "and the ribs", "tr": "wal-tarāibi", "audio": "wbw/086_007_005.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "86:8", "juz": 30, "page": 591, "side_trans": "Indeed, He [i.e., Allāh], to return him [to life], is Able.", "words": [{"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, He", "tr": "innahu", "audio": "wbw/086_008_001.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "to", "tr": "ʿalā", "audio": "wbw/086_008_002.mp3"}, {"type": "word", "ar": "رَجْعِهِۦ", "tajweed": "رَ<rule class=qalaqah>جۡ</rule>عِه<rule class=madda_normal>ِۦ</rule>", "en": "return him", "tr": "rajʿihi", "audio": "wbw/086_008_003.mp3"}, {"type": "word", "ar": "لَقَادِرٌۭ", "tajweed": "لَقَادِرٌ", "en": "(is) Able", "tr": "laqādirun", "audio": "wbw/086_008_004.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "86:9", "juz": 30, "page": 591, "side_trans": "The Day when secrets will be put on trial,", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(The) Day", "tr": "yawma", "audio": "wbw/086_009_001.mp3"}, {"type": "word", "ar": "تُبْلَى", "tajweed": "تُ<rule class=qalaqah>بۡ</rule>لَى", "en": "will be tested", "tr": "tub'lā", "audio": "wbw/086_009_002.mp3"}, {"type": "word", "ar": "ٱلسَّرَآئِرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّر<rule class=madda_obligatory_mottasel>َا</rule>ٓئِرُ", "en": "the secrets", "tr": "l-sarāiru", "audio": "wbw/086_009_003.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "86:10", "juz": 30, "page": 591, "side_trans": "Then he [i.e., man] will have no power or any helper.", "words": [{"type": "word", "ar": "فَمَا", "tajweed": "فَمَا", "en": "Then not", "tr": "famā", "audio": "wbw/086_010_001.mp3"}, {"type": "word", "ar": "لَهُۥ", "tajweed": "لَهُ<rule class=madda_normal>ۥ</rule>", "en": "(is) for him", "tr": "lahu", "audio": "wbw/086_010_002.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "any", "tr": "min", "audio": "wbw/086_010_003.mp3"}, {"type": "word", "ar": "قُوَّةٍۢ", "tajweed": "<rule class=ikhafa>ق</rule>ُوَّ<rule class=idgham_ghunnah>ةٍ</rule>", "en": "power", "tr": "quwwatin", "audio": "wbw/086_010_004.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "and not", "tr": "walā", "audio": "wbw/086_010_005.mp3"}, {"type": "word", "ar": "نَاصِرٍۢ", "tajweed": "نَاصِرٍ", "en": "any helper", "tr": "nāṣirin", "audio": "wbw/086_010_006.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "86:11", "juz": 30, "page": 591, "side_trans": "By the sky which sends back", "words": [{"type": "word", "ar": "وَٱلسَّمَآءِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءِ", "en": "By the sky", "tr": "wal-samāi", "audio": "wbw/086_011_001.mp3"}, {"type": "word", "ar": "ذَاتِ", "tajweed": "ذَاتِ", "en": "which", "tr": "dhāti", "audio": "wbw/086_011_002.mp3"}, {"type": "word", "ar": "ٱلرَّجْعِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رَّ<rule class=qalaqah>جۡ</rule>عِ", "en": "returns", "tr": "l-rajʿi", "audio": "wbw/086_011_003.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "86:12", "juz": 30, "page": 591, "side_trans": "And [by] the earth which splits,", "words": [{"type": "word", "ar": "وَٱلْأَرْضِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "And the earth", "tr": "wal-arḍi", "audio": "wbw/086_012_001.mp3"}, {"type": "word", "ar": "ذَاتِ", "tajweed": "ذَاتِ", "en": "which", "tr": "dhāti", "audio": "wbw/086_012_002.mp3"}, {"type": "word", "ar": "ٱلصَّدْعِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّ<rule class=qalaqah>دۡ</rule>عِ", "en": "cracks open", "tr": "l-ṣadʿi", "audio": "wbw/086_012_003.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "86:13", "juz": 30, "page": 591, "side_trans": "Indeed, it [i.e., the Qur’ān] is a decisive statement,", "words": [{"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, it", "tr": "innahu", "audio": "wbw/086_013_001.mp3"}, {"type": "word", "ar": "لَقَوْلٌۭ", "tajweed": "لَقَوۡ<rule class=ikhafa>لٌ</rule>", "en": "(is) surely a Word", "tr": "laqawlun", "audio": "wbw/086_013_002.mp3"}, {"type": "word", "ar": "فَصْلٌۭ", "tajweed": "<rule class=ikhafa>ف</rule>َصۡلٌ", "en": "decisive", "tr": "faṣlun", "audio": "wbw/086_013_003.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "86:14", "juz": 30, "page": 591, "side_trans": "And it is not amusement.", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/086_014_001.mp3"}, {"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "it", "tr": "huwa", "audio": "wbw/086_014_002.mp3"}, {"type": "word", "ar": "بِٱلْهَزْلِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡهَزۡلِ", "en": "(is) for amusement", "tr": "bil-hazli", "audio": "wbw/086_014_003.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "86:15", "juz": 30, "page": 591, "side_trans": "Indeed, they are planning a plan,", "words": [{"type": "word", "ar": "إِنَّهُمْ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "Indeed, they", "tr": "innahum", "audio": "wbw/086_015_001.mp3"}, {"type": "word", "ar": "يَكِيدُونَ", "tajweed": "يَكِيدُونَ", "en": "are plotting", "tr": "yakīdūna", "audio": "wbw/086_015_002.mp3"}, {"type": "word", "ar": "كَيْدًۭا", "tajweed": "كَيۡدًا", "en": "a plot", "tr": "kaydan", "audio": "wbw/086_015_003.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "86:16", "juz": 30, "page": 591, "side_trans": "But I am planning a plan.", "words": [{"type": "word", "ar": "وَأَكِيدُ", "tajweed": "وَأَكِيدُ", "en": "But I am planning", "tr": "wa-akīdu", "audio": "wbw/086_016_001.mp3"}, {"type": "word", "ar": "كَيْدًۭا", "tajweed": "كَيۡدًا", "en": "a plan", "tr": "kaydan", "audio": "wbw/086_016_002.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "86:17", "juz": 30, "page": 591, "side_trans": "So allow time for the disbelievers. Leave them awhile.", "words": [{"type": "word", "ar": "فَمَهِّلِ", "tajweed": "فَمَهِّلِ", "en": "So give respite", "tr": "famahhili", "audio": "wbw/086_017_001.mp3"}, {"type": "word", "ar": "ٱلْكَـٰفِرِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَ<rule class=madda_normal>ـٰ</rule>فِرِينَ", "en": "(to) the disbelievers", "tr": "l-kāfirīna", "audio": "wbw/086_017_002.mp3"}, {"type": "word", "ar": "أَمْهِلْهُمْ", "tajweed": "أَمۡهِلۡهُمۡ", "en": "Give respite to them ", "tr": "amhil'hum", "audio": "wbw/086_017_003.mp3"}, {"type": "word", "ar": "رُوَيْدًۢا", "tajweed": "رُوَيۡدَۢا", "en": "little", "tr": "ruwaydan", "audio": "wbw/086_017_004.mp3"}, {"type": "end", "num": "١٧"}]}]