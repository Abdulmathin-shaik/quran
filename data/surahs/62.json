[{"id": 1, "key": "62:1", "juz": 28, "page": 553, "side_trans": "Whatever is in the heavens and whatever is on the earth is exalting Allāh, the Sovereign, the Pure, the Exalted in Might, the Wise.", "words": [{"type": "word", "ar": "يُسَبِّحُ", "tajweed": "يُسَبِّحُ", "en": "Glorifies", "tr": "yusabbiḥu", "audio": "wbw/062_001_001.mp3"}, {"type": "word", "ar": "لِلَّهِ", "tajweed": "لِلَّهِ", "en": "Allah", "tr": "lillahi", "audio": "wbw/062_001_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "whatever", "tr": "mā", "audio": "wbw/062_001_003.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(is) in", "tr": "fī", "audio": "wbw/062_001_004.mp3"}, {"type": "word", "ar": "ٱلسَّمَـٰوَٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّمَ<rule class=madda_normal>ـٰ</rule>و<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِ", "en": "the heavens", "tr": "l-samāwāti", "audio": "wbw/062_001_005.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "and whatever", "tr": "wamā", "audio": "wbw/062_001_006.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(is) in", "tr": "fī", "audio": "wbw/062_001_007.mp3"}, {"type": "word", "ar": "ٱلْأَرْضِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "the earth", "tr": "l-arḍi", "audio": "wbw/062_001_008.mp3"}, {"type": "word", "ar": "ٱلْمَلِكِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَلِكِ", "en": "the Sovereign", "tr": "l-maliki", "audio": "wbw/062_001_009.mp3"}, {"type": "word", "ar": "ٱلْقُدُّوسِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقُدُّوسِ", "en": "the Holy", "tr": "l-qudūsi", "audio": "wbw/062_001_010.mp3"}, {"type": "word", "ar": "ٱلْعَزِيزِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَزِيزِ", "en": "the All-Mighty", "tr": "l-ʿazīzi", "audio": "wbw/062_001_011.mp3"}, {"type": "word", "ar": "ٱلْحَكِيمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَك<rule class=madda_permissible>ِي</rule>مِ", "en": "the All-Wise", "tr": "l-ḥakīmi", "audio": "wbw/062_001_012.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "62:2", "juz": 28, "page": 553, "side_trans": "It is He who has sent among the unlettered [Arabs] a Messenger from themselves reciting to them His verses and purifying them and teaching them the Book [i.e., the Qur’ān] and wisdom [i.e., the sunnah] - although they were before in clear error -", "words": [{"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "He", "tr": "huwa", "audio": "wbw/062_002_001.mp3"}, {"type": "word", "ar": "ٱلَّذِى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِى", "en": "(is) the One Who", "tr": "alladhī", "audio": "wbw/062_002_002.mp3"}, {"type": "word", "ar": "بَعَثَ", "tajweed": "بَعَثَ", "en": "sent", "tr": "baʿatha", "audio": "wbw/062_002_003.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "among", "tr": "fī", "audio": "wbw/062_002_004.mp3"}, {"type": "word", "ar": "ٱلْأُمِّيِّـۧنَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأُ<rule class=ghunnah>مّ</rule>ِيِّـ<rule class=madda_normal>ـۧ</rule>نَ", "en": "the unlettered", "tr": "l-umiyīna", "audio": "wbw/062_002_005.mp3"}, {"type": "word", "ar": "رَسُولًۭا", "tajweed": "رَسُول<rule class=idgham_ghunnah>اً</rule>", "en": "a Messenger", "tr": "rasūlan", "audio": "wbw/062_002_006.mp3"}, {"type": "word", "ar": "مِّنْهُمْ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنۡهُمۡ", "en": "from themselves", "tr": "min'hum", "audio": "wbw/062_002_007.mp3"}, {"type": "word", "ar": "يَتْلُوا۟", "tajweed": "يَتۡلُو<rule class=slnt>اۡ</rule>", "en": "reciting", "tr": "yatlū", "audio": "wbw/062_002_008.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ", "tajweed": "عَلَيۡهِمۡ", "en": "to them", "tr": "ʿalayhim", "audio": "wbw/062_002_009.mp3"}, {"type": "word", "ar": "ءَايَـٰتِهِۦ", "tajweed": "ءَايَ<rule class=madda_normal>ـٰ</rule>تِه<rule class=madda_normal>ِۦ</rule>", "en": "His Verses", "tr": "āyātihi", "audio": "wbw/062_002_010.mp3"}, {"type": "word", "ar": "وَيُزَكِّيهِمْ", "tajweed": "وَيُزَكِّيهِمۡ", "en": "and purifying them", "tr": "wayuzakkīhim", "audio": "wbw/062_002_011.mp3"}, {"type": "word", "ar": "وَيُعَلِّمُهُمُ", "tajweed": "وَيُعَلِّمُهُمُ", "en": "and teaching them", "tr": "wayuʿallimuhumu", "audio": "wbw/062_002_012.mp3"}, {"type": "word", "ar": "ٱلْكِتَـٰبَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكِتَ<rule class=madda_normal>ـٰ</rule>بَ", "en": "the Book", "tr": "l-kitāba", "audio": "wbw/062_002_013.mp3"}, {"type": "word", "ar": "وَٱلْحِكْمَةَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡحِكۡمَةَ", "en": "and the wisdom", "tr": "wal-ḥik'mata", "audio": "wbw/062_002_014.mp3"}, {"type": "word", "ar": "وَإِن", "tajweed": "وَإِ<rule class=ikhafa>ن</rule>", "en": "although", "tr": "wa-in", "audio": "wbw/062_002_015.mp3"}, {"type": "word", "ar": "كَانُوا۟", "tajweed": "<rule class=ikhafa>ك</rule>َانُو<rule class=slnt>اۡ</rule>", "en": "they were", "tr": "kānū", "audio": "wbw/062_002_016.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/062_002_017.mp3"}, {"type": "word", "ar": "قَبْلُ", "tajweed": "<rule class=ikhafa>ق</rule>َ<rule class=qalaqah>بۡ</rule>لُ", "en": "before", "tr": "qablu", "audio": "wbw/062_002_018.mp3"}, {"type": "word", "ar": "لَفِى", "tajweed": "لَفِى", "en": "surely in", "tr": "lafī", "audio": "wbw/062_002_019.mp3"}, {"type": "word", "ar": "ضَلَـٰلٍۢ", "tajweed": "ضَلَ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>لٍ</rule>", "en": "an error", "tr": "ḍalālin", "audio": "wbw/062_002_020.mp3"}, {"type": "word", "ar": "مُّبِينٍۢ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّب<rule class=madda_permissible>ِي</rule>نٍ", "en": "clear", "tr": "mubīnin", "audio": "wbw/062_002_021.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "62:3", "juz": 28, "page": 553, "side_trans": "And [to] others of them who have not yet joined them. And He is the Exalted in Might, the Wise.", "words": [{"type": "word", "ar": "وَءَاخَرِينَ", "tajweed": "وَءَاخَرِينَ", "en": "And others", "tr": "waākharīna", "audio": "wbw/062_003_001.mp3"}, {"type": "word", "ar": "مِنْهُمْ", "tajweed": "مِنۡهُمۡ", "en": "among them", "tr": "min'hum", "audio": "wbw/062_003_002.mp3"}, {"type": "word", "ar": "لَمَّا", "tajweed": "لَ<rule class=ghunnah>مّ</rule>َا", "en": "who have not yet", "tr": "lammā", "audio": "wbw/062_003_003.mp3"}, {"type": "word", "ar": "يَلْحَقُوا۟", "tajweed": "يَلۡحَقُو<rule class=slnt>اۡ</rule>", "en": "joined", "tr": "yalḥaqū", "audio": "wbw/062_003_004.mp3"}, {"type": "word", "ar": "بِهِمْ ۚ", "tajweed": "بِهِمۡ‌ۚ", "en": "them", "tr": "bihim", "audio": "wbw/062_003_005.mp3"}, {"type": "word", "ar": "وَهُوَ", "tajweed": "وَهُوَ", "en": "and He", "tr": "wahuwa", "audio": "wbw/062_003_007.mp3"}, {"type": "word", "ar": "ٱلْعَزِيزُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَزِيزُ", "en": "(is) the All-Mighty", "tr": "l-ʿazīzu", "audio": "wbw/062_003_008.mp3"}, {"type": "word", "ar": "ٱلْحَكِيمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَك<rule class=madda_permissible>ِي</rule>مُ", "en": "the All-Wise", "tr": "l-ḥakīmu", "audio": "wbw/062_003_009.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "62:4", "juz": 28, "page": 553, "side_trans": "That is the bounty of Allāh, which He gives to whom He wills, and Allāh is the possessor of great bounty.", "words": [{"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "That", "tr": "dhālika", "audio": "wbw/062_004_001.mp3"}, {"type": "word", "ar": "فَضْلُ", "tajweed": "فَضۡلُ", "en": "(is the) Bounty", "tr": "faḍlu", "audio": "wbw/062_004_002.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/062_004_003.mp3"}, {"type": "word", "ar": "يُؤْتِيهِ", "tajweed": "يُؤۡتِيهِ", "en": "He gives it", "tr": "yu'tīhi", "audio": "wbw/062_004_004.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "م<rule class=idgham_ghunnah>َن</rule>", "en": "(to) whom", "tr": "man", "audio": "wbw/062_004_005.mp3"}, {"type": "word", "ar": "يَشَآءُ ۚ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َش<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ‌ۚ", "en": "He wills", "tr": "yashāu", "audio": "wbw/062_004_006.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/062_004_008.mp3"}, {"type": "word", "ar": "ذُو", "tajweed": "ذُو", "en": "(is the) Possessor", "tr": "dhū", "audio": "wbw/062_004_009.mp3"}, {"type": "word", "ar": "ٱلْفَضْلِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَضۡلِ", "en": "(of) Bounty", "tr": "l-faḍli", "audio": "wbw/062_004_010.mp3"}, {"type": "word", "ar": "ٱلْعَظِيمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَظ<rule class=madda_permissible>ِي</rule>مِ", "en": "the Great", "tr": "l-ʿaẓīmi", "audio": "wbw/062_004_011.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "62:5", "juz": 28, "page": 553, "side_trans": "The example of those who were entrusted with the Torah and then did not take it on is like that of a donkey who carries volumes [of books]. Wretched is the example of the people who deny the signs of Allāh. And Allāh does not guide the wrongdoing people.", "words": [{"type": "word", "ar": "مَثَلُ", "tajweed": "مَثَلُ", "en": "(The) likeness", "tr": "mathalu", "audio": "wbw/062_005_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "(of) those who", "tr": "alladhīna", "audio": "wbw/062_005_002.mp3"}, {"type": "word", "ar": "حُمِّلُوا۟", "tajweed": "حُ<rule class=ghunnah>مّ</rule>ِلُو<rule class=slnt>اۡ</rule>", "en": "were entrusted", "tr": "ḥummilū", "audio": "wbw/062_005_003.mp3"}, {"type": "word", "ar": "ٱلتَّوْرَىٰةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>تَّوۡرَ<rule class=madda_normal>ٮٰ</rule>ةَ", "en": "(with) the Taurat", "tr": "l-tawrāta", "audio": "wbw/062_005_004.mp3"}, {"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "then", "tr": "thumma", "audio": "wbw/062_005_005.mp3"}, {"type": "word", "ar": "لَمْ", "tajweed": "لَمۡ", "en": "not", "tr": "lam", "audio": "wbw/062_005_006.mp3"}, {"type": "word", "ar": "يَحْمِلُوهَا", "tajweed": "يَحۡمِلُوهَا", "en": "they bore it", "tr": "yaḥmilūhā", "audio": "wbw/062_005_007.mp3"}, {"type": "word", "ar": "كَمَثَلِ", "tajweed": "كَمَثَلِ", "en": "(is) like", "tr": "kamathali", "audio": "wbw/062_005_008.mp3"}, {"type": "word", "ar": "ٱلْحِمَارِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحِمَارِ", "en": "the donkey", "tr": "l-ḥimāri", "audio": "wbw/062_005_009.mp3"}, {"type": "word", "ar": "يَحْمِلُ", "tajweed": "يَحۡمِلُ", "en": "who carries", "tr": "yaḥmilu", "audio": "wbw/062_005_010.mp3"}, {"type": "word", "ar": "أَسْفَارًۢا ۚ", "tajweed": "أَسۡفَار<rule class=iqlab>َۢا‌ۚ</rule>", "en": "books", "tr": "asfāran", "audio": "wbw/062_005_011.mp3"}, {"type": "word", "ar": "بِئْسَ", "tajweed": "<rule class=iqlab>ب</rule>ِئۡسَ", "en": "Wretched is", "tr": "bi'sa", "audio": "wbw/062_005_013.mp3"}, {"type": "word", "ar": "مَثَلُ", "tajweed": "مَثَلُ", "en": "(the) example", "tr": "mathalu", "audio": "wbw/062_005_014.mp3"}, {"type": "word", "ar": "ٱلْقَوْمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَوۡمِ", "en": "(of) the people", "tr": "l-qawmi", "audio": "wbw/062_005_015.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "who", "tr": "alladhīna", "audio": "wbw/062_005_016.mp3"}, {"type": "word", "ar": "كَذَّبُوا۟", "tajweed": "كَذَّبُو<rule class=slnt>اۡ</rule>", "en": "deny", "tr": "kadhabū", "audio": "wbw/062_005_017.mp3"}, {"type": "word", "ar": "بِـَٔايَـٰتِ", "tajweed": "بِـَٔـايَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "(the) Signs", "tr": "biāyāti", "audio": "wbw/062_005_018.mp3"}, {"type": "word", "ar": "ٱللَّهِ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ‌ۚ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/062_005_019.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/062_005_021.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(does) not", "tr": "lā", "audio": "wbw/062_005_022.mp3"}, {"type": "word", "ar": "يَهْدِى", "tajweed": "يَهۡدِى", "en": "guide", "tr": "yahdī", "audio": "wbw/062_005_023.mp3"}, {"type": "word", "ar": "ٱلْقَوْمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَوۡمَ", "en": "the people", "tr": "l-qawma", "audio": "wbw/062_005_024.mp3"}, {"type": "word", "ar": "ٱلظَّـٰلِمِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ظَّ<rule class=madda_normal>ـٰ</rule>لِم<rule class=madda_permissible>ِي</rule>نَ", "en": "the wrongdoers", "tr": "l-ẓālimīna", "audio": "wbw/062_005_025.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "62:6", "juz": 28, "page": 553, "side_trans": "Say, \"O you who are Jews, if you claim that you are allies of Allāh, excluding the [other] people, then wish for death, if you should be truthful.\"", "words": [{"type": "word", "ar": "قُلْ", "tajweed": "قُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/062_006_001.mp3"}, {"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/062_006_002.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "you (who)", "tr": "alladhīna", "audio": "wbw/062_006_003.mp3"}, {"type": "word", "ar": "هَادُوٓا۟", "tajweed": "هَاد<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "(are) Jews", "tr": "hādū", "audio": "wbw/062_006_004.mp3"}, {"type": "word", "ar": "إِن", "tajweed": "إِ<rule class=ikhafa>ن</rule>", "en": "If", "tr": "in", "audio": "wbw/062_006_005.mp3"}, {"type": "word", "ar": "زَعَمْتُمْ", "tajweed": "<rule class=ikhafa>ز</rule>َعَمۡتُمۡ", "en": "you claim", "tr": "zaʿamtum", "audio": "wbw/062_006_006.mp3"}, {"type": "word", "ar": "أَنَّكُمْ", "tajweed": "أَ<rule class=ghunnah>نّ</rule>َكُمۡ", "en": "that you", "tr": "annakum", "audio": "wbw/062_006_007.mp3"}, {"type": "word", "ar": "أَوْلِيَآءُ", "tajweed": "أَوۡلِي<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ", "en": "(are) allies", "tr": "awliyāu", "audio": "wbw/062_006_008.mp3"}, {"type": "word", "ar": "لِلَّهِ", "tajweed": "لِلَّهِ", "en": "of Allah", "tr": "lillahi", "audio": "wbw/062_006_009.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/062_006_010.mp3"}, {"type": "word", "ar": "دُونِ", "tajweed": "<rule class=ikhafa>د</rule>ُونِ", "en": "excluding", "tr": "dūni", "audio": "wbw/062_006_011.mp3"}, {"type": "word", "ar": "ٱلنَّاسِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َاسِ", "en": "the people", "tr": "l-nāsi", "audio": "wbw/062_006_012.mp3"}, {"type": "word", "ar": "فَتَمَنَّوُا۟", "tajweed": "فَتَمَ<rule class=ghunnah>نّ</rule>َوُ<rule class=slnt>اۡ</rule>", "en": "then wish", "tr": "fatamannawū", "audio": "wbw/062_006_013.mp3"}, {"type": "word", "ar": "ٱلْمَوْتَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَوۡتَ", "en": "(for) the death", "tr": "l-mawta", "audio": "wbw/062_006_014.mp3"}, {"type": "word", "ar": "إِن", "tajweed": "إِ<rule class=ikhafa>ن</rule>", "en": "if", "tr": "in", "audio": "wbw/062_006_015.mp3"}, {"type": "word", "ar": "كُنتُمْ", "tajweed": "<rule class=ikhafa>ك</rule>ُ<rule class=ikhafa>نت</rule>ُمۡ", "en": "you are", "tr": "kuntum", "audio": "wbw/062_006_016.mp3"}, {"type": "word", "ar": "صَـٰدِقِينَ", "tajweed": "صَ<rule class=madda_normal>ـٰ</rule>دِق<rule class=madda_permissible>ِي</rule>نَ", "en": "truthful", "tr": "ṣādiqīna", "audio": "wbw/062_006_017.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "62:7", "juz": 28, "page": 553, "side_trans": "But they will not wish for it, ever, because of what their hands have put forth. And Allāh is Knowing of the wrongdoers.", "words": [{"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "But not", "tr": "walā", "audio": "wbw/062_007_001.mp3"}, {"type": "word", "ar": "يَتَمَنَّوْنَهُۥٓ", "tajweed": "يَتَمَ<rule class=ghunnah>نّ</rule>َوۡنَهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "they will wish for it", "tr": "yatamannawnahu", "audio": "wbw/062_007_002.mp3"}, {"type": "word", "ar": "أَبَدًۢا", "tajweed": "أَبَد<rule class=iqlab>َۢا</rule>", "en": "ever", "tr": "abadan", "audio": "wbw/062_007_003.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "<rule class=iqlab>ب</rule>ِمَا", "en": "for what", "tr": "bimā", "audio": "wbw/062_007_004.mp3"}, {"type": "word", "ar": "قَدَّمَتْ", "tajweed": "قَدَّمَتۡ", "en": "(have) sent forth", "tr": "qaddamat", "audio": "wbw/062_007_005.mp3"}, {"type": "word", "ar": "أَيْدِيهِمْ ۚ", "tajweed": "أَيۡدِيهِمۡ‌ۚ", "en": "their hands", "tr": "aydīhim", "audio": "wbw/062_007_006.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/062_007_008.mp3"}, {"type": "word", "ar": "عَلِيمٌۢ", "tajweed": "عَلِي<rule class=iqlab>مُۢ</rule>", "en": "(is) All-Knowing", "tr": "ʿalīmun", "audio": "wbw/062_007_009.mp3"}, {"type": "word", "ar": "بِٱلظَّـٰلِمِينَ", "tajweed": "<rule class=iqlab>ب</rule>ِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ظَّ<rule class=madda_normal>ـٰ</rule>لِم<rule class=madda_permissible>ِي</rule>نَ", "en": "of the wrongdoers", "tr": "bil-ẓālimīna", "audio": "wbw/062_007_010.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "62:8", "juz": 28, "page": 553, "side_trans": "Say, \"Indeed, the death from which you flee - indeed, it will meet you. Then you will be returned to the Knower of the unseen and the witnessed, and He will inform you about what you used to do.\"", "words": [{"type": "word", "ar": "قُلْ", "tajweed": "قُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/062_008_001.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/062_008_002.mp3"}, {"type": "word", "ar": "ٱلْمَوْتَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَوۡتَ", "en": "the death", "tr": "l-mawta", "audio": "wbw/062_008_003.mp3"}, {"type": "word", "ar": "ٱلَّذِى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِى", "en": "which", "tr": "alladhī", "audio": "wbw/062_008_004.mp3"}, {"type": "word", "ar": "تَفِرُّونَ", "tajweed": "تَفِرُّونَ", "en": "you flee", "tr": "tafirrūna", "audio": "wbw/062_008_005.mp3"}, {"type": "word", "ar": "مِنْهُ", "tajweed": "مِنۡهُ", "en": "from it", "tr": "min'hu", "audio": "wbw/062_008_006.mp3"}, {"type": "word", "ar": "فَإِنَّهُۥ", "tajweed": "فَإِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "then surely it", "tr": "fa-innahu", "audio": "wbw/062_008_007.mp3"}, {"type": "word", "ar": "مُلَـٰقِيكُمْ ۖ", "tajweed": "مُلَ<rule class=madda_normal>ـٰ</rule>قِيكُمۡ‌ۖ", "en": "(will) meet you", "tr": "mulāqīkum", "audio": "wbw/062_008_008.mp3"}, {"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/062_008_010.mp3"}, {"type": "word", "ar": "تُرَدُّونَ", "tajweed": "تُرَدُّونَ", "en": "you will be sent back", "tr": "turaddūna", "audio": "wbw/062_008_011.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/062_008_012.mp3"}, {"type": "word", "ar": "عَـٰلِمِ", "tajweed": "عَ<rule class=madda_normal>ـٰ</rule>لِمِ", "en": "(the) All-Knower", "tr": "ʿālimi", "audio": "wbw/062_008_013.mp3"}, {"type": "word", "ar": "ٱلْغَيْبِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡغَيۡبِ", "en": "(of) the unseen", "tr": "l-ghaybi", "audio": "wbw/062_008_014.mp3"}, {"type": "word", "ar": "وَٱلشَّهَـٰدَةِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شَّهَ<rule class=madda_normal>ـٰ</rule>دَةِ", "en": "and the witnessed", "tr": "wal-shahādati", "audio": "wbw/062_008_015.mp3"}, {"type": "word", "ar": "فَيُنَبِّئُكُم", "tajweed": "فَيُنَبِّئُك<rule class=ikhafa_shafawi>ُم</rule>", "en": "and He will inform you", "tr": "fayunabbi-ukum", "audio": "wbw/062_008_016.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِمَا", "en": "[of] what", "tr": "bimā", "audio": "wbw/062_008_017.mp3"}, {"type": "word", "ar": "كُنتُمْ", "tajweed": "كُ<rule class=ikhafa>نت</rule>ُمۡ", "en": "you used to", "tr": "kuntum", "audio": "wbw/062_008_018.mp3"}, {"type": "word", "ar": "تَعْمَلُونَ", "tajweed": "تَعۡمَل<rule class=madda_permissible>ُو</rule>نَ", "en": "do", "tr": "taʿmalūna", "audio": "wbw/062_008_019.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "62:9", "juz": 28, "page": 554, "side_trans": "O you who have believed, when [the adhān] is called for the prayer on the day of Jumuʿah [Friday], then proceed to the remembrance of Allāh and leave trade. That is better for you, if you only knew.", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/062_009_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "(you) who", "tr": "alladhīna", "audio": "wbw/062_009_002.mp3"}, {"type": "word", "ar": "ءَامَنُوٓا۟", "tajweed": "ءَامَن<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/062_009_003.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/062_009_004.mp3"}, {"type": "word", "ar": "نُودِىَ", "tajweed": "نُودِىَ", "en": "(the) call is made", "tr": "nūdiya", "audio": "wbw/062_009_005.mp3"}, {"type": "word", "ar": "لِلصَّلَوٰةِ", "tajweed": "لِلصَّلَ<rule class=slnt>و</rule><rule class=madda_normal>ٰ</rule>ةِ", "en": "for (the) prayer", "tr": "lilṣṣalati", "audio": "wbw/062_009_006.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_ghunnah>ِن</rule>", "en": "on", "tr": "min", "audio": "wbw/062_009_007.mp3"}, {"type": "word", "ar": "يَوْمِ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمِ", "en": "(the) day", "tr": "yawmi", "audio": "wbw/062_009_008.mp3"}, {"type": "word", "ar": "ٱلْجُمُعَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجُمُعَةِ", "en": "(of) Friday", "tr": "l-jumuʿati", "audio": "wbw/062_009_009.mp3"}, {"type": "word", "ar": "فَٱسْعَوْا۟", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>سۡعَوۡ<rule class=slnt>اۡ</rule>", "en": "then hasten", "tr": "fa-is'ʿaw", "audio": "wbw/062_009_010.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/062_009_011.mp3"}, {"type": "word", "ar": "ذِكْرِ", "tajweed": "ذِكۡرِ", "en": "(the) remembrance", "tr": "dhik'ri", "audio": "wbw/062_009_012.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/062_009_013.mp3"}, {"type": "word", "ar": "وَذَرُوا۟", "tajweed": "وَذَرُو<rule class=slnt>اۡ</rule>", "en": "and leave", "tr": "wadharū", "audio": "wbw/062_009_014.mp3"}, {"type": "word", "ar": "ٱلْبَيْعَ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبَيۡعَ‌ۚ", "en": "the business", "tr": "l-bayʿa", "audio": "wbw/062_009_015.mp3"}, {"type": "word", "ar": "ذَٰلِكُمْ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكُمۡ", "en": "That", "tr": "dhālikum", "audio": "wbw/062_009_017.mp3"}, {"type": "word", "ar": "خَيْرٌۭ", "tajweed": "خَيۡ<rule class=idgham_wo_ghunnah>رٌ</rule>", "en": "(is) better", "tr": "khayrun", "audio": "wbw/062_009_018.mp3"}, {"type": "word", "ar": "لَّكُمْ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/062_009_019.mp3"}, {"type": "word", "ar": "إِن", "tajweed": "إِ<rule class=ikhafa>ن</rule>", "en": "if", "tr": "in", "audio": "wbw/062_009_020.mp3"}, {"type": "word", "ar": "كُنتُمْ", "tajweed": "<rule class=ikhafa>ك</rule>ُ<rule class=ikhafa>نت</rule>ُمۡ", "en": "you", "tr": "kuntum", "audio": "wbw/062_009_021.mp3"}, {"type": "word", "ar": "تَعْلَمُونَ", "tajweed": "تَعۡلَم<rule class=madda_permissible>ُو</rule>نَ", "en": "know", "tr": "taʿlamūna", "audio": "wbw/062_009_022.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "62:10", "juz": 28, "page": 554, "side_trans": "And when the prayer has been concluded, disperse within the land and seek from the bounty of Allāh, and remember Allāh often that you may succeed.", "words": [{"type": "word", "ar": "فَإِذَا", "tajweed": "فَإِذَا", "en": "Then when", "tr": "fa-idhā", "audio": "wbw/062_010_001.mp3"}, {"type": "word", "ar": "قُضِيَتِ", "tajweed": "قُضِيَتِ", "en": "is concluded", "tr": "quḍiyati", "audio": "wbw/062_010_002.mp3"}, {"type": "word", "ar": "ٱلصَّلَوٰةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّلَ<rule class=slnt>و</rule><rule class=madda_normal>ٰ</rule>ةُ", "en": "the prayer", "tr": "l-ṣalatu", "audio": "wbw/062_010_003.mp3"}, {"type": "word", "ar": "فَٱنتَشِرُوا۟", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule><rule class=ikhafa>نت</rule>َشِرُو<rule class=slnt>اۡ</rule>", "en": "then disperse", "tr": "fa-intashirū", "audio": "wbw/062_010_004.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/062_010_005.mp3"}, {"type": "word", "ar": "ٱلْأَرْضِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "the land", "tr": "l-arḍi", "audio": "wbw/062_010_006.mp3"}, {"type": "word", "ar": "وَٱبْتَغُوا۟", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>بۡ</rule>تَغُو<rule class=slnt>اۡ</rule>", "en": "and seek", "tr": "wa-ib'taghū", "audio": "wbw/062_010_007.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/062_010_008.mp3"}, {"type": "word", "ar": "فَضْلِ", "tajweed": "<rule class=ikhafa>ف</rule>َضۡلِ", "en": "(the) Bounty", "tr": "faḍli", "audio": "wbw/062_010_009.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/062_010_010.mp3"}, {"type": "word", "ar": "وَٱذْكُرُوا۟", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>ذۡكُرُو<rule class=slnt>اۡ</rule>", "en": "and remember", "tr": "wa-udh'kurū", "audio": "wbw/062_010_011.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/062_010_012.mp3"}, {"type": "word", "ar": "كَثِيرًۭا", "tajweed": "كَثِي<rule class=idgham_wo_ghunnah>رًا</rule>", "en": "much", "tr": "kathīran", "audio": "wbw/062_010_013.mp3"}, {"type": "word", "ar": "لَّعَلَّكُمْ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّعَلَّكُمۡ", "en": "so that you may", "tr": "laʿallakum", "audio": "wbw/062_010_014.mp3"}, {"type": "word", "ar": "تُفْلِحُونَ", "tajweed": "تُفۡلِح<rule class=madda_permissible>ُو</rule>نَ", "en": "succeed", "tr": "tuf'liḥūna", "audio": "wbw/062_010_015.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "62:11", "juz": 28, "page": 554, "side_trans": "But [on one occasion] when they saw a transaction or a diversion, [O Muḥammad], they rushed to it and left you standing. Say, \"What is with Allāh is better than diversion and than a transaction, and Allāh is the best of providers.\"", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/062_011_001.mp3"}, {"type": "word", "ar": "رَأَوْا۟", "tajweed": "رَأَوۡ<rule class=slnt>اۡ</rule>", "en": "they saw", "tr": "ra-aw", "audio": "wbw/062_011_002.mp3"}, {"type": "word", "ar": "تِجَـٰرَةً", "tajweed": "تِجَ<rule class=madda_normal>ـٰ</rule>رَةً", "en": "a transaction", "tr": "tijāratan", "audio": "wbw/062_011_003.mp3"}, {"type": "word", "ar": "أَوْ", "tajweed": "أَوۡ", "en": "or", "tr": "aw", "audio": "wbw/062_011_004.mp3"}, {"type": "word", "ar": "لَهْوًا", "tajweed": "لَهۡوًا", "en": "a sport", "tr": "lahwan", "audio": "wbw/062_011_005.mp3"}, {"type": "word", "ar": "ٱنفَضُّوٓا۟", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=ikhafa>نف</rule>َضّ<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "they rushed", "tr": "infaḍḍū", "audio": "wbw/062_011_006.mp3"}, {"type": "word", "ar": "إِلَيْهَا", "tajweed": "إِلَيۡهَا", "en": "to it", "tr": "ilayhā", "audio": "wbw/062_011_007.mp3"}, {"type": "word", "ar": "وَتَرَكُوكَ", "tajweed": "وَتَرَكُوكَ", "en": "and left you", "tr": "watarakūka", "audio": "wbw/062_011_008.mp3"}, {"type": "word", "ar": "قَآئِمًۭا ۚ", "tajweed": "ق<rule class=madda_obligatory_mottasel>َا</rule>ٓئِ<rule class=ikhafa>مًا‌ۚ</rule>", "en": "standing", "tr": "qāiman", "audio": "wbw/062_011_009.mp3"}, {"type": "word", "ar": "قُلْ", "tajweed": "<rule class=ikhafa>ق</rule>ُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/062_011_011.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "What", "tr": "mā", "audio": "wbw/062_011_012.mp3"}, {"type": "word", "ar": "عِندَ", "tajweed": "عِ<rule class=ikhafa>ند</rule>َ", "en": "(is) with", "tr": "ʿinda", "audio": "wbw/062_011_013.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/062_011_014.mp3"}, {"type": "word", "ar": "خَيْرٌۭ", "tajweed": "خَيۡ<rule class=idgham_ghunnah>رٌ</rule>", "en": "(is) better", "tr": "khayrun", "audio": "wbw/062_011_015.mp3"}, {"type": "word", "ar": "مِّنَ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنَ", "en": "than", "tr": "mina", "audio": "wbw/062_011_016.mp3"}, {"type": "word", "ar": "ٱللَّهْوِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>لَّهۡوِ", "en": "the sport", "tr": "l-lahwi", "audio": "wbw/062_011_017.mp3"}, {"type": "word", "ar": "وَمِنَ", "tajweed": "وَمِنَ", "en": "and from", "tr": "wamina", "audio": "wbw/062_011_018.mp3"}, {"type": "word", "ar": "ٱلتِّجَـٰرَةِ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>تِّجَ<rule class=madda_normal>ـٰ</rule>رَةِ‌ۚ", "en": "(any) transaction", "tr": "l-tijārati", "audio": "wbw/062_011_019.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/062_011_021.mp3"}, {"type": "word", "ar": "خَيْرُ", "tajweed": "خَيۡرُ", "en": "(is the) Best", "tr": "khayru", "audio": "wbw/062_011_022.mp3"}, {"type": "word", "ar": "ٱلرَّٰزِقِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رّ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>زِق<rule class=madda_permissible>ِي</rule>نَ", "en": "(of) the Providers", "tr": "l-rāziqīna", "audio": "wbw/062_011_023.mp3"}, {"type": "end", "num": "١١"}]}]