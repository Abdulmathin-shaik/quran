[{"id": 1, "key": "112:1", "juz": 30, "page": 604, "side_trans": "Say, \"He is Allāh, [who is] One,", "words": [{"type": "word", "ar": "قُلْ", "tajweed": "قُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/112_001_001.mp3"}, {"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "He", "tr": "huwa", "audio": "wbw/112_001_002.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "(is) Allah", "tr": "l-lahu", "audio": "wbw/112_001_003.mp3"}, {"type": "word", "ar": "أَحَدٌ", "tajweed": "أَحَ<rule class=qalaqah>د</rule>ٌ", "en": "the One", "tr": "aḥadun", "audio": "wbw/112_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "112:2", "juz": 30, "page": 604, "side_trans": "Allāh, the Eternal Refuge.", "words": [{"type": "word", "ar": "ٱللَّهُ", "tajweed": "ٱللَّهُ", "en": "Allah", "tr": "al-lahu", "audio": "wbw/112_002_001.mp3"}, {"type": "word", "ar": "ٱلصَّمَدُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّمَ<rule class=qalaqah>د</rule>ُ", "en": "the Eternal, the Absolute", "tr": "l-ṣamadu", "audio": "wbw/112_002_002.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "112:3", "juz": 30, "page": 604, "side_trans": "He neither begets nor is born,", "words": [{"type": "word", "ar": "لَمْ", "tajweed": "لَمۡ", "en": "Not", "tr": "lam", "audio": "wbw/112_003_001.mp3"}, {"type": "word", "ar": "يَلِدْ", "tajweed": "يَلِ<rule class=qalaqah>دۡ</rule>", "en": "He begets", "tr": "yalid", "audio": "wbw/112_003_002.mp3"}, {"type": "word", "ar": "وَلَمْ", "tajweed": "وَلَمۡ", "en": "and not", "tr": "walam", "audio": "wbw/112_003_003.mp3"}, {"type": "word", "ar": "يُولَدْ", "tajweed": "يُولَ<rule class=qalaqah>دۡ</rule>", "en": "He is begotten", "tr": "yūlad", "audio": "wbw/112_003_004.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "112:4", "juz": 30, "page": 604, "side_trans": "Nor is there to Him any equivalent.\"", "words": [{"type": "word", "ar": "وَلَمْ", "tajweed": "وَلَمۡ", "en": "And not", "tr": "walam", "audio": "wbw/112_004_001.mp3"}, {"type": "word", "ar": "يَكُن", "tajweed": "يَك<rule class=idgham_wo_ghunnah>ُن</rule>", "en": "is", "tr": "yakun", "audio": "wbw/112_004_002.mp3"}, {"type": "word", "ar": "لَّهُۥ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّهُ<rule class=madda_normal>ۥ</rule>", "en": "for Him", "tr": "lahu", "audio": "wbw/112_004_003.mp3"}, {"type": "word", "ar": "كُفُوًا", "tajweed": "كُفُوًا", "en": "equivalent", "tr": "kufuwan", "audio": "wbw/112_004_004.mp3"}, {"type": "word", "ar": "أَحَدٌۢ", "tajweed": "أَحَ<rule class=qalaqah>د</rule>ُۢ", "en": "any [one]", "tr": "aḥadun", "audio": "wbw/112_004_005.mp3"}, {"type": "end", "num": "٤"}]}]