[{"id": 1, "key": "75:1", "juz": 29, "page": 577, "side_trans": "I swear by the Day of Resurrection", "words": [{"type": "word", "ar": "لَآ", "tajweed": "ل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Nay", "tr": "lā", "audio": "wbw/075_001_001.mp3"}, {"type": "word", "ar": "أُقْسِمُ", "tajweed": "أُ<rule class=qalaqah>قۡ</rule>سِمُ", "en": "I swear", "tr": "uq'simu", "audio": "wbw/075_001_002.mp3"}, {"type": "word", "ar": "بِيَوْمِ", "tajweed": "بِيَوۡمِ", "en": "by (the) Day", "tr": "biyawmi", "audio": "wbw/075_001_003.mp3"}, {"type": "word", "ar": "ٱلْقِيَـٰمَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقِيَ<rule class=madda_normal>ـٰ</rule>مَةِ", "en": "(of) the Resurrection", "tr": "l-qiyāmati", "audio": "wbw/075_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "75:2", "juz": 29, "page": 577, "side_trans": "And I swear by the reproaching soul [to the certainty of resurrection].", "words": [{"type": "word", "ar": "وَلَآ", "tajweed": "وَل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And nay", "tr": "walā", "audio": "wbw/075_002_001.mp3"}, {"type": "word", "ar": "أُقْسِمُ", "tajweed": "أُ<rule class=qalaqah>قۡ</rule>سِمُ", "en": "I swear", "tr": "uq'simu", "audio": "wbw/075_002_002.mp3"}, {"type": "word", "ar": "بِٱلنَّفْسِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َفۡسِ", "en": "by the soul", "tr": "bil-nafsi", "audio": "wbw/075_002_003.mp3"}, {"type": "word", "ar": "ٱللَّوَّامَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>لَّوَّامَةِ", "en": "self-accusing", "tr": "l-lawāmati", "audio": "wbw/075_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "75:3", "juz": 29, "page": 577, "side_trans": "Does man think that We will not assemble his bones?", "words": [{"type": "word", "ar": "أَيَحْسَبُ", "tajweed": "أَيَحۡسَبُ", "en": "Does think", "tr": "ayaḥsabu", "audio": "wbw/075_003_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "[the] man", "tr": "l-insānu", "audio": "wbw/075_003_002.mp3"}, {"type": "word", "ar": "أَلَّن", "tajweed": "أَلّ<rule class=idgham_ghunnah>َن</rule>", "en": "that not", "tr": "allan", "audio": "wbw/075_003_003.mp3"}, {"type": "word", "ar": "نَّجْمَعَ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>َّ<rule class=qalaqah>جۡ</rule>مَعَ", "en": "We will assemble", "tr": "najmaʿa", "audio": "wbw/075_003_004.mp3"}, {"type": "word", "ar": "عِظَامَهُۥ", "tajweed": "عِظَامَهُۥ", "en": "his bones", "tr": "ʿiẓāmahu", "audio": "wbw/075_003_005.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "75:4", "juz": 29, "page": 577, "side_trans": "Yes. [We are] Able [even] to proportion his fingertips.", "words": [{"type": "word", "ar": "بَلَىٰ", "tajweed": "بَلَىٰ", "en": "Nay", "tr": "balā", "audio": "wbw/075_004_001.mp3"}, {"type": "word", "ar": "قَـٰدِرِينَ", "tajweed": "قَ<rule class=madda_normal>ـٰ</rule>دِرِينَ", "en": "(We are) Able", "tr": "qādirīna", "audio": "wbw/075_004_002.mp3"}, {"type": "word", "ar": "عَلَىٰٓ", "tajweed": "عَلَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "on", "tr": "ʿalā", "audio": "wbw/075_004_003.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/075_004_004.mp3"}, {"type": "word", "ar": "نُّسَوِّىَ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>ُّسَوِّىَ", "en": "We can restore", "tr": "nusawwiya", "audio": "wbw/075_004_005.mp3"}, {"type": "word", "ar": "بَنَانَهُۥ", "tajweed": "بَنَانَهُۥ", "en": "his fingertips", "tr": "banānahu", "audio": "wbw/075_004_006.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "75:5", "juz": 29, "page": 577, "side_trans": "But man desires to continue in sin.", "words": [{"type": "word", "ar": "بَلْ", "tajweed": "بَلۡ", "en": "Nay", "tr": "bal", "audio": "wbw/075_005_001.mp3"}, {"type": "word", "ar": "يُرِيدُ", "tajweed": "يُرِيدُ", "en": "Desires", "tr": "yurīdu", "audio": "wbw/075_005_002.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "[the] man", "tr": "l-insānu", "audio": "wbw/075_005_003.mp3"}, {"type": "word", "ar": "لِيَفْجُرَ", "tajweed": "لِيَفۡجُرَ", "en": "to give (the) lie", "tr": "liyafjura", "audio": "wbw/075_005_004.mp3"}, {"type": "word", "ar": "أَمَامَهُۥ", "tajweed": "أَمَامَهُۥ", "en": "(to) what is before him", "tr": "amāmahu", "audio": "wbw/075_005_005.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "75:6", "juz": 29, "page": 577, "side_trans": "He asks, \"When is the Day of Resurrection?\"", "words": [{"type": "word", "ar": "يَسْـَٔلُ", "tajweed": "يَسۡــَٔلُ", "en": "He asks", "tr": "yasalu", "audio": "wbw/075_006_001.mp3"}, {"type": "word", "ar": "أَيَّانَ", "tajweed": "أَيَّانَ", "en": "When", "tr": "ayyāna", "audio": "wbw/075_006_002.mp3"}, {"type": "word", "ar": "يَوْمُ", "tajweed": "يَوۡمُ", "en": "(is the) Day", "tr": "yawmu", "audio": "wbw/075_006_003.mp3"}, {"type": "word", "ar": "ٱلْقِيَـٰمَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقِيَ<rule class=madda_normal>ـٰ</rule>مَةِ", "en": "(of) the Resurrection", "tr": "l-qiyāmati", "audio": "wbw/075_006_004.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "75:7", "juz": 29, "page": 577, "side_trans": "So when vision is dazzled.", "words": [{"type": "word", "ar": "فَإِذَا", "tajweed": "فَإِذَا", "en": "So when", "tr": "fa-idhā", "audio": "wbw/075_007_001.mp3"}, {"type": "word", "ar": "بَرِقَ", "tajweed": "بَرِقَ", "en": "is dazzled", "tr": "bariqa", "audio": "wbw/075_007_002.mp3"}, {"type": "word", "ar": "ٱلْبَصَرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبَصَرُ", "en": "the vision", "tr": "l-baṣaru", "audio": "wbw/075_007_003.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "75:8", "juz": 29, "page": 577, "side_trans": "And the moon darkens.", "words": [{"type": "word", "ar": "وَخَسَفَ", "tajweed": "وَخَسَفَ", "en": "And becomes dark", "tr": "wakhasafa", "audio": "wbw/075_008_001.mp3"}, {"type": "word", "ar": "ٱلْقَمَرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَمَرُ", "en": "the moon", "tr": "l-qamaru", "audio": "wbw/075_008_002.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "75:9", "juz": 29, "page": 577, "side_trans": "And the sun and the moon are joined,", "words": [{"type": "word", "ar": "وَجُمِعَ", "tajweed": "وَجُمِعَ", "en": "And are joined", "tr": "wajumiʿa", "audio": "wbw/075_009_001.mp3"}, {"type": "word", "ar": "ٱلشَّمْسُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شَّمۡسُ", "en": "the sun", "tr": "l-shamsu", "audio": "wbw/075_009_002.mp3"}, {"type": "word", "ar": "وَٱلْقَمَرُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡقَمَرُ", "en": "and the moon", "tr": "wal-qamaru", "audio": "wbw/075_009_003.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "75:10", "juz": 29, "page": 577, "side_trans": "Man will say on that Day, \"Where is the [place of] escape?\"", "words": [{"type": "word", "ar": "يَقُولُ", "tajweed": "يَقُولُ", "en": "Will say", "tr": "yaqūlu", "audio": "wbw/075_010_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "[the] man", "tr": "l-insānu", "audio": "wbw/075_010_002.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍ", "tajweed": "يَوۡمَئِذٍ", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/075_010_003.mp3"}, {"type": "word", "ar": "أَيْنَ", "tajweed": "أَيۡنَ", "en": "Where", "tr": "ayna", "audio": "wbw/075_010_004.mp3"}, {"type": "word", "ar": "ٱلْمَفَرُّ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَفَرُّ", "en": "(is) the escape", "tr": "l-mafaru", "audio": "wbw/075_010_005.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "75:11", "juz": 29, "page": 577, "side_trans": "No! There is no refuge.", "words": [{"type": "word", "ar": "كَلَّا", "tajweed": "كَلَّا", "en": "By no means", "tr": "kallā", "audio": "wbw/075_011_001.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(There is) no", "tr": "lā", "audio": "wbw/075_011_002.mp3"}, {"type": "word", "ar": "وَزَرَ", "tajweed": "وَزَرَ", "en": "refuge", "tr": "wazara", "audio": "wbw/075_011_003.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "75:12", "juz": 29, "page": 577, "side_trans": "To your Lord, that Day, is the [place of] permanence.", "words": [{"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "To", "tr": "ilā", "audio": "wbw/075_012_001.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "your Lord", "tr": "rabbika", "audio": "wbw/075_012_002.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍ", "tajweed": "يَوۡمَئِذٍ", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/075_012_003.mp3"}, {"type": "word", "ar": "ٱلْمُسْتَقَرُّ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُسۡتَقَرُّ", "en": "(is) the place of rest", "tr": "l-mus'taqaru", "audio": "wbw/075_012_004.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "75:13", "juz": 29, "page": 577, "side_trans": "Man will be informed that Day of what he sent ahead and kept back.", "words": [{"type": "word", "ar": "يُنَبَّؤُا۟", "tajweed": "يُنَبَّؤُ<rule class=slnt>اۡ</rule>", "en": "Will be informed", "tr": "yunabba-u", "audio": "wbw/075_013_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "[the] man", "tr": "l-insānu", "audio": "wbw/075_013_002.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۭ", "tajweed": "يَوۡمَئِ<rule class=iqlab>ذِۭ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/075_013_003.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "<rule class=iqlab>ب</rule>ِمَا", "en": "of what", "tr": "bimā", "audio": "wbw/075_013_004.mp3"}, {"type": "word", "ar": "قَدَّمَ", "tajweed": "قَدَّمَ", "en": "he sent forth", "tr": "qaddama", "audio": "wbw/075_013_005.mp3"}, {"type": "word", "ar": "وَأَخَّرَ", "tajweed": "وَأَخَّرَ", "en": "and kept back", "tr": "wa-akhara", "audio": "wbw/075_013_006.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "75:14", "juz": 29, "page": 577, "side_trans": "Rather, man, against himself, will be a witness,", "words": [{"type": "word", "ar": "بَلِ", "tajweed": "بَلِ", "en": "Nay", "tr": "bali", "audio": "wbw/075_014_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "[The] man", "tr": "l-insānu", "audio": "wbw/075_014_002.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "against", "tr": "ʿalā", "audio": "wbw/075_014_003.mp3"}, {"type": "word", "ar": "نَفْسِهِۦ", "tajweed": "نَفۡسِه<rule class=madda_normal>ِۦ</rule>", "en": "himself", "tr": "nafsihi", "audio": "wbw/075_014_004.mp3"}, {"type": "word", "ar": "بَصِيرَةٌۭ", "tajweed": "بَصِيرَةٌ", "en": "(will be) a witness", "tr": "baṣīratun", "audio": "wbw/075_014_005.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "75:15", "juz": 29, "page": 577, "side_trans": "Even if he presents his excuses.", "words": [{"type": "word", "ar": "وَلَوْ", "tajweed": "وَلَوۡ", "en": "Even if", "tr": "walaw", "audio": "wbw/075_015_001.mp3"}, {"type": "word", "ar": "أَلْقَىٰ", "tajweed": "أَلۡقَىٰ", "en": "he presents", "tr": "alqā", "audio": "wbw/075_015_002.mp3"}, {"type": "word", "ar": "مَعَاذِيرَهُۥ", "tajweed": "مَعَاذِيرَهُۥ", "en": "his excuses", "tr": "maʿādhīrahu", "audio": "wbw/075_015_003.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "75:16", "juz": 29, "page": 577, "side_trans": "Move not your tongue with it, [O Muḥammad], to hasten with it [i.e., recitation of the Qur’ān].", "words": [{"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "Not", "tr": "lā", "audio": "wbw/075_016_001.mp3"}, {"type": "word", "ar": "تُحَرِّكْ", "tajweed": "تُحَرِّكۡ", "en": "move", "tr": "tuḥarrik", "audio": "wbw/075_016_002.mp3"}, {"type": "word", "ar": "بِهِۦ", "tajweed": "بِه<rule class=madda_normal>ِۦ</rule>", "en": "with it", "tr": "bihi", "audio": "wbw/075_016_003.mp3"}, {"type": "word", "ar": "لِسَانَكَ", "tajweed": "لِسَانَكَ", "en": "your tongue", "tr": "lisānaka", "audio": "wbw/075_016_004.mp3"}, {"type": "word", "ar": "لِتَعْجَلَ", "tajweed": "لِتَعۡجَلَ", "en": "to hasten", "tr": "litaʿjala", "audio": "wbw/075_016_005.mp3"}, {"type": "word", "ar": "بِهِۦٓ", "tajweed": "بِهِۦٓ", "en": "with it", "tr": "bihi", "audio": "wbw/075_016_006.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "75:17", "juz": 29, "page": 577, "side_trans": "Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/075_017_001.mp3"}, {"type": "word", "ar": "عَلَيْنَا", "tajweed": "عَلَيۡنَا", "en": "upon Us", "tr": "ʿalaynā", "audio": "wbw/075_017_002.mp3"}, {"type": "word", "ar": "جَمْعَهُۥ", "tajweed": "جَمۡعَهُ<rule class=madda_normal>ۥ</rule>", "en": "(is) its collection", "tr": "jamʿahu", "audio": "wbw/075_017_003.mp3"}, {"type": "word", "ar": "وَقُرْءَانَهُۥ", "tajweed": "وَقُرۡءَانَهُۥ", "en": "and its recitation", "tr": "waqur'ānahu", "audio": "wbw/075_017_004.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "75:18", "juz": 29, "page": 577, "side_trans": "So when We have recited it [through Gabriel], then follow its recitation.", "words": [{"type": "word", "ar": "فَإِذَا", "tajweed": "فَإِذَا", "en": "And when", "tr": "fa-idhā", "audio": "wbw/075_018_001.mp3"}, {"type": "word", "ar": "قَرَأْنَـٰهُ", "tajweed": "قَرَأۡنَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "We have recited it", "tr": "qaranāhu", "audio": "wbw/075_018_002.mp3"}, {"type": "word", "ar": "فَٱتَّبِعْ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>تَّبِعۡ", "en": "then follow", "tr": "fa-ittabiʿ", "audio": "wbw/075_018_003.mp3"}, {"type": "word", "ar": "قُرْءَانَهُۥ", "tajweed": "قُرۡءَانَهُۥ", "en": "its recitation", "tr": "qur'ānahu", "audio": "wbw/075_018_004.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "75:19", "juz": 29, "page": 577, "side_trans": "Then upon Us is its clarification [to you].", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/075_019_001.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "indeed", "tr": "inna", "audio": "wbw/075_019_002.mp3"}, {"type": "word", "ar": "عَلَيْنَا", "tajweed": "عَلَيۡنَا", "en": "upon Us", "tr": "ʿalaynā", "audio": "wbw/075_019_003.mp3"}, {"type": "word", "ar": "بَيَانَهُۥ", "tajweed": "بَيَانَهُۥ", "en": "(is) its explanation", "tr": "bayānahu", "audio": "wbw/075_019_004.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "75:20", "juz": 29, "page": 578, "side_trans": "No! But you [i.e., mankind] love the immediate", "words": [{"type": "word", "ar": "كَلَّا", "tajweed": "كَلَّا", "en": "No", "tr": "kallā", "audio": "wbw/075_020_001.mp3"}, {"type": "word", "ar": "بَلْ", "tajweed": "بَلۡ", "en": "But", "tr": "bal", "audio": "wbw/075_020_002.mp3"}, {"type": "word", "ar": "تُحِبُّونَ", "tajweed": "تُحِبُّونَ", "en": "you love", "tr": "tuḥibbūna", "audio": "wbw/075_020_003.mp3"}, {"type": "word", "ar": "ٱلْعَاجِلَةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَاجِلَةَ", "en": "the immediate", "tr": "l-ʿājilata", "audio": "wbw/075_020_004.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "75:21", "juz": 29, "page": 578, "side_trans": "And leave [i.e., neglect] the Hereafter.", "words": [{"type": "word", "ar": "وَتَذَرُونَ", "tajweed": "وَتَذَرُونَ", "en": "And leave", "tr": "watadharūna", "audio": "wbw/075_021_001.mp3"}, {"type": "word", "ar": "ٱلْـَٔاخِرَةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَخِرَةَ", "en": "the Hereafter", "tr": "l-ākhirata", "audio": "wbw/075_021_002.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "75:22", "juz": 29, "page": 578, "side_trans": "[Some] faces, that Day, will be radiant,", "words": [{"type": "word", "ar": "وُجُوهٌۭ", "tajweed": "وُجُو<rule class=idgham_ghunnah>هٌ</rule>", "en": "Faces", "tr": "wujūhun", "audio": "wbw/075_022_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۢ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=idgham_ghunnah>ذٍ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/075_022_002.mp3"}, {"type": "word", "ar": "نَّاضِرَةٌ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>َّاضِرَةٌ", "en": "(will be) radiant", "tr": "nāḍiratun", "audio": "wbw/075_022_003.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "75:23", "juz": 29, "page": 578, "side_trans": "Looking at their Lord.", "words": [{"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "Towards", "tr": "ilā", "audio": "wbw/075_023_001.mp3"}, {"type": "word", "ar": "رَبِّهَا", "tajweed": "رَبِّهَا", "en": "their Lord", "tr": "rabbihā", "audio": "wbw/075_023_002.mp3"}, {"type": "word", "ar": "نَاظِرَةٌۭ", "tajweed": "نَاظِرَةٌ", "en": "looking", "tr": "nāẓiratun", "audio": "wbw/075_023_003.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "75:24", "juz": 29, "page": 578, "side_trans": "And [some] faces, that Day, will be contorted,", "words": [{"type": "word", "ar": "وَوُجُوهٌۭ", "tajweed": "وَوُجُو<rule class=idgham_ghunnah>هٌ</rule>", "en": "And faces", "tr": "wawujūhun", "audio": "wbw/075_024_001.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍۭ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َوۡمَئِ<rule class=iqlab>ذِۭ</rule>", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/075_024_002.mp3"}, {"type": "word", "ar": "بَاسِرَةٌۭ", "tajweed": "<rule class=iqlab>ب</rule>َاسِرَةٌ", "en": "(will be) distorted", "tr": "bāsiratun", "audio": "wbw/075_024_003.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "75:25", "juz": 29, "page": 578, "side_trans": "Expecting that there will be done to them [something] backbreaking.", "words": [{"type": "word", "ar": "تَظُنُّ", "tajweed": "تَظُ<rule class=ghunnah>نّ</rule>ُ", "en": "Thinking", "tr": "taẓunnu", "audio": "wbw/075_025_001.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/075_025_002.mp3"}, {"type": "word", "ar": "يُفْعَلَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُفۡعَلَ", "en": "will be done", "tr": "yuf'ʿala", "audio": "wbw/075_025_003.mp3"}, {"type": "word", "ar": "بِهَا", "tajweed": "بِهَا", "en": "to them", "tr": "bihā", "audio": "wbw/075_025_004.mp3"}, {"type": "word", "ar": "فَاقِرَةٌۭ", "tajweed": "فَاقِرَةٌ", "en": "backbreaking", "tr": "fāqiratun", "audio": "wbw/075_025_005.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "75:26", "juz": 29, "page": 578, "side_trans": "No! When it [i.e., the soul] has reached the collar bones", "words": [{"type": "word", "ar": "كَلَّآ", "tajweed": "كَلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "No", "tr": "kallā", "audio": "wbw/075_026_001.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/075_026_002.mp3"}, {"type": "word", "ar": "بَلَغَتِ", "tajweed": "بَلَغَتِ", "en": "it reaches", "tr": "balaghati", "audio": "wbw/075_026_003.mp3"}, {"type": "word", "ar": "ٱلتَّرَاقِىَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>تَّرَاقِىَ", "en": "the collar bones", "tr": "l-tarāqiya", "audio": "wbw/075_026_004.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "75:27", "juz": 29, "page": 578, "side_trans": "And it is said, \"Who will cure [him]?\"", "words": [{"type": "word", "ar": "وَقِيلَ", "tajweed": "وَقِيلَ", "en": "And it is said", "tr": "waqīla", "audio": "wbw/075_027_001.mp3"}, {"type": "word", "ar": "مَنْ ۜ", "tajweed": "م<rule class=idgham_wo_ghunnah>َنۡۜ</rule>", "en": "Who", "tr": "man", "audio": "wbw/075_027_002.mp3"}, {"type": "word", "ar": "رَاقٍۢ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule><rule class=madda_permissible>َا</rule><rule class=qalaqah>ق</rule>ٍ", "en": "(will) cure", "tr": "rāqin", "audio": "wbw/075_027_004.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "75:28", "juz": 29, "page": 578, "side_trans": "And he [i.e., the dying one] is certain that it is the [time of] separation", "words": [{"type": "word", "ar": "وَظَنَّ", "tajweed": "وَظَ<rule class=ghunnah>نّ</rule>َ", "en": "And he is certain", "tr": "waẓanna", "audio": "wbw/075_028_001.mp3"}, {"type": "word", "ar": "أَنَّهُ", "tajweed": "أَ<rule class=ghunnah>نّ</rule>َهُ", "en": "that it", "tr": "annahu", "audio": "wbw/075_028_002.mp3"}, {"type": "word", "ar": "ٱلْفِرَاقُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفِر<rule class=madda_permissible>َا</rule><rule class=qalaqah>ق</rule>ُ", "en": "(is) the parting", "tr": "l-firāqu", "audio": "wbw/075_028_003.mp3"}, {"type": "end", "num": "٢٨"}]}, {"id": 29, "key": "75:29", "juz": 29, "page": 578, "side_trans": "And the leg is wound about the leg,", "words": [{"type": "word", "ar": "وَٱلْتَفَّتِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡتَفَّتِ", "en": "And is wound", "tr": "wal-tafati", "audio": "wbw/075_029_001.mp3"}, {"type": "word", "ar": "ٱلسَّاقُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّاقُ", "en": "the leg", "tr": "l-sāqu", "audio": "wbw/075_029_002.mp3"}, {"type": "word", "ar": "بِٱلسَّاقِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سّ<rule class=madda_permissible>َا</rule><rule class=qalaqah>ق</rule>ِ", "en": "about the leg", "tr": "bil-sāqi", "audio": "wbw/075_029_003.mp3"}, {"type": "end", "num": "٢٩"}]}, {"id": 30, "key": "75:30", "juz": 29, "page": 578, "side_trans": "To your Lord, that Day, will be the procession.", "words": [{"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "To", "tr": "ilā", "audio": "wbw/075_030_001.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "your Lord", "tr": "rabbika", "audio": "wbw/075_030_002.mp3"}, {"type": "word", "ar": "يَوْمَئِذٍ", "tajweed": "يَوۡمَئِذٍ", "en": "that Day", "tr": "yawma-idhin", "audio": "wbw/075_030_003.mp3"}, {"type": "word", "ar": "ٱلْمَسَاقُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَس<rule class=madda_permissible>َا</rule><rule class=qalaqah>ق</rule>ُ", "en": "(will be) the driving", "tr": "l-masāqu", "audio": "wbw/075_030_004.mp3"}, {"type": "end", "num": "٣٠"}]}, {"id": 31, "key": "75:31", "juz": 29, "page": 578, "side_trans": "And he [i.e., the disbeliever] had not believed, nor had he prayed.", "words": [{"type": "word", "ar": "فَلَا", "tajweed": "فَلَا", "en": "And not", "tr": "falā", "audio": "wbw/075_031_001.mp3"}, {"type": "word", "ar": "صَدَّقَ", "tajweed": "صَدَّقَ", "en": "he accepted (the) truth", "tr": "ṣaddaqa", "audio": "wbw/075_031_002.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "and not", "tr": "walā", "audio": "wbw/075_031_003.mp3"}, {"type": "word", "ar": "صَلَّىٰ", "tajweed": "صَلَّىٰ", "en": "he prayed", "tr": "ṣallā", "audio": "wbw/075_031_004.mp3"}, {"type": "end", "num": "٣١"}]}, {"id": 32, "key": "75:32", "juz": 29, "page": 578, "side_trans": "But [instead], he denied and turned away.", "words": [{"type": "word", "ar": "وَلَـٰكِن", "tajweed": "وَلَ<rule class=madda_normal>ـٰ</rule>كِ<rule class=ikhafa>ن</rule>", "en": "But", "tr": "walākin", "audio": "wbw/075_032_001.mp3"}, {"type": "word", "ar": "كَذَّبَ", "tajweed": "<rule class=ikhafa>ك</rule>َذَّبَ", "en": "he denied", "tr": "kadhaba", "audio": "wbw/075_032_002.mp3"}, {"type": "word", "ar": "وَتَوَلَّىٰ", "tajweed": "وَتَوَلَّىٰ", "en": "and turned away", "tr": "watawallā", "audio": "wbw/075_032_003.mp3"}, {"type": "end", "num": "٣٢"}]}, {"id": 33, "key": "75:33", "juz": 29, "page": 578, "side_trans": "And then he went to his people, swaggering [in pride].", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/075_033_001.mp3"}, {"type": "word", "ar": "ذَهَبَ", "tajweed": "ذَهَبَ", "en": "he went", "tr": "dhahaba", "audio": "wbw/075_033_002.mp3"}, {"type": "word", "ar": "إِلَىٰٓ", "tajweed": "إِلَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "to", "tr": "ilā", "audio": "wbw/075_033_003.mp3"}, {"type": "word", "ar": "أَهْلِهِۦ", "tajweed": "أَهۡلِه<rule class=madda_normal>ِۦ</rule>", "en": "his family", "tr": "ahlihi", "audio": "wbw/075_033_004.mp3"}, {"type": "word", "ar": "يَتَمَطَّىٰٓ", "tajweed": "يَتَمَطَّىٰٓ", "en": "swaggering", "tr": "yatamaṭṭā", "audio": "wbw/075_033_005.mp3"}, {"type": "end", "num": "٣٣"}]}, {"id": 34, "key": "75:34", "juz": 29, "page": 578, "side_trans": "Woe to you, and woe!", "words": [{"type": "word", "ar": "أَوْلَىٰ", "tajweed": "أَوۡلَىٰ", "en": "Woe", "tr": "awlā", "audio": "wbw/075_034_001.mp3"}, {"type": "word", "ar": "لَكَ", "tajweed": "لَكَ", "en": "to you", "tr": "laka", "audio": "wbw/075_034_002.mp3"}, {"type": "word", "ar": "فَأَوْلَىٰ", "tajweed": "فَأَوۡلَىٰ", "en": "and woe", "tr": "fa-awlā", "audio": "wbw/075_034_003.mp3"}, {"type": "end", "num": "٣٤"}]}, {"id": 35, "key": "75:35", "juz": 29, "page": 578, "side_trans": "Then woe to you, and woe!", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/075_035_001.mp3"}, {"type": "word", "ar": "أَوْلَىٰ", "tajweed": "أَوۡلَىٰ", "en": "woe", "tr": "awlā", "audio": "wbw/075_035_002.mp3"}, {"type": "word", "ar": "لَكَ", "tajweed": "لَكَ", "en": "to you", "tr": "laka", "audio": "wbw/075_035_003.mp3"}, {"type": "word", "ar": "فَأَوْلَىٰٓ", "tajweed": "فَأَوۡلَىٰٓ", "en": "and woe", "tr": "fa-awlā", "audio": "wbw/075_035_004.mp3"}, {"type": "end", "num": "٣٥"}]}, {"id": 36, "key": "75:36", "juz": 29, "page": 578, "side_trans": "Does man think that he will be left neglected?", "words": [{"type": "word", "ar": "أَيَحْسَبُ", "tajweed": "أَيَحۡسَبُ", "en": "Does think", "tr": "ayaḥsabu", "audio": "wbw/075_036_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نُ", "en": "man", "tr": "l-insānu", "audio": "wbw/075_036_002.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/075_036_003.mp3"}, {"type": "word", "ar": "يُتْرَكَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُتۡرَكَ", "en": "he will be left", "tr": "yut'raka", "audio": "wbw/075_036_004.mp3"}, {"type": "word", "ar": "سُدًى", "tajweed": "سُدًى", "en": "neglected", "tr": "sudan", "audio": "wbw/075_036_005.mp3"}, {"type": "end", "num": "٣٦"}]}, {"id": 37, "key": "75:37", "juz": 29, "page": 578, "side_trans": "Had he not been a sperm from semen emitted?", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Was not", "tr": "alam", "audio": "wbw/075_037_001.mp3"}, {"type": "word", "ar": "يَكُ", "tajweed": "يَكُ", "en": "he", "tr": "yaku", "audio": "wbw/075_037_002.mp3"}, {"type": "word", "ar": "نُطْفَةًۭ", "tajweed": "نُ<rule class=qalaqah>طۡ</rule>فَ<rule class=idgham_ghunnah>ةً</rule>", "en": "a semen-drop", "tr": "nuṭ'fatan", "audio": "wbw/075_037_003.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_ghunnah>م</rule>ّ<rule class=idgham_ghunnah>ِن</rule>", "en": "of", "tr": "min", "audio": "wbw/075_037_004.mp3"}, {"type": "word", "ar": "مَّنِىٍّۢ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّنِ<rule class=idgham_ghunnah>ىٍّ</rule>", "en": "semen", "tr": "maniyyin", "audio": "wbw/075_037_005.mp3"}, {"type": "word", "ar": "يُمْنَىٰ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُمۡنَىٰ", "en": "emitted", "tr": "yum'nā", "audio": "wbw/075_037_006.mp3"}, {"type": "end", "num": "٣٧"}]}, {"id": 38, "key": "75:38", "juz": 29, "page": 578, "side_trans": "Then he was a clinging clot, and [Allāh] created [his form] and proportioned [him]", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/075_038_001.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "he was", "tr": "kāna", "audio": "wbw/075_038_002.mp3"}, {"type": "word", "ar": "عَلَقَةًۭ", "tajweed": "عَلَقَ<rule class=ikhafa>ةً</rule>", "en": "a clinging substance", "tr": "ʿalaqatan", "audio": "wbw/075_038_003.mp3"}, {"type": "word", "ar": "فَخَلَقَ", "tajweed": "<rule class=ikhafa>ف</rule>َخَلَقَ", "en": "then He created", "tr": "fakhalaqa", "audio": "wbw/075_038_004.mp3"}, {"type": "word", "ar": "فَسَوَّىٰ", "tajweed": "فَسَوَّىٰ", "en": "and proportioned", "tr": "fasawwā", "audio": "wbw/075_038_005.mp3"}, {"type": "end", "num": "٣٨"}]}, {"id": 39, "key": "75:39", "juz": 29, "page": 578, "side_trans": "And made of him two mates, the male and the female.", "words": [{"type": "word", "ar": "فَجَعَلَ", "tajweed": "فَجَعَلَ", "en": "Then made", "tr": "fajaʿala", "audio": "wbw/075_039_001.mp3"}, {"type": "word", "ar": "مِنْهُ", "tajweed": "مِنۡهُ", "en": "of him", "tr": "min'hu", "audio": "wbw/075_039_002.mp3"}, {"type": "word", "ar": "ٱلزَّوْجَيْنِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>زَّوۡجَيۡنِ", "en": "two kinds", "tr": "l-zawjayni", "audio": "wbw/075_039_003.mp3"}, {"type": "word", "ar": "ٱلذَّكَرَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ذَّكَرَ", "en": "(the) male", "tr": "l-dhakara", "audio": "wbw/075_039_004.mp3"}, {"type": "word", "ar": "وَٱلْأُنثَىٰٓ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأُ<rule class=ikhafa>نث</rule>َىٰٓ", "en": "and the female", "tr": "wal-unthā", "audio": "wbw/075_039_005.mp3"}, {"type": "end", "num": "٣٩"}]}, {"id": 40, "key": "75:40", "juz": 29, "page": 578, "side_trans": "Is not that [Creator] Able to give life to the dead?", "words": [{"type": "word", "ar": "أَلَيْسَ", "tajweed": "أَلَيۡسَ", "en": "Is not", "tr": "alaysa", "audio": "wbw/075_040_001.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "[that]", "tr": "dhālika", "audio": "wbw/075_040_002.mp3"}, {"type": "word", "ar": "بِقَـٰدِرٍ", "tajweed": "بِقَ<rule class=madda_normal>ـٰ</rule>دِرٍ", "en": "(He) Able", "tr": "biqādirin", "audio": "wbw/075_040_003.mp3"}, {"type": "word", "ar": "عَلَىٰٓ", "tajweed": "عَلَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "[over]", "tr": "ʿalā", "audio": "wbw/075_040_004.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "to", "tr": "an", "audio": "wbw/075_040_005.mp3"}, {"type": "word", "ar": "يُحْـِۧىَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُحۡــِۧىَ", "en": "give life", "tr": "yuḥ'yiya", "audio": "wbw/075_040_006.mp3"}, {"type": "word", "ar": "ٱلْمَوْتَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَوۡتَىٰ", "en": "(to) the dead", "tr": "l-mawtā", "audio": "wbw/075_040_007.mp3"}, {"type": "end", "num": "٤٠"}]}]