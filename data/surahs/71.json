audio": "wbw/071_028_005.mp3"}, {"type": "word", "ar": "دَخَلَ", "tajweed": "<rule class=ikhafa>د</rule>َخَلَ", "en": "enters", "tr": "dakhala", "audio": "wbw/071_028_006.mp3"}, {"type": "word", "ar": "بَيْتِىَ", "tajweed": "بَيۡتِىَ", "en": "my house ", "tr": "baytiya", "audio": "wbw/071_028_007.mp3"}, {"type": "word", "ar": "مُؤْمِنًۭا", "tajweed": "مُؤۡمِ<rule class=idgham_ghunnah>نًا</rule>", "en": "a believer", "tr": "mu'minan", "audio": "wbw/071_028_008.mp3"}, {"type": "word", "ar": "وَلِلْمُؤْمِنِينَ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلِلۡمُؤۡمِنِينَ", "en": "and the believing men", "tr": "walil'mu'minīna", "audio": "wbw/071_028_009.mp3"}, {"type": "word", "ar": "وَٱلْمُؤْمِنَـٰتِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمُؤۡمِنَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "and the believing women", "tr": "wal-mu'mināti", "audio": "wbw/071_028_010.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "And (do) not", "tr": "walā", "audio": "wbw/071_028_011.mp3"}, {"type": "word", "ar": "تَزِدِ", "tajweed": "تَزِدِ", "en": "increase", "tr": "tazidi", "audio": "wbw/071_028_012.mp3"}, {"type": "word", "ar": "ٱلظَّـٰلِمِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ظَّ<rule class=madda_normal>ـٰ</rule>لِمِينَ", "en": "the wrongdoers", "tr": "l-ẓālimīna", "audio": "wbw/071_028_013.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/071_028_014.mp3"}, {"type": "word", "ar": "تَبَارًۢا", "tajweed": "تَبَارَۢا", "en": "(in) destruction", "tr": "tabāran", "audio": "wbw/071_028_015.mp3"}, {"type": "end", "num": "٢٨"}]}]