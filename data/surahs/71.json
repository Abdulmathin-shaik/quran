[{"id": 1, "key": "71:1", "juz": 29, "page": 570, "side_trans": "Indeed, We sent Noah to his people, [saying], \"Warn your people before there comes to them a painful punishment.\"", "words": [{"type": "word", "ar": "إِنَّآ", "tajweed": "إِ<rule class=ghunnah>نّ</rule><rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Indeed, We", "tr": "innā", "audio": "wbw/071_001_001.mp3"}, {"type": "word", "ar": "أَرْسَلْنَا", "tajweed": "أَرۡسَلۡنَا", "en": "[We] sent", "tr": "arsalnā", "audio": "wbw/071_001_002.mp3"}, {"type": "word", "ar": "نُوحًا", "tajweed": "نُوحًا", "en": "Nuh", "tr": "nūḥan", "audio": "wbw/071_001_003.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/071_001_004.mp3"}, {"type": "word", "ar": "قَوْمِهِۦٓ", "tajweed": "قَوۡمِه<rule class=madda_obligatory_monfasel>ِۦٓ</rule>", "en": "his people", "tr": "qawmihi", "audio": "wbw/071_001_005.mp3"}, {"type": "word", "ar": "أَنْ", "tajweed": "أَنۡ", "en": "that", "tr": "an", "audio": "wbw/071_001_006.mp3"}, {"type": "word", "ar": "أَنذِرْ", "tajweed": "أَ<rule class=ikhafa>نذ</rule>ِرۡ", "en": "Warn", "tr": "andhir", "audio": "wbw/071_001_007.mp3"}, {"type": "word", "ar": "قَوْمَكَ", "tajweed": "قَوۡمَكَ", "en": "your people", "tr": "qawmaka", "audio": "wbw/071_001_008.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/071_001_009.mp3"}, {"type": "word", "ar": "قَبْلِ", "tajweed": "<rule class=ikhafa>ق</rule>َ<rule class=qalaqah>بۡ</rule>لِ", "en": "before", "tr": "qabli", "audio": "wbw/071_001_010.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "[that]", "tr": "an", "audio": "wbw/071_001_011.mp3"}, {"type": "word", "ar": "يَأْتِيَهُمْ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َأۡتِيَهُمۡ", "en": "comes to them", "tr": "yatiyahum", "audio": "wbw/071_001_012.mp3"}, {"type": "word", "ar": "عَذَابٌ", "tajweed": "عَذَابٌ", "en": "a punishment", "tr": "ʿadhābun", "audio": "wbw/071_001_013.mp3"}, {"type": "word", "ar": "أَلِيمٌۭ", "tajweed": "أَل<rule class=madda_permissible>ِي</rule>مٌ", "en": "painful", "tr": "alīmun", "audio": "wbw/071_001_014.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "71:2", "juz": 29, "page": 570, "side_trans": "He said, \"O my people, indeed I am to you a clear warner -", "words": [{"type": "word", "ar": "قَالَ", "tajweed": "قَالَ", "en": "He said", "tr": "qāla", "audio": "wbw/071_002_001.mp3"}, {"type": "word", "ar": "يَـٰقَوْمِ", "tajweed": "يَ<rule class=madda_normal>ـٰ</rule>قَوۡمِ", "en": "O my people", "tr": "yāqawmi", "audio": "wbw/071_002_002.mp3"}, {"type": "word", "ar": "إِنِّى", "tajweed": "إِ<rule class=ghunnah>نّ</rule>ِى", "en": "Indeed, I am", "tr": "innī", "audio": "wbw/071_002_003.mp3"}, {"type": "word", "ar": "لَكُمْ", "tajweed": "لَكُمۡ", "en": "to you", "tr": "lakum", "audio": "wbw/071_002_004.mp3"}, {"type": "word", "ar": "نَذِيرٌۭ", "tajweed": "نَذِي<rule class=idgham_ghunnah>رٌ</rule>", "en": "a warner", "tr": "nadhīrun", "audio": "wbw/071_002_005.mp3"}, {"type": "word", "ar": "مُّبِينٌ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّب<rule class=madda_permissible>ِي</rule>نٌ", "en": "clear", "tr": "mubīnun", "audio": "wbw/071_002_006.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "71:3", "juz": 29, "page": 570, "side_trans": "To worship Allāh, fear Him and obey me.", "words": [{"type": "word", "ar": "أَنِ", "tajweed": "أَنِ", "en": "That", "tr": "ani", "audio": "wbw/071_003_001.mp3"}, {"type": "word", "ar": "ٱعْبُدُوا۟", "tajweed": "<rule class=ham_wasl>ٱ</rule>عۡبُدُو<rule class=slnt>اۡ</rule>", "en": "Worship", "tr": "uʿ'budū", "audio": "wbw/071_003_002.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/071_003_003.mp3"}, {"type": "word", "ar": "وَٱتَّقُوهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>تَّقُوهُ", "en": "and fear Him", "tr": "wa-ittaqūhu", "audio": "wbw/071_003_004.mp3"}, {"type": "word", "ar": "وَأَطِيعُونِ", "tajweed": "وَأَطِيع<rule class=madda_permissible>ُو</rule>نِ", "en": "and obey me", "tr": "wa-aṭīʿūni", "audio": "wbw/071_003_005.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "71:4", "juz": 29, "page": 570, "side_trans": "He [i.e., Allāh] will forgive you of your sins and delay you for a specified term. Indeed, the time [set by] Allāh, when it comes, will not be delayed, if you only knew.\"", "words": [{"type": "word", "ar": "يَغْفِرْ", "tajweed": "يَغۡفِرۡ", "en": "He will forgive", "tr": "yaghfir", "audio": "wbw/071_004_001.mp3"}, {"type": "word", "ar": "لَكُم", "tajweed": "لَك<rule class=idgham_shafawi>ُم</rule>", "en": "for you", "tr": "lakum", "audio": "wbw/071_004_002.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_shafawi>م</rule>ِّ<rule class=ikhafa>ن</rule>", "en": "[of]", "tr": "min", "audio": "wbw/071_004_003.mp3"}, {"type": "word", "ar": "ذُنُوبِكُمْ", "tajweed": "<rule class=ikhafa>ذ</rule>ُنُوبِكُمۡ", "en": "your sins", "tr": "dhunūbikum", "audio": "wbw/071_004_004.mp3"}, {"type": "word", "ar": "وَيُؤَخِّرْكُمْ", "tajweed": "وَيُؤَخِّرۡكُمۡ", "en": "and give you respite", "tr": "wayu-akhir'kum", "audio": "wbw/071_004_005.mp3"}, {"type": "word", "ar": "إِلَىٰٓ", "tajweed": "إِلَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "for", "tr": "ilā", "audio": "wbw/071_004_006.mp3"}, {"type": "word", "ar": "أَجَلٍۢ", "tajweed": "أَجَ<rule class=idgham_ghunnah>لٍ</rule>", "en": "a term", "tr": "ajalin", "audio": "wbw/071_004_007.mp3"}, {"type": "word", "ar": "مُّسَمًّى ۚ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّسَ<rule class=ghunnah>مّ</rule>ًى‌ۚ", "en": "specified", "tr": "musamman", "audio": "wbw/071_004_008.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/071_004_010.mp3"}, {"type": "word", "ar": "أَجَلَ", "tajweed": "أَجَلَ", "en": "(the) term", "tr": "ajala", "audio": "wbw/071_004_011.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/071_004_012.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/071_004_013.mp3"}, {"type": "word", "ar": "جَآءَ", "tajweed": "ج<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "it comes", "tr": "jāa", "audio": "wbw/071_004_014.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/071_004_015.mp3"}, {"type": "word", "ar": "يُؤَخَّرُ ۖ", "tajweed": "يُؤَخَّرُ‌ۖ", "en": "is delayed", "tr": "yu-akharu", "audio": "wbw/071_004_016.mp3"}, {"type": "word", "ar": "لَوْ", "tajweed": "لَوۡ", "en": "if", "tr": "law", "audio": "wbw/071_004_018.mp3"}, {"type": "word", "ar": "كُنتُمْ", "tajweed": "كُ<rule class=ikhafa>نت</rule>ُمۡ", "en": "you", "tr": "kuntum", "audio": "wbw/071_004_019.mp3"}, {"type": "word", "ar": "تَعْلَمُونَ", "tajweed": "تَعۡلَم<rule class=madda_permissible>ُو</rule>نَ", "en": "know", "tr": "taʿlamūna", "audio": "wbw/071_004_020.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "71:5", "juz": 29, "page": 570, "side_trans": "He said, \"My Lord, indeed I invited my people [to truth] night and day.", "words": [{"type": "word", "ar": "قَالَ", "tajweed": "قَالَ", "en": "He said", "tr": "qāla", "audio": "wbw/071_005_001.mp3"}, {"type": "word", "ar": "رَبِّ", "tajweed": "رَبِّ", "en": "My Lord", "tr": "rabbi", "audio": "wbw/071_005_002.mp3"}, {"type": "word", "ar": "إِنِّى", "tajweed": "إِ<rule class=ghunnah>نّ</rule>ِى", "en": "Indeed, I", "tr": "innī", "audio": "wbw/071_005_003.mp3"}, {"type": "word", "ar": "دَعَوْتُ", "tajweed": "دَعَوۡتُ", "en": "invited", "tr": "daʿawtu", "audio": "wbw/071_005_004.mp3"}, {"type": "word", "ar": "قَوْمِى", "tajweed": "قَوۡمِى", "en": "my people", "tr": "qawmī", "audio": "wbw/071_005_005.mp3"}, {"type": "word", "ar": "لَيْلًۭا", "tajweed": "لَيۡل<rule class=idgham_ghunnah>اً</rule>", "en": "night", "tr": "laylan", "audio": "wbw/071_005_006.mp3"}, {"type": "word", "ar": "وَنَهَارًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َنَهَارًا", "en": "and day", "tr": "wanahāran", "audio": "wbw/071_005_007.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "71:6", "juz": 29, "page": 570, "side_trans": "But my invitation increased them not except in flight [i.e., aversion].", "words": [{"type": "word", "ar": "فَلَمْ", "tajweed": "فَلَمۡ", "en": "But not", "tr": "falam", "audio": "wbw/071_006_001.mp3"}, {"type": "word", "ar": "يَزِدْهُمْ", "tajweed": "يَزِ<rule class=qalaqah>دۡ</rule>هُمۡ", "en": "increased them", "tr": "yazid'hum", "audio": "wbw/071_006_002.mp3"}, {"type": "word", "ar": "دُعَآءِىٓ", "tajweed": "دُع<rule class=madda_obligatory_mottasel>َا</rule>ٓء<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "my invitation", "tr": "duʿāī", "audio": "wbw/071_006_003.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/071_006_004.mp3"}, {"type": "word", "ar": "فِرَارًۭا", "tajweed": "فِرَارًا", "en": "(in) flight", "tr": "firāran", "audio": "wbw/071_006_005.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "71:7", "juz": 29, "page": 570, "side_trans": "And indeed, every time I invited them that You may forgive them, they put their fingers in their ears, covered themselves with their garments, persisted, and were arrogant with [great] arrogance.", "words": [{"type": "word", "ar": "وَإِنِّى", "tajweed": "وَإِ<rule class=ghunnah>نّ</rule>ِى", "en": "And indeed, I", "tr": "wa-innī", "audio": "wbw/071_007_001.mp3"}, {"type": "word", "ar": "كُلَّمَا", "tajweed": "كُلَّمَا", "en": "every time", "tr": "kullamā", "audio": "wbw/071_007_002.mp3"}, {"type": "word", "ar": "دَعَوْتُهُمْ", "tajweed": "دَعَوۡتُهُمۡ", "en": "I invited them", "tr": "daʿawtuhum", "audio": "wbw/071_007_003.mp3"}, {"type": "word", "ar": "لِتَغْفِرَ", "tajweed": "لِتَغۡفِرَ", "en": "that You may forgive", "tr": "litaghfira", "audio": "wbw/071_007_004.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "them", "tr": "lahum", "audio": "wbw/071_007_005.mp3"}, {"type": "word", "ar": "جَعَلُوٓا۟", "tajweed": "جَعَل<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "they put", "tr": "jaʿalū", "audio": "wbw/071_007_006.mp3"}, {"type": "word", "ar": "أَصَـٰبِعَهُمْ", "tajweed": "أَصَ<rule class=madda_normal>ـٰ</rule>بِعَهُمۡ", "en": "their fingers", "tr": "aṣābiʿahum", "audio": "wbw/071_007_007.mp3"}, {"type": "word", "ar": "فِىٓ", "tajweed": "ف<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "in", "tr": "fī", "audio": "wbw/071_007_008.mp3"}, {"type": "word", "ar": "ءَاذَانِهِمْ", "tajweed": "ءَاذَانِهِمۡ", "en": "their ears", "tr": "ādhānihim", "audio": "wbw/071_007_009.mp3"}, {"type": "word", "ar": "وَٱسْتَغْشَوْا۟", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>سۡتَغۡشَوۡ<rule class=slnt>اۡ</rule>", "en": "and covered themselves", "tr": "wa-is'taghshaw", "audio": "wbw/071_007_010.mp3"}, {"type": "word", "ar": "ثِيَابَهُمْ", "tajweed": "ثِيَابَهُمۡ", "en": "(with) their garments", "tr": "thiyābahum", "audio": "wbw/071_007_011.mp3"}, {"type": "word", "ar": "وَأَصَرُّوا۟", "tajweed": "وَأَصَرُّو<rule class=slnt>اۡ</rule>", "en": "and persisted", "tr": "wa-aṣarrū", "audio": "wbw/071_007_012.mp3"}, {"type": "word", "ar": "وَٱسْتَكْبَرُوا۟", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>سۡتَكۡبَرُو<rule class=slnt>اۡ</rule>", "en": "and were arrogant", "tr": "wa-is'takbarū", "audio": "wbw/071_007_013.mp3"}, {"type": "word", "ar": "ٱسْتِكْبَارًۭا", "tajweed": "<rule class=ham_wasl>ٱ</rule>سۡتِكۡبَارًا", "en": "(with) pride", "tr": "is'tik'bāran", "audio": "wbw/071_007_014.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "71:8", "juz": 29, "page": 570, "side_trans": "Then I invited them publicly.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/071_008_001.mp3"}, {"type": "word", "ar": "إِنِّى", "tajweed": "إِ<rule class=ghunnah>نّ</rule>ِى", "en": "indeed, I", "tr": "innī", "audio": "wbw/071_008_002.mp3"}, {"type": "word", "ar": "دَعَوْتُهُمْ", "tajweed": "دَعَوۡتُهُمۡ", "en": "invited them", "tr": "daʿawtuhum", "audio": "wbw/071_008_003.mp3"}, {"type": "word", "ar": "جِهَارًۭا", "tajweed": "جِهَارًا", "en": "publicly", "tr": "jihāran", "audio": "wbw/071_008_004.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "71:9", "juz": 29, "page": 570, "side_trans": "Then I announced to them and [also] confided to them secretly", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/071_009_001.mp3"}, {"type": "word", "ar": "إِنِّىٓ", "tajweed": "إِ<rule class=ghunnah>نّ</rule><rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "indeed, I", "tr": "innī", "audio": "wbw/071_009_002.mp3"}, {"type": "word", "ar": "أَعْلَنتُ", "tajweed": "أَعۡلَ<rule class=ikhafa>نت</rule>ُ", "en": "announced", "tr": "aʿlantu", "audio": "wbw/071_009_003.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "to them", "tr": "lahum", "audio": "wbw/071_009_004.mp3"}, {"type": "word", "ar": "وَأَسْرَرْتُ", "tajweed": "وَأَسۡرَرۡتُ", "en": "and I confided", "tr": "wa-asrartu", "audio": "wbw/071_009_005.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "to them", "tr": "lahum", "audio": "wbw/071_009_006.mp3"}, {"type": "word", "ar": "إِسْرَارًۭا", "tajweed": "إِسۡرَارًا", "en": "secretly", "tr": "is'rāran", "audio": "wbw/071_009_007.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "71:10", "juz": 29, "page": 570, "side_trans": "And said, 'Ask forgiveness of your Lord. Indeed, He is ever a Perpetual Forgiver.", "words": [{"type": "word", "ar": "فَقُلْتُ", "tajweed": "فَقُلۡتُ", "en": "Then I said", "tr": "faqul'tu", "audio": "wbw/071_010_001.mp3"}, {"type": "word", "ar": "ٱسْتَغْفِرُوا۟", "tajweed": "<rule class=ham_wasl>ٱ</rule>سۡتَغۡفِرُو<rule class=slnt>اۡ</rule>", "en": "Ask forgiveness", "tr": "is'taghfirū", "audio": "wbw/071_010_002.mp3"}, {"type": "word", "ar": "رَبَّكُمْ", "tajweed": "رَبَّكُمۡ", "en": "(from) your Lord", "tr": "rabbakum", "audio": "wbw/071_010_003.mp3"}, {"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, He", "tr": "innahu", "audio": "wbw/071_010_004.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "is", "tr": "kāna", "audio": "wbw/071_010_005.mp3"}, {"type": "word", "ar": "غَفَّارًۭا", "tajweed": "غَفَّارًا", "en": "Oft-Forgiving", "tr": "ghaffāran", "audio": "wbw/071_010_006.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "71:11", "juz": 29, "page": 571, "side_trans": "He will send [rain from] the sky upon you in [continuing] showers", "words": [{"type": "word", "ar": "يُرْسِلِ", "tajweed": "يُرۡسِلِ", "en": "He will send down", "tr": "yur'sili", "audio": "wbw/071_011_001.mp3"}, {"type": "word", "ar": "ٱلسَّمَآءَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "(rain from) the sky", "tr": "l-samāa", "audio": "wbw/071_011_002.mp3"}, {"type": "word", "ar": "عَلَيْكُم", "tajweed": "عَلَيۡك<rule class=idgham_shafawi>ُم</rule>", "en": "upon you", "tr": "ʿalaykum", "audio": "wbw/071_011_003.mp3"}, {"type": "word", "ar": "مِّدْرَارًۭا", "tajweed": "<rule class=idgham_shafawi>م</rule>ِّ<rule class=qalaqah>دۡ</rule>رَارًا", "en": "(in) abundance", "tr": "mid'rāran", "audio": "wbw/071_011_004.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "71:12", "juz": 29, "page": 571, "side_trans": "And give you increase in wealth and children and provide for you gardens and provide for you rivers.", "words": [{"type": "word", "ar": "وَيُمْدِدْكُم", "tajweed": "وَيُمۡدِ<rule class=qalaqah>دۡ</rule>ك<rule class=ikhafa_shafawi>ُم</rule>", "en": "And provide you", "tr": "wayum'did'kum", "audio": "wbw/071_012_001.mp3"}, {"type": "word", "ar": "بِأَمْوَٰلٍۢ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِأَمۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule><rule class=idgham_ghunnah>لٍ</rule>", "en": "with wealth", "tr": "bi-amwālin", "audio": "wbw/071_012_002.mp3"}, {"type": "word", "ar": "وَبَنِينَ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َبَنِينَ", "en": "and children", "tr": "wabanīna", "audio": "wbw/071_012_003.mp3"}, {"type": "word", "ar": "وَيَجْعَل", "tajweed": "وَيَ<rule class=qalaqah>جۡ</rule>عَل", "en": "and make", "tr": "wayajʿal", "audio": "wbw/071_012_004.mp3"}, {"type": "word", "ar": "لَّكُمْ", "tajweed": "لَّكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/071_012_005.mp3"}, {"type": "word", "ar": "جَنَّـٰتٍۢ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>تٍ</rule>", "en": "gardens", "tr": "jannātin", "audio": "wbw/071_012_006.mp3"}, {"type": "word", "ar": "وَيَجْعَل", "tajweed": "<rule class=idgham_ghunnah>و</rule>َيَ<rule class=qalaqah>جۡ</rule>عَل", "en": "and make", "tr": "wayajʿal", "audio": "wbw/071_012_007.mp3"}, {"type": "word", "ar": "لَّكُمْ", "tajweed": "لَّكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/071_012_008.mp3"}, {"type": "word", "ar": "أَنْهَـٰرًۭا", "tajweed": "أَنۡهَ<rule class=madda_normal>ـٰ</rule>رًا", "en": "rivers", "tr": "anhāran", "audio": "wbw/071_012_009.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "71:13", "juz": 29, "page": 571, "side_trans": "What is [the matter] with you that you do not attribute to Allāh [due] grandeur", "words": [{"type": "word", "ar": "مَّا", "tajweed": "مَّا", "en": "What", "tr": "mā", "audio": "wbw/071_013_001.mp3"}, {"type": "word", "ar": "لَكُمْ", "tajweed": "لَكُمۡ", "en": "(is) for you", "tr": "lakum", "audio": "wbw/071_013_002.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/071_013_003.mp3"}, {"type": "word", "ar": "تَرْجُونَ", "tajweed": "تَرۡجُونَ", "en": "you attribute", "tr": "tarjūna", "audio": "wbw/071_013_004.mp3"}, {"type": "word", "ar": "لِلَّهِ", "tajweed": "لِلَّهِ", "en": "to Allah", "tr": "lillahi", "audio": "wbw/071_013_005.mp3"}, {"type": "word", "ar": "وَقَارًۭا", "tajweed": "وَقَارًا", "en": "grandeur", "tr": "waqāran", "audio": "wbw/071_013_006.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "71:14", "juz": 29, "page": 571, "side_trans": "While He has created you in stages?", "words": [{"type": "word", "ar": "وَقَدْ", "tajweed": "وَقَ<rule class=qalaqah>دۡ</rule>", "en": "And indeed", "tr": "waqad", "audio": "wbw/071_014_001.mp3"}, {"type": "word", "ar": "خَلَقَكُمْ", "tajweed": "خَلَقَكُمۡ", "en": "He created you", "tr": "khalaqakum", "audio": "wbw/071_014_002.mp3"}, {"type": "word", "ar": "أَطْوَارًا", "tajweed": "أَ<rule class=qalaqah>طۡ</rule>وَارًا", "en": "(in) stages", "tr": "aṭwāran", "audio": "wbw/071_014_003.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "71:15", "juz": 29, "page": 571, "side_trans": "Do you not consider how Allāh has created seven heavens in layers", "words": [{"type": "word", "ar": "أَلَمْ", "tajweed": "أَلَمۡ", "en": "Do not", "tr": "alam", "audio": "wbw/071_015_001.mp3"}, {"type": "word", "ar": "تَرَوْا۟", "tajweed": "تَرَوۡ<rule class=slnt>اۡ</rule>", "en": "you see", "tr": "taraw", "audio": "wbw/071_015_002.mp3"}, {"type": "word", "ar": "كَيْفَ", "tajweed": "كَيۡفَ", "en": "how", "tr": "kayfa", "audio": "wbw/071_015_003.mp3"}, {"type": "word", "ar": "خَلَقَ", "tajweed": "خَلَقَ", "en": "did create", "tr": "khalaqa", "audio": "wbw/071_015_004.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/071_015_005.mp3"}, {"type": "word", "ar": "سَبْعَ", "tajweed": "سَ<rule class=qalaqah>بۡ</rule>عَ", "en": "(the) seven", "tr": "sabʿa", "audio": "wbw/071_015_006.mp3"}, {"type": "word", "ar": "سَمَـٰوَٰتٍۢ", "tajweed": "سَمَ<rule class=madda_normal>ـٰ</rule>و<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule><rule class=ikhafa>تٍ</rule>", "en": "heavens", "tr": "samāwātin", "audio": "wbw/071_015_007.mp3"}, {"type": "word", "ar": "طِبَاقًۭا", "tajweed": "<rule class=ikhafa>ط</rule>ِبَاقًا", "en": "(in) layers", "tr": "ṭibāqan", "audio": "wbw/071_015_008.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "71:16", "juz": 29, "page": 571, "side_trans": "And made the moon therein a [reflected] light and made the sun a burning lamp?", "words": [{"type": "word", "ar": "وَجَعَلَ", "tajweed": "وَجَعَلَ", "en": "And made", "tr": "wajaʿala", "audio": "wbw/071_016_001.mp3"}, {"type": "word", "ar": "ٱلْقَمَرَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَمَرَ", "en": "the moon", "tr": "l-qamara", "audio": "wbw/071_016_002.mp3"}, {"type": "word", "ar": "فِيهِنَّ", "tajweed": "فِيهِ<rule class=ghunnah>نّ</rule>َ", "en": "therein", "tr": "fīhinna", "audio": "wbw/071_016_003.mp3"}, {"type": "word", "ar": "نُورًۭا", "tajweed": "نُو<rule class=idgham_ghunnah>رًا</rule>", "en": "a light", "tr": "nūran", "audio": "wbw/071_016_004.mp3"}, {"type": "word", "ar": "وَجَعَلَ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َجَعَلَ", "en": "and made", "tr": "wajaʿala", "audio": "wbw/071_016_005.mp3"}, {"type": "word", "ar": "ٱلشَّمْسَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شَّمۡسَ", "en": "the sun", "tr": "l-shamsa", "audio": "wbw/071_016_006.mp3"}, {"type": "word", "ar": "سِرَاجًۭا", "tajweed": "سِرَاجًا", "en": "a lamp", "tr": "sirājan", "audio": "wbw/071_016_007.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "71:17", "juz": 29, "page": 571, "side_trans": "And Allāh has caused you to grow from the earth a [progressive] growth.", "words": [{"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/071_017_001.mp3"}, {"type": "word", "ar": "أَنۢبَتَكُم", "tajweed": "أَ<rule class=iqlab>نۢب</rule>َتَك<rule class=idgham_shafawi>ُم</rule>", "en": "has caused you to grow", "tr": "anbatakum", "audio": "wbw/071_017_002.mp3"}, {"type": "word", "ar": "مِّنَ", "tajweed": "<rule class=idgham_shafawi>م</rule>ِّنَ", "en": "from", "tr": "mina", "audio": "wbw/071_017_003.mp3"}, {"type": "word", "ar": "ٱلْأَرْضِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "the earth", "tr": "l-arḍi", "audio": "wbw/071_017_004.mp3"}, {"type": "word", "ar": "نَبَاتًۭا", "tajweed": "نَبَاتًا", "en": "(as) a growth", "tr": "nabātan", "audio": "wbw/071_017_005.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "71:18", "juz": 29, "page": 571, "side_trans": "Then He will return you into it and extract you [another] extraction.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/071_018_001.mp3"}, {"type": "word", "ar": "يُعِيدُكُمْ", "tajweed": "يُعِيدُكُمۡ", "en": "He will return you", "tr": "yuʿīdukum", "audio": "wbw/071_018_002.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "into it", "tr": "fīhā", "audio": "wbw/071_018_003.mp3"}, {"type": "word", "ar": "وَيُخْرِجُكُمْ", "tajweed": "وَيُخۡرِجُكُمۡ", "en": "and bring you forth", "tr": "wayukh'rijukum", "audio": "wbw/071_018_004.mp3"}, {"type": "word", "ar": "إِخْرَاجًۭا", "tajweed": "إِخۡرَاجًا", "en": "(a new) bringing forth", "tr": "ikh'rājan", "audio": "wbw/071_018_005.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "71:19", "juz": 29, "page": 571, "side_trans": "And Allāh has made for you the earth an expanse", "words": [{"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/071_019_001.mp3"}, {"type": "word", "ar": "جَعَلَ", "tajweed": "جَعَلَ", "en": "made", "tr": "jaʿala", "audio": "wbw/071_019_002.mp3"}, {"type": "word", "ar": "لَكُمُ", "tajweed": "لَكُمُ", "en": "for you", "tr": "lakumu", "audio": "wbw/071_019_003.mp3"}, {"type": "word", "ar": "ٱلْأَرْضَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضَ", "en": "the earth", "tr": "l-arḍa", "audio": "wbw/071_019_004.mp3"}, {"type": "word", "ar": "بِسَاطًۭا", "tajweed": "بِسَاطًا", "en": "an expanse", "tr": "bisāṭan", "audio": "wbw/071_019_005.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "71:20", "juz": 29, "page": 571, "side_trans": "That you may follow therein roads of passage.'\"", "words": [{"type": "word", "ar": "لِّتَسْلُكُوا۟", "tajweed": "لِّتَسۡلُكُو<rule class=slnt>اۡ</rule>", "en": "That you may go along", "tr": "litaslukū", "audio": "wbw/071_020_001.mp3"}, {"type": "word", "ar": "مِنْهَا", "tajweed": "مِنۡهَا", "en": "therein", "tr": "min'hā", "audio": "wbw/071_020_002.mp3"}, {"type": "word", "ar": "سُبُلًۭا", "tajweed": "سُبُل<rule class=ikhafa>اً</rule>", "en": "(in) paths", "tr": "subulan", "audio": "wbw/071_020_003.mp3"}, {"type": "word", "ar": "فِجَاجًۭا", "tajweed": "<rule class=ikhafa>ف</rule>ِجَاجًا", "en": "wide", "tr": "fijājan", "audio": "wbw/071_020_004.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "71:21", "juz": 29, "page": 571, "side_trans": "Noah said, \"My Lord, indeed they have disobeyed me and followed him whose wealth and children will not increase him except in loss.", "words": [{"type": "word", "ar": "قَالَ", "tajweed": "قَالَ", "en": "Said", "tr": "qāla", "audio": "wbw/071_021_001.mp3"}, {"type": "word", "ar": "نُوحٌۭ", "tajweed": "نُو<rule class=idgham_wo_ghunnah>حٌ</rule>", "en": "Nuh", "tr": "nūḥun", "audio": "wbw/071_021_002.mp3"}, {"type": "word", "ar": "رَّبِّ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّبِّ", "en": "My Lord", "tr": "rabbi", "audio": "wbw/071_021_003.mp3"}, {"type": "word", "ar": "إِنَّهُمْ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "Indeed, they", "tr": "innahum", "audio": "wbw/071_021_004.mp3"}, {"type": "word", "ar": "عَصَوْنِى", "tajweed": "عَصَوۡنِى", "en": "disobeyed me", "tr": "ʿaṣawnī", "audio": "wbw/071_021_005.mp3"}, {"type": "word", "ar": "وَٱتَّبَعُوا۟", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>تَّبَعُو<rule class=slnt>اۡ</rule>", "en": "and followed", "tr": "wa-ittabaʿū", "audio": "wbw/071_021_006.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "م<rule class=idgham_wo_ghunnah>َن</rule>", "en": "(the one) who", "tr": "man", "audio": "wbw/071_021_007.mp3"}, {"type": "word", "ar": "لَّمْ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>َّمۡ", "en": "(did) not", "tr": "lam", "audio": "wbw/071_021_008.mp3"}, {"type": "word", "ar": "يَزِدْهُ", "tajweed": "يَزِ<rule class=qalaqah>دۡ</rule>هُ", "en": "increase him", "tr": "yazid'hu", "audio": "wbw/071_021_009.mp3"}, {"type": "word", "ar": "مَالُهُۥ", "tajweed": "مَالُهُ<rule class=madda_normal>ۥ</rule>", "en": "his wealth", "tr": "māluhu", "audio": "wbw/071_021_010.mp3"}, {"type": "word", "ar": "وَوَلَدُهُۥٓ", "tajweed": "وَوَلَدُهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "and his children", "tr": "wawaladuhu", "audio": "wbw/071_021_011.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/071_021_012.mp3"}, {"type": "word", "ar": "خَسَارًۭا", "tajweed": "خَسَارًا", "en": "(in) loss", "tr": "khasāran", "audio": "wbw/071_021_013.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "71:22", "juz": 29, "page": 571, "side_trans": "And they conspired an immense conspiracy", "words": [{"type": "word", "ar": "وَمَكَرُوا۟", "tajweed": "وَمَكَرُو<rule class=slnt>اۡ</rule>", "en": "And they have planned", "tr": "wamakarū", "audio": "wbw/071_022_001.mp3"}, {"type": "word", "ar": "مَكْرًۭا", "tajweed": "مَكۡ<rule class=ikhafa>رًا</rule>", "en": "a plan", "tr": "makran", "audio": "wbw/071_022_002.mp3"}, {"type": "word", "ar": "كُبَّارًۭا", "tajweed": "<rule class=ikhafa>ك</rule>ُبَّارًا", "en": "great", "tr": "kubbāran", "audio": "wbw/071_022_003.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "71:23", "juz": 29, "page": 571, "side_trans": "And said, 'Never leave your gods and never leave Wadd or Suwāʿ or Yaghūth and Yaʿūq and Nasr.'", "words": [{"type": "word", "ar": "وَقَالُوا۟", "tajweed": "وَقَالُو<rule class=slnt>اۡ</rule>", "en": "And they said", "tr": "waqālū", "audio": "wbw/071_023_001.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(Do) not", "tr": "lā", "audio": "wbw/071_023_002.mp3"}, {"type": "word", "ar": "تَذَرُنَّ", "tajweed": "تَذَرُ<rule class=ghunnah>نّ</rule>َ", "en": "leave", "tr": "tadharunna", "audio": "wbw/071_023_003.mp3"}, {"type": "word", "ar": "ءَالِهَتَكُمْ", "tajweed": "ءَالِهَتَكُمۡ", "en": "your gods", "tr": "ālihatakum", "audio": "wbw/071_023_004.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "and (do) not", "tr": "walā", "audio": "wbw/071_023_005.mp3"}, {"type": "word", "ar": "تَذَرُنَّ", "tajweed": "تَذَرُ<rule class=ghunnah>نّ</rule>َ", "en": "leave", "tr": "tadharunna", "audio": "wbw/071_023_006.mp3"}, {"type": "word", "ar": "وَدًّۭا", "tajweed": "وَد<rule class=idgham_ghunnah>ًّا</rule>", "en": "Wadd", "tr": "waddan", "audio": "wbw/071_023_007.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "and not", "tr": "walā", "audio": "wbw/071_023_008.mp3"}, {"type": "word", "ar": "سُوَاعًۭا", "tajweed": "سُوَا<rule class=idgham_ghunnah>عًا</rule>", "en": "Suwa", "tr": "suwāʿan", "audio": "wbw/071_023_009.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "and not", "tr": "walā", "audio": "wbw/071_023_010.mp3"}, {"type": "word", "ar": "يَغُوثَ", "tajweed": "يَغُوثَ", "en": "Yaguth", "tr": "yaghūtha", "audio": "wbw/071_023_011.mp3"}, {"type": "word", "ar": "وَيَعُوقَ", "tajweed": "وَيَعُوقَ", "en": "and Yauq", "tr": "wayaʿūqa", "audio": "wbw/071_023_012.mp3"}, {"type": "word", "ar": "وَنَسْرًۭا", "tajweed": "وَنَسۡرًا", "en": "and Nasr", "tr": "wanasran", "audio": "wbw/071_023_013.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "71:24", "juz": 29, "page": 571, "side_trans": "And already they have misled many. And, [my Lord], do not increase the wrongdoers except in error.\"", "words": [{"type": "word", "ar": "وَقَدْ", "tajweed": "وَقَ<rule class=qalaqah>دۡ</rule>", "en": "And indeed", "tr": "waqad", "audio": "wbw/071_024_001.mp3"}, {"type": "word", "ar": "أَضَلُّوا۟", "tajweed": "أَضَلُّو<rule class=slnt>اۡ</rule>", "en": "they have led astray", "tr": "aḍallū", "audio": "wbw/071_024_002.mp3"}, {"type": "word", "ar": "كَثِيرًۭا ۖ", "tajweed": "كَثِي<rule class=idgham_ghunnah>رًا‌ۖ</rule>", "en": "many", "tr": "kathīran", "audio": "wbw/071_024_003.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "And not", "tr": "walā", "audio": "wbw/071_024_005.mp3"}, {"type": "word", "ar": "تَزِدِ", "tajweed": "تَزِدِ", "en": "increase", "tr": "tazidi", "audio": "wbw/071_024_006.mp3"}, {"type": "word", "ar": "ٱلظَّـٰلِمِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ظَّ<rule class=madda_normal>ـٰ</rule>لِمِينَ", "en": "the wrongdoers", "tr": "l-ẓālimīna", "audio": "wbw/071_024_007.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/071_024_008.mp3"}, {"type": "word", "ar": "ضَلَـٰلًۭا", "tajweed": "ضَلَ<rule class=madda_normal>ـٰ</rule>لاً", "en": "(in) error", "tr": "ḍalālan", "audio": "wbw/071_024_009.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "71:25", "juz": 29, "page": 571, "side_trans": "Because of their sins they were drowned and put into the Fire, and they found not for themselves besides Allāh [any] helpers.", "words": [{"type": "word", "ar": "مِّمَّا", "tajweed": "مِّ<rule class=ghunnah>مّ</rule>َا", "en": "Because of", "tr": "mimmā", "audio": "wbw/071_025_001.mp3"}, {"type": "word", "ar": "خَطِيٓـَٔـٰتِهِمْ", "tajweed": "خَط<rule class=madda_obligatory_mottasel>ِيٓ</rule>ـَٔ<rule class=madda_normal>ـٰ</rule>تِهِمۡ", "en": "their sins", "tr": "khaṭīātihim", "audio": "wbw/071_025_002.mp3"}, {"type": "word", "ar": "أُغْرِقُوا۟", "tajweed": "أُغۡرِقُو<rule class=slnt>اۡ</rule>", "en": "they were drowned", "tr": "ugh'riqū", "audio": "wbw/071_025_003.mp3"}, {"type": "word", "ar": "فَأُدْخِلُوا۟", "tajweed": "فَأُ<rule class=qalaqah>دۡ</rule>خِلُو<rule class=slnt>اۡ</rule>", "en": "then made to enter", "tr": "fa-ud'khilū", "audio": "wbw/071_025_004.mp3"}, {"type": "word", "ar": "نَارًۭا", "tajweed": "نَا<rule class=ikhafa>رًا</rule>", "en": "(the) Fire", "tr": "nāran", "audio": "wbw/071_025_005.mp3"}, {"type": "word", "ar": "فَلَمْ", "tajweed": "<rule class=ikhafa>ف</rule>َلَمۡ", "en": "and not", "tr": "falam", "audio": "wbw/071_025_006.mp3"}, {"type": "word", "ar": "يَجِدُوا۟", "tajweed": "يَجِدُو<rule class=slnt>اۡ</rule>", "en": "they found", "tr": "yajidū", "audio": "wbw/071_025_007.mp3"}, {"type": "word", "ar": "لَهُم", "tajweed": "لَه<rule class=idgham_shafawi>ُم</rule>", "en": "for themselves", "tr": "lahum", "audio": "wbw/071_025_008.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_shafawi>م</rule>ِّ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/071_025_009.mp3"}, {"type": "word", "ar": "دُونِ", "tajweed": "<rule class=ikhafa>د</rule>ُونِ", "en": "besides", "tr": "dūni", "audio": "wbw/071_025_010.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/071_025_011.mp3"}, {"type": "word", "ar": "أَنصَارًۭا", "tajweed": "أَ<rule class=ikhafa>نص</rule>َارًا", "en": "any helpers", "tr": "anṣāran", "audio": "wbw/071_025_012.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "71:26", "juz": 29, "page": 571, "side_trans": "And Noah said, \"My Lord, do not leave upon the earth from among the disbelievers an inhabitant.", "words": [{"type": "word", "ar": "وَقَالَ", "tajweed": "وَقَالَ", "en": "And said", "tr": "waqāla", "audio": "wbw/071_026_001.mp3"}, {"type": "word", "ar": "نُوحٌۭ", "tajweed": "نُو<rule class=idgham_wo_ghunnah>حٌ</rule>", "en": "Nuh", "tr": "nūḥun", "audio": "wbw/071_026_002.mp3"}, {"type": "word", "ar": "رَّبِّ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّبِّ", "en": "My Lord", "tr": "rabbi", "audio": "wbw/071_026_003.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(Do) not", "tr": "lā", "audio": "wbw/071_026_004.mp3"}, {"type": "word", "ar": "تَذَرْ", "tajweed": "تَذَرۡ", "en": "leave", "tr": "tadhar", "audio": "wbw/071_026_005.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "on", "tr": "ʿalā", "audio": "wbw/071_026_006.mp3"}, {"type": "word", "ar": "ٱلْأَرْضِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "the earth", "tr": "l-arḍi", "audio": "wbw/071_026_007.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "any", "tr": "mina", "audio": "wbw/071_026_008.mp3"}, {"type": "word", "ar": "ٱلْكَـٰفِرِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَ<rule class=madda_normal>ـٰ</rule>فِرِينَ", "en": "(of) the disbelievers", "tr": "l-kāfirīna", "audio": "wbw/071_026_009.mp3"}, {"type": "word", "ar": "دَيَّارًا", "tajweed": "دَيَّارًا", "en": "(as) an inhabitant", "tr": "dayyāran", "audio": "wbw/071_026_010.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "71:27", "juz": 29, "page": 571, "side_trans": "Indeed, if You leave them, they will mislead Your servants and not beget except [every] wicked one and [confirmed] disbeliever.", "words": [{"type": "word", "ar": "إِنَّكَ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َكَ", "en": "Indeed, You", "tr": "innaka", "audio": "wbw/071_027_001.mp3"}, {"type": "word", "ar": "إِن", "tajweed": "إِ<rule class=ikhafa>ن</rule>", "en": "if", "tr": "in", "audio": "wbw/071_027_002.mp3"}, {"type": "word", "ar": "تَذَرْهُمْ", "tajweed": "<rule class=ikhafa>ت</rule>َذَرۡهُمۡ", "en": "You leave them", "tr": "tadharhum", "audio": "wbw/071_027_003.mp3"}, {"type": "word", "ar": "يُضِلُّوا۟", "tajweed": "ي