[{"id": 1, "key": "103:1", "juz": 30, "page": 601, "side_trans": "By time,", "words": [{"type": "word", "ar": "وَٱلْعَصْرِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡعَصۡرِ", "en": "By the time", "tr": "wal-ʿaṣri", "audio": "wbw/103_001_001.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "103:2", "juz": 30, "page": 601, "side_trans": "Indeed, mankind is in loss,", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/103_002_001.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نَ", "en": "mankind", "tr": "l-insāna", "audio": "wbw/103_002_002.mp3"}, {"type": "word", "ar": "لَفِى", "tajweed": "لَفِى", "en": "(is) surely, in", "tr": "lafī", "audio": "wbw/103_002_003.mp3"}, {"type": "word", "ar": "خُسْرٍ", "tajweed": "خُسۡرٍ", "en": "loss", "tr": "khus'rin", "audio": "wbw/103_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "103:3", "juz": 30, "page": 601, "side_trans": "Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.", "words": [{"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "Except", "tr": "illā", "audio": "wbw/103_003_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/103_003_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/103_003_003.mp3"}, {"type": "word", "ar": "وَعَمِلُوا۟", "tajweed": "وَعَمِلُو<rule class=slnt>اۡ</rule>", "en": "and do", "tr": "waʿamilū", "audio": "wbw/103_003_004.mp3"}, {"type": "word", "ar": "ٱلصَّـٰلِحَـٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّ<rule class=madda_normal>ـٰ</rule>لِحَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "righteous deeds", "tr": "l-ṣāliḥāti", "audio": "wbw/103_003_005.mp3"}, {"type": "word", "ar": "وَتَوَاصَوْا۟", "tajweed": "وَتَوَاصَوۡ<rule class=slnt>اۡ</rule>", "en": "and enjoin (each other)", "tr": "watawāṣaw", "audio": "wbw/103_003_006.mp3"}, {"type": "word", "ar": "بِٱلْحَقِّ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule>لۡحَقِّ", "en": "to the truth", "tr": "bil-ḥaqi", "audio": "wbw/103_003_007.mp3"}, {"type": "word", "ar": "وَتَوَاصَوْا۟", "tajweed": "وَتَوَاصَوۡ<rule class=slnt>اۡ</rule>", "en": "and enjoin (each other)", "tr": "watawāṣaw", "audio": "wbw/103_003_008.mp3"}, {"type": "word", "ar": "بِٱلصَّبْرِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّ<rule class=qalaqah>بۡ</rule>رِ", "en": "to [the] patience", "tr": "bil-ṣabri", "audio": "wbw/103_003_009.mp3"}, {"type": "end", "num": "٣"}]}]