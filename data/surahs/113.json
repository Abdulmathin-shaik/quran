[{"id": 1, "key": "113:1", "juz": 30, "page": 604, "side_trans": "Say, \"I seek refuge in the Lord of daybreak", "words": [{"type": "word", "ar": "قُلْ", "tajweed": "قُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/113_001_001.mp3"}, {"type": "word", "ar": "أَعُوذُ", "tajweed": "أَعُوذُ", "en": "I seek refuge", "tr": "aʿūdhu", "audio": "wbw/113_001_002.mp3"}, {"type": "word", "ar": "بِرَبِّ", "tajweed": "بِرَبِّ", "en": "in (the) Lord", "tr": "birabbi", "audio": "wbw/113_001_003.mp3"}, {"type": "word", "ar": "ٱلْفَلَقِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَلَ<rule class=qalaqah>ق</rule>ِ", "en": "(of) the dawn", "tr": "l-falaqi", "audio": "wbw/113_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "113:2", "juz": 30, "page": 604, "side_trans": "From the evil of that which He created", "words": [{"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "From", "tr": "min", "audio": "wbw/113_002_001.mp3"}, {"type": "word", "ar": "شَرِّ", "tajweed": "<rule class=ikhafa>ش</rule>َرِّ", "en": "(the) evil", "tr": "sharri", "audio": "wbw/113_002_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "(of) what", "tr": "mā", "audio": "wbw/113_002_003.mp3"}, {"type": "word", "ar": "خَلَقَ", "tajweed": "خَلَ<rule class=qalaqah>ق</rule>َ", "en": "He created", "tr": "khalaqa", "audio": "wbw/113_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "113:3", "juz": 30, "page": 604, "side_trans": "And from the evil of darkness when it settles", "words": [{"type": "word", "ar": "وَمِن", "tajweed": "وَمِ<rule class=ikhafa>ن</rule>", "en": "And from", "tr": "wamin", "audio": "wbw/113_003_001.mp3"}, {"type": "word", "ar": "شَرِّ", "tajweed": "<rule class=ikhafa>ش</rule>َرِّ", "en": "(the) evil", "tr": "sharri", "audio": "wbw/113_003_002.mp3"}, {"type": "word", "ar": "غَاسِقٍ", "tajweed": "غَاسِقٍ", "en": "(of) darkness", "tr": "ghāsiqin", "audio": "wbw/113_003_003.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/113_003_004.mp3"}, {"type": "word", "ar": "وَقَبَ", "tajweed": "وَقَ<rule class=qalaqah>ب</rule>َ", "en": "it spreads", "tr": "waqaba", "audio": "wbw/113_003_005.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "113:4", "juz": 30, "page": 604, "side_trans": "And from the evil of the blowers in knots", "words": [{"type": "word", "ar": "وَمِن", "tajweed": "وَمِ<rule class=ikhafa>ن</rule>", "en": "And from", "tr": "wamin", "audio": "wbw/113_004_001.mp3"}, {"type": "word", "ar": "شَرِّ", "tajweed": "<rule class=ikhafa>ش</rule>َرِّ", "en": "(the) evil", "tr": "sharri", "audio": "wbw/113_004_002.mp3"}, {"type": "word", "ar": "ٱلنَّفَّـٰثَـٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َفَّ<rule class=madda_normal>ـٰ</rule>ثَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "(of) the blowers", "tr": "l-nafāthāti", "audio": "wbw/113_004_003.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/113_004_004.mp3"}, {"type": "word", "ar": "ٱلْعُقَدِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعُقَ<rule class=qalaqah>د</rule>ِ", "en": "the knots", "tr": "l-ʿuqadi", "audio": "wbw/113_004_005.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "113:5", "juz": 30, "page": 604, "side_trans": "And from the evil of an envier when he envies.\"", "words": [{"type": "word", "ar": "وَمِن", "tajweed": "وَمِ<rule class=ikhafa>ن</rule>", "en": "And from", "tr": "wamin", "audio": "wbw/113_005_001.mp3"}, {"type": "word", "ar": "شَرِّ", "tajweed": "<rule class=ikhafa>ش</rule>َرِّ", "en": "(the) evil", "tr": "sharri", "audio": "wbw/113_005_002.mp3"}, {"type": "word", "ar": "حَاسِدٍ", "tajweed": "حَاسِدٍ", "en": "(of) an envier", "tr": "ḥāsidin", "audio": "wbw/113_005_003.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/113_005_004.mp3"}, {"type": "word", "ar": "حَسَدَ", "tajweed": "حَسَ<rule class=qalaqah>د</rule>َ", "en": "he envies", "tr": "ḥasada", "audio": "wbw/113_005_005.mp3"}, {"type": "end", "num": "٥"}]}]