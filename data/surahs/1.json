[{"id": 1, "key": "1:1", "juz": 1, "page": 1, "side_trans": "In the name of Allāh, the Entirely Merciful, the Especially Merciful.", "words": [{"type": "word", "ar": "بِسْمِ", "tajweed": "بِسۡمِ", "en": "In (the) name", "tr": "bis'mi", "audio": "wbw/001_001_001.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/001_001_002.mp3"}, {"type": "word", "ar": "ٱلرَّحْمَـٰنِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رَّحۡمَ<rule class=madda_normal>ـٰ</rule>نِ", "en": "the Most Gracious", "tr": "l-raḥmāni", "audio": "wbw/001_001_003.mp3"}, {"type": "word", "ar": "ٱلرَّحِيمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رَّح<rule class=madda_permissible>ِي</rule>مِ", "en": "the Most Merciful", "tr": "l-raḥīmi", "audio": "wbw/001_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "1:2", "juz": 1, "page": 1, "side_trans": "[All] praise is [due] to Allāh, Lord of the worlds -", "words": [{"type": "word", "ar": "ٱلْحَمْدُ", "tajweed": "ٱلۡحَمۡدُ", "en": "All praises and thanks", "tr": "al-ḥamdu", "audio": "wbw/001_002_001.mp3"}, {"type": "word", "ar": "لِلَّهِ", "tajweed": "لِلَّهِ", "en": "(be) to Allah", "tr": "lillahi", "audio": "wbw/001_002_002.mp3"}, {"type": "word", "ar": "رَبِّ", "tajweed": "رَبِّ", "en": "the Lord", "tr": "rabbi", "audio": "wbw/001_002_003.mp3"}, {"type": "word", "ar": "ٱلْعَـٰلَمِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَ<rule class=madda_normal>ـٰ</rule>لَم<rule class=madda_permissible>ِي</rule>نَ", "en": "of the universe", "tr": "l-ʿālamīna", "audio": "wbw/001_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "1:3", "juz": 1, "page": 1, "side_trans": "The Entirely Merciful, the Especially Merciful,", "words": [{"type": "word", "ar": "ٱلرَّحْمَـٰنِ", "tajweed": "ٱ<rule class=laam_shamsiyah>ل</rule>رَّحۡمَ<rule class=madda_normal>ـٰ</rule>نِ", "en": "The Most Gracious", "tr": "al-raḥmāni", "audio": "wbw/001_003_001.mp3"}, {"type": "word", "ar": "ٱلرَّحِيمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رَّح<rule class=madda_permissible>ِي</rule>مِ", "en": "the Most Merciful", "tr": "l-raḥīmi", "audio": "wbw/001_003_002.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "1:4", "juz": 1, "page": 1, "side_trans": "Sovereign of the Day of Recompense.", "words": [{"type": "word", "ar": "مَـٰلِكِ", "tajweed": "مَ<rule class=madda_normal>ـٰ</rule>لِكِ", "en": "(The) Master", "tr": "māliki", "audio": "wbw/001_004_001.mp3"}, {"type": "word", "ar": "يَوْمِ", "tajweed": "يَوۡمِ", "en": "(of the) Day", "tr": "yawmi", "audio": "wbw/001_004_002.mp3"}, {"type": "word", "ar": "ٱلدِّينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دّ<rule class=madda_permissible>ِي</rule>نِ", "en": "(of the) Judgment", "tr": "l-dīni", "audio": "wbw/001_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "1:5", "juz": 1, "page": 1, "side_trans": "It is You we worship and You we ask for help.", "words": [{"type": "word", "ar": "إِيَّاكَ", "tajweed": "إِيَّاكَ", "en": "You Alone", "tr": "iyyāka", "audio": "wbw/001_005_001.mp3"}, {"type": "word", "ar": "نَعْبُدُ", "tajweed": "نَعۡبُدُ", "en": "we worship", "tr": "naʿbudu", "audio": "wbw/001_005_002.mp3"}, {"type": "word", "ar": "وَإِيَّاكَ", "tajweed": "وَإِيَّاكَ", "en": "and You Alone", "tr": "wa-iyyāka", "audio": "wbw/001_005_003.mp3"}, {"type": "word", "ar": "نَسْتَعِينُ", "tajweed": "نَسۡتَع<rule class=madda_permissible>ِي</rule>نُ", "en": "we ask for help", "tr": "nastaʿīnu", "audio": "wbw/001_005_004.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "1:6", "juz": 1, "page": 1, "side_trans": "Guide us to the straight path -", "words": [{"type": "word", "ar": "ٱهْدِنَا", "tajweed": "ٱهۡدِنَا", "en": "Guide us", "tr": "ih'dinā", "audio": "wbw/001_006_001.mp3"}, {"type": "word", "ar": "ٱلصِّرَٰطَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صِّر<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>طَ", "en": "(to) the path", "tr": "l-ṣirāṭa", "audio": "wbw/001_006_002.mp3"}, {"type": "word", "ar": "ٱلْمُسْتَقِيمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُسۡتَق<rule class=madda_permissible>ِي</rule>مَ", "en": "the straight", "tr": "l-mus'taqīma", "audio": "wbw/001_006_003.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "1:7", "juz": 1, "page": 1, "side_trans": "The path of those upon whom You have bestowed favor, not of those who have earned [Your] anger or of those who are astray.", "words": [{"type": "word", "ar": "صِرَٰطَ", "tajweed": "صِر<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>طَ", "en": "(The) path", "tr": "ṣirāṭa", "audio": "wbw/001_007_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "(of) those", "tr": "alladhīna", "audio": "wbw/001_007_002.mp3"}, {"type": "word", "ar": "أَنْعَمْتَ", "tajweed": "أَنۡعَمۡتَ", "en": "You have bestowed (Your) Favors", "tr": "anʿamta", "audio": "wbw/001_007_003.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ", "tajweed": "عَلَيۡهِمۡ", "en": "on them", "tr": "ʿalayhim", "audio": "wbw/001_007_004.mp3"}, {"type": "word", "ar": "غَيْرِ", "tajweed": "غَيۡرِ", "en": "not (of)", "tr": "ghayri", "audio": "wbw/001_007_005.mp3"}, {"type": "word", "ar": "ٱلْمَغْضُوبِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَغۡضُوبِ", "en": "those who earned (Your) wrath", "tr": "l-maghḍūbi", "audio": "wbw/001_007_006.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ", "tajweed": "عَلَيۡهِمۡ", "en": "on themselves", "tr": "ʿalayhim", "audio": "wbw/001_007_007.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "and not", "tr": "walā", "audio": "wbw/001_007_008.mp3"}, {"type": "word", "ar": "ٱلضَّآلِّينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ضّ<rule class=madda_necessary>َا</rule>ٓلّ<rule class=madda_permissible>ِي</rule>نَ", "en": "(of) those who go astray", "tr": "l-ḍālīna", "audio": "wbw/001_007_009.mp3"}, {"type": "end", "num": "٧"}]}]