[{"id": 1, "key": "95:1", "juz": 30, "page": 597, "side_trans": "By the fig and the olive", "words": [{"type": "word", "ar": "وَٱلتِّينِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>تِّينِ", "en": "By the fig", "tr": "wal-tīni", "audio": "wbw/095_001_001.mp3"}, {"type": "word", "ar": "وَٱلزَّيْتُونِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>زَّيۡت<rule class=madda_permissible>ُو</rule>نِ", "en": "and the olive", "tr": "wal-zaytūni", "audio": "wbw/095_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "95:2", "juz": 30, "page": 597, "side_trans": "And [by] Mount Sinai", "words": [{"type": "word", "ar": "وَطُورِ", "tajweed": "وَطُورِ", "en": "And (the) Mount", "tr": "waṭūri", "audio": "wbw/095_002_001.mp3"}, {"type": "word", "ar": "سِينِينَ", "tajweed": "سِين<rule class=madda_permissible>ِي</rule>نَ", "en": "Sinai", "tr": "sīnīna", "audio": "wbw/095_002_002.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "95:3", "juz": 30, "page": 597, "side_trans": "And [by] this secure city [i.e., Makkah],", "words": [{"type": "word", "ar": "وَهَـٰذَا", "tajweed": "وَهَ<rule class=madda_normal>ـٰ</rule>ذَا", "en": "And this", "tr": "wahādhā", "audio": "wbw/095_003_001.mp3"}, {"type": "word", "ar": "ٱلْبَلَدِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡبَلَدِ", "en": "[the] city", "tr": "l-baladi", "audio": "wbw/095_003_002.mp3"}, {"type": "word", "ar": "ٱلْأَمِينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَم<rule class=madda_permissible>ِي</rule>نِ", "en": "[the] secure", "tr": "l-amīni", "audio": "wbw/095_003_003.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "95:4", "juz": 30, "page": 597, "side_trans": "We have certainly created man in the best of stature;", "words": [{"type": "word", "ar": "لَقَدْ", "tajweed": "لَقَ<rule class=qalaqah>دۡ</rule>", "en": "Indeed", "tr": "laqad", "audio": "wbw/095_004_001.mp3"}, {"type": "word", "ar": "خَلَقْنَا", "tajweed": "خَلَ<rule class=qalaqah>قۡ</rule>نَا", "en": "We created", "tr": "khalaqnā", "audio": "wbw/095_004_002.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نَ", "en": "man", "tr": "l-insāna", "audio": "wbw/095_004_003.mp3"}, {"type": "word", "ar": "فِىٓ", "tajweed": "ف<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "in", "tr": "fī", "audio": "wbw/095_004_004.mp3"}, {"type": "word", "ar": "أَحْسَنِ", "tajweed": "أَحۡسَنِ", "en": "(the) best", "tr": "aḥsani", "audio": "wbw/095_004_005.mp3"}, {"type": "word", "ar": "تَقْوِيمٍۢ", "tajweed": "تَ<rule class=qalaqah>قۡ</rule>و<rule class=madda_permissible>ِي</rule>مٍ", "en": "mould", "tr": "taqwīmin", "audio": "wbw/095_004_006.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "95:5", "juz": 30, "page": 597, "side_trans": "Then We return him to the lowest of the low,", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/095_005_001.mp3"}, {"type": "word", "ar": "رَدَدْنَـٰهُ", "tajweed": "رَدَ<rule class=qalaqah>دۡ</rule>نَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "We returned him", "tr": "radadnāhu", "audio": "wbw/095_005_002.mp3"}, {"type": "word", "ar": "أَسْفَلَ", "tajweed": "أَسۡفَلَ", "en": "(to the) lowest", "tr": "asfala", "audio": "wbw/095_005_003.mp3"}, {"type": "word", "ar": "سَـٰفِلِينَ", "tajweed": "سَ<rule class=madda_normal>ـٰ</rule>فِل<rule class=madda_permissible>ِي</rule>نَ", "en": "(of the) low", "tr": "sāfilīna", "audio": "wbw/095_005_004.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "95:6", "juz": 30, "page": 597, "side_trans": "Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.", "words": [{"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "Except", "tr": "illā", "audio": "wbw/095_006_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/095_006_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/095_006_003.mp3"}, {"type": "word", "ar": "وَعَمِلُوا۟", "tajweed": "وَعَمِلُو<rule class=slnt>اۡ</rule>", "en": "and do", "tr": "waʿamilū", "audio": "wbw/095_006_004.mp3"}, {"type": "word", "ar": "ٱلصَّـٰلِحَـٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّ<rule class=madda_normal>ـٰ</rule>لِحَ<rule class=madda_normal>ـٰ</rule>تِ", "en": "righteous deeds", "tr": "l-ṣāliḥāti", "audio": "wbw/095_006_005.mp3"}, {"type": "word", "ar": "فَلَهُمْ", "tajweed": "فَلَهُمۡ", "en": "then for them", "tr": "falahum", "audio": "wbw/095_006_006.mp3"}, {"type": "word", "ar": "أَجْرٌ", "tajweed": "أَ<rule class=qalaqah>جۡ</rule>رٌ", "en": "(is a) reward", "tr": "ajrun", "audio": "wbw/095_006_007.mp3"}, {"type": "word", "ar": "غَيْرُ", "tajweed": "غَيۡرُ", "en": "never", "tr": "ghayru", "audio": "wbw/095_006_008.mp3"}, {"type": "word", "ar": "مَمْنُونٍۢ", "tajweed": "مَمۡن<rule class=madda_permissible>ُو</rule>نٍ", "en": "ending", "tr": "mamnūnin", "audio": "wbw/095_006_009.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "95:7", "juz": 30, "page": 597, "side_trans": "So what yet causes you to deny the Recompense?", "words": [{"type": "word", "ar": "فَمَا", "tajweed": "فَمَا", "en": "Then what", "tr": "famā", "audio": "wbw/095_007_001.mp3"}, {"type": "word", "ar": "يُكَذِّبُكَ", "tajweed": "يُكَذِّبُكَ", "en": "causes you to deny", "tr": "yukadhibuka", "audio": "wbw/095_007_002.mp3"}, {"type": "word", "ar": "بَعْدُ", "tajweed": "بَعۡدُ", "en": "after (this)", "tr": "baʿdu", "audio": "wbw/095_007_003.mp3"}, {"type": "word", "ar": "بِٱلدِّينِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دّ<rule class=madda_permissible>ِي</rule>نِ", "en": "the judgment", "tr": "bil-dīni", "audio": "wbw/095_007_004.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "95:8", "juz": 30, "page": 597, "side_trans": "Is not Allāh the most just of judges?", "words": [{"type": "word", "ar": "أَلَيْسَ", "tajweed": "أَلَيۡسَ", "en": "Is not", "tr": "alaysa", "audio": "wbw/095_008_001.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/095_008_002.mp3"}, {"type": "word", "ar": "بِأَحْكَمِ", "tajweed": "بِأَحۡكَمِ", "en": "(the) Most Just", "tr": "bi-aḥkami", "audio": "wbw/095_008_003.mp3"}, {"type": "word", "ar": "ٱلْحَـٰكِمِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَ<rule class=madda_normal>ـٰ</rule>كِم<rule class=madda_permissible>ِي</rule>نَ", "en": "(of) the Judges", "tr": "l-ḥākimīna", "audio": "wbw/095_008_004.mp3"}, {"type": "end", "num": "٨"}]}]