[{"id": 1, "key": "109:1", "juz": 30, "page": 603, "side_trans": "Say, \"O disbelievers,", "words": [{"type": "word", "ar": "قُلْ", "tajweed": "قُلۡ", "en": "Say", "tr": "qul", "audio": "wbw/109_001_001.mp3"}, {"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/109_001_002.mp3"}, {"type": "word", "ar": "ٱلْكَـٰفِرُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكَ<rule class=madda_normal>ـٰ</rule>فِر<rule class=madda_permissible>ُو</rule>نَ", "en": "disbelievers", "tr": "l-kāfirūna", "audio": "wbw/109_001_003.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "109:2", "juz": 30, "page": 603, "side_trans": "I do not worship what you worship.", "words": [{"type": "word", "ar": "لَآ", "tajweed": "ل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Not", "tr": "lā", "audio": "wbw/109_002_001.mp3"}, {"type": "word", "ar": "أَعْبُدُ", "tajweed": "أَعۡبُدُ", "en": "I worship", "tr": "aʿbudu", "audio": "wbw/109_002_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/109_002_003.mp3"}, {"type": "word", "ar": "تَعْبُدُونَ", "tajweed": "تَعۡبُد<rule class=madda_permissible>ُو</rule>نَ", "en": "you worship", "tr": "taʿbudūna", "audio": "wbw/109_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "109:3", "juz": 30, "page": 603, "side_trans": "Nor are you worshippers of what I worship.", "words": [{"type": "word", "ar": "وَلَآ", "tajweed": "وَل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And not", "tr": "walā", "audio": "wbw/109_003_001.mp3"}, {"type": "word", "ar": "أَنتُمْ", "tajweed": "أَ<rule class=ikhafa>نت</rule>ُمۡ", "en": "you", "tr": "antum", "audio": "wbw/109_003_002.mp3"}, {"type": "word", "ar": "عَـٰبِدُونَ", "tajweed": "عَ<rule class=madda_normal>ـٰ</rule>بِدُونَ", "en": "(are) worshippers", "tr": "ʿābidūna", "audio": "wbw/109_003_003.mp3"}, {"type": "word", "ar": "مَآ", "tajweed": "م<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "(of) what", "tr": "mā", "audio": "wbw/109_003_004.mp3"}, {"type": "word", "ar": "أَعْبُدُ", "tajweed": "أَعۡبُ<rule class=qalaqah>د</rule>ُ", "en": "I worship", "tr": "aʿbudu", "audio": "wbw/109_003_005.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "109:4", "juz": 30, "page": 603, "side_trans": "Nor will I be a worshipper of what you worship.", "words": [{"type": "word", "ar": "وَلَآ", "tajweed": "وَل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And not", "tr": "walā", "audio": "wbw/109_004_001.mp3"}, {"type": "word", "ar": "أَنَا۠", "tajweed": "أَنَاۡ", "en": "I am", "tr": "anā", "audio": "wbw/109_004_002.mp3"}, {"type": "word", "ar": "عَابِدٌۭ", "tajweed": "عَابِ<rule class=idgham_ghunnah>دٌ</rule>", "en": "a worshipper", "tr": "ʿābidun", "audio": "wbw/109_004_003.mp3"}, {"type": "word", "ar": "مَّا", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّا", "en": "(of) what", "tr": "mā", "audio": "wbw/109_004_004.mp3"}, {"type": "word", "ar": "عَبَدتُّمْ", "tajweed": "عَبَ<rule class=idgham_mutajanisayn>د</rule>تُّمۡ", "en": "you worship", "tr": "ʿabadttum", "audio": "wbw/109_004_005.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "109:5", "juz": 30, "page": 603, "side_trans": "Nor will you be worshippers of what I worship.", "words": [{"type": "word", "ar": "وَلَآ", "tajweed": "وَل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And not", "tr": "walā", "audio": "wbw/109_005_001.mp3"}, {"type": "word", "ar": "أَنتُمْ", "tajweed": "أَ<rule class=ikhafa>نت</rule>ُمۡ", "en": "you", "tr": "antum", "audio": "wbw/109_005_002.mp3"}, {"type": "word", "ar": "عَـٰبِدُونَ", "tajweed": "عَ<rule class=madda_normal>ـٰ</rule>بِدُونَ", "en": "(are) worshippers", "tr": "ʿābidūna", "audio": "wbw/109_005_003.mp3"}, {"type": "word", "ar": "مَآ", "tajweed": "م<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "(of) what", "tr": "mā", "audio": "wbw/109_005_004.mp3"}, {"type": "word", "ar": "أَعْبُدُ", "tajweed": "أَعۡبُ<rule class=qalaqah>د</rule>ُ", "en": "I worship", "tr": "aʿbudu", "audio": "wbw/109_005_005.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "109:6", "juz": 30, "page": 603, "side_trans": "For you is your religion, and for me is my religion.\"", "words": [{"type": "word", "ar": "لَكُمْ", "tajweed": "لَكُمۡ", "en": "For you", "tr": "lakum", "audio": "wbw/109_006_001.mp3"}, {"type": "word", "ar": "دِينُكُمْ", "tajweed": "دِينُكُمۡ", "en": "(is) your religion", "tr": "dīnukum", "audio": "wbw/109_006_002.mp3"}, {"type": "word", "ar": "وَلِىَ", "tajweed": "وَلِىَ", "en": "and for me", "tr": "waliya", "audio": "wbw/109_006_003.mp3"}, {"type": "word", "ar": "دِينِ", "tajweed": "د<rule class=madda_permissible>ِي</rule>نِ", "en": "(is) my religion", "tr": "dīni", "audio": "wbw/109_006_004.mp3"}, {"type": "end", "num": "٦"}]}]