[{"id": 1, "key": "87:1", "juz": 30, "page": 591, "side_trans": "Exalt the name of your Lord, the Most High,", "words": [{"type": "word", "ar": "سَبِّحِ", "tajweed": "سَبِّحِ", "en": "Glorify", "tr": "sabbiḥi", "audio": "wbw/087_001_001.mp3"}, {"type": "word", "ar": "ٱسْمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>سۡمَ", "en": "(the) name", "tr": "is'ma", "audio": "wbw/087_001_002.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "(of) your Lord", "tr": "rabbika", "audio": "wbw/087_001_003.mp3"}, {"type": "word", "ar": "ٱلْأَعْلَى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَعۡلَى", "en": "the Most High", "tr": "l-aʿlā", "audio": "wbw/087_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "87:2", "juz": 30, "page": 591, "side_trans": "Who created and proportioned", "words": [{"type": "word", "ar": "ٱلَّذِى", "tajweed": "ٱلَّذِى", "en": "The One Who", "tr": "alladhī", "audio": "wbw/087_002_001.mp3"}, {"type": "word", "ar": "خَلَقَ", "tajweed": "خَلَقَ", "en": "created", "tr": "khalaqa", "audio": "wbw/087_002_002.mp3"}, {"type": "word", "ar": "فَسَوَّىٰ", "tajweed": "فَسَوَّىٰ", "en": "then proportioned", "tr": "fasawwā", "audio": "wbw/087_002_003.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "87:3", "juz": 30, "page": 591, "side_trans": "And who destined and [then] guided", "words": [{"type": "word", "ar": "وَٱلَّذِى", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّذِى", "en": "And the One Who", "tr": "wa-alladhī", "audio": "wbw/087_003_001.mp3"}, {"type": "word", "ar": "قَدَّرَ", "tajweed": "قَدَّرَ", "en": "measured", "tr": "qaddara", "audio": "wbw/087_003_002.mp3"}, {"type": "word", "ar": "فَهَدَىٰ", "tajweed": "فَهَدَىٰ", "en": "then guided", "tr": "fahadā", "audio": "wbw/087_003_003.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "87:4", "juz": 30, "page": 591, "side_trans": "And who brings out the pasture", "words": [{"type": "word", "ar": "وَٱلَّذِىٓ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّذ<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "And the One Who", "tr": "wa-alladhī", "audio": "wbw/087_004_001.mp3"}, {"type": "word", "ar": "أَخْرَجَ", "tajweed": "أَخۡرَجَ", "en": "brings forth", "tr": "akhraja", "audio": "wbw/087_004_002.mp3"}, {"type": "word", "ar": "ٱلْمَرْعَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَرۡعَىٰ", "en": "the pasture", "tr": "l-marʿā", "audio": "wbw/087_004_003.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "87:5", "juz": 30, "page": 591, "side_trans": "And [then] makes it black stubble.", "words": [{"type": "word", "ar": "فَجَعَلَهُۥ", "tajweed": "فَجَعَلَهُ<rule class=madda_normal>ۥ</rule>", "en": "And then makes it", "tr": "fajaʿalahu", "audio": "wbw/087_005_001.mp3"}, {"type": "word", "ar": "غُثَآءً", "tajweed": "غُث<rule class=madda_obligatory_mottasel>َا</rule>ٓءً", "en": "stubble", "tr": "ghuthāan", "audio": "wbw/087_005_002.mp3"}, {"type": "word", "ar": "أَحْوَىٰ", "tajweed": "أَحۡوَىٰ", "en": "dark", "tr": "aḥwā", "audio": "wbw/087_005_003.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "87:6", "juz": 30, "page": 591, "side_trans": "We will make you recite, [O Muḥammad], and you will not forget,", "words": [{"type": "word", "ar": "سَنُقْرِئُكَ", "tajweed": "سَنُ<rule class=qalaqah>قۡ</rule>رِئُكَ", "en": "We will make you recite", "tr": "sanuq'ri-uka", "audio": "wbw/087_006_001.mp3"}, {"type": "word", "ar": "فَلَا", "tajweed": "فَلَا", "en": "so not", "tr": "falā", "audio": "wbw/087_006_002.mp3"}, {"type": "word", "ar": "تَنسَىٰٓ", "tajweed": "تَ<rule class=ikhafa>نس</rule>َىٰٓ", "en": "you will forget", "tr": "tansā", "audio": "wbw/087_006_003.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "87:7", "juz": 30, "page": 591, "side_trans": "Except what Allāh should will. Indeed, He knows what is declared and what is hidden.", "words": [{"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "Except", "tr": "illā", "audio": "wbw/087_007_001.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/087_007_002.mp3"}, {"type": "word", "ar": "شَآءَ", "tajweed": "ش<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "wills", "tr": "shāa", "audio": "wbw/087_007_003.mp3"}, {"type": "word", "ar": "ٱللَّهُ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ‌ۚ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/087_007_004.mp3"}, {"type": "word", "ar": "إِنَّهُۥ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُ<rule class=madda_normal>ۥ</rule>", "en": "Indeed, He", "tr": "innahu", "audio": "wbw/087_007_006.mp3"}, {"type": "word", "ar": "يَعْلَمُ", "tajweed": "يَعۡلَمُ", "en": "knows", "tr": "yaʿlamu", "audio": "wbw/087_007_007.mp3"}, {"type": "word", "ar": "ٱلْجَهْرَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجَهۡرَ", "en": "the manifest", "tr": "l-jahra", "audio": "wbw/087_007_008.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "and what", "tr": "wamā", "audio": "wbw/087_007_009.mp3"}, {"type": "word", "ar": "يَخْفَىٰ", "tajweed": "يَخۡفَىٰ", "en": "is hidden", "tr": "yakhfā", "audio": "wbw/087_007_010.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "87:8", "juz": 30, "page": 591, "side_trans": "And We will ease you toward ease.", "words": [{"type": "word", "ar": "وَنُيَسِّرُكَ", "tajweed": "وَنُيَسِّرُكَ", "en": "And We will ease you", "tr": "wanuyassiruka", "audio": "wbw/087_008_001.mp3"}, {"type": "word", "ar": "لِلْيُسْرَىٰ", "tajweed": "لِلۡيُسۡرَىٰ", "en": "to the ease", "tr": "lil'yus'rā", "audio": "wbw/087_008_002.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "87:9", "juz": 30, "page": 591, "side_trans": "So remind, if the reminder should benefit;", "words": [{"type": "word", "ar": "فَذَكِّرْ", "tajweed": "فَذَكِّرۡ", "en": "So remind", "tr": "fadhakkir", "audio": "wbw/087_009_001.mp3"}, {"type": "word", "ar": "إِن", "tajweed": "إ<rule class=idgham_ghunnah>ِن</rule>", "en": "if", "tr": "in", "audio": "wbw/087_009_002.mp3"}, {"type": "word", "ar": "نَّفَعَتِ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>َّفَعَتِ", "en": "benefits", "tr": "nafaʿati", "audio": "wbw/087_009_003.mp3"}, {"type": "word", "ar": "ٱلذِّكْرَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ذِّكۡرَىٰ", "en": "the reminder", "tr": "l-dhik'rā", "audio": "wbw/087_009_004.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "87:10", "juz": 30, "page": 591, "side_trans": "He who fears [Allāh] will be reminded.", "words": [{"type": "word", "ar": "سَيَذَّكَّرُ", "tajweed": "سَيَذَّكَّرُ", "en": "He will pay heed ", "tr": "sayadhakkaru", "audio": "wbw/087_010_001.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "م<rule class=idgham_ghunnah>َن</rule>", "en": "(one) who", "tr": "man", "audio": "wbw/087_010_002.mp3"}, {"type": "word", "ar": "يَخْشَىٰ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َخۡشَىٰ", "en": "fears (Allah)", "tr": "yakhshā", "audio": "wbw/087_010_003.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "87:11", "juz": 30, "page": 592, "side_trans": "But the wretched one will avoid it", "words": [{"type": "word", "ar": "وَيَتَجَنَّبُهَا", "tajweed": "وَيَتَجَ<rule class=ghunnah>نّ</rule>َبُهَا", "en": "And will avoid it", "tr": "wayatajannabuhā", "audio": "wbw/087_011_001.mp3"}, {"type": "word", "ar": "ٱلْأَشْقَى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَشۡقَى", "en": "the wretched one", "tr": "l-ashqā", "audio": "wbw/087_011_002.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "87:12", "juz": 30, "page": 592, "side_trans": "[He] who will [enter and] burn in the greatest Fire,", "words": [{"type": "word", "ar": "ٱلَّذِى", "tajweed": "ٱلَّذِى", "en": "The one who", "tr": "alladhī", "audio": "wbw/087_012_001.mp3"}, {"type": "word", "ar": "يَصْلَى", "tajweed": "يَصۡلَى", "en": "will burn", "tr": "yaṣlā", "audio": "wbw/087_012_002.mp3"}, {"type": "word", "ar": "ٱلنَّارَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َارَ", "en": "(in) the Fire", "tr": "l-nāra", "audio": "wbw/087_012_003.mp3"}, {"type": "word", "ar": "ٱلْكُبْرَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡكُ<rule class=qalaqah>بۡ</rule>رَىٰ", "en": "[the] great", "tr": "l-kub'rā", "audio": "wbw/087_012_004.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "87:13", "juz": 30, "page": 592, "side_trans": "Neither dying therein nor living.", "words": [{"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "Then", "tr": "thumma", "audio": "wbw/087_013_001.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "not", "tr": "lā", "audio": "wbw/087_013_002.mp3"}, {"type": "word", "ar": "يَمُوتُ", "tajweed": "يَمُوتُ", "en": "he will die", "tr": "yamūtu", "audio": "wbw/087_013_003.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/087_013_004.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "and not", "tr": "walā", "audio": "wbw/087_013_005.mp3"}, {"type": "word", "ar": "يَحْيَىٰ", "tajweed": "يَحۡيَىٰ", "en": "will live", "tr": "yaḥyā", "audio": "wbw/087_013_006.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "87:14", "juz": 30, "page": 592, "side_trans": "He has certainly succeeded who purifies himself", "words": [{"type": "word", "ar": "قَدْ", "tajweed": "قَ<rule class=qalaqah>دۡ</rule>", "en": "Certainly", "tr": "qad", "audio": "wbw/087_014_001.mp3"}, {"type": "word", "ar": "أَفْلَحَ", "tajweed": "أَفۡلَحَ", "en": "has succeeded", "tr": "aflaḥa", "audio": "wbw/087_014_002.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "مَ<rule class=ikhafa>ن</rule>", "en": "(one) who", "tr": "man", "audio": "wbw/087_014_003.mp3"}, {"type": "word", "ar": "تَزَكَّىٰ", "tajweed": "<rule class=ikhafa>ت</rule>َزَكَّىٰ", "en": "purifies (himself)", "tr": "tazakkā", "audio": "wbw/087_014_004.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "87:15", "juz": 30, "page": 592, "side_trans": "And mentions the name of his Lord and prays.", "words": [{"type": "word", "ar": "وَذَكَرَ", "tajweed": "وَذَكَرَ", "en": "And remembers", "tr": "wadhakara", "audio": "wbw/087_015_001.mp3"}, {"type": "word", "ar": "ٱسْمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>سۡمَ", "en": "(the) name", "tr": "is'ma", "audio": "wbw/087_015_002.mp3"}, {"type": "word", "ar": "رَبِّهِۦ", "tajweed": "رَبِّه<rule class=madda_normal>ِۦ</rule>", "en": "(of) his Lord", "tr": "rabbihi", "audio": "wbw/087_015_003.mp3"}, {"type": "word", "ar": "فَصَلَّىٰ", "tajweed": "فَصَلَّىٰ", "en": "and prays", "tr": "faṣallā", "audio": "wbw/087_015_004.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "87:16", "juz": 30, "page": 592, "side_trans": "But you prefer the worldly life,", "words": [{"type": "word", "ar": "بَلْ", "tajweed": "بَلۡ", "en": "Nay", "tr": "bal", "audio": "wbw/087_016_001.mp3"}, {"type": "word", "ar": "تُؤْثِرُونَ", "tajweed": "تُؤۡثِرُونَ", "en": "You prefer", "tr": "tu'thirūna", "audio": "wbw/087_016_002.mp3"}, {"type": "word", "ar": "ٱلْحَيَوٰةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡحَيَ<rule class=slnt>و</rule><rule class=madda_normal>ٰ</rule>ةَ", "en": "the life", "tr": "l-ḥayata", "audio": "wbw/087_016_003.mp3"}, {"type": "word", "ar": "ٱلدُّنْيَا", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دُّنۡيَا", "en": "(of) the world", "tr": "l-dun'yā", "audio": "wbw/087_016_004.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "87:17", "juz": 30, "page": 592, "side_trans": "While the Hereafter is better and more enduring.", "words": [{"type": "word", "ar": "وَٱلْـَٔاخِرَةُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأَخِرَةُ", "en": "While the Hereafter", "tr": "wal-ākhiratu", "audio": "wbw/087_017_001.mp3"}, {"type": "word", "ar": "خَيْرٌۭ", "tajweed": "خَيۡ<rule class=idgham_ghunnah>رٌ</rule>", "en": "(is) better", "tr": "khayrun", "audio": "wbw/087_017_002.mp3"}, {"type": "word", "ar": "وَأَبْقَىٰٓ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َأَ<rule class=qalaqah>بۡ</rule>قَىٰٓ", "en": "and everlasting", "tr": "wa-abqā", "audio": "wbw/087_017_003.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "87:18", "juz": 30, "page": 592, "side_trans": "Indeed, this is in the former scriptures,", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/087_018_001.mp3"}, {"type": "word", "ar": "هَـٰذَا", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>ذَا", "en": "this", "tr": "hādhā", "audio": "wbw/087_018_002.mp3"}, {"type": "word", "ar": "لَفِى", "tajweed": "لَفِى", "en": "surely (is) in", "tr": "lafī", "audio": "wbw/087_018_003.mp3"}, {"type": "word", "ar": "ٱلصُّحُفِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صُّحُفِ", "en": "the Scriptures", "tr": "l-ṣuḥufi", "audio": "wbw/087_018_004.mp3"}, {"type": "word", "ar": "ٱلْأُولَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأُولَىٰ", "en": "[the] former", "tr": "l-ūlā", "audio": "wbw/087_018_005.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "87:19", "juz": 30, "page": 592, "side_trans": "The scriptures of Abraham and Moses.", "words": [{"type": "word", "ar": "صُحُفِ", "tajweed": "صُحُفِ", "en": "(The) Scriptures", "tr": "ṣuḥufi", "audio": "wbw/087_019_001.mp3"}, {"type": "word", "ar": "إِبْرَٰهِيمَ", "tajweed": "إِ<rule class=qalaqah>بۡ</rule>ر<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>هِيمَ", "en": "(of) Ibrahim", "tr": "ib'rāhīma", "audio": "wbw/087_019_002.mp3"}, {"type": "word", "ar": "وَمُوسَىٰ", "tajweed": "وَمُوسَىٰ", "en": "and Musa", "tr": "wamūsā", "audio": "wbw/087_019_003.mp3"}, {"type": "end", "num": "١٩"}]}]