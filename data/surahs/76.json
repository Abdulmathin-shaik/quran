[{"id": 1, "key": "76:1", "juz": 29, "page": 578, "side_trans": "Has there [not] come upon man a period of time when he was not a thing [even] mentioned?", "words": [{"type": "word", "ar": "هَلْ", "tajweed": "هَلۡ", "en": "Has", "tr": "hal", "audio": "wbw/076_001_001.mp3"}, {"type": "word", "ar": "أَتَىٰ", "tajweed": "أَتَىٰ", "en": "(there) come", "tr": "atā", "audio": "wbw/076_001_002.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "upon", "tr": "ʿalā", "audio": "wbw/076_001_003.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نِ", "en": "man", "tr": "l-insāni", "audio": "wbw/076_001_004.mp3"}, {"type": "word", "ar": "حِينٌۭ", "tajweed": "حِي<rule class=idgham_ghunnah>نٌ</rule>", "en": "a period", "tr": "ḥīnun", "audio": "wbw/076_001_005.mp3"}, {"type": "word", "ar": "مِّنَ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنَ", "en": "of", "tr": "mina", "audio": "wbw/076_001_006.mp3"}, {"type": "word", "ar": "ٱلدَّهْرِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دَّهۡرِ", "en": "time", "tr": "l-dahri", "audio": "wbw/076_001_007.mp3"}, {"type": "word", "ar": "لَمْ", "tajweed": "لَمۡ", "en": "not", "tr": "lam", "audio": "wbw/076_001_008.mp3"}, {"type": "word", "ar": "يَكُن", "tajweed": "يَكُ<rule class=ikhafa>ن</rule>", "en": "he was", "tr": "yakun", "audio": "wbw/076_001_009.mp3"}, {"type": "word", "ar": "شَيْـًۭٔا", "tajweed": "<rule class=ikhafa>ش</rule>َيۡـ<rule class=idgham_ghunnah>ـًٔا</rule>", "en": "a thing", "tr": "shayan", "audio": "wbw/076_001_010.mp3"}, {"type": "word", "ar": "مَّذْكُورًا", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّذۡكُورًا", "en": "mentioned", "tr": "madhkūran", "audio": "wbw/076_001_011.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "76:2", "juz": 29, "page": 578, "side_trans": "Indeed, We created man from a sperm-drop mixture that We may try him; and We made him hearing and seeing.", "words": [{"type": "word", "ar": "إِنَّا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َا", "en": "Indeed, We", "tr": "innā", "audio": "wbw/076_002_001.mp3"}, {"type": "word", "ar": "خَلَقْنَا", "tajweed": "خَلَ<rule class=qalaqah>قۡ</rule>نَا", "en": "[We] created", "tr": "khalaqnā", "audio": "wbw/076_002_002.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نَ", "en": "man", "tr": "l-insāna", "audio": "wbw/076_002_003.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_ghunnah>ِن</rule>", "en": "from", "tr": "min", "audio": "wbw/076_002_004.mp3"}, {"type": "word", "ar": "نُّطْفَةٍ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>ُّ<rule class=qalaqah>طۡ</rule>فَةٍ", "en": "a semen-drop", "tr": "nuṭ'fatin", "audio": "wbw/076_002_005.mp3"}, {"type": "word", "ar": "أَمْشَاجٍۢ", "tajweed": "أَمۡشَا<rule class=idgham_ghunnah>جٍ</rule>", "en": "a mixture", "tr": "amshājin", "audio": "wbw/076_002_006.mp3"}, {"type": "word", "ar": "نَّبْتَلِيهِ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>َّ<rule class=qalaqah>بۡ</rule>تَلِيهِ", "en": "(that) We test him", "tr": "nabtalīhi", "audio": "wbw/076_002_007.mp3"}, {"type": "word", "ar": "فَجَعَلْنَـٰهُ", "tajweed": "فَجَعَلۡنَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "so We made (for) him", "tr": "fajaʿalnāhu", "audio": "wbw/076_002_008.mp3"}, {"type": "word", "ar": "سَمِيعًۢا", "tajweed": "سَمِيع<rule class=iqlab>َۢا</rule>", "en": "hearing", "tr": "samīʿan", "audio": "wbw/076_002_009.mp3"}, {"type": "word", "ar": "بَصِيرًا", "tajweed": "<rule class=iqlab>ب</rule>َصِيرًا", "en": "and sight", "tr": "baṣīran", "audio": "wbw/076_002_010.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "76:3", "juz": 29, "page": 578, "side_trans": "Indeed, We guided him to the way, be he grateful or be he ungrateful.", "words": [{"type": "word", "ar": "إِنَّا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َا", "en": "Indeed, We", "tr": "innā", "audio": "wbw/076_003_001.mp3"}, {"type": "word", "ar": "هَدَيْنَـٰهُ", "tajweed": "هَدَيۡنَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "guided him", "tr": "hadaynāhu", "audio": "wbw/076_003_002.mp3"}, {"type": "word", "ar": "ٱلسَّبِيلَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّبِيلَ", "en": "(to) the way", "tr": "l-sabīla", "audio": "wbw/076_003_003.mp3"}, {"type": "word", "ar": "إِمَّا", "tajweed": "إِ<rule class=ghunnah>مّ</rule>َا", "en": "whether", "tr": "immā", "audio": "wbw/076_003_004.mp3"}, {"type": "word", "ar": "شَاكِرًۭا", "tajweed": "شَاكِ<rule class=idgham_ghunnah>رًا</rule>", "en": "(he) be grateful", "tr": "shākiran", "audio": "wbw/076_003_005.mp3"}, {"type": "word", "ar": "وَإِمَّا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َإِ<rule class=ghunnah>مّ</rule>َا", "en": "and whether", "tr": "wa-immā", "audio": "wbw/076_003_006.mp3"}, {"type": "word", "ar": "كَفُورًا", "tajweed": "كَفُورًا", "en": "(he) be ungrateful", "tr": "kafūran", "audio": "wbw/076_003_007.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "76:4", "juz": 29, "page": 578, "side_trans": "Indeed, We have prepared for the disbelievers chains and shackles and a blaze.", "words": [{"type": "word", "ar": "إِنَّآ", "tajweed": "إِ<rule class=ghunnah>نّ</rule><rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Indeed, We", "tr": "innā", "audio": "wbw/076_004_001.mp3"}, {"type": "word", "ar": "أَعْتَدْنَا", "tajweed": "أَعۡتَ<rule class=qalaqah>دۡ</rule>نَا", "en": "[We] have prepared", "tr": "aʿtadnā", "audio": "wbw/076_004_002.mp3"}, {"type": "word", "ar": "لِلْكَـٰفِرِينَ", "tajweed": "لِلۡكَ<rule class=madda_normal>ـٰ</rule>فِرِينَ", "en": "for the disbelievers", "tr": "lil'kāfirīna", "audio": "wbw/076_004_003.mp3"}, {"type": "word", "ar": "سَلَـٰسِلَا۟", "tajweed": "سَلَ<rule class=madda_normal>ـٰ</rule>سِلَ<rule class=slnt>اۡ</rule>", "en": "chains", "tr": "salāsilā", "audio": "wbw/076_004_004.mp3"}, {"type": "word", "ar": "وَأَغْلَـٰلًۭا", "tajweed": "وَأَغۡلَ<rule class=madda_normal>ـٰ</rule>ل<rule class=idgham_ghunnah>اً</rule>", "en": "and shackles", "tr": "wa-aghlālan", "audio": "wbw/076_004_005.mp3"}, {"type": "word", "ar": "وَسَعِيرًا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َسَعِيرًا", "en": "and a Blazing Fire", "tr": "wasaʿīran", "audio": "wbw/076_004_006.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "76:5", "juz": 29, "page": 578, "side_trans": "Indeed, the righteous will drink from a cup [of wine] whose mixture is of Kāfūr,", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/076_005_001.mp3"}, {"type": "word", "ar": "ٱلْأَبْرَارَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَ<rule class=qalaqah>بۡ</rule>رَارَ", "en": "the righteous", "tr": "l-abrāra", "audio": "wbw/076_005_002.mp3"}, {"type": "word", "ar": "يَشْرَبُونَ", "tajweed": "يَشۡرَبُونَ", "en": "will drink", "tr": "yashrabūna", "audio": "wbw/076_005_003.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/076_005_004.mp3"}, {"type": "word", "ar": "كَأْسٍۢ", "tajweed": "<rule class=ikhafa>ك</rule>َأۡ<rule class=ikhafa>سٍ</rule>", "en": "a cup", "tr": "kasin", "audio": "wbw/076_005_005.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "<rule class=ikhafa>ك</rule>َانَ", "en": "is", "tr": "kāna", "audio": "wbw/076_005_006.mp3"}, {"type": "word", "ar": "مِزَاجُهَا", "tajweed": "مِزَاجُهَا", "en": "its mixture", "tr": "mizājuhā", "audio": "wbw/076_005_007.mp3"}, {"type": "word", "ar": "كَافُورًا", "tajweed": "كَافُورًا", "en": "(of) Kafur", "tr": "kāfūran", "audio": "wbw/076_005_008.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "76:6", "juz": 29, "page": 579, "side_trans": "A spring of which the [righteous] servants of Allāh will drink; they will make it gush forth in force [and abundance].", "words": [{"type": "word", "ar": "عَيْنًۭا", "tajweed": "عَيۡ<rule class=idgham_ghunnah>نًا</rule>", "en": "A spring ", "tr": "ʿaynan", "audio": "wbw/076_006_001.mp3"}, {"type": "word", "ar": "يَشْرَبُ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َشۡرَبُ", "en": "will drink", "tr": "yashrabu", "audio": "wbw/076_006_002.mp3"}, {"type": "word", "ar": "بِهَا", "tajweed": "بِهَا", "en": "from it", "tr": "bihā", "audio": "wbw/076_006_003.mp3"}, {"type": "word", "ar": "عِبَادُ", "tajweed": "عِبَادُ", "en": "(the) slaves", "tr": "ʿibādu", "audio": "wbw/076_006_004.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/076_006_005.mp3"}, {"type": "word", "ar": "يُفَجِّرُونَهَا", "tajweed": "يُفَجِّرُونَهَا", "en": "causing it to gush forth", "tr": "yufajjirūnahā", "audio": "wbw/076_006_006.mp3"}, {"type": "word", "ar": "تَفْجِيرًۭا", "tajweed": "تَفۡجِيرًا", "en": "abundantly", "tr": "tafjīran", "audio": "wbw/076_006_007.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "76:7", "juz": 29, "page": 579, "side_trans": "They [are those who] fulfill [their] vows and fear a Day whose evil will be widespread.", "words": [{"type": "word", "ar": "يُوفُونَ", "tajweed": "يُوفُونَ", "en": "They fulfill", "tr": "yūfūna", "audio": "wbw/076_007_001.mp3"}, {"type": "word", "ar": "بِٱلنَّذْرِ", "tajweed": "بِ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َذۡرِ", "en": "the vows", "tr": "bil-nadhri", "audio": "wbw/076_007_002.mp3"}, {"type": "word", "ar": "وَيَخَافُونَ", "tajweed": "وَيَخَافُونَ", "en": "and fear", "tr": "wayakhāfūna", "audio": "wbw/076_007_003.mp3"}, {"type": "word", "ar": "يَوْمًۭا", "tajweed": "يَوۡ<rule class=ikhafa>مًا</rule>", "en": "a Day ", "tr": "yawman", "audio": "wbw/076_007_004.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "<rule class=ikhafa>ك</rule>َانَ", "en": "(which) is", "tr": "kāna", "audio": "wbw/076_007_005.mp3"}, {"type": "word", "ar": "شَرُّهُۥ", "tajweed": "شَرُّهُ<rule class=madda_normal>ۥ</rule>", "en": "its evil", "tr": "sharruhu", "audio": "wbw/076_007_006.mp3"}, {"type": "word", "ar": "مُسْتَطِيرًۭا", "tajweed": "مُسۡتَطِيرًا", "en": "widespread", "tr": "mus'taṭīran", "audio": "wbw/076_007_007.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "76:8", "juz": 29, "page": 579, "side_trans": "And they give food in spite of love for it to the needy, the orphan, and the captive,", "words": [{"type": "word", "ar": "وَيُطْعِمُونَ", "tajweed": "وَيُ<rule class=qalaqah>طۡ</rule>عِمُونَ", "en": "And they feed", "tr": "wayuṭ'ʿimūna", "audio": "wbw/076_008_001.mp3"}, {"type": "word", "ar": "ٱلطَّعَامَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>طَّعَامَ", "en": "the food", "tr": "l-ṭaʿāma", "audio": "wbw/076_008_002.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "in spite of", "tr": "ʿalā", "audio": "wbw/076_008_003.mp3"}, {"type": "word", "ar": "حُبِّهِۦ", "tajweed": "حُبِّه<rule class=madda_normal>ِۦ</rule>", "en": "love (for) it", "tr": "ḥubbihi", "audio": "wbw/076_008_004.mp3"}, {"type": "word", "ar": "مِسْكِينًۭا", "tajweed": "مِسۡكِي<rule class=idgham_ghunnah>نًا</rule>", "en": "(to the) needy", "tr": "mis'kīnan", "audio": "wbw/076_008_005.mp3"}, {"type": "word", "ar": "وَيَتِيمًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َيَتِي<rule class=idgham_ghunnah>مًا</rule>", "en": "and (the) orphan", "tr": "wayatīman", "audio": "wbw/076_008_006.mp3"}, {"type": "word", "ar": "وَأَسِيرًا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َأَسِيرًا", "en": "and (the) captive", "tr": "wa-asīran", "audio": "wbw/076_008_007.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "76:9", "juz": 29, "page": 579, "side_trans": "[Saying], \"We feed you only for the face [i.e., approval] of Allāh. We wish not from you reward or gratitude.", "words": [{"type": "word", "ar": "إِنَّمَا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َمَا", "en": "Only", "tr": "innamā", "audio": "wbw/076_009_001.mp3"}, {"type": "word", "ar": "نُطْعِمُكُمْ", "tajweed": "نُ<rule class=qalaqah>طۡ</rule>عِمُكُمۡ", "en": "we feed you", "tr": "nuṭ'ʿimukum", "audio": "wbw/076_009_002.mp3"}, {"type": "word", "ar": "لِوَجْهِ", "tajweed": "لِوَ<rule class=qalaqah>جۡ</rule>هِ", "en": "for (the) Countenance", "tr": "liwajhi", "audio": "wbw/076_009_003.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/076_009_004.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "Not", "tr": "lā", "audio": "wbw/076_009_005.mp3"}, {"type": "word", "ar": "نُرِيدُ", "tajweed": "نُرِيدُ", "en": "we desire", "tr": "nurīdu", "audio": "wbw/076_009_006.mp3"}, {"type": "word", "ar": "مِنكُمْ", "tajweed": "مِ<rule class=ikhafa>نك</rule>ُمۡ", "en": "from you", "tr": "minkum", "audio": "wbw/076_009_007.mp3"}, {"type": "word", "ar": "جَزَآءًۭ", "tajweed": "جَز<rule class=madda_obligatory_mottasel>َا</rule>ٓ<rule class=idgham_ghunnah>ءً</rule>", "en": "any reward", "tr": "jazāan", "audio": "wbw/076_009_008.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "and not", "tr": "walā", "audio": "wbw/076_009_009.mp3"}, {"type": "word", "ar": "شُكُورًا", "tajweed": "شُكُورًا", "en": "thanks", "tr": "shukūran", "audio": "wbw/076_009_010.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "76:10", "juz": 29, "page": 579, "side_trans": "Indeed, We fear from our Lord a Day austere and distressful.\"", "words": [{"type": "word", "ar": "إِنَّا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َا", "en": "Indeed, we", "tr": "innā", "audio": "wbw/076_010_001.mp3"}, {"type": "word", "ar": "نَخَافُ", "tajweed": "نَخَافُ", "en": "fear", "tr": "nakhāfu", "audio": "wbw/076_010_002.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_wo_ghunnah>ِن</rule>", "en": "from", "tr": "min", "audio": "wbw/076_010_003.mp3"}, {"type": "word", "ar": "رَّبِّنَا", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّبِّنَا", "en": "our Lord", "tr": "rabbinā", "audio": "wbw/076_010_004.mp3"}, {"type": "word", "ar": "يَوْمًا", "tajweed": "يَوۡمًا", "en": "a Day ", "tr": "yawman", "audio": "wbw/076_010_005.mp3"}, {"type": "word", "ar": "عَبُوسًۭا", "tajweed": "عَبُو<rule class=ikhafa>سًا</rule>", "en": "harsh", "tr": "ʿabūsan", "audio": "wbw/076_010_006.mp3"}, {"type": "word", "ar": "قَمْطَرِيرًۭا", "tajweed": "<rule class=ikhafa>ق</rule>َمۡطَرِيرًا", "en": "and distressful", "tr": "qamṭarīran", "audio": "wbw/076_010_007.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "76:11", "juz": 29, "page": 579, "side_trans": "So Allāh will protect them from the evil of that Day and give them radiance and happiness", "words": [{"type": "word", "ar": "فَوَقَىٰهُمُ", "tajweed": "فَوَقَ<rule class=madda_normal>ـٰ</rule>هُمُ", "en": "But will protect them", "tr": "fawaqāhumu", "audio": "wbw/076_011_001.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/076_011_002.mp3"}, {"type": "word", "ar": "شَرَّ", "tajweed": "شَرَّ", "en": "(from the) evil", "tr": "sharra", "audio": "wbw/076_011_003.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "(of) that", "tr": "dhālika", "audio": "wbw/076_011_004.mp3"}, {"type": "word", "ar": "ٱلْيَوْمِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَوۡمِ", "en": "Day", "tr": "l-yawmi", "audio": "wbw/076_011_005.mp3"}, {"type": "word", "ar": "وَلَقَّىٰهُمْ", "tajweed": "وَلَقَّ<rule class=madda_normal>ـٰ</rule>هُمۡ", "en": "and will cause them to meet", "tr": "walaqqāhum", "audio": "wbw/076_011_006.mp3"}, {"type": "word", "ar": "نَضْرَةًۭ", "tajweed": "نَضۡرَ<rule class=idgham_ghunnah>ةً</rule>", "en": "radiance", "tr": "naḍratan", "audio": "wbw/076_011_007.mp3"}, {"type": "word", "ar": "وَسُرُورًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َسُرُورًا", "en": "and happiness", "tr": "wasurūran", "audio": "wbw/076_011_008.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "76:12", "juz": 29, "page": 579, "side_trans": "And will reward them for what they patiently endured [with] a garden [in Paradise] and silk [garments].", "words": [{"type": "word", "ar": "وَجَزَىٰهُم", "tajweed": "وَجَزَ<rule class=madda_normal>ٮٰ</rule>ه<rule class=ikhafa_shafawi>ُم</rule>", "en": "And will reward them", "tr": "wajazāhum", "audio": "wbw/076_012_001.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِمَا", "en": "because", "tr": "bimā", "audio": "wbw/076_012_002.mp3"}, {"type": "word", "ar": "صَبَرُوا۟", "tajweed": "صَبَرُو<rule class=slnt>اۡ</rule>", "en": "they were patient", "tr": "ṣabarū", "audio": "wbw/076_012_003.mp3"}, {"type": "word", "ar": "جَنَّةًۭ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َ<rule class=idgham_ghunnah>ةً</rule>", "en": "(with) a Garden", "tr": "jannatan", "audio": "wbw/076_012_004.mp3"}, {"type": "word", "ar": "وَحَرِيرًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َحَرِيرًا", "en": "and silk", "tr": "waḥarīran", "audio": "wbw/076_012_005.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "76:13", "juz": 29, "page": 579, "side_trans": "[They will be] reclining therein on adorned couches. They will not see therein any [burning] sun or [freezing] cold.", "words": [{"type": "word", "ar": "مُّتَّكِـِٔينَ", "tajweed": "مُّتَّكِــِٔينَ", "en": "Reclining", "tr": "muttakiīna", "audio": "wbw/076_013_001.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/076_013_002.mp3"}, {"type": "word", "ar": "عَلَى", "tajweed": "عَلَى", "en": "on", "tr": "ʿalā", "audio": "wbw/076_013_003.mp3"}, {"type": "word", "ar": "ٱلْأَرَآئِكِ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَر<rule class=madda_obligatory_mottasel>َا</rule>ٓئِكِ‌ۖ", "en": "couches", "tr": "l-arāiki", "audio": "wbw/076_013_004.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "Not", "tr": "lā", "audio": "wbw/076_013_006.mp3"}, {"type": "word", "ar": "يَرَوْنَ", "tajweed": "يَرَوۡنَ", "en": "they will see", "tr": "yarawna", "audio": "wbw/076_013_007.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/076_013_008.mp3"}, {"type": "word", "ar": "شَمْسًۭا", "tajweed": "شَمۡ<rule class=idgham_ghunnah>سًا</rule>", "en": "sun", "tr": "shamsan", "audio": "wbw/076_013_009.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َلَا", "en": "and not", "tr": "walā", "audio": "wbw/076_013_010.mp3"}, {"type": "word", "ar": "زَمْهَرِيرًۭا", "tajweed": "زَمۡهَرِيرًا", "en": "freezing cold", "tr": "zamharīran", "audio": "wbw/076_013_011.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "76:14", "juz": 29, "page": 579, "side_trans": "And near above them are its shades, and its [fruit] to be picked will be lowered in compliance.", "words": [{"type": "word", "ar": "وَدَانِيَةً", "tajweed": "وَدَانِيَةً", "en": "And near", "tr": "wadāniyatan", "audio": "wbw/076_014_001.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ", "tajweed": "عَلَيۡهِمۡ", "en": "above them", "tr": "ʿalayhim", "audio": "wbw/076_014_002.mp3"}, {"type": "word", "ar": "ظِلَـٰلُهَا", "tajweed": "ظِلَ<rule class=madda_normal>ـٰ</rule>لُهَا", "en": "(are) its shades", "tr": "ẓilāluhā", "audio": "wbw/076_014_003.mp3"}, {"type": "word", "ar": "وَذُلِّلَتْ", "tajweed": "وَذُلِّلَتۡ", "en": "and will hang low", "tr": "wadhullilat", "audio": "wbw/076_014_004.mp3"}, {"type": "word", "ar": "قُطُوفُهَا", "tajweed": "قُطُوفُهَا", "en": "its cluster of fruits", "tr": "quṭūfuhā", "audio": "wbw/076_014_005.mp3"}, {"type": "word", "ar": "تَذْلِيلًۭا", "tajweed": "تَذۡلِيلاً", "en": "dangling low", "tr": "tadhlīlan", "audio": "wbw/076_014_006.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "76:15", "juz": 29, "page": 579, "side_trans": "And there will be circulated among them vessels of silver and cups having been [created] clear [as glass],", "words": [{"type": "word", "ar": "وَيُطَافُ", "tajweed": "وَيُطَافُ", "en": "And will be circulated", "tr": "wayuṭāfu", "audio": "wbw/076_015_001.mp3"}, {"type": "word", "ar": "عَلَيْهِم", "tajweed": "عَلَيۡه<rule class=ikhafa_shafawi>ِم</rule>", "en": "among them", "tr": "ʿalayhim", "audio": "wbw/076_015_002.mp3"}, {"type": "word", "ar": "بِـَٔانِيَةٍۢ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِـَٔـانِيَ<rule class=idgham_ghunnah>ةٍ</rule>", "en": "vessels", "tr": "biāniyatin", "audio": "wbw/076_015_003.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّ<rule class=ikhafa>ن</rule>", "en": "of", "tr": "min", "audio": "wbw/076_015_004.mp3"}, {"type": "word", "ar": "فِضَّةٍۢ", "tajweed": "<rule class=ikhafa>ف</rule>ِضَّ<rule class=idgham_ghunnah>ةٍ</rule>", "en": "silver", "tr": "fiḍḍatin", "audio": "wbw/076_015_005.mp3"}, {"type": "word", "ar": "وَأَكْوَابٍۢ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َأَكۡوَا<rule class=ikhafa>بٍ</rule>", "en": "and cups", "tr": "wa-akwābin", "audio": "wbw/076_015_006.mp3"}, {"type": "word", "ar": "كَانَتْ", "tajweed": "<rule class=ikhafa>ك</rule>َانَتۡ", "en": "(that) are", "tr": "kānat", "audio": "wbw/076_015_007.mp3"}, {"type": "word", "ar": "قَوَارِيرَا۠", "tajweed": "قَوَارِيرَاۡ", "en": "(of) crystal", "tr": "qawārīrā", "audio": "wbw/076_015_008.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "76:16", "juz": 29, "page": 579, "side_trans": "Clear glasses [made] from silver of which they have determined the measure.", "words": [{"type": "word", "ar": "قَوَارِيرَا۟", "tajweed": "قَوَارِيرَ<rule class=slnt>اۡ</rule>", "en": "Crystal-clear", "tr": "qawārīrā", "audio": "wbw/076_016_001.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "of", "tr": "min", "audio": "wbw/076_016_002.mp3"}, {"type": "word", "ar": "فِضَّةٍۢ", "tajweed": "<rule class=ikhafa>ف</rule>ِضَّ<rule class=ikhafa>ةٍ</rule>", "en": "silver", "tr": "fiḍḍatin", "audio": "wbw/076_016_003.mp3"}, {"type": "word", "ar": "قَدَّرُوهَا", "tajweed": "<rule class=ikhafa>ق</rule>َدَّرُوهَا", "en": "They will determine its", "tr": "qaddarūhā", "audio": "wbw/076_016_004.mp3"}, {"type": "word", "ar": "تَقْدِيرًۭا", "tajweed": "تَ<rule class=qalaqah>قۡ</rule>دِيرًا", "en": "measure", "tr": "taqdīran", "audio": "wbw/076_016_005.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "76:17", "juz": 29, "page": 579, "side_trans": "And they will be given to drink a cup [of wine] whose mixture is of ginger", "words": [{"type": "word", "ar": "وَيُسْقَوْنَ", "tajweed": "وَيُسۡقَوۡنَ", "en": "And they will be given to drink", "tr": "wayus'qawna", "audio": "wbw/076_017_001.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/076_017_002.mp3"}, {"type": "word", "ar": "كَأْسًۭا", "tajweed": "كَأۡ<rule class=ikhafa>سًا</rule>", "en": "a cup ", "tr": "kasan", "audio": "wbw/076_017_003.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "<rule class=ikhafa>ك</rule>َانَ", "en": "is", "tr": "kāna", "audio": "wbw/076_017_004.mp3"}, {"type": "word", "ar": "مِزَاجُهَا", "tajweed": "مِزَاجُهَا", "en": "its mixture", "tr": "mizājuhā", "audio": "wbw/076_017_005.mp3"}, {"type": "word", "ar": "زَنجَبِيلًا", "tajweed": "زَ<rule class=ikhafa>نج</rule>َبِيلاً", "en": "(of) Zanjabil", "tr": "zanjabīlan", "audio": "wbw/076_017_006.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "76:18", "juz": 29, "page": 579, "side_trans": "[From] a fountain within it [i.e., Paradise] named Salsabeel.", "words": [{"type": "word", "ar": "عَيْنًۭا", "tajweed": "عَيۡ<rule class=ikhafa>نًا</rule>", "en": "A spring", "tr": "ʿaynan", "audio": "wbw/076_018_001.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "<rule class=ikhafa>ف</rule>ِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/076_018_002.mp3"}, {"type": "word", "ar": "تُسَمَّىٰ", "tajweed": "تُسَ<rule class=ghunnah>مّ</rule>َىٰ", "en": "named", "tr": "tusammā", "audio": "wbw/076_018_003.mp3"}, {"type": "word", "ar": "سَلْسَبِيلًۭا", "tajweed": "سَلۡسَبِيلاً", "en": "Salsabil", "tr": "salsabīlan", "audio": "wbw/076_018_004.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "76:19", "juz": 29, "page": 579, "side_trans": "There will circulate among them young boys made eternal. When you see them, you would think them [as beautiful as] scattered pearls.", "words": [{"type": "word", "ar": "۞ وَيَطُوفُ", "tajweed": "۞وَيَطُوفُ", "en": "And will circulate", "tr": "wayaṭūfu", "audio": "wbw/076_019_002.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ", "tajweed": "عَلَيۡهِمۡ", "en": "among them", "tr": "ʿalayhim", "audio": "wbw/076_019_003.mp3"}, {"type": "word", "ar": "وِلْدَٰنٌۭ", "tajweed": "وِلۡد<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule><rule class=idgham_ghunnah>نٌ</rule>", "en": "young boys", "tr": "wil'dānun", "audio": "wbw/076_019_004.mp3"}, {"type": "word", "ar": "مُّخَلَّدُونَ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّخَلَّدُونَ", "en": "made eternal", "tr": "mukhalladūna", "audio": "wbw/076_019_005.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/076_019_006.mp3"}, {"type": "word", "ar": "رَأَيْتَهُمْ", "tajweed": "رَأَيۡتَهُمۡ", "en": "you see them", "tr": "ra-aytahum", "audio": "wbw/076_019_007.mp3"}, {"type": "word", "ar": "حَسِبْتَهُمْ", "tajweed": "حَسِ<rule class=qalaqah>بۡ</rule>تَهُمۡ", "en": "you would think them", "tr": "ḥasib'tahum", "audio": "wbw/076_019_008.mp3"}, {"type": "word", "ar": "لُؤْلُؤًۭا", "tajweed": "لُؤۡلُ<rule class=idgham_ghunnah>ؤًا</rule>", "en": "(to be) pearls", "tr": "lu'lu-an", "audio": "wbw/076_019_009.mp3"}, {"type": "word", "ar": "مَّنثُورًۭا", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّ<rule class=ikhafa>نث</rule>ُورًا", "en": "scattered", "tr": "manthūran", "audio": "wbw/076_019_010.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "76:20", "juz": 29, "page": 579, "side_trans": "And when you look there [in Paradise], you will see pleasure and great dominion.", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/076_020_001.mp3"}, {"type": "word", "ar": "رَأَيْتَ", "tajweed": "رَأَيۡتَ", "en": "you look", "tr": "ra-ayta", "audio": "wbw/076_020_002.mp3"}, {"type": "word", "ar": "ثَمَّ", "tajweed": "ثَ<rule class=ghunnah>مّ</rule>َ", "en": "then", "tr": "thamma", "audio": "wbw/076_020_003.mp3"}, {"type": "word", "ar": "رَأَيْتَ", "tajweed": "رَأَيۡتَ", "en": "you will see", "tr": "ra-ayta", "audio": "wbw/076_020_004.mp3"}, {"type": "word", "ar": "نَعِيمًۭا", "tajweed": "نَعِي<rule class=idgham_ghunnah>مًا</rule>", "en": "blessings", "tr": "naʿīman", "audio": "wbw/076_020_005.mp3"}, {"type": "word", "ar": "وَمُلْكًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َمُلۡ<rule class=ikhafa>كًا</rule>", "en": "and a kingdom", "tr": "wamul'kan", "audio": "wbw/076_020_006.mp3"}, {"type": "word", "ar": "كَبِيرًا", "tajweed": "<rule class=ikhafa>ك</rule>َبِيرًا", "en": "great", "tr": "kabīran", "audio": "wbw/076_020_007.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "76:21", "juz": 29, "page": 579, "side_trans": "Upon them [i.e., the inhabitants] will be green garments of fine silk and brocade. And they will be adorned with bracelets of silver, and their Lord will give them a purifying drink.", "words": [{"type": "word", "ar": "عَـٰلِيَهُمْ", "tajweed": "عَ<rule class=madda_normal>ـٰ</rule>لِيَهُمۡ", "en": "Upon them", "tr": "ʿāliyahum", "audio": "wbw/076_021_001.mp3"}, {"type": "word", "ar": "ثِيَابُ", "tajweed": "ثِيَابُ", "en": "(will be) garments", "tr": "thiyābu", "audio": "wbw/076_021_002.mp3"}, {"type": "word", "ar": "سُندُسٍ", "tajweed": "سُ<rule class=ikhafa>ند</rule>ُسٍ", "en": "(of) fine silk", "tr": "sundusin", "audio": "wbw/076_021_003.mp3"}, {"type": "word", "ar": "خُضْرٌۭ", "tajweed": "خُضۡ<rule class=idgham_ghunnah>رٌ</rule>", "en": "green", "tr": "khuḍ'run", "audio": "wbw/076_021_004.mp3"}, {"type": "word", "ar": "وَإِسْتَبْرَقٌۭ ۖ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َإِسۡتَ<rule class=qalaqah>بۡ</rule>رَ<rule class=idgham_ghunnah>قٌ‌ۖ</rule>", "en": "and heavy brocade", "tr": "wa-is'tabraqun", "audio": "wbw/076_021_005.mp3"}, {"type": "word", "ar": "وَحُلُّوٓا۟", "tajweed": "<rule class=idgham_ghunnah>و</rule>َحُلّ<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "And they will be adorned", "tr": "waḥullū", "audio": "wbw/076_021_007.mp3"}, {"type": "word", "ar": "أَسَاوِرَ", "tajweed": "أَسَاوِرَ", "en": "(with) bracelets", "tr": "asāwira", "audio": "wbw/076_021_008.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "of", "tr": "min", "audio": "wbw/076_021_009.mp3"}, {"type": "word", "ar": "فِضَّةٍۢ", "tajweed": "<rule class=ikhafa>ف</rule>ِضَّ<rule class=idgham_ghunnah>ةٍ</rule>", "en": "silver", "tr": "fiḍḍatin", "audio": "wbw/076_021_010.mp3"}, {"type": "word", "ar": "وَسَقَىٰهُمْ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َسَقَ<rule class=madda_normal>ـٰ</rule>هُمۡ", "en": "and will give them to drink", "tr": "wasaqāhum", "audio": "wbw/076_021_011.mp3"}, {"type": "word", "ar": "رَبُّهُمْ", "tajweed": "رَبُّهُمۡ", "en": "their Lord", "tr": "rabbuhum", "audio": "wbw/076_021_012.mp3"}, {"type": "word", "ar": "شَرَابًۭا", "tajweed": "شَرَا<rule class=ikhafa>بًا</rule>", "en": "a drink", "tr": "sharāban", "audio": "wbw/076_021_013.mp3"}, {"type": "word", "ar": "طَهُورًا", "tajweed": "<rule class=ikhafa>ط</rule>َهُورًا", "en": "pure", "tr": "ṭahūran", "audio": "wbw/076_021_014.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "76:22", "juz": 29, "page": 579, "side_trans": "[And it will be said], \"Indeed, this is for you a reward, and your effort has been appreciated.\"", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/076_022_001.mp3"}, {"type": "word", "ar": "هَـٰذَا", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>ذَا", "en": "this", "tr": "hādhā", "audio": "wbw/076_022_002.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "is", "tr": "kāna", "audio": "wbw/076_022_003.mp3"}, {"type": "word", "ar": "لَكُمْ", "tajweed": "لَكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/076_022_004.mp3"}, {"type": "word", "ar": "جَزَآءًۭ", "tajweed": "جَز<rule class=madda_obligatory_mottasel>َا</rule>ٓ<rule class=idgham_ghunnah>ءً</rule>", "en": "a reward", "tr": "jazāan", "audio": "wbw/076_022_005.mp3"}, {"type": "word", "ar": "وَكَانَ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َكَانَ", "en": "and has been", "tr": "wakāna", "audio": "wbw/076_022_006.mp3"}, {"type": "word", "ar": "سَعْيُكُم", "tajweed": "سَعۡيُك<rule class=idgham_shafawi>ُم</rule>", "en": "your effort", "tr": "saʿyukum", "audio": "wbw/076_022_007.mp3"}, {"type": "word", "ar": "مَّشْكُورًا", "tajweed": "<rule class=idgham_shafawi>م</rule>َّشۡكُورًا", "en": "appreciated", "tr": "mashkūran", "audio": "wbw/076_022_008.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "76:23", "juz": 29, "page": 579, "side_trans": "Indeed, it is We who have sent down to you, [O Muḥammad], the Qur’ān progressively.", "words": [{"type": "word", "ar": "إِنَّا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َا", "en": "Indeed, We", "tr": "innā", "audio": "wbw/076_023_001.mp3"}, {"type": "word", "ar": "نَحْنُ", "tajweed": "نَحۡنُ", "en": "[We]", "tr": "naḥnu", "audio": "wbw/076_023_002.mp3"}, {"type": "word", "ar": "نَزَّلْنَا", "tajweed": "نَزَّلۡنَا", "en": "[We] revealed", "tr": "nazzalnā", "audio": "wbw/076_023_003.mp3"}, {"type": "word", "ar": "عَلَيْكَ", "tajweed": "عَلَيۡكَ", "en": "to you", "tr": "ʿalayka", "audio": "wbw/076_023_004.mp3"}, {"type": "word", "ar": "ٱلْقُرْءَانَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقُرۡءَانَ", "en": "the Quran", "tr": "l-qur'āna", "audio": "wbw/076_023_005.mp3"}, {"type": "word", "ar": "تَنزِيلًۭا", "tajweed": "تَ<rule class=ikhafa>نز</rule>ِيلاً", "en": "progressively", "tr": "tanzīlan", "audio": "wbw/076_023_006.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "76:24", "juz": 29, "page": 579, "side_trans": "So be patient for the decision of your Lord and do not obey from among them a sinner or ungrateful [disbeliever].", "words": [{"type": "word", "ar": "فَٱصْبِرْ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>صۡبِرۡ", "en": "So be patient", "tr": "fa-iṣ'bir", "audio": "wbw/076_024_001.mp3"}, {"type": "word", "ar": "لِحُكْمِ", "tajweed": "لِحُكۡمِ", "en": "for (the) Command", "tr": "liḥuk'mi", "audio": "wbw/076_024_002.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "(of) your Lord", "tr": "rabbika", "audio": "wbw/076_024_003.mp3"}, {"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "and (do) not", "tr": "walā", "audio": "wbw/076_024_004.mp3"}, {"type": "word", "ar": "تُطِعْ", "tajweed": "تُطِعۡ", "en": "obey", "tr": "tuṭiʿ", "audio": "wbw/076_024_005.mp3"}, {"type": "word", "ar": "مِنْهُمْ", "tajweed": "مِنۡهُمۡ", "en": "from them", "tr": "min'hum", "audio": "wbw/076_024_006.mp3"}, {"type": "word", "ar": "ءَاثِمًا", "tajweed": "ءَاثِمًا", "en": "any sinner", "tr": "āthiman", "audio": "wbw/076_024_007.mp3"}, {"type": "word", "ar": "أَوْ", "tajweed": "أَوۡ", "en": "or", "tr": "aw", "audio": "wbw/076_024_008.mp3"}, {"type": "word", "ar": "كَفُورًۭا", "tajweed": "كَفُورًا", "en": "disbeliever", "tr": "kafūran", "audio": "wbw/076_024_009.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "76:25", "juz": 29, "page": 579, "side_trans": "And mention the name of your Lord [in prayer] morning and evening", "words": [{"type": "word", "ar": "وَٱذْكُرِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>ذۡكُرِ", "en": "And remember", "tr": "wa-udh'kuri", "audio": "wbw/076_025_001.mp3"}, {"type": "word", "ar": "ٱسْمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>سۡمَ", "en": "(the) name", "tr": "is'ma", "audio": "wbw/076_025_002.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "(of) your Lord", "tr": "rabbika", "audio": "wbw/076_025_003.mp3"}, {"type": "word", "ar": "بُكْرَةًۭ", "tajweed": "بُكۡرَ<rule class=idgham_ghunnah>ةً</rule>", "en": "morning", "tr": "buk'ratan", "audio": "wbw/076_025_004.mp3"}, {"type": "word", "ar": "وَأَصِيلًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َأَصِيلاً", "en": "and evening", "tr": "wa-aṣīlan", "audio": "wbw/076_025_005.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "76:26", "juz": 29, "page": 580, "side_trans": "And during the night prostrate to Him and exalt [i.e., praise] Him a long [part of the] night.", "words": [{"type": "word", "ar": "وَمِنَ", "tajweed": "وَمِنَ", "en": "And of", "tr": "wamina", "audio": "wbw/076_026_001.mp3"}, {"type": "word", "ar": "ٱلَّيْلِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّيۡلِ", "en": "the night", "tr": "al-layli", "audio": "wbw/076_026_002.mp3"}, {"type": "word", "ar": "فَٱسْجُدْ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>سۡجُ<rule class=qalaqah>دۡ</rule>", "en": "prostrate", "tr": "fa-us'jud", "audio": "wbw/076_026_003.mp3"}, {"type": "word", "ar": "لَهُۥ", "tajweed": "لَهُ<rule class=madda_normal>ۥ</rule>", "en": "to Him", "tr": "lahu", "audio": "wbw/076_026_004.mp3"}, {"type": "word", "ar": "وَسَبِّحْهُ", "tajweed": "وَسَبِّحۡهُ", "en": "and glorify Him", "tr": "wasabbiḥ'hu", "audio": "wbw/076_026_005.mp3"}, {"type": "word", "ar": "لَيْلًۭا", "tajweed": "لَيۡل<rule class=ikhafa>اً</rule>", "en": "a night", "tr": "laylan", "audio": "wbw/076_026_006.mp3"}, {"type": "word", "ar": "طَوِيلًا", "tajweed": "<rule class=ikhafa>ط</rule>َوِيلاً", "en": "long", "tr": "ṭawīlan", "audio": "wbw/076_026_007.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "76:27", "juz": 29, "page": 580, "side_trans": "Indeed, these [disbelievers] love the immediate and leave behind them a grave Day.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/076_027_001.mp3"}, {"type": "word", "ar": "هَـٰٓؤُلَآءِ", "tajweed": "هَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ؤُل<rule class=madda_obligatory_mottasel>َا</rule>ٓءِ", "en": "these", "tr": "hāulāi", "audio": "wbw/076_027_002.mp3"}, {"type": "word", "ar": "يُحِبُّونَ", "tajweed": "يُحِبُّونَ", "en": "love", "tr": "yuḥibbūna", "audio": "wbw/076_027_003.mp3"}, {"type": "word", "ar": "ٱلْعَاجِلَةَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَاجِلَةَ", "en": "the immediate", "tr": "l-ʿājilata", "audio": "wbw/076_027_004.mp3"}, {"type": "word", "ar": "وَيَذَرُونَ", "tajweed": "وَيَذَرُونَ", "en": "and leave", "tr": "wayadharūna", "audio": "wbw/076_027_005.mp3"}, {"type": "word", "ar": "وَرَآءَهُمْ", "tajweed": "وَر<rule class=madda_obligatory_mottasel>َا</rule>ٓءَهُمۡ", "en": "behind them", "tr": "warāahum", "audio": "wbw/076_027_006.mp3"}, {"type": "word", "ar": "يَوْمًۭا", "tajweed": "يَوۡ<rule class=ikhafa>مًا</rule>", "en": "a Day", "tr": "yawman", "audio": "wbw/076_027_007.mp3"}, {"type": "word", "ar": "ثَقِيلًۭا", "tajweed": "<rule class=ikhafa>ث</rule>َقِيلاً", "en": "grave", "tr": "thaqīlan", "audio": "wbw/076_027_008.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "76:28", "juz": 29, "page": 580, "side_trans": "We have created them and strengthened their forms, and when We will, We can change their likenesses with [complete] alteration.", "words": [{"type": "word", "ar": "نَّحْنُ", "tajweed": "نَّحۡنُ", "en": "We", "tr": "naḥnu", "audio": "wbw/076_028_001.mp3"}, {"type": "word", "ar": "خَلَقْنَـٰهُمْ", "tajweed": "خَلَ<rule class=qalaqah>قۡ</rule>نَ<rule class=madda_normal>ـٰ</rule>هُمۡ", "en": "created them", "tr": "khalaqnāhum", "audio": "wbw/076_028_002.mp3"}, {"type": "word", "ar": "وَشَدَدْنَآ", "tajweed": "وَشَدَ<rule class=qalaqah>دۡ</rule>ن<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "and We strengthened", "tr": "washadadnā", "audio": "wbw/076_028_003.mp3"}, {"type": "word", "ar": "أَسْرَهُمْ ۖ", "tajweed": "أَسۡرَهُمۡ‌ۖ", "en": "their forms", "tr": "asrahum", "audio": "wbw/076_028_004.mp3"}, {"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "and when", "tr": "wa-idhā", "audio": "wbw/076_028_006.mp3"}, {"type": "word", "ar": "شِئْنَا", "tajweed": "شِئۡنَا", "en": "We will", "tr": "shi'nā", "audio": "wbw/076_028_007.mp3"}, {"type": "word", "ar": "بَدَّلْنَآ", "tajweed": "بَدَّلۡن<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "We can change", "tr": "baddalnā", "audio": "wbw/076_028_008.mp3"}, {"type": "word", "ar": "أَمْثَـٰلَهُمْ", "tajweed": "أَمۡثَ<rule class=madda_normal>ـٰ</rule>لَهُمۡ", "en": "their likeness[es]", "tr": "amthālahum", "audio": "wbw/076_028_009.mp3"}, {"type": "word", "ar": "تَبْدِيلًا", "tajweed": "تَ<rule class=qalaqah>بۡ</rule>دِيلاً", "en": "(with) a change", "tr": "tabdīlan", "audio": "wbw/076_028_010.mp3"}, {"type": "end", "num": "٢٨"}]}, {"id": 29, "key": "76:29", "juz": 29, "page": 580, "side_trans": "Indeed, this is a reminder, so he who wills may take to his Lord a way.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/076_029_001.mp3"}, {"type": "word", "ar": "هَـٰذِهِۦ", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>ذِه<rule class=madda_normal>ِۦ</rule>", "en": "this", "tr": "hādhihi", "audio": "wbw/076_029_002.mp3"}, {"type": "word", "ar": "تَذْكِرَةٌۭ ۖ", "tajweed": "تَذۡكِرَ<rule class=ikhafa>ةٌ‌ۖ</rule>", "en": "(is) a reminder", "tr": "tadhkiratun", "audio": "wbw/076_029_003.mp3"}, {"type": "word", "ar": "فَمَن", "tajweed": "<rule class=ikhafa>ف</rule>َمَ<rule class=ikhafa>ن</rule>", "en": "so whoever", "tr": "faman", "audio": "wbw/076_029_005.mp3"}, {"type": "word", "ar": "شَآءَ", "tajweed": "<rule class=ikhafa>ش</rule><rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "wills", "tr": "shāa", "audio": "wbw/076_029_006.mp3"}, {"type": "word", "ar": "ٱتَّخَذَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>تَّخَذَ", "en": "let him take", "tr": "ittakhadha", "audio": "wbw/076_029_007.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/076_029_008.mp3"}, {"type": "word", "ar": "رَبِّهِۦ", "tajweed": "رَبِّه<rule class=madda_normal>ِۦ</rule>", "en": "his Lord", "tr": "rabbihi", "audio": "wbw/076_029_009.mp3"}, {"type": "word", "ar": "سَبِيلًۭا", "tajweed": "سَبِيلاً", "en": "a way", "tr": "sabīlan", "audio": "wbw/076_029_010.mp3"}, {"type": "end", "num": "٢٩"}]}, {"id": 30, "key": "76:30", "juz": 29, "page": 580, "side_trans": "And you do not will except that Allāh wills. Indeed, Allāh is ever Knowing and Wise.", "words": [{"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "And not", "tr": "wamā", "audio": "wbw/076_030_001.mp3"}, {"type": "word", "ar": "تَشَآءُونَ", "tajweed": "تَش<rule class=madda_obligatory_mottasel>َا</rule>ٓءُونَ", "en": "you will", "tr": "tashāūna", "audio": "wbw/076_030_002.mp3"}, {"type": "word", "ar": "إِلَّآ", "tajweed": "إِلّ<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "except", "tr": "illā", "audio": "wbw/076_030_003.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/076_030_004.mp3"}, {"type": "word", "ar": "يَشَآءَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َش<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "wills", "tr": "yashāa", "audio": "wbw/076_030_005.mp3"}, {"type": "word", "ar": "ٱللَّهُ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ‌ۚ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/076_030_006.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/076_030_008.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/076_030_009.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "is", "tr": "kāna", "audio": "wbw/076_030_010.mp3"}, {"type": "word", "ar": "عَلِيمًا", "tajweed": "عَلِيمًا", "en": "All-Knower", "tr": "ʿalīman", "audio": "wbw/076_030_011.mp3"}, {"type": "word", "ar": "حَكِيمًۭا", "tajweed": "حَكِيمًا", "en": "All-Wise", "tr": "ḥakīman", "audio": "wbw/076_030_012.mp3"}, {"type": "end", "num": "٣٠"}]}, {"id": 31, "key": "76:31", "juz": 29, "page": 580, "side_trans": "He admits whom He wills into His mercy; but the wrongdoers - He has prepared for them a painful punishment.", "words": [{"type": "word", "ar": "يُدْخِلُ", "tajweed": "يُ<rule class=qalaqah>دۡ</rule>خِلُ", "en": "He admits", "tr": "yud'khilu", "audio": "wbw/076_031_001.mp3"}, {"type": "word", "ar": "مَن", "tajweed": "م<rule class=idgham_ghunnah>َن</rule>", "en": "whom", "tr": "man", "audio": "wbw/076_031_002.mp3"}, {"type": "word", "ar": "يَشَآءُ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َش<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ", "en": "He wills", "tr": "yashāu", "audio": "wbw/076_031_003.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "into", "tr": "fī", "audio": "wbw/076_031_004.mp3"}, {"type": "word", "ar": "رَحْمَتِهِۦ ۚ", "tajweed": "رَحۡمَتِه<rule class=madda_normal>ِۦ</rule>‌ۚ", "en": "His mercy", "tr": "raḥmatihi", "audio": "wbw/076_031_005.mp3"}, {"type": "word", "ar": "وَٱلظَّـٰلِمِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>ظَّ<rule class=madda_normal>ـٰ</rule>لِمِينَ", "en": "but (for) the wrongdoers", "tr": "wal-ẓālimīna", "audio": "wbw/076_031_007.mp3"}, {"type": "word", "ar": "أَعَدَّ", "tajweed": "أَعَدَّ", "en": "He has prepared", "tr": "aʿadda", "audio": "wbw/076_031_008.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "for them", "tr": "lahum", "audio": "wbw/076_031_009.mp3"}, {"type": "word", "ar": "عَذَابًا", "tajweed": "عَذَابًا", "en": "a punishment", "tr": "ʿadhāban", "audio": "wbw/076_031_010.mp3"}, {"type": "word", "ar": "أَلِيمًۢا", "tajweed": "أَلِيمَۢا", "en": "painful", "tr": "alīman", "audio": "wbw/076_031_011.mp3"}, {"type": "end", "num": "٣١"}]}]