[{"id": 1, "key": "73:1", "juz": 29, "page": 574, "side_trans": "O you who wraps himself [in clothing]", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O you", "tr": "yāayyuhā", "audio": "wbw/073_001_001.mp3"}, {"type": "word", "ar": "ٱلْمُزَّمِّلُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُزَّ<rule class=ghunnah>مّ</rule>ِلُ", "en": "who wraps himself", "tr": "l-muzamilu", "audio": "wbw/073_001_002.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "73:2", "juz": 29, "page": 574, "side_trans": "Arise [to pray] the night, except for a little -", "words": [{"type": "word", "ar": "قُمِ", "tajweed": "قُمِ", "en": "Stand", "tr": "qumi", "audio": "wbw/073_002_001.mp3"}, {"type": "word", "ar": "ٱلَّيْلَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّيۡلَ", "en": "(in) the night", "tr": "al-layla", "audio": "wbw/073_002_002.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/073_002_003.mp3"}, {"type": "word", "ar": "قَلِيلًۭا", "tajweed": "قَلِيلاً", "en": "a little", "tr": "qalīlan", "audio": "wbw/073_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "73:3", "juz": 29, "page": 574, "side_trans": "Half of it - or subtract from it a little", "words": [{"type": "word", "ar": "نِّصْفَهُۥٓ", "tajweed": "نِّصۡفَهُ<rule class=madda_obligatory_monfasel>ۥٓ</rule>", "en": "Half of it", "tr": "niṣ'fahu", "audio": "wbw/073_003_001.mp3"}, {"type": "word", "ar": "أَوِ", "tajweed": "أَوِ", "en": "or", "tr": "awi", "audio": "wbw/073_003_002.mp3"}, {"type": "word", "ar": "ٱنقُصْ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=ikhafa>نق</rule>ُصۡ", "en": "lessen", "tr": "unquṣ", "audio": "wbw/073_003_003.mp3"}, {"type": "word", "ar": "مِنْهُ", "tajweed": "مِنۡهُ", "en": "from it", "tr": "min'hu", "audio": "wbw/073_003_004.mp3"}, {"type": "word", "ar": "قَلِيلًا", "tajweed": "قَلِيلاً", "en": "a little", "tr": "qalīlan", "audio": "wbw/073_003_005.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "73:4", "juz": 29, "page": 574, "side_trans": "Or add to it, and recite the Qur’ān with measured recitation.", "words": [{"type": "word", "ar": "أَوْ", "tajweed": "أَوۡ", "en": "Or", "tr": "aw", "audio": "wbw/073_004_001.mp3"}, {"type": "word", "ar": "زِدْ", "tajweed": "زِ<rule class=qalaqah>دۡ</rule>", "en": "add", "tr": "zid", "audio": "wbw/073_004_002.mp3"}, {"type": "word", "ar": "عَلَيْهِ", "tajweed": "عَلَيۡهِ", "en": "to it", "tr": "ʿalayhi", "audio": "wbw/073_004_003.mp3"}, {"type": "word", "ar": "وَرَتِّلِ", "tajweed": "وَرَتِّلِ", "en": "and recite", "tr": "warattili", "audio": "wbw/073_004_004.mp3"}, {"type": "word", "ar": "ٱلْقُرْءَانَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقُرۡءَانَ", "en": "the Quran", "tr": "l-qur'āna", "audio": "wbw/073_004_005.mp3"}, {"type": "word", "ar": "تَرْتِيلًا", "tajweed": "تَرۡتِيلاً", "en": "(with) measured rhythmic recitation", "tr": "tartīlan", "audio": "wbw/073_004_006.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "73:5", "juz": 29, "page": 574, "side_trans": "Indeed, We will cast upon you a heavy word.", "words": [{"type": "word", "ar": "إِنَّا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َا", "en": "Indeed, We", "tr": "innā", "audio": "wbw/073_005_001.mp3"}, {"type": "word", "ar": "سَنُلْقِى", "tajweed": "سَنُلۡقِى", "en": "will cast", "tr": "sanul'qī", "audio": "wbw/073_005_002.mp3"}, {"type": "word", "ar": "عَلَيْكَ", "tajweed": "عَلَيۡكَ", "en": "upon you", "tr": "ʿalayka", "audio": "wbw/073_005_003.mp3"}, {"type": "word", "ar": "قَوْلًۭا", "tajweed": "قَوۡل<rule class=ikhafa>اً</rule>", "en": "a Word", "tr": "qawlan", "audio": "wbw/073_005_004.mp3"}, {"type": "word", "ar": "ثَقِيلًا", "tajweed": "<rule class=ikhafa>ث</rule>َقِيلاً", "en": "heavy", "tr": "thaqīlan", "audio": "wbw/073_005_005.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "73:6", "juz": 29, "page": 574, "side_trans": "Indeed, the hours of the night are more effective for concurrence [of heart and tongue] and more suitable for words.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/073_006_001.mp3"}, {"type": "word", "ar": "نَاشِئَةَ", "tajweed": "نَاشِئَةَ", "en": "(the) rising", "tr": "nāshi-ata", "audio": "wbw/073_006_002.mp3"}, {"type": "word", "ar": "ٱلَّيْلِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّيۡلِ", "en": "(at) the night", "tr": "al-layli", "audio": "wbw/073_006_003.mp3"}, {"type": "word", "ar": "هِىَ", "tajweed": "هِىَ", "en": "it", "tr": "hiya", "audio": "wbw/073_006_004.mp3"}, {"type": "word", "ar": "أَشَدُّ", "tajweed": "أَشَدُّ", "en": "(is) very hard", "tr": "ashaddu", "audio": "wbw/073_006_005.mp3"}, {"type": "word", "ar": "وَطْـًۭٔا", "tajweed": "وَ<rule class=qalaqah>طۡ</rule>ـ<rule class=idgham_ghunnah>ـًٔا</rule>", "en": "and most potent", "tr": "waṭan", "audio": "wbw/073_006_006.mp3"}, {"type": "word", "ar": "وَأَقْوَمُ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َأَ<rule class=qalaqah>قۡ</rule>وَمُ", "en": "and more suitable", "tr": "wa-aqwamu", "audio": "wbw/073_006_007.mp3"}, {"type": "word", "ar": "قِيلًا", "tajweed": "قِيلاً", "en": "(for) Word", "tr": "qīlan", "audio": "wbw/073_006_008.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "73:7", "juz": 29, "page": 574, "side_trans": "Indeed, for you by day is prolonged occupation.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/073_007_001.mp3"}, {"type": "word", "ar": "لَكَ", "tajweed": "لَكَ", "en": "for you", "tr": "laka", "audio": "wbw/073_007_002.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/073_007_003.mp3"}, {"type": "word", "ar": "ٱلنَّهَارِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َهَارِ", "en": "the day", "tr": "l-nahāri", "audio": "wbw/073_007_004.mp3"}, {"type": "word", "ar": "سَبْحًۭا", "tajweed": "سَ<rule class=qalaqah>بۡ</rule><rule class=ikhafa>حًا</rule>", "en": "(is) occupation", "tr": "sabḥan", "audio": "wbw/073_007_005.mp3"}, {"type": "word", "ar": "طَوِيلًۭا", "tajweed": "<rule class=ikhafa>ط</rule>َوِيلاً", "en": "prolonged", "tr": "ṭawīlan", "audio": "wbw/073_007_006.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "73:8", "juz": 29, "page": 574, "side_trans": "And remember the name of your Lord and devote yourself to Him with [complete] devotion.", "words": [{"type": "word", "ar": "وَٱذْكُرِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>ذۡكُرِ", "en": "And remember", "tr": "wa-udh'kuri", "audio": "wbw/073_008_001.mp3"}, {"type": "word", "ar": "ٱسْمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>سۡمَ", "en": "(the) name", "tr": "is'ma", "audio": "wbw/073_008_002.mp3"}, {"type": "word", "ar": "رَبِّكَ", "tajweed": "رَبِّكَ", "en": "(of) your Lord", "tr": "rabbika", "audio": "wbw/073_008_003.mp3"}, {"type": "word", "ar": "وَتَبَتَّلْ", "tajweed": "وَتَبَتَّلۡ", "en": "and devote yourself", "tr": "watabattal", "audio": "wbw/073_008_004.mp3"}, {"type": "word", "ar": "إِلَيْهِ", "tajweed": "إِلَيۡهِ", "en": "to Him", "tr": "ilayhi", "audio": "wbw/073_008_005.mp3"}, {"type": "word", "ar": "تَبْتِيلًۭا", "tajweed": "تَ<rule class=qalaqah>بۡ</rule>تِيلاً", "en": "(with) devotion", "tr": "tabtīlan", "audio": "wbw/073_008_006.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "73:9", "juz": 29, "page": 574, "side_trans": "[He is] the Lord of the East and the West; there is no deity except Him, so take Him as Disposer of [your] affairs.", "words": [{"type": "word", "ar": "رَّبُّ", "tajweed": "رَّبُّ", "en": "(The) Lord", "tr": "rabbu", "audio": "wbw/073_009_001.mp3"}, {"type": "word", "ar": "ٱلْمَشْرِقِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَشۡرِقِ", "en": "(of) the east", "tr": "l-mashriqi", "audio": "wbw/073_009_002.mp3"}, {"type": "word", "ar": "وَٱلْمَغْرِبِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمَغۡرِبِ", "en": "and the west", "tr": "wal-maghribi", "audio": "wbw/073_009_003.mp3"}, {"type": "word", "ar": "لَآ", "tajweed": "ل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "(there is) no", "tr": "lā", "audio": "wbw/073_009_004.mp3"}, {"type": "word", "ar": "إِلَـٰهَ", "tajweed": "إِلَ<rule class=madda_normal>ـٰ</rule>هَ", "en": "god", "tr": "ilāha", "audio": "wbw/073_009_005.mp3"}, {"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "except", "tr": "illā", "audio": "wbw/073_009_006.mp3"}, {"type": "word", "ar": "هُوَ", "tajweed": "هُوَ", "en": "Him", "tr": "huwa", "audio": "wbw/073_009_007.mp3"}, {"type": "word", "ar": "فَٱتَّخِذْهُ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>تَّخِذۡهُ", "en": "so take Him", "tr": "fa-ittakhidh'hu", "audio": "wbw/073_009_008.mp3"}, {"type": "word", "ar": "وَكِيلًۭا", "tajweed": "وَكِيلاً", "en": "(as) Disposer of Affairs", "tr": "wakīlan", "audio": "wbw/073_009_009.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "73:10", "juz": 29, "page": 574, "side_trans": "And be patient over what they say and avoid them with gracious avoidance.", "words": [{"type": "word", "ar": "وَٱصْبِرْ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>صۡبِرۡ", "en": "And be patient", "tr": "wa-iṣ'bir", "audio": "wbw/073_010_001.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "over", "tr": "ʿalā", "audio": "wbw/073_010_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/073_010_003.mp3"}, {"type": "word", "ar": "يَقُولُونَ", "tajweed": "يَقُولُونَ", "en": "they say", "tr": "yaqūlūna", "audio": "wbw/073_010_004.mp3"}, {"type": "word", "ar": "وَٱهْجُرْهُمْ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>هۡجُرۡهُمۡ", "en": "and avoid them", "tr": "wa-uh'jur'hum", "audio": "wbw/073_010_005.mp3"}, {"type": "word", "ar": "هَجْرًۭا", "tajweed": "هَ<rule class=qalaqah>جۡ</rule><rule class=ikhafa>رًا</rule>", "en": "an avoidance", "tr": "hajran", "audio": "wbw/073_010_006.mp3"}, {"type": "word", "ar": "جَمِيلًۭا", "tajweed": "<rule class=ikhafa>ج</rule>َمِيلاً", "en": "gracious", "tr": "jamīlan", "audio": "wbw/073_010_007.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "73:11", "juz": 29, "page": 574, "side_trans": "And leave Me with [the matter of] the deniers, those of ease [in life], and allow them respite a little.", "words": [{"type": "word", "ar": "وَذَرْنِى", "tajweed": "وَذَرۡنِى", "en": "And leave Me", "tr": "wadharnī", "audio": "wbw/073_011_001.mp3"}, {"type": "word", "ar": "وَٱلْمُكَذِّبِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمُكَذِّبِينَ", "en": "and the deniers", "tr": "wal-mukadhibīna", "audio": "wbw/073_011_002.mp3"}, {"type": "word", "ar": "أُو۟لِى", "tajweed": "أُ<rule class=slnt>وۡ</rule>لِى", "en": "possessors", "tr": "ulī", "audio": "wbw/073_011_003.mp3"}, {"type": "word", "ar": "ٱلنَّعْمَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule><rule class=ghunnah>نّ</rule>َعۡمَةِ", "en": "(of) the ease", "tr": "l-naʿmati", "audio": "wbw/073_011_004.mp3"}, {"type": "word", "ar": "وَمَهِّلْهُمْ", "tajweed": "وَمَهِّلۡهُمۡ", "en": "and allow them respite ", "tr": "wamahhil'hum", "audio": "wbw/073_011_005.mp3"}, {"type": "word", "ar": "قَلِيلًا", "tajweed": "قَلِيلاً", "en": "a little", "tr": "qalīlan", "audio": "wbw/073_011_006.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "73:12", "juz": 29, "page": 574, "side_trans": "Indeed, with Us [for them] are shackles and burning fire.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/073_012_001.mp3"}, {"type": "word", "ar": "لَدَيْنَآ", "tajweed": "لَدَيۡن<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "with Us", "tr": "ladaynā", "audio": "wbw/073_012_002.mp3"}, {"type": "word", "ar": "أَنكَالًۭا", "tajweed": "أَ<rule class=ikhafa>نك</rule>َال<rule class=idgham_ghunnah>اً</rule>", "en": "(are) shackles", "tr": "ankālan", "audio": "wbw/073_012_003.mp3"}, {"type": "word", "ar": "وَجَحِيمًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َجَحِيمًا", "en": "and burning fire", "tr": "wajaḥīman", "audio": "wbw/073_012_004.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "73:13", "juz": 29, "page": 574, "side_trans": "And food that chokes and a painful punishment -", "words": [{"type": "word", "ar": "وَطَعَامًۭا", "tajweed": "وَطَعَا<rule class=ikhafa>مًا</rule>", "en": "And food", "tr": "waṭaʿāman", "audio": "wbw/073_013_001.mp3"}, {"type": "word", "ar": "ذَا", "tajweed": "<rule class=ikhafa>ذ</rule>َا", "en": "that", "tr": "dhā", "audio": "wbw/073_013_002.mp3"}, {"type": "word", "ar": "غُصَّةٍۢ", "tajweed": "غُصَّ<rule class=idgham_ghunnah>ةٍ</rule>", "en": "chokes", "tr": "ghuṣṣatin", "audio": "wbw/073_013_003.mp3"}, {"type": "word", "ar": "وَعَذَابًا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َعَذَابًا", "en": "and a punishment", "tr": "waʿadhāban", "audio": "wbw/073_013_004.mp3"}, {"type": "word", "ar": "أَلِيمًۭا", "tajweed": "أَلِيمًا", "en": "painful", "tr": "alīman", "audio": "wbw/073_013_005.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "73:14", "juz": 29, "page": 574, "side_trans": "On the Day the earth and the mountains will convulse and the mountains will become a heap of sand pouring down.", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(On the) Day", "tr": "yawma", "audio": "wbw/073_014_001.mp3"}, {"type": "word", "ar": "تَرْجُفُ", "tajweed": "تَرۡجُفُ", "en": "will quake", "tr": "tarjufu", "audio": "wbw/073_014_002.mp3"}, {"type": "word", "ar": "ٱلْأَرْضُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضُ", "en": "the earth", "tr": "l-arḍu", "audio": "wbw/073_014_003.mp3"}, {"type": "word", "ar": "وَٱلْجِبَالُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡجِبَالُ", "en": "and the mountains", "tr": "wal-jibālu", "audio": "wbw/073_014_004.mp3"}, {"type": "word", "ar": "وَكَانَتِ", "tajweed": "وَكَانَتِ", "en": "and will become", "tr": "wakānati", "audio": "wbw/073_014_005.mp3"}, {"type": "word", "ar": "ٱلْجِبَالُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجِبَالُ", "en": "the mountains", "tr": "l-jibālu", "audio": "wbw/073_014_006.mp3"}, {"type": "word", "ar": "كَثِيبًۭا", "tajweed": "كَثِي<rule class=idgham_ghunnah>بًا</rule>", "en": "a heap of sand", "tr": "kathīban", "audio": "wbw/073_014_007.mp3"}, {"type": "word", "ar": "مَّهِيلًا", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّهِيلاً", "en": "pouring down", "tr": "mahīlan", "audio": "wbw/073_014_008.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "73:15", "juz": 29, "page": 574, "side_trans": "Indeed, We have sent to you a Messenger as a witness upon you just as We sent to Pharaoh a messenger.", "words": [{"type": "word", "ar": "إِنَّآ", "tajweed": "إِ<rule class=ghunnah>نّ</rule><rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Indeed, We", "tr": "innā", "audio": "wbw/073_015_001.mp3"}, {"type": "word", "ar": "أَرْسَلْنَآ", "tajweed": "أَرۡسَلۡن<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "[We] have sent", "tr": "arsalnā", "audio": "wbw/073_015_002.mp3"}, {"type": "word", "ar": "إِلَيْكُمْ", "tajweed": "إِلَيۡكُمۡ", "en": "to you", "tr": "ilaykum", "audio": "wbw/073_015_003.mp3"}, {"type": "word", "ar": "رَسُولًۭا", "tajweed": "رَسُول<rule class=ikhafa>اً</rule>", "en": "a Messenger", "tr": "rasūlan", "audio": "wbw/073_015_004.mp3"}, {"type": "word", "ar": "شَـٰهِدًا", "tajweed": "<rule class=ikhafa>ش</rule>َ<rule class=madda_normal>ـٰ</rule>هِدًا", "en": "(as) a witness", "tr": "shāhidan", "audio": "wbw/073_015_005.mp3"}, {"type": "word", "ar": "عَلَيْكُمْ", "tajweed": "عَلَيۡكُمۡ", "en": "upon you", "tr": "ʿalaykum", "audio": "wbw/073_015_006.mp3"}, {"type": "word", "ar": "كَمَآ", "tajweed": "كَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "as", "tr": "kamā", "audio": "wbw/073_015_007.mp3"}, {"type": "word", "ar": "أَرْسَلْنَآ", "tajweed": "أَرۡسَلۡن<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "We sent", "tr": "arsalnā", "audio": "wbw/073_015_008.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/073_015_009.mp3"}, {"type": "word", "ar": "فِرْعَوْنَ", "tajweed": "فِرۡعَوۡنَ", "en": "Firaun", "tr": "fir'ʿawna", "audio": "wbw/073_015_010.mp3"}, {"type": "word", "ar": "رَسُولًۭا", "tajweed": "رَسُولاً", "en": "a Messenger", "tr": "rasūlan", "audio": "wbw/073_015_011.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "73:16", "juz": 29, "page": 574, "side_trans": "But Pharaoh disobeyed the messenger, so We seized him with a ruinous seizure.", "words": [{"type": "word", "ar": "فَعَصَىٰ", "tajweed": "فَعَصَىٰ", "en": "But disobeyed", "tr": "faʿaṣā", "audio": "wbw/073_016_001.mp3"}, {"type": "word", "ar": "فِرْعَوْنُ", "tajweed": "فِرۡعَوۡنُ", "en": "Firaun", "tr": "fir'ʿawnu", "audio": "wbw/073_016_002.mp3"}, {"type": "word", "ar": "ٱلرَّسُولَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رَّسُولَ", "en": "the Messenger", "tr": "l-rasūla", "audio": "wbw/073_016_003.mp3"}, {"type": "word", "ar": "فَأَخَذْنَـٰهُ", "tajweed": "فَأَخَذۡنَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "so We seized him", "tr": "fa-akhadhnāhu", "audio": "wbw/073_016_004.mp3"}, {"type": "word", "ar": "أَخْذًۭا", "tajweed": "أَخۡ<rule class=idgham_ghunnah>ذًا</rule>", "en": "(with) a seizure", "tr": "akhdhan", "audio": "wbw/073_016_005.mp3"}, {"type": "word", "ar": "وَبِيلًۭا", "tajweed": "<rule class=idgham_ghunnah>و</rule>َبِيلاً", "en": "ruinous", "tr": "wabīlan", "audio": "wbw/073_016_006.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "73:17", "juz": 29, "page": 574, "side_trans": "Then how can you fear, if you disbelieve, a Day that will make the children white-haired?", "words": [{"type": "word", "ar": "فَكَيْفَ", "tajweed": "فَكَيۡفَ", "en": "Then how", "tr": "fakayfa", "audio": "wbw/073_017_001.mp3"}, {"type": "word", "ar": "تَتَّقُونَ", "tajweed": "تَتَّقُونَ", "en": "will you guard yourselves", "tr": "tattaqūna", "audio": "wbw/073_017_002.mp3"}, {"type": "word", "ar": "إِن", "tajweed": "إِ<rule class=ikhafa>ن</rule>", "en": "if", "tr": "in", "audio": "wbw/073_017_003.mp3"}, {"type": "word", "ar": "كَفَرْتُمْ", "tajweed": "<rule class=ikhafa>ك</rule>َفَرۡتُمۡ", "en": "you disbelieve", "tr": "kafartum", "audio": "wbw/073_017_004.mp3"}, {"type": "word", "ar": "يَوْمًۭا", "tajweed": "يَوۡ<rule class=idgham_ghunnah>مًا</rule>", "en": "a Day", "tr": "yawman", "audio": "wbw/073_017_005.mp3"}, {"type": "word", "ar": "يَجْعَلُ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َ<rule class=qalaqah>جۡ</rule>عَلُ", "en": "(that) will make", "tr": "yajʿalu", "audio": "wbw/073_017_006.mp3"}, {"type": "word", "ar": "ٱلْوِلْدَٰنَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡوِلۡد<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>نَ", "en": "the children", "tr": "l-wil'dāna", "audio": "wbw/073_017_007.mp3"}, {"type": "word", "ar": "شِيبًا", "tajweed": "شِيبًا", "en": "gray-haired", "tr": "shīban", "audio": "wbw/073_017_008.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "73:18", "juz": 29, "page": 574, "side_trans": "The heaven will break apart therefrom; ever is His promise fulfilled.", "words": [{"type": "word", "ar": "ٱلسَّمَآءُ", "tajweed": "ٱ<rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ", "en": "The heaven", "tr": "al-samāu", "audio": "wbw/073_018_001.mp3"}, {"type": "word", "ar": "مُنفَطِرٌۢ", "tajweed": "مُ<rule class=ikhafa>نف</rule>َطِ<rule class=iqlab>رُۢ</rule>", "en": "(will) break apart", "tr": "munfaṭirun", "audio": "wbw/073_018_002.mp3"}, {"type": "word", "ar": "بِهِۦ ۚ", "tajweed": "<rule class=iqlab>ب</rule>ِه<rule class=madda_normal>ِۦ</rule>‌ۚ", "en": "therefrom", "tr": "bihi", "audio": "wbw/073_018_003.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "كَانَ", "en": "is", "tr": "kāna", "audio": "wbw/073_018_005.mp3"}, {"type": "word", "ar": "وَعْدُهُۥ", "tajweed": "وَعۡدُهُ<rule class=madda_normal>ۥ</rule>", "en": "His Promise", "tr": "waʿduhu", "audio": "wbw/073_018_006.mp3"}, {"type": "word", "ar": "مَفْعُولًا", "tajweed": "مَفۡعُولاً", "en": "to be fulfilled", "tr": "mafʿūlan", "audio": "wbw/073_018_007.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "73:19", "juz": 29, "page": 574, "side_trans": "Indeed, this is a reminder, so whoever wills may take to his Lord a way.", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/073_019_001.mp3"}, {"type": "word", "ar": "هَـٰذِهِۦ", "tajweed": "هَ<rule class=madda_normal>ـٰ</rule>ذِه<rule class=madda_normal>ِۦ</rule>", "en": "this", "tr": "hādhihi", "audio": "wbw/073_019_002.mp3"}, {"type": "word", "ar": "تَذْكِرَةٌۭ ۖ", "tajweed": "تَذۡكِرَ<rule class=ikhafa>ةٌ‌ۖ</rule>", "en": "(is) a Reminder", "tr": "tadhkiratun", "audio": "wbw/073_019_003.mp3"}, {"type": "word", "ar": "فَمَن", "tajweed": "<rule class=ikhafa>ف</rule>َمَ<rule class=ikhafa>ن</rule>", "en": "then whoever", "tr": "faman", "audio": "wbw/073_019_005.mp3"}, {"type": "word", "ar": "شَآءَ", "tajweed": "<rule class=ikhafa>ش</rule><rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "wills", "tr": "shāa", "audio": "wbw/073_019_006.mp3"}, {"type": "word", "ar": "ٱتَّخَذَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>تَّخَذَ", "en": "(let him) take", "tr": "ittakhadha", "audio": "wbw/073_019_007.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/073_019_008.mp3"}, {"type": "word", "ar": "رَبِّهِۦ", "tajweed": "رَبِّه<rule class=madda_normal>ِۦ</rule>", "en": "his Lord", "tr": "rabbihi", "audio": "wbw/073_019_009.mp3"}, {"type": "word", "ar": "سَبِيلًا", "tajweed": "سَبِيلاً", "en": "a way", "tr": "sabīlan", "audio": "wbw/073_019_010.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "73:20", "juz": 29, "page": 575, "side_trans": "Indeed, your Lord knows, [O Muḥammad], that you stand [in prayer] almost two thirds of the night or half of it or a third of it, and [so do] a group of those with you. And Allāh determines [the extent of] the night and the day. He has known that you [Muslims] will not be able to do it and has turned to you in forgiveness, so recite what is easy [for you] of the Qur’ān. He has known that there will be among you those who are ill and others traveling throughout the land seeking [something] of the bounty of Allāh and others fighting for the cause of Allāh. So recite what is easy from it and establish prayer and give zakāh and loan Allāh a goodly loan. And whatever good you put forward for yourselves - you will find it with Allāh. It is better and greater in reward. And seek forgiveness of Allāh. Indeed, Allāh is Forgiving and Merciful.", "words": [{"type": "word", "ar": "۞ إِنَّ", "tajweed": "۞إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/073_020_002.mp3"}, {"type": "word", "ar": "رَبَّكَ", "tajweed": "رَبَّكَ", "en": "your Lord", "tr": "rabbaka", "audio": "wbw/073_020_003.mp3"}, {"type": "word", "ar": "يَعْلَمُ", "tajweed": "يَعۡلَمُ", "en": "knows", "tr": "yaʿlamu", "audio": "wbw/073_020_004.mp3"}, {"type": "word", "ar": "أَنَّكَ", "tajweed": "أَ<rule class=ghunnah>نّ</rule>َكَ", "en": "that you", "tr": "annaka", "audio": "wbw/073_020_005.mp3"}, {"type": "word", "ar": "تَقُومُ", "tajweed": "تَقُومُ", "en": "stand", "tr": "taqūmu", "audio": "wbw/073_020_006.mp3"}, {"type": "word", "ar": "أَدْنَىٰ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>نَىٰ", "en": "(a little) less", "tr": "adnā", "audio": "wbw/073_020_007.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "مِ<rule class=ikhafa>ن</rule>", "en": "than", "tr": "min", "audio": "wbw/073_020_008.mp3"}, {"type": "word", "ar": "ثُلُثَىِ", "tajweed": "<rule class=ikhafa>ث</rule>ُلُثَىِ", "en": "two-thirds", "tr": "thuluthayi", "audio": "wbw/073_020_009.mp3"}, {"type": "word", "ar": "ٱلَّي