[{"id": 1, "key": "63:1", "juz": 28, "page": 554, "side_trans": "When the hypocrites come to you, [O Muḥammad], they say, \"We testify that you are the Messenger of Allāh.\" And Allāh knows that you are His Messenger, and Allāh testifies that the hypocrites are liars.", "words": [{"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/063_001_001.mp3"}, {"type": "word", "ar": "جَآءَكَ", "tajweed": "ج<rule class=madda_obligatory_mottasel>َا</rule>ٓءَكَ", "en": "come to you", "tr": "jāaka", "audio": "wbw/063_001_002.mp3"}, {"type": "word", "ar": "ٱلْمُنَـٰفِقُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُنَ<rule class=madda_normal>ـٰ</rule>فِقُونَ", "en": "the hypocrites", "tr": "l-munāfiqūna", "audio": "wbw/063_001_003.mp3"}, {"type": "word", "ar": "قَالُوا۟", "tajweed": "قَالُو<rule class=slnt>اۡ</rule>", "en": "they say", "tr": "qālū", "audio": "wbw/063_001_004.mp3"}, {"type": "word", "ar": "نَشْهَدُ", "tajweed": "نَشۡهَدُ", "en": "We testify", "tr": "nashhadu", "audio": "wbw/063_001_005.mp3"}, {"type": "word", "ar": "إِنَّكَ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َكَ", "en": "that you", "tr": "innaka", "audio": "wbw/063_001_006.mp3"}, {"type": "word", "ar": "لَرَسُولُ", "tajweed": "لَرَسُولُ", "en": "(are) surely (the) Messenger", "tr": "larasūlu", "audio": "wbw/063_001_007.mp3"}, {"type": "word", "ar": "ٱللَّهِ ۗ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ‌ۗ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/063_001_008.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/063_001_010.mp3"}, {"type": "word", "ar": "يَعْلَمُ", "tajweed": "يَعۡلَمُ", "en": "knows", "tr": "yaʿlamu", "audio": "wbw/063_001_011.mp3"}, {"type": "word", "ar": "إِنَّكَ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َكَ", "en": "that you", "tr": "innaka", "audio": "wbw/063_001_012.mp3"}, {"type": "word", "ar": "لَرَسُولُهُۥ", "tajweed": "لَرَسُولُهُ<rule class=madda_normal>ۥ</rule>", "en": "(are) surely His Messenger", "tr": "larasūluhu", "audio": "wbw/063_001_013.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "and Allah", "tr": "wal-lahu", "audio": "wbw/063_001_014.mp3"}, {"type": "word", "ar": "يَشْهَدُ", "tajweed": "يَشۡهَدُ", "en": "testifies", "tr": "yashhadu", "audio": "wbw/063_001_015.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "that", "tr": "inna", "audio": "wbw/063_001_016.mp3"}, {"type": "word", "ar": "ٱلْمُنَـٰفِقِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُنَ<rule class=madda_normal>ـٰ</rule>فِقِينَ", "en": "the hypocrites", "tr": "l-munāfiqīna", "audio": "wbw/063_001_017.mp3"}, {"type": "word", "ar": "لَكَـٰذِبُونَ", "tajweed": "لَكَ<rule class=madda_normal>ـٰ</rule>ذِب<rule class=madda_permissible>ُو</rule>نَ", "en": "(are) surely liars", "tr": "lakādhibūna", "audio": "wbw/063_001_018.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "63:2", "juz": 28, "page": 554, "side_trans": "They have taken their oaths as a cover, so they averted [people] from the way of Allāh. Indeed, it was evil that they were doing.", "words": [{"type": "word", "ar": "ٱتَّخَذُوٓا۟", "tajweed": "ٱتَّخَذ<rule class=madda_obligatory_mottasel>ُوٓ</rule><rule class=slnt>اۡ</rule>", "en": "They take", "tr": "ittakhadhū", "audio": "wbw/063_002_001.mp3"}, {"type": "word", "ar": "أَيْمَـٰنَهُمْ", "tajweed": "أَيۡمَ<rule class=madda_normal>ـٰ</rule>نَهُمۡ", "en": "their oaths", "tr": "aymānahum", "audio": "wbw/063_002_002.mp3"}, {"type": "word", "ar": "جُنَّةًۭ", "tajweed": "جُ<rule class=ghunnah>نّ</rule>َ<rule class=ikhafa>ةً</rule>", "en": "(as) a cover", "tr": "junnatan", "audio": "wbw/063_002_003.mp3"}, {"type": "word", "ar": "فَصَدُّوا۟", "tajweed": "<rule class=ikhafa>ف</rule>َصَدُّو<rule class=slnt>اۡ</rule>", "en": "so they turn away", "tr": "faṣaddū", "audio": "wbw/063_002_004.mp3"}, {"type": "word", "ar": "عَن", "tajweed": "عَ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "ʿan", "audio": "wbw/063_002_005.mp3"}, {"type": "word", "ar": "سَبِيلِ", "tajweed": "<rule class=ikhafa>س</rule>َبِيلِ", "en": "(the) Way", "tr": "sabīli", "audio": "wbw/063_002_006.mp3"}, {"type": "word", "ar": "ٱللَّهِ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ‌ۚ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/063_002_007.mp3"}, {"type": "word", "ar": "إِنَّهُمْ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "Indeed, [they]", "tr": "innahum", "audio": "wbw/063_002_009.mp3"}, {"type": "word", "ar": "سَآءَ", "tajweed": "س<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "evil is", "tr": "sāa", "audio": "wbw/063_002_010.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/063_002_011.mp3"}, {"type": "word", "ar": "كَانُوا۟", "tajweed": "كَانُو<rule class=slnt>اۡ</rule>", "en": "they used to", "tr": "kānū", "audio": "wbw/063_002_012.mp3"}, {"type": "word", "ar": "يَعْمَلُونَ", "tajweed": "يَعۡمَل<rule class=madda_permissible>ُو</rule>نَ", "en": "do", "tr": "yaʿmalūna", "audio": "wbw/063_002_013.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "63:3", "juz": 28, "page": 554, "side_trans": "That is because they believed, and then they disbelieved; so their hearts were sealed over, and they do not understand.", "words": [{"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "That", "tr": "dhālika", "audio": "wbw/063_003_001.mp3"}, {"type": "word", "ar": "بِأَنَّهُمْ", "tajweed": "بِأَ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "(is) because", "tr": "bi-annahum", "audio": "wbw/063_003_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "they believed", "tr": "āmanū", "audio": "wbw/063_003_003.mp3"}, {"type": "word", "ar": "ثُمَّ", "tajweed": "ثُ<rule class=ghunnah>مّ</rule>َ", "en": "then", "tr": "thumma", "audio": "wbw/063_003_004.mp3"}, {"type": "word", "ar": "كَفَرُوا۟", "tajweed": "كَفَرُو<rule class=slnt>اۡ</rule>", "en": "they disbelieved", "tr": "kafarū", "audio": "wbw/063_003_005.mp3"}, {"type": "word", "ar": "فَطُبِعَ", "tajweed": "فَطُبِعَ", "en": "so were sealed", "tr": "faṭubiʿa", "audio": "wbw/063_003_006.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "[upon]", "tr": "ʿalā", "audio": "wbw/063_003_007.mp3"}, {"type": "word", "ar": "قُلُوبِهِمْ", "tajweed": "قُلُوبِهِمۡ", "en": "their hearts", "tr": "qulūbihim", "audio": "wbw/063_003_008.mp3"}, {"type": "word", "ar": "فَهُمْ", "tajweed": "فَهُمۡ", "en": "so they", "tr": "fahum", "audio": "wbw/063_003_009.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(do) not", "tr": "lā", "audio": "wbw/063_003_010.mp3"}, {"type": "word", "ar": "يَفْقَهُونَ", "tajweed": "يَفۡقَه<rule class=madda_permissible>ُو</rule>نَ", "en": "understand", "tr": "yafqahūna", "audio": "wbw/063_003_011.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "63:4", "juz": 28, "page": 554, "side_trans": "And when you see them, their forms please you, and if they speak, you listen to their speech. [They are] as if they were pieces of wood propped up - they think that every shout is against them. They are the enemy, so beware of them. May Allāh destroy them; how are they deluded?", "words": [{"type": "word", "ar": "۞ وَإِذَا", "tajweed": "۞وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/063_004_002.mp3"}, {"type": "word", "ar": "رَأَيْتَهُمْ", "tajweed": "رَأَيۡتَهُمۡ", "en": "you see them", "tr": "ra-aytahum", "audio": "wbw/063_004_003.mp3"}, {"type": "word", "ar": "تُعْجِبُكَ", "tajweed": "تُعۡجِبُكَ", "en": "pleases you", "tr": "tuʿ'jibuka", "audio": "wbw/063_004_004.mp3"}, {"type": "word", "ar": "أَجْسَامُهُمْ ۖ", "tajweed": "أَ<rule class=qalaqah>جۡ</rule>سَامُهُمۡ‌ۖ", "en": "their bodies", "tr": "ajsāmuhum", "audio": "wbw/063_004_005.mp3"}, {"type": "word", "ar": "وَإِن", "tajweed": "وَإ<rule class=idgham_ghunnah>ِن</rule>", "en": "and if", "tr": "wa-in", "audio": "wbw/063_004_007.mp3"}, {"type": "word", "ar": "يَقُولُوا۟", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َقُولُو<rule class=slnt>اۡ</rule>", "en": "they speak", "tr": "yaqūlū", "audio": "wbw/063_004_008.mp3"}, {"type": "word", "ar": "تَسْمَعْ", "tajweed": "تَسۡمَعۡ", "en": "you listen", "tr": "tasmaʿ", "audio": "wbw/063_004_009.mp3"}, {"type": "word", "ar": "لِقَوْلِهِمْ ۖ", "tajweed": "لِقَوۡلِهِمۡ‌ۖ", "en": "to their speech", "tr": "liqawlihim", "audio": "wbw/063_004_010.mp3"}, {"type": "word", "ar": "كَأَنَّهُمْ", "tajweed": "كَأَ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "as if they (were)", "tr": "ka-annahum", "audio": "wbw/063_004_012.mp3"}, {"type": "word", "ar": "خُشُبٌۭ", "tajweed": "خُشُ<rule class=idgham_ghunnah>بٌ</rule>", "en": "pieces of wood", "tr": "khushubun", "audio": "wbw/063_004_013.mp3"}, {"type": "word", "ar": "مُّسَنَّدَةٌۭ ۖ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّسَ<rule class=ghunnah>نّ</rule>َدَ<rule class=idgham_ghunnah>ةٌ‌ۖ</rule>", "en": "propped up", "tr": "musannadatun", "audio": "wbw/063_004_014.mp3"}, {"type": "word", "ar": "يَحْسَبُونَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َحۡسَبُونَ", "en": "They think", "tr": "yaḥsabūna", "audio": "wbw/063_004_016.mp3"}, {"type": "word", "ar": "كُلَّ", "tajweed": "كُلَّ", "en": "every", "tr": "kulla", "audio": "wbw/063_004_017.mp3"}, {"type": "word", "ar": "صَيْحَةٍ", "tajweed": "صَيۡحَةٍ", "en": "shout", "tr": "ṣayḥatin", "audio": "wbw/063_004_018.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ ۚ", "tajweed": "عَلَيۡهِمۡ‌ۚ", "en": "(is) against them", "tr": "ʿalayhim", "audio": "wbw/063_004_019.mp3"}, {"type": "word", "ar": "هُمُ", "tajweed": "هُمُ", "en": "They", "tr": "humu", "audio": "wbw/063_004_021.mp3"}, {"type": "word", "ar": "ٱلْعَدُوُّ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَدُوُّ", "en": "(are) the enemy", "tr": "l-ʿaduwu", "audio": "wbw/063_004_022.mp3"}, {"type": "word", "ar": "فَٱحْذَرْهُمْ ۚ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>حۡذَرۡهُمۡ‌ۚ", "en": "so beware of them", "tr": "fa-iḥ'dharhum", "audio": "wbw/063_004_023.mp3"}, {"type": "word", "ar": "قَـٰتَلَهُمُ", "tajweed": "قَ<rule class=madda_normal>ـٰ</rule>تَلَهُمُ", "en": "May destroy them", "tr": "qātalahumu", "audio": "wbw/063_004_025.mp3"}, {"type": "word", "ar": "ٱللَّهُ ۖ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ‌ۖ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/063_004_026.mp3"}, {"type": "word", "ar": "أَنَّىٰ", "tajweed": "أَ<rule class=ghunnah>نّ</rule>َىٰ", "en": "How", "tr": "annā", "audio": "wbw/063_004_028.mp3"}, {"type": "word", "ar": "يُؤْفَكُونَ", "tajweed": "يُؤۡفَك<rule class=madda_permissible>ُو</rule>نَ", "en": "are they deluded", "tr": "yu'fakūna", "audio": "wbw/063_004_029.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "63:5", "juz": 28, "page": 555, "side_trans": "And when it is said to them, \"Come, the Messenger of Allāh will ask forgiveness for you,\" they turn their heads aside and you see them evading while they are arrogant.", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/063_005_001.mp3"}, {"type": "word", "ar": "قِيلَ", "tajweed": "قِيلَ", "en": "it is said", "tr": "qīla", "audio": "wbw/063_005_002.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "to them", "tr": "lahum", "audio": "wbw/063_005_003.mp3"}, {"type": "word", "ar": "تَعَالَوْا۟", "tajweed": "تَعَالَوۡ<rule class=slnt>اۡ</rule>", "en": "Come", "tr": "taʿālaw", "audio": "wbw/063_005_004.mp3"}, {"type": "word", "ar": "يَسْتَغْفِرْ", "tajweed": "يَسۡتَغۡفِرۡ", "en": "will ask forgiveness", "tr": "yastaghfir", "audio": "wbw/063_005_005.mp3"}, {"type": "word", "ar": "لَكُمْ", "tajweed": "لَكُمۡ", "en": "for you", "tr": "lakum", "audio": "wbw/063_005_006.mp3"}, {"type": "word", "ar": "رَسُولُ", "tajweed": "رَسُولُ", "en": "(the) Messenger", "tr": "rasūlu", "audio": "wbw/063_005_007.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/063_005_008.mp3"}, {"type": "word", "ar": "لَوَّوْا۟", "tajweed": "لَوَّوۡ<rule class=slnt>اۡ</rule>", "en": "They turn aside", "tr": "lawwaw", "audio": "wbw/063_005_009.mp3"}, {"type": "word", "ar": "رُءُوسَهُمْ", "tajweed": "رُءُوسَهُمۡ", "en": "their heads", "tr": "ruūsahum", "audio": "wbw/063_005_010.mp3"}, {"type": "word", "ar": "وَرَأَيْتَهُمْ", "tajweed": "وَرَأَيۡتَهُمۡ", "en": "and you see them", "tr": "wara-aytahum", "audio": "wbw/063_005_011.mp3"}, {"type": "word", "ar": "يَصُدُّونَ", "tajweed": "يَصُدُّونَ", "en": "turning away", "tr": "yaṣuddūna", "audio": "wbw/063_005_012.mp3"}, {"type": "word", "ar": "وَهُم", "tajweed": "وَه<rule class=idgham_shafawi>ُم</rule>", "en": "while they", "tr": "wahum", "audio": "wbw/063_005_013.mp3"}, {"type": "word", "ar": "مُّسْتَكْبِرُونَ", "tajweed": "<rule class=idgham_shafawi>م</rule>ُّسۡتَكۡبِر<rule class=madda_permissible>ُو</rule>نَ", "en": "(are) arrogant", "tr": "mus'takbirūna", "audio": "wbw/063_005_014.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "63:6", "juz": 28, "page": 555, "side_trans": "It is all the same for them whether you ask forgiveness for them or do not ask forgiveness for them; never will Allāh forgive them. Indeed, Allāh does not guide the defiantly disobedient people.", "words": [{"type": "word", "ar": "سَوَآءٌ", "tajweed": "سَو<rule class=madda_obligatory_mottasel>َا</rule>ٓءٌ", "en": "(It) is same", "tr": "sawāon", "audio": "wbw/063_006_001.mp3"}, {"type": "word", "ar": "عَلَيْهِمْ", "tajweed": "عَلَيۡهِمۡ", "en": "for them", "tr": "ʿalayhim", "audio": "wbw/063_006_002.mp3"}, {"type": "word", "ar": "أَسْتَغْفَرْتَ", "tajweed": "أَسۡتَغۡفَرۡتَ", "en": "whether you ask forgiveness", "tr": "astaghfarta", "audio": "wbw/063_006_003.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "for them", "tr": "lahum", "audio": "wbw/063_006_004.mp3"}, {"type": "word", "ar": "أَمْ", "tajweed": "أَمۡ", "en": "or", "tr": "am", "audio": "wbw/063_006_005.mp3"}, {"type": "word", "ar": "لَمْ", "tajweed": "لَمۡ", "en": "(do) not", "tr": "lam", "audio": "wbw/063_006_006.mp3"}, {"type": "word", "ar": "تَسْتَغْفِرْ", "tajweed": "تَسۡتَغۡفِرۡ", "en": "ask forgiveness", "tr": "tastaghfir", "audio": "wbw/063_006_007.mp3"}, {"type": "word", "ar": "لَهُمْ", "tajweed": "لَهُمۡ", "en": "for them", "tr": "lahum", "audio": "wbw/063_006_008.mp3"}, {"type": "word", "ar": "لَن", "tajweed": "ل<rule class=idgham_ghunnah>َن</rule>", "en": "Never", "tr": "lan", "audio": "wbw/063_006_009.mp3"}, {"type": "word", "ar": "يَغْفِرَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َغۡفِرَ", "en": "will forgive", "tr": "yaghfira", "audio": "wbw/063_006_010.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "Allah", "tr": "l-lahu", "audio": "wbw/063_006_011.mp3"}, {"type": "word", "ar": "لَهُمْ ۚ", "tajweed": "لَهُمۡ‌ۚ", "en": "[to] them", "tr": "lahum", "audio": "wbw/063_006_012.mp3"}, {"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/063_006_014.mp3"}, {"type": "word", "ar": "ٱللَّهَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهَ", "en": "Allah", "tr": "l-laha", "audio": "wbw/063_006_015.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(does) not", "tr": "lā", "audio": "wbw/063_006_016.mp3"}, {"type": "word", "ar": "يَهْدِى", "tajweed": "يَهۡدِى", "en": "guide", "tr": "yahdī", "audio": "wbw/063_006_017.mp3"}, {"type": "word", "ar": "ٱلْقَوْمَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَوۡمَ", "en": "the people", "tr": "l-qawma", "audio": "wbw/063_006_018.mp3"}, {"type": "word", "ar": "ٱلْفَـٰسِقِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَ<rule class=madda_normal>ـٰ</rule>سِق<rule class=madda_permissible>ِي</rule>نَ", "en": "the defiantly disobedient", "tr": "l-fāsiqīna", "audio": "wbw/063_006_019.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "63:7", "juz": 28, "page": 555, "side_trans": "They are the ones who say, \"Do not spend on those who are with the Messenger of Allāh until they disband.\" And to Allāh belong the depositories of the heavens and the earth, but the hypocrites do not understand.", "words": [{"type": "word", "ar": "هُمُ", "tajweed": "هُمُ", "en": "They", "tr": "humu", "audio": "wbw/063_007_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "(are) those who", "tr": "alladhīna", "audio": "wbw/063_007_002.mp3"}, {"type": "word", "ar": "يَقُولُونَ", "tajweed": "يَقُولُونَ", "en": "say", "tr": "yaqūlūna", "audio": "wbw/063_007_003.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(Do) not", "tr": "lā", "audio": "wbw/063_007_004.mp3"}, {"type": "word", "ar": "تُنفِقُوا۟", "tajweed": "تُ<rule class=ikhafa>نف</rule>ِقُو<rule class=slnt>اۡ</rule>", "en": "spend", "tr": "tunfiqū", "audio": "wbw/063_007_005.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "on", "tr": "ʿalā", "audio": "wbw/063_007_006.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "(those) who", "tr": "man", "audio": "wbw/063_007_007.mp3"}, {"type": "word", "ar": "عِندَ", "tajweed": "عِ<rule class=ikhafa>ند</rule>َ", "en": "(are) with", "tr": "ʿinda", "audio": "wbw/063_007_008.mp3"}, {"type": "word", "ar": "رَسُولِ", "tajweed": "رَسُولِ", "en": "(the) Messenger", "tr": "rasūli", "audio": "wbw/063_007_009.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/063_007_010.mp3"}, {"type": "word", "ar": "حَتَّىٰ", "tajweed": "حَتَّىٰ", "en": "until", "tr": "ḥattā", "audio": "wbw/063_007_011.mp3"}, {"type": "word", "ar": "يَنفَضُّوا۟ ۗ", "tajweed": "يَ<rule class=ikhafa>نف</rule>َضُّو<rule class=slnt>اۡ‌ۗ</rule>", "en": "they disband", "tr": "yanfaḍḍū", "audio": "wbw/063_007_012.mp3"}, {"type": "word", "ar": "وَلِلَّهِ", "tajweed": "وَلِلَّهِ", "en": "And for Allah", "tr": "walillahi", "audio": "wbw/063_007_014.mp3"}, {"type": "word", "ar": "خَزَآئِنُ", "tajweed": "خَز<rule class=madda_obligatory_mottasel>َا</rule>ٓئِنُ", "en": "(are the) treasures", "tr": "khazāinu", "audio": "wbw/063_007_015.mp3"}, {"type": "word", "ar": "ٱلسَّمَـٰوَٰتِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّمَ<rule class=madda_normal>ـٰ</rule>و<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِ", "en": "(of) the heavens", "tr": "l-samāwāti", "audio": "wbw/063_007_016.mp3"}, {"type": "word", "ar": "وَٱلْأَرْضِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "and the earth", "tr": "wal-arḍi", "audio": "wbw/063_007_017.mp3"}, {"type": "word", "ar": "وَلَـٰكِنَّ", "tajweed": "وَلَ<rule class=madda_normal>ـٰ</rule>كِ<rule class=ghunnah>نّ</rule>َ", "en": "but", "tr": "walākinna", "audio": "wbw/063_007_018.mp3"}, {"type": "word", "ar": "ٱلْمُنَـٰفِقِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُنَ<rule class=madda_normal>ـٰ</rule>فِقِينَ", "en": "the hypocrites", "tr": "l-munāfiqīna", "audio": "wbw/063_007_019.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(do) not", "tr": "lā", "audio": "wbw/063_007_020.mp3"}, {"type": "word", "ar": "يَفْقَهُونَ", "tajweed": "يَفۡقَه<rule class=madda_permissible>ُو</rule>نَ", "en": "understand", "tr": "yafqahūna", "audio": "wbw/063_007_021.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "63:8", "juz": 28, "page": 555, "side_trans": "They say, \"If we return to al-Madīnah, the more honored [for power] will surely expel therefrom the more humble.\" And to Allāh belongs [all] honor, and to His Messenger, and to the believers, but the hypocrites do not know.", "words": [{"type": "word", "ar": "يَقُولُونَ", "tajweed": "يَقُولُونَ", "en": "They say", "tr": "yaqūlūna", "audio": "wbw/063_008_001.mp3"}, {"type": "word", "ar": "لَئِن", "tajweed": "لَئ<rule class=idgham_wo_ghunnah>ِن</rule>", "en": "If", "tr": "la-in", "audio": "wbw/063_008_002.mp3"}, {"type": "word", "ar": "رَّجَعْنَآ", "tajweed": "<rule class=idgham_wo_ghunnah>ر</rule>َّجَعۡن<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "we return", "tr": "rajaʿnā", "audio": "wbw/063_008_003.mp3"}, {"type": "word", "ar": "إِلَى", "tajweed": "إِلَى", "en": "to", "tr": "ilā", "audio": "wbw/063_008_004.mp3"}, {"type": "word", "ar": "ٱلْمَدِينَةِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَدِينَةِ", "en": "Al-Madinah", "tr": "l-madīnati", "audio": "wbw/063_008_005.mp3"}, {"type": "word", "ar": "لَيُخْرِجَنَّ", "tajweed": "لَيُخۡرِجَ<rule class=ghunnah>نّ</rule>َ", "en": "surely, will expel", "tr": "layukh'rijanna", "audio": "wbw/063_008_006.mp3"}, {"type": "word", "ar": "ٱلْأَعَزُّ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَعَزُّ", "en": "the more honorable", "tr": "l-aʿazu", "audio": "wbw/063_008_007.mp3"}, {"type": "word", "ar": "مِنْهَا", "tajweed": "مِنۡهَا", "en": "from it", "tr": "min'hā", "audio": "wbw/063_008_008.mp3"}, {"type": "word", "ar": "ٱلْأَذَلَّ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَذَلَّ‌ۚ", "en": "the more humble", "tr": "l-adhala", "audio": "wbw/063_008_009.mp3"}, {"type": "word", "ar": "وَلِلَّهِ", "tajweed": "وَلِلَّهِ", "en": "But for Allah", "tr": "walillahi", "audio": "wbw/063_008_011.mp3"}, {"type": "word", "ar": "ٱلْعِزَّةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعِزَّةُ", "en": "(is) the honor", "tr": "l-ʿizatu", "audio": "wbw/063_008_012.mp3"}, {"type": "word", "ar": "وَلِرَسُولِهِۦ", "tajweed": "وَلِرَسُولِه<rule class=madda_normal>ِۦ</rule>", "en": "and for His Messenger", "tr": "walirasūlihi", "audio": "wbw/063_008_013.mp3"}, {"type": "word", "ar": "وَلِلْمُؤْمِنِينَ", "tajweed": "وَلِلۡمُؤۡمِنِينَ", "en": "and for the believers", "tr": "walil'mu'minīna", "audio": "wbw/063_008_014.mp3"}, {"type": "word", "ar": "وَلَـٰكِنَّ", "tajweed": "وَلَ<rule class=madda_normal>ـٰ</rule>كِ<rule class=ghunnah>نّ</rule>َ", "en": "but", "tr": "walākinna", "audio": "wbw/063_008_015.mp3"}, {"type": "word", "ar": "ٱلْمُنَـٰفِقِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُنَ<rule class=madda_normal>ـٰ</rule>فِقِينَ", "en": "the hypocrites", "tr": "l-munāfiqīna", "audio": "wbw/063_008_016.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(do) not", "tr": "lā", "audio": "wbw/063_008_017.mp3"}, {"type": "word", "ar": "يَعْلَمُونَ", "tajweed": "يَعۡلَم<rule class=madda_permissible>ُو</rule>نَ", "en": "know", "tr": "yaʿlamūna", "audio": "wbw/063_008_018.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "63:9", "juz": 28, "page": 555, "side_trans": "O you who have believed, let not your wealth and your children divert you from the remembrance of Allāh. And whoever does that - then those are the losers.", "words": [{"type": "word", "ar": "يَـٰٓأَيُّهَا", "tajweed": "يَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>أَيُّهَا", "en": "O", "tr": "yāayyuhā", "audio": "wbw/063_009_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "you (who)", "tr": "alladhīna", "audio": "wbw/063_009_002.mp3"}, {"type": "word", "ar": "ءَامَنُوا۟", "tajweed": "ءَامَنُو<rule class=slnt>اۡ</rule>", "en": "believe", "tr": "āmanū", "audio": "wbw/063_009_003.mp3"}, {"type": "word", "ar": "لَا", "tajweed": "لَا", "en": "(Let) not", "tr": "lā", "audio": "wbw/063_009_004.mp3"}, {"type": "word", "ar": "تُلْهِكُمْ", "tajweed": "تُلۡهِكُمۡ", "en": "divert you", "tr": "tul'hikum", "audio": "wbw/063_009_005.mp3"}, {"type": "word", "ar": "أَمْوَٰلُكُمْ", "tajweed": "أَمۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لُكُمۡ", "en": "your wealth", "tr": "amwālukum", "audio": "wbw/063_009_006.mp3"}, {"type": "word", "ar": "وَلَآ", "tajweed": "وَل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "and not", "tr": "walā", "audio": "wbw/063_009_007.mp3"}, {"type": "word", "ar": "أَوْلَـٰدُكُمْ", "tajweed": "أَوۡلَ<rule class=madda_normal>ـٰ</rule>دُكُمۡ", "en": "your children", "tr": "awlādukum", "audio": "wbw/063_009_008.mp3"}, {"type": "word", "ar": "عَن", "tajweed": "عَ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "ʿan", "audio": "wbw/063_009_009.mp3"}, {"type": "word", "ar": "ذِكْرِ", "tajweed": "<rule class=ikhafa>ذ</rule>ِكۡرِ", "en": "(the) remembrance", "tr": "dhik'ri", "audio": "wbw/063_009_010.mp3"}, {"type": "word", "ar": "ٱللَّهِ ۚ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ‌ۚ", "en": "(of) Allah", "tr": "l-lahi", "audio": "wbw/063_009_011.mp3"}, {"type": "word", "ar": "وَمَن", "tajweed": "وَم<rule class=idgham_ghunnah>َن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/063_009_013.mp3"}, {"type": "word", "ar": "يَفْعَلْ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َفۡعَلۡ", "en": "does", "tr": "yafʿal", "audio": "wbw/063_009_014.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "that", "tr": "dhālika", "audio": "wbw/063_009_015.mp3"}, {"type": "word", "ar": "فَأُو۟لَـٰٓئِكَ", "tajweed": "فَأُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَ", "en": "then those", "tr": "fa-ulāika", "audio": "wbw/063_009_016.mp3"}, {"type": "word", "ar": "هُمُ", "tajweed": "هُمُ", "en": "[they]", "tr": "humu", "audio": "wbw/063_009_017.mp3"}, {"type": "word", "ar": "ٱلْخَـٰسِرُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡخَ<rule class=madda_normal>ـٰ</rule>سِر<rule class=madda_permissible>ُو</rule>نَ", "en": "(are) the losers", "tr": "l-khāsirūna", "audio": "wbw/063_009_018.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "63:10", "juz": 28, "page": 555, "side_trans": "And spend [in the way of Allāh] from what We have provided you before death approaches one of you and he says, \"My Lord, if only You would delay me for a brief term so I would give charity and be of the righteous.\"", "words": [{"type": "word", "ar": "وَأَنفِقُوا۟", "tajweed": "وَأَ<rule class=ikhafa>نف</rule>ِقُو<rule class=slnt>اۡ</rule>", "en": "And spend", "tr": "wa-anfiqū", "audio": "wbw/063_010_001.mp3"}, {"type": "word", "ar": "مِن", "tajweed": "م<rule class=idgham_ghunnah>ِن</rule>", "en": "from", "tr": "min", "audio": "wbw/063_010_002.mp3"}, {"type": "word", "ar": "مَّا", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّا", "en": "what", "tr": "mā", "audio": "wbw/063_010_003.mp3"}, {"type": "word", "ar": "رَزَقْنَـٰكُم", "tajweed": "رَزَ<rule class=qalaqah>قۡ</rule>نَ<rule class=madda_normal>ـٰ</rule>ك<rule class=idgham_shafawi>ُم</rule>", "en": "We have provided you", "tr": "razaqnākum", "audio": "wbw/063_010_004.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_shafawi>م</rule>ِّ<rule class=ikhafa>ن</rule>", "en": "from", "tr": "min", "audio": "wbw/063_010_005.mp3"}, {"type": "word", "ar": "قَبْلِ", "tajweed": "<rule class=ikhafa>ق</rule>َ<rule class=qalaqah>بۡ</rule>لِ", "en": "before", "tr": "qabli", "audio": "wbw/063_010_006.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "[that]", "tr": "an", "audio": "wbw/063_010_007.mp3"}, {"type": "word", "ar": "يَأْتِىَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>َأۡتِىَ", "en": "comes", "tr": "yatiya", "audio": "wbw/063_010_008.mp3"}, {"type": "word", "ar": "أَحَدَكُمُ", "tajweed": "أَحَدَكُمُ", "en": "(to) one of you", "tr": "aḥadakumu", "audio": "wbw/063_010_009.mp3"}, {"type": "word", "ar": "ٱلْمَوْتُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَوۡتُ", "en": "the death", "tr": "l-mawtu", "audio": "wbw/063_010_010.mp3"}, {"type": "word", "ar": "فَيَقُولَ", "tajweed": "فَيَقُولَ", "en": "and he says", "tr": "fayaqūla", "audio": "wbw/063_010_011.mp3"}, {"type": "word", "ar": "رَبِّ", "tajweed": "رَبِّ", "en": "My Lord", "tr": "rabbi", "audio": "wbw/063_010_012.mp3"}, {"type": "word", "ar": "لَوْلَآ", "tajweed": "لَوۡل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Why not", "tr": "lawlā", "audio": "wbw/063_010_013.mp3"}, {"type": "word", "ar": "أَخَّرْتَنِىٓ", "tajweed": "أَخَّرۡتَن<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "You delay me", "tr": "akhartanī", "audio": "wbw/063_010_014.mp3"}, {"type": "word", "ar": "إِلَىٰٓ", "tajweed": "إِلَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "for", "tr": "ilā", "audio": "wbw/063_010_015.mp3"}, {"type": "word", "ar": "أَجَلٍۢ", "tajweed": "أَجَ<rule class=ikhafa>لٍ</rule>", "en": "a term", "tr": "ajalin", "audio": "wbw/063_010_016.mp3"}, {"type": "word", "ar": "قَرِيبٍۢ", "tajweed": "<rule class=ikhafa>ق</rule>َرِي<rule class=ikhafa>بٍ</rule>", "en": "near", "tr": "qarībin", "audio": "wbw/063_010_017.mp3"}, {"type": "word", "ar": "فَأَصَّدَّقَ", "tajweed": "<rule class=ikhafa>ف</rule>َأَصَّدَّقَ", "en": "so I would give charity", "tr": "fa-aṣṣaddaqa", "audio": "wbw/063_010_018.mp3"}, {"type": "word", "ar": "وَأَكُن", "tajweed": "وَأَك<rule class=idgham_ghunnah>ُن</rule>", "en": "and be", "tr": "wa-akun", "audio": "wbw/063_010_019.mp3"}, {"type": "word", "ar": "مِّنَ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنَ", "en": "among", "tr": "mina", "audio": "wbw/063_010_020.mp3"}, {"type": "word", "ar": "ٱلصَّـٰلِحِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>صَّ<rule class=madda_normal>ـٰ</rule>لِح<rule class=madda_permissible>ِي</rule>نَ", "en": "the righteous", "tr": "l-ṣāliḥīna", "audio": "wbw/063_010_021.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "63:11", "juz": 28, "page": 555, "side_trans": "But never will Allāh delay a soul when its time has come. And Allāh is Aware of what you do.", "words": [{"type": "word", "ar": "وَلَن", "tajweed": "وَل<rule class=idgham_ghunnah>َن</rule>", "en": "But never", "tr": "walan", "audio": "wbw/063_011_001.mp3"}, {"type": "word", "ar": "يُؤَخِّرَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُؤَخِّرَ", "en": "will (be) delayed", "tr": "yu-akhira", "audio": "wbw/063_011_002.mp3"}, {"type": "word", "ar": "ٱللَّهُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "(by) Allah", "tr": "l-lahu", "audio": "wbw/063_011_003.mp3"}, {"type": "word", "ar": "نَفْسًا", "tajweed": "نَفۡسًا", "en": "a soul", "tr": "nafsan", "audio": "wbw/063_011_004.mp3"}, {"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "when", "tr": "idhā", "audio": "wbw/063_011_005.mp3"}, {"type": "word", "ar": "جَآءَ", "tajweed": "ج<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "has come", "tr": "jāa", "audio": "wbw/063_011_006.mp3"}, {"type": "word", "ar": "أَجَلُهَا ۚ", "tajweed": "أَجَلُهَا‌ۚ", "en": "its term", "tr": "ajaluhā", "audio": "wbw/063_011_007.mp3"}, {"type": "word", "ar": "وَٱللَّهُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>للَّهُ", "en": "And Allah", "tr": "wal-lahu", "audio": "wbw/063_011_009.mp3"}, {"type": "word", "ar": "خَبِيرٌۢ", "tajweed": "خَبِي<rule class=iqlab>رُۢ</rule>", "en": "(is) All-Aware", "tr": "khabīrun", "audio": "wbw/063_011_010.mp3"}, {"type": "word", "ar": "بِمَا", "tajweed": "<rule class=iqlab>ب</rule>ِمَا", "en": "of what", "tr": "bimā", "audio": "wbw/063_011_011.mp3"}, {"type": "word", "ar": "تَعْمَلُونَ", "tajweed": "تَعۡمَل<rule class=madda_permissible>ُو</rule>نَ", "en": "you do", "tr": "taʿmalūna", "audio": "wbw/063_011_012.mp3"}, {"type": "end", "num": "١١"}]}]