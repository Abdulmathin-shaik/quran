[{"id": 1, "key": "70:1", "juz": 29, "page": 568, "side_trans": "A supplicant asked for a punishment bound to happen", "words": [{"type": "word", "ar": "سَأَلَ", "tajweed": "سَأَلَ", "en": "Asked", "tr": "sa-ala", "audio": "wbw/070_001_001.mp3"}, {"type": "word", "ar": "سَآئِلٌۢ", "tajweed": "س<rule class=madda_obligatory_mottasel>َا</rule>ٓئِ<rule class=iqlab>لُۢ</rule>", "en": "a questioner", "tr": "sāilun", "audio": "wbw/070_001_002.mp3"}, {"type": "word", "ar": "بِعَذَابٍۢ", "tajweed": "<rule class=iqlab>ب</rule>ِعَذَا<rule class=idgham_ghunnah>بٍ</rule>", "en": "about a punishment", "tr": "biʿadhābin", "audio": "wbw/070_001_003.mp3"}, {"type": "word", "ar": "وَاقِعٍۢ", "tajweed": "<rule class=idgham_ghunnah>و</rule>َاقِعٍ", "en": "bound to happen", "tr": "wāqiʿin", "audio": "wbw/070_001_004.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "70:2", "juz": 29, "page": 568, "side_trans": "To the disbelievers; of it there is no preventer.", "words": [{"type": "word", "ar": "لِّلْكَـٰفِرِينَ", "tajweed": "لِّلۡكَ<rule class=madda_normal>ـٰ</rule>فِرِينَ", "en": "To the disbelievers", "tr": "lil'kāfirīna", "audio": "wbw/070_002_001.mp3"}, {"type": "word", "ar": "لَيْسَ", "tajweed": "لَيۡسَ", "en": "not", "tr": "laysa", "audio": "wbw/070_002_002.mp3"}, {"type": "word", "ar": "لَهُۥ", "tajweed": "لَهُ<rule class=madda_normal>ۥ</rule>", "en": "of it", "tr": "lahu", "audio": "wbw/070_002_003.mp3"}, {"type": "word", "ar": "دَافِعٌۭ", "tajweed": "دَافِعٌ", "en": "any preventer", "tr": "dāfiʿun", "audio": "wbw/070_002_004.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "70:3", "juz": 29, "page": 568, "side_trans": "[It is] from Allāh, owner of the ways of ascent.", "words": [{"type": "word", "ar": "مِّنَ", "tajweed": "مِّنَ", "en": "From", "tr": "mina", "audio": "wbw/070_003_001.mp3"}, {"type": "word", "ar": "ٱللَّهِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>للَّهِ", "en": "Allah", "tr": "l-lahi", "audio": "wbw/070_003_002.mp3"}, {"type": "word", "ar": "ذِى", "tajweed": "ذِى", "en": "Owner", "tr": "dhī", "audio": "wbw/070_003_003.mp3"}, {"type": "word", "ar": "ٱلْمَعَارِجِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَعَارِ<rule class=qalaqah>ج</rule>ِ", "en": "(of) the ways of ascent", "tr": "l-maʿāriji", "audio": "wbw/070_003_004.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "70:4", "juz": 29, "page": 568, "side_trans": "The angels and the Spirit [i.e., Gabriel] will ascend to Him during a Day the extent of which is fifty thousand years.", "words": [{"type": "word", "ar": "تَعْرُجُ", "tajweed": "تَعۡرُجُ", "en": "Ascend", "tr": "taʿruju", "audio": "wbw/070_004_001.mp3"}, {"type": "word", "ar": "ٱلْمَلَـٰٓئِكَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَلَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَةُ", "en": "the Angels", "tr": "l-malāikatu", "audio": "wbw/070_004_002.mp3"}, {"type": "word", "ar": "وَٱلرُّوحُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رُّوحُ", "en": "and the Spirit", "tr": "wal-rūḥu", "audio": "wbw/070_004_003.mp3"}, {"type": "word", "ar": "إِلَيْهِ", "tajweed": "إِلَيۡهِ", "en": "to Him", "tr": "ilayhi", "audio": "wbw/070_004_004.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/070_004_005.mp3"}, {"type": "word", "ar": "يَوْمٍۢ", "tajweed": "يَوۡ<rule class=ikhafa>مٍ</rule>", "en": "a Day", "tr": "yawmin", "audio": "wbw/070_004_006.mp3"}, {"type": "word", "ar": "كَانَ", "tajweed": "<rule class=ikhafa>ك</rule>َانَ", "en": "[is]", "tr": "kāna", "audio": "wbw/070_004_007.mp3"}, {"type": "word", "ar": "مِقْدَارُهُۥ", "tajweed": "مِ<rule class=qalaqah>قۡ</rule>دَارُهُ<rule class=madda_normal>ۥ</rule>", "en": "its measure", "tr": "miq'dāruhu", "audio": "wbw/070_004_008.mp3"}, {"type": "word", "ar": "خَمْسِينَ", "tajweed": "خَمۡسِينَ", "en": "(is) fifty", "tr": "khamsīna", "audio": "wbw/070_004_009.mp3"}, {"type": "word", "ar": "أَلْفَ", "tajweed": "أَلۡفَ", "en": "thousand", "tr": "alfa", "audio": "wbw/070_004_010.mp3"}, {"type": "word", "ar": "سَنَةٍۢ", "tajweed": "سَنَةٍ", "en": "year(s)", "tr": "sanatin", "audio": "wbw/070_004_011.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "70:5", "juz": 29, "page": 568, "side_trans": "So be patient with gracious patience.", "words": [{"type": "word", "ar": "فَٱصْبِرْ", "tajweed": "فَ<rule class=ham_wasl>ٱ</rule>صۡبِرۡ", "en": "So be patient", "tr": "fa-iṣ'bir", "audio": "wbw/070_005_001.mp3"}, {"type": "word", "ar": "صَبْرًۭا", "tajweed": "صَ<rule class=qalaqah>بۡ</rule><rule class=ikhafa>رًا</rule>", "en": "a patience", "tr": "ṣabran", "audio": "wbw/070_005_002.mp3"}, {"type": "word", "ar": "جَمِيلًا", "tajweed": "<rule class=ikhafa>ج</rule>َمِيلاً", "en": "good", "tr": "jamīlan", "audio": "wbw/070_005_003.mp3"}, {"type": "end", "num": "٥"}]}, {"id": 6, "key": "70:6", "juz": 29, "page": 568, "side_trans": "Indeed, they see it [as] distant,", "words": [{"type": "word", "ar": "إِنَّهُمْ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "Indeed, they", "tr": "innahum", "audio": "wbw/070_006_001.mp3"}, {"type": "word", "ar": "يَرَوْنَهُۥ", "tajweed": "يَرَوۡنَهُ<rule class=madda_normal>ۥ</rule>", "en": "see it", "tr": "yarawnahu", "audio": "wbw/070_006_002.mp3"}, {"type": "word", "ar": "بَعِيدًۭا", "tajweed": "بَعِيدًا", "en": "(as) far off", "tr": "baʿīdan", "audio": "wbw/070_006_003.mp3"}, {"type": "end", "num": "٦"}]}, {"id": 7, "key": "70:7", "juz": 29, "page": 568, "side_trans": "But We see it [as] near.", "words": [{"type": "word", "ar": "وَنَرَىٰهُ", "tajweed": "وَنَرَ<rule class=madda_normal>ٮٰ</rule>هُ", "en": "But We see it", "tr": "wanarāhu", "audio": "wbw/070_007_001.mp3"}, {"type": "word", "ar": "قَرِيبًۭا", "tajweed": "قَرِيبًا", "en": "near", "tr": "qarīban", "audio": "wbw/070_007_002.mp3"}, {"type": "end", "num": "٧"}]}, {"id": 8, "key": "70:8", "juz": 29, "page": 568, "side_trans": "On the Day the sky will be like murky oil,", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(The) Day ", "tr": "yawma", "audio": "wbw/070_008_001.mp3"}, {"type": "word", "ar": "تَكُونُ", "tajweed": "تَكُونُ", "en": "will be", "tr": "takūnu", "audio": "wbw/070_008_002.mp3"}, {"type": "word", "ar": "ٱلسَّمَآءُ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>سَّم<rule class=madda_obligatory_mottasel>َا</rule>ٓءُ", "en": "the sky", "tr": "l-samāu", "audio": "wbw/070_008_003.mp3"}, {"type": "word", "ar": "كَٱلْمُهْلِ", "tajweed": "كَ<rule class=ham_wasl>ٱ</rule>لۡمُهۡلِ", "en": "like molten copper", "tr": "kal-muh'li", "audio": "wbw/070_008_004.mp3"}, {"type": "end", "num": "٨"}]}, {"id": 9, "key": "70:9", "juz": 29, "page": 568, "side_trans": "And the mountains will be like wool,", "words": [{"type": "word", "ar": "وَتَكُونُ", "tajweed": "وَتَكُونُ", "en": "And will be", "tr": "watakūnu", "audio": "wbw/070_009_001.mp3"}, {"type": "word", "ar": "ٱلْجِبَالُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡجِبَالُ", "en": "the mountains", "tr": "l-jibālu", "audio": "wbw/070_009_002.mp3"}, {"type": "word", "ar": "كَٱلْعِهْنِ", "tajweed": "كَ<rule class=ham_wasl>ٱ</rule>لۡعِهۡنِ", "en": "like wool", "tr": "kal-ʿih'ni", "audio": "wbw/070_009_003.mp3"}, {"type": "end", "num": "٩"}]}, {"id": 10, "key": "70:10", "juz": 29, "page": 568, "side_trans": "And no friend will ask [anything of] a friend,", "words": [{"type": "word", "ar": "وَلَا", "tajweed": "وَلَا", "en": "And not", "tr": "walā", "audio": "wbw/070_010_001.mp3"}, {"type": "word", "ar": "يَسْـَٔلُ", "tajweed": "يَسۡــَٔلُ", "en": "will ask", "tr": "yasalu", "audio": "wbw/070_010_002.mp3"}, {"type": "word", "ar": "حَمِيمٌ", "tajweed": "حَمِيمٌ", "en": "a friend", "tr": "ḥamīmun", "audio": "wbw/070_010_003.mp3"}, {"type": "word", "ar": "حَمِيمًۭا", "tajweed": "حَمِيمًا", "en": "(about) a friend", "tr": "ḥamīman", "audio": "wbw/070_010_004.mp3"}, {"type": "end", "num": "١٠"}]}, {"id": 11, "key": "70:11", "juz": 29, "page": 569, "side_trans": "They will be shown each other. The criminal will wish that he could be ransomed from the punishment of that Day by his children.", "words": [{"type": "word", "ar": "يُبَصَّرُونَهُمْ ۚ", "tajweed": "يُبَصَّرُونَهُمۡ‌ۚ", "en": "They will be made to see each other", "tr": "yubaṣṣarūnahum", "audio": "wbw/070_011_001.mp3"}, {"type": "word", "ar": "يَوَدُّ", "tajweed": "يَوَدُّ", "en": "Would wish", "tr": "yawaddu", "audio": "wbw/070_011_003.mp3"}, {"type": "word", "ar": "ٱلْمُجْرِمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُ<rule class=qalaqah>جۡ</rule>رِمُ", "en": "the criminal", "tr": "l-muj'rimu", "audio": "wbw/070_011_004.mp3"}, {"type": "word", "ar": "لَوْ", "tajweed": "لَوۡ", "en": "if", "tr": "law", "audio": "wbw/070_011_005.mp3"}, {"type": "word", "ar": "يَفْتَدِى", "tajweed": "يَفۡتَدِى", "en": "he (could be) ransomed", "tr": "yaftadī", "audio": "wbw/070_011_006.mp3"}, {"type": "word", "ar": "مِنْ", "tajweed": "مِنۡ", "en": "from", "tr": "min", "audio": "wbw/070_011_007.mp3"}, {"type": "word", "ar": "عَذَابِ", "tajweed": "عَذَابِ", "en": "(the) punishment", "tr": "ʿadhābi", "audio": "wbw/070_011_008.mp3"}, {"type": "word", "ar": "يَوْمِئِذٍۭ", "tajweed": "يَوۡمِئِ<rule class=iqlab>ذِۭ</rule>", "en": "(of) that Day", "tr": "yawmi-idhin", "audio": "wbw/070_011_009.mp3"}, {"type": "word", "ar": "بِبَنِيهِ", "tajweed": "<rule class=iqlab>ب</rule>ِبَن<rule class=madda_permissible>ِي</rule>هِ", "en": "by his children", "tr": "bibanīhi", "audio": "wbw/070_011_010.mp3"}, {"type": "end", "num": "١١"}]}, {"id": 12, "key": "70:12", "juz": 29, "page": 569, "side_trans": "And his wife and his brother", "words": [{"type": "word", "ar": "وَصَـٰحِبَتِهِۦ", "tajweed": "وَصَ<rule class=madda_normal>ـٰ</rule>حِبَتِه<rule class=madda_normal>ِۦ</rule>", "en": "And his spouse", "tr": "waṣāḥibatihi", "audio": "wbw/070_012_001.mp3"}, {"type": "word", "ar": "وَأَخِيهِ", "tajweed": "وَأَخ<rule class=madda_permissible>ِي</rule>هِ", "en": "and his brother", "tr": "wa-akhīhi", "audio": "wbw/070_012_002.mp3"}, {"type": "end", "num": "١٢"}]}, {"id": 13, "key": "70:13", "juz": 29, "page": 569, "side_trans": "And his nearest kindred who shelter him.", "words": [{"type": "word", "ar": "وَفَصِيلَتِهِ", "tajweed": "وَفَصِيلَتِهِ", "en": "And his nearest kindred", "tr": "wafaṣīlatihi", "audio": "wbw/070_013_001.mp3"}, {"type": "word", "ar": "ٱلَّتِى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّتِى", "en": "who", "tr": "allatī", "audio": "wbw/070_013_002.mp3"}, {"type": "word", "ar": "تُـْٔوِيهِ", "tajweed": "تُــٔۡو<rule class=madda_permissible>ِي</rule>هِ", "en": "sheltered him", "tr": "tu'wīhi", "audio": "wbw/070_013_003.mp3"}, {"type": "end", "num": "١٣"}]}, {"id": 14, "key": "70:14", "juz": 29, "page": 569, "side_trans": "And whoever is on earth entirely [so] then it could save him.", "words": [{"type": "word", "ar": "وَمَن", "tajweed": "وَمَ<rule class=ikhafa>ن</rule>", "en": "And whoever", "tr": "waman", "audio": "wbw/070_014_001.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "<rule class=ikhafa>ف</rule>ِى", "en": "(is) on", "tr": "fī", "audio": "wbw/070_014_002.mp3"}, {"type": "word", "ar": "ٱلْأَرْضِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَرۡضِ", "en": "the earth", "tr": "l-arḍi", "audio": "wbw/070_014_003.mp3"}, {"type": "word", "ar": "جَمِيعًۭا", "tajweed": "جَمِي<rule class=ikhafa>عًا</rule>", "en": "all", "tr": "jamīʿan", "audio": "wbw/070_014_004.mp3"}, {"type": "word", "ar": "ثُمَّ", "tajweed": "<rule class=ikhafa>ث</rule>ُ<rule class=ghunnah>مّ</rule>َ", "en": "then", "tr": "thumma", "audio": "wbw/070_014_005.mp3"}, {"type": "word", "ar": "يُنجِيهِ", "tajweed": "يُ<rule class=ikhafa>نج</rule><rule class=madda_permissible>ِي</rule>هِ", "en": "it (could) save him", "tr": "yunjīhi", "audio": "wbw/070_014_006.mp3"}, {"type": "end", "num": "١٤"}]}, {"id": 15, "key": "70:15", "juz": 29, "page": 569, "side_trans": "No! Indeed, it is the Flame [of Hell],", "words": [{"type": "word", "ar": "كَلَّآ ۖ", "tajweed": "كَلّ<rule class=madda_obligatory_monfasel>َآ‌ۖ</rule>", "en": "By no means", "tr": "kallā", "audio": "wbw/070_015_001.mp3"}, {"type": "word", "ar": "إِنَّهَا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َهَا", "en": "Indeed, it (is)", "tr": "innahā", "audio": "wbw/070_015_003.mp3"}, {"type": "word", "ar": "لَظَىٰ", "tajweed": "لَظَىٰ", "en": "surely a Flame of Hell", "tr": "laẓā", "audio": "wbw/070_015_004.mp3"}, {"type": "end", "num": "١٥"}]}, {"id": 16, "key": "70:16", "juz": 29, "page": 569, "side_trans": "A remover of exteriors.", "words": [{"type": "word", "ar": "نَزَّاعَةًۭ", "tajweed": "نَزَّاعَ<rule class=idgham_wo_ghunnah>ةً</rule>", "en": "A remover", "tr": "nazzāʿatan", "audio": "wbw/070_016_001.mp3"}, {"type": "word", "ar": "لِّلشَّوَىٰ", "tajweed": "<rule class=idgham_wo_ghunnah>ل</rule>ِّلشَّوَىٰ", "en": "of the skin of the head", "tr": "lilshawā", "audio": "wbw/070_016_002.mp3"}, {"type": "end", "num": "١٦"}]}, {"id": 17, "key": "70:17", "juz": 29, "page": 569, "side_trans": "It invites he who turned his back [on truth] and went away [from obedience]", "words": [{"type": "word", "ar": "تَدْعُوا۟", "tajweed": "تَ<rule class=qalaqah>دۡ</rule>عُو<rule class=slnt>اۡ</rule>", "en": "Inviting", "tr": "tadʿū", "audio": "wbw/070_017_001.mp3"}, {"type": "word", "ar": "مَنْ", "tajweed": "مَنۡ", "en": "(him) who", "tr": "man", "audio": "wbw/070_017_002.mp3"}, {"type": "word", "ar": "أَدْبَرَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>بَرَ", "en": "turned his back", "tr": "adbara", "audio": "wbw/070_017_003.mp3"}, {"type": "word", "ar": "وَتَوَلَّىٰ", "tajweed": "وَتَوَلَّىٰ", "en": "and went away", "tr": "watawallā", "audio": "wbw/070_017_004.mp3"}, {"type": "end", "num": "١٧"}]}, {"id": 18, "key": "70:18", "juz": 29, "page": 569, "side_trans": "And collected [wealth] and hoarded.", "words": [{"type": "word", "ar": "وَجَمَعَ", "tajweed": "وَجَمَعَ", "en": "And collected", "tr": "wajamaʿa", "audio": "wbw/070_018_001.mp3"}, {"type": "word", "ar": "فَأَوْعَىٰٓ", "tajweed": "فَأَوۡعَىٰٓ", "en": "and hoarded", "tr": "fa-awʿā", "audio": "wbw/070_018_002.mp3"}, {"type": "end", "num": "١٨"}]}, {"id": 19, "key": "70:19", "juz": 29, "page": 569, "side_trans": "Indeed, mankind was created anxious:", "words": [{"type": "word", "ar": "۞ إِنَّ", "tajweed": "۞إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/070_019_002.mp3"}, {"type": "word", "ar": "ٱلْإِنسَـٰنَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡإِ<rule class=ikhafa>نس</rule>َ<rule class=madda_normal>ـٰ</rule>نَ", "en": "the man", "tr": "l-insāna", "audio": "wbw/070_019_003.mp3"}, {"type": "word", "ar": "خُلِقَ", "tajweed": "خُلِقَ", "en": "was created", "tr": "khuliqa", "audio": "wbw/070_019_004.mp3"}, {"type": "word", "ar": "هَلُوعًا", "tajweed": "هَلُوعًا", "en": "anxious ", "tr": "halūʿan", "audio": "wbw/070_019_005.mp3"}, {"type": "end", "num": "١٩"}]}, {"id": 20, "key": "70:20", "juz": 29, "page": 569, "side_trans": "When evil touches him, impatient,", "words": [{"type": "word", "ar": "إِذَا", "tajweed": "إِذَا", "en": "When", "tr": "idhā", "audio": "wbw/070_020_001.mp3"}, {"type": "word", "ar": "مَسَّهُ", "tajweed": "مَسَّهُ", "en": "touches him", "tr": "massahu", "audio": "wbw/070_020_002.mp3"}, {"type": "word", "ar": "ٱلشَّرُّ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شَّرُّ", "en": "the evil", "tr": "l-sharu", "audio": "wbw/070_020_003.mp3"}, {"type": "word", "ar": "جَزُوعًۭا", "tajweed": "جَزُوعًا", "en": "distressed", "tr": "jazūʿan", "audio": "wbw/070_020_004.mp3"}, {"type": "end", "num": "٢٠"}]}, {"id": 21, "key": "70:21", "juz": 29, "page": 569, "side_trans": "And when good touches him, withholding [of it],", "words": [{"type": "word", "ar": "وَإِذَا", "tajweed": "وَإِذَا", "en": "And when", "tr": "wa-idhā", "audio": "wbw/070_021_001.mp3"}, {"type": "word", "ar": "مَسَّهُ", "tajweed": "مَسَّهُ", "en": "touches him", "tr": "massahu", "audio": "wbw/070_021_002.mp3"}, {"type": "word", "ar": "ٱلْخَيْرُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡخَيۡرُ", "en": "the good", "tr": "l-khayru", "audio": "wbw/070_021_003.mp3"}, {"type": "word", "ar": "مَنُوعًا", "tajweed": "مَنُوعًا", "en": "withholding", "tr": "manūʿan", "audio": "wbw/070_021_004.mp3"}, {"type": "end", "num": "٢١"}]}, {"id": 22, "key": "70:22", "juz": 29, "page": 569, "side_trans": "Except the observers of prayer -", "words": [{"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "Except", "tr": "illā", "audio": "wbw/070_022_001.mp3"}, {"type": "word", "ar": "ٱلْمُصَلِّينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمُصَلّ<rule class=madda_permissible>ِي</rule>نَ", "en": "those who pray ", "tr": "l-muṣalīna", "audio": "wbw/070_022_002.mp3"}, {"type": "end", "num": "٢٢"}]}, {"id": 23, "key": "70:23", "juz": 29, "page": 569, "side_trans": "Those who are constant in their prayer", "words": [{"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "ٱلَّذِينَ", "en": "Those who", "tr": "alladhīna", "audio": "wbw/070_023_001.mp3"}, {"type": "word", "ar": "هُمْ", "tajweed": "هُمۡ", "en": "[they]", "tr": "hum", "audio": "wbw/070_023_002.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "at", "tr": "ʿalā", "audio": "wbw/070_023_003.mp3"}, {"type": "word", "ar": "صَلَاتِهِمْ", "tajweed": "صَلَاتِهِمۡ", "en": "their prayer", "tr": "ṣalātihim", "audio": "wbw/070_023_004.mp3"}, {"type": "word", "ar": "دَآئِمُونَ", "tajweed": "د<rule class=madda_obligatory_mottasel>َا</rule>ٓئِم<rule class=madda_permissible>ُو</rule>نَ", "en": "(are) constant", "tr": "dāimūna", "audio": "wbw/070_023_005.mp3"}, {"type": "end", "num": "٢٣"}]}, {"id": 24, "key": "70:24", "juz": 29, "page": 569, "side_trans": "And those within whose wealth is a known right", "words": [{"type": "word", "ar": "وَٱلَّذِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "And those who", "tr": "wa-alladhīna", "audio": "wbw/070_024_001.mp3"}, {"type": "word", "ar": "فِىٓ", "tajweed": "ف<rule class=madda_obligatory_monfasel>ِىٓ</rule>", "en": "in", "tr": "fī", "audio": "wbw/070_024_002.mp3"}, {"type": "word", "ar": "أَمْوَٰلِهِمْ", "tajweed": "أَمۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِهِمۡ", "en": "their wealth", "tr": "amwālihim", "audio": "wbw/070_024_003.mp3"}, {"type": "word", "ar": "حَقٌّۭ", "tajweed": "حَ<rule class=idgham_ghunnah>قٌّ</rule>", "en": "(is) a right", "tr": "ḥaqqun", "audio": "wbw/070_024_004.mp3"}, {"type": "word", "ar": "مَّعْلُومٌۭ", "tajweed": "<rule class=idgham_ghunnah>م</rule>َّعۡل<rule class=madda_permissible>ُو</rule>مٌ", "en": "known", "tr": "maʿlūmun", "audio": "wbw/070_024_005.mp3"}, {"type": "end", "num": "٢٤"}]}, {"id": 25, "key": "70:25", "juz": 29, "page": 569, "side_trans": "For the petitioner and the deprived -", "words": [{"type": "word", "ar": "لِّلسَّآئِلِ", "tajweed": "لِّلسّ<rule class=madda_obligatory_mottasel>َا</rule>ٓئِلِ", "en": "For the one who asks", "tr": "lilssāili", "audio": "wbw/070_025_001.mp3"}, {"type": "word", "ar": "وَٱلْمَحْرُومِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمَحۡر<rule class=madda_permissible>ُو</rule>مِ", "en": "and the deprived", "tr": "wal-maḥrūmi", "audio": "wbw/070_025_002.mp3"}, {"type": "end", "num": "٢٥"}]}, {"id": 26, "key": "70:26", "juz": 29, "page": 569, "side_trans": "And those who believe in the Day of Recompense", "words": [{"type": "word", "ar": "وَٱلَّذِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "And those who", "tr": "wa-alladhīna", "audio": "wbw/070_026_001.mp3"}, {"type": "word", "ar": "يُصَدِّقُونَ", "tajweed": "يُصَدِّقُونَ", "en": "accept (the) truth", "tr": "yuṣaddiqūna", "audio": "wbw/070_026_002.mp3"}, {"type": "word", "ar": "بِيَوْمِ", "tajweed": "بِيَوۡمِ", "en": "(of the) Day", "tr": "biyawmi", "audio": "wbw/070_026_003.mp3"}, {"type": "word", "ar": "ٱلدِّينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>دّ<rule class=madda_permissible>ِي</rule>نِ", "en": "(of) the Judgment", "tr": "l-dīni", "audio": "wbw/070_026_004.mp3"}, {"type": "end", "num": "٢٦"}]}, {"id": 27, "key": "70:27", "juz": 29, "page": 569, "side_trans": "And those who are fearful of the punishment of their Lord -", "words": [{"type": "word", "ar": "وَٱلَّذِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "And those who", "tr": "wa-alladhīna", "audio": "wbw/070_027_001.mp3"}, {"type": "word", "ar": "هُم", "tajweed": "ه<rule class=idgham_shafawi>ُم</rule>", "en": "[they]", "tr": "hum", "audio": "wbw/070_027_002.mp3"}, {"type": "word", "ar": "مِّنْ", "tajweed": "<rule class=idgham_shafawi>م</rule>ِّنۡ", "en": "of", "tr": "min", "audio": "wbw/070_027_003.mp3"}, {"type": "word", "ar": "عَذَابِ", "tajweed": "عَذَابِ", "en": "(the) punishment", "tr": "ʿadhābi", "audio": "wbw/070_027_004.mp3"}, {"type": "word", "ar": "رَبِّهِم", "tajweed": "رَبِّه<rule class=idgham_shafawi>ِم</rule>", "en": "(of) their Lord", "tr": "rabbihim", "audio": "wbw/070_027_005.mp3"}, {"type": "word", "ar": "مُّشْفِقُونَ", "tajweed": "<rule class=idgham_shafawi>م</rule>ُّشۡفِق<rule class=madda_permissible>ُو</rule>نَ", "en": "(are) fearful ", "tr": "mush'fiqūna", "audio": "wbw/070_027_006.mp3"}, {"type": "end", "num": "٢٧"}]}, {"id": 28, "key": "70:28", "juz": 29, "page": 569, "side_trans": "Indeed, the punishment of their Lord is not that from which one is safe -", "words": [{"type": "word", "ar": "إِنَّ", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َ", "en": "Indeed", "tr": "inna", "audio": "wbw/070_028_001.mp3"}, {"type": "word", "ar": "عَذَابَ", "tajweed": "عَذَابَ", "en": "(the) punishment", "tr": "ʿadhāba", "audio": "wbw/070_028_002.mp3"}, {"type": "word", "ar": "رَبِّهِمْ", "tajweed": "رَبِّهِمۡ", "en": "(of) your Lord", "tr": "rabbihim", "audio": "wbw/070_028_003.mp3"}, {"type": "word", "ar": "غَيْرُ", "tajweed": "غَيۡرُ", "en": "(is) not", "tr": "ghayru", "audio": "wbw/070_028_004.mp3"}, {"type": "word", "ar": "مَأْمُونٍۢ", "tajweed": "مَأۡم<rule class=madda_permissible>ُو</rule>نٍ", "en": "to be felt secure (of) ", "tr": "mamūnin", "audio": "wbw/070_028_005.mp3"}, {"type": "end", "num": "٢٨"}]}, {"id": 29, "key": "70:29", "juz": 29, "page": 569, "side_trans": "And those who guard their private parts", "words": [{"type": "word", "ar": "وَٱلَّذِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "And those who", "tr": "wa-alladhīna", "audio": "wbw/070_029_001.mp3"}, {"type": "word", "ar": "هُمْ", "tajweed": "هُمۡ", "en": "[they]", "tr": "hum", "audio": "wbw/070_029_002.mp3"}, {"type": "word", "ar": "لِفُرُوجِهِمْ", "tajweed": "لِفُرُوجِهِمۡ", "en": "their modesty", "tr": "lifurūjihim", "audio": "wbw/070_029_003.mp3"}, {"type": "word", "ar": "حَـٰفِظُونَ", "tajweed": "حَ<rule class=madda_normal>ـٰ</rule>فِظ<rule class=madda_permissible>ُو</rule>نَ", "en": "(are) guardians", "tr": "ḥāfiẓūna", "audio": "wbw/070_029_004.mp3"}, {"type": "end", "num": "٢٩"}]}, {"id": 30, "key": "70:30", "juz": 29, "page": 569, "side_trans": "Except from their wives or those their right hands possess, for indeed, they are not to be blamed -", "words": [{"type": "word", "ar": "إِلَّا", "tajweed": "إِلَّا", "en": "Except", "tr": "illā", "audio": "wbw/070_030_001.mp3"}, {"type": "word", "ar": "عَلَىٰٓ", "tajweed": "عَلَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "from", "tr": "ʿalā", "audio": "wbw/070_030_002.mp3"}, {"type": "word", "ar": "أَزْوَٰجِهِمْ", "tajweed": "أَزۡو<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>جِهِمۡ", "en": "their spouses", "tr": "azwājihim", "audio": "wbw/070_030_003.mp3"}, {"type": "word", "ar": "أَوْ", "tajweed": "أَوۡ", "en": "or", "tr": "aw", "audio": "wbw/070_030_004.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/070_030_005.mp3"}, {"type": "word", "ar": "مَلَكَتْ", "tajweed": "مَلَكَتۡ", "en": "they possess", "tr": "malakat", "audio": "wbw/070_030_006.mp3"}, {"type": "word", "ar": "أَيْمَـٰنُهُمْ", "tajweed": "أَيۡمَ<rule class=madda_normal>ـٰ</rule>نُهُمۡ", "en": "rightfully", "tr": "aymānuhum", "audio": "wbw/070_030_007.mp3"}, {"type": "word", "ar": "فَإِنَّهُمْ", "tajweed": "فَإِ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "then indeed, they", "tr": "fa-innahum", "audio": "wbw/070_030_008.mp3"}, {"type": "word", "ar": "غَيْرُ", "tajweed": "غَيۡرُ", "en": "(are) not", "tr": "ghayru", "audio": "wbw/070_030_009.mp3"}, {"type": "word", "ar": "مَلُومِينَ", "tajweed": "مَلُوم<rule class=madda_permissible>ِي</rule>نَ", "en": "blameworthy", "tr": "malūmīna", "audio": "wbw/070_030_010.mp3"}, {"type": "end", "num": "٣٠"}]}, {"id": 31, "key": "70:31", "juz": 29, "page": 569, "side_trans": "But whoever seeks beyond that, then they are the transgressors -", "words": [{"type": "word", "ar": "فَمَنِ", "tajweed": "فَمَنِ", "en": "But whoever", "tr": "famani", "audio": "wbw/070_031_001.mp3"}, {"type": "word", "ar": "ٱبْتَغَىٰ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=qalaqah>بۡ</rule>تَغَىٰ", "en": "seeks", "tr": "ib'taghā", "audio": "wbw/070_031_002.mp3"}, {"type": "word", "ar": "وَرَآءَ", "tajweed": "وَر<rule class=madda_obligatory_mottasel>َا</rule>ٓءَ", "en": "beyond", "tr": "warāa", "audio": "wbw/070_031_003.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "ذ<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "that", "tr": "dhālika", "audio": "wbw/070_031_004.mp3"}, {"type": "word", "ar": "فَأُو۟لَـٰٓئِكَ", "tajweed": "فَأُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَ", "en": "then those", "tr": "fa-ulāika", "audio": "wbw/070_031_005.mp3"}, {"type": "word", "ar": "هُمُ", "tajweed": "هُمُ", "en": "[they]", "tr": "humu", "audio": "wbw/070_031_006.mp3"}, {"type": "word", "ar": "ٱلْعَادُونَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡعَاد<rule class=madda_permissible>ُو</rule>نَ", "en": "(are) the transgressors ", "tr": "l-ʿādūna", "audio": "wbw/070_031_007.mp3"}, {"type": "end", "num": "٣١"}]}, {"id": 32, "key": "70:32", "juz": 29, "page": 569, "side_trans": "And those who are to their trusts and promises attentive.", "words": [{"type": "word", "ar": "وَٱلَّذِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "And those who", "tr": "wa-alladhīna", "audio": "wbw/070_032_001.mp3"}, {"type": "word", "ar": "هُمْ", "tajweed": "هُمۡ", "en": "[they]", "tr": "hum", "audio": "wbw/070_032_002.mp3"}, {"type": "word", "ar": "لِأَمَـٰنَـٰتِهِمْ", "tajweed": "لِأَمَ<rule class=madda_normal>ـٰ</rule>نَ<rule class=madda_normal>ـٰ</rule>تِهِمۡ", "en": "of their trusts", "tr": "li-amānātihim", "audio": "wbw/070_032_003.mp3"}, {"type": "word", "ar": "وَعَهْدِهِمْ", "tajweed": "وَعَهۡدِهِمۡ", "en": "and their promise", "tr": "waʿahdihim", "audio": "wbw/070_032_004.mp3"}, {"type": "word", "ar": "رَٰعُونَ", "tajweed": "ر<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>ع<rule class=madda_permissible>ُو</rule>نَ", "en": "(are) observers", "tr": "rāʿūna", "audio": "wbw/070_032_005.mp3"}, {"type": "end", "num": "٣٢"}]}, {"id": 33, "key": "70:33", "juz": 29, "page": 569, "side_trans": "And those who are in their testimonies upright", "words": [{"type": "word", "ar": "وَٱلَّذِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "And those who", "tr": "wa-alladhīna", "audio": "wbw/070_033_001.mp3"}, {"type": "word", "ar": "هُم", "tajweed": "ه<rule class=ikhafa_shafawi>ُم</rule>", "en": "[they]", "tr": "hum", "audio": "wbw/070_033_002.mp3"}, {"type": "word", "ar": "بِشَهَـٰدَٰتِهِمْ", "tajweed": "<rule class=ikhafa_shafawi>ب</rule>ِشَهَ<rule class=madda_normal>ـٰ</rule>د<rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>تِهِمۡ", "en": "in their testimonies", "tr": "bishahādātihim", "audio": "wbw/070_033_003.mp3"}, {"type": "word", "ar": "قَآئِمُونَ", "tajweed": "ق<rule class=madda_obligatory_mottasel>َا</rule>ٓئِم<rule class=madda_permissible>ُو</rule>نَ", "en": "stand firm", "tr": "qāimūna", "audio": "wbw/070_033_004.mp3"}, {"type": "end", "num": "٣٣"}]}, {"id": 34, "key": "70:34", "juz": 29, "page": 569, "side_trans": "And those who [carefully] maintain their prayer:", "words": [{"type": "word", "ar": "وَٱلَّذِينَ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "And those who", "tr": "wa-alladhīna", "audio": "wbw/070_034_001.mp3"}, {"type": "word", "ar": "هُمْ", "tajweed": "هُمۡ", "en": "[they]", "tr": "hum", "audio": "wbw/070_034_002.mp3"}, {"type": "word", "ar": "عَلَىٰ", "tajweed": "عَلَىٰ", "en": "on", "tr": "ʿalā", "audio": "wbw/070_034_003.mp3"}, {"type": "word", "ar": "صَلَاتِهِمْ", "tajweed": "صَلَاتِهِمۡ", "en": "their prayer", "tr": "ṣalātihim", "audio": "wbw/070_034_004.mp3"}, {"type": "word", "ar": "يُحَافِظُونَ", "tajweed": "يُحَافِظ<rule class=madda_permissible>ُو</rule>نَ", "en": "keep a guard ", "tr": "yuḥāfiẓūna", "audio": "wbw/070_034_005.mp3"}, {"type": "end", "num": "٣٤"}]}, {"id": 35, "key": "70:35", "juz": 29, "page": 569, "side_trans": "They will be in gardens, honored.", "words": [{"type": "word", "ar": "أُو۟لَـٰٓئِكَ", "tajweed": "أُ<rule class=slnt>وۡ</rule>لَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَ", "en": "Those", "tr": "ulāika", "audio": "wbw/070_035_001.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "(will be) in", "tr": "fī", "audio": "wbw/070_035_002.mp3"}, {"type": "word", "ar": "جَنَّـٰتٍۢ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َ<rule class=madda_normal>ـٰ</rule><rule class=idgham_ghunnah>تٍ</rule>", "en": "Gardens", "tr": "jannātin", "audio": "wbw/070_035_003.mp3"}, {"type": "word", "ar": "مُّكْرَمُونَ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ُّكۡرَم<rule class=madda_permissible>ُو</rule>نَ", "en": "honored", "tr": "muk'ramūna", "audio": "wbw/070_035_004.mp3"}, {"type": "end", "num": "٣٥"}]}, {"id": 36, "key": "70:36", "juz": 29, "page": 569, "side_trans": "So what is [the matter] with those who disbelieve, hastening [from] before you, [O Muḥammad],", "words": [{"type": "word", "ar": "فَمَالِ", "tajweed": "فَمَالِ", "en": "So what is with", "tr": "famāli", "audio": "wbw/070_036_001.mp3"}, {"type": "word", "ar": "ٱلَّذِينَ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِينَ", "en": "those who", "tr": "alladhīna", "audio": "wbw/070_036_002.mp3"}, {"type": "word", "ar": "كَفَرُوا۟", "tajweed": "كَفَرُو<rule class=slnt>اۡ</rule>", "en": "disbelieve", "tr": "kafarū", "audio": "wbw/070_036_003.mp3"}, {"type": "word", "ar": "قِبَلَكَ", "tajweed": "قِبَلَكَ", "en": "before you", "tr": "qibalaka", "audio": "wbw/070_036_004.mp3"}, {"type": "word", "ar": "مُهْطِعِينَ", "tajweed": "مُهۡطِع<rule class=madda_permissible>ِي</rule>نَ", "en": "(they) hasten", "tr": "muh'ṭiʿīna", "audio": "wbw/070_036_005.mp3"}, {"type": "end", "num": "٣٦"}]}, {"id": 37, "key": "70:37", "juz": 29, "page": 569, "side_trans": "[To sit] on [your] right and [your] left in separate groups?", "words": [{"type": "word", "ar": "عَنِ", "tajweed": "عَنِ", "en": "On", "tr": "ʿani", "audio": "wbw/070_037_001.mp3"}, {"type": "word", "ar": "ٱلْيَمِينِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَمِينِ", "en": "the right", "tr": "l-yamīni", "audio": "wbw/070_037_002.mp3"}, {"type": "word", "ar": "وَعَنِ", "tajweed": "وَعَنِ", "en": "and on", "tr": "waʿani", "audio": "wbw/070_037_003.mp3"}, {"type": "word", "ar": "ٱلشِّمَالِ", "tajweed": "<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>شِّمَالِ", "en": "the left", "tr": "l-shimāli", "audio": "wbw/070_037_004.mp3"}, {"type": "word", "ar": "عِزِينَ", "tajweed": "عِز<rule class=madda_permissible>ِي</rule>نَ", "en": "(in) separate groups", "tr": "ʿizīna", "audio": "wbw/070_037_005.mp3"}, {"type": "end", "num": "٣٧"}]}, {"id": 38, "key": "70:38", "juz": 29, "page": 569, "side_trans": "Does every person among them aspire to enter a garden of pleasure?", "words": [{"type": "word", "ar": "أَيَطْمَعُ", "tajweed": "أَيَ<rule class=qalaqah>طۡ</rule>مَعُ", "en": "Does long", "tr": "ayaṭmaʿu", "audio": "wbw/070_038_001.mp3"}, {"type": "word", "ar": "كُلُّ", "tajweed": "كُلُّ", "en": "every", "tr": "kullu", "audio": "wbw/070_038_002.mp3"}, {"type": "word", "ar": "ٱمْرِئٍۢ", "tajweed": "<rule class=ham_wasl>ٱ</rule>مۡرِى<rule class=idgham_ghunnah>ٍٕ</rule>", "en": "person", "tr": "im'ri-in", "audio": "wbw/070_038_003.mp3"}, {"type": "word", "ar": "مِّنْهُمْ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنۡهُمۡ", "en": "among them", "tr": "min'hum", "audio": "wbw/070_038_004.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "that", "tr": "an", "audio": "wbw/070_038_005.mp3"}, {"type": "word", "ar": "يُدْخَلَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُ<rule class=qalaqah>دۡ</rule>خَلَ", "en": "he enters", "tr": "yud'khala", "audio": "wbw/070_038_006.mp3"}, {"type": "word", "ar": "جَنَّةَ", "tajweed": "جَ<rule class=ghunnah>نّ</rule>َةَ", "en": "a Garden", "tr": "jannata", "audio": "wbw/070_038_007.mp3"}, {"type": "word", "ar": "نَعِيمٍۢ", "tajweed": "نَع<rule class=madda_permissible>ِي</rule>مٍ", "en": "(of) Delight", "tr": "naʿīmin", "audio": "wbw/070_038_008.mp3"}, {"type": "end", "num": "٣٨"}]}, {"id": 39, "key": "70:39", "juz": 29, "page": 569, "side_trans": "No! Indeed, We have created them from that which they know.", "words": [{"type": "word", "ar": "كَلَّآ ۖ", "tajweed": "كَلّ<rule class=madda_obligatory_monfasel>َآ‌ۖ</rule>", "en": "By no means", "tr": "kallā", "audio": "wbw/070_039_001.mp3"}, {"type": "word", "ar": "إِنَّا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َا", "en": "Indeed, We", "tr": "innā", "audio": "wbw/070_039_003.mp3"}, {"type": "word", "ar": "خَلَقْنَـٰهُم", "tajweed": "خَلَ<rule class=qalaqah>قۡ</rule>نَ<rule class=madda_normal>ـٰ</rule>ه<rule class=idgham_shafawi>ُم</rule>", "en": "[We] have created them", "tr": "khalaqnāhum", "audio": "wbw/070_039_004.mp3"}, {"type": "word", "ar": "مِّمَّا", "tajweed": "<rule class=idgham_shafawi>م</rule>ِّ<rule class=ghunnah>مّ</rule>َا", "en": "from what", "tr": "mimmā", "audio": "wbw/070_039_005.mp3"}, {"type": "word", "ar": "يَعْلَمُونَ", "tajweed": "يَعۡلَم<rule class=madda_permissible>ُو</rule>نَ", "en": "they know", "tr": "yaʿlamūna", "audio": "wbw/070_039_006.mp3"}, {"type": "end", "num": "٣٩"}]}, {"id": 40, "key": "70:40", "juz": 29, "page": 569, "side_trans": "So I swear by the Lord of [all] risings and settings that indeed We are able", "words": [{"type": "word", "ar": "فَلَآ", "tajweed": "فَل<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "But nay", "tr": "falā", "audio": "wbw/070_040_001.mp3"}, {"type": "word", "ar": "أُقْسِمُ", "tajweed": "أُ<rule class=qalaqah>قۡ</rule>سِمُ", "en": "I swear", "tr": "uq'simu", "audio": "wbw/070_040_002.mp3"}, {"type": "word", "ar": "بِرَبِّ", "tajweed": "بِرَبِّ", "en": "by (the) Lord", "tr": "birabbi", "audio": "wbw/070_040_003.mp3"}, {"type": "word", "ar": "ٱلْمَشَـٰرِقِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَشَ<rule class=madda_normal>ـٰ</rule>رِقِ", "en": "(of) the risings", "tr": "l-mashāriqi", "audio": "wbw/070_040_004.mp3"}, {"type": "word", "ar": "وَٱلْمَغَـٰرِبِ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule>لۡمَغَ<rule class=madda_normal>ـٰ</rule>رِبِ", "en": "and the settings", "tr": "wal-maghāribi", "audio": "wbw/070_040_005.mp3"}, {"type": "word", "ar": "إِنَّا", "tajweed": "إِ<rule class=ghunnah>نّ</rule>َا", "en": "that We", "tr": "innā", "audio": "wbw/070_040_006.mp3"}, {"type": "word", "ar": "لَقَـٰدِرُونَ", "tajweed": "لَقَ<rule class=madda_normal>ـٰ</rule>دِر<rule class=madda_permissible>ُو</rule>نَ", "en": "(are) surely Able", "tr": "laqādirūna", "audio": "wbw/070_040_007.mp3"}, {"type": "end", "num": "٤٠"}]}, {"id": 41, "key": "70:41", "juz": 29, "page": 570, "side_trans": "To replace them with better than them; and We are not to be outdone.", "words": [{"type": "word", "ar": "عَلَىٰٓ", "tajweed": "عَلَ<rule class=madda_obligatory_monfasel>ىٰٓ</rule>", "en": "[On]", "tr": "ʿalā", "audio": "wbw/070_041_001.mp3"}, {"type": "word", "ar": "أَن", "tajweed": "أ<rule class=idgham_ghunnah>َن</rule>", "en": "to", "tr": "an", "audio": "wbw/070_041_002.mp3"}, {"type": "word", "ar": "نُّبَدِّلَ", "tajweed": "<rule class=idgham_ghunnah>ن</rule>ُّبَدِّلَ", "en": "[We] replace", "tr": "nubaddila", "audio": "wbw/070_041_003.mp3"}, {"type": "word", "ar": "خَيْرًۭا", "tajweed": "خَيۡ<rule class=idgham_ghunnah>رًا</rule>", "en": "(with) better", "tr": "khayran", "audio": "wbw/070_041_004.mp3"}, {"type": "word", "ar": "مِّنْهُمْ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنۡهُمۡ", "en": "than them", "tr": "min'hum", "audio": "wbw/070_041_005.mp3"}, {"type": "word", "ar": "وَمَا", "tajweed": "وَمَا", "en": "and not", "tr": "wamā", "audio": "wbw/070_041_006.mp3"}, {"type": "word", "ar": "نَحْنُ", "tajweed": "نَحۡنُ", "en": "We", "tr": "naḥnu", "audio": "wbw/070_041_007.mp3"}, {"type": "word", "ar": "بِمَسْبُوقِينَ", "tajweed": "بِمَسۡبُوق<rule class=madda_permissible>ِي</rule>نَ", "en": "(are) to be outrun", "tr": "bimasbūqīna", "audio": "wbw/070_041_008.mp3"}, {"type": "end", "num": "٤١"}]}, {"id": 42, "key": "70:42", "juz": 29, "page": 570, "side_trans": "So leave them to converse vainly and amuse themselves until they meet their Day which they are promised -", "words": [{"type": "word", "ar": "فَذَرْهُمْ", "tajweed": "فَذَرۡهُمۡ", "en": "So leave them", "tr": "fadharhum", "audio": "wbw/070_042_001.mp3"}, {"type": "word", "ar": "يَخُوضُوا۟", "tajweed": "يَخُوضُو<rule class=slnt>اۡ</rule>", "en": "(to) converse vainly", "tr": "yakhūḍū", "audio": "wbw/070_042_002.mp3"}, {"type": "word", "ar": "وَيَلْعَبُوا۟", "tajweed": "وَيَلۡعَبُو<rule class=slnt>اۡ</rule>", "en": "and amuse themselves", "tr": "wayalʿabū", "audio": "wbw/070_042_003.mp3"}, {"type": "word", "ar": "حَتَّىٰ", "tajweed": "حَتَّىٰ", "en": "until", "tr": "ḥattā", "audio": "wbw/070_042_004.mp3"}, {"type": "word", "ar": "يُلَـٰقُوا۟", "tajweed": "يُلَ<rule class=madda_normal>ـٰ</rule>قُو<rule class=slnt>اۡ</rule>", "en": "they meet", "tr": "yulāqū", "audio": "wbw/070_042_005.mp3"}, {"type": "word", "ar": "يَوْمَهُمُ", "tajweed": "يَوۡمَهُمُ", "en": "their Day", "tr": "yawmahumu", "audio": "wbw/070_042_006.mp3"}, {"type": "word", "ar": "ٱلَّذِى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِى", "en": "which", "tr": "alladhī", "audio": "wbw/070_042_007.mp3"}, {"type": "word", "ar": "يُوعَدُونَ", "tajweed": "يُوعَد<rule class=madda_permissible>ُو</rule>نَ", "en": "they are promised", "tr": "yūʿadūna", "audio": "wbw/070_042_008.mp3"}, {"type": "end", "num": "٤٢"}]}, {"id": 43, "key": "70:43", "juz": 29, "page": 570, "side_trans": "The Day they will emerge from the graves rapidly as if they were, toward an erected idol, hastening.", "words": [{"type": "word", "ar": "يَوْمَ", "tajweed": "يَوۡمَ", "en": "(The) Day", "tr": "yawma", "audio": "wbw/070_043_001.mp3"}, {"type": "word", "ar": "يَخْرُجُونَ", "tajweed": "يَخۡرُجُونَ", "en": "they will come out", "tr": "yakhrujūna", "audio": "wbw/070_043_002.mp3"}, {"type": "word", "ar": "مِنَ", "tajweed": "مِنَ", "en": "from", "tr": "mina", "audio": "wbw/070_043_003.mp3"}, {"type": "word", "ar": "ٱلْأَجْدَاثِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡأَ<rule class=qalaqah>جۡ</rule>دَاثِ", "en": "the graves", "tr": "l-ajdāthi", "audio": "wbw/070_043_004.mp3"}, {"type": "word", "ar": "سِرَاعًۭا", "tajweed": "سِرَا<rule class=ikhafa>عًا</rule>", "en": "rapidly", "tr": "sirāʿan", "audio": "wbw/070_043_005.mp3"}, {"type": "word", "ar": "كَأَنَّهُمْ", "tajweed": "<rule class=ikhafa>ك</rule>َأَ<rule class=ghunnah>نّ</rule>َهُمۡ", "en": "as if they (were)", "tr": "ka-annahum", "audio": "wbw/070_043_006.mp3"}, {"type": "word", "ar": "إِلَىٰ", "tajweed": "إِلَىٰ", "en": "to", "tr": "ilā", "audio": "wbw/070_043_007.mp3"}, {"type": "word", "ar": "نُصُبٍۢ", "tajweed": "نُصُ<rule class=idgham_ghunnah>بٍ</rule>", "en": "a goal", "tr": "nuṣubin", "audio": "wbw/070_043_008.mp3"}, {"type": "word", "ar": "يُوفِضُونَ", "tajweed": "<rule class=idgham_ghunnah>ي</rule>ُوفِض<rule class=madda_permissible>ُو</rule>نَ", "en": "hastening", "tr": "yūfiḍūna", "audio": "wbw/070_043_009.mp3"}, {"type": "end", "num": "٤٣"}]}, {"id": 44, "key": "70:44", "juz": 29, "page": 570, "side_trans": "Their eyes humbled, humiliation will cover them. That is the Day which they had been promised.", "words": [{"type": "word", "ar": "خَـٰشِعَةً", "tajweed": "خَ<rule class=madda_normal>ـٰ</rule>شِعَةً", "en": "Humbled", "tr": "khāshiʿatan", "audio": "wbw/070_044_001.mp3"}, {"type": "word", "ar": "أَبْصَـٰرُهُمْ", "tajweed": "أَ<rule class=qalaqah>بۡ</rule>صَ<rule class=madda_normal>ـٰ</rule>رُهُمۡ", "en": "their eyesights", "tr": "abṣāruhum", "audio": "wbw/070_044_002.mp3"}, {"type": "word", "ar": "تَرْهَقُهُمْ", "tajweed": "تَرۡهَقُهُمۡ", "en": "will cover them", "tr": "tarhaquhum", "audio": "wbw/070_044_003.mp3"}, {"type": "word", "ar": "ذِلَّةٌۭ ۚ", "tajweed": "ذِلَّ<rule class=ikhafa>ةٌ‌ۚ</rule>", "en": "humiliation", "tr": "dhillatun", "audio": "wbw/070_044_004.mp3"}, {"type": "word", "ar": "ذَٰلِكَ", "tajweed": "<rule class=ikhafa>ذ</rule><rule class=madda_normal><rule class=custom-alef-maksora>ٰ</rule></rule>لِكَ", "en": "That", "tr": "dhālika", "audio": "wbw/070_044_006.mp3"}, {"type": "word", "ar": "ٱلْيَوْمُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡيَوۡمُ", "en": "(is) the Day", "tr": "l-yawmu", "audio": "wbw/070_044_007.mp3"}, {"type": "word", "ar": "ٱلَّذِى", "tajweed": "<rule class=ham_wasl>ٱ</rule>لَّذِى", "en": "which", "tr": "alladhī", "audio": "wbw/070_044_008.mp3"}, {"type": "word", "ar": "كَانُوا۟", "tajweed": "كَانُو<rule class=slnt>اۡ</rule>", "en": "they were", "tr": "kānū", "audio": "wbw/070_044_009.mp3"}, {"type": "word", "ar": "يُوعَدُونَ", "tajweed": "يُوعَد<rule class=madda_permissible>ُو</rule>نَ", "en": "promised", "tr": "yūʿadūna", "audio": "wbw/070_044_010.mp3"}, {"type": "end", "num": "٤٤"}]}]