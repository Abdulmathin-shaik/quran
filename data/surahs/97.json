[{"id": 1, "key": "97:1", "juz": 30, "page": 598, "side_trans": "Indeed, We sent it [i.e., the Qur’ān] down during the Night of Decree.", "words": [{"type": "word", "ar": "إِنَّآ", "tajweed": "إِ<rule class=ghunnah>نّ</rule><rule class=madda_obligatory_monfasel>َآ</rule>", "en": "Indeed, We", "tr": "innā", "audio": "wbw/097_001_001.mp3"}, {"type": "word", "ar": "أَنزَلْنَـٰهُ", "tajweed": "أَ<rule class=ikhafa>نز</rule>َلۡنَ<rule class=madda_normal>ـٰ</rule>هُ", "en": "revealed it", "tr": "anzalnāhu", "audio": "wbw/097_001_002.mp3"}, {"type": "word", "ar": "فِى", "tajweed": "فِى", "en": "in", "tr": "fī", "audio": "wbw/097_001_003.mp3"}, {"type": "word", "ar": "لَيْلَةِ", "tajweed": "لَيۡلَةِ", "en": "(the) Night", "tr": "laylati", "audio": "wbw/097_001_004.mp3"}, {"type": "word", "ar": "ٱلْقَدْرِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَ<rule class=qalaqah>دۡ</rule>رِ", "en": "(of) Power", "tr": "l-qadri", "audio": "wbw/097_001_005.mp3"}, {"type": "end", "num": "١"}]}, {"id": 2, "key": "97:2", "juz": 30, "page": 598, "side_trans": "And what can make you know what is the Night of Decree?", "words": [{"type": "word", "ar": "وَمَآ", "tajweed": "وَم<rule class=madda_obligatory_monfasel>َآ</rule>", "en": "And what", "tr": "wamā", "audio": "wbw/097_002_001.mp3"}, {"type": "word", "ar": "أَدْرَىٰكَ", "tajweed": "أَ<rule class=qalaqah>دۡ</rule>رَ<rule class=madda_normal>ٮٰ</rule>كَ", "en": "can make you know", "tr": "adrāka", "audio": "wbw/097_002_002.mp3"}, {"type": "word", "ar": "مَا", "tajweed": "مَا", "en": "what", "tr": "mā", "audio": "wbw/097_002_003.mp3"}, {"type": "word", "ar": "لَيْلَةُ", "tajweed": "لَيۡلَةُ", "en": "(the) Night", "tr": "laylatu", "audio": "wbw/097_002_004.mp3"}, {"type": "word", "ar": "ٱلْقَدْرِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَ<rule class=qalaqah>دۡ</rule>رِ", "en": "(of) Power (is)", "tr": "l-qadri", "audio": "wbw/097_002_005.mp3"}, {"type": "end", "num": "٢"}]}, {"id": 3, "key": "97:3", "juz": 30, "page": 598, "side_trans": "The Night of Decree is better than a thousand months.", "words": [{"type": "word", "ar": "لَيْلَةُ", "tajweed": "لَيۡلَةُ", "en": "(The) Night", "tr": "laylatu", "audio": "wbw/097_003_001.mp3"}, {"type": "word", "ar": "ٱلْقَدْرِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡقَ<rule class=qalaqah>دۡ</rule>رِ", "en": "(of) Power", "tr": "l-qadri", "audio": "wbw/097_003_002.mp3"}, {"type": "word", "ar": "خَيْرٌۭ", "tajweed": "خَيۡ<rule class=idgham_ghunnah>رٌ</rule>", "en": "(is) better", "tr": "khayrun", "audio": "wbw/097_003_003.mp3"}, {"type": "word", "ar": "مِّنْ", "tajweed": "<rule class=idgham_ghunnah>م</rule>ِّنۡ", "en": "than", "tr": "min", "audio": "wbw/097_003_004.mp3"}, {"type": "word", "ar": "أَلْفِ", "tajweed": "أَلۡفِ", "en": "a thousand", "tr": "alfi", "audio": "wbw/097_003_005.mp3"}, {"type": "word", "ar": "شَهْرٍۢ", "tajweed": "شَهۡرٍ", "en": "month(s)", "tr": "shahrin", "audio": "wbw/097_003_006.mp3"}, {"type": "end", "num": "٣"}]}, {"id": 4, "key": "97:4", "juz": 30, "page": 598, "side_trans": "The angels and the Spirit [i.e., Gabriel] descend therein by permission of their Lord for every matter.", "words": [{"type": "word", "ar": "تَنَزَّلُ", "tajweed": "تَنَزَّلُ", "en": "Descend", "tr": "tanazzalu", "audio": "wbw/097_004_001.mp3"}, {"type": "word", "ar": "ٱلْمَلَـٰٓئِكَةُ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡمَلَ<rule class=madda_obligatory_mottasel>ـٰٓ</rule>ئِكَةُ", "en": "the Angels", "tr": "l-malāikatu", "audio": "wbw/097_004_002.mp3"}, {"type": "word", "ar": "وَٱلرُّوحُ", "tajweed": "وَ<rule class=ham_wasl>ٱ</rule><rule class=laam_shamsiyah>ل</rule>رُّوحُ", "en": "and the Spirit", "tr": "wal-rūḥu", "audio": "wbw/097_004_003.mp3"}, {"type": "word", "ar": "فِيهَا", "tajweed": "فِيهَا", "en": "therein", "tr": "fīhā", "audio": "wbw/097_004_004.mp3"}, {"type": "word", "ar": "بِإِذْنِ", "tajweed": "بِإِذۡنِ", "en": "by (the) permission", "tr": "bi-idh'ni", "audio": "wbw/097_004_005.mp3"}, {"type": "word", "ar": "رَبِّهِم", "tajweed": "رَبِّه<rule class=idgham_shafawi>ِم</rule>", "en": "(of) their Lord", "tr": "rabbihim", "audio": "wbw/097_004_006.mp3"}, {"type": "word", "ar": "مِّن", "tajweed": "<rule class=idgham_shafawi>م</rule>ِّ<rule class=ikhafa>ن</rule>", "en": "for", "tr": "min", "audio": "wbw/097_004_007.mp3"}, {"type": "word", "ar": "كُلِّ", "tajweed": "<rule class=ikhafa>ك</rule>ُلِّ", "en": "every", "tr": "kulli", "audio": "wbw/097_004_008.mp3"}, {"type": "word", "ar": "أَمْرٍۢ", "tajweed": "أَمۡرٍ", "en": "affair", "tr": "amrin", "audio": "wbw/097_004_009.mp3"}, {"type": "end", "num": "٤"}]}, {"id": 5, "key": "97:5", "juz": 30, "page": 598, "side_trans": "Peace it is until the emergence of dawn.", "words": [{"type": "word", "ar": "سَلَـٰمٌ", "tajweed": "سَلَ<rule class=madda_normal>ـٰ</rule>مٌ", "en": "Peace", "tr": "salāmun", "audio": "wbw/097_005_001.mp3"}, {"type": "word", "ar": "هِىَ", "tajweed": "هِىَ", "en": "it (is)", "tr": "hiya", "audio": "wbw/097_005_002.mp3"}, {"type": "word", "ar": "حَتَّىٰ", "tajweed": "حَتَّىٰ", "en": "until", "tr": "ḥattā", "audio": "wbw/097_005_003.mp3"}, {"type": "word", "ar": "مَطْلَعِ", "tajweed": "مَ<rule class=qalaqah>طۡ</rule>لَعِ", "en": "(the) emergence", "tr": "maṭlaʿi", "audio": "wbw/097_005_004.mp3"}, {"type": "word", "ar": "ٱلْفَجْرِ", "tajweed": "<rule class=ham_wasl>ٱ</rule>لۡفَ<rule class=qalaqah>جۡ</rule>رِ", "en": "(of) the dawn", "tr": "l-fajri", "audio": "wbw/097_005_005.mp3"}, {"type": "end", "num": "٥"}]}]